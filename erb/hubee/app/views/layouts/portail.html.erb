<!DOCTYPE html>
<html lang="fr" data-fr-scheme="system">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for(:title) || t("app_name") %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Les balises propres à une page, comme le cache Turbo désactivé du détail d'un abonnement. %>
    <%= yield :head %>

    <%# La favicon HubEE (reprise du portail V1). Servie depuis /favicon.ico, l'adresse
        que les navigateurs sondent d'office — plus de RoutingError dans les journaux. %>
    <link rel="icon" href="/favicon.ico" type="image/x-icon">

    <%# DSFR — Design System de l'État (gem dsfr-assets) %>
    <%= stylesheet_link_tag "dsfr.min", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "utility/dsfr-utility.min", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%# Bouton officiel ProConnect (CSS auto-suffisant hébergé localement) %>
    <%= stylesheet_link_tag "proconnect_button", "data-turbo-track": "reload" %>
    <%# ⚠️ Turbo 8 précharge tout lien au survol : un GET qui écrit (trace d'audit, appel amont avec
        effet) doit passer par un formulaire ou porter `data-turbo="false"`. %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render "portail/shared/skip_links" %>
    <%= render "portail/shared/header" %>

    <%# Le bandeau ouvre le contenu : le lien d'évitement « Contenu » ne doit pas le sauter. %>
    <main role="main" id="content">
      <%= render "portail/shared/beta_notice" if beta_notice? %>
      <div class="fr-container fr-my-6w">
        <%= render "portail/shared/flash" %>
        <%= yield %>
      </div>
    </main>

    <%= render "portail/shared/footer" %>
  </body>
</html>

<%# locals: (key:, label:, target:, value:) -%>
<%# La valeur entière ne vit que dans l'attribut lu par le contrôleur `clipboard`. Les messages sont
    des <template> insérés dans une zone vide : le DSFR n'espace que le premier message d'un champ. %>
<% id = "subscription-credentials-#{key}" %>
<div class="fr-input-group" data-controller="clipboard" data-clipboard-text-value="<%= value %>"
     data-clipboard-done-label-value="<%= t("portail.subscriptions.credentials.copy_done") %>"
     data-action="clipboard:copy@window->clipboard#reset">
  <label class="fr-label" for="<%= id %>">
    <%= label %><span class="fr-sr-only"><%= t("portail.subscriptions.credentials.masked_sr") %></span>
  </label>
  <div class="fr-input-wrap fr-input-wrap--action">
    <input class="fr-input" id="<%= id %>" type="text" readonly value="<%= masked_credential(value) %>"
           aria-describedby="<%= id %>-messages">
    <button type="button" class="fr-btn fr-btn--secondary fr-btn--icon-left fr-icon-clipboard-line"
            data-clipboard-target="button" data-action="clipboard#copy">
      <span data-clipboard-target="label"><%= t("portail.subscriptions.credentials.copy") %></span><span class="fr-sr-only"> <%= target %></span>
    </button>
  </div>
  <div class="fr-messages-group" id="<%= id %>-messages" aria-live="polite" data-clipboard-target="messages"></div>
  <template data-clipboard-target="copied">
    <p class="fr-message fr-message--valid"><%= t("portail.subscriptions.credentials.copied") %></p>
  </template>
  <template data-clipboard-target="failed">
    <p class="fr-message fr-message--error">
      <%# Sans <span>, chaque morceau autour du lien serait un élément flex à part. %>
      <span><%= t("portail.subscriptions.credentials.copy_failed_html", email: mail_to(support_email)) %></span>
    </p>
  </template>
</div>

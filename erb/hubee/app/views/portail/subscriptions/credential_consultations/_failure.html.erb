<%# locals: (failure:) -%>
<%# Un refus est durable, un cas pour l'équipe HubEE. Une panne peut durer : réessayer plus tard,
    puis écrire au support. %>
<div id="subscription-credentials" class="fr-mb-4w">
  <section class="subscription-panel fr-p-3w fr-border-default--grey">
    <%# Le bouton qui avait le focus disparaît : Turbo porte le focus sur ce titre, que le lecteur
        d'écran annonce. %>
    <h2 class="fr-h6 fr-mb-2w" tabindex="-1" autofocus>
      <span class="fr-icon-lock-line fr-mr-1w" aria-hidden="true"></span><%= t("portail.subscriptions.credentials.heading") %>
    </h2>
    <% if failure == :refused %>
      <div class="fr-alert fr-alert--warning fr-alert--sm">
        <p><%= t("portail.subscriptions.credentials.refused_html", email: mail_to(support_email)) %></p>
      </div>
    <% else %>
      <div class="fr-alert fr-alert--error fr-alert--sm">
        <p><%= t("portail.subscriptions.credentials.unavailable_html", email: mail_to(support_email)) %></p>
      </div>
    <% end %>
  </section>
</div>

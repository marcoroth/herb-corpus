<%# locals: (credentials:, failure:) -%>
<% if failure %>
  <%= turbo_stream.replace "subscription-credentials",
        partial: "portail/subscriptions/credential_consultations/failure", locals: {failure:} %>
<% else %>
  <%= turbo_stream.replace "subscription-credentials",
        partial: "portail/subscriptions/credential_consultations/revealed", locals: {credentials:} %>
<% end %>

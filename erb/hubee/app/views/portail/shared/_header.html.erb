<header role="banner" class="fr-header">
  <div class="fr-header__body">
    <div class="fr-container">
      <div class="fr-header__body-row">
        <div class="fr-header__brand fr-enlarge-link">
          <div class="fr-header__brand-top">
            <div class="fr-header__logo">
              <p class="fr-logo">République<br>Française</p>
            </div>
            <div class="fr-header__navbar">
              <button data-fr-opened="false" aria-controls="modal-header-menu" title="<%= t(".menu") %>" type="button" id="button-header-menu" class="fr-btn--menu fr-btn"><%= t(".menu") %></button>
            </div>
          </div>
          <div class="fr-header__service">
            <%= link_to root_path, title: t(".home_title") do %>
              <p class="fr-header__service-title"><%= t("app_name") %></p>
            <% end %>
            <p class="fr-header__service-tagline"><%= t("tagline") %></p>
          </div>
        </div>

        <%# Accès rapides du DSFR. Le contenu de fr-header__tools-links est recopié
            automatiquement dans fr-header__menu-links pour le mobile — l'identité doit
            donc rester à l'intérieur, sans quoi elle disparaîtrait sur petit écran. %>
        <div class="fr-header__tools">
          <div class="fr-header__tools-links">
            <ul class="fr-btns-group">
              <%# L'identité d'abord : une information, pas une action. Les actions suivent, côte à
                  côte, la déconnexion tout à droite, là où on la cherche. %>
              <% if agent_signed_in? %>
                <li>
                  <%# Même rembourrage vertical que le bouton : les <li> du groupe étant
                      alignés en haut, c'est ce qui met les deux textes sur la même ligne. %>
                  <p class="fr-text--sm fr-m-0 fr-py-1v">
                    <%= t(".signed_in_as", name: current_agent.first_name, email: current_agent.email) %>
                  </p>
                </li>
              <% end %>
              <%# Pour tous, connecté ou non : c'est souvent avant la connexion qu'on cherche l'aide. %>
              <li>
                <%= link_to t(".help"), help_url,
                      class: "fr-btn fr-btn--icon-left fr-icon-question-line",
                      target: "_blank", rel: "noopener", title: t(".help_title") %>
              </li>
              <% if agent_signed_in? %>
                <li>
                  <%# Déconnexion : redirection cross-origin vers ProConnect (SLO), que Turbo
                      ne sait pas rendre — il laisserait la page inchangée. Hors Turbo, donc. %>
                  <%= button_to t(".sign_out"), logout_path, method: :delete,
                        class: "fr-btn fr-btn--icon-left fr-icon-logout-box-r-line",
                        form: {data: {turbo: false}} %>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="fr-header__menu fr-modal" id="modal-header-menu" aria-labelledby="button-header-menu">
    <div class="fr-container">
      <button aria-controls="modal-header-menu" title="<%= t(".close") %>" type="button" id="button-close-header-menu" class="fr-btn--close fr-btn"><%= t(".close") %></button>
      <div class="fr-header__menu-links"></div>
      <nav class="fr-nav" id="header-navigation" role="navigation" aria-label="<%= t(".nav_label") %>">
        <ul class="fr-nav__list">
          <li class="fr-nav__item">
            <%= link_to t(".deliveries"), teledossiers_path, class: "fr-nav__link", "aria-current": (current_page?(teledossiers_path) ? "page" : nil) %>
          </li>
          <%# La policy et non le rôle : le lien n'apparaît que là où la page s'ouvre. %>
          <% if agent_signed_in? && policy(Portail::Subscription).index? %>
            <li class="fr-nav__item">
              <%= link_to t(".subscriptions"), abonnements_path, class: "fr-nav__link", "aria-current": (current_page?(abonnements_path) ? "page" : nil) %>
            </li>
          <% end %>
          <%# Le tableau désigne Portail::MembershipPolicy : le modèle est ::Membership. %>
          <% if agent_signed_in? && policy([:portail, Membership]).index? %>
            <li class="fr-nav__item">
              <%= link_to t(".memberships"), agents_path, class: "fr-nav__link", "aria-current": (current_page?(agents_path) ? "page" : nil) %>
            </li>
          <% end %>
        </ul>
      </nav>
    </div>
  </div>
</header>

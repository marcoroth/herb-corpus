<%# _no_songs.html.erb - Renders a message when no songs are found %>
<div class="mx-auto max-w-screen-lg px-2 mt-6">
  <div class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body items-center text-center">
      <h3 class="card-title">No se encontraron canciones</h3>
      <p class="text-sm opacity-70">
        <%= params[:q].present? ? "Intenta ajustar tu búsqueda." : "Aún no hay canciones." %>
      </p>
      <% if params[:q].present? %>
        <%= link_to 'Limpiar búsqueda', app_path, class: 'btn btn-sm mt-2' %>
      <% end %>
    </div>
  </div>
</div>

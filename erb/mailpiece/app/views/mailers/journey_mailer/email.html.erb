<tr>
  <td style="color: #1a1a1a; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 17px; line-height: 1.55; overflow-wrap: anywhere; word-break: break-word;">
    <div style="margin: 0 auto; max-width: 600px;">
      <% if @email.summary %>
        <%# The first text in the message, so an inbox shows it beside the subject. %>
        <div style="display: none; max-height: 0; mso-hide: all; overflow: hidden;"><%= @email.summary %></div>
      <% end %>

      <%= render "mailers/post_mailer/masthead", name: @account.name %>

      <%= post_email_html(@email) %>

      <p style="border-top: 1px solid #d1d5dc; color: #737374; font-size: 14px; margin: 32px 0 0; padding: 16px 0 0;">
        <% if @unsubscribed %>
          <%= t("mailers_journey_unsubscribed", name: @account.name) %>
        <% elsif @subscriber %>
          <%= t("mailers_issue_receiving", name: @account.name) %>
          <%= link_to t("mailers_issue_unsubscribe"), @unsubscribe_url, style: "color: #737374; text-decoration: underline;" %>
        <% else %>
          <%= t("mailers_journey_test_copy") %>
        <% end %>
      </p>
    </div>
  </td>
</tr>

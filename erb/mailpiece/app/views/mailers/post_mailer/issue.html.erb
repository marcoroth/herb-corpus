<tr>
  <td style="color: #1a1a1a; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 17px; line-height: 1.55; overflow-wrap: anywhere; word-break: break-word;">
    <div style="margin: 0 auto; max-width: 600px;">
      <% if @post.summary %>
        <%# The first text in the message, so an inbox shows it beside the subject; hidden, since it is read again under the title. %>
        <div style="display: none; max-height: 0; mso-hide: all; overflow: hidden;"><%= @post.summary %></div>
      <% end %>

      <%= render "mailers/post_mailer/masthead", name: @account.name, web_url: (public_post_url(@post.public_param) if @post.on_the_web?) %>

      <p style="color: #737374; font-size: 12px; font-weight: 500; letter-spacing: 0.14em; line-height: 1.4; margin: 0 0 12px; text-transform: uppercase;"><%= public_post_date(@post.published_at || Time.current) %> · <%= @post.creator.name %></p>
      <h1 style="font-family: Georgia, 'Times New Roman', serif; font-size: 30px; font-weight: 700; line-height: 1.2; margin: 0 0 <%= @post.summary ? 12 : 24 %>px;"><%= @post.title %></h1>
      <% if @post.summary %>
        <p style="color: #737374; font-size: 19px; line-height: 1.4; margin: 0 0 24px;"><%= @post.summary %></p>
      <% end %>

      <%= post_email_html(@post) %>

      <p style="border-top: 1px solid #d1d5dc; color: #737374; font-size: 14px; margin: 32px 0 0; padding: 16px 0 0;">
        <% if @subscriber %>
          <% if @rating_token %>
            <%# Outside the post's body, so link tracking never rewrites these. %>
            <%= t("mailers_issue_rating_html",
                  liked: link_to(t("mailers_issue_rating_liked"), new_public_rating_url(access_token: @rating_token, choice: :liked), style: "color: #737374; text-decoration: underline;"),
                  disliked: link_to(t("mailers_issue_rating_disliked"), new_public_rating_url(access_token: @rating_token, choice: :disliked), style: "color: #737374; text-decoration: underline;")) %>
            <br>
          <% end %>
          <%= t("mailers_issue_receiving", name: @account.name) %>
          <%= link_to t("mailers_issue_unsubscribe"), @unsubscribe_url, style: "color: #737374; text-decoration: underline;" %>
        <% else %>
          <%= t("mailers_issue_test_copy") %>
        <% end %>
      </p>
    </div>
  </td>
</tr>

<table role="presentation" cellpadding="0" cellspacing="0" style="margin: 0 0 28px; width: 100%;">
  <tr>
    <td style="border-bottom: 1px solid #d1d5dc; color: #1a1a1a; font-family: Georgia, 'Times New Roman', serif; font-size: 22px; font-weight: 700; line-height: 1.2; padding: 0 0 14px; text-align: left; vertical-align: bottom;"><%= name %></td>
    <% if local_assigns[:web_url] %>
      <td style="border-bottom: 1px solid #d1d5dc; color: #737374; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 14px; line-height: 1.2; padding: 0 0 14px 16px; text-align: right; vertical-align: bottom; white-space: nowrap;"><%= link_to t("mailers_issue_view_on_web"), web_url, style: "color: #737374; text-decoration: underline;" %></td>
    <% end %>
  </tr>
</table>

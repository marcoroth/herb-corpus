<tr>
  <td>

    <% if @magic_link.for_sign_in? %>
      <h1 class="title"><%= t("mailers_sign_in_title_sign_in") %></h1>
      <p class="subtitle"><%= t("mailers_sign_in_enter_code_sign_in") %></p>
    <% else %>
      <h1 class="title"><%= t("mailers_sign_in_title_new") %></h1>
      <p class="subtitle"><%= t("mailers_sign_in_enter_code_new") %></p>
    <% end %>

    <strong class="txt-large"><%= @magic_link.code %></strong>

    <p><%= t("mailers_sign_in_expires", time: distance_of_time_in_words(MagicLink::EXPIRATION_TIME)) %></p>

    <% if @magic_link.for_sign_in? && url_options[:host].present? && (account = @identity.accounts.active.last) %>
      <p><%= t("mailers_sign_in_passkey_html", link: link_to(t("mailers_sign_in_passkey_link"), my_passkeys_url(script_name: account.slug))) %></p>
    <% end %>

    <% if support_email_address %>
      <p class="footer"><%= t("support_need_help_html", link: mail_to(support_email_address, t("support_email_link"))) %>
      </p>
    <% end %>
  </td>
</tr>

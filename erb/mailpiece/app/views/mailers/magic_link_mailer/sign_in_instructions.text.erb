<% if @magic_link.for_sign_in? %>
<%= t("mailers_sign_in_enter_code_sign_in") %>
<% else %>
<%= t("mailers_sign_in_enter_code_new") %>
<% end %>

<%= @magic_link.code %>

<%= t("mailers_sign_in_expires", time: distance_of_time_in_words(MagicLink::EXPIRATION_TIME)) %>
<% if @magic_link.for_sign_in? && url_options[:host].present? && (account = @identity.accounts.active.last) %>

<%= t("mailers_sign_in_passkey_text", url: my_passkeys_url(script_name: account.slug)) %>
<% end %>

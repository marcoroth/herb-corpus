<% @page_title = t("sessions_completion_heading") %>
<% turbo_exempts_page_from_cache %>

<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="panel panel--centered flex flex-column gap-half">
  <%= form_with model: @signup, url: signup_completion_path, scope: "signup", class: "flex flex-column gap-half txt-medium" do |form| %>
    <%= render "shared/errors", record: @signup %>

    <div class="flex flex-column gap-half txt-align-start">
      <%= form.label :full_name do %>
        <strong><%= t("sessions_full_name_label") %></strong>
      <% end %>
      <%= form.text_field :full_name, required: true, autofocus: true, autocomplete: "name", placeholder: t("sessions_full_name_placeholder"), maxlength: 240, class: "input txt-large full-width" %>
    </div>

    <p class="margin-block-half"><%= t("sessions_completion_body") %></p>

    <%= form.button t("continue"), type: "submit", class: "btn btn--link center txt-medium" %>
  <% end %>
</div>

<% content_for :footer do %>
  <%= render "sessions/footer" %>
<% end %>

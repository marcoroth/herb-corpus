<% @page_title = t("public_rating_title") %>
<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="panel panel--centered flex flex-column gap-half">
  <% other_choice = (Post::Rating.choices.keys - [ @choice ]).sole %>
  <p class="margin-none"><%= t("public_rating_body", title: post_title(@delivery.post)) %></p>
  <%= button_to t("public_rating_#{@choice}"), public_rating_path(access_token: params[:access_token]), params: { choice: @choice }, class: "btn btn--reversed center" %>
  <%= link_to t("public_rating_other_#{other_choice}"), new_public_rating_path(access_token: params[:access_token], choice: other_choice), class: "txt-small txt-subtle center" %>
</div>

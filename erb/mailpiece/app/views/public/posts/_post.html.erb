<article id="<%= dom_id post %>" class="post-summary">
  <p class="post__meta"><%= public_post_date(post.published_at) %></p>
  <h2 class="post-summary__title"><%= link_to post.title, public_post_path(post.public_param), class: "post-summary__link" %></h2>
  <p class="post-summary__excerpt"><%= post.excerpt %></p>
  <%= link_to t("public_read_more"), public_post_path(post.public_param), class: "btn post-summary__more" %>
</article>

<% @page_title = @post.title %>
<% @body_class = "newsletter newsletter-post" %>

<% content_for :head do %>
  <%= auto_discovery_link_tag :atom, public_feed_url, title: Current.account.name %>
  <%= post_share_tags @post %>
  <%= tag.link rel: "alternate", type: "text/markdown", href: public_post_markdown_url(@post.public_param) %>
  <%= tag.meta name: "robots", content: "noindex" unless @post.listed? %>
<% end %>

<div class="page writing reading flex flex-column gap">
  <header class="newsletter-header">
    <%= render "public/posts/identity" %>
  </header>

  <article class="post">
    <p class="post__meta"><%= public_post_date(@post.published_at) %> · <%= @post.creator.name %></p>
    <h1 class="post__title"><%= @post.title %></h1>
    <% if @post.summary %>
      <p class="post__summary"><%= @post.summary %></p>
    <% end %>
    <div class="lexxy-content"><%= post_web_html @post %></div>
  </article>

  <% if Current.account.description.present? %>
    <section class="post-about">
      <h2 class="post-about__title"><%= t("public_about", name: Current.account.name) %></h2>
      <div class="post-about__description lexxy-content"><%= Current.account.description %></div>
    </section>
  <% end %>

  <%= render "public/subscriptions/form", post: @post %>
</div>

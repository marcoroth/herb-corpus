<% @page_title = Current.account.name %>
<% @body_class = "newsletter newsletter-home" %>

<% content_for :head do %>
  <%= auto_discovery_link_tag :atom, public_feed_url, title: Current.account.name %>
  <%= newsletter_share_tags %>
  <% if Current.account.welcomes_visitors? %>
    <%= javascript_tag nonce: true do %>
      if (!localStorage.getItem("<%= welcome_storage_key %>")) {
        document.documentElement.dataset.welcome = ""
      }
    <% end %>
  <% end %>
<% end %>

<%= tag.div class: "page writing reading flex flex-column gap", data: welcome_data do %>
  <header class="newsletter-header">
    <%= render "public/posts/identity", tag: :h1 %>
    <% if Current.account.description.present? %>
      <div class="newsletter-header__description lexxy-content"><%= Current.account.description %></div>
    <% end %>
    <% if Current.account.welcomes_visitors? && Current.account.welcome_message.present? %>
      <div class="welcome-message lexxy-content"><%= Current.account.welcome_message %></div>
    <% end %>
  </header>

  <%= render "public/subscriptions/form" %>

  <% if Current.account.welcomes_visitors? %>
    <button type="button" class="welcome-skip btn btn--plain txt-small txt-underline" data-action="welcome#dismiss"><%= t("public_welcome_skip") %></button>
  <% end %>

  <% if @page.used? %>
    <div class="post-summaries">
      <%= with_automatic_pagination :posts, @page do %>
        <%= render partial: "public/posts/post", collection: @page.records %>
      <% end %>
    </div>
  <% else %>
    <div class="blank-slate fit-content center"><strong><%= t("public_no_posts") %></strong></div>
  <% end %>
<% end %>

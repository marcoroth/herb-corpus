<%# A new window, and noopener alone: the video's site is told where its visitor came from. %>
<% window = { target: "_blank", rel: "noopener" } %>
<%= tag.figure class: "video-thumbnail" do -%>
<%= link_to tag.img(src: post_video_thumbnail_url(post, video), alt: t("posts_video_thumbnail_alt")), video.address, class: "video-thumbnail__picture", **window -%>
<%= tag.figcaption link_to(video.caption, video.address, **window), class: "attachment__caption" -%>
<% end -%>

<% @page_title = t("public_confirmation_invalid_title") %>
<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="panel panel--centered flex flex-column gap-half">
  <p class="margin-none"><%= t("public_confirmation_invalid_body", duration: distance_of_time_in_words(Subscriber::CONFIRMATION_TOKEN_EXPIRATION), name: Current.account.name) %></p>
  <%= link_to t("public_see_all_posts"), root_path, class: "btn center" %>
</div>

<% @page_title = @subscriber.active? ? t("public_confirmation_done_title") : t("public_confirmation_pending_title") %>
<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="panel panel--centered flex flex-column gap-half">
  <% if @subscriber.active? %>
    <p class="margin-none"><%= t("public_confirmation_done_body", name: Current.account.name, email: @subscriber.email) %></p>
    <p class="margin-none txt-small txt-subtle"><%= t("public_confirmation_done_note", name: Current.account.name) %></p>
    <%= link_to t("public_see_all_posts"), root_path, class: "btn center" %>
    <%# The same link every issue carries; its page asks before anything is done. %>
    <%= link_to t("public_unsubscribe_button"), public_subscription_unsubscription_path(@subscriber.token), class: "txt-small txt-subtle center" %>
  <% else %>
    <p class="margin-none"><%= t("public_confirmation_pending_body") %></p>
    <%= button_to t("public_confirmation_pending_button"), public_subscription_confirmation_path(params[:subscription_token]), class: "btn btn--reversed center", form: { data: { turbo: false } } %>
  <% end %>
</div>

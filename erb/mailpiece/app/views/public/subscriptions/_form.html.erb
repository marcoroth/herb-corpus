<section class="subscription txt-small txt-subtle" id="subscribe">
  <% if Current.account.sends_mail? %>
    <%= form_with url: public_subscription_path do |form| %>
      <label for="subscription_email" class="subscription__label">
        <%= t("public_subscribe_label_html", link: link_to(t("public_rss_feed"), public_feed_path, class: "subscription__feed")) %>
      </label>

      <div class="subscribe">
        <%= form.email_field :email, id: "subscription_email", required: true, autocomplete: "email", placeholder: t("public_subscribe_email_placeholder"), class: "subscribe__email input" %>
        <%# A person never sees or fills this field: an address that arrives with it is dropped. %>
        <%= form.text_field :reference, id: nil, tabindex: -1, autocomplete: "off", hidden: true, aria: { hidden: true } %>
        <%# When the form was drawn: an address that arrives within seconds of it is dropped. %>
        <%= form.hidden_field :drawn_at, id: nil, value: Subscriber::FormStamp.generate, autocomplete: "off" %>
        <%= form.hidden_field :post_code, id: nil, value: post.code, autocomplete: "off" if local_assigns[:post] %>
        <%= form.button t("public_subscribe_button"), type: "submit", class: "subscribe__submit btn btn--plain" %>
      </div>
    <% end %>
  <% else %>
    <p class="subscription__label margin-none"><%= t("public_subscribe_rss_only_html", link: link_to(t("public_rss_feed"), public_feed_path, class: "subscription__feed")) %></p>
  <% end %>
</section>

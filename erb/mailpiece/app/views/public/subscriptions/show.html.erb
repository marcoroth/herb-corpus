<% @page_title = Current.account.sends_mail? ? t("public_subscription_sent_title") : t("public_subscription_not_sending_title") %>
<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="panel panel--centered flex flex-column gap-half">
  <% if Current.account.sends_mail? %>
    <p class="margin-none"><%= t("public_subscription_sent_body", name: Current.account.name) %></p>
    <p class="margin-none txt-small txt-subtle"><%= t("public_subscription_sent_note", subject: t("mailers_subscription_confirm_title", name: Current.account.name)) %></p>
  <% else %>
    <p class="margin-none"><%= t("public_subscription_not_sending_body", name: Current.account.name) %></p>
    <p class="margin-none txt-small txt-subtle"><%= t("public_subscription_not_sending_follow_html", link: link_to(t("public_rss_feed"), public_feed_path)) %></p>
  <% end %>
  <%= link_to t("public_see_all_posts"), root_path, class: "btn center" %>
</div>

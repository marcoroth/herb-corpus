<% @page_title = @subscriber.unsubscribed_at? ? t("public_unsubscribe_done_title") : t("public_unsubscribe_confirm_title") %>
<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="panel panel--centered flex flex-column gap-half">
  <% if @subscriber.unsubscribed_at? %>
    <p class="margin-none"><%= t("public_unsubscribe_done_body", email: @subscriber.email, name: Current.account.name) %></p>
    <%= link_to t("public_see_all_posts"), root_path, class: "btn center" %>
  <% else %>
    <p class="margin-none"><%= t("public_unsubscribe_confirm_body", email: @subscriber.email, name: Current.account.name) %></p>
    <%= button_to t("public_unsubscribe_button"), public_subscription_unsubscription_path(@subscriber.token), class: "btn btn--negative center", form: { data: { turbo: false } } %>
  <% end %>
</div>

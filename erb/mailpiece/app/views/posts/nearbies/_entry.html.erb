<%= tag.div class: token_list("calendar__entry", "calendar__entry--proposed": calendar.proposed?(post)) do %>
  <span class="calendar__meta">
    <% if calendar.proposed?(post) %>
      <span class="calendar__this-post"><%= t("posts_nearby_this_post") %></span>
    <% else %>
      <%= status_tag post.state %>
    <% end %>
  </span>
  <%= tag.strong post_title(post), class: "calendar__title", title: post_title(post) %>
<% end %>

<%= tag.li id: dom_id(post),
      class: "row",
      style: "view-transition-name: #{dom_id post}",
      tabindex: -1,
      data: { quick_find_target: "item", navigable_list_target: "item" } do %>
  <%= link_to edit_post_path(post), class: "row__body" do %>
    <strong class="row__title"><%= post_title(post) %></strong>
    <span class="row__meta"><%= post_meta(post) %></span>
  <% end %>
<% end %>

<% @page_title = t("posts_changes_to", title: post_title(@post)) %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= link_to t("posts"), posts_path %>
      <span class="breadcrumbs__separator">▸</span>
      <%= up_crumb_to post_title(@post), edit_post_path(@post) %>
      <strong><%= t("posts_history") %></strong>
    </span>
  </h1>
<% end %>

<div class="page writing" style="<%= post_audience_labels_style %>">
  <section class="writing__version">
    <%= turbo_frame_tag :previous_version do %>
      <header class="writing-toolbar">
        <% if @revision.previous %>
          <%= link_to post_revision_path(@post, @revision.previous), data: { turbo_action: :advance }, class: "btn txt-small" do %>
            <%= icon_tag "arrow-left" %>
            <span class="for-screen-reader"><%= t("posts_previous_version") %></span>
          <% end %>
        <% else %>
          <span class="btn txt-small" disabled>
            <%= icon_tag "arrow-left" %>
            <span class="for-screen-reader"><%= t("posts_previous_version") %></span>
          </span>
        <% end %>

        <h2 class="txt-small margin-none overflow-ellipsis"><%= local_datetime_tag @revision.updated_at, style: :ago %></h2>

        <% if @revision.next %>
          <%= link_to post_revision_path(@post, @revision.next), data: { turbo_action: :advance }, class: "btn txt-small" do %>
            <%= icon_tag "arrow-right" %>
            <span class="for-screen-reader"><%= t("posts_next_version") %></span>
          <% end %>
        <% else %>
          <span class="btn txt-small" disabled>
            <%= icon_tag "arrow-right" %>
            <span class="for-screen-reader"><%= t("posts_next_version") %></span>
          </span>
        <% end %>
      </header>

      <article class="post">
        <h1 class="post__title"><%= @revision.title %></h1>
        <div class="lexxy-content"><%= @revision.body %></div>
      </article>
    <% end %>
  </section>

  <section class="writing__version writing__version--current">
    <header class="writing-toolbar">
      <%= link_to t("posts_current"), edit_post_path(@post), class: "btn btn--link txt-medium" %>
    </header>

    <article class="post">
      <h1 class="post__title"><%= @post.title %></h1>
      <div class="lexxy-content"><%= @post.body %></div>
    </article>
  </section>
</div>

<div id="<%= dom_id(post, :listing) %>" role="radiogroup" aria-label="<%= t("posts_on_the_web") %>">
  <%= tag.button type: "submit",
        form: dom_id(post, :listing_form),
        class: "post-pop__item",
        role: "radio",
        aria: { checked: post.listed? },
        disabled: post.listed? do %>
    <span><%= t("posts_listed") %></span>
    <%= icon_tag "check", class: "checked" %>
  <% end %>
  <%= tag.button type: "submit",
        form: dom_id(post, :listing_form),
        name: "_method",
        value: "delete",
        class: "post-pop__item",
        role: "radio",
        aria: { checked: post.unlisted? },
        disabled: post.unlisted? do %>
    <span><%= t("posts_by_link_only") %></span>
    <%= icon_tag "check", class: "checked" %>
  <% end %>
</div>

<% @page_title = t("posts_results_title") %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= link_to t("posts"), posts_path %>
      <span class="breadcrumbs__separator">▸</span>
      <%= up_crumb_to post_title(@post), edit_post_path(@post) %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page">
  <div class="settings">
    <div class="settings__panel panel shadow">
      <% if @brought_subscribers_count.positive? %>
        <p class="margin-none"><%= t("posts_results_brought_subscribers", count: @brought_subscribers_count) %></p>
      <% end %>

      <% if @ratings_count.any? %>
        <p class="margin-none"><%= t("posts_results_ratings", liked: @ratings_count.fetch("liked", 0), disliked: @ratings_count.fetch("disliked", 0)) %></p>
      <% end %>

      <% if @links.any? %>
        <%= render partial: "posts/links/link", collection: @links, locals: { post: @post } %>
      <% else %>
        <div class="blank-slate fit-content center"><strong><%= t("posts_links_none") %></strong></div>
      <% end %>

      <div>
        <%= link_to t("cancel_and_go_back"), edit_post_path(@post), class: "btn borderless" %>
      </div>
    </div>
  </div>
</div>

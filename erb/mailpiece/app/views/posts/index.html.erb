<% @page_title = t("posts") %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb up: true %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end">
    <%= toolbar_button t("snippets_title"), snippets_path, icon: "clipboard" %>
    <%= toolbar_button t("journeys_title"), journeys_path, icon: "bolt" %>
    <%= new_link_to t("posts_new"), new_post_path %>
  </div>
<% end %>

<div class="page flex flex-column gap">
  <% if Current.account.posts.exists? %>
    <%= render layout: "shared/filter", locals: { what: t("posts_filter_what"), search: search_path } do %>
      <div data-controller="navigable-list" data-action="keydown->navigable-list#navigate turbo:before-visit@document->navigable-list#rememberSelection turbo:frame-load->navigable-list#forgetSelection"
            data-navigable-list-actionable-items-value="true">
        <% if @drafts.none? && @scheduled.none? %>
          <div class="blank-slate fit-content center"><strong><%= t("posts_none_here") %></strong> <%= link_to t("posts_add_one"), new_post_path %></div>
        <% end %>

        <%= render "shared/rows_section", title: t("posts_state_draft"), records: @drafts, partial: "posts/post" %>
        <%= render "shared/rows_section", title: t("posts_state_scheduled"), records: @scheduled, partial: "posts/post" %>

        <ul class="rows rows--links">
          <%= render "shared/count_row", title: t("posts_state_published"), path: posts_published_path, count: Current.account.posts.published.on_the_web.count %>
          <%= render "shared/count_row", title: t("posts_state_sent"), path: posts_sent_path, count: Current.account.posts.sent.count %>
        </ul>
      </div>
    <% end %>
  <% else %>
    <div class="blank-slate fit-content center"><strong><%= t("posts_none_yet") %></strong> <%= link_to t("posts_add_one"), new_post_path %></div>
  <% end %>
</div>

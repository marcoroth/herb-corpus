<div class="display-contents"
     data-controller="dialog"
     data-dialog-orient-value="false"
     data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
  <span class="post-actions__split post-actions__main">
    <%= form.button type: "submit", class: "btn btn--link post-actions__primary" do %>
      <span><%= t("save") %></span>
    <% end %>
    <button type="button"
            class="btn btn--link post-actions__more"
            aria-label="<%= t("posts_release_more") %>"
            aria-haspopup="dialog"
            data-action="dialog#toggle">
      <%= icon_tag "caret-down" %>
    </button>
  </span>

  <dialog class="popup post-pop post-pop--menu"
          aria-label="<%= t("posts_release_group_label") %>"
          data-dialog-target="dialog"
          data-action="post-bar:submitted->dialog#close">
    <% if post.on_the_web? %>
      <div class="post-pop__columns" data-controller="post-nearby" data-action="change->post-nearby#load">
        <div class="post-pop__choices">
          <span class="post-pop__heading"><%= t("posts_on_the_web") %></span>
          <%= render "posts/listings/listing", post: post %>
          <%= form.button type: "submit", name: "_method", value: "delete", formaction: post_publication_path(post), formnovalidate: true,
                class: "post-pop__item btn", data: { turbo_confirm: t("posts_unpublish_confirm") } do %>
            <span class="txt-negative"><%= t("posts_unpublish") %></span>
          <% end %>

          <span class="post-pop__heading"><%= t("posts_publication_date") %></span>
          <div class="post-pop__when">
            <%= date_field_tag "post[published_day]", post.published_at.to_date.iso8601, id: nil, class: "input", max: Time.zone.today.iso8601,
                  aria: { label: t("posts_schedule_day") }, data: { post_nearby_target: "day", action: "keydown.enter->dialog#close:prevent" } %>
            <%= select_tag "post[published_hour]", post_release_hour_options(post.published_at.hour), id: nil, class: "input input--select",
                  aria: { label: t("posts_schedule_hour") }, data: { post_nearby_target: "hour", action: "keydown.enter->dialog#close:prevent" } %>
          </div>
        </div>

        <%= render "posts/bar/nearby", post: post %>
      </div>
    <% elsif post.sent? %>
      <span class="post-pop__heading"><%= t("posts_on_the_web") %></span>
      <%= form.button type: "submit",
            name: "_method",
            value: "post",
            formaction: post_publication_path(post),
            formnovalidate: true,
            class: "post-pop__item btn" do %>
        <span><%= t("posts_publish_on_web") %></span>
      <% end %>
    <% end %>
  </dialog>
</div>

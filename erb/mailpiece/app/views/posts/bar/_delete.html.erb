      class: "btn txt-negative borderless fill-transparent flex-item-justify-end", data: { turbo_confirm: t("posts_delete_confirm") } do %>
  <%= icon_tag "trash" %>
  <span class="for-screen-reader"><%= t("posts_delete") %></span>
<% end %>

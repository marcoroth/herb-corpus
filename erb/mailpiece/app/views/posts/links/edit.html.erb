<%= turbo_frame_tag @link do %>
  <section class="settings__section">
    <%= form_with model: @link, url: post_link_path(@post, @link), class: "flex flex-column gap-half" do |form| %>
      <%= render "shared/errors", record: @link %>

      <div class="flex align-center gap-half">
        <strong class="overflow-ellipsis"><%= @link.text.presence || @link.original_url %></strong>
        <%= status_tag "stale", form: :badge if @link.stale? %>
      </div>

      <div class="flex gap-half">
        <%= form.url_field :url,
              required: true,
              autofocus: true,
              class: "input flex-item-grow min-width",
              aria: { label: Post::Link.human_attribute_name(:url) } %>
        <%= form.button t("save"), type: "submit", class: "btn btn--link" %>
        <%= link_to t("cancel"), post_results_path(@post), class: "btn borderless" %>
      </div>
    <% end %>
  </section>
<% end %>

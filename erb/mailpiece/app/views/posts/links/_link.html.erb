<%= turbo_frame_tag link do %>
  <section class="settings__section flex flex-column gap-half">
    <div class="flex align-center gap-half">
      <strong class="overflow-ellipsis"><%= link.text.presence || link.original_url %></strong>
      <%= status_tag "stale", form: :badge if link.stale? %>
    </div>

    <div class="flex align-center gap-half">
      <span class="overflow-ellipsis flex-item-grow min-width"><%= link.url %></span>
      <%= link_to t("edit"), edit_post_link_path(post, link), class: "btn btn--link" %>
    </div>
  </section>
<% end %>

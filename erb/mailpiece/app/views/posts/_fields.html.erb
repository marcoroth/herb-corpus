<%= render "shared/errors", record: post %>

<%= form.label :title,
      class: "autoresize__wrapper post-form__heading",
      data: { autoresize_target: "wrapper", autoresize_clone_value: "" } do %>
  <%= form.text_area :title,
        autofocus: post.new_record?,
        maxlength: 200,
        rows: 1,
        dir: "auto",
        class: "input autoresize__textarea post-form__title",
        placeholder: t("posts_title_placeholder"),
        aria: { label: t("posts_title_label") },
        data: {
          autoresize_target: "textarea",
          action: token_list(
            "input->autoresize#resize keydown.enter->advance-to-editor#advance",
            "auto-save#change blur->auto-save#submit keydown.enter->auto-save#submit": local_assigns[:auto_save]
          )
        } %>
<% end %>

<%= form.text_area :summary,
      maxlength: Post::SUMMARY_LENGTH,
      rows: 1,
      dir: "auto",
      class: "input post-form__summary",
      placeholder: t("posts_summary_placeholder"),
      aria: { label: t("posts_summary_label") },
      data: {
        action: token_list(
          "keydown.enter->advance-to-editor#advance",
          "auto-save#change blur->auto-save#submit keydown.enter->auto-save#submit": local_assigns[:auto_save]
        )
      } %>

<%= form.rich_textarea :body,
      class: "lexxy-content",
      placeholder: t("posts_body_placeholder"),
      aria: { label: t("posts_body_label") },
      style: post_audience_labels_style,
      data: {
        advance_to_editor_target: "editor",
        action: ("lexxy:change->auto-save#change focusout->auto-save#submit" if local_assigns[:auto_save])
      } do %>
  <%= post_snippets_prompt %>
<% end %>

<% @page_title = t("posts_new") %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= link_to t("posts"), posts_path %>
      <span class="breadcrumbs__separator">▸</span>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page writing">
  <%= form_with model: @post, class: "writing__form", style: "view-transition-name: #{dom_id(@post)}", data: { controller: "autoresize advance-to-editor" } do |form| %>
    <%= render "posts/fields", form: form, post: @post %>

    <div class="writing-bar post-actions">
      <%= form.button type: "submit", class: "btn btn--link post-actions__main" do %>
        <span><%= t("save") %></span>
      <% end %>
      <%= link_to t("cancel_and_go_back"), posts_path, class: "btn borderless" %>
    </div>
  <% end %>
</div>

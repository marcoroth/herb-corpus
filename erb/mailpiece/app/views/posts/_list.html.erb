<div class="page flex flex-column gap">
  <%= render layout: "shared/filter", locals: { what: t("posts_filter_what"), search: search_path } do %>
    <% if page.used? %>
      <div data-controller="navigable-list" data-action="keydown->navigable-list#navigate turbo:before-visit@document->navigable-list#rememberSelection turbo:frame-load->navigable-list#forgetSelection"
            data-navigable-list-actionable-items-value="true">
        <ul class="rows">
          <%= with_automatic_pagination :posts, page do %>
            <%= render partial: "posts/post", collection: page.records %>
          <% end %>
        </ul>
      </div>
    <% else %>
      <div class="blank-slate fit-content center"><strong><%= t("posts_none_here") %></strong></div>
    <% end %>
  <% end %>
</div>

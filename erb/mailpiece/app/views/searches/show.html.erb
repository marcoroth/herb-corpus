<% @page_title = @query ? t("search_results_for", query: @query) : t("search") %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb up: true %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <%= form_with url: search_path, method: :get do %>
    <%= search_field_tag :q, @query, class: "input full-width", autocomplete: "off", autofocus: @query.nil?,
          placeholder: t("search"), aria: { label: t("search") } %>
  <% end %>

  <%= render "shared/rows_section", title: t("posts"), records: @posts, partial: "posts/post" %>
  <% if @page.used? %>
    <section class="rows__section">
      <h2 class="rows__heading txt-small txt-subtle"><%= t("subscribers") %></h2>
      <ul class="rows">
        <%= with_automatic_pagination :subscribers, @page do %>
          <%= render partial: "subscribers/subscriber", collection: @page.records %>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if @query && @posts.none? && @page.empty? %>
    <div class="blank-slate fit-content center"><strong><%= t("search_no_matches") %></strong></div>
  <% end %>
</div>

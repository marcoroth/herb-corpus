<%= turbo_frame_tag :user_identity do %>
  <section class="settings__section">
    <div class="flex align-center gap">
      <%= avatar_tag user.name_in_database, user.identity&.email_address %>

      <div class="details margin-none flex-item-grow">
        <div class="details__heading">
          <%= form_with model: user, method: :patch, class: "flex gap-half", data: { controller: "form" } do |form| %>
            <strong class="full-width"><%= form.text_field :name, required: true, autocomplete: "name", class: "input full-width", aria: { label: t("users_name_input_label") }, data: { action: "input->form#disableSubmitWhenInvalid" } %></strong>

            <%= form.button class: "btn btn--circle btn--link", data: { form_target: "submit" } do %>
              <%= icon_tag "arrow-right" %>
              <span class="for-screen-reader"><%= t("users_save_changes") %></span>
            <% end %>
          <% end %>

          <p class="details__meta">
            <%= t("users_role_#{user.role}") %> · <%= user.identity&.email_address %>
            · <%= link_to t("users_change_email"), new_user_email_address_path(user_id: user.id), data: { turbo_frame: "_top" } %>
          </p>
        </div>
      </div>
    </div>
  </section>
<% end %>

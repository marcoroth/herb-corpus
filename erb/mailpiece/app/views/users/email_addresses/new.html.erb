<% @page_title = t("users_change_email_title") %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= up_crumb_to t("profile"), user_path(@user, script_name: @user.account.slug) %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <div class="panel shadow">
    <%= form_with url: user_email_addresses_path(user_id: @user.id), method: :post, class: "flex flex-column gap", data: { turbo: false } do |form| %>
      <div class="flex flex-column gap-half">
        <label for="email_address">
          <strong><%= t("users_new_email_address") %></strong><br>
          <p class="margin-none txt-x-small txt-subtle"><%= t("users_email_change_enter_instructions") %></p>
        </label>
        <%= form.email_field :email_address, id: "email_address", autocomplete: "email", placeholder: t("users_new_email_address_placeholder"), autofocus: true, required: true, class: "input" %>
      </div>

      <div class="flex gap-half">
        <%= form.button t("continue"), type: "submit", class: "btn btn--link" %>
        <%= link_to t("cancel_and_go_back"), user_path(@user, script_name: @user.account.slug), class: "btn borderless" %>
      </div>
    <% end %>
  </div>
</div>

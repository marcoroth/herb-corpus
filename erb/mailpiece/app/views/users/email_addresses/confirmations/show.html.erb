<% @page_title = t("users_confirming_email_change_title") %>
<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <p class="margin-none"><%= t("users_email_address_confirmation_description") %></p>

  <%= auto_submit_form_with url: user_email_address_confirmation_path(user_id: @user.id), method: :post do |form| %>
    <%= form.hidden_field :email_address_token, value: params[:email_address_token] %>
    <%= form.button t("done"), type: "submit", class: "btn btn--link" %>
  <% end %>
</div>

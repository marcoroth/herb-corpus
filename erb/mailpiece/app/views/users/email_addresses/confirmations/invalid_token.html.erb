<% @page_title = t("users_invalid_token_title") %>
<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <p class="margin-none"><%= t("users_invalid_token_description") %></p>
  <p class="margin-none"><%= link_to t("users_change_my_email_address"), new_user_email_address_path(user_id: @user, script_name: @user.account.slug) %></p>
  <% if support_email_address %>
    <p class="margin-none txt-small"><%= t("support_stuck_html", link: mail_to(support_email_address, t("support_email_link_inline"))) %></p>
  <% end %>
</div>

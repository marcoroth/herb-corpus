<% @page_title = t("users_check_email_title") %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= up_crumb_to t("profile"), user_path(@user, script_name: @user.account.slug) %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <p class="margin-none"><%= t("users_email_address_confirmation_sent_html", email: params[:email_address]) %></p>
  <p class="margin-none"><%= t("users_email_address_confirmation_click") %></p>
  <p class="margin-none"><%= link_to t("done"), user_path(@user, script_name: @user.account.slug) %></p>
</div>

<% @page_title = @user.name_in_database %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <% if Current.user.admin? %>
        <%= home_crumb %>
        <%= up_crumb_to t("settings"), account_settings_path %>
      <% else %>
        <%= home_crumb up: true %>
      <% end %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page">
  <div class="settings settings--profile">
    <div class="settings__panel panel shadow">
      <%= render "users/identity", user: @user %>

      <section class="settings__section">
        <header>
          <h2 class="divider txt-medium txt-tight-lines"><%= t("users_sign_in_section") %></h2>
        </header>

        <ul class="rows">
          <%= render "users/passkeys", count: Current.identity.passkeys.count %>
          <%= render "users/access_tokens", count: Current.identity.access_tokens.count %>
        </ul>
      </section>

      <%= render "users/theme" %>

      <% if Current.user.admin? %>
        <section class="settings__section">
          <header>
            <h2 class="divider txt-medium txt-tight-lines"><%= t("users_notifications") %></h2>
          </header>

          <ul class="rows">
            <li class="row">
              <%= link_to notifications_settings_path, class: "row__body" do %>
                <strong class="row__title"><%= t("users_notification_settings") %></strong>
                <span class="row__meta"><%= t("users_notification_settings_new_subscriber") %></span>
              <% end %>
            </li>
          </ul>
        </section>

        <section class="settings__section">
          <header>
            <h2 class="divider txt-medium txt-tight-lines"><%= t("users_people") %></h2>
          </header>

          <ul class="rows">
            <li class="row">
              <%= link_to account_join_code_path, class: "row__body" do %>
                <strong class="row__title"><%= t("users_add_users") %></strong>
                <span class="row__meta"><%= t("users_people_description") %></span>
              <% end %>
            </li>
          </ul>
        </section>
      <% end %>

      <section class="settings__section">
        <header>
          <h2 class="divider txt-medium txt-tight-lines"><%= t("users_sign_out") %></h2>
        </header>

        <%= button_to t("users_sign_out"), session_path(script_name: nil), method: :delete, class: "btn", form: { data: { turbo: false } } %>
      </section>
    </div>
  </div>
</div>

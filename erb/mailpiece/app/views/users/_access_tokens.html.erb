<li class="row">
  <%= link_to my_access_tokens_path, class: "row__body flex-item-grow" do %>
    <strong class="row__title"><%= t("my_access_tokens") %></strong>
    <span class="row__meta"><%= t("users_access_tokens_hint") %></span>
  <% end %>

  <span class="row__end"><%= count.zero? ? t("users_none_yet") : t("users_token_count", count: count) %></span>
</li>

<li class="row">
  <%= link_to my_passkeys_path, class: "row__body flex-item-grow" do %>
    <strong class="row__title"><%= t("my_passkey_index_title") %></strong>
    <span class="row__meta"><%= t("users_passkeys_hint") %></span>
  <% end %>

  <span class="row__end"><%= count.zero? ? t("users_none_yet") : t("users_passkey_count", count: count) %></span>
</li>

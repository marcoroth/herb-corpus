<% @page_title = @journey.label %>
<% emails = @journey.emails.to_a %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= link_to t("posts"), posts_path %>
      <span class="breadcrumbs__separator">▸</span>
      <%= up_crumb_to t("journeys_title"), journeys_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page">
  <% if emails.any? %>
    <ul class="rows">
      <%= render partial: "journeys/emails/email", collection: emails, locals: { journey: @journey } %>
    </ul>
  <% end %>

  <% if @journey.addable? %>
    <%= link_to t("journeys_new"), new_journey_email_path(@journey), class: "btn btn--plain txt-link txt-small steps__add" %>
  <% end %>
</div>

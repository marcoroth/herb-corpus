<% @page_title = t("journeys_new") %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= link_to t("posts"), posts_path %>
      <span class="breadcrumbs__separator">▸</span>
      <%= link_to t("journeys_title"), journeys_path %>
      <span class="breadcrumbs__separator">▸</span>
      <%= link_to @journey.label, journey_path(@journey) %>
      <span class="breadcrumbs__separator">▸</span>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page writing">
  <%= form_with model: @email, url: journey_emails_path(@journey), class: "writing__form", style: "view-transition-name: #{dom_id(@email)}", data: { controller: "autoresize advance-to-editor" } do |form| %>
    <%= render "journeys/emails/fields", form: form, email: @email %>

    <div class="writing-bar post-actions">
      <%= form.button type: "submit", class: "btn btn--link post-actions__main" do %>
        <span><%= t("save") %></span>
      <% end %>
      <%= link_to t("cancel_and_go_back"), journey_path(@journey), class: "btn borderless" %>
    </div>
  <% end %>
</div>

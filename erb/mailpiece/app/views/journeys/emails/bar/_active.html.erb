<div class="display-contents"
     data-controller="dialog"
     data-dialog-orient-value="false"
     data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
  <span class="post-actions__split post-actions__main">
    <%= form.button type: "submit", class: "btn btn--link post-actions__primary" do %>
      <span><%= t("save") %></span>
    <% end %>
    <button type="button"
            class="btn btn--link post-actions__more"
            aria-label="<%= t("journeys_more") %>"
            aria-haspopup="dialog"
            data-action="dialog#toggle">
      <%= icon_tag "caret-down" %>
    </button>
  </span>

  <dialog class="popup post-pop post-pop--menu"
          aria-label="<%= t("journeys_menu_label") %>"
          data-dialog-target="dialog"
          data-action="post-bar:submitted->dialog#close">
    <%= form.button type: "submit", name: "_method", value: "delete", formaction: journey_email_activation_path(journey, email), formnovalidate: true,
          class: "post-pop__item btn" do %>
      <span class="txt-negative"><%= t("journeys_deactivate") %></span>
    <% end %>

    <%= render "journeys/emails/bar/delay", form: form, journey: journey, email: email %>

    <% if !email.deliverable? %>
      <p><%= t("posts_email_not_set_up_html", link: link_to(t("posts_finish_settings"), settings_path_to_finish_sending)) %></p>
    <% end %>
  </dialog>
</div>

<%= render "journeys/emails/bar/test_delivery", form: form, journey: journey, email: email if email.testable? %>

<% if journey.delayed? %>
  <span class="post-pop__heading"><%= t("journeys_delay") %></span>
  <div class="post-pop__when">
    <%= form.number_field :delay_days, id: nil, class: "input", min: 0, step: 1,
          aria: { label: t("journeys_delay") },
          data: { action: token_list("keydown.enter->dialog#close:prevent", "auto-save#change": email.draft?) } %>
    <%= form.select :send_hour, journey_email_hour_options(email), { include_blank: t("journeys_any_hour") },
          id: nil, class: "input input--select", autocomplete: "off", aria: { label: t("posts_schedule_hour") },
          data: { action: token_list("keydown.enter->dialog#close:prevent", "auto-save#change": email.draft?) } %>
  </div>
<% end %>

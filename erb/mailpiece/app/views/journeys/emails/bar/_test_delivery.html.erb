<div class="display-contents"
     data-controller="dialog"
     data-dialog-orient-value="false"
     data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
  <button type="button" class="btn btn--plain txt-link post-actions__beside" aria-haspopup="dialog" data-action="dialog#toggle">
    <span><%= t("posts_send_test") %></span>
  </button>

  <dialog class="popup post-pop" aria-label="<%= t("posts_send_test") %>" data-dialog-target="dialog" data-action="post-bar:submitted->dialog#close">
    <div class="post-pop__test" data-controller="clicker">
      <%= text_field_tag :email_address, params.fetch(:email_address, Current.identity.email_address), id: nil, class: "input",
            inputmode: "email", autocomplete: "email", placeholder: t("posts_test_address"), aria: { label: t("posts_test_address") },
            data: { action: "keydown.enter->clicker#click:prevent" } %>
      <%= form.button type: "submit",
            name: "_method",
            value: "post",
            formaction: journey_email_test_delivery_path(journey, email),
            class: "btn",
            data: { clicker_target: "clickable" } do %>
        <span><%= t("posts_send_test") %></span>
      <% end %>
    </div>
  </dialog>
</div>

<% @page_title = @email.subject_in_database.presence || t("untitled") %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= link_to t("posts"), posts_path %>
      <span class="breadcrumbs__separator">▸</span>
      <%= link_to t("journeys_title"), journeys_path %>
      <span class="breadcrumbs__separator">▸</span>
      <%= link_to @journey.label, journey_path(@journey) %>
      <span class="breadcrumbs__separator">▸</span>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page writing" data-controller="post-bar">
  <%# The form itself is the save, which is what auto-save submits. Every other button posts to its own resource and
      carries its own _method, which comes after the form's and so replaces it. %>
  <%= form_with model: @email, url: journey_email_path(@journey, @email), class: "writing__form", style: "view-transition-name: #{dom_id(@email)}", data: post_editor_data(@email) do |form| %>
    <%= render "journeys/emails/fields", form: form, email: @email, auto_save: @email.draft? %>

    <% if @email.draft? %>
      <%# Only a draft's editor carries it, so an auto-save, a test or a switch from a tab left open on an email switched on since is refused. %>
      <%= hidden_field_tag :auto_save, true, id: nil %>
    <% end %>

    <div class="writing-bar post-actions" data-controller="dialog-manager">
      <% if @email.active? %>
        <%= render "journeys/emails/bar/active", form: form, journey: @journey, email: @email %>
      <% else %>
        <%= render "journeys/emails/bar/draft", form: form, journey: @journey, email: @email %>
      <% end %>

      <%= render "journeys/emails/bar/delete", form: form, journey: @journey, email: @email %>
      <%= journey_email_bar_state(@email) %>
    </div>
  <% end %>
</div>

<%= tag.li id: dom_id(email), class: "row", style: "view-transition-name: #{dom_id email}" do %>
  <%= link_to edit_journey_email_path(journey, email), class: "row__body flex-item-grow" do %>
    <strong class="row__title"><%= journey_email_subject(email) %></strong>
    <span class="row__meta"><%= journey_email_meta(email) %></span>
  <% end %>

  <%= render "journeys/emails/actions", journey: journey, email: email %>
<% end %>

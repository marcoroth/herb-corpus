<% @page_title = t("users_notification_settings") %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= up_crumb_to t("profile"), user_path(Current.user) %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page">
  <div class="settings settings--profile">
    <div class="settings__panel panel shadow">
      <%= render "notifications/settings/email", settings: @settings %>
    </div>
  </div>
</div>

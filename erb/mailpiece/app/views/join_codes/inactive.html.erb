<% @page_title = t("sessions_invitation_inactive_heading") %>
<% turbo_exempts_page_from_cache %>
<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <p class="margin-none"><%= t("sessions_invitation_inactive_body", account: @join_code.account.name) %></p>
</div>

<% content_for :footer do %>
  <%= render "sessions/footer" %>
<% end %>

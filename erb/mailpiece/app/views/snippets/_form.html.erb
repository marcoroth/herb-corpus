<%= form_with model: snippet, class: "writing__form", style: "view-transition-name: #{dom_id(snippet)}", data: { controller: "autoresize advance-to-editor" } do |form| %>
  <%= render "shared/errors", record: snippet %>

  <%= form.label :name,
        class: "autoresize__wrapper post-form__heading",
        data: { autoresize_target: "wrapper", autoresize_clone_value: "" } do %>
    <%= form.text_area :name,
          autofocus: snippet.new_record?,
          required: true,
          maxlength: 255,
          rows: 1,
          dir: "auto",
          class: "input autoresize__textarea post-form__title",
          placeholder: t("snippets_name_label"),
          aria: { label: t("snippets_name_label") },
          data: { autoresize_target: "textarea", action: "input->autoresize#resize keydown.enter->advance-to-editor#advance" } %>
  <% end %>

  <%= form.rich_textarea :content,
        class: "lexxy-content",
        placeholder: t("posts_body_placeholder"),
        aria: { label: t("snippets_content_label") },
        data: { advance_to_editor_target: "editor" } %>

  <div class="writing-bar post-actions">
    <%= form.button type: "submit", class: "btn btn--link post-actions__main" do %>
      <span><%= t("save") %></span>
    <% end %>
    <%= link_to t("cancel_and_go_back"), snippets_path, class: "btn borderless" %>

    <% if snippet.persisted? %>
      <%= form.button type: "submit", name: "_method", value: "delete", formaction: snippet_path(snippet), formnovalidate: true,
            class: "btn txt-negative borderless fill-transparent flex-item-justify-end",
            data: { turbo_confirm: t("snippets_delete_confirm", name: snippet.name_in_database) } do %>
        <%= icon_tag "trash" %>
        <span class="for-screen-reader"><%= t("snippets_delete_button") %></span>
      <% end %>
    <% end %>
  </div>
<% end %>

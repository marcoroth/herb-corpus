<% @page_title = t("snippets_title") %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= up_crumb_to t("posts"), posts_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end">
    <%= new_link_to t("snippets_add_title"), new_snippet_path %>
  </div>
<% end %>

<div class="page flex flex-column gap">
  <% if Current.account.snippets.exists? %>
    <%= render layout: "shared/filter", locals: { what: t("snippets_filter_what") } do %>
      <div data-controller="navigable-list" data-action="keydown->navigable-list#navigate turbo:before-visit@document->navigable-list#rememberSelection turbo:frame-load->navigable-list#forgetSelection"
            data-navigable-list-actionable-items-value="true">
        <ul class="rows">
          <%= with_automatic_pagination :snippets, @page do %>
            <%= render partial: "snippets/snippet", collection: @page.records %>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% else %>
    <div class="blank-slate fit-content center"><%= t("snippets_empty_html", link: link_to(t("snippets_empty_link"), new_snippet_path)) %></div>
  <% end %>
</div>

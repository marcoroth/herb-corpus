<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <%= render "layouts/shared/head" %>

  <body class="public <%= @body_class %>" data-controller="reader-time timezone-cookie live-region lightbox" data-action="turbo:morph@window->reader-time#refreshAll" data-platform="<%= platform.type %>">
    <div id="global-container">
      <header class="header" id="header">
        <a href="#main" class="header__skip-navigation btn" data-turbo="false"><%= t("skip_to_main_content") %></a>

        <div class="site-header">
          <%= link_to root_path, class: "site-header__brand" do %>
            <% if Current.account %>
              <%= account_avatar_tag(Current.account, class: "site-header__logo") || tag.span(Current.account.name, class: "site-header__account-name") %>
            <% else %>
              <span class="site-header__account-name">Mailpiece</span>
            <% end %>
          <% end %>
        </div>
      </header>

      <% if content_for?(:header) %>
        <div class="strip" data-controller="breadcrumbs" data-breadcrumbs-expanded-class="breadcrumbs--expanded"
          data-action="click->breadcrumbs#toggle keydown.enter->breadcrumbs#toggle keydown.space->breadcrumbs#toggle resize@window->breadcrumbs#refresh turbo:morph@window->breadcrumbs#refresh">
          <%= yield :header %>
        </div>
      <% end %>

      <%= render "layouts/shared/flash" %>

      <main id="main">
        <%= yield %>
      </main>
    </div>

    <footer id="footer">
      <%= yield :footer %>

      <%= render "layouts/shared/back_to_top" %>
    </footer>

    <%= render "layouts/shared/live_region" %>
    <%= render "layouts/lightbox" %>
  </body>
</html>

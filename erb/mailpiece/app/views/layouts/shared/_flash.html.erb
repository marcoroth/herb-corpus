<%= turbo_frame_tag :flash do %>
  <% if notice = flash[:notice] || flash[:alert] %>
    <div class="flash" data-controller="element-removal" data-action="animationend->element-removal#remove" data-live-region-target="announcement">
      <div class="flash__inner shadow">
        <%= notice %>
      </div>
    </div>
  <% end %>

  <template data-flash-template>
    <div class="flash" data-controller="element-removal" data-action="animationend->element-removal#remove" data-live-region-target="announcement">
      <div class="flash__inner shadow"></div>
    </div>
  </template>
<% end %>

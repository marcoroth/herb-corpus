<%# Adapted from Writebook (37signals, MIT licence). The form closes the dialog with no script of ours. %>
<dialog class="lightbox dialog" aria-label="<%= t("lightbox_label") %>" data-lightbox-target="dialog" data-action="close->lightbox#reset click->lightbox#closeOnBackdrop">
  <img class="lightbox__image" alt="" data-lightbox-target="zoomedImage">

  <form method="dialog" class="lightbox__close">
    <button class="btn" title="<%= t("lightbox_close_title") %>">
      <%= icon_tag "close" %>
      <span class="for-screen-reader"><%= t("lightbox_close") %></span>
    </button>
  </form>
</dialog>

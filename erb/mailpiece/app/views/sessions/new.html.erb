<% @page_title = t("sessions_sign_in") %>
<% turbo_exempts_page_from_cache %>
<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="panel panel--centered flex flex-column gap-half">
  <%= form_with url: session_path, class: "flex flex-column gap-half txt-medium" do |form| %>
    <div class="flex flex-column gap-half txt-align-start">
      <label for="email_address"><strong><%= t("email") %></strong></label>
      <%= form.email_field :email_address, id: "email_address", required: true, autofocus: true, autocomplete: "username webauthn", placeholder: t("sessions_email_placeholder"), class: "input txt-large full-width" %>
    </div>

    <p class="margin-block-half"><%= t("sessions_sign_in_link_only_instruction") %></p>

    <%= form.button t("sessions_sign_in"), type: "submit", class: "btn btn--link center txt-medium" %>
  <% end %>

  <div class="margin-block-start">
    <%= passkey_sign_in_button t("sessions_passkey_sign_in_button"), session_passkey_path, options: @authentication_options, mediation: "conditional",
          error: { class: "txt-negative txt-small", message: t("sessions_passkey_sign_in_error") },
          cancellation: { class: "txt-subtle txt-small", message: t("sessions_passkey_sign_in_cancelled") },
          class: "btn btn--plain txt-link center txt-small" %>
  </div>
</div>

<% content_for :footer do %>
  <%= render "sessions/footer" %>
<% end %>

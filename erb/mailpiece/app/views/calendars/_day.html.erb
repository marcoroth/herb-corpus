<%= tag.li id: "calendar_day_#{day.iso8601}", class: "calendar__day", aria: { current: ("date" if day.today?) } do %>
  <div class="calendar__head">
    <%= render "calendars/date", day: day %>

    <% if day.day == 1 %>
      <span class="calendar__month"><%= l day, format: :month_and_year %></span>
    <% elsif day_counter.zero? %>
      <span class="calendar__month"><%= t("date.month_names")[day.month] %></span>
    <% end %>
  </div>

  <%= render partial: "calendars/entry", collection: calendar.posts_on(day), as: :post %>
<% end %>

<%= tag.li id: "calendar_day_#{day.iso8601}", class: "calendar__agenda-day", aria: { current: ("date" if day.today?) } do %>
  <div class="calendar__head">
    <%= render "calendars/date", day: day %>
    <span class="calendar__month"><%= t("date.abbr_month_names")[day.month] %></span>
  </div>

  <%= render partial: entry, collection: calendar.posts_on(day), as: :post, locals: { calendar: calendar } %>
<% end %>

<ol class="calendar__agenda">
  <% if calendar.agenda_days.any? %>
    <%= render partial: "calendars/agenda_day", collection: calendar.agenda_days, as: :day,
          locals: { calendar: calendar, entry: local_assigns.fetch(:entry, "calendars/entry") } %>
  <% else %>
    <li class="calendar__nothing"><%= t("calendar_nothing_between", from: l(calendar.from, format: :public_post), to: l(calendar.last_day, format: :public_post)) %></li>
  <% end %>
</ol>

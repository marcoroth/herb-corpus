<% @page_title = t("calendar_title") %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb up: true %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end">
    <%= toolbar_button t("calendar_agenda"), calendar_agenda_path(params[:date]), icon: "menu", current: controller_name == "agenda" %>
    <%= toolbar_button t("calendar_weeks"), calendar_week_path(params[:date]), icon: "grid", current: controller_name == "weeks", class: "calendar__weeks-button" %>
    <%= toolbar_button t("calendar_today"), url_for(date: Time.zone.today.iso8601), icon: "calendar" %>
    <%= new_link_to t("posts_new"), new_post_path %>
  </div>
<% end %>

<div class="page calendar">
  <%= turbo_frame_tag "calendar", class: "calendar__weeks", target: "_top", data: { controller: "pagination", pagination_paginate_on_intersection_value: paginate_on_intersection } do %>
    <%= calendar_frame_tag calendar do %>
      <%= yield %>
    <% end %>
  <% end %>
</div>

<% @page_title = Current.account.name %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb(url: session_menu_path(script_name: nil), label: t("accounts")) if Current.identity.accounts.active.many? %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <ul class="rows">
    <li class="row">
      <%= link_to user_path(Current.user), class: "row__body" do %>
        <strong class="row__title"><%= t("profile") %></strong>
      <% end %>
    </li>
  </ul>
</div>

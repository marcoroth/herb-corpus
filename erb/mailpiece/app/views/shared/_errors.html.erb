<% if record.errors.any? %>
  <%= tag.div id: dom_id(record, :errors), class: "error-explanation shake", role: "alert", tabindex: "-1", data: { controller: "errors" } do %>
    <ul class="error-explanation__list">
      <% record.errors.full_messages.each do |message| %>
        <li class="error-explanation__message"><%= message %></li>
      <% end %>
    </ul>
  <% end %>
<% end %>

<% disabled = local_assigns.fetch(:disabled, false) %>

<%= form_with url: url, method: (on ? :delete : :post), class: "display-contents",
      data: { controller: "form" }.merge(local_assigns.fetch(:form_data, {})) do %>
  <label class="switch">
    <%= check_box_tag :switch, "1", on, id: nil, class: "switch__input", disabled: disabled,
          aria: { label: label }, data: { action: "change->form#submit" }.merge(local_assigns.fetch(:checkbox_data, {})) %>
    <span class="switch__btn"></span>
  </label>
<% end %>

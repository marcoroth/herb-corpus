<li class="row">
  <div class="row__body flex-item-grow">
    <strong class="row__title"><%= title %></strong>
    <span class="row__meta"><%= meta.join(" · ") %></span>
  </div>

  <span class="step__actions">
    <%= link_to edit_path, class: "btn btn--circle", aria: { label: t("account_outgoing_mail_edit") } do %>
      <%= icon_tag "pencil" %>
      <span class="for-screen-reader"><%= t("account_outgoing_mail_edit") %></span>
    <% end %>
    <%= button_to path, method: :delete, class: "btn btn--circle", aria: { label: t("account_outgoing_mail_remove") },
          data: { turbo_confirm: t("account_outgoing_mail_remove_confirm") } do %>
      <%= icon_tag "trash" %>
      <span class="for-screen-reader"><%= t("account_outgoing_mail_remove") %></span>
    <% end %>
  </span>
</li>

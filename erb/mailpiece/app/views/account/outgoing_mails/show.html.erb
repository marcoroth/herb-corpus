<% @page_title = t("account_outgoing_mail_title") %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= up_crumb_to t("settings"), account_settings_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <% if @sender.relay? %>
    <ul class="rows">
      <%= render "account/outgoing_mails/transport", title: t("account_outgoing_mail_over_relay"), path: account_sender_relay_path, edit_path: edit_account_sender_relay_path,
            meta: [ @sender.relay_url, t("account_outgoing_mail_token_set") ] %>
    </ul>
  <% elsif @sender.smtp? %>
    <ul class="rows">
      <%= render "account/outgoing_mails/transport", title: t("account_outgoing_mail_over_smtp_server"), path: account_sender_smtp_server_path, edit_path: edit_account_sender_smtp_server_path,
            meta: [ "#{@sender.smtp_address}:#{@sender.smtp_port}", @sender.smtp_username.present? ? t("account_outgoing_mail_password_set") : t("account_outgoing_mail_no_sign_in") ] %>
    </ul>
  <% else %>
    <div class="blank-slate fit-content center">
      <%= t("account_outgoing_mail_empty_html", relay: link_to(t("account_outgoing_mail_empty_relay"), edit_account_sender_relay_path),
            smtp_server: link_to(t("account_outgoing_mail_empty_smtp_server"), edit_account_sender_smtp_server_path)) %>
    </div>
  <% end %>
</div>

<%= turbo_frame_tag account, :welcome, target: "_top", class: "flex flex-column gap" do %>
  <div class="publication">
    <header>
      <h2 class="txt-medium txt-tight-lines margin-none"><%= t("account_welcome_title") %></h2>
      <p class="txt-small txt-subtle margin-none"><%= account.welcoming? ? t("account_welcome_on_description") : t("account_welcome_off_description") %></p>
    </header>

    <% if account.welcoming? %>
      <div class="publication__box publication__box--published">
        <div class="publication__switch">
          <%= icon_tag "lock" %>
          <%= render "shared/switch", url: account_welcome_path, on: true, label: t("account_welcome_deactivate_label") %>
          <%= icon_tag "world" %>
        </div>
      </div>
    <% else %>
      <div class="publication__box">
        <div class="publication__switch">
          <%= icon_tag "lock" %>
          <%= render "shared/switch", url: account_welcome_path, on: false, label: t("account_welcome_activate_label") %>
          <%= icon_tag "world" %>
        </div>
      </div>
    <% end %>
  </div>

  <% if account.welcoming? %>
    <%= form_with model: account, url: account_newsletter_path, method: :patch, class: "flex flex-column gap" do |form| %>
      <div class="flex flex-column gap-half">
        <%= form.label :welcome_message do %>
          <strong><%= t("account_welcome_message_label") %></strong>
          <br>
          <p class="margin-none txt-x-small txt-subtle"><%= t("account_welcome_message_hint") %></p>
        <% end %>
        <%= form.rich_textarea :welcome_message, class: "lexxy-content input", aria: { label: t("account_welcome_message_label") } %>
      </div>

      <div class="flex gap-half">
        <%= form.button t("save"), type: "submit", class: "btn btn--link" %>
      </div>
    <% end %>
  <% end %>
<% end %>

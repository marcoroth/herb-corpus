<% @page_title = t("account_newsletter_title") %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= link_to t("settings"), account_settings_path %>
      <span class="breadcrumbs__separator">▸</span>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page">
  <div class="settings">
    <div class="settings__panel panel shadow">
      <section class="settings__section">
        <%= form_with model: @account, url: account_newsletter_path, method: :patch, class: "flex flex-column gap", data: { controller: "upload-preview" } do |form| %>
          <%= render "shared/errors", record: @account %>

          <div class="flex flex-column gap-half">
            <strong><%= t("account_newsletter_logo_label") %></strong>

            <div class="align-center center avatar__form gap">
              <span class="btn btn--placeholder txt-small"></span>

              <label class="avatar avatar--icon avatar--square input--file txt-xx-large">
                <% if @account.avatar.persisted? %>
                  <%= image_tag account_avatar_path, aria: { hidden: "true" }, size: 64, data: { upload_preview_target: "image" } %>
                <% else %>
                  <%= icon_tag "camera" %>
                  <%= tag.img aria: { hidden: "true" }, data: { upload_preview_target: "image" } %>
                <% end %>
                <%= form.file_field :avatar, class: "input", accept: Account::Avatar::ALLOWED_AVATAR_CONTENT_TYPES.join(","),
                      data: { upload_preview_target: "input", action: "upload-preview#previewImage" } %>
                <span class="for-screen-reader"><%= t("account_newsletter_logo_label") %></span>
              </label>

              <% if @account.avatar.persisted? %>
                <%= tag.button type: :submit, form: "avatar-delete-form", class: "btn btn--negative txt-small", data: { turbo_confirm: t("account_newsletter_logo_remove_confirm") } do %>
                  <%= icon_tag "minus" %>
                  <span class="for-screen-reader"><%= t("account_newsletter_logo_remove") %></span>
                <% end %>
              <% end %>
            </div>
          </div>

          <div class="flex flex-column gap-half">
            <%= form.label :name do %>
              <strong><%= t("account_newsletter_name_label") %></strong>
            <% end %>
            <%= form.text_field :name, required: true, class: "input" %>
          </div>

          <div class="flex flex-column gap-half">
            <%= form.label :description do %>
              <strong><%= t("account_newsletter_description_label") %></strong>
            <% end %>
            <%= form.rich_textarea :description, class: "lexxy-content input", aria: { label: t("account_newsletter_description_label") } %>
          </div>

          <div class="flex flex-column gap-half">
            <%= form.label :locale do %>
              <strong><%= t("language") %></strong>
            <% end %>
            <%= form.select :locale, Account::Localizable::LOCALES.collect { [ t("language_#{it}"), it ] },
                  { selected: @account.locale || I18n.default_locale.to_s }, class: "input input--select" %>
          </div>

          <div class="flex gap-half">
            <%= form.button t("save"), type: "submit", class: "btn btn--link" %>
            <%= link_to t("cancel_and_go_back"), account_settings_path, class: "btn borderless" %>
          </div>
        <% end %>

        <% if @account.avatar.persisted? %>
          <%= form_with url: account_avatar_path, method: :delete, id: "avatar-delete-form" %>
        <% end %>
      </section>
    </div>
  </div>
</div>

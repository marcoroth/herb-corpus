<% @page_title = t("account_subscribe_form_title") %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= up_crumb_to t("settings"), account_settings_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page">
  <div class="settings">
    <div class="settings__panel panel shadow">
      <section class="settings__section">
        <% snippet = subscribe_form_snippet %>

        <pre class="input settings__snippet txt-mono txt-small" id="subscribe-form-snippet" aria-label="<%= t("account_subscribe_form_title") %>"><%= snippet %></pre>

        <div class="flex flex-wrap align-center gap">
          <%= button_to_copy_to_clipboard snippet do %>
            <%= icon_tag "copy-paste" %>
            <span><%= t("account_subscribe_form_copy_button") %></span>
          <% end %>
        </div>

        <%= form_with model: @account, url: account_subscribe_form_path, method: :patch, class: "flex flex-column gap" do |form| %>
          <%= render "shared/errors", record: @account %>

          <div class="flex flex-column gap-half">
            <%= form.label :subscription_return_url do %>
              <strong><%= t("account_subscribe_form_return_url_label") %></strong>
            <% end %>
            <%= form.url_field :subscription_return_url, placeholder: "https://", class: "input" %>
          </div>

          <div class="flex gap-half">
            <%= form.button t("save"), type: "submit", class: "btn btn--link" %>
            <%= link_to t("cancel_and_go_back"), account_settings_path, class: "btn borderless" %>
          </div>
        <% end %>
      </section>
    </div>
  </div>
</div>

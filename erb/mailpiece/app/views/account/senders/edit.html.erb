<% @page_title = t("account_sender_title") %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= up_crumb_to t("settings"), account_settings_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page">
  <div class="settings">
    <div class="settings__panel panel shadow">
      <section class="settings__section">
        <%= form_with model: @sender, url: account_sender_path, method: :patch, class: "flex flex-column gap" do |form| %>
          <%= render "shared/errors", record: @sender %>

          <div class="flex flex-column gap-half">
            <%= form.label :from_name do %>
              <strong><%= t("account_sender_from_name_label") %></strong>
            <% end %>
            <%= form.text_field :from_name, class: "input" %>
          </div>

          <div class="flex flex-column gap-half">
            <%= form.label :from_address do %>
              <strong><%= t("account_sender_from_address_label") %></strong><br>
              <p class="margin-none txt-x-small txt-subtle"><%= t("account_sender_from_address_hint") %></p>
            <% end %>
            <%= form.email_field :from_address, class: "input" %>
          </div>

          <div class="flex flex-column gap-half">
            <%= form.label :reply_to_address do %>
              <strong><%= t("account_sender_reply_to_label") %></strong>
            <% end %>
            <%= form.email_field :reply_to_address, class: "input" %>
          </div>

          <div class="flex gap-half">
            <%= form.button t("save"), type: "submit", class: "btn btn--link" %>
            <%= link_to t("cancel_and_go_back"), account_settings_path, class: "btn borderless" %>
          </div>
        <% end %>
      </section>
    </div>
  </div>
</div>

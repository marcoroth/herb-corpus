<% @page_title = t("account_sender_relay_title") %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= up_crumb_to t("settings"), account_settings_path %>
      <%= up_crumb_to t("account_outgoing_mail_title"), account_outgoing_mail_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page">
  <div class="settings">
    <div class="settings__panel panel shadow">
      <section class="settings__section">
        <%= form_with model: @sender, url: account_sender_relay_path, method: :patch, class: "flex flex-column gap" do |form| %>
          <%= render "shared/errors", record: @sender %>

          <div class="flex flex-column gap-half">
            <%= form.label :relay_url do %>
              <strong><%= t("account_sender_relay_url_label") %></strong>
            <% end %>
            <%= form.url_field :relay_url, class: "input", autocapitalize: "none", autocorrect: "off", spellcheck: false %>
          </div>

          <% if @sender.relay_token_in_database.present? %>
            <p class="margin-none txt-small txt-subtle"><%= t("account_sender_relay_token_set_hint") %></p>
          <% else %>
            <div class="flex flex-column gap-half">
              <%= form.label :relay_token do %>
                <strong><%= t("account_sender_relay_token_label") %></strong>
              <% end %>
              <%= form.password_field :relay_token, class: "input", autocomplete: "new-password" %>
            </div>
          <% end %>

          <div class="flex gap-half">
            <%= form.button t("save"), type: "submit", class: "btn btn--link" %>
            <%= link_to t("cancel_and_go_back"), account_outgoing_mail_path, class: "btn borderless" %>
          </div>
        <% end %>
      </section>
    </div>
  </div>
</div>

<% @page_title = t("account_sender_smtp_server_title") %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= up_crumb_to t("settings"), account_settings_path %>
      <%= up_crumb_to t("account_outgoing_mail_title"), account_outgoing_mail_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page">
  <div class="settings">
    <div class="settings__panel panel shadow">
      <section class="settings__section">
        <%= form_with model: @sender, url: account_sender_smtp_server_path, method: :patch, class: "flex flex-column gap" do |form| %>
          <%= render "shared/errors", record: @sender %>

          <div class="flex flex-column gap-half">
            <%= form.label :smtp_address do %>
              <strong><%= t("account_sender_smtp_address_label") %></strong>
            <% end %>
            <%= form.text_field :smtp_address, class: "input", autocapitalize: "none", autocorrect: "off", spellcheck: false %>
          </div>

          <div class="flex flex-column gap-half">
            <%= form.label :smtp_port do %>
              <strong><%= t("account_sender_smtp_port_label") %></strong><br>
              <p class="margin-none txt-x-small txt-subtle"><%= t("account_sender_smtp_port_hint") %></p>
            <% end %>
            <%= form.number_field :smtp_port, value: @sender.smtp_port || 587, class: "input" %>
          </div>

          <div class="flex flex-column gap-half">
            <%= form.label :smtp_username do %>
              <strong><%= t("account_sender_smtp_username_label") %></strong>
            <% end %>
            <%= form.text_field :smtp_username, class: "input", autocomplete: "off", autocapitalize: "none", autocorrect: "off", spellcheck: false %>
          </div>

          <% if @sender.smtp_password_in_database.present? %>
            <p class="margin-none txt-small txt-subtle"><%= t("account_sender_smtp_password_set_hint") %></p>
          <% else %>
            <div class="flex flex-column gap-half">
              <%= form.label :smtp_password do %>
                <strong><%= t("account_sender_smtp_password_label") %></strong>
              <% end %>
              <%= form.password_field :smtp_password, class: "input", autocomplete: "new-password" %>
            </div>
          <% end %>

          <div class="flex gap-half">
            <%= form.button t("save"), type: "submit", class: "btn btn--link" %>
            <%= link_to t("cancel_and_go_back"), account_outgoing_mail_path, class: "btn borderless" %>
          </div>
        <% end %>
      </section>
    </div>
  </div>
</div>

<% @page_title = t("account_handle_title") %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= up_crumb_to t("settings"), account_settings_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page">
  <div class="settings">
    <div class="settings__panel panel shadow">
      <section class="settings__section">
        <%= form_with model: @account, url: account_handle_path, method: :patch, class: "flex flex-column gap" do |form| %>
          <%= render "shared/errors", record: @account %>

          <div class="flex flex-column gap-half">
            <%= form.label :handle do %>
              <strong><%= t("account_handle_name_label") %></strong>
              <% if @account.handle_in_database %>
                <% numbered_url = root_url(script_name: @account.numbered_slug) %>
                <br>
                <p class="margin-none txt-x-small txt-subtle"><%= t("account_handle_numbered_address_html", link: link_to(numbered_url, numbered_url)) %></p>
              <% end %>
            <% end %>
            <%= form.text_field :handle, class: "input", maxlength: Account::Addressable::HANDLE_LENGTH.max, autocapitalize: "none", autocorrect: "off", spellcheck: false %>
          </div>

          <div class="flex gap-half">
            <%= form.button t("save"), type: "submit", class: "btn btn--link",
                  data: { turbo_confirm: (t("account_handle_confirm") if @account.handle_in_database) } %>
            <%= link_to t("cancel_and_go_back"), account_settings_path, class: "btn borderless" %>
          </div>
        <% end %>
      </section>
    </div>
  </div>
</div>

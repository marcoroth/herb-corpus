<% @page_title = t("account_domain_title") %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= up_crumb_to t("settings"), account_settings_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page">
  <div class="settings">
    <div class="settings__panel panel shadow">
      <section class="settings__section">
        <%= form_with model: @account, url: account_domain_path, method: :patch, class: "flex flex-column gap" do |form| %>
          <%= render "shared/errors", record: @account %>

          <div class="flex flex-column gap-half">
            <%= form.label :domain do %>
              <strong><%= t("account_domain_label") %></strong>
            <% end %>
            <%= form.text_field :domain, class: "input", maxlength: Account::Addressable::DOMAIN_LENGTH, autocapitalize: "none", autocorrect: "off", spellcheck: false %>
          </div>

          <div class="flex gap-half">
            <%= form.button t("save"), type: "submit", class: "btn btn--link" %>
            <%= link_to t("cancel_and_go_back"), account_settings_path, class: "btn borderless" %>
          </div>
        <% end %>
      </section>
    </div>
  </div>
</div>

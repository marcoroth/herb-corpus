<% @page_title = t("account_join_code_change_limit_title") %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= link_to t("profile"), user_path(Current.user) %>
      <span class="breadcrumbs__separator">▸</span>
      <%= up_crumb_to t("account_join_code_add_users"), account_join_code_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <div class="panel shadow">
    <%= form_with model: @join_code, url: account_join_code_path, method: :patch, class: "flex flex-column gap" do |form| %>
      <%= render "shared/errors", record: @join_code %>

      <div class="flex flex-column gap-half">
        <%= form.label :usage_limit do %>
          <strong><%= t("account_join_code_max_uses_label") %></strong><br>
          <p class="margin-none txt-x-small txt-subtle"><%= t("account_join_code_max_uses_hint", used: @join_code.usage_count, limit: @join_code.usage_limit_in_database) %></p>
        <% end %>
        <%= form.number_field :usage_limit, required: true, autofocus: true, in: 0..Account::JoinCode::USAGE_LIMIT_MAX, class: "input" %>
      </div>

      <div class="flex gap-half">
        <%= form.button t("save"), type: "submit", class: "btn btn--link" %>
        <%= link_to t("cancel_and_go_back"), account_join_code_path, class: "btn borderless" %>
      </div>
    <% end %>
  </div>
</div>

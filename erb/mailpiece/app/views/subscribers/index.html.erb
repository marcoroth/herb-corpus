<% @page_title = t("subscribers") %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb up: true %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end">
    <%= new_link_to t("subscribers_add_title"), new_subscribers_batch_path %>
  </div>
<% end %>

<div class="page flex flex-column gap">
  <% if Current.account.subscribers.exists? %>
    <%= render layout: "shared/filter", locals: { what: t("subscribers_filter_what"), search: search_path } do %>
      <div data-controller="navigable-list" data-action="keydown->navigable-list#navigate turbo:before-visit@document->navigable-list#rememberSelection turbo:frame-load->navigable-list#forgetSelection"
            data-navigable-list-actionable-items-value="true">
        <ul class="rows rows--links">
          <%= render "shared/count_row", title: t("status_active"), path: subscribers_active_path, count: Current.account.subscribers.active.count %>
          <%= render "shared/count_row", title: t("status_unconfirmed"), path: subscribers_unconfirmed_path, count: Current.account.subscribers.unconfirmed.count %>
          <%= render "shared/count_row", title: t("status_unsubscribed"), path: subscribers_unsubscribed_path, count: Current.account.subscribers.unsubscribed.count %>
          <%= render "shared/count_row", title: t("status_bounced"), path: subscribers_bounced_path, count: Current.account.subscribers.bounced.count %>
          <%= render "shared/count_row", title: t("status_deactivated"), path: subscribers_deactivated_path, count: Current.account.subscribers.deactivated.count %>
        </ul>
      </div>
    <% end %>
  <% else %>
    <div class="blank-slate fit-content center"><%= t "subscribers_empty_html", link: link_to(t("subscribers_empty_link"), new_subscribers_batch_path) %></div>
  <% end %>
</div>

<% @page_title = t("subscribers_add_title") %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= up_crumb_to t("subscribers"), subscribers_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
<% end %>

<div class="page flex flex-column gap">
  <div class="panel shadow flex flex-column gap">
    <%= render "subscribers/batches/form", batch: @batch, url: subscribers_batch_path %>

    <%= link_to t("subscribers_import_read_button"), new_subscribers_import_path, class: "btn btn--plain txt-link txt-small steps__add" %>
  </div>
</div>

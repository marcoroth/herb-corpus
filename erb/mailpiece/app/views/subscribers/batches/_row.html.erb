<% subscriber = row.subscriber %>
<% name = "batch[rows][#{index}]" %>

<li class="batch__row" data-repeater-target="row">
  <% unless row.ticked.nil? %>
    <%= hidden_field_tag "#{name}[added]", "0", id: nil %>
    <%= check_box_tag "#{name}[added]", "1", row.ticked, id: nil, class: "checkbox", aria: { label: t("subscribers_batch_add_row_label", number: number) } %>
  <% end %>

  <div class="batch__fields">
    <%= email_field_tag "#{name}[email]", subscriber.email, id: nil, class: "input", placeholder: t("subscribers_batch_email_placeholder"), autocomplete: "off", aria: { label: t("subscribers_batch_email_label", number: number) } %>
  </div>

  <button type="button" class="btn btn--circle btn--negative txt-x-small" data-action="repeater#remove" aria-label="<%= t "subscribers_batch_remove_row_label", number: number %>">
    <%= icon_tag "remove" %>
  </button>

  <% if subscriber.errors.any? %>
    <p class="batch__note txt-small txt-negative"><%= subscriber.errors.full_messages.to_sentence %></p>
  <% end %>
</li>

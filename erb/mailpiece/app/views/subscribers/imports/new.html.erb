<% @page_title = t("subscribers_import_title") %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= link_to t("subscribers"), subscribers_path %>
      <span class="breadcrumbs__separator">▸</span>
      <%= up_crumb_to t("subscribers_add_title"), new_subscribers_batch_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
<% end %>

<div class="page flex flex-column gap">
  <div class="panel shadow flex flex-column gap">
    <% input_id = "import_file" %>

    <div class="flex flex-column gap-half" data-controller="clicker">
      <%# The field is drawn for screen readers only: the label below opens it and takes the keys, and choosing a file sends it. %>
      <%= form_with url: subscribers_imports_path, data: { controller: "form" } do |form| %>
        <%= form.file_field :file, id: input_id, required: true, accept: ".csv,.txt,text/csv,text/plain",
              class: "visually-hidden", tabindex: -1, aria: { label: t("subscribers_import_read_button") }, data: { clicker_target: "clickable", action: "change->form#submit" } %>
      <% end %>

      <div>
        <label for="<%= input_id %>" class="btn" role="button" tabindex="0"
               data-action="keydown.enter->clicker#click:prevent keydown.space->clicker#click:prevent">
          <%= icon_tag "arrow-up" %> <span><%= t "subscribers_import_read_button" %></span>
        </label>
      </div>
      <p class="txt-small txt-subtle margin-none"><%= t "subscribers_import_hint_html", number: number_with_delimiter(Subscriber::Import::ROWS_LIMIT), link: link_to(t("subscribers_import_template_link"), subscribers_import_template_path(format: :csv), download: "subscribers.csv") %></p>
    </div>
  </div>
</div>

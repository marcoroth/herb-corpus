<% @page_title = t("subscribers_import_title") %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= link_to t("subscribers"), subscribers_path %>
      <span class="breadcrumbs__separator">▸</span>
      <%= up_crumb_to t("subscribers_add_title"), new_subscribers_batch_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
<% end %>

<div class="page flex flex-column gap">
  <div class="panel shadow flex flex-column gap">
    <% if @import.failed? %>
      <div class="flex flex-column gap-half">
        <p class="margin-none"><strong><%= t "subscribers_import_failed", filename: @import.file.filename %></strong></p>
        <p class="txt-small txt-subtle margin-none">
          <% if @import.failed_due_to_too_long? %>
            <%= t "subscribers_import_too_long", number: number_with_delimiter(Subscriber::Import::ROWS_LIMIT) %>
          <% else %>
            <%= t "subscribers_import_unreadable" %>
          <% end %>
        </p>
      </div>

      <div><%= link_to t("subscribers_import_read_button"), new_subscribers_import_path, class: "btn" %></div>
    <% else %>
      <%= render "subscribers/imports/reading", import: @import %>
    <% end %>
  </div>
</div>

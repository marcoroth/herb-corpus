<% @page_title = t("subscribers_import_title") %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= link_to t("subscribers"), subscribers_path %>
      <span class="breadcrumbs__separator">▸</span>
      <%= up_crumb_to t("subscribers_add_title"), new_subscribers_batch_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
<% end %>

<div class="page flex flex-column gap">
  <div class="panel shadow flex flex-column gap">
    <p class="margin-none">
      <% if @batch.found_count.zero? %>
        <%= t "subscribers_batch_found_nothing" %>
      <% elsif @batch.none_to_add? %>
        <%= t "subscribers_batch_found_none", count: @batch.found_count, filename: @import.file.filename %>
      <% else %>
        <%= t "subscribers_batch_found_some", count: @batch.found_count, filename: @import.file.filename %>
      <% end %>
    </p>

    <%= render "subscribers/batches/form", batch: @batch, url: subscribers_import_batch_path(@import) %>
  </div>
</div>

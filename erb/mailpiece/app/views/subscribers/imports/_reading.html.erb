<%= turbo_stream_from import %>

<ul class="rows" data-controller="reload">
  <li class="row">
    <div class="row__body">
      <span class="row__title"><%= import.file.filename %></span>
      <div class="reading" aria-busy="true">
        <span class="spinner reading__spinner"></span>
        <p class="reading__message"><%= t "subscribers_import_reading" %></p>
      </div>
    </div>
  </li>
</ul>

<li id="<%= dom_id subscriber %>" class="<%= class_names "row", "row--inactive": !subscriber.active? && !subscriber.unconfirmed? %>"
    data-quick-find-target="item" data-navigable-list-target="item" tabindex="-1">
  <%= link_to subscriber_path(subscriber), class: "row__body" do %>
    <strong class="row__title"><%= subscriber.email %></strong>
    <span class="row__meta"><%= subscriber_meta subscriber %></span>
  <% end %>
</li>

<% @page_title = t("my_access_tokens_new_title") %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <% if Current.user %>
        <%= home_crumb %>
        <%= link_to t("profile"), user_path(Current.user) %>
        <span class="breadcrumbs__separator">▸</span>
      <% else %>
        <%= home_crumb(url: session_menu_path, label: t("accounts")) %>
      <% end %>
      <%= up_crumb_to t("my_access_tokens"), my_access_tokens_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <div class="panel shadow">
    <%= form_with model: @access_token, url: my_access_tokens_path, scope: :access_token, class: "flex flex-column gap" do |form| %>
      <div class="flex flex-column gap-half">
        <label for="access_token_description"><strong><%= t("my_access_token_description_label") %></strong></label>
        <%= form.text_field :description, id: "access_token_description", required: true, autofocus: true, placeholder: t("my_access_token_description_placeholder"), class: "input" %>
      </div>

      <div class="flex flex-column gap-half">
        <label for="access_token_permission"><strong><%= t("my_access_token_permission") %></strong></label>
        <%= form.select :permission, options_for_select({ t("my_access_token_read") => "read", t("my_access_token_read_write") => "write" }), {}, id: "access_token_permission", class: "input input--select" %>
      </div>

      <div class="flex gap-half">
        <%= form.button t("my_access_tokens_generate_button"), type: "submit", class: "btn btn--link" %>
        <%= link_to t("cancel_and_go_back"), my_access_tokens_path, class: "btn borderless" %>
      </div>
    <% end %>
  </div>
</div>

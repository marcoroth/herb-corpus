<% @page_title = t("my_access_tokens_show_title") %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <% if Current.user %>
        <%= home_crumb %>
        <%= link_to t("profile"), user_path(Current.user) %>
        <span class="breadcrumbs__separator">▸</span>
      <% else %>
        <%= home_crumb(url: session_menu_path, label: t("accounts")) %>
      <% end %>
      <%= up_crumb_to t("my_access_tokens"), my_access_tokens_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <div class="panel shadow flex flex-column gap">
    <div>
      <strong><%= t("my_access_token_description") %></strong>
      <div><%= @access_token.description %> (<%= @access_token.permission == "write" ? t("my_access_token_read_write") : t("my_access_token_read") %>)</div>
    </div>

    <% if flash[:access_token] %>
      <div class="flex flex-column gap-half">
        <label for="access-token"><strong><%= t("my_access_token_field_label") %></strong></label>
        <input type="text" value="<%= flash[:access_token] %>" id="access-token" readonly autocomplete="off" class="input">
      </div>

      <p class="margin-none txt-small"><%= t("my_access_tokens_save_now") %></p>

      <div class="flex gap-half">
        <%= button_to_copy_to_clipboard flash[:access_token] do %>
          <%= icon_tag "copy-paste" %>
          <span><%= t("my_access_token_copy") %></span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

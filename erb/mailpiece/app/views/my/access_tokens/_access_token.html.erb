<li id="<%= dom_id access_token %>" class="row">
  <div class="row__body flex-item-grow">
    <strong class="row__title"><%= access_token.description %></strong>
    <span class="row__meta"><%= access_token.permission == "write" ? t("my_access_token_read_write") : t("my_access_token_read") %> · <%= local_datetime_tag access_token.created_at, style: :timeordate %></span>
  </div>

  <span class="step__actions">
    <%= button_to my_access_token_path(access_token), method: :delete, class: "btn btn--circle", aria: { label: t("my_access_token_revoke") },
          data: { turbo_confirm: t("my_access_token_revoke_confirm") } do %>
      <%= icon_tag "trash" %>
      <span class="for-screen-reader"><%= t("my_access_token_revoke") %></span>
    <% end %>
  </span>
</li>

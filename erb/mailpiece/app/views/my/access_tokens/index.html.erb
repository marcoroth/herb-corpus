<% @page_title = t("my_access_tokens") %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <% if Current.user %>
        <%= home_crumb %>
        <%= up_crumb_to t("profile"), user_path(Current.user) %>
      <% else %>
        <%= home_crumb(url: session_menu_path, label: t("accounts"), up: true) %>
      <% end %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end">
    <%= new_link_to t("my_access_tokens_generate"), new_my_access_token_path %>
  </div>
<% end %>

<div class="page flex flex-column gap">
  <p class="margin-none"><%= t("my_access_tokens_blurb") %></p>

  <% if @access_tokens.any? %>
    <ul class="rows">
      <%= render partial: "my/access_tokens/access_token", collection: @access_tokens %>
    </ul>
  <% else %>
    <div class="blank-slate fit-content center"><strong><%= t("my_access_tokens_no_tokens") %></strong></div>
  <% end %>
</div>

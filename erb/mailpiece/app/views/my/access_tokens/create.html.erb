<% @page_title = t("my_access_tokens_create_title") %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <% if Current.user %>
        <%= home_crumb %>
        <%= link_to t("profile"), user_path(Current.user) %>
        <span class="breadcrumbs__separator">▸</span>
      <% else %>
        <%= home_crumb(url: session_menu_path, label: t("accounts")) %>
      <% end %>
      <%= up_crumb_to t("my_access_tokens"), my_access_tokens_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <%= render "my/access_tokens/reveal", access_token: @access_token %>
</div>

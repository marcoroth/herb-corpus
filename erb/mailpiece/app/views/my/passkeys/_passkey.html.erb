<li id="<%= dom_id passkey %>" class="row">
  <%= link_to edit_my_passkey_path(passkey), class: "row__body" do %>
    <strong class="row__title"><%= passkey.name.presence || t("my_passkey_default_name") %></strong>
    <span class="row__meta">
      <% if passkey.authenticator && passkey.authenticator.name != passkey.name %>
        <%= passkey.authenticator.name %> ·
      <% end %>
      <%= local_datetime_tag passkey.created_at, style: :timeordate %>
    </span>
  <% end %>
</li>

<% @page_title = t("my_passkey_edit_title") %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <% if Current.user %>
        <%= home_crumb %>
        <%= link_to t("profile"), user_path(Current.user) %>
        <span class="breadcrumbs__separator">▸</span>
      <% else %>
        <%= home_crumb(url: session_menu_path, label: t("accounts")) %>
      <% end %>
      <%= up_crumb_to t("my_passkey_index_title"), my_passkeys_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <div class="panel shadow flex flex-column gap">
    <% if params[:created] %>
      <p class="margin-none"><%= t("my_passkey_registered") %></p>
    <% end %>

    <%= form_with model: @passkey, scope: :passkey, url: my_passkey_path(@passkey), class: "flex flex-column gap" do |form| %>
      <div class="flex flex-column gap-half">
        <label for="passkey_name"><strong><%= t("my_passkey_name_label") %></strong></label>
        <%= form.text_field :name, id: "passkey_name", autofocus: true, autocomplete: "off", placeholder: t("my_passkey_name_placeholder"), data: { "1p-ignore": "" }, class: "input" %>
      </div>

      <div class="flex gap-half">
        <%= form.button t("save"), type: "submit", class: "btn btn--link" %>
        <%= link_to t("cancel_and_go_back"), my_passkeys_path, class: "btn borderless" %>
      </div>
    <% end %>

    <div class="txt-align-center">
      <%= button_to my_passkey_path(@passkey), method: :delete,
            class: "btn txt-negative borderless txt-small",
            data: { turbo_confirm: t("my_passkey_remove_confirm") } do %>
        <%= icon_tag "trash" %>
        <span><%= t("my_passkey_remove") %></span>
      <% end %>
    </div>
  </div>
</div>

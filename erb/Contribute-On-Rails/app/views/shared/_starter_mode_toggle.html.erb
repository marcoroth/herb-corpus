<div class="group/starter-mode relative z-40 inline-flex">
  <%= button_to toggle_path, method: :get, params: starter_mode_toggle_params(filter_params), form: { class: "inline-flex max-w-full" }, class: "inline-flex max-w-full cursor-pointer items-center gap-3 rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-2 text-left shadow-sm transition hover:border-indigo-300 hover:bg-indigo-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:border-indigo-800/60 dark:bg-indigo-950/40 dark:hover:border-indigo-700", role: "switch", aria: { checked: starter_mode?, label: t("issues.starter_mode.toggle"), describedby: "starter-mode-tooltip" } do %>
    <span class="relative inline-flex h-6 w-11 shrink-0 rounded-full transition-colors <%= starter_mode? ? 'bg-indigo-600' : 'bg-slate-300 dark:bg-slate-700' %>" aria-hidden="true">
      <span class="absolute top-0.5 h-5 w-5 rounded-full bg-white shadow-sm transition-transform <%= starter_mode? ? 'translate-x-5' : 'translate-x-0.5' %>"></span>
    </span>
    <span>
      <span class="flex items-center gap-1.5 text-sm font-semibold text-slate-900 dark:text-white">
        <%= t("issues.starter_mode.label") %>
        <span class="inline-flex h-4 w-4 items-center justify-center rounded-full border border-indigo-300 text-[10px] text-indigo-700 dark:border-indigo-700 dark:text-indigo-300" aria-hidden="true">?</span>
      </span>
      <span class="block text-xs text-slate-600 dark:text-slate-300"><%= t("issues.starter_mode.description") %></span>
    </span>
  <% end %>

  <span id="starter-mode-tooltip" role="tooltip" class="pointer-events-none absolute right-0 top-full z-50 mt-2 w-64 rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-xs text-white opacity-0 shadow-xl transition-opacity group-hover/starter-mode:opacity-100 group-focus-within/starter-mode:opacity-100 dark:border-slate-200 dark:bg-slate-100 dark:text-slate-950">
    <%= t("issues.starter_mode.cookie_tooltip") %>
  </span>
</div>

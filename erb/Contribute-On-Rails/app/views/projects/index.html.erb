<% content_for :title, t("projects.index.heading") %>
<% content_for :description, t("projects.index.meta_description") %>

<section class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-10">
  <header class="mb-8 animate-fade-in-up">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 dark:bg-indigo-950/40 dark:text-indigo-300 dark:border dark:border-indigo-800/40 shadow-sm mb-3">
      <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-pulse"></span>
      <%= t("app.tagline") %>
    </div>

    <h1 class="mt-2 bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 bg-clip-text text-3xl font-extrabold tracking-tight text-transparent sm:text-4xl dark:from-white dark:via-indigo-200 dark:to-white">
      <%= t("projects.index.heading") %>
    </h1>

    <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">
      <%= t("projects.index.description") %>
    </p>
  </header>

  <%= form_with url: projects_path, method: :get, class: "mb-6 grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:grid-cols-[minmax(0,1fr)_minmax(12rem,0.55fr)_auto] dark:border-slate-800 dark:bg-slate-900 animate-fade-in-up", role: "search" do |form| %>
    <div>
      <%= form.label :q, t("projects.filters.search"), class: "sr-only" %>
      <%= form.search_field :q, value: @query, placeholder: t("projects.filters.search"), class: "h-11 w-full rounded-xl border border-slate-300 bg-white px-4 text-slate-900 shadow-sm outline-none placeholder:text-slate-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:placeholder:text-slate-400" %>
    </div>

    <div>
      <%= form.label :category, t("projects.filters.category"), class: "sr-only" %>
      <%= form.select :category, options_for_select(@categories, @category), { include_blank: t("projects.filters.all_categories") }, class: "h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-slate-900 shadow-sm outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:border-slate-700 dark:bg-slate-950 dark:text-white" %>
    </div>

    <div class="flex gap-2">
      <%= form.submit t("projects.filters.submit"), name: nil, class: "h-11 flex-1 cursor-pointer rounded-xl bg-slate-900 px-5 font-semibold text-white shadow-sm transition-colors hover:bg-slate-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 sm:flex-none dark:bg-slate-100 dark:text-slate-950 dark:hover:bg-slate-200" %>
      <% if @query.present? || @category.present? %>
        <%= link_to t("projects.filters.clear"), projects_path, class: "inline-flex h-11 items-center justify-center rounded-xl border border-slate-300 px-4 font-semibold text-slate-700 transition-colors hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800" %>
      <% end %>
    </div>
  <% end %>

  <p class="mb-4 text-sm text-slate-600 dark:text-slate-400" aria-live="polite">
    <%= t("projects.index.results", count: @pagy.count) %>
  </p>

  <% if @projects.any? %>
    <div class="grid gap-4 md:grid-cols-2 animate-fade-in-up">
      <% @projects.each do |project| %>
        <article
          class="
            rounded-2xl border border-slate-200 bg-white p-5 shadow-sm
            dark:border-slate-800 dark:bg-slate-900
          "
        >
          <div class="flex flex-wrap items-start justify-between gap-2">
            <h2 class="min-w-0 break-words text-lg font-semibold text-slate-900 dark:text-white">
              <%= link_to project.name, project_path(project), class: "hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:outline-none rounded" %>
            </h2>

            <span class="shrink-0 bg-slate-900 px-2.5 py-1 rounded-full font-semibold text-white text-xs dark:bg-slate-800 dark:text-slate-200">
              <%= t("projects.index.open_issues", count: project.open_issues_count) %>
            </span>
          </div>

          <div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-sm">
            <p class="min-w-0 break-all text-slate-600 dark:text-slate-300">
              <%= project.github_owner %>/<%= project.github_repo %>
            </p>

            <% if project.source_category.present? %>
              <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-semibold text-indigo-700 dark:bg-indigo-950/50 dark:text-indigo-300">
                <%= project.source_category %>
              </span>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>

    <div class="mt-8">
      <%== @pagy.series_nav(aria_label: t("projects.pagination")) if @pagy.pages > 1 %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white/70 p-10 text-center dark:border-slate-700 dark:bg-slate-900/70">
      <p class="font-semibold text-slate-900 dark:text-white"><%= t("projects.index.empty") %></p>
      <%= link_to t("projects.filters.clear"), projects_path, class: "mt-3 inline-flex text-sm font-semibold text-indigo-700 hover:text-indigo-900 dark:text-indigo-300 dark:hover:text-indigo-200" %>
    </div>
  <% end %>
</section>

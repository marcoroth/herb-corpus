<% content_for :title, @project.name %>
<% content_for :description, t("projects.show.meta_description", project: @project.name) %>
<% content_for :enhanced_selects, true %>

<section class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-10">
  <% if params[:from_random].present? %>
    <%= link_to issues_path, class: "mb-6 inline-flex cursor-pointer items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-900 shadow-sm transition hover:border-slate-400 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 dark:border-slate-800 dark:bg-slate-900 dark:text-white dark:hover:bg-slate-800" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
      <%= t("projects.show.back_to_issues") %>
    <% end %>
  <% end %>

  <div class="relative z-30 animate-fade-in-up">
    <span class="mb-2 inline-block text-xs font-semibold uppercase tracking-widest text-slate-500 dark:text-slate-400">
      <%= @project.source_category %>
    </span>

    <div class="flex flex-wrap items-center gap-3">
      <h1 class="min-w-0 break-words bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 bg-clip-text text-3xl font-extrabold tracking-tight text-transparent dark:from-white dark:via-indigo-200 dark:to-white">
        <%= @project.name %>
      </h1>

      <%= link_to "https://github.com/#{@project.github_owner}/#{@project.github_repo}", target: "_blank", rel: "noopener", class: "inline-flex min-w-0 items-center gap-1 break-all text-xs text-slate-600 transition-colors hover:text-indigo-700 dark:text-slate-300 dark:hover:text-indigo-300" do %>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
        github.com/<%= @project.github_owner %>/<%= @project.github_repo %>
      <% end %>
    </div>

    <p class="mt-2 text-slate-500 text-sm dark:text-slate-400">
      <%= t("projects.show.last_synced", date: @project.last_synced_at ? l(@project.last_synced_at, format: :long) : t("projects.show.never")) %>
    </p>

    <div class="mt-4">
      <%= render "shared/starter_mode_toggle", toggle_path: project_path(@project), filter_params: request.query_parameters.merge(labels: @active_labels) %>
    </div>
  </div>

  <%= form_with url: project_path(@project), method: :get, class: "relative z-20 mt-6 grid gap-4 md:grid-cols-2 max-w-xl" do |form| %>
    <% @active_labels.each do |label| %>
      <%= hidden_field_tag "labels[]", label %>
    <% end %>
    <div class="floating-label-group">
      <%= form.select :updated_since, options_for_select([[t("issues.filters.any_time"), "all"], [t("issues.filters.last_30_days"), 30], [t("issues.filters.last_90_days"), 90], [t("issues.filters.last_year"), 365]], params[:updated_since] || "all"), {}, class: "select-control", data: { controller: "select" }, id: "select_updated_since", onchange: "this.form.requestSubmit()" %>
      <%= form.label :updated_since, t("issues.filters.updated_since"), for: "select_updated_since" %>
    </div>

    <div class="floating-label-group">
      <%= form.select :assignee_status, options_for_select([[t("issues.filters.unassigned_only"), "unassigned"], [t("issues.filters.assigned_only"), "assigned"], [t("issues.filters.all_assignees"), "all"]], params[:assignee_status] || "all"), {}, class: "select-control", data: { controller: "select" }, id: "select_assignee_status", onchange: "this.form.requestSubmit()" %>
      <%= form.label :assignee_status, t("issues.filters.assignee_status"), for: "select_assignee_status" %>
    </div>
  <% end %>

  <div class="space-y-4 mt-8">
    <% @issues.each do |issue| %>
      <article
        class="
          bg-white shadow-sm p-5 border border-slate-200 rounded-2xl
          dark:border-slate-800 dark:bg-slate-900
        "
      >
        <div
          class="
            flex flex-wrap items-center gap-2 text-slate-500 text-sm
            dark:text-slate-400
          "
        >
          <span>#<%= issue.number %></span>

          <% issue.labels.each do |label| %>
            <span
              class="
                bg-slate-100 text-slate-700 px-2.5 py-1 rounded-full text-xs shimmer-badge
                dark:bg-slate-800 dark:text-slate-300
              "
            >
              <%= label.name %>
            </span>
          <% end %>

          <% if issue.assigned? %>
            <span
              class="
                bg-amber-50 border border-amber-200 px-2 py-1 rounded-full
                font-medium text-amber-800 text-xs dark:bg-amber-950/30
                dark:border-amber-900/50 dark:text-amber-400
              "
            >
              <%= t("issues.index.assigned_to", names: issue.assignee_logins.join(", ")) %>
            </span>
          <% end %>
        </div>

        <h3 class="mt-3 break-words font-semibold text-slate-900 text-xl dark:text-white">
          <%= link_to issue.title, issue.github_url, target: "_blank", rel: "noopener", class: "hover:text-indigo-600 dark:hover:text-indigo-400 focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:outline-none rounded transition-colors" %>
        </h3>

        <p class="mt-2 text-slate-500 text-sm dark:text-slate-400">
          <%= t("issues.index.opened", date: l(issue.opened_at, format: :long)) %>
          ·
          <%= t("issues.index.updated", date: l(issue.updated_at_from_github, format: :long)) %>
        </p>
      </article>
    <% end %>
  </div>

  <div class="mt-8">
    <%== @pagy.series_nav(aria_label: t("issues.pagination")) if @pagy.pages > 1 %>
  </div>
</section>

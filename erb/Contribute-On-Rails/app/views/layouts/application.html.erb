<!DOCTYPE html>

<html lang="<%= I18n.locale %>">
  <head>
    <title><%= page_title %></title>
    <meta name="description" content="<%= page_description %>">
    <link rel="canonical" href="<%= canonical_url %>">
    <% I18n.available_locales.each do |locale| %>
      <link rel="alternate" hreflang="<%= locale %>" href="<%= canonical_url(locale: locale) %>">
    <% end %>
    <link rel="alternate" hreflang="x-default" href="<%= canonical_url(locale: I18n.default_locale) %>">

    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:site_name" content="Contribute on Rails">
    <meta property="og:locale" content="<%= I18n.locale.to_s.tr('-', '_') %>">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= page_description %>">

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Contribute on Rails">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#6366f1" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#4f46e5" media="(prefers-color-scheme: dark)">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">

    <% if content_for?(:enhanced_selects) %>
      <%# TomSelect is only requested on pages that render enhanced filters. %>
      <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
      <link rel="preload" href="https://cdn.jsdelivr.net/npm/tom-select@2.6.1/dist/css/tom-select.css" as="style">
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.6.1/dist/css/tom-select.css">
      <link rel="modulepreload" href="https://cdn.jsdelivr.net/npm/tom-select@2.6.1/+esm">
    <% end %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>

    <script nonce="<%= request.content_security_policy_nonce %>">
      (function() {
        const theme = localStorage.getItem('theme') || 'system';
        const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>

  <body class="relative bg-slate-50 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-50">
    <%= link_to t("layout.skip_to_content"), "#main-content", class: "fixed left-4 top-4 z-[100] -translate-y-20 rounded-lg bg-slate-950 px-4 py-2 font-semibold text-white shadow-lg transition-transform focus:translate-y-0 dark:bg-white dark:text-slate-950" %>

    <!-- Animated Neon Background Blobs -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10 select-none">
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-indigo-500/10 dark:bg-indigo-500/8 rounded-full blur-3xl animate-float-slow"></div>
      <div class="absolute top-1/3 -right-40 w-96 h-96 bg-pink-500/10 dark:bg-pink-500/6 rounded-full blur-3xl animate-float-delayed"></div>
      <div class="absolute -bottom-40 left-1/4 w-96 h-96 bg-cyan-500/10 dark:bg-cyan-500/6 rounded-full blur-3xl animate-float-slow"></div>
    </div>

    <header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/80 backdrop-blur-md dark:border-slate-800/80 dark:bg-slate-950/80">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-3 px-4 py-3 sm:flex-nowrap sm:px-6 sm:py-4">
        <div class="flex w-full items-center justify-between gap-3 sm:w-auto sm:flex-1 sm:justify-start sm:gap-8">
          <%= link_to root_path, class: "group flex shrink-0 items-center gap-3 font-bold text-slate-900 tracking-tight text-lg transition hover:opacity-90 dark:text-white" do %>
            <div class="relative flex items-center justify-center p-1.5 rounded-xl bg-slate-100 border border-slate-200 group-hover:border-indigo-400/50 transition-colors dark:bg-slate-900 dark:border-slate-800 dark:group-hover:border-indigo-500/50">
              <!-- Cybernetic glowing ring behind the logo on group hover -->
              <div class="absolute inset-0 rounded-xl bg-gradient-to-tr from-indigo-500 via-pink-500 to-cyan-400 opacity-0 blur-xs group-hover:opacity-40 group-hover:animate-spin-slow transition-opacity duration-500"></div>
              <%= image_tag "/icon.png", class: "relative h-6 w-6 transition-transform duration-500 group-hover:scale-110 group-hover:rotate-12", alt: "Logo" %>
            </div>
            <span class="hidden md:inline">Contribute on Rails</span>
          <% end %>

          <nav class="flex items-center gap-3 sm:gap-6" aria-label="<%= t('layout.nav.aria_label') %>">
            <%= link_to t("layout.nav.issues"), root_path, class: "text-sm font-semibold transition #{controller_name == 'issues' ? 'text-slate-900 dark:text-white' : 'text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-100'}" %>
            <%= link_to t("layout.nav.projects"), projects_path, class: "text-sm font-semibold transition #{controller_name == 'projects' ? 'text-slate-900 dark:text-white' : 'text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-100'}" %>
          </nav>
        </div>

        <div class="ml-auto flex w-full items-center justify-end gap-2 sm:w-auto sm:gap-4">
          <button
            type="button"
            data-controller="theme"
            data-action="click->theme#toggle"
            class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 shadow-sm transition hover:bg-slate-50 hover:text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white"
            data-theme-light-label-value="<%= t('layout.theme.switch_to_light') %>"
            data-theme-dark-label-value="<%= t('layout.theme.switch_to_dark') %>"
          >
            <svg data-theme-target="lightIcon" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
            </svg>
            <svg data-theme-target="darkIcon" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
            </svg>
          </button>

          <nav class="flex items-center gap-1 rounded-full border border-slate-200/80 bg-slate-100 p-0.5 dark:border-slate-700 dark:bg-slate-800" aria-label="<%= t('layout.language.aria_label') %>">
            <%= link_to "EN", url_for(params.to_unsafe_h.merge(locale: "en")), lang: "en", hreflang: "en", aria: { current: I18n.locale == :en ? "true" : nil }, class: "rounded-full px-2.5 py-1.5 text-xs font-bold transition #{I18n.locale == :en ? 'bg-white text-slate-900 shadow-sm dark:bg-slate-900 dark:text-white' : 'text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white'}" %>
            <%= link_to "PT", url_for(params.to_unsafe_h.merge(locale: "pt-BR")), lang: "pt-BR", hreflang: "pt-BR", aria: { current: I18n.locale == :"pt-BR" ? "true" : nil }, class: "rounded-full px-2.5 py-1.5 text-xs font-bold transition #{I18n.locale == :"pt-BR" ? 'bg-white text-slate-900 shadow-sm dark:bg-slate-900 dark:text-white' : 'text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white'}" %>
          </nav>
        </div>
      </div>
    </header>

    <main id="main-content" class="min-h-[calc(100vh-14rem)]" tabindex="-1">
      <%= yield %>
    </main>

    <footer class="border-t border-slate-200/80 bg-white/40 backdrop-blur-md dark:border-slate-800/85 dark:bg-slate-950/40 py-8 mt-16 text-xs text-slate-500 dark:text-slate-400">
      <div class="mx-auto max-w-7xl px-6 flex items-center justify-center">
        <span class="font-medium text-slate-600 dark:text-slate-400">Contribute on Rails &copy; <%= Time.current.year %></span>
      </div>
    </footer>
  </body>
</html>

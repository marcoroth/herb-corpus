<article class="bg-white shadow-sm p-5 border border-slate-200 rounded-2xl dark:border-slate-850 dark:bg-slate-900">
  <div class="flex flex-wrap items-center justify-between gap-2 text-slate-500 text-sm dark:text-slate-400">
    <div class="flex flex-wrap items-center gap-2">
      <% unless group_by_project %>
        <%= link_to "#{issue.project.github_owner}/#{issue.project.github_repo}", project_path(issue.project), class: "font-medium text-slate-700 hover:text-indigo-600 dark:text-slate-300 dark:hover:text-indigo-400 transition-colors" %>
        <span class="text-slate-300 dark:text-slate-600">•</span>
      <% end %>
      <span>#<%= issue.number %></span>

      <% issue.labels.each do |label| %>
        <span class="bg-slate-100 text-slate-700 px-2.5 py-1 rounded-full text-xs shimmer-badge dark:bg-slate-800 dark:text-slate-300">
          <%= label.name %>
        </span>
      <% end %>

      <% if issue.assigned? %>
        <span class="bg-amber-50 px-2 py-1 border border-amber-200 rounded-full font-medium text-amber-800 text-xs dark:bg-amber-950/30 dark:border-amber-900/50 dark:text-amber-400">
          <%= t("issues.index.assigned_to", names: issue.assignee_logins.join(", ")) %>
        </span>
      <% end %>
    </div>

    <div class="flex items-center gap-3 ml-auto">
      <% if issue.has_pull_requests? %>
        <div class="inline-flex items-center gap-1.5 text-purple-700 dark:text-purple-300 font-medium text-xs bg-purple-50 dark:bg-purple-950/50 border border-purple-200 dark:border-purple-800/60 px-2 py-0.5 rounded-md cursor-help shadow-2xs" title="<%= t("issues.index.pull_requests_count", count: issue.pull_requests_count) %>">
          <svg class="w-3.5 h-3.5 shrink-0 fill-current" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M1.5 3.25a2.25 2.25 0 1 1 3 2.122v5.256a2.251 2.251 0 1 1-1.5 0V5.372A2.25 2.25 0 0 1 1.5 3.25Zm5.677-.177L9.573.677A.25.25 0 0 1 10 .854v4.792a.25.25 0 0 1-.427.177L7.177 3.427a.25.25 0 0 1 0-.354ZM3.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm0 9.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm8.5-9.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm0 9.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Z"></path>
          </svg>
          <span><%= issue.pull_requests_count %></span>
        </div>
      <% end %>

      <% if issue.comments_count > 0 %>
        <div class="inline-flex items-center gap-1.5 text-slate-600 dark:text-slate-400 text-xs font-medium bg-slate-100/80 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-700/60 px-2 py-0.5 rounded-md" title="<%= t("issues.index.comments_count", count: issue.comments_count) %>">
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
          </svg>
          <span><%= issue.comments_count %></span>
        </div>
      <% end %>
    </div>
  </div>

  <h3 class="mt-3 break-words font-semibold text-slate-900 text-xl dark:text-white">
    <%= link_to issue.title, issue.github_url, target: "_blank", rel: "noopener", class: "hover:text-indigo-600 dark:hover:text-indigo-400 focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:outline-none rounded transition-colors" %>
  </h3>

  <p class="mt-2 text-slate-600 text-sm dark:text-slate-400">
    <%= t("issues.index.opened", date: l(issue.opened_at, format: :long)) %>
    ·
    <%= t("issues.index.updated", date: l(issue.updated_at_from_github, format: :long)) %>
  </p>
</article>

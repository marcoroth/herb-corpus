<% content_for :title, t("issues.index.title") %>
<% content_for :description, t("issues.index.meta_description") %>
<% content_for :enhanced_selects, true %>

<section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10">
  <header class="relative z-30 flex md:flex-row flex-col md:justify-between md:items-end gap-4 mb-8 animate-fade-in-up">
    <div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 dark:bg-indigo-950/40 dark:text-indigo-300 dark:border dark:border-indigo-800/40 shadow-sm mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-pulse"></span>
        <%= t("app.tagline") %>
      </div>

      <h1
        class="
          mt-2 font-extrabold text-slate-900 text-3xl tracking-tight sm:text-4xl
          bg-clip-text text-transparent bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900
          dark:from-white dark:via-indigo-200 dark:to-white
          dark:text-white
        "
      >
        <%= t("issues.index.heading") %>
      </h1>

      <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">
        <%= t("issues.index.description") %>
      </p>
    </div>

    <div class="flex flex-col items-stretch gap-3 sm:items-end">
      <%= render "shared/starter_mode_toggle", toggle_path: issues_path, filter_params: @active_search_params %>

      <%= link_to random_issues_path(@active_search_params), class: "group inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 font-semibold text-slate-900 shadow-sm transition-all hover:border-indigo-400 hover:bg-slate-50 hover:shadow-md hover:scale-[1.02] active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:border-slate-800 dark:bg-slate-900 dark:text-white dark:hover:border-indigo-500 dark:hover:bg-slate-800" do %>
        <span><%= t("issues.random_project") %></span>
        <svg class="w-4 h-4 text-slate-500 group-hover:text-indigo-600 group-hover:rotate-12 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.656 48.656 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3l-3-3M3 12c0 1.232.046 2.453.138 3.662a4.006 4.006 0 003.7 3.7 48.656 48.656 0 007.324 0 4.006 4.006 0 003.7-3.7c.017-.22.032-.441.046-.662M3 12l-3 3m3-3l3 3" />
        </svg>
      <% end %>
    </div>
  </header>

  <div
    data-controller="saved-searches"
    data-saved-searches-storage-key-value="contribute-on-rails.saved-searches.v1"
    data-saved-searches-path-value="<%= issues_path %>"
    data-saved-searches-pristine-value="<%= request.query_parameters.except('locale', 'group_by_project', 'page').empty? %>"
    data-saved-searches-limit-value="10"
    data-saved-searches-apply-label-value="<%= t('issues.saved_searches.apply') %>"
    data-saved-searches-default-label-value="<%= t('issues.saved_searches.make_default') %>"
    data-saved-searches-remove-default-label-value="<%= t('issues.saved_searches.remove_default') %>"
    data-saved-searches-delete-label-value="<%= t('issues.saved_searches.delete') %>"
    data-saved-searches-default-badge-value="<%= t('issues.saved_searches.default_badge') %>"
    data-saved-searches-name-required-value="<%= t('issues.saved_searches.name_required') %>"
    data-saved-searches-saved-message-value="<%= t('issues.saved_searches.saved') %>"
    data-saved-searches-updated-message-value="<%= t('issues.saved_searches.updated') %>"
    data-saved-searches-limit-message-value="<%= t('issues.saved_searches.limit') %>"
    data-saved-searches-storage-error-value="<%= t('issues.saved_searches.storage_error') %>"
  >
    <%= render "saved_searches" %>

    <%= form_with url: issues_path, method: :get, class: "relative z-20 mb-8 grid gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm md:grid-cols-4 dark:border-slate-800 dark:bg-slate-900 animate-fade-in-up", data: { saved_searches_target: "form" } do |form| %>
      <%= form.hidden_field :group_by_project, value: @group_by_project %>
      <%= form.hidden_field :starter_mode, value: starter_mode? %>
      <div class="floating-label-group md:col-span-2">
        <%= form.search_field :q, value: @active_search_params["q"], placeholder: " ", id: "input_q", class: "h-11 w-full rounded-xl border border-slate-300 px-4 pt-3 text-slate-900 shadow-sm outline-none ring-0 focus:border-slate-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 dark:border-slate-800 dark:bg-slate-950 dark:text-white dark:focus:border-slate-700" %>
        <%= form.label :q, t("issues.filters.search"), for: "input_q" %>
      </div>

      <div class="floating-label-group">
        <%= form.select :project_id, options_from_collection_for_select(@projects, :id, ->(project) { "#{project.github_owner}/#{project.github_repo}" }, @active_search_params["project_id"]), { include_blank: "" }, class: "select-control", data: { controller: "select" }, id: "select_project" %>
        <%= form.label :project_id, t("issues.filters.project"), for: "select_project" %>
      </div>

      <div class="floating-label-group">
        <%= form.select :organization, options_for_select(@organizations, @active_search_params["organization"]), { include_blank: "" }, class: "select-control", data: { controller: "select" }, id: "select_organization" %>
        <%= form.label :organization, t("issues.filters.organization"), for: "select_organization" %>
      </div>

      <div class="floating-label-group">
        <%= form.select :category, options_for_select(@categories, @active_search_params["category"]), { include_blank: "" }, class: "select-control", data: { controller: "select" }, id: "select_category" %>
        <%= form.label :category, t("issues.filters.category"), for: "select_category" %>
      </div>

      <div class="floating-label-group">
        <%= form.select :updated_since, options_for_select([[t("issues.filters.any_time"), "all"], [t("issues.filters.last_30_days"), 30], [t("issues.filters.last_90_days"), 90], [t("issues.filters.last_year"), 365]], @active_search_params["updated_since"]), {}, class: "select-control", data: { controller: "select" }, id: "select_updated_since" %>
        <%= form.label :updated_since, t("issues.filters.updated_since"), for: "select_updated_since" %>
      </div>

      <div class="floating-label-group">
        <%= form.select :assignee_status, options_for_select([[t("issues.filters.unassigned_only"), "unassigned"], [t("issues.filters.assigned_only"), "assigned"], [t("issues.filters.all_assignees"), "all"]], @active_search_params["assignee_status"]), {}, class: "select-control", data: { controller: "select" }, id: "select_assignee_status" %>
        <%= form.label :assignee_status, t("issues.filters.assignee_status"), for: "select_assignee_status" %>
      </div>

      <div class="floating-label-group">
        <%= form.select :sort, options_for_select([[t("issues.filters.sort_options.recently_updated"), "recently_updated"], [t("issues.filters.sort_options.newest"), "newest"], [t("issues.filters.sort_options.oldest"), "oldest"], [t("issues.filters.sort_options.least_recently_updated"), "least_recently_updated"]], @active_search_params["sort"]), {}, class: "select-control", data: { controller: "select" }, id: "select_sort" %>
        <%= form.label :sort, t("issues.filters.sort"), for: "select_sort" %>
      </div>

      <div class="floating-label-group md:col-span-3">
        <%= select_tag "labels[]", options_for_select(@all_labels, @active_search_params["labels"]), multiple: true, class: "select-control", data: { controller: "select" }, id: "select_labels" %>
        <label for="select_labels"><%= t("issues.filters.labels") %></label>
      </div>

      <div class="flex gap-2">
        <%= form.submit t("issues.filters.submit"), name: nil, class: "h-11 min-w-0 flex-1 cursor-pointer rounded-xl bg-slate-900 px-4 font-medium text-white shadow-sm transition-colors hover:bg-slate-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 dark:bg-slate-100 dark:text-slate-950 dark:hover:bg-slate-200" %>
        <% if request.query_parameters.except("locale", "group_by_project", "starter_mode", "page").present? %>
          <%= link_to t("issues.filters.clear"), issues_path(group_by_project: @group_by_project, starter_mode: starter_mode?), class: "inline-flex h-11 items-center justify-center rounded-xl border border-slate-300 px-3 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div
    class="
      mb-6 flex flex-col items-stretch gap-4 text-sm text-slate-600
      sm:flex-row sm:items-center sm:justify-between
      dark:text-slate-400
    "
  >
    <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-4">
      <p aria-live="polite">
        <%= t("issues.index.results", count: @pagy.count) %>
      </p>

      <div class="flex items-center gap-1.5 bg-slate-100/50 dark:bg-slate-800/50 p-1 rounded-lg border border-slate-200 dark:border-slate-700/50">
        <%= link_to t("issues.index.group_by_project", default: "Grouped by Project"), url_for(request.query_parameters.merge(group_by_project: true)), aria: { current: @group_by_project ? "true" : nil }, class: "px-3 py-1.5 text-xs font-medium rounded-md transition-colors #{@group_by_project ? 'bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm ring-1 ring-slate-900/5 dark:ring-white/10' : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white'}" %>
        <%= link_to t("issues.index.flat_list", default: "Flat List"), url_for(request.query_parameters.merge(group_by_project: false)), aria: { current: !@group_by_project ? "true" : nil }, class: "px-3 py-1.5 text-xs font-medium rounded-md transition-colors #{!@group_by_project ? 'bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm ring-1 ring-slate-900/5 dark:ring-white/10' : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white'}" %>
      </div>
    </div>

    <% if @pagy.pages > 1 %>
      <nav
        class="hidden items-center gap-1 lg:flex"
        aria-label="<%= t("issues.pagination") %>"
      >
        <% if @pagy.page > 1 %>
          <%= link_to @pagy.page_url(@pagy.page - 1), class: "inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white font-medium text-slate-700 shadow-sm transition hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800", aria: { label: t("pagy.nav.prev") } do %>
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15.75 19.5L8.25 12l7.5-7.5"
              />
            </svg>
          <% end %>
        <% end %>

        <% @pagy.send(:series, size: [1, 2, 2, 1]).each do |item| %>
          <% if item.is_a?(Integer) %>
            <%= link_to item, @pagy.page_url(item), class: "inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white font-medium text-slate-700 shadow-sm transition hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800" %>
          <% elsif item.is_a?(String) %>
            <span
              aria-current="page"
              class="
                inline-flex justify-center items-center bg-slate-900
                shadow-sm rounded-lg w-9 h-9 font-medium text-white
                cursor-default dark:bg-slate-100 dark:text-slate-950
              "
            >
              <%= item %>
            </span>
          <% elsif item == :gap %>
            <span
              class="
                inline-flex justify-center items-center w-9 h-9 font-medium
                text-slate-400
              "
            >
              …
            </span>
          <% end %>
        <% end %>

        <% if @pagy.page < @pagy.pages %>
          <%= link_to @pagy.page_url(@pagy.page + 1), class: "inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white font-medium text-slate-700 shadow-sm transition hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800", aria: { label: t("pagy.nav.next") } do %>
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8.25 4.5l7.5 7.5-7.5 7.5"
              />
            </svg>
          <% end %>
        <% end %>
      </nav>
    <% end %>
  </div>

  <% if @group_by_project && @grouped_issues.any? %>
    <div class="space-y-8 animate-fade-in-up">
      <% @grouped_issues.each do |(organization, project), issues| %>
        <section aria-labelledby="project-<%= project.id %>" data-controller="collapsible" data-collapsible-project-id-value="<%= project.id %>">
          <div class="mb-3 flex flex-wrap items-center gap-3">
            <button
              type="button"
              class="p-1 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500 hover:text-indigo-600 dark:text-slate-400 dark:hover:text-indigo-400 transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-indigo-500"
              data-action="click->collapsible#toggle"
              data-collapsible-target="button"
              aria-label="<%= t('issues.index.toggle_project', project: project.github_repo) %>"
              aria-expanded="true"
              aria-controls="project-issues-<%= project.id %>"
            >
              <svg
                class="w-5 h-5 transform transition-transform duration-200"
                data-collapsible-target="icon"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <p
              class="
                font-medium text-slate-600 text-sm uppercase tracking-wide
                dark:text-slate-400
              "
            >
              <%= organization %>
            </p>

            <h2
              id="project-<%= project.id %>"
              class="
                min-w-0 break-words font-semibold text-slate-900 text-xl dark:text-white
              "
            >
              <%= link_to project.github_repo, project_path(project), class: "hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" %>
            </h2>

            <span
              class="
                bg-slate-900 px-2.5 py-1 rounded-full font-semibold
                text-white text-xs dark:bg-slate-800 dark:text-slate-200
              "
            >
              <%= t("issues.index.project_count", count: @project_issue_counts.fetch(project.id, 0)) %>
            </span>

            <div class="hidden h-px flex-1 bg-slate-200 dark:bg-slate-800/60 sm:block"></div>
          </div>

          <div id="project-issues-<%= project.id %>" class="space-y-4 animate-fade-in-up" data-collapsible-target="content">
            <%= render partial: "issue", collection: issues, locals: { group_by_project: @group_by_project } %>
          </div>
        </section>
      <% end %>
    </div>
  <% elsif !@group_by_project && @issues.any? %>
    <div class="space-y-4 animate-fade-in-up">
      <%= render partial: "issue", collection: @issues, locals: { group_by_project: @group_by_project } %>
    </div>
  <% else %>
    <p
      class="
        bg-white p-8 border border-slate-300 border-dashed rounded-2xl
        text-slate-600 text-center dark:bg-slate-900 dark:border-slate-800
        dark:text-slate-400
      "
    >
      <%= t("issues.index.empty") %>
    </p>
  <% end %>

  <div class="mt-8">
    <%== @pagy.series_nav(aria_label: t("issues.pagination")) if @pagy.pages > 1 %>
  </div>
</section>

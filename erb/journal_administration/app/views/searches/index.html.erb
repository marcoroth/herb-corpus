<%= turbo_frame_tag "search-results" do %>
  <% if @search.query.present? && !@search.any_results? %>
    <p><%= t("search.no_results") %></p>
  <% elsif @search.any_results? %>
    <% @search.results.each do |type, items| %>
      <section>
        <h3><%= t("search.result_types.#{type}") %></h3>
        <% case type %>
        <% when :pages %>
          <%= render partial: "searches/result_page", collection: items, as: :page %>
        <% when :accounts %>
          <%= render partial: "searches/result_account", collection: items, as: :account %>
        <% when :transactions %>
          <%= render partial: "searches/result_transaction", collection: items, as: :transaction %>
        <% when :chattels %>
          <%= render partial: "searches/result_chattel", collection: items, as: :chattel %>
        <% when :categories %>
          <%= render partial: "searches/result_category", collection: items, as: :category %>
        <% else %>
          <%= raise ArgumentError, "No search result partial for #{type}" %>
        <% end %>
      </section>
    <% end %>
  <% end %>
<% end %>

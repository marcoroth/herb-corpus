<%# locals: (user:) %>
<div>
  <%= link_to user.name, user.current? ? edit_user_profile_path(user) : user_profile_path(user) %>

  <%= form_with model: user, url: user_path(user), data: { controller: "submit-on-change" }, method: :patch do |form| %>
    <label for="<%= dom_id(user, :role) %>">
      <%= t('.role_label', name: user.name, role: user.administrator? ? t('.role_administrator') : t('.role_member')) %>
      <%= form.check_box :role, { data: { action: "change->submit-on-change#submit" }, hidden: true, id: dom_id(user, :role),
            disabled: ("disabled" if user.current? || !Current.user.can_administer?) },
            "administrator", "member" %>
    </label>
  <% end %>
</div>

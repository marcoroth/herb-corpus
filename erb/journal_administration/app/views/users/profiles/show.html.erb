<% content_for(:title) { @user.name } %>
<%= render layout: "shared/title_bar", locals: { title: @user.name } do %>
  <%= link_to t("common.back"), users_path %>
<% end %>

<article>
  <dl>
    <dt><%= User.human_attribute_name(:name) %></dt>
    <dd><%= @user.name %></dd>

    <dt><%= User.human_attribute_name(:email_address) %></dt>
    <dd><%= mail_to @user.email_address %></dd>
  </dl>
</article>

<% if Current.user.can_administer? %>
  <article>
    <%= render "users/transfer", user: @user %>
  </article>
<% end %>

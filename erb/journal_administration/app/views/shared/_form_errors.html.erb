<%# locals: (record:) %>
<% if record.errors.any? %>
  <aside role="alert">
    <h2><%= t("errors.template.header", count: record.errors.count, model: record.model_name.human.downcase) %></h2>
    <ul>
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </aside>
<% end %>

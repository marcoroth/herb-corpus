<%# locals: (form:, cancel_path:, submit_label: nil, delete_form_id: nil, confirm: nil) %>
<footer>
  <% if delete_form_id %>
    <%= button_tag t("common.delete_ellipsis"), type: "submit", form: delete_form_id, class: "button-danger",
        data: { turbo_confirm: confirm } %>
  <% end %>
  <%= link_to t("common.cancel"), cancel_path, role: "button", class: "button-secondary" %>
  <%= form.submit submit_label || t("common.save") %>
</footer>

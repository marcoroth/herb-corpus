<% content_for(:title) { @account.to_s } %>
<%= render layout: "shared/title_bar", locals: { title: @account.to_s } do %>
  <%= link_to t('common.show'), account_path(@account) %>
<% end %>
<article>
  <%= render "accounts/form", account: @account %>
</article>

<article>
  <%= render "shared/recent_transactions", transactions: @account.recent_transactions %>
</article>

<% content_for(:title) { t(".title") } %>
<%= render layout: "shared/title_bar", locals: { title: t(".title") } do %>
  <%= link_to t("common.new"), new_account_path %>
<% end %>

<% labels = {
  account_numbers: t('.account_numbers'),
  name: t('.name'),
  owner: t('.owner'),
  category: t('.category')
} %>
<% tables = {
  own: { heading: t('.own_accounts'), page: @own_page, accounts: @own_accounts, page_param: :own_page,
         columns: %i[account_numbers name owner category] },
  external: { heading: t('.external_accounts'), page: @external_page, accounts: @external_accounts,
              page_param: :external_page, columns: %i[account_numbers name category] }
} %>

<% tables.each do |kind, table| %>
  <article id="<%= kind %>-accounts">
    <h2 id="<%= kind %>-accounts-heading"><%= table[:heading] %></h2>

    <%= render "shared/pagination", page: table[:page], param: table[:page_param] %>

    <table class="accounts" id="<%= kind %>-accounts-table" data-stack="medium" role="table"
           aria-labelledby="<%= kind %>-accounts-heading">
      <thead role="rowgroup">
        <tr role="row">
          <% table[:columns].each do |column| %>
            <th scope="col" role="columnheader"><%= labels[column] %></th>
          <% end %>
        </tr>
      </thead>

      <tbody role="rowgroup">
        <% table[:accounts].each do |account| %>
          <tr role="row">
            <td role="cell" data-label="<%= labels[:account_numbers] %>"><%= safe_join(account.numbers, tag.br) %></td>
            <td role="cell" data-label="<%= labels[:name] %>"><%= link_to account.to_s, account_path(account) %></td>
            <% if kind == :own %>
              <td role="cell" data-label="<%= labels[:owner] %>"><%= account.owner_name %></td>
            <% end %>
            <td role="cell" data-label="<%= labels[:category] %>"><%= account.category&.name %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%= render "shared/pagination", page: table[:page], param: table[:page_param] %>
  </article>
<% end %>

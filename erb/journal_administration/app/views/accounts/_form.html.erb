<%# locals: (account:) %>
<%= form_with model: account do |f| %>
  <%= render "shared/form_errors", record: account %>

  <div class="field">
    <%= f.label :id %>
    <%= f.text_field :id, disabled: :disabled %>
  </div>
  <fieldset class="field">
    <legend><%= t('.account_numbers') %></legend>
    <%= f.fields_for :account_numbers do |number_form| %>
      <div>
        <%= number_form.text_field :number, value: number_form.object.number.to_s, aria: { label: t('.account_number') } %>
        <% if number_form.object.persisted? %>
          <%= number_form.check_box :_destroy %>
          <%= number_form.label :_destroy, t('.remove_number') %>
        <% end %>
      </div>
    <% end %>
  </fieldset>
  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>
  <div class="field">
    <%= f.label :managed_owner %>
    <%= f.select :managed_owner, managed_owner_options, include_blank: false %>
  </div>
  <div class="field">
    <%= f.label :category_id %>
    <%= f.select :category_id, grouped_category_options(selected: f.object.category_id), { include_blank: true } %>
  </div>

  <%= render "shared/action_row", form: f,
      cancel_path: account.persisted? ? account_path(account) : accounts_path,
      delete_form_id: (dom_id(account, :delete) if account.persisted?),
      confirm: t("common.confirm_delete_named", name: account.stored_label) %>
<% end %>
<% if account.persisted? %>
  <%= render "shared/delete_form", record: account, url: account_path(account) %>
<% end %>

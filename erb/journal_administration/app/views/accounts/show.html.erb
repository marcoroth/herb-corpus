<% content_for(:title) { @account.name } %>
<header>
  <h1><%= @account.name %></h1>
  <nav>
    <%= link_to t('.edit'), edit_account_path(@account) %>
  </nav>
</header>

<article>
<p>
  <b><%= t('.id') %></b>
  <%= @account.id %>
</p>
<p>
  <b><%= t('.account_number') %></b>
  <%= @account.account_number %>
</p>
<p>
  <b><%= t('.name') %></b>
  <%= @account.name %>
</p>
<p>
  <b><%= t('.owner') %></b>
  <%= @account.owner_name %>
</p>
<p>
  <b><%= t('.category') %></b>
  <%= @account.category&.name %>
</p>

<%= button_to t('.update_transactions'), account_transactions_bulk_path(@account), method: :patch %>
</article>

<% if @account.external? %>
  <article>
    <h2><%= t(".aliases") %></h2>
    <ul>
      <%= render @account.account_aliases %>
    </ul>
    <%= render "account_aliases/form", account: @account, account_alias: @account.account_aliases.build %>
    <%= button_to t(".absorb_transactions"), account_transaction_absorption_path(@account) %>
  </article>

  <article>
    <p><%= @account.payment_provider? ? t(".payment_provider_on") : t(".payment_provider_off") %></p>
    <% if @account.payment_provider? %>
      <%= button_to t(".unmark_payment_provider"), account_payment_provider_path(@account), method: :delete %>
      <%= button_to t(".move_to_merchants"), account_merchant_reassignment_path(@account),
          data: { turbo_confirm: t(".confirm_move_to_merchants") } %>
    <% else %>
      <%= button_to t(".mark_payment_provider"), account_payment_provider_path(@account) %>
    <% end %>
  </article>
<% end %>

<article>
  <%= render "shared/recent_transactions", transactions: @transactions, page: @transactions_page %>
</article>

<footer>
  <%= button_to t('common.destroy'), @account, method: :delete, class: "button-danger",
      data: { turbo_confirm: t('common.confirm_destroy'), confirm_verb: t('common.delete') } %>
</footer>

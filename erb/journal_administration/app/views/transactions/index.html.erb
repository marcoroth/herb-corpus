<% content_for(:title) { t(".title") } %>
<%= render layout: "shared/title_bar", locals: { title: t(".title") } do %>
  <%= link_to t("common.new"), new_transaction_path %>
<% end %>

<article class="transactions">
  <%= render partial: "transactions/table",
             locals: { transactions: @transactions, page: @page, show_uncategorized_amount: params[:filter] == "no_category" } %>
</article>

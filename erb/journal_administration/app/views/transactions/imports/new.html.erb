<% content_for(:title) { t('.heading') } %>
<%= render layout: "shared/title_bar", locals: { title: t('.heading') } do %>
  <%= link_to t('common.back'), transactions_path %>
<% end %>
<article class="upload">
  <%= form_with local: true, url: transactions_imports_path, multipart: true do |form| %>
    <%= form.file_field :csv %>
    <%= render "shared/action_row", form: form, cancel_path: transactions_path, submit_label: t('.submit') %>
  <% end %>
</article>

<%# locals: (transaction:) %>
<% chargeable_as_whole = transaction.type != "Transfer" && !transaction.split? %>
<%= tag.article id: "whole_payment_charge", hidden: !chargeable_as_whole do %>
  <% if chargeable_as_whole %>
    <h2><%= Appropriation.model_name.human %></h2>
    <%= render "appropriations/charge_form",
               url: transaction_appropriation_charge_path(transaction), chargeable: transaction %>
  <% end %>
<% end %>

<%# locals: (transaction:) %>

<section>
  <%= form_with model: transaction do |f| %>
    <%= render "shared/form_errors", record: transaction %>

    <fieldset>
      <%= f.label :id %>
      <%= f.text_field :id, disabled: :disabled %>

      <%= f.label :debitor %>
      <%= f.text_field :debitor, disabled: :disabled %>

      <%= f.label :creditor %>
      <%= f.text_field :creditor, disabled: :disabled %>

      <%= f.label :amount %>
      <%= f.text_field :amount,
        value: cents_field_value(f.object, :amount, separator: I18n.t("number.format.separator")) %>

      <%= f.label :category_id %>
      <%= f.select :category_id, grouped_category_options(selected: f.object.category_id), { include_blank: true } %>

      <%= f.label :note %>
      <%= f.text_area :note %>

      <%= f.label :booked_at %>
      <%= f.date_field :booked_at %>

      <%= f.label :interest_at %>
      <%= f.date_field :interest_at %>

      <%= f.label :type %>
      <%= f.collection_select(:type, Transaction::TYPES, :to_s, :to_s) %>

      <%= f.label :proof_of_purchase %>
      <%= f.file_field :proof_of_purchase, accept: "application/pdf" %>

      <% if Current.user.can_administer? %>
        <%= f.label :original_note %>
        <%= f.text_area :original_note, disabled: true %>

        <%= f.label :original_balance_after_mutation %>
        <%= f.text_field :original_balance_after_mutation, disabled: true,
          value: cents_field_value(f.object, :original_balance_after_mutation, separator: I18n.t("number.format.separator")) %>

        <%= f.label :original_tag %>
        <%= f.text_field :original_tag, disabled: true %>
      <% end %>
    </fieldset>

    <%= render "shared/action_row", form: f,
        cancel_path: transaction.persisted? ? polymorphic_path(transaction) : transactions_path,
        delete_form_id: (dom_id(transaction, :delete) if transaction.persisted?),
        confirm: t("common.confirm_delete_named", name: "#{transaction.creditor} ➡️ #{transaction.debitor}") %>
  <% end %>
  <% if transaction.persisted? %>
    <%= render "shared/delete_form", record: transaction, url: transaction_path(transaction) %>
  <% end %>
</section>

<% content_for(:title) { @category.name } %>
<%= render layout: "shared/title_bar", locals: { title: @category.name } do %>
  <%= link_to t('common.show'), category_path(@category) %>
<% end %>
<article>
  <%= render "categories/form", category: @category %>
</article>

<article>
  <%= render "shared/recent_transactions", transactions: @category.recent_transactions, category: @category %>
</article>

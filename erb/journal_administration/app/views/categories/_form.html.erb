<%# locals: (category:) %>
<section>
  <%= form_with model: category do |f| %>
    <%= render "shared/form_errors", record: category %>

    <%= f.label :name %>
    <%= f.text_field :name %>

    <%= f.label :direction %>
    <%= f.collection_select :direction, Category.directions.keys, :to_s, :to_s, { required: true } %>

    <%= f.label :parent_category %>
    <%= f.collection_select :parent_category_id, Category.groups, :id, :name, { include_blank: true } %>

    <%= render "shared/action_row", form: f,
        cancel_path: category.persisted? ? category_path(category) : categories_path,
        delete_form_id: (dom_id(category, :delete) if category.persisted?),
        confirm: t("common.confirm_delete_named", name: category.name_in_database) %>
  <% end %>
  <% if category.persisted? %>
    <%= render "shared/delete_form", record: category, url: category_path(category) %>
  <% end %>
</section>

<% content_for(:title) { t(".title") } %>
<%= render layout: "shared/title_bar", locals: { title: t(".title") } do %>
  <%= link_to t("common.new"), new_category_path %>
<% end %>

<% @category_groups.each_with_index do |(parent, categories), index| %>
  <article>
    <h2 id="category-group-<%= index %>"><%= parent&.name || t('.root_categories') %></h2>

    <table class="categories" data-stack="narrow" role="table" aria-labelledby="category-group-<%= index %>">
      <thead role="rowgroup">
        <tr role="row">
          <th scope="col" role="columnheader"><%= t('.name') %></th>
        </tr>
      </thead>
      <tbody role="rowgroup">
        <% categories.each do |category| %>
          <tr role="row">
            <td role="cell" data-label="<%= t('.name') %>"><%= link_to category.name, category_path(category) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </article>
<% end %>

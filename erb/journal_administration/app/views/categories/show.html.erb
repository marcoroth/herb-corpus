<% content_for(:title) { @category.name } %>
<%= render layout: "shared/title_bar", locals: { title: @category.name } do %>
  <%= link_to t('common.edit'), edit_category_path(@category) %>
<% end %>
<article>
  <dl>
    <dt><%= Category.human_attribute_name(:name) %></dt>
    <dd><%= @category.name %></dd>
    <dt><%= Category.human_attribute_name(:direction) %></dt>
    <dd><%= @category.direction %></dd>
    <dt><%= Category.human_attribute_name(:parent_category) %></dt>
    <dd><%= @category.parent_category&.name %></dd>
  </dl>
</article>

<article>
  <%= render "shared/recent_transactions", transactions: @category.recent_transactions, category: @category %>
</article>

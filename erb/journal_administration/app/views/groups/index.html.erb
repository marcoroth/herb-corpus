<% content_for(:title) { t("groups.index.heading") } %>
<%= render layout: "shared/title_bar", locals: { title: t("groups.index.heading") } do %>
  <%= link_to t("common.new"), new_group_path %>
<% end %>

<% labels = { name: Group.human_attribute_name(:name), members: t("groups.index.members") } %>
<article>
  <table data-stack="narrow" role="table" aria-label="<%= t("groups.index.heading") %>">
    <thead role="rowgroup">
      <tr role="row">
        <% labels.each_value do |label| %>
          <th scope="col" role="columnheader"><%= label %></th>
        <% end %>
      </tr>
    </thead>
    <tbody role="rowgroup">
      <% @groups.each do |group| %>
        <tr role="row">
          <td role="cell" data-label="<%= labels[:name] %>"><%= link_to group.name, group_path(group) %></td>
          <td role="cell" data-label="<%= labels[:members] %>"><%= group.people.map(&:name).to_sentence %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</article>

<% content_for(:title) { t("groups.index.heading") } %>
<header>
  <h1><%= t("groups.index.heading") %></h1>
  <nav><%= link_to t("groups.index.new"), new_group_path %></nav>
</header>

<article>
  <table>
    <thead><tr><th><%= Group.human_attribute_name(:name) %></th><th><%= t("groups.index.members") %></th><th></th></tr></thead>
    <tbody>
      <% @groups.each do |group| %>
        <tr>
          <td><%= link_to group.name, group %></td>
          <td><%= group.people.map(&:name).to_sentence %></td>
          <td><%= link_to t("groups.index.edit"), edit_group_path(group) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</article>

<% content_for(:title) { @group.name } %>
<header>
  <h1><%= @group.name %></h1>
  <nav><%= link_to t("groups.show.edit"), edit_group_path(@group) %></nav>
</header>

<article>
  <h2><%= t("groups.show.members") %></h2>
  <ul><% @group.people.order(:name).each do |person| %><li><%= person.name %></li><% end %></ul>
</article>

<footer>
  <%= button_to t("groups.show.destroy"), @group, method: :delete, class: "button-danger" %>
</footer>

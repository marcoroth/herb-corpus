<% content_for(:title) { @group.name } %>
<%= render layout: "shared/title_bar", locals: { title: @group.name } do %>
  <%= link_to t("groups.show.edit"), edit_group_path(@group) %>
<% end %>

<article>
  <dl>
    <dt><%= t("groups.show.members") %></dt>
    <dd><%= @group.people.order(:name).map(&:name).to_sentence %></dd>
  </dl>
</article>

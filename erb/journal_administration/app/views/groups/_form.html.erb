<%# locals: (group:) %>
<%= form_with model: group do |form| %>
  <% if group.errors.any? %>
    <div>
      <% group.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <fieldset>
    <legend><%= t("groups.form.members") %></legend>
    <%= form.label :name %>
    <%= form.text_field :name, required: true %>
    <%= form.collection_check_boxes :person_ids, Person.order(:name), :id, :name %>
  </fieldset>

  <%= form.submit %>
  <%= link_to t("common.cancel"), group.persisted? ? group : groups_path %>
<% end %>

<%# locals: (group:) %>
<%= form_with model: group do |form| %>
  <%= render "shared/form_errors", record: group %>

  <fieldset>
    <legend><%= t("groups.form.members") %></legend>
    <%= form.label :name %>
    <%= form.text_field :name, required: true %>
    <%= form.collection_check_boxes :person_ids, Person.order(:name), :id, :name %>
  </fieldset>

  <%= render "shared/action_row", form: form,
      cancel_path: group.persisted? ? group_path(group) : groups_path,
      delete_form_id: (dom_id(group, :delete) if group.persisted?),
      confirm: t("common.confirm_delete_named", name: group.name_in_database) %>
<% end %>
<% if group.persisted? %>
  <%= render "shared/delete_form", record: group, url: group_path(group) %>
<% end %>

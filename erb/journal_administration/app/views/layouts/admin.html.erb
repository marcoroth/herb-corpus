<!DOCTYPE html>
<html
  data-controller="theme"
  data-color-scheme="<%= theme_attributes[:"data-color-scheme"] %>"
  data-light-theme="<%= theme_attributes[:"data-light-theme"] %>"
  data-dark-theme="<%= theme_attributes[:"data-dark-theme"] %>"
  data-theme="<%= theme_attributes[:"data-theme"] %>"
>
  <head>
    <title>Admin - <%= Rails.application.class.module_parent_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-cache-control" content="no-cache">
    <meta name="view-transition" content="same-origin">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "appkit/shared/pwa_meta" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render "appkit/shared/skip_link" %>
    <header>
      <nav>
        <ul>
          <li><%= link_to t("admin.nav.dashboard"), admin_root_path, "aria-current": ("page" if current_page?(admin_root_path)) %></li>
          <li><%= link_to t("admin.nav.users"), admin_users_path, "aria-current": ("page" if current_page?(admin_users_path)) %></li>
          <li><%= link_to t("admin.nav.back_to_site"), root_path %></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <%= render "appkit/shared/flashes" %>

      <%= yield %>
    </main>

    <%= render "appkit/shared/confirm_dialog" %>
  </body>
</html>

<% content_for(:title) { t(".heading") } %>
<%= render "shared/title_bar", title: t(".heading") %>

<% if @receipts.empty? %>
  <p><%= t(".empty") %></p>
<% else %>
  <% labels = { date: t(".date"), shop: t(".shop"), total: t(".total"), payment: t(".payment") } %>
  <%= render "shared/pagination", page: @page %>

  <table id="receipts-table" data-stack="narrow" role="table" aria-label="<%= t(".heading") %>">
    <thead role="rowgroup">
      <tr role="row">
        <% labels.each_value do |label| %>
          <th scope="col" role="columnheader"><%= label %></th>
        <% end %>
      </tr>
    </thead>
    <tbody role="rowgroup">
      <% @receipts.each do |receipt| %>
        <tr role="row">
          <td role="cell" data-label="<%= labels[:date] %>">
            <%= link_to receipt_path(receipt) do %>
              <time datetime="<%= receipt.issued_on.iso8601 %>"><%= l(receipt.issued_on, format: :short) %></time>
            <% end %>
          </td>
          <td role="cell" data-label="<%= labels[:shop] %>"><%= receipt.shop.name %></td>
          <td role="cell" data-label="<%= labels[:total] %>"><data value="<%= receipt.total_amount %>"><%= cents_to_currency(receipt.total_amount) %></data></td>
          <td role="cell" data-label="<%= labels[:payment] %>"><%= receipt.payment ? t(".settled") : t(".not_settled") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= render "shared/pagination", page: @page %>
<% end %>

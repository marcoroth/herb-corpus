<header>
  <h1><%= t(".heading") %></h1>
</header>

<% if @receipts.empty? %>
  <p><%= t(".empty") %></p>
<% else %>
  <%= render "shared/pagination", page: @page %>

  <table id="receipts-table">
    <thead>
      <tr>
        <th><%= t(".date") %></th>
        <th><%= t(".shop") %></th>
        <th><%= t(".total") %></th>
        <th><%= t(".payment") %></th>
      </tr>
    </thead>
    <tbody>
      <% @receipts.each do |receipt| %>
        <tr>
          <td><%= link_to l(receipt.issued_on, format: :short), receipt_path(receipt) %></td>
          <td><%= receipt.shop.name %></td>
          <td><%= number_to_currency(receipt.total_amount) %></td>
          <td><%= receipt.payment ? t(".settled") : t(".not_settled") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= render "shared/pagination", page: @page %>
<% end %>

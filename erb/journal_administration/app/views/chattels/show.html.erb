<% content_for(:title) { @chattel.name } %>
<%= render layout: "shared/title_bar", locals: { title: @chattel.name } do %>
  <%= link_to t("common.back"), chattels_path %>
  <%= link_to t('common.edit'), edit_chattel_path(@chattel) %>
<% end %>
<article>
  <dl>
    <% %i[name brand kind model_number serial_number purchase_transaction_id].each do |attribute| %>
      <dt><%= Chattel.human_attribute_name(attribute) %></dt>
      <dd><%= @chattel.public_send(attribute) %></dd>
    <% end %>
    <dt><%= Chattel.human_attribute_name(:notes) %></dt>
    <dd><%= simple_format(@chattel.notes) %></dd>
    <% %i[purchased_at warranty_expires_at left_possession_at].each do |attribute| %>
      <dt><%= Chattel.human_attribute_name(attribute) %></dt>
      <dd>
        <% if @chattel.public_send(attribute).present? %>
          <% date = @chattel.public_send(attribute).to_date %>
          <time datetime="<%= date.iso8601 %>"><%= l(date) %></time>
        <% end %>
      </dd>
    <% end %>
    <dt><%= Chattel.human_attribute_name(:purchase_price) %></dt>
    <dd><%= cents_to_currency(@chattel.purchase_price) %></dd>
  </dl>

  <section>
    <h2><%= t('chattels.show.warranty_proof') %></h2>
    <% proof = @chattel.warranty_proof %>
    <% if proof %>
      <%= link_to t('chattels.show.view_warranty'), rails_blob_path(proof, disposition: :inline) %>
    <% else %>
      <p><%= t('chattels.show.no_warranty') %></p>
    <% end %>
  </section>
</article>

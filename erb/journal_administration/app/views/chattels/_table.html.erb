<%# locals: (header:, chattels:) %>
<% heading_id = "chattels-#{header.parameterize}" %>
<% labels = {
  name: Chattel.human_attribute_name(:name),
  brand: Chattel.human_attribute_name(:brand),
  kind: Chattel.human_attribute_name(:kind),
  model_number: Chattel.human_attribute_name(:model_number),
  purchased_at: Chattel.human_attribute_name(:purchased_at),
  warranty_expires_at: Chattel.human_attribute_name(:warranty_expires_at),
  left_possession_at: Chattel.human_attribute_name(:left_possession_at),
  purchase_price: Chattel.human_attribute_name(:purchase_price),
  proof: t('chattels.index.proof_of_purchase')
} %>
<h2 id="<%= heading_id %>"><%= header %></h2>

<table data-stack="wide" role="table" aria-labelledby="<%= heading_id %>">
  <thead role="rowgroup">
    <tr role="row">
      <% labels.each_value do |label| %>
        <th scope="col" role="columnheader"><%= label %></th>
      <% end %>
    </tr>
  </thead>

  <tbody role="rowgroup">
    <% chattels.each do |chattel| %>
      <tr role="row">
        <td role="cell" data-label="<%= labels[:name] %>"><%= link_to chattel.name, chattel_path(chattel) %></td>
        <td role="cell" data-label="<%= labels[:brand] %>"><%= chattel.brand %></td>
        <td role="cell" data-label="<%= labels[:kind] %>"><%= chattel.kind %></td>
        <td role="cell" data-label="<%= labels[:model_number] %>"><%= chattel.model_number %></td>
        <% %i[purchased_at warranty_expires_at left_possession_at].each do |attribute| %>
          <td role="cell" data-label="<%= labels[attribute] %>">
            <% if chattel.public_send(attribute).present? %>
              <% date = chattel.public_send(attribute).to_date %>
              <time datetime="<%= date.iso8601 %>"><%= l(date) %></time>
            <% end %>
          </td>
        <% end %>
        <td role="cell" data-label="<%= labels[:purchase_price] %>">
          <data value="<%= chattel.purchase_price %>"><%= cents_to_currency(chattel.purchase_price) %></data>
        </td>
        <td role="cell" data-label="<%= labels[:proof] %>"><%= chattel.proof_of_purchase? ? t('chattels.index.has_proof') : t('chattels.index.no_proof') %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<% content_for(:title) { t(".title") } %>
<%= render layout: "shared/title_bar", locals: { title: t(".title") } do %>
  <%= link_to t("common.new"), new_chattel_path %>
<% end %>
<article>
  <%= render "table", header: t("warrantied"), chattels: @warrantied if @warrantied.present? %>
  <%= render "table", header: t("out_of_warranty"), chattels: @out_of_warranty if @out_of_warranty.present? %>
  <%= render "table", header: t("unknown_warranty"), chattels: @unknown_warranty if @unknown_warranty.present? %>
  <%= render "table", header: t("left"), chattels: @left if @left.present? %>
</article>

<%# locals: (chattel:, brands_in_use:) %>
<section>
  <%= form_with model: chattel do |f| %>
    <%= render "shared/form_errors", record: chattel %>

    <div class="field">
      <%= f.label :name %>
      <%= f.text_field :name %>
    </div>
    <div class="field">
      <%= f.label :brand %>
      <%= f.text_field :brand, list: "brands-in-use" %>
      <datalist id="brands-in-use">
        <% brands_in_use.each do |brand| %>
          <option value="<%= brand %>"></option>
        <% end %>
      </datalist>
    </div>
    <div class="field">
      <%= f.label :kind %>
      <%= f.text_field :kind %>
    </div>
    <div class="field">
      <%= f.label :model_number %>
      <%= f.text_field :model_number %>
    </div>
    <div class="field">
      <%= f.label :serial_number %>
      <%= f.text_field :serial_number %>
    </div>
    <div class="field">
      <%= f.label :purchase_transaction_id %>
      <%= f.number_field :purchase_transaction_id %>
    </div>
    <div class="field">
      <%= f.label :purchased_at %>
      <%= f.date_field :purchased_at %>
    </div>
    <div class="field">
      <%= f.label :warranty_expires_at %>
      <%= f.date_field :warranty_expires_at %>
    </div>
    <div class="field">
      <%= f.label :left_possession_at %>
      <%= f.date_field :left_possession_at %>
    </div>
    <div class="field">
      <%= f.label :purchase_price %>
      <%= f.text_field :purchase_price,
        value: cents_field_value(f.object, :purchase_price, separator: I18n.t("number.format.separator")) %>
    </div>
    <div class="field">
      <%= f.label :notes %>
      <%= f.text_area :notes %>
    </div>

    <%= f.label :warranty_document %>
    <%= f.file_field :warranty_document, accept: "application/pdf" %>

    <%= render "shared/action_row", form: f,
        cancel_path: chattel.persisted? ? chattel_path(chattel) : chattels_path,
        delete_form_id: (dom_id(chattel, :delete) if chattel.persisted?),
        confirm: t("common.confirm_delete_named", name: chattel.name_in_database) %>
  <% end %>
  <% if chattel.persisted? %>
    <%= render "shared/delete_form", record: chattel, url: chattel_path(chattel) %>
  <% end %>
</section>

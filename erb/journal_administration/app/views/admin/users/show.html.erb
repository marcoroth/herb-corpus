<% content_for(:title) { t(".title") } %>
<%= render layout: "shared/title_bar", locals: { title: t(".title") } do %>
  <%= link_to t("admin.users.show.edit"), edit_admin_user_path(@user) %>
  <%= link_to t("common.back"), admin_users_path %>
<% end %>
<article>
  <dl>
    <dt><%= t(".name") %></dt>
    <dd><%= @user.name %></dd>

    <dt><%= t(".email") %></dt>
    <dd><%= @user.email_address %></dd>

    <dt><%= t(".role") %></dt>
    <dd><%= @user.role %></dd>

    <dt><%= t(".created_at") %></dt>
    <dd><%= l(@user.created_at, format: :long) %></dd>

    <dt><%= t(".active_sessions") %></dt>
    <dd><%= @user.sessions.count %></dd>
  </dl>
</article>

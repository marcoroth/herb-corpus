<% content_for(:title) { t(".title") } %>
<%= render layout: "shared/title_bar", locals: { title: t(".title") } do %>
  <%= link_to t("common.show"), admin_user_path(@user) %>
<% end %>

<article>
  <%= render "admin/users/form",
             user: @user,
             url: admin_user_path(@user),
             submit_label: t(".submit"),
             cancel_path: admin_user_path(@user) %>
</article>

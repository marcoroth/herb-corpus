<% content_for(:title) { t(".title") } %>
<%= render "shared/title_bar", title: t(".title") %>

<article>
  <h2><%= t(".summary") %></h2>
  <dl>
    <dt><%= t(".total_users") %></dt>
    <dd><%= @total_users %></dd>

    <dt><%= t(".admin_users") %></dt>
    <dd><%= @admin_users %></dd>
  </dl>
</article>

<article>
  <h2 id="recent-signups-heading"><%= t(".recent_signups") %></h2>

  <% labels = { name: t(".name"), email: t(".email"), role: t(".role"), created_at: t(".created_at") } %>
  <table data-stack="medium" role="table" aria-labelledby="recent-signups-heading">
    <thead role="rowgroup">
      <tr role="row">
        <% labels.each_value do |label| %>
          <th scope="col" role="columnheader"><%= label %></th>
        <% end %>
      </tr>
    </thead>
    <tbody role="rowgroup">
      <% @users.each do |user| %>
        <tr role="row">
          <td role="cell" data-label="<%= labels[:name] %>"><%= link_to user.name.presence || user.email_address, admin_user_path(user) %></td>
          <td role="cell" data-label="<%= labels[:email] %>"><%= user.email_address %></td>
          <td role="cell" data-label="<%= labels[:role] %>"><%= user.role %></td>
          <td role="cell" data-label="<%= labels[:created_at] %>"><time datetime="<%= user.created_at.iso8601 %>"><%= l(user.created_at, format: :long) %></time></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</article>

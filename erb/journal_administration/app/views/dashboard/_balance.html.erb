<%# locals: (dashboard:) %>
<% debits = dashboard.debit_transactions %>
<% credits = dashboard.credit_transactions %>
<% show_budget = dashboard.active_budget.present? %>
<% budget_amounts = show_budget ? dashboard.budget_amounts : {} %>
<% debit_budget_only = show_budget ? budget_amounts.keys.select { |c| c.debit? && !debits.key?(c) } : [] %>
<% credit_budget_only = show_budget ? budget_amounts.keys.select { |c| c.credit? && !credits.key?(c) } : [] %>
<% debit_rows = debits.keys + debit_budget_only %>
<% credit_rows = credits.keys + credit_budget_only %>
<% labels = {
  debit: {
    name: "#{t('balance.debit')}: #{t('balance.category_name')}",
    amount: "#{t('balance.debit')}: #{t('balance.total_amount')}",
    budget: "#{t('balance.debit')}: #{t('balance.budget')}",
    status: "#{t('balance.debit')}: #{t('balance.status')}"
  },
  credit: {
    name: "#{t('balance.credit')}: #{t('balance.category_name')}",
    amount: "#{t('balance.credit')}: #{t('balance.total_amount')}",
    budget: "#{t('balance.credit')}: #{t('balance.target')}",
    status: "#{t('balance.credit')}: #{t('balance.status')}"
  }
} %>
<table class="debit_credit" data-stack="wide" role="table" aria-label="<%= t('balance.debit') %> / <%= t('balance.credit') %>">
  <thead role="rowgroup">
    <tr role="row">
      <th role="columnheader" colspan="<%= show_budget ? 4 : 2 %>"><%= t('balance.debit') %></th>
      <th role="columnheader" colspan="<%= show_budget ? 4 : 2 %>"><%= t('balance.credit') %></th>
    </tr>
    <tr role="row">
      <th scope="col" role="columnheader"><%= t('balance.category_name') %></th>
      <th scope="col" role="columnheader"><%= t('balance.total_amount') %></th>
      <% if show_budget %>
        <th scope="col" role="columnheader"><%= t('balance.budget') %></th>
        <th scope="col" role="columnheader"><%= t('balance.status') %></th>
      <% end %>
      <th scope="col" role="columnheader"><%= t('balance.category_name') %></th>
      <th scope="col" role="columnheader"><%= t('balance.total_amount') %></th>
      <% if show_budget %>
        <th scope="col" role="columnheader"><%= t('balance.target') %></th>
        <th scope="col" role="columnheader"><%= t('balance.status') %></th>
      <% end %>
    </tr>
  </thead>
  <tbody role="rowgroup">
    <% (-1..[debit_rows.count, credit_rows.count].max).each do |i| %>
      <tr role="row">
        <% if i < 0 %>
          <td role="cell" data-label="<%= labels[:debit][:name] %>"></td>
          <td role="cell" data-label="<%= labels[:debit][:amount] %>" class="amount"></td>
          <% if show_budget %>
            <td role="cell" data-label="<%= labels[:debit][:budget] %>"></td>
            <td role="cell" data-label="<%= labels[:debit][:status] %>"></td>
          <% end %>
          <td role="cell" data-label="<%= labels[:credit][:name] %>" class="profit-and-loss"><%= t "balance.profit_or_loss" %></td>
          <td role="cell" data-label="<%= labels[:credit][:amount] %>" class="profit-and-loss amount"><%= cents_to_currency dashboard.profit_or_loss %></td>
          <% if show_budget %>
            <td role="cell" data-label="<%= labels[:credit][:budget] %>"></td>
            <td role="cell" data-label="<%= labels[:credit][:status] %>"></td>
          <% end %>
        <% else %>
          <% debit_cat = debit_rows.count > i ? debit_rows[i] : nil %>
          <% credit_cat = credit_rows.count > i ? credit_rows[i] : nil %>
          <td role="cell" data-label="<%= labels[:debit][:name] %>"><%= debit_cat.blank? ? (debit_rows.count > i ? '-' : '') : debit_cat&.full_name %></td>
          <td role="cell" data-label="<%= labels[:debit][:amount] %>" class="amount"><%= (debit_rows.count > i && debits.key?(debit_cat)) ? cents_to_currency(debits[debit_cat]) : '' %></td>
          <% if show_budget %>
            <% debit_budgeted = debit_cat && budget_amounts[debit_cat] %>
            <td role="cell" data-label="<%= labels[:debit][:budget] %>" class="amount"><%= debit_budgeted ? cents_to_currency(debit_budgeted) : '' %></td>
            <td role="cell" data-label="<%= labels[:debit][:status] %>">
              <% if debit_cat && debit_budgeted %>
                <% debit_actual = dashboard.budget_actuals[debit_cat].to_f %>
                <% status = budget_status(category: debit_cat, actual: debit_actual, budgeted: debit_budgeted) %>
                <% pct_label = budget_pct_label(actual: debit_actual, budgeted: debit_budgeted) %>
                <% css_class = "budget-status budget-status--#{status}" %>
                <span class="<%= css_class %>"><%= pct_label %></span>
              <% end %>
            </td>
          <% end %>
          <td role="cell" data-label="<%= labels[:credit][:name] %>"><%= credit_cat.blank? ? (credit_rows.count > i ? '-' : '') : credit_cat&.full_name %></td>
          <td role="cell" data-label="<%= labels[:credit][:amount] %>" class="amount"><%= (credit_rows.count > i && credits.key?(credit_cat)) ? cents_to_currency(credits[credit_cat]) : '' %></td>
          <% if show_budget %>
            <% credit_budgeted = credit_cat && budget_amounts[credit_cat] %>
            <td role="cell" data-label="<%= labels[:credit][:budget] %>" class="amount"><%= credit_budgeted ? cents_to_currency(credit_budgeted) : '' %></td>
            <td role="cell" data-label="<%= labels[:credit][:status] %>">
              <% if credit_cat && credit_budgeted %>
                <% credit_actual = -dashboard.budget_actuals[credit_cat].to_f %>
                <% status = budget_status(category: credit_cat, actual: credit_actual, budgeted: credit_budgeted) %>
                <% pct_label = budget_pct_label(actual: credit_actual, budgeted: credit_budgeted) %>
                <% css_class = "budget-status budget-status--#{status}" %>
                <span class="<%= css_class %>"><%= pct_label %></span>
              <% end %>
            </td>
          <% end %>
        <% end %>
      </tr>
    <% end %>
  </tbody>
  <tfoot role="rowgroup">
    <tr role="row">
      <td role="cell" data-label="<%= labels[:debit][:name] %>"><%= t('balance.totals') %></td>
      <td role="cell" data-label="<%= labels[:debit][:amount] %>" class="amount"><%= cents_to_currency dashboard.debit_total %></td>
      <% if show_budget %>
        <td role="cell" data-label="<%= labels[:debit][:budget] %>"></td>
        <td role="cell" data-label="<%= labels[:debit][:status] %>"></td>
      <% end %>
      <td role="cell" data-label="<%= labels[:credit][:name] %>"><%= t('balance.totals') %></td>
      <td role="cell" data-label="<%= labels[:credit][:amount] %>" class="amount"><%= cents_to_currency dashboard.credit_total %></td>
      <% if show_budget %>
        <td role="cell" data-label="<%= labels[:credit][:budget] %>"></td>
        <td role="cell" data-label="<%= labels[:credit][:status] %>"></td>
      <% end %>
    </tr>
  </tfoot>
</table>

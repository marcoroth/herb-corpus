<%# locals: (product_type:, categories:) %>
<section>
  <%= form_with model: product_type do |f| %>
    <%= render "shared/form_errors", record: product_type %>

    <%= f.label :name %>
    <%= f.text_field :name, required: true %>

    <%= f.label :category %>
    <%= f.collection_select :category_id, categories, :id, :name, { include_blank: true }, { required: true } %>

    <%= render "shared/action_row", form: f,
        cancel_path: product_type.persisted? ? product_type_path(product_type) : product_types_path %>
  <% end %>
</section>

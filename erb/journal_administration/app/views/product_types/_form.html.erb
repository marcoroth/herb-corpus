<%# locals: (product_type:, categories:) %>
<section>
  <%= form_for product_type do |f| %>
    <% if product_type.errors.any? %>
      <div id="error_explanation">
        <h2>
          <%= t("errors.template.header",
                count: product_type.errors.count,
                model: ProductType.model_name.human.downcase) %>
        </h2>
        <ul>
          <% product_type.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= f.label :name %>
    <%= f.text_field :name, required: true %>

    <%= f.label :category %>
    <%= f.collection_select :category_id, categories, :id, :name, { include_blank: true }, { required: true } %>

    <nav>
      <%= f.submit %>
      <%= link_to t("common.cancel"), product_types_path %>
    </nav>
  <% end %>
</section>

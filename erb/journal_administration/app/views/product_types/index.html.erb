<% content_for(:title) { t(".heading") } %>
<%= render layout: "shared/title_bar", locals: { title: t(".heading") } do %>
  <%= link_to t("common.new"), new_product_type_path %>
<% end %>

<% if @product_types.empty? %>
  <p><%= t(".empty") %></p>
<% else %>
  <% labels = { name: t(".name"), category: t(".category") } %>
  <table id="product-types-table" data-stack="narrow" role="table" aria-label="<%= t(".heading") %>">
    <thead role="rowgroup">
      <tr role="row">
        <% labels.each_value do |label| %>
          <th scope="col" role="columnheader"><%= label %></th>
        <% end %>
      </tr>
    </thead>
    <tbody role="rowgroup">
      <% @product_types.each do |product_type| %>
        <tr role="row">
          <td role="cell" data-label="<%= labels[:name] %>"><%= link_to product_type.name, product_type_path(product_type) %></td>
          <td role="cell" data-label="<%= labels[:category] %>"><%= product_type.category.name %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

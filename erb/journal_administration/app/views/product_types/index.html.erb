<header>
  <h1><%= t(".heading") %></h1>
  <nav>
    <%= link_to t(".new"), new_product_type_path %>
  </nav>
</header>

<% if @product_types.empty? %>
  <p><%= t(".empty") %></p>
<% else %>
  <table id="product-types-table">
    <thead>
      <tr>
        <th><%= t(".name") %></th>
        <th><%= t(".category") %></th>
        <th><%= t(".actions") %></th>
      </tr>
    </thead>
    <tbody>
      <% @product_types.each do |product_type| %>
        <tr>
          <td><%= link_to product_type.name, product_type_path(product_type) %></td>
          <td><%= product_type.category.name %></td>
          <td><%= link_to t("common.edit"), edit_product_type_path(product_type) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<header>
  <h1><%= @product_type.name %></h1>
  <nav>
    <%= link_to t("common.edit"), edit_product_type_path(@product_type) %>
  </nav>
</header>

<article>
  <dl>
    <dt><%= ProductType.human_attribute_name(:category) %></dt>
    <dd><%= @product_type.category.name %></dd>
  </dl>

  <% if @latest_purchases.empty? %>
    <p><%= t(".never_bought") %></p>
  <% else %>
    <section>
      <h2><%= t(".brands") %></h2>

      <table id="brands-table">
        <thead>
          <tr>
            <th><%= t("products.index.brand") %></th>
            <th><%= t("products.index.name") %></th>
            <th><%= t(".last_bought") %></th>
            <th><%= t("receipts.basket.paid") %></th>
          </tr>
        </thead>
        <tbody>
          <% @latest_purchases.each do |product, purchase| %>
            <tr>
              <td><%= product.brand.presence || t("products.index.unclassified") %></td>
              <td><%= link_to product.name, product_path(product) %></td>
              <td><%= l purchase.receipt.issued_on, format: :short %></td>
              <td><%= number_to_currency(purchase.paid_amount) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>

    <section>
      <h2><%= t(".per_month") %></h2>

      <table id="monthly-totals-table">
        <thead>
          <tr>
            <th><%= t(".month") %></th>
            <th><%= t(".spent") %></th>
            <th><%= t(".bought") %></th>
            <th><%= t(".on_bonus") %></th>
          </tr>
        </thead>
        <tbody>
          <% @monthly_totals.each do |month, totals| %>
            <tr>
              <td><%= l month, format: :month_and_year %></td>
              <td><%= number_to_currency(totals.spent) %></td>
              <td><%= totals.count %></td>
              <td><%= totals.on_bonus_count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>
</article>

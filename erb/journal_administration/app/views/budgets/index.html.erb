<% content_for(:title) { t("budgets.index.title") } %>
<%= render layout: "shared/title_bar", locals: { title: t("budgets.index.title") } do %>
  <%= link_to t("common.new"), new_budget_path %>
<% end %>

<% labels = {
  date_range: t("budgets.index.date_range"),
  status: t("budgets.index.status"),
  categories: t("budgets.index.categories")
} %>
<article>
  <table data-stack="narrow" role="table" aria-label="<%= t("budgets.index.title") %>">
    <thead role="rowgroup">
      <tr role="row">
        <% labels.each_value do |label| %>
          <th scope="col" role="columnheader"><%= label %></th>
        <% end %>
      </tr>
    </thead>
    <tbody role="rowgroup">
      <% @budgets.each do |budget| %>
        <tr role="row">
          <td role="cell" data-label="<%= labels[:date_range] %>"><%= link_to budget.to_s, budget_path(budget) %></td>
          <td role="cell" data-label="<%= labels[:status] %>">
            <span>
              <% if budget.active? %>
                <%= t("budgets.index.active") %>
              <% elsif budget.future? %>
                <%= t("budgets.index.future") %>
              <% else %>
                <%= t("budgets.index.past") %>
              <% end %>
            </span>
          </td>
          <td role="cell" data-label="<%= labels[:categories] %>"><%= budget.budget_categories.size %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</article>

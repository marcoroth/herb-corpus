<% content_for(:title) { t(".heading", year: @year) } %>
<header>
  <h1><%= t(".heading", year: @year) %></h1>
  <nav>
    <%= link_to t(".previous_year", year: @year - 1), appropriations_path(year: @year - 1) %>
    <%= link_to t(".next_year", year: @year + 1), appropriations_path(year: @year + 1) %>
    <%= link_to t(".new"), new_appropriation_path %>
  </nav>
</header>

<article>
  <% if @appropriations.empty? %>
    <p><%= t(".empty", year: @year) %></p>
  <% else %>
    <table>
      <thead>
        <tr>
          <th><%= Appropriation.human_attribute_name(:purpose) %></th>
          <th><%= Appropriation.human_attribute_name(:recipient) %></th>
          <th><%= Appropriation.human_attribute_name(:amount) %></th>
          <th><%= t(".charged") %></th>
          <th><%= t(".balance") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @appropriations.each do |appropriation| %>
          <tr>
            <td><%= link_to appropriation.purpose, appropriation %></td>
            <td><%= appropriation.recipient %></td>
            <td><%= number_to_currency(appropriation.amount) %></td>
            <td><%= number_to_currency(appropriation.charged) %></td>
            <td><%= render "appropriations/balance", appropriation: appropriation %></td>
            <td>
              <%= link_to t(".edit"), edit_appropriation_path(appropriation) %>
              <%= button_to t(".delete"), appropriation_path(appropriation), method: :delete,
                  data: { turbo_confirm: t(".confirm_destroy"), confirm_verb: t("common.delete") } %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <th><%= t(".total") %></th>
          <td></td>
          <td><%= number_to_currency(@appropriations.sum(&:amount)) %></td>
          <td><%= number_to_currency(@appropriations.sum(&:charged)) %></td>
          <td><%= number_to_currency(@appropriations.sum(&:balance)) %></td>
          <td></td>
        </tr>
      </tfoot>
    </table>
  <% end %>
</article>

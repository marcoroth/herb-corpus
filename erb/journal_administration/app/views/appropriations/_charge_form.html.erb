<%# locals: (url:, chargeable:) %>
<%= form_with scope: :appropriation_charge, url: url, method: :patch, namespace: dom_id(chargeable),
      data: { turbo_frame: "_top" } do |f| %>
  <%= f.label :appropriation_id, Appropriation.model_name.human %>
  <%= f.select :appropriation_id, grouped_appropriation_options(selected: chargeable.appropriation), {}, required: true %>
  <%= f.submit t("appropriations.charge_form.charge") %>
<% end %>
<% if chargeable.appropriation %>
  <%= button_to t("appropriations.charge_form.remove"), url, method: :delete, form: { data: { turbo_frame: "_top" } } %>
<% end %>

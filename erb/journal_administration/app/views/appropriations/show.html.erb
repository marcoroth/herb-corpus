<% content_for(:title) { @appropriation.to_s } %>
<%= render layout: "shared/title_bar", locals: { title: @appropriation.to_s } do %>
  <%= link_to t(".edit"), edit_appropriation_path(@appropriation) %>
  <%= link_to t("common.back"), appropriations_path(year: @appropriation.budget_year) %>
<% end %>

<article>
  <dl>
    <dt><%= Appropriation.human_attribute_name(:amount) %></dt>
    <dd><%= cents_to_currency(@appropriation.amount) %></dd>

    <dt><%= t(".charged") %></dt>
    <dd><%= cents_to_currency(@appropriation.charged) %></dd>

    <dt><%= t(".balance") %></dt>
    <dd><%= render "appropriations/balance", appropriation: @appropriation %></dd>
  </dl>

  <% charges = @appropriation.charges %>
  <% if charges.empty? %>
    <p><%= t(".no_charges") %></p>
  <% else %>
    <table>
      <thead>
        <tr>
          <th><%= t(".date") %></th>
          <th><%= t(".note") %></th>
          <th><%= t(".amount") %></th>
        </tr>
      </thead>
      <tbody>
        <% charges.each do |charge| %>
          <tr>
            <td><%= charge.booked_at ? l(charge.booked_at.to_date) : "-" %></td>
            <td><%= charge.note %></td>
            <td><%= cents_to_currency(charge.amount) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</article>

<%# locals: (appropriation:) %>
<%= form_with model: appropriation do |f| %>
  <% if appropriation.errors.any? %>
    <div>
      <% appropriation.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <fieldset>
    <%= f.label :purpose %>
    <%= f.text_field :purpose, required: true %>

    <%= f.label :recipient %>
    <%= f.text_field :recipient, required: true, list: "recipient_suggestions" %>
    <datalist id="recipient_suggestions">
      <% Appropriation.recipient_suggestions.each do |name| %>
        <option value="<%= name %>"></option>
      <% end %>
    </datalist>

    <%= f.label :budget_year %>
    <%= f.number_field :budget_year, step: 1, required: true %>

    <%= f.label :amount %>
    <%= f.number_field :amount, step: "0.01", min: "0.01", required: true %>
  </fieldset>

  <%= f.submit %>
  <%= link_to t("common.cancel"), appropriation.persisted? ? appropriation : appropriations_path %>
<% end %>

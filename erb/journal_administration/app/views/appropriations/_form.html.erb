<%# locals: (appropriation:) %>
<%= form_with model: appropriation do |f| %>
  <%= render "shared/form_errors", record: appropriation %>

  <fieldset>
    <%= f.label :purpose %>
    <%= f.text_field :purpose, required: true %>

    <%= f.label :person_id, Appropriation.human_attribute_name(:recipient) %>
    <%= f.collection_select :person_id, Person.order(:name), :id, :name, { include_blank: true }, required: true %>

    <%= f.label :budget_year %>
    <%= f.number_field :budget_year, step: 1, required: true %>

    <%= f.label :amount %>
    <%= f.number_field :amount, step: "0.01", min: "0.01", required: true,
          value: cents_field_value(appropriation, :amount, separator: ".") %>
  </fieldset>

  <%= render "shared/action_row", form: f,
      cancel_path: appropriation.persisted? ? appropriation_path(appropriation) : appropriations_path,
      delete_form_id: (dom_id(appropriation, :delete) if appropriation.persisted?),
      confirm: t("common.confirm_delete_named", name: appropriation.to_s) %>
<% end %>
<% if appropriation.persisted? %>
  <%= render "shared/delete_form", record: appropriation, url: appropriation_path(appropriation) %>
<% end %>

<% content_for(:title) { t("people.index.heading") } %>
<header>
  <h1><%= t("people.index.heading") %></h1>
  <nav><%= link_to t("people.index.new"), new_person_path %></nav>
</header>

<article>
  <table>
    <thead>
      <tr>
        <th><%= Person.human_attribute_name(:name) %></th>
        <th><%= Person.human_attribute_name(:household) %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @people.each do |person| %>
        <tr>
          <td><%= link_to person.name, person %></td>
          <td><%= t("people.household.#{person.household?}") %></td>
          <td><%= link_to t("people.index.edit"), edit_person_path(person) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</article>

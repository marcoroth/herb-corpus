<% content_for(:title) { t("people.index.heading") } %>
<%= render layout: "shared/title_bar", locals: { title: t("people.index.heading") } do %>
  <%= link_to t("common.new"), new_person_path %>
<% end %>

<% labels = { name: Person.human_attribute_name(:name), household: Person.human_attribute_name(:household) } %>
<article>
  <table data-stack="narrow" role="table" aria-label="<%= t("people.index.heading") %>">
    <thead role="rowgroup">
      <tr role="row">
        <% labels.each_value do |label| %>
          <th scope="col" role="columnheader"><%= label %></th>
        <% end %>
      </tr>
    </thead>
    <tbody role="rowgroup">
      <% @people.each do |person| %>
        <tr role="row">
          <td role="cell" data-label="<%= labels[:name] %>"><%= link_to person.name, person_path(person) %></td>
          <td role="cell" data-label="<%= labels[:household] %>"><%= t("people.household.#{person.household?}") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</article>

<% content_for(:title) { @person.name } %>
<header>
  <h1><%= @person.name %></h1>
  <nav><%= link_to t("people.show.edit"), edit_person_path(@person) %></nav>
</header>

<article>
  <p><b><%= Person.human_attribute_name(:household) %></b> <%= t("people.household.#{@person.household?}") %></p>
</article>

<footer>
  <%= button_to t("people.show.destroy"), @person, method: :delete, class: "button-danger" %>
</footer>

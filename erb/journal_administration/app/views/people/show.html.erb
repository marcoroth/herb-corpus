<% content_for(:title) { @person.name } %>
<%= render layout: "shared/title_bar", locals: { title: @person.name } do %>
  <%= link_to t("people.show.edit"), edit_person_path(@person) %>
<% end %>

<article>
  <dl>
    <dt><%= Person.human_attribute_name(:household) %></dt>
    <dd><%= t("people.household.#{@person.household?}") %></dd>
  </dl>
</article>

<%# locals: (person:) %>
<%= form_with model: person do |form| %>
  <%= render "shared/form_errors", record: person %>

  <fieldset>
    <%= form.label :name %>
    <%= form.text_field :name, required: true %>
    <%= form.label :household %>
    <%= form.check_box :household %>
  </fieldset>

  <%= render "shared/action_row", form: form,
      cancel_path: person.persisted? ? person_path(person) : people_path,
      delete_form_id: (dom_id(person, :delete) if person.persisted?),
      confirm: t("common.confirm_delete_named", name: person.name_in_database) %>
<% end %>
<% if person.persisted? %>
  <%= render "shared/delete_form", record: person, url: person_path(person) %>
<% end %>

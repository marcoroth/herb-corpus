<%# locals: (person:) %>
<%= form_with model: person do |form| %>
  <% if person.errors.any? %>
    <div>
      <% person.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <fieldset>
    <%= form.label :name %>
    <%= form.text_field :name, required: true %>
    <%= form.label :household %>
    <%= form.check_box :household %>
  </fieldset>

  <%= form.submit %>
  <%= link_to t("common.cancel"), person.persisted? ? person : people_path %>
<% end %>

<% content_for(:title) { t(".heading") } %>
<%= render layout: "shared/title_bar", locals: { title: t(".heading") } do %>
  <%= link_to t("common.show"), product_path(@product) %>
<% end %>

<p><%= @product.name %></p>

<%= render "products/form", product: @product, brands_in_use: @brands_in_use, product_types: @product_types %>

<header>
  <h1><%= @product.name %></h1>
  <nav>
    <%= link_to t("common.edit"), edit_product_path(@product) %>
  </nav>
</header>

<article>
  <dl>
    <dt><%= Product.human_attribute_name(:brand) %></dt>
    <dd><%= @product.brand.presence || t(".unknown") %></dd>

    <dt><%= Product.human_attribute_name(:product_type) %></dt>
    <dd><%= @product.product_type&.name || t(".unknown") %></dd>
  </dl>

  <section>
    <h2><%= t(".purchases") %></h2>

    <% if @purchases.empty? %>
      <p><%= t(".never_bought") %></p>
    <% else %>
      <% if @purchases.size > 1 %>
        <%= render "price_chart", purchases: @purchases.to_a.reverse %>
      <% end %>

      <table id="purchases-table">
        <thead>
          <tr>
            <th><%= t("receipts.index.date") %></th>
            <th><%= t("receipts.basket.quantity") %></th>
            <th><%= t("receipts.basket.shelf_price") %></th>
            <th><%= t("receipts.basket.bonus") %></th>
            <th><%= t("receipts.basket.paid") %></th>
          </tr>
        </thead>
        <tbody>
          <% @purchases.each do |purchase| %>
            <tr>
              <td><%= link_to l(purchase.receipt.issued_on, format: :short), receipt_path(purchase.receipt) %></td>
              <td><%= number_with_precision(purchase.quantity, precision: 3, strip_insignificant_zeros: true) %></td>
              <td><%= number_to_currency(purchase.full_amount) %></td>
              <td><%= purchase.on_bonus? ? number_to_currency(purchase.discount_amount) : "-" %></td>
              <td><%= number_to_currency(purchase.paid_amount) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>
</article>

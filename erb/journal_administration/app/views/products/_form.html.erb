<%# locals: (product:, brands_in_use:, product_types:) %>
<section>
  <%= form_for product do |f| %>
    <% if product.errors.any? %>
      <div id="error_explanation">
        <h2>
          <%= t("errors.template.header", count: product.errors.count, model: Product.model_name.human.downcase) %>
        </h2>
        <ul>
          <% product.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= f.label :name %>
    <%= f.text_field :name, required: true %>

    <%= f.label :brand %>
    <%= f.text_field :brand, list: "brands-in-use" %>
    <datalist id="brands-in-use">
      <% brands_in_use.each do |brand| %>
        <option value="<%= brand %>"></option>
      <% end %>
    </datalist>

    <%= f.label :product_type %>
    <%= f.collection_select :product_type_id, product_types, :id, :name, { include_blank: true } %>

    <nav>
      <%= f.submit %>
      <%= link_to t("common.cancel"), products_path %>
    </nav>
  <% end %>
</section>

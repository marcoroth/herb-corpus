<% content_for(:title) { t(".heading") } %>
<%= render "shared/title_bar", title: t(".heading") %>

<% if @products.empty? %>
  <p><%= t(".empty") %></p>
<% else %>
  <% labels = { name: t(".name"), brand: t(".brand"), product_type: t(".product_type") } %>
  <%= render "shared/pagination", page: @page %>

  <table id="products-table" data-stack="narrow" role="table" aria-label="<%= t(".heading") %>">
    <thead role="rowgroup">
      <tr role="row">
        <% labels.each_value do |label| %>
          <th scope="col" role="columnheader"><%= label %></th>
        <% end %>
      </tr>
    </thead>
    <tbody role="rowgroup">
      <% @products.each do |product| %>
        <tr role="row">
          <td role="cell" data-label="<%= labels[:name] %>"><%= link_to product.name, product_path(product) %></td>
          <td role="cell" data-label="<%= labels[:brand] %>"><%= product.brand.presence || t(".unclassified") %></td>
          <td role="cell" data-label="<%= labels[:product_type] %>"><%= product.product_type&.name || t(".unclassified") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= render "shared/pagination", page: @page %>
<% end %>

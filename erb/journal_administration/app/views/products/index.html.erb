<header>
  <h1><%= t(".heading") %></h1>
</header>

<% if @products.empty? %>
  <p><%= t(".empty") %></p>
<% else %>
  <%= render "shared/pagination", page: @page %>

  <table id="products-table">
    <thead>
      <tr>
        <th><%= t(".name") %></th>
        <th><%= t(".brand") %></th>
        <th><%= t(".product_type") %></th>
      </tr>
    </thead>
    <tbody>
      <% @products.each do |product| %>
        <tr>
          <td><%= link_to product.name, product_path(product) %></td>
          <td><%= product.brand.presence || t(".unclassified") %></td>
          <td><%= product.product_type&.name || t(".unclassified") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= render "shared/pagination", page: @page %>
<% end %>

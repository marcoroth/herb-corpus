<%# locals: (purchases:) %>
<% shelf_prices = purchases.map(&:full_amount) %>
<% paid_prices = purchases.map(&:paid_amount) %>
<% highest = shelf_prices.max %>

<figure class="price-chart">
  <svg viewBox="0 0 <%= ProductsHelper::CHART_WIDTH %> <%= ProductsHelper::CHART_HEIGHT %>"
       role="img"
       preserveAspectRatio="none">
    <title><%= t("products.price_chart.title") %></title>
    <polyline fill="none"
              stroke="var(--color-primary)"
              stroke-width="3"
              stroke-dasharray="12 6"
              points="<%= price_chart_points(shelf_prices, highest) %>" />
    <polyline fill="none"
              stroke="var(--color-success)"
              stroke-width="3"
              points="<%= price_chart_points(paid_prices, highest) %>" />
  </svg>
  <figcaption>
    <%= t("products.price_chart.shelf_series") %> ·
    <%= t("products.price_chart.paid_series") %> ·
    <%= t("products.price_chart.highest", price: number_to_currency(highest)) %>
  </figcaption>
</figure>

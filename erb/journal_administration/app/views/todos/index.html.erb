<% content_for(:title) { t(".title") } %>
<%= render "shared/title_bar", title: t(".title") %>

<article class="todo-list">
  <% if @empty %>
    <p><%= t('.empty') %></p>
  <% else %>
    <% labels = { date: t('.date'), kind: t('.kind'), description: t('.description') } %>
    <%= render "shared/pagination", page: @page %>
    <table class="todo" data-stack="narrow" role="table" aria-label="<%= t('.title') %>">
      <thead role="rowgroup">
        <tr role="row">
          <% labels.each_value do |label| %>
            <th scope="col" role="columnheader"><%= label %></th>
          <% end %>
        </tr>
      </thead>
      <tbody role="rowgroup">
        <% @items.each do |item| %>
          <tr role="row">
            <td role="cell" data-label="<%= labels[:date] %>"><time datetime="<%= item.date.to_date.iso8601 %>"><%= l item.date, format: :short %></time></td>
            <td role="cell" data-label="<%= labels[:kind] %>"><%= t(".#{item.kind}") %></td>
            <td role="cell" data-label="<%= labels[:description] %>"><%= link_to todo_description(item), polymorphic_path(item.record) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "shared/pagination", page: @page %>
  <% end %>
</article>

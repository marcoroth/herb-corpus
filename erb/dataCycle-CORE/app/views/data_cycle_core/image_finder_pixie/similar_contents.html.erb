<%= turbo_frame_tag "similar_contents_#{@content.id}" do %>
  <% if @contents.present? %>
    <section class="image-finder-pixie">
      <span class="horizontal-separator-header">
        <div class="header-text">
          <h4><%= t('feature.image_finder_pixie.similar_contents', count: @total, locale: active_ui_locale) %></h4>
        </div>
      </span>

      <ul class="no-bullet no-format grid">
        <% @contents.each do |content| %>
          <% distance = @distances&.dig(content.id) %>
          <% content_for(:contents_grid_bottom, similarity_score_tag(distance), flush: true) if distance %>

          <%= tag.li(class: content_tile_class(content, 'grid'), data: { id: content.id }) do %>
            <%= render 'data_cycle_core/application/watch_lists', content: content if can?(:read, DataCycleCore::WatchList) %>
            <%= render_content_tile(item: content, mode: 'grid') %>
          <% end %>
        <% end %>

        <% if @more_params.present? %>
          <li class="pagination-container text-center">
            <%= link_to t('pagination.next', locale: active_ui_locale), root_path(@more_params), class: 'button' %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
<% end %>

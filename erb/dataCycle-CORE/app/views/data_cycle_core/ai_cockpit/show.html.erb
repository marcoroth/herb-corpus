<% content_for :title, t('data_cycle_core.ai_cockpit.title') %>

<div class="ac-page">
  <a href="#main" class="ac-skip-link"><%= t('data_cycle_core.ai_cockpit.skip_to_content') %></a>

  <%= render 'data_cycle_core/ai_cockpit/brand_symbols' %>

  <%= render 'data_cycle_core/ai_cockpit/header' %>

  <main id="main" class="ac-main" tabindex="-1">
    <div class="ac-intro">
      <%= render 'data_cycle_core/ai_cockpit/greeting' %>

      <% if ai_cockpit_openwebui_url %>
        <%= render 'data_cycle_core/ai_cockpit/composer' %>
        <%= render 'data_cycle_core/ai_cockpit/prompts' %>
      <% end %>

      <%= render 'data_cycle_core/ai_cockpit/glance', usage: @usage, workflows: nil %>
    </div>

    <%# the tiles' frames have target _top so that their links leave the page; data-turbo="false" keeps those plain links: %>
    <%# inside a frame Turbo follows and prefetches links even with Drive off, so a hover over "Leer anlegen" would %>
    <%# sign the user in to n8n and a click render n8n into this page %>
    <div class="ac-tiles" data-turbo="false">
      <% if ai_cockpit_openwebui_url %>
        <%= turbo_frame_tag 'ai-cockpit-chats', src: ai_cockpit_chats_path, loading: :lazy, target: '_top', class: 'ac-tile ac-tile--chats' do %>
          <%= render layout: 'data_cycle_core/ai_cockpit/tile', locals: { id: 'ac-chats', title: t('data_cycle_core.ai_cockpit.chats.title'), loading: t('data_cycle_core.ai_cockpit.chats.loading') } do %>
            <%= render 'data_cycle_core/ai_cockpit/chats_skeleton' %>
          <% end %>
        <% end %>
      <% end %>

      <% if ai_cockpit_workflows? %>
        <%# loads with the page rather than once it scrolls into view, since its answer brings "Auf einen Blick" along; %>
        <%# a reload morphs the new answer in, which keeps the focus on a switch (workflows.js) %>
        <%= turbo_frame_tag 'ai-cockpit-workflows', src: ai_cockpit_workflows_path, target: '_top', refresh: 'morph', class: 'ac-tile ac-tile--workflows' do %>
          <%= render layout: 'data_cycle_core/ai_cockpit/tile', locals: { id: 'ac-workflows', title: t('data_cycle_core.ai_cockpit.workflows.title'), loading: t('data_cycle_core.ai_cockpit.workflows.loading') } do %>
            <%= render 'data_cycle_core/ai_cockpit/workflows_skeleton' %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </main>

  <%= render 'data_cycle_core/ai_cockpit/footer' %>
  <%= render 'data_cycle_core/ai_cockpit/tab_bar' %>
  <%= render 'data_cycle_core/ai_cockpit/tile_error' %>

  <%= render 'data_cycle_core/ai_cockpit/toasts' if ai_cockpit_workflows? %>
</div>

<% content_for :body_scripts do %>
  <%= dc_javascript_tag 'entrypoints/ai_cockpit.js' %>
<% end %>

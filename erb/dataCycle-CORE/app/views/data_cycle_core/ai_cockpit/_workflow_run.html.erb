<%# The button that runs the card's workflow (javascripts/ai_cockpit/workflow_runs.js). It stays one element %>
<%# while the workflow starts and runs, with aria-disabled rather than disabled, so that the focus stays %>
<%# on it while the tile reloads. The toasts' texts come along, as the card may be gone by the time %>
<%# the run ends. %>
<%= tag.button type: 'button',
               id: "ac-run-#{card.id}",
               class: ['ac-run', { 'ac-run--running': running }],
               aria: { describedby: title_id, disabled: (true if running), busy: (true if running) },
               data: { ai_cockpit_run: ai_cockpit_workflow_run_path(card.id), starting: t('data_cycle_core.ai_cockpit.workflows.run_starting'), **ai_cockpit_run_toasts(card) } do %>
  <%= ai_cockpit_icon(:play, size: 10, class: 'ac-run__play') %>
  <%= ai_cockpit_icon(:loader_circle, size: 15, stroke_width: 3, class: 'ac-run__spinner') %>
  <span data-ai-cockpit-run-label><%= t(running ? 'data_cycle_core.ai_cockpit.workflows.run_running' : 'data_cycle_core.ai_cockpit.workflows.run') %></span>
<% end %>

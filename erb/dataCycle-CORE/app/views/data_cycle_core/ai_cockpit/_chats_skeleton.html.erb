<div class="ac-card ac-chats-skeleton" aria-hidden="true">
  <% 5.times do %>
    <div class="ac-chats-skeleton__row">
      <span class="ac-skeleton ac-skeleton--soft ac-chats-skeleton__icon"></span>
      <span class="ac-chats-skeleton__lines">
        <span class="ac-skeleton ac-chats-skeleton__title"></span>
        <span class="ac-skeleton ac-skeleton--soft ac-chats-skeleton__subtitle"></span>
      </span>
      <span class="ac-skeleton ac-skeleton--soft ac-chats-skeleton__time"></span>
    </div>
  <% end %>
</div>

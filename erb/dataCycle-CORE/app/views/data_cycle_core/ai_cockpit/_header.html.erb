<header class="ac-header">
  <div class="ac-header__inner">
    <%= link_to ai_cockpit_path, class: 'ac-header__brand', aria: { label: t('data_cycle_core.ai_cockpit.nav.home') } do %>
      <svg class="ac-header__logo" viewBox="-4 -4 684 137" width="139.8" height="28" aria-hidden="true"><use href="#ac-logo" /></svg>
      <%= render 'data_cycle_core/ai_cockpit/by_line' %>
    <% end %>

    <nav class="ac-nav ac-desktop-only" aria-label="<%= t('data_cycle_core.ai_cockpit.nav.label') %>">
      <%= link_to t('data_cycle_core.ai_cockpit.nav.start'), ai_cockpit_path, class: 'ac-nav__link', aria: { current: 'page' } %>

      <% ai_cockpit_nav_items.each do |item| %>
        <a href="<%= item[:url] %>" class="ac-nav__link">
          <%= item[:label] %><%= ai_cockpit_icon(:arrow_up_right, size: 14) %><span class="ac-sr-only"> (<%= item[:hint] %>)</span>
        </a>
      <% end %>
    </nav>

    <span class="ac-header__user">
      <span class="ac-header__name"><%= current_user.full_name_or_email %></span>
      <span><%= t('title') %></span>
    </span>

    <div class="ac-menu ac-header__account" data-ai-cockpit-menu>
      <button type="button"
              class="ac-avatar"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="ac-account-menu"
              aria-label="<%= t('data_cycle_core.ai_cockpit.account.button', initials: current_user.initials) %>">
        <%= current_user.initials %>
      </button>

      <div id="ac-account-menu" class="ac-menu__list ac-menu__list--end" role="menu" aria-label="<%= t('data_cycle_core.ai_cockpit.account.label') %>" hidden>
        <% if ai_cockpit_openwebui_url %>
          <a href="<%= ai_cockpit_openwebui_url %>" class="ac-menu__item" role="menuitem" tabindex="-1">
            <%= t('data_cycle_core.ai_cockpit.account.profile') %>
          </a>
        <% end %>

        <%= button_to t('data_cycle_core.ai_cockpit.account.sign_out'), destroy_user_session_path, method: :delete, class: 'ac-menu__item', form_class: 'ac-menu__form', role: 'menuitem', tabindex: -1 %>
      </div>
    </div>
  </div>
</header>

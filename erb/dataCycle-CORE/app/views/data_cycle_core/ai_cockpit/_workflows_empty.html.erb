<% templates = ai_cockpit_link(:templates) %>
<% marketplace = ai_cockpit_link(:marketplace) %>

<div class="ac-empty ac-empty--dashed ac-workflows-empty">
  <span class="ac-empty__icon ac-empty__icon--outlined"><%= ai_cockpit_icon(:workflow, size: 26) %></span>
  <h3 class="ac-empty__title"><%= t('data_cycle_core.ai_cockpit.workflows.empty_title') %></h3>
  <p class="ac-empty__text ac-empty__text--wide"><%= t('data_cycle_core.ai_cockpit.workflows.empty_text') %></p>

  <div class="ac-empty__actions">
    <% if templates %>
      <a href="<%= templates %>" class="ac-button ac-button--primary"><%= t('data_cycle_core.ai_cockpit.workflows.new_from_template') %></a>
    <% end %>
    <a href="<%= ai_cockpit_new_workflow_path %>" class="ac-button"><%= t('data_cycle_core.ai_cockpit.workflows.new_blank') %></a>
  </div>

  <% if marketplace %>
    <a href="<%= marketplace %>" class="ac-marketplace-link ac-empty__marketplace"><%= t('data_cycle_core.ai_cockpit.workflows.marketplace') %></a>
  <% end %>
</div>

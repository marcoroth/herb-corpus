<%# workflows: AiCockpitWorkflows::Result with at least one card. A group shows with its heading even %>
<%# when empty if its workflows are the user's to switch, since "Neuer Workflow" adds to it. %>
<% if workflows.stale %>
  <div class="ac-stale" role="alert">
    <%= ai_cockpit_icon(:triangle_alert, size: 20, stroke_width: 2.2, class: 'ac-stale__icon') %>
    <span class="ac-stale__text">
      <b><%= t('data_cycle_core.ai_cockpit.workflows.stale_title') %></b>
      <%= t('data_cycle_core.ai_cockpit.workflows.stale_text', time: ai_cockpit_clock(workflows.fetched_at)) %>
    </span>
    <button type="button" class="ac-stale__retry" data-ai-cockpit-tile-retry><%= t('data_cycle_core.ai_cockpit.tile_error.retry') %></button>
  </div>
<% end %>

<% workflows.groups.each do |group| %>
  <% next if group.cards.empty? && !group.own %>

  <section class="ac-workflow-group" aria-labelledby="ac-workflows-<%= group.kind %>">
    <h3 id="ac-workflows-<%= group.kind %>" class="ac-workflow-group__title"><%= t("data_cycle_core.ai_cockpit.workflows.groups.#{group.kind}") %></h3>

    <div class="ac-workflow-grid">
      <% group.shown_cards.each do |card| %>
        <%= render 'data_cycle_core/ai_cockpit/workflow_card', card:, own: group.own, stale: workflows.stale %>
      <% end %>

      <% if group.own %>
        <%= render 'data_cycle_core/ai_cockpit/workflow_new' %>
      <% end %>
    </div>
  </section>
<% end %>

<a href="<%= new_n8n_session_path %>" class="ac-link ac-workflows-all ac-mobile-only"><%= t('data_cycle_core.ai_cockpit.workflows.all_mobile') %></a>

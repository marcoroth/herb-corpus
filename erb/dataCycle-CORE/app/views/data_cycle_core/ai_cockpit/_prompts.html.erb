<% suggestions = ai_cockpit_config_list(:suggestions) %>

<%# a prompt fills the composer without sending it (javascripts/ai_cockpit/composer.js) %>
<% if suggestions.any? %>
  <div class="ac-suggestions">
    <% suggestions.each do |suggestion| %>
      <button type="button" class="ac-suggestion" data-ai-cockpit-prompt="<%= ai_cockpit_config_text(suggestion[:prompt]) %>"><%= ai_cockpit_config_text(suggestion[:label]) %></button>
    <% end %>
  </div>
<% end %>

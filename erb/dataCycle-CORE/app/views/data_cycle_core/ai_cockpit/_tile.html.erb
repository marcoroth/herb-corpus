<%# A tile of the start page, the same in its frame's placeholder and in the frame's answer; %>
<%# loading: is the placeholder's hint beside the heading, link: (label and url) the answer's link %>
<%# beside it from 640 px. %>
<%= tag.section class: 'ac-tile__section', aria: { labelledby: "#{id}-title" } do %>
  <div class="ac-tile__header">
    <h2 id="<%= id %>-title" class="ac-tile__title" tabindex="-1"><%= title %></h2>
    <% if local_assigns[:loading] %>
      <span class="ac-tile__loading" data-ai-cockpit-tile-loading><%= loading %></span>
    <% elsif local_assigns[:link] %>
      <a href="<%= link[:url] %>" class="ac-link ac-desktop-only"><%= link[:label] %></a>
    <% end %>
  </div>

  <div class="ac-tile__body" data-ai-cockpit-tile-body>
    <%= yield %>
  </div>
<% end %>

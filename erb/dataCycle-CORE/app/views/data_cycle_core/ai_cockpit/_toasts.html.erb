<%# where javascripts/ai_cockpit/toasts.js shows its toasts, and the texts the workflows give them %>
<div class="ac-toasts" data-ai-cockpit-toasts>
  <div class="ac-toasts__list" role="status" aria-live="polite" data-ai-cockpit-toasts="status"></div>
  <div class="ac-toasts__list" role="alert" data-ai-cockpit-toasts="alert"></div>
</div>

<template id="ac-toast" data-undo="<%= t('data_cycle_core.ai_cockpit.workflows.undo') %>" data-switch-failed="<%= t('data_cycle_core.ai_cockpit.workflows.switch_failed') %>" data-live="<%= t('data_cycle_core.ai_cockpit.workflows.view_in_n8n') %>" data-log="<%= t('data_cycle_core.ai_cockpit.workflows.log') %>">
  <div class="ac-toast">
    <%= ai_cockpit_icon(:pause, size: 18, class: 'ac-toast__icon', data: { toast_icon: 'pause' }) %>
    <%= ai_cockpit_icon(:play, size: 18, class: 'ac-toast__icon', data: { toast_icon: 'play' }) %>
    <%= ai_cockpit_icon(:check, size: 18, class: 'ac-toast__icon', data: { toast_icon: 'check' }) %>
    <%= ai_cockpit_icon(:triangle_alert, size: 18, class: 'ac-toast__icon ac-toast__icon--error', data: { toast_icon: 'error' }) %>
    <div class="ac-toast__body">
      <div class="ac-toast__title" data-toast-title></div>
      <button type="button" class="ac-toast__action" data-toast-action hidden></button>
      <a class="ac-toast__action" data-toast-link hidden></a>
    </div>
    <button type="button" class="ac-toast__close" aria-label="<%= t('data_cycle_core.ai_cockpit.toast.close') %>" data-toast-close>
      <%= ai_cockpit_icon(:x, size: 14, stroke_width: 2.4) %>
    </button>
  </div>
</template>

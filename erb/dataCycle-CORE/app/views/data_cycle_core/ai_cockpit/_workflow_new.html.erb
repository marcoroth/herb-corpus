<%# the tile after the workflows the user switches, which adds one in n8n: blank, or from a template %>
<%# where the start page links templates %>
<% templates = ai_cockpit_link(:templates) %>

<% if templates %>
  <div class="ac-workflow-new">
    <%= ai_cockpit_icon(:plus, size: 18, stroke_width: 2.4) %>
    <span><%= t('data_cycle_core.ai_cockpit.workflows.new') %>:</span>
    <a href="<%= ai_cockpit_new_workflow_path %>" class="ac-link"><%= t('data_cycle_core.ai_cockpit.workflows.new_blank') %></a>
    <a href="<%= templates %>" class="ac-link"><%= t('data_cycle_core.ai_cockpit.workflows.new_from_template') %></a>
  </div>
<% else %>
  <a href="<%= ai_cockpit_new_workflow_path %>" class="ac-workflow-new ac-workflow-new--link">
    <%= ai_cockpit_icon(:plus, size: 18, stroke_width: 2.4) %>
    <%= t('data_cycle_core.ai_cockpit.workflows.new') %>
  </a>
<% end %>

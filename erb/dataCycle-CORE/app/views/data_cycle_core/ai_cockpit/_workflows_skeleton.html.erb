<div class="ac-workflows-skeleton" aria-hidden="true">
  <% 4.times do %>
    <div class="ac-card ac-workflows-skeleton__card">
      <span class="ac-workflows-skeleton__top">
        <span class="ac-skeleton ac-skeleton--soft ac-workflows-skeleton__label"></span>
        <span class="ac-skeleton ac-skeleton--soft ac-workflows-skeleton__badge"></span>
      </span>
      <span class="ac-skeleton ac-workflows-skeleton__title"></span>
      <span class="ac-skeleton ac-skeleton--soft ac-workflows-skeleton__line"></span>
      <span class="ac-skeleton ac-skeleton--soft ac-workflows-skeleton__line"></span>
      <span class="ac-workflows-skeleton__buttons">
        <span class="ac-skeleton ac-skeleton--strong ac-workflows-skeleton__run"></span>
        <span class="ac-skeleton ac-skeleton--soft ac-workflows-skeleton__edit"></span>
      </span>
    </div>
  <% end %>
</div>

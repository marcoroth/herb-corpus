<% example = ai_cockpit_example_prompt %>

<div class="ac-empty">
  <span class="ac-empty__icon ac-empty__icon--tint"><%= ai_cockpit_icon(:message_square_text, size: 22, stroke_width: 2.1) %></span>
  <h3 class="ac-empty__title"><%= t('data_cycle_core.ai_cockpit.chats.empty_title') %></h3>
  <p class="ac-empty__text"><%= t('data_cycle_core.ai_cockpit.chats.empty_text') %></p>

  <% if example %>
    <button type="button" class="ac-button ac-empty__action" data-ai-cockpit-prompt="<%= example %>" aria-describedby="ac-chats-example">
      <%= ai_cockpit_icon(:sparkle, size: 16, stroke_width: 2.2, class: 'ac-button__accent') %>
      <%= t('data_cycle_core.ai_cockpit.chats.try_example') %>
    </button>
    <p id="ac-chats-example" class="ac-empty__hint"><%= t('data_cycle_core.ai_cockpit.chats.try_example_hint', prompt: example) %></p>
  <% end %>
</div>

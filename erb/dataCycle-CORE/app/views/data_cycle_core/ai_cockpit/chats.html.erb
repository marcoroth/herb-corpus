<%# @chats is nil where Open WebUI did not answer (AiCockpitController#chats) %>
<%= turbo_frame_tag 'ai-cockpit-chats' do %>
  <% if ai_cockpit_openwebui_url %>
    <% if @chats.nil? %>
      <%= render layout: 'data_cycle_core/ai_cockpit/tile', locals: { id: 'ac-chats', title: t('data_cycle_core.ai_cockpit.chats.title') } do %>
        <%= render 'data_cycle_core/ai_cockpit/tile_unavailable' %>
      <% end %>
    <% elsif @chats.any? %>
      <%= render layout: 'data_cycle_core/ai_cockpit/tile', locals: { id: 'ac-chats', title: t('data_cycle_core.ai_cockpit.chats.title'), link: { label: t('data_cycle_core.ai_cockpit.chats.all'), url: ai_cockpit_openwebui_url } } do %>
        <%= render 'data_cycle_core/ai_cockpit/chats_list', chats: @chats %>
      <% end %>
    <% else %>
      <%= render layout: 'data_cycle_core/ai_cockpit/tile', locals: { id: 'ac-chats', title: t('data_cycle_core.ai_cockpit.chats.title') } do %>
        <%= render 'data_cycle_core/ai_cockpit/chats_empty' %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%# a tile whose service did not answer, with a retry that tile_frames.js reloads the frame on %>
<div class="ac-empty" role="alert">
  <span class="ac-empty__icon ac-empty__icon--warning"><%= ai_cockpit_icon(:cloud_off, size: 26, stroke_width: 1.8) %></span>
  <h3 class="ac-empty__title"><%= t('data_cycle_core.ai_cockpit.tile_error.title') %></h3>
  <button type="button" class="ac-button ac-empty__action" data-ai-cockpit-tile-retry>
    <%= ai_cockpit_icon(:refresh_cw, size: 16, stroke_width: 2.2) %>
    <%= t('data_cycle_core.ai_cockpit.tile_error.retry') %>
  </button>
</div>

<% models = ai_cockpit_config_list(:models) %>
<% sources = ai_cockpit_config_list(:data_sources) %>

<%# javascripts/ai_cockpit/composer.js hands the question over to Open WebUI as ?q=…&model=…&tools=… %>
<form class="ac-composer"
      action="<%= ai_cockpit_openwebui_url %>"
      method="get"
      data-ai-cockpit-composer
      data-max-url-length="<%= DataCycleCore::AiCockpitController::MAX_CHAT_URL_LENGTH %>">
  <label for="ac-prompt" class="ac-sr-only"><%= t('data_cycle_core.ai_cockpit.composer.label') %></label>
  <div class="ac-composer__field">
    <%# the placeholder is an overlay, so that CSS can switch between its two texts; placeholder=" " lets CSS hide it once there is text %>
    <textarea id="ac-prompt" name="q" rows="3" class="ac-composer__input" placeholder=" "></textarea>
    <span class="ac-composer__placeholder" aria-hidden="true">
      <span class="ac-desktop-only"><%= t('data_cycle_core.ai_cockpit.composer.placeholder') %></span>
      <span class="ac-mobile-only"><%= t('data_cycle_core.ai_cockpit.composer.placeholder_mobile') %></span>
    </span>
  </div>

  <p id="ac-prompt-too-long" class="ac-composer__too-long" role="alert" hidden><%= t('data_cycle_core.ai_cockpit.composer.too_long') %></p>

  <div class="ac-composer__actions">
    <% if models.any? %>
      <%# the empty first option leaves the model to Open WebUI's own default, which an instance sets there (DEFAULT_MODELS) %>
      <label class="ac-model ac-desktop-only">
        <%= t('data_cycle_core.ai_cockpit.composer.model') %>
        <select name="model" class="ac-model__select" data-ai-cockpit-model>
          <option value=""><%= t('data_cycle_core.ai_cockpit.composer.model_default') %></option>
          <% models.each do |model| %>
            <option value="<%= model[:id] %>"><%= ai_cockpit_config_text(model[:label]) %></option>
          <% end %>
        </select>
      </label>
      <label class="ac-model ac-model--compact ac-mobile-only">
        <span class="ac-sr-only"><%= t('data_cycle_core.ai_cockpit.composer.model') %></span>
        <select class="ac-model__select" data-ai-cockpit-model>
          <option value=""><%= t('data_cycle_core.ai_cockpit.composer.model_default') %></option>
          <% models.each do |model| %>
            <option value="<%= model[:id] %>"><%= ai_cockpit_config_text(model[:short_label]) %></option>
          <% end %>
        </select>
      </label>
    <% end %>

    <button type="submit" class="ac-composer__start" disabled>
      <span class="ac-desktop-only"><%= t('data_cycle_core.ai_cockpit.composer.start') %></span>
      <span class="ac-mobile-only"><%= t('data_cycle_core.ai_cockpit.composer.start_mobile') %></span>
      <%= ai_cockpit_icon(:arrow_right, size: 18, stroke_width: 2.4) %>
    </button>
  </div>

  <% if sources.any? %>
    <div class="ac-composer__sources">
      <span class="ac-composer__sources-label ac-desktop-only"><%= t('data_cycle_core.ai_cockpit.composer.sources') %></span>
      <% sources.each do |source| %>
        <button type="button" class="ac-chip" aria-pressed="<%= source[:default_on] == true %>" data-ai-cockpit-tool="<%= source[:tool_id] %>">
          <%= ai_cockpit_icon(:check, size: 14, stroke_width: 3, class: 'ac-chip__check') %>
          <%= tag.span(class: ['ac-chip__dot', "ac-chip__dot--#{source[:dot_color]}"]) %>
          <%= ai_cockpit_config_text(source[:label]) %>
        </button>
      <% end %>
    </div>
  <% end %>
</form>

<p class="ac-composer-hint">
  <span class="ac-desktop-only"><%= t('data_cycle_core.ai_cockpit.composer.hint') %></span>
  <span class="ac-mobile-only"><%= t('data_cycle_core.ai_cockpit.composer.hint_mobile') %></span>
</p>

<%# the latest chats of DataCycleCore::OpenWebuiChats, three of them on a phone %>
<div class="ac-card ac-chats">
  <ul class="ac-chats__list">
    <% chats.each do |chat| %>
      <li class="ac-chats__item">
        <a href="<%= ai_cockpit_chat_url(chat) %>" class="ac-chat">
          <span class="ac-chat__icon"><%= ai_cockpit_icon(:message_square, size: 15, stroke_width: 2.4) %></span>
          <span class="ac-chat__text">
            <span class="ac-chat__title"><%= chat.title %></span>
            <% if chat.snippet %>
              <span class="ac-chat__snippet ac-desktop-only"><%= chat.snippet %></span>
            <% end %>
            <%= time_tag chat.updated_at, ai_cockpit_time_ago(chat.updated_at), class: 'ac-chat__time ac-mobile-only' %>
          </span>
          <%= time_tag chat.updated_at, ai_cockpit_time_ago(chat.updated_at), class: 'ac-chat__time ac-desktop-only' %>
          <%= ai_cockpit_icon(:chevron_right, size: 16, stroke_width: 2.2, class: 'ac-chat__chevron ac-mobile-only') %>
        </a>
      </li>
    <% end %>
  </ul>

  <a href="<%= ai_cockpit_openwebui_url %>" class="ac-chats__all ac-mobile-only"><%= t('data_cycle_core.ai_cockpit.chats.all_mobile') %></a>
</div>

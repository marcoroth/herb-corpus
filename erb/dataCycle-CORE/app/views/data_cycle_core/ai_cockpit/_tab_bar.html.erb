<nav class="ac-tab-bar ac-mobile-only" aria-label="<%= t('data_cycle_core.ai_cockpit.nav.label') %>">
  <a href="<%= ai_cockpit_path %>" class="ac-tab ac-tab--current" aria-current="page">
    <%= ai_cockpit_icon(:house, size: 22) %>
    <%= t('data_cycle_core.ai_cockpit.nav.start') %>
  </a>

  <% ai_cockpit_nav_items.each do |item| %>
    <a href="<%= item[:url] %>" class="ac-tab">
      <%= ai_cockpit_icon(item[:icon], size: 22) %>
      <%= item[:label] %><span class="ac-sr-only"> (<%= item[:hint] %>)</span>
    </a>
  <% end %>
</nav>

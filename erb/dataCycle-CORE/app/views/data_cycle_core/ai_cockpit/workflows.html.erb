<%# @workflows is nil where n8n did not answer and nothing was read before (AiCockpitController#workflows) %>
<%= turbo_frame_tag 'ai-cockpit-workflows' do %>
  <% if ai_cockpit_workflows? %>
    <% if @workflows.nil? %>
      <%= render layout: 'data_cycle_core/ai_cockpit/tile', locals: { id: 'ac-workflows', title: t('data_cycle_core.ai_cockpit.workflows.title') } do %>
        <%= render 'data_cycle_core/ai_cockpit/tile_unavailable' %>
      <% end %>
    <% elsif @workflows.empty? %>
      <%= render layout: 'data_cycle_core/ai_cockpit/tile', locals: { id: 'ac-workflows', title: t('data_cycle_core.ai_cockpit.workflows.title') } do %>
        <%= render 'data_cycle_core/ai_cockpit/workflows_empty' %>
      <% end %>
    <% else %>
      <%= render layout: 'data_cycle_core/ai_cockpit/tile', locals: { id: 'ac-workflows', title: t('data_cycle_core.ai_cockpit.workflows.title'), link: { label: t('data_cycle_core.ai_cockpit.workflows.all'), url: new_n8n_session_path } } do %>
        <%= render 'data_cycle_core/ai_cockpit/workflows_groups', workflows: @workflows %>
      <% end %>
    <% end %>

    <%# Turbo runs a stream once the frame puts it into the page, so "Auf einen Blick" follows the tile %>
    <%= turbo_stream.replace('ac-glance', partial: 'data_cycle_core/ai_cockpit/glance', locals: { usage: @usage, workflows: @workflows }) if @workflows %>
  <% end %>
<% end %>

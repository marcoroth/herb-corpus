<div class="ac-footer-wrap">
  <footer class="ac-footer">
    <span class="ac-footer__brand" role="img" aria-label="<%= t('data_cycle_core.ai_cockpit.footer.by') %>">
      <svg class="ac-footer__logo" viewBox="0 12 680 113" width="108.32" height="18" aria-hidden="true"><use href="#ac-logo" /></svg>
      <%= render 'data_cycle_core/ai_cockpit/by_line' %>
    </span>

    <% links = %i[imprint privacy help marketplace portal].index_with { |key| ai_cockpit_link(key) }.compact %>
    <% if links.any? %>
      <span class="ac-footer__links">
        <% links.each do |key, url| %>
          <a href="<%= url %>" class="ac-footer__link"><%= t("data_cycle_core.ai_cockpit.footer.#{key}") %></a>
        <% end %>
      </span>
    <% end %>

    <%# javascripts/ai_cockpit/theme_switch.js presses the stored choice, which the layout applies before the page paints %>
    <span class="ac-theme-switch" role="group" aria-label="<%= t('data_cycle_core.ai_cockpit.theme.label') %>" data-ai-cockpit-theme-switch="<%= DataCycleCore::AiCockpitHelper::THEME_STORAGE_KEY %>">
      <% { system: :laptop, light: :sun, dark: :moon }.each do |theme, icon| %>
        <% label = t("data_cycle_core.ai_cockpit.theme.#{theme}") %>
        <button type="button" class="ac-theme-switch__option" data-theme-choice="<%= theme %>" aria-pressed="<%= theme == :system %>" aria-label="<%= label %>" title="<%= label %>">
          <%= ai_cockpit_icon(icon, size: 14) %>
        </button>
      <% end %>
    </span>
  </footer>
</div>

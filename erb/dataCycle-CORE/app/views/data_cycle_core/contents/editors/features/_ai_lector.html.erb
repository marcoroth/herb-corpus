<% dropdown_id = "#{sanitize_to_id(key)}-ai-lector-dropdown" %>

<%
  tips = DataCycleCore::Feature['AiLector'].config_by_type(content, key, 'tips', I18n.locale)
  improvements = DataCycleCore::Feature['AiLector'].config_by_type(content, key, 'improvements', I18n.locale)
  proofing_improvements = improvements.select { |_k, v| v[:category].to_s == 'proofing' }
  targeting_improvements = improvements.select { |_k, v| v[:category].to_s == 'targeting' }
%>

<div class="ai-lector-dropdown-container">
  <button
    type="button"
    class="ai-lector-dropdown-button"
    data-toggle="<%= dropdown_id %>"
    aria-haspopup="true"
    data-dc-tooltip="<%= t('feature.ai_lector.title', default: 'data.pixies', locale: active_ui_locale) %>"
  >
    <i class="fa fa-magic" aria-hidden="true"></i>
  </button>

  <div
    id="<%= dropdown_id %>"
    class="dropdown-pane ai-lector-dropdown"
    data-hover="false"
    data-dropdown="true"
    data-close-on-click="true"
    data-position="bottom"
  >
    <ul class="no-bullet">
      <% local_assigns.fetch(:text_pixies, []).each do |pixie| %>
        <%= render 'data_cycle_core/contents/editors/features/ai_lector_section_header',
              css_class: 'text-pixie', icon: 'fa-magic',
              title: t("feature.#{pixie}.section_title", locale: active_ui_locale) %>

        <li class="ai-lector-row text-pixie">
          <%= render 'data_cycle_core/contents/editors/features/text_pixie_button',
                content:, key:, definition: local_assigns[:definition], pixie:, row: true %>
        </li>
      <% end %>

      <% if tips.present? %>
        <%= render 'data_cycle_core/contents/editors/features/ai_lector_section_header',
              css_class: 'tips', icon: 'fa-lightbulb-o',
              title: t('feature.ai_lector.tips.title', default: 'Tips', locale: active_ui_locale),
              subtitle: t('feature.ai_lector.tips.subtitle', default: nil, locale: active_ui_locale) %>

        <% tips.each do |k, v| %>
          <%= render 'data_cycle_core/contents/editors/features/ai_lector_tip_row',
                content:, key:, k:, category: 'tips',
                icon: (v.is_a?(Hash) ? v[:icon].presence : nil) || 'fa-lightbulb-o' %>
        <% end %>
      <% end %>

      <% if proofing_improvements.present? %>
        <%= render 'data_cycle_core/contents/editors/features/ai_lector_section_header',
              css_class: 'proofing', icon: 'fa-magic',
              title: t('feature.ai_lector.proofing.title', default: 'Proofing Pixie', locale: active_ui_locale),
              subtitle: t('feature.ai_lector.proofing.subtitle', default: nil, locale: active_ui_locale) %>

        <% proofing_improvements.each do |k, v| %>
          <%= render 'data_cycle_core/contents/editors/features/ai_lector_improvement_row',
                content:, key:, k:, v:, category: 'proofing',
                icon: v[:icon].presence || 'fa-magic' %>
        <% end %>
      <% end %>

      <% if targeting_improvements.present? %>
        <%= render 'data_cycle_core/contents/editors/features/ai_lector_section_header',
              css_class: 'targeting', icon: 'fa-bullseye',
              title: t('feature.ai_lector.targeting.title', default: 'Targeting Pixie', locale: active_ui_locale),
              subtitle: t('feature.ai_lector.targeting.subtitle', default: nil, locale: active_ui_locale) %>

        <% targeting_improvements.each do |k, v| %>
          <%= render 'data_cycle_core/contents/editors/features/ai_lector_improvement_row',
                content:, key:, k:, v:, category: 'targeting',
                icon: v[:icon].presence || 'fa-crosshairs' %>
        <% end %>
      <% end %>
    </ul>
  </div>
</div>

<%#
  The stockPixie's wand on a linked image attribute (#47882) and the dialog it opens: the image is
  shown there, drawn again with the editor's note, and only an accepted one becomes an image content,
  which the object browser +html_id+ then links like an uploaded one (stock_pixie.js).

  The dialog is rendered inside the edit form, so it holds no form of its own -- the parser drops a
  nested <form> tag -- and its note has no name, which keeps it out of the content's save.
%>
<% modal_id = "stock_pixie_#{html_id}" %>
<%= render 'data_cycle_core/contents/editors/features/pixie_generate_button',
      content: content,
      pixie: 'stock_pixie',
      css_class: 'stock-pixie-button',
      tooltip: t('feature.stock_pixie.generate', locale: active_ui_locale),
      data: {
        attribute_key: key.to_s.attribute_name_from_key,
        locale: I18n.locale,
        object_browser: html_id,
        modal: modal_id
      } %>

<div id="<%= modal_id %>" class="reveal stock-pixie-overlay" data-reveal data-multiple-opened="true">
  <button class="close-button" data-close aria-label="Close modal" type="button">
    <span aria-hidden="true">&times;</span>
  </button>

  <div class="reveal-header">
    <i class="fa fa-magic" aria-hidden="true"></i>
    <%= t('feature.stock_pixie.dialog_title', locale: active_ui_locale) %>
  </div>

  <div class="reveal-body">
    <div class="stock-pixie-preview"></div>

    <label>
      <%= t('feature.stock_pixie.note', locale: active_ui_locale) %>
      <%= tag.textarea class: 'stock-pixie-note',
                       rows: 2,
                       maxlength: DataCycleCore::Feature::StockPixie::MAX_NOTE_LENGTH,
                       placeholder: t('feature.stock_pixie.note_placeholder', locale: active_ui_locale) %>
    </label>
  </div>

  <div class="reveal-footer buttons">
    <%= button_tag safe_join([tag.i(class: 'fa fa-times'), t('actions.cancel', locale: active_ui_locale)]),
                   class: 'button secondary hollow',
                   data: { close: '' },
                   type: :button %>
    <%= button_tag safe_join([t('feature.stock_pixie.new_version', locale: active_ui_locale), tag.i(class: 'fa fa-refresh')]),
                   class: 'button primary hollow stock-pixie-new-version',
                   type: :button %>
    <%= button_tag safe_join([t('feature.stock_pixie.accept', locale: active_ui_locale), tag.i(class: 'fa fa-check')]),
                   class: 'button success stock-pixie-accept',
                   type: :button %>
  </div>
</div>

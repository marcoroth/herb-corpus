<%#
  The header of one section of the aiLector's dropdown (_ai_lector.scss): its icon, its title and a
  subtitle where there is one.
%>
<li class="ai-lector-section-header <%= css_class %>">
  <i class="fa <%= icon %> ai-lector-section-icon" aria-hidden="true"></i>
  <span>
    <span class="ai-lector-section-title"><%= title %></span>
    <% if local_assigns[:subtitle].present? %>
      <span class="ai-lector-section-subtitle"><%= subtitle %></span>
    <% end %>
  </span>
</li>

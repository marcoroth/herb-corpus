<%#
  Generate button of a pixie that writes one text attribute: the imageDescriptionPixie (#47881) and
  the descriptionPixie (#47878), named by +pixie+. The locale is the editor's own: the form renders
  the other translations of an attribute without reloading, so a wand in one of those asks for its
  own language rather than for the page's. As a +row+ of the aiLector's dropdown it is labelled
  like the dropdown's other rows.
%>
<% text = t("feature.#{pixie}.generate_for", data: translated_attribute_label(local_assigns[:key], local_assigns[:definition], content), locale: active_ui_locale) %>
<%= render 'data_cycle_core/contents/editors/features/pixie_generate_button',
      content: content,
      pixie: pixie,
      css_class: ['text-pixie-button', "#{pixie.dasherize}-button", ('ai-lector-button' if local_assigns[:row])].compact.join(' '),
      icon_class: ('ai-lector-button-icon' if local_assigns[:row]),
      label: (tag.span(text, class: 'ai-lector-button-label') if local_assigns[:row]),
      tooltip: text,
      data: {
        attribute_key: local_assigns[:key].to_s.attribute_name_from_key,
        locale: I18n.locale
      } %>

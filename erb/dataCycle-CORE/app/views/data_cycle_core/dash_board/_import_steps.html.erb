<% if local_assigns[:times].present? %>
  <table class="import-steps">
    <%# one row per partial so ExternalSystemExtensions::Import#broadcast_step_update can replace a
        single step's <tr> by id instead of re-rendering the whole table %>
    <%= render partial: 'data_cycle_core/dash_board/import_step',
               collection: Array.wrap(times),
               as: :value,
               locals: { external_source_id: local_assigns[:external_source_id] } %>
  </table>
<% else %>
  <div class="no-content">no timestamps for steps found</div>
<% end %>

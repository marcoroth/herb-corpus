<%# Unlike doorkeeper's own view, the script carries the CSP nonce, without which script-src blocks it and
    the code never reaches the client. The button covers a browser without JavaScript. %>
<%= render layout: 'sign_in_card', locals: { title: t('doorkeeper.authorizations.form_post.title', locale: active_ui_locale) } do %>
  <%= form_tag @pre_auth.redirect_uri, method: :post, name: :redirect_form, authenticity_token: false do %>
    <% auth.body.compact.each do |key, value| %>
      <%= hidden_field_tag key, value %>
    <% end %>

    <%= button_tag t('actions.next', locale: active_ui_locale).capitalize, name: nil, class: 'button' %>
  <% end %>

  <%= javascript_tag nonce: true do %>
    document.forms['redirect_form'].submit();
  <% end %>
<% end %>

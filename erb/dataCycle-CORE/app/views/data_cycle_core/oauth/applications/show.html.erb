<% breadcrumb :oauth_application, @application %>

<% content_for(:title, flush: true) { t('doorkeeper.applications.show.title', name: @application.name, locale: active_ui_locale) } %>

<div class="oauth-page">
  <h1><%= t('doorkeeper.applications.show.title', name: @application.name, locale: active_ui_locale) %></h1>

  <dl class="oauth-application-details">
    <dt><%= t('doorkeeper.applications.show.application_id', locale: active_ui_locale) %></dt>
    <dd>
      <%= tag.span @application.uid,
        class: 'copy-to-clipboard with-shadow',
        data: {
          value: @application.uid,
          dc_tooltip: t('actions.copy_to_clipboard', locale: active_ui_locale)
        } %>
    </dd>

    <dt><%= t('doorkeeper.applications.show.secret', locale: active_ui_locale) %></dt>
    <dd>
      <% secret = flash[:application_secret].presence || @application.plaintext_secret %>
      <% if secret.present? %>
        <span class="password-field access-token-field">
          <%= password_field_tag :secret, secret, readonly: true, autocomplete: 'off', size: secret.length %>

          <%= tag.span tag.i(class: 'fa fa-clipboard', aria_hidden: true),
            class: 'copy-to-clipboard',
            data: {
              value: secret,
              dc_tooltip: t('actions.copy_to_clipboard', locale: active_ui_locale)
            } %>
        </span>
      <% else %>
        <em><%= t('doorkeeper.applications.show.secret_hashed', locale: active_ui_locale) %></em>
      <% end %>
    </dd>

    <dt><%= t('doorkeeper.applications.show.scopes', locale: active_ui_locale) %></dt>
    <dd>
      <% if @application.scopes.present? %>
        <span class="tags"><%= safe_join(@application.scopes.map { |scope| tag.span(scope, class: 'tag') }, ' ') %></span>
      <% else %>
        <em><%= t('doorkeeper.applications.show.not_defined', locale: active_ui_locale) %></em>
      <% end %>
    </dd>

    <dt><%= t('doorkeeper.applications.show.confidential', locale: active_ui_locale) %></dt>
    <dd><%= t("common.#{@application.confidential?}", locale: active_ui_locale) %></dd>

    <dt><%= t('doorkeeper.applications.show.trusted', locale: active_ui_locale) %></dt>
    <dd><%= t("common.#{@application.trusted?}", locale: active_ui_locale) %></dd>

    <dt><%= t('doorkeeper.applications.show.callback_urls', locale: active_ui_locale) %></dt>
    <dd>
      <% if @application.redirect_uri.present? %>
        <ul class="no-bullet">
          <% @application.redirect_uri.split.each do |uri| %>
            <li>
              <%= uri %>
              <%= link_to t('doorkeeper.applications.buttons.authorize', locale: active_ui_locale),
                oauth_authorization_path(client_id: @application.uid, redirect_uri: uri, response_type: 'code', scope: @application.scopes),
                class: 'button small hollow',
                target: '_blank' %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <em><%= t('doorkeeper.applications.show.not_defined', locale: active_ui_locale) %></em>
      <% end %>
    </dd>
  </dl>

  <div class="oauth-buttons">
    <%= link_to safe_join([tag.i(class: 'fa fa-pencil', aria_hidden: true), t('doorkeeper.applications.buttons.edit', locale: active_ui_locale)]),
      edit_oauth_application_path(@application),
      class: 'button' %>

    <%= link_to safe_join([tag.i(class: 'fa fa-trash', aria_hidden: true), t('doorkeeper.applications.buttons.destroy', locale: active_ui_locale)]),
      oauth_application_path(@application),
      method: :delete,
      class: 'button alert',
      data: {
        confirm: t('doorkeeper.applications.confirmations.destroy', locale: active_ui_locale),
        confirmation_text: t('doorkeeper.applications.buttons.destroy', locale: active_ui_locale) + tag.i(class: 'fa fa-trash')
      } %>
  </div>
</div>

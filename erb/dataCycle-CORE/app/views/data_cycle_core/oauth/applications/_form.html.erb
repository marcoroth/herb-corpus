<%# Doorkeeper's fields plus trusted, which ApplicationsController#application_params permits on top. %>
<%= form_for application, url: doorkeeper_submit_path(application), as: :doorkeeper_application do |f| %>
  <% if application.errors.any? %>
    <div class="callout alert">
      <p><%= t('doorkeeper.applications.form.error', locale: active_ui_locale) %></p>

      <ul>
        <% application.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-element">
    <%= f.label :name do %>
      <%= Doorkeeper::Application.human_attribute_name(:name, locale: active_ui_locale) %>
      <%= tag.i('*', class: 'required-field-marker', data: { dc_tooltip: t('common.required_field', locale: active_ui_locale) }) %>
    <% end %>
    <%= f.text_field :name, required: true %>
  </div>

  <div class="form-element">
    <%= f.label :redirect_uri, Doorkeeper::Application.human_attribute_name(:redirect_uri, locale: active_ui_locale) %>
    <%= f.text_area :redirect_uri, rows: 3 %>
    <p class="help-text"><%= t('doorkeeper.applications.help.redirect_uri', locale: active_ui_locale) %></p>

    <% if Doorkeeper.configuration.allow_blank_redirect_uri?(application) %>
      <p class="help-text"><%= t('doorkeeper.applications.help.blank_redirect_uri', locale: active_ui_locale) %></p>
    <% end %>
  </div>

  <div class="form-element boolean dc-checkbox">
    <%= f.check_box :confidential %>
    <%= f.label :confidential, Doorkeeper::Application.human_attribute_name(:confidential, locale: active_ui_locale) %>
    <p class="help-text"><%= t('doorkeeper.applications.help.confidential', locale: active_ui_locale) %></p>
  </div>

  <div class="form-element boolean dc-checkbox">
    <%= f.check_box :trusted %>
    <%= f.label :trusted, Doorkeeper::Application.human_attribute_name(:trusted, locale: active_ui_locale) %>
    <p class="help-text"><%= t('doorkeeper.applications.help.trusted', locale: active_ui_locale) %></p>
  </div>

  <div class="form-element">
    <%= f.label :scopes, Doorkeeper::Application.human_attribute_name(:scopes, locale: active_ui_locale) %>
    <%= f.text_field :scopes %>
    <p class="help-text"><%= t('doorkeeper.applications.help.scopes', locale: active_ui_locale) %></p>
  </div>

  <div class="oauth-buttons">
    <%= f.button safe_join([tag.i(class: 'fa fa-check', aria_hidden: true), t('doorkeeper.applications.buttons.submit', locale: active_ui_locale)]),
      type: :submit,
      class: 'button success' %>

    <%= link_to t('doorkeeper.applications.buttons.cancel', locale: active_ui_locale), oauth_applications_path, class: 'button hollow secondary' %>
  </div>
<% end %>

<% breadcrumb :oauth_applications %>

<% content_for(:title, flush: true) { t('doorkeeper.applications.index.title', locale: active_ui_locale) } %>
<% edit_label = t('doorkeeper.applications.buttons.edit', locale: active_ui_locale) %>
<% destroy_label = t('doorkeeper.applications.buttons.destroy', locale: active_ui_locale) %>

<div class="oauth-page oauth-applications">
  <h1><%= t('doorkeeper.applications.index.title', locale: active_ui_locale) %></h1>

  <table>
    <thead>
      <tr>
        <th><%= t('doorkeeper.applications.index.name', locale: active_ui_locale) %></th>
        <th><%= t('doorkeeper.applications.index.callback_url', locale: active_ui_locale) %></th>
        <th><%= t('doorkeeper.applications.index.confidential', locale: active_ui_locale) %></th>
        <th><%= t('doorkeeper.applications.index.trusted', locale: active_ui_locale) %></th>
        <th><span class="show-for-sr"><%= t('doorkeeper.applications.index.actions', locale: active_ui_locale) %></span></th>
      </tr>
    </thead>

    <tbody>
      <% @applications.each do |application| %>
        <tr id="application_<%= application.id %>">
          <td><%= link_to application.name, oauth_application_path(application) %></td>
          <td><%= safe_join(application.redirect_uri.to_s.split, tag.br) %></td>
          <td><%= t("common.#{application.confidential?}", locale: active_ui_locale) %></td>
          <td><%= t("common.#{application.trusted?}", locale: active_ui_locale) %></td>
          <td>
            <div class="oauth-buttons">
              <%= link_to tag.i(class: 'fa fa-pencil', aria_hidden: true),
                edit_oauth_application_path(application),
                class: 'button small hollow',
                aria: { label: edit_label },
                data: { dc_tooltip: edit_label } %>

              <%= link_to tag.i(class: 'fa fa-trash', aria_hidden: true),
                oauth_application_path(application),
                method: :delete,
                class: 'button small hollow alert',
                aria: { label: destroy_label },
                data: {
                  confirm: t('doorkeeper.applications.confirmations.destroy', locale: active_ui_locale),
                  confirmation_text: destroy_label + tag.i(class: 'fa fa-trash'),
                  dc_tooltip: destroy_label
                } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="oauth-buttons">
    <%= link_to safe_join([tag.i(class: 'fa fa-plus', aria_hidden: true), t('doorkeeper.applications.index.new', locale: active_ui_locale)]),
      new_oauth_application_path,
      class: 'button success' %>
  </div>
</div>

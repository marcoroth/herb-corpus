<% breadcrumb :oauth_authorized_applications %>

<% content_for(:title, flush: true) { t('doorkeeper.authorized_applications.index.title', locale: active_ui_locale) } %>

<div class="oauth-page">
  <h1><%= t('doorkeeper.authorized_applications.index.title', locale: active_ui_locale) %></h1>

  <table>
    <thead>
      <tr>
        <th><%= t('doorkeeper.authorized_applications.index.application', locale: active_ui_locale) %></th>
        <th><%= t('doorkeeper.authorized_applications.index.created_at', locale: active_ui_locale) %></th>
        <th></th>
      </tr>
    </thead>

    <tbody>
      <% @applications.each do |application| %>
        <tr>
          <td><%= application.name %></td>
          <td><%= application.created_at.strftime(t('doorkeeper.authorized_applications.index.date_format', locale: active_ui_locale)) %></td>
          <td>
            <%= link_to safe_join([tag.i(class: 'fa fa-ban', aria_hidden: true), t('doorkeeper.authorized_applications.buttons.revoke', locale: active_ui_locale)]),
              oauth_authorized_application_path(application),
              method: :delete,
              class: 'button small hollow alert',
              data: {
                confirm: t('doorkeeper.authorized_applications.confirmations.revoke', locale: active_ui_locale),
                confirmation_text: t('doorkeeper.authorized_applications.buttons.revoke', locale: active_ui_locale) + tag.i(class: 'fa fa-ban')
              } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

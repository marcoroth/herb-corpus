<% source = thing_ids_to_value(visible_similarity_source_id(value)).first %>
<span class="tag-group tags <%= key %> <%= local_assigns[:filter_method] || 'i' %> <%= local_assigns[:container_classes] %>" data-id="<%= target %>">
  <span class="tag-group-label">
    <i class="fa fa-picture-o" aria-hidden="true"></i>
    <span><%= t('filter.similar_to', locale: active_ui_locale) %></span>
  </span>

  <span class="tags-container">
    <% if source.present? %>
      <%= tag.span(class: "tag #{source.html_class}", data: { dc_tooltip: source.dc_tooltip }) do %>
        <%= source.name %>
        <%= link_to tag.i(class: 'fa fa-external-link', aria_hidden: true), thing_path(source.id), class: 'open-selection-link', target: :_blank %>
      <% end %>
    <% else %>
      <span class="tag"><%= t('filter.similar_to_unavailable', locale: active_ui_locale) %></span>
    <% end %>
  </span>

  <%= render 'data_cycle_core/application/filters/tag_groups/advanced_buttons', local_assigns if buttons %>
</span>

<div data-id="<%= identifier %>" class="advanced-filter <%= filter_method || 'i' %>" data-label="<%= filter_name %>">
  <%= hidden_field_tag "f[#{identifier}][c]", local_assigns[:filter_code] || 'a' %>
  <%= hidden_field_tag "f[#{identifier}][t]", DataCycleCore::StoredFilterExtensions::SimilaritySources::FILTER_TYPE %>
  <%= hidden_field_tag "f[#{identifier}][n]", filter_title %>
  <%= hidden_field_tag "f[#{identifier}][m]", 'i' %>
  <% similarity_filter_bounds(value).each do |key, bound| %>
    <%= hidden_field_tag "f[#{identifier}][v][#{key}]", bound %>
  <% end %>

  <div class="advanced-filter-title">
    <%= render 'data_cycle_core/shared/icon', icon_type: filter_name&.underscore_blanks, icon_class: 'filter' %>
    <span><%= t('filter.similar_to', locale: active_ui_locale) %></span>
  </div>

  <div class="advanced-filter-selector">
    <%= select_tag("f[#{identifier}][v][thing]",
          similarity_source_options(value),
          {
            include_blank: true,
            id: "f_#{identifier}_v_thing",
            class: 'async-select',
            data: {
              initial_focus: true,
              max: 20,
              placeholder: t('filter.similar_to_placeholder', locale: active_ui_locale),
              search_path: select_search_things_path,
              query_params: { stored_filter: [{ template_names: DataCycleCore::Feature::ImageFinderPixie.image_template_names }] }.to_json
            }
          }) %>
  </div>

  <% if can?(:advanced_filter, :backend) && local_assigns[:filter_buttons] %>
    <div class="buttons">
      <a class="remove-advanced-filter" data-target="<%= identifier %>"><i aria-hidden="true" class="fa fa-times"></i></a>
    </div>
  <% end %>
</div>

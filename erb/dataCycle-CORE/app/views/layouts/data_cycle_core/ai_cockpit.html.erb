<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <%# no application bundle: the page ships its own entrypoint (ai_cockpit/show.html.erb) %>
    <%= render 'data_cycle_core/application/head_base' %>

    <%# the mode the footer's switch stored (javascripts/ai_cockpit/theme_switch.js), before the page paints %>
    <%= javascript_tag nonce: true do %>
      try {
        const theme = localStorage.getItem("<%= j DataCycleCore::AiCockpitHelper::THEME_STORAGE_KEY %>");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.acTheme = theme;
      } catch {}
    <% end %>
  </head>
  <body class="ac-body">
    <%= yield %>

    <%= yield_content!(:body_scripts) %>
  </body>
</html>

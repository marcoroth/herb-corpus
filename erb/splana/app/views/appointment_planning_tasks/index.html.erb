<% content_for :page_title, AppointmentPlanningTask.translated_name_plural %>
<% content_for :page_subtitle, "Alle" %>

<div class="container-fluid mt--6">
  <%= render PageHeaderComponent.new(button_text: "Neue #{AppointmentPlanningTask.translated_name}", button_url: new_appointment_planning_task_path) %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_card_content do %>
      <%= render CardTableComponent.new do |table| %>
        <%= table.with_header { "Fälligkeit" } %>
        <%= table.with_header { "Zwischen" } %>
        <%= table.with_header { "Und" } %>
        <%= table.with_header { "Terminrahmenplan" } %>
        <%= table.with_header { "Termin" } %>
        <%= table.with_header { "Aktionen" } %>

        <% @tasks.each do |task| %>
          <%= table.with_row do |row| %>
            <%= row.with_cell { task.due_date.to_fs(:default) } %>
            <%= row.with_cell { task.start_date.to_fs(:default) } %>
            <%= row.with_cell { task.end_date.to_fs(:default) } %>
            <%= row.with_cell { link_to task.appointment_outline.name, task.appointment_outline } %>
            <%= row.with_cell { task.appointment.try(:name) || "Kein Termin" } %>

            <%= row.with_cell do %>
              <%= render DropdownComponent.new do |dropdown| %>
                <% dropdown.with_item { link_to "Termin planen", appointment_planning_task_path(task) } %>
                <% dropdown.with_item { link_to "Anzeigen", appointment_planning_task_path(task) } %>
                <% dropdown.with_item { link_to "Bearbeiten", edit_appointment_planning_task_path(task) } %>
                <% dropdown.with_item { link_to "Löschen", appointment_planning_task_path(task), data: { turbo_confirm: "Möchtest du wirklich die #{AppointmentPlanningTask.translated_name} löschen?", turbo_method: "delete" } } %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>

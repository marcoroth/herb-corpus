<%= simple_form_for(@task) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.input :due_date %>
    <%= f.input :start_date %>
    <%= f.input :end_date %>
    <%= f.association :appointment_outline %>
    <%= f.association :appointment %>
  </div>

  <div class="form-actions">
    <%= f.button :submit %>
  </div>
<% end %>

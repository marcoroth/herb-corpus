<% content_for :page_title, "#{AppointmentPlanningTask.translated_name} '#{@task.due_date}'" %>
<% content_for :page_subtitle, AppointmentPlanningTask.translated_name_plural %>

<div class="container-fluid mt--6">
  <%= render PageHeaderComponent.new(button_text: "Bearbeiten", button_url: edit_appointment_planning_task_path(@task)) %>

  <div class="row tw-mt-16">
    <div class="col-12 col-xl-8">
      <%= render CardComponent.new do |card| %>
        <%= card.with_body do %>

          <% date = @task.start_date.beginning_of_week %>
          <% group = @task.group %>

          <% while date < @task.end_date %>
            <div class="tw-grid tw-mt-6 tw-grid-cols-[repeat(5,1fr)] tw-gap-x-4">
              <% range = date..date+4.days %>

              <% range.each do |day| %>
                <a href="<%= day_plan_for_group_path(group, start_date: day) %>" class="tw-border tw-border-gray-300 tw-py-2 tw-px-4 tw-sticky tw-top-0 tw-bg-white hover:tw-bg-gray-100 hover:tw-text-inherit tw-border-black tw-text-center tw-mb-2">
                  <b><%= I18n.t("date.day_names")[day.wday] %></b><br>
                  <%= day.day %>.<%= day.month %>
                </a>
              <% end %>

              <% range.each do |day| %>
                <%= render partial: "groups/available_group_day", locals: { date: day, group: group, min_height: "350px" } %>
              <% end %>
            </div>

            <% date = date + 1.week %>
          <% end %>



          <%= link_to 'Löschen', appointment_planning_task_path(@task), class: "btn btn-danger", data: { turbo_method: "delete", turbo_confirm: "Willst du diesen #{AppointmentPlanningTask.translated_name} wirklich löschen?" } %>
          <%= link_to 'Zurück', appointment_planning_tasks_path, class: "btn btn-secondary" %>
        <% end %>
      <% end %>
    </div>

    <div class="col-12 col-xl-4">
      <%= render CardListComponent.new do |list| %>
        <%= list.with_item(title: "Erstellt am", value: @task.created_at.to_fs(:default)) %>
        <%= list.with_item(title: "Fällig am", value: @task.due_date.to_fs(:default)) %>
        <%= list.with_item(title: "Fällig?", value: @task.due? ? "Ja" : "Nein") %>

        <%= list.with_item(title: "Geplant zwischen") do %>
          <%= @task.start_date.to_fs(:default) %> und <%= @task.end_date.to_fs(:default) %>
        <% end %>

        <%= list.with_item(title: "Benötigte Mitarbeiter", value: "#{@task.needed_workers}") %>
        <%= list.with_item(title: "Regelaufwand pro Termin", value: "#{@task.duration} h") %>


        <%= list.with_item(title: "Terminrahmenplan") do %>
          <%= link_to @task.appointment_outline.name, @task.appointment_outline %>
        <% end %>

        <%= list.with_item(title: "Dauerauftrag-Ausführung") do %>
          <%= link_to @task.recurring_order_execution.to_s, @task.recurring_order_execution %>
        <% end %>

        <%= list.with_item(title: "Dauerauftrag") do %>
          <%= link_to @task.recurring_order.name, @task.recurring_order %>
        <% end %>


        <%= list.with_item(title: "Status") do %>
          <% if @task.done? %>
            Geplant (Termin: <%= link_to @task.appointment.name, @appointmnet_planning_task.appointment %>)
          <% else %>
            Ungeplant
          <% end %>
        <% end %>

        <%= list.with_item(title: "Gruppe") do %>
          <%= render AvatarGroupComponent.new(users: @task.group.users) %>
        <% end %>

        <%= list.with_item(title: "Kunde") do %>
          <%= render AvatarComponent.new(user: @task.client) %>
        <% end %>

        <%= list.with_item(title: "Bauleiter") do %>
          <%= render AvatarComponent.new(user: @task.leader) %>
        <% end %>
      <% end %>

      <% if @next_appointment %>
        <%= render AppointmentCardComponent.new(appointment: @next_appointment, header: "Nächster Termin", duration: false) %>
      <% end %>
    </div>
  </div>

</div>

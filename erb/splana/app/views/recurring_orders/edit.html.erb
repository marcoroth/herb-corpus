<% content_for :page_title, "Dauerauftrag bearbeiten" %>
<% content_for :page_subtitle, "Dauerauftrag" %>

<div class="container-fluid mt--6">
  <%= render PageHeaderComponent.new %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_body do %>
      <%= simple_form_for(@recurring_order) do |order| %>
        <%= order.error_notification %>

        <div class="form-inputs">
          <%= order.input :name %>

          <%= order.input :client_id, label: "Kunde", as: :select, prompt: "Bitte auswählen:", collection: [@recurring_order.client], disabled: true %>
        </div><br>

        <div class="form-actions">
          <%= order.button :submit, class: "btn btn-primary" %>
          <%= link_to "Abbrechen", recurring_orders_path, class: "btn btn-secondary" %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>

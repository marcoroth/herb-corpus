<% content_for :page_title, "Neuen Dauerauftrag erfassen" %>
<% content_for :page_subtitle, "Dauerauftrag" %>

<div class="container-fluid mt--6">
  <%= render PageHeaderComponent.new %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_body do %>
      <%= simple_form_for(@recurring_order) do |order| %>
        <%= order.error_notification %>

        <%= order.simple_fields_for :recurring_order_executions do |execution| %>
        <%= execution.error_notification %>

          <div class="form-inputs" data-controller="recurring-order-form">
            <h3 class="">Dauerauftrag</h3>

            <div class="row">
              <%= order.input :name %>
            </div>

            <div class="row">
              <div class="col-md-6">
                <%= execution.input :start_date, label: "Start-Datum", as: :only_date %>
              </div>

              <div class="col-md-6">
                <%= execution.input :end_date, label: "End-Datum", as: :only_date %>
              </div>
            </div>

            <h3 class="tw-mt-6">Eckdaten</h3>

            <div class="row">
              <div class="col-md-6">
                <%= execution.association :leader, label: "Verantwortliche/r Bauleiter/in", as: :select, collection: Leader.all %>
              </div>

              <div class="col-md-6">
                <%= execution.association :group, label: Group.translated_name, as: :select, collection: Group.labeled %>
              </div>

              <div class="col-md-6">
                <%= execution.input :report_number, label: "Auftragsnummer" %>
              </div>
            </div>

            <h3 class="tw-mt-6">Kunde</h3>

            <%= order.association :client, label: "Kunde", as: :select, collection: Client.labeled, input_html: { data: { action: "change->recurring-order-form#changeClient" } }  %>

            <div class="row">
              <div class="col-md-6">
                <%= execution.input :address, label: "Ausführungs-Adresse", as: :string %>
              </div>

              <div class="col-md-6">
                <%= execution.association :place, label: "Ausführungs-Ort", as: :select, collection: Place.labeled %>
              </div>
            </div>
          </div><br>

          <div class="form-actions">
            <%= order.button :submit, class: "btn btn-primary" %>
            <%= link_to "Abbrechen", recurring_orders_path, class: "btn btn-secondary" %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>

              <a href="#" class="tw-text-gray-700 tw-block tw-px-4 tw-py-2 tw-text-sm" role="menuitem" tabindex="-1" id="menu-0-item-0">Create event</a>
            </div>
            <div class="tw-py-1" role="none">
              <a href="" class="tw-text-gray-700 tw-block tw-px-4 tw-py-2 tw-text-sm" role="menuitem" tabindex="-1" id="menu-0-item-1">Go to today</a>
            </div>
            <div class="tw-py-1" role="none">
              <a href="#" class="tw-text-gray-700 tw-block tw-px-4 tw-py-2 tw-text-sm" role="menuitem" tabindex="-1" id="menu-0-item-2">Day view</a>
              <a href="#" class="tw-text-gray-700 tw-block tw-px-4 tw-py-2 tw-text-sm" role="menuitem" tabindex="-1" id="menu-0-item-3">Week view</a>
              <a href="#" class="tw-text-gray-700 tw-block tw-px-4 tw-py-2 tw-text-sm" role="menuitem" tabindex="-1" id="menu-0-item-4">Month view</a>
              <a href="#" class="tw-text-gray-700 tw-block tw-px-4 tw-py-2 tw-text-sm" role="menuitem" tabindex="-1" id="menu-0-item-5">Year view</a>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="tw-isolate tw-flex tw-flex-auto tw-flex-col tw-overflow-auto tw-bg-white">
      <div style="width: 165%" class="tw-flex tw-max-w-full tw-flex-none tw-flex-col sm:tw-max-w-none md:tw-max-w-full">
        <div class="tw-sticky tw-top-0 tw-z-30 tw-flex-none tw-bg-white tw-shadow tw-ring-1 tw-ring-black tw-ring-opacity-5 sm:tw-pr-8">

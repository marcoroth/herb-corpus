<div class="container-fluid">
  <div class="tw-flex tw-h-[95vh] tw-flex-col">
    <header class="tw-flex tw-flex-none tw-items-center tw-justify-between tw-border-b tw-border-gray-200 tw-py-4 tw-px-6">
      <h1 class="tw-text-lg tw-font-semibold tw-text-gray-900">
        <time datetime="2022-01"><%= @date.beginning_of_week.to_fs(:default) %> bis <%= @date.end_of_week.to_fs(:default) %></time>
      </h1>
      <div class="tw-flex tw-items-center">
        <div class="tw-flex tw-items-center tw-rounded-md tw-shadow-sm md:tw-items-stretch">
          <a href="<%= weekly_calendar_path(date: @date - 1.week, user_id: @user.id) %>" class="tw-flex tw-items-center tw-justify-center tw-rounded-l-md tw-border tw-border-r-0 tw-border-gray-300 tw-bg-white tw-py-2 tw-pl-3 tw-pr-4 tw-text-gray-400 hover:tw-text-gray-500 focus:tw-relative md:tw-w-9 md:tw-px-2 md:hover:tw-bg-gray-50">
            <span class="tw-sr-only">Previous month</span>
            <!-- Heroicon name: mini/chevron-left -->
            <svg class="tw-h-5 tw-w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" />
            </svg>
          </a>
          <a href="<%= weekly_calendar_path(date: Date.current, user_id: @user.id) %>" class="tw-hidden tw-border-t tw-border-b tw-border-gray-300 tw-bg-white tw-px-3.5 tw-text-sm tw-font-medium tw-text-gray-700 hover:tw-bg-gray-50 hover:tw-text-gray-900 focus:tw-relative md:tw-block">Today</a>
          <span class="tw-relative -tw-mx-px tw-h-5 tw-w-px tw-bg-gray-300 md:tw-hidden"></span>
          <a href="<%= weekly_calendar_path(date: @date + 1.week, user_id: @user.id) %>" class="tw-flex tw-items-center tw-justify-center tw-rounded-r-md tw-border tw-border-l-0 tw-border-gray-300 tw-bg-white tw-py-2 tw-pl-4 tw-pr-3 tw-text-gray-400 hover:tw-text-gray-500 focus:tw-relative md:tw-w-9 md:tw-px-2 md:hover:tw-bg-gray-50">
            <span class="tw-sr-only">Next month</span>
            <!-- Heroicon name: mini/chevron-right -->
            <svg class="tw-h-5 tw-w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>

        <div class="tw-hidden md:tw-ml-4 md:tw-flex md:tw-items-center">
          <div class="tw-ml-6 tw-h-6 tw-w-px tw-bg-gray-300"></div>
          <button type="button" class="tw-ml-6 tw-rounded-md tw-border tw-border-transparent tw-bg-indigo-600 tw-py-2 tw-px-4 tw-text-sm tw-font-medium tw-text-white tw-shadow-sm hover:tw-bg-indigo-700 focus:tw-outline-none focus:tw-ring-2 focus:tw-ring-indigo-500 focus:tw-ring-offset-2">Add event</button>
        </div>
        <div class="tw-relative tw-ml-6 md:tw-hidden">
          <button type="button" class="-tw-mx-2 tw-flex tw-items-center tw-rounded-full tw-border tw-border-transparent tw-p-2 tw-text-gray-400 hover:tw-text-gray-500" id="menu-0-button" aria-expanded="false" aria-haspopup="true">
            <span class="tw-sr-only">Open menu</span>
            <!-- Heroicon name: mini/ellipsis-horizontal -->
            <svg class="tw-h-5 tw-w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M3 10a1.5 1.5 0 113 0 1.5 1.5 0 01-3 0zM8.5 10a1.5 1.5 0 113 0 1.5 1.5 0 01-3 0zM15.5 8.5a1.5 1.5 0 100 3 1.5 1.5 0 000-3z" />
            </svg>
          </button>

          <!--
            Dropdown menu, show/hide based on menu state.

            Entering: "transition ease-out duration-100"
            From: "transform opacity-0 scale-95"
            To: "transform opacity-100 scale-100"
            Leaving: "transition ease-in duration-75"
            From: "transform opacity-100 scale-100"
            To: "transform opacity-0 scale-95"
          -->
          <div class="tw-absolute tw-right-0 tw-z-10 tw-mt-3 tw-w-36 tw-origin-top-right tw-divide-y tw-divide-gray-100 tw-overflow-hidden tw-rounded-md tw-bg-white tw-shadow-lg tw-ring-1 tw-ring-black tw-ring-opacity-5 focus:tw-outline-none" role="menu" aria-orientation="vertical" aria-labelledby="menu-0-button" tabindex="-1">

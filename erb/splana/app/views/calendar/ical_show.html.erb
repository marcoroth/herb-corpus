<% content_for :page_title, "iCal-Kalender" %>
<% content_for :page_subtitle, "Kalender" %>

<div class="container-fluid mt--6">
  <%= render PageHeaderComponent.new %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_header do |header| %>
      <%= header.with_title { "Kalender" } %>
    <% end %>

    <%= card.with_body do %>
      <div class="">
        <div class="">
          <table class="table white-box">
            <tr>
              <th>Kalender von:</th>
              <th>iCal Kalender-URL:</th>
              <th>iCal</th>
              <th>Termine</th>
              <th>Zuletzt aktualisiert:</th>
            </tr>

            <% @users.each do |u| %>
              <tr>
                <td><%= u.name %></td>
                <td><%= link_to ical_user_url(u.ical_key), ical_user_path(u.ical_key) %></td>
                <% ical_link = ical_user_url(u.ical_key).to_s %>
                <td><%= link_to "iCal", ical_link.starts_with?("https") ? ical_link.gsub!("https://", "ical://") : ical_link.gsub!("http://", "ical://"), target: "_blank" %></td>
                <td><%= u.appointments.count %></td>
                <% if u.calendar_refreshed_at.present? %>
                  <% if (Time.current - u.calendar_refreshed_at).to_i < 1.hour.to_i || u.calendar_refreshed_at.to_date == Date.current %>
                    <td class="text-success">
                  <% else %>
                    <td class="text-danger">
                  <% end %>
                    <%= u.calendar_refreshed_at.to_fs(:default) %> - (vor: <%= time_ago_in_words(u.calendar_refreshed_at) %>)
                  </td>
                <% else %>
                  <td class="text-danger">Nie abgerufen</td>
                <% end %>
              </tr>
            <% end %>
          </table>

        </div><br>

        <div class="col-md-12 m-t-40">
          <table class="table white-box">
            <tr>
              <th>Kalender von:</th>
              <th>iCal Kalender-URL:</th>
            </tr>

            <% @groups.each do |user| %>
              <tr>
                <td><%= user %></td>
                <td><%= link_to ical_group_url(user.ical_key), ical_group_path(user.ical_key) %></td>
                <td></td>
              </tr>
            <% end %>
          </table>
        </div>

      </div>
    <% end %>
  <% end %>
</div>

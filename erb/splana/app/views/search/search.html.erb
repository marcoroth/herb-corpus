<div class="row container-fluid">
  <div class="col-md-12">
    <div class="white-box">
      <h3 class="box-title">Suchen</h3>
      <%= form_for search_path, method: :get, html: { class: "form-group" } do |f| %>
      <p>
        <div class="input-group">
          <%= text_field_tag :q, params[:q], class: "form-control" %>
          <span class="input-group-btn">
            <button type="submit" class="btn waves-effect waves-light btn-info">
              <i class="fa fa-search"></i>
            </button>
          </span>
        </div>
      </p>
      <% end %>

      <h2 class="m-t-40">Such-Ergebnisse für "<%= params[:q] %>"</h2> <small><%= @results.total_count %> Treffer</small>
      <hr>
      <ul class="search-listing">

        <% @results.results.each do |result| %>
        <% #aa %>
          <% @result = eval(result._type.classify).find(result._id) %>
          <li>
            <h3><%= link_to @result.search_title, user_path(@result.id) %></h3>
            <p><%= @result.search_description %></p>

            <% unless result.try(:highlight).nil? %>
              <p>
                Treffer in
                <% result.try(:highlight).each do |h| %>
                  <b><%= h[0] %></b>:
                  <%= h[1].first.html_safe %>
                <% end %>
              </p>
            <% end %>
          </li>
        <% end %>
      </ul>

</div>
</div>
</div>

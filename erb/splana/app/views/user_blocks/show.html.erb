<div class="tw-grid tw-grid-cols-[2fr_1fr]">
  <div class="container-fluid tw-mt-12">
    <div class="tw-overflow-hidden tw-bg-white tw-shadow sm:tw-rounded-lg">
      <div class="tw-px-4 tw-py-5 sm:tw-px-6">
        <h3 class="tw-text-lg tw-font-medium tw-leading-6 tw-text-gray-900">Block</h3>
        <p class="tw-mt-1 tw-max-w-2xl tw-text-sm tw-text-gray-500"><%= @block.time_text %></p>
      </div>
      <div class="tw-border-t tw-border-gray-200 tw-px-4 tw-py-5 sm:tw-p-0">
        <dl class="sm:tw-divide-y sm:tw-divide-gray-200">
          <div class="tw-py-4 sm:tw-grid sm:tw-grid-cols-3 sm:tw-gap-4 sm:tw-py-5 sm:tw-px-6">
            <dt class="tw-text-sm tw-font-medium tw-text-gray-500">Datum</dt>
            <dd class="tw-mt-1 tw-text-sm tw-text-gray-900 sm:tw-col-span-2 sm:tw-mt-0"><%= @block.start_time.to_date.to_fs(:default) %></dd>
          </div>

          <div class="tw-py-4 sm:tw-grid sm:tw-grid-cols-3 sm:tw-gap-4 sm:tw-py-5 sm:tw-px-6">
            <dt class="tw-text-sm tw-font-medium tw-text-gray-500">Zeit</dt>
            <dd class="tw-mt-1 tw-text-sm tw-text-gray-900 sm:tw-col-span-2 sm:tw-mt-0"><%= @block.time_text(only_time: true) %></dd>
          </div>

          <div class="tw-py-4 sm:tw-grid sm:tw-grid-cols-3 sm:tw-gap-4 sm:tw-py-5 sm:tw-px-6">
            <dt class="tw-text-sm tw-font-medium tw-text-gray-500">Mitarbeiter</dt>
            <dd class="tw-mt-1 tw-text-sm tw-text-gray-900 sm:tw-col-span-2 sm:tw-mt-0"><%= link_to @block.user.name, user_path(@block.user) %></dd>
          </div>

          <!-- <div class="tw-py-4 sm:tw-grid sm:tw-grid-cols-3 sm:tw-gap-4 sm:tw-py-5 sm:tw-px-6">
            <dt class="tw-text-sm tw-font-medium tw-text-gray-500">Eingeplant</dt>
            <dd class="tw-mt-1 tw-text-sm tw-text-gray-900 sm:tw-col-span-2 sm:tw-mt-0">
              <% if @block.has_appointment %>
                <span class="tw-inline-block tw-flex-shrink-0 tw-rounded-full tw-bg-green-100 tw-px-2 tw-py-0.5 tw-text-xs tw-font-medium tw-text-green-800"><%= link_to "Ja", @block.appointment %></span>
              <% else %>
                <span class="tw-inline-block tw-flex-shrink-0 tw-rounded-full tw-bg-red-100 tw-px-2 tw-py-0.5 tw-text-xs tw-font-medium tw-text-red-800">Nein</span>
              <% end %>
            </dd>
          </div> -->

          <div class="tw-py-4 sm:tw-grid sm:tw-grid-cols-3 sm:tw-gap-4 sm:tw-py-5 sm:tw-px-6">
            <dt class="tw-text-sm tw-font-medium tw-text-gray-500">Mitarbeiter/in einplanbar?</dt>
            <dd class="tw-mt-1 tw-text-sm tw-text-gray-900 sm:tw-col-span-2 sm:tw-mt-0">
              <% if @block.available %>
                <%= render BadgeComponent.new(text: "Ja", color: "green") %>
              <% else %>
                <%= render BadgeComponent.new(text: "Nein", color: "red") %>

                <h3 class="tw-text-gray-700 tw-mt-6">Grund/Gründe</h3>

                <ul role="list" class="tw-divide-y tw-divide-gray-200 tw-rounded-md tw-border tw-border-gray-200 tw-mt-3">
                  <% if !@block.has_conflict %>
                    <% if @block.weekend %>
                      <li class="tw-flex tw-items-center tw-justify-between tw-py-3 tw-pl-3 tw-pr-4 tw-text-sm">
                        <div class="tw-flex tw-w-0 tw-flex-1 tw-items-center">
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.563C9 9.252 9.252 9 9.563 9h4.874c.311 0 .563.252.563.563v4.874c0 .311-.252.563-.563.563H9.564A.562.562 0 019 14.437V9.564z" />
                          </svg>
                          <span class="tw-ml-2 tw-w-0 tw-flex-1 tw-truncate">Block fällt auf ein Wochenende</span>
                        </div>
                      </li>
                    <% end %>

                    <% if !@block.has_user_availability %>
                      <li class="tw-flex tw-items-center tw-justify-between tw-py-3 tw-pl-3 tw-pr-4 tw-text-sm">
                        <div class="tw-flex tw-w-0 tw-flex-1 tw-items-center">
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.563C9 9.252 9.252 9 9.563 9h4.874c.311 0 .563.252.563.563v4.874c0 .311-.252.563-.563.563H9.564A.562.562 0 019 14.437V9.564z" />
                          </svg>
                          <span class="tw-ml-2 tw-w-0 tw-flex-1 tw-truncate">Mitarbeiter hat keine Verfügbarkeit</span>
                        </div>
                        <div class="tw-ml-4 tw-flex-shrink-0">
                          <a href="<%= new_user_availability_path(user_id: @block.user_id) %>" class="tw-font-medium tw-text-indigo-600 hover:tw-text-indigo-500">Verfügbarkeit erstellen</a>
                        </div>
                      </li>
                    <% end %>

                    <% if !@block.working_hour %>
                      <li class="tw-flex tw-items-center tw-justify-between tw-py-3 tw-pl-3 tw-pr-4 tw-text-sm">
                        <div class="tw-flex tw-w-0 tw-flex-1 tw-items-center">
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.563C9 9.252 9.252 9 9.563 9h4.874c.311 0 .563.252.563.563v4.874c0 .311-.252.563-.563.563H9.564A.562.562 0 019 14.437V9.564z" />
                          </svg>
                          <span class="tw-ml-2 tw-w-0 tw-flex-1 tw-truncate">Block ist ausserhalb der Arbeitszeiten</span>
                        </div>
                        <div class="tw-ml-4 tw-flex-shrink-0">
                          <a href="<%= working_hours_path %>" class="tw-font-medium tw-text-indigo-600 hover:tw-text-indigo-500">Arbeitszeiten anzeigen</a>
                        </div>
                      </li>
                    <% end %>

                    <% if @block.has_appointment %>
                      <li class="tw-flex tw-items-center tw-justify-between tw-py-3 tw-pl-3 tw-pr-4 tw-text-sm">
                        <div class="tw-flex tw-w-0 tw-flex-1 tw-items-center">
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.563C9 9.252 9.252 9 9.563 9h4.874c.311 0 .563.252.563.563v4.874c0 .311-.252.563-.563.563H9.564A.562.562 0 019 14.437V9.564z" />
                          </svg>
                          <span class="tw-ml-2 tw-w-0 tw-flex-1 tw-truncate">Mitarbeiter ist dem Termin "<%= link_to @block.appointment.name, @block.appointment %>" zugeteilt</span>
                        </div>
                        <div class="tw-ml-4 tw-flex-shrink-0">
                          <a href="<%= appointment_path(@block.appointment) %>" class="tw-font-medium tw-text-indigo-600 hover:tw-text-indigo-500">Termin anzeigen</a>
                        </div>
                      </li>
                    <% end %>

                    <% if @block.has_absence %>
                      <li class="tw-flex tw-items-center tw-justify-between tw-py-3 tw-pl-3 tw-pr-4 tw-text-sm">
                        <div class="tw-flex tw-w-0 tw-flex-1 tw-items-center">
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.563C9 9.252 9.252 9 9.563 9h4.874c.311 0 .563.252.563.563v4.874c0 .311-.252.563-.563.563H9.564A.562.562 0 019 14.437V9.564z" />
                          </svg>
                          <span class="tw-ml-2 tw-w-0 tw-flex-1 tw-truncate">Mitarbeiter hat Absenz "<%= link_to @block.absence.name, @block.absence %>"</span>
                        </div>
                        <div class="tw-ml-4 tw-flex-shrink-0">
                          <a href="<%= absence_path(@block.absence) %>" class="tw-font-medium tw-text-indigo-600 hover:tw-text-indigo-500">Absenz anzeigen</a>
                        </div>
                      </li>
                    <% end %>

                    <% if @block.has_absence_rule %>
                      <li class="tw-flex tw-items-center tw-justify-between tw-py-3 tw-pl-3 tw-pr-4 tw-text-sm">
                        <div class="tw-flex tw-w-0 tw-flex-1 tw-items-center">
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.563C9 9.252 9.252 9 9.563 9h4.874c.311 0 .563.252.563.563v4.874c0 .311-.252.563-.563.563H9.564A.562.562 0 019 14.437V9.564z" />
                          </svg>
                          <span class="tw-ml-2 tw-w-0 tw-flex-1 tw-truncate">Mitarbeiter hat Absenz-Regel "<%= link_to @block.absence_rule.name, @block.absence_rule %>"</span>
                        </div>
                        <div class="tw-ml-4 tw-flex-shrink-0">
                          <a href="<%= absence_rule_path(@block.absence_rule) %>" class="tw-font-medium tw-text-indigo-600 hover:tw-text-indigo-500">Abwesenheitsregel anzeigen</a>
                        </div>
                      </li>
                    <% end %>

                    <% if @block.has_holiday %>
                      <li class="tw-flex tw-items-center tw-justify-between tw-py-3 tw-pl-3 tw-pr-4 tw-text-sm">
                        <div class="tw-flex tw-w-0 tw-flex-1 tw-items-center">
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.563C9 9.252 9.252 9 9.563 9h4.874c.311 0 .563.252.563.563v4.874c0 .311-.252.563-.563.563H9.564A.562.562 0 019 14.437V9.564z" />
                          </svg>
                          <span class="tw-ml-2 tw-w-0 tw-flex-1 tw-truncate">Block fällt auf <%= link_to @block.holiday.holiday_type, @block.holiday %> "<%= link_to @block.holiday.name, @block.holiday %>" </span>
                        </div>
                        <div class="tw-ml-4 tw-flex-shrink-0">
                          <a href="<%= holiday_path(@block.holiday) %>" class="tw-font-medium tw-text-indigo-600 hover:tw-text-indigo-500">Feiertag anzeigen</a>
                        </div>
                      </li>
                    <% end %>

                    <% if @block.has_pause %>
                      <li class="tw-flex tw-items-center tw-justify-between tw-py-3 tw-pl-3 tw-pr-4 tw-text-sm">
                        <div class="tw-flex tw-w-0 tw-flex-1 tw-items-center">
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.563C9 9.252 9.252 9 9.563 9h4.874c.311 0 .563.252.563.563v4.874c0 .311-.252.563-.563.563H9.564A.562.562 0 019 14.437V9.564z" />
                          </svg>
                          <span class="tw-ml-2 tw-w-0 tw-flex-1 tw-truncate">Block fällt auf eine Pause</span>
                        </div>
                        <div class="tw-ml-4 tw-flex-shrink-0">
                          <a href="<%= working_hour_path(@block.working_hour) %>" class="tw-font-medium tw-text-indigo-600 hover:tw-text-indigo-500">Arbeitszeiten anzeigen</a>
                        </div>
                      </li>
                    <% end %>

                  <% else %>
                    <li class="tw-flex tw-items-center tw-justify-between tw-py-3 tw-pl-3 tw-pr-4 tw-text-sm">
                      <div class="tw-flex tw-w-0 tw-flex-1 tw-items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.563C9 9.252 9.252 9 9.563 9h4.874c.311 0 .563.252.563.563v4.874c0 .311-.252.563-.563.563H9.564A.562.562 0 019 14.437V9.564z" />
                        </svg>
                        <span class="tw-ml-2 tw-w-0 tw-flex-1 tw-truncate">Block hat Konflikt</span>
                      </div>
                    </li>
                  <% end %>
                </ul>
              <% end %>
            </dd>
          </div>

          <div class="tw-py-4 sm:tw-grid sm:tw-grid-cols-3 sm:tw-gap-4 sm:tw-py-5 sm:tw-px-6">
            <dt class="tw-text-sm tw-font-medium tw-text-gray-500">Status</dt>
            <dd class="tw-mt-1 tw-text-sm tw-text-gray-900 sm:tw-col-span-2 sm:tw-mt-0">
              <% if !@block.has_conflict %>
                <% if @block.available %>
                  <%= render BadgeComponent.new(text: "Einplanung austehend", color: "yellow") %>
                <% else %>
                  <%= render BadgeComponent.new(text: "OK", color: "green") %>
                <% end %>
              <% else %>
                <%= render BadgeComponent.new(text: "Konflikt", color: "red") %>

                <h3 class="tw-text-gray-700 tw-mt-6">Grund/Gründe</h3>

                <ul role="list" class="tw-divide-y tw-divide-gray-200 tw-rounded-md tw-border tw-border-gray-200 tw-mt-3">
                  <% @block.appointments.each do |appointment| %>
                    <li class="tw-flex tw-items-center tw-justify-between tw-py-3 tw-pl-3 tw-pr-4 tw-text-sm">
                      <div class="tw-flex tw-w-0 tw-flex-1 tw-items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.563C9 9.252 9.252 9 9.563 9h4.874c.311 0 .563.252.563.563v4.874c0 .311-.252.563-.563.563H9.564A.562.562 0 019 14.437V9.564z" />
                        </svg>
                        <span class="tw-ml-2 tw-w-0 tw-flex-1 tw-truncate"><%= appointment.time_text(only_time: true) %> - Mitarbeiter ist dem Termin "<%= link_to appointment.name, appointment %>" zugeteilt</span>
                      </div>
                      <div class="tw-ml-4 tw-flex-shrink-0">
                        <a href="<%= appointment_path(@block.appointment) %>" class="tw-font-medium tw-text-indigo-600 hover:tw-text-indigo-500">Termin anzeigen</a>
                      </div>
                    </li>
                  <% end %>

                  <% if @block.has_appointments %>
                    <li class="tw-flex tw-items-center tw-justify-between tw-py-3 tw-pl-3 tw-pr-4 tw-text-sm">
                      <div class="tw-flex tw-w-0 tw-flex-1 tw-items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.563C9 9.252 9.252 9 9.563 9h4.874c.311 0 .563.252.563.563v4.874c0 .311-.252.563-.563.563H9.564A.562.562 0 019 14.437V9.564z" />
                        </svg>
                        <span class="tw-ml-2 tw-w-0 tw-flex-1 tw-truncate">Mitarbeiter ist mehreren Terminen zur gleichen Zeit zugeteilt</span>
                      </div>
                    </li>
                  <% end %>

                  <% if !@block.appointment_has_enough_workers %>
                    <li class="tw-flex tw-items-center tw-justify-between tw-py-3 tw-pl-3 tw-pr-4 tw-text-sm">
                      <div class="tw-flex tw-w-0 tw-flex-1 tw-items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.563C9 9.252 9.252 9 9.563 9h4.874c.311 0 .563.252.563.563v4.874c0 .311-.252.563-.563.563H9.564A.562.562 0 019 14.437V9.564z" />
                        </svg>
                        <span class="tw-ml-2 tw-w-0 tw-flex-1 tw-truncate">
                          Termin hat nicht die richtige Anzahl an Mitarbeiter/innen zugeteilt. <br/>
                          Benötigt: <%= @block.appointment_needed_workers %><br/>
                          Zugeteilt: <%= @block.appointment_user_count %>
                        </span>
                      </div>
                      <div class="tw-ml-4 tw-flex-shrink-0">
                        <a href="<%= appointment_path(@block.appointment) %>" class="tw-font-medium tw-text-indigo-600 hover:tw-text-indigo-500">Termin anzeigen</a>
                      </div>
                    </li>
                  <% end %>

                  <% if !@block.has_user_availability %>
                    <li class="tw-flex tw-items-center tw-justify-between tw-py-3 tw-pl-3 tw-pr-4 tw-text-sm">
                      <div class="tw-flex tw-w-0 tw-flex-1 tw-items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.563C9 9.252 9.252 9 9.563 9h4.874c.311 0 .563.252.563.563v4.874c0 .311-.252.563-.563.563H9.564A.562.562 0 019 14.437V9.564z" />
                        </svg>
                        <span class="tw-ml-2 tw-w-0 tw-flex-1 tw-truncate">Mitarbeiter hat keine Verfügbarkeit</span>
                      </div>
                      <div class="tw-ml-4 tw-flex-shrink-0">
                        <a href="<%= new_user_availability_path(user_id: @block.user_id) %>" class="tw-font-medium tw-text-indigo-600 hover:tw-text-indigo-500">Verfügbarkeit erstellen</a>
                      </div>
                    </li>
                  <% end %>

                  <% if @block.weekend %>
                    <li class="tw-flex tw-items-center tw-justify-between tw-py-3 tw-pl-3 tw-pr-4 tw-text-sm">
                      <div class="tw-flex tw-w-0 tw-flex-1 tw-items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.563C9 9.252 9.252 9 9.563 9h4.874c.311 0 .563.252.563.563v4.874c0 .311-.252.563-.563.563H9.564A.562.562 0 019 14.437V9.564z" />
                        </svg>
                        <span class="tw-ml-2 tw-w-0 tw-flex-1 tw-truncate">Block fällt auf ein Wochenende</span>
                      </div>
                    </li>
                  <% end %>

                  <% if !@block.working_hour %>
                    <li class="tw-flex tw-items-center tw-justify-between tw-py-3 tw-pl-3 tw-pr-4 tw-text-sm">
                      <div class="tw-flex tw-w-0 tw-flex-1 tw-items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.563C9 9.252 9.252 9 9.563 9h4.874c.311 0 .563.252.563.563v4.874c0 .311-.252.563-.563.563H9.564A.562.562 0 019 14.437V9.564z" />
                        </svg>
                        <span class="tw-ml-2 tw-w-0 tw-flex-1 tw-truncate">Block ist ausserhalb der Arbeitszeiten</span>
                      </div>
                      <div class="tw-ml-4 tw-flex-shrink-0">
                        <a href="<%= working_hours_path %>" class="tw-font-medium tw-text-indigo-600 hover:tw-text-indigo-500">Arbeitszeiten anzeigen</a>
                      </div>
                    </li>
                  <% end %>

                  <% if @block.has_absence %>
                    <li class="tw-flex tw-items-center tw-justify-between tw-py-3 tw-pl-3 tw-pr-4 tw-text-sm">
                      <div class="tw-flex tw-w-0 tw-flex-1 tw-items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.563C9 9.252 9.252 9 9.563 9h4.874c.311 0 .563.252.563.563v4.874c0 .311-.252.563-.563.563H9.564A.562.562 0 019 14.437V9.564z" />
                        </svg>
                        <span class="tw-ml-2 tw-w-0 tw-flex-1 tw-truncate">Mitarbeiter hat Absenz "<%= link_to @block.absence.name, @block.absence %>"</span>
                      </div>
                      <div class="tw-ml-4 tw-flex-shrink-0">
                        <a href="<%= absence_path(@block.absence) %>" class="tw-font-medium tw-text-indigo-600 hover:tw-text-indigo-500">Absenz anzeigen</a>
                      </div>
                    </li>
                  <% end %>

                  <% if @block.has_absence_rule %>
                    <li class="tw-flex tw-items-center tw-justify-between tw-py-3 tw-pl-3 tw-pr-4 tw-text-sm">
                      <div class="tw-flex tw-w-0 tw-flex-1 tw-items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.563C9 9.252 9.252 9 9.563 9h4.874c.311 0 .563.252.563.563v4.874c0 .311-.252.563-.563.563H9.564A.562.562 0 019 14.437V9.564z" />
                        </svg>
                        <span class="tw-ml-2 tw-w-0 tw-flex-1 tw-truncate">Mitarbeiter hat Absenz-Regel "<%= link_to @block.absence_rule.name, @block.absence_rule %>"</span>
                      </div>
                      <div class="tw-ml-4 tw-flex-shrink-0">
                        <a href="<%= absence_rule_path(@block.absence_rule) %>" class="tw-font-medium tw-text-indigo-600 hover:tw-text-indigo-500">Abwesenheitsregel anzeigen</a>
                      </div>
                    </li>
                  <% end %>

                  <% if @block.has_holiday %>
                    <li class="tw-flex tw-items-center tw-justify-between tw-py-3 tw-pl-3 tw-pr-4 tw-text-sm">
                      <div class="tw-flex tw-w-0 tw-flex-1 tw-items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.563C9 9.252 9.252 9 9.563 9h4.874c.311 0 .563.252.563.563v4.874c0 .311-.252.563-.563.563H9.564A.562.562 0 019 14.437V9.564z" />
                        </svg>
                        <span class="tw-ml-2 tw-w-0 tw-flex-1 tw-truncate">Block fällt auf <%= link_to @block.holiday.holiday_type, @block.holiday %> "<%= link_to @block.holiday.name, @block.holiday %>"</span>
                      </div>
                      <div class="tw-ml-4 tw-flex-shrink-0">
                        <a href="<%= holiday_path(@block.holiday) %>" class="tw-font-medium tw-text-indigo-600 hover:tw-text-indigo-500">Feiertag anzeigen</a>
                      </div>
                    </li>
                  <% end %>

                  <% if @block.has_pause %>
                    <li class="tw-flex tw-items-center tw-justify-between tw-py-3 tw-pl-3 tw-pr-4 tw-text-sm">
                      <div class="tw-flex tw-w-0 tw-flex-1 tw-items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.563C9 9.252 9.252 9 9.563 9h4.874c.311 0 .563.252.563.563v4.874c0 .311-.252.563-.563.563H9.564A.562.562 0 019 14.437V9.564z" />
                        </svg>
                        <span class="tw-ml-2 tw-w-0 tw-flex-1 tw-truncate">Block fällt auf eine Pause</span>
                      </div>
                      <div class="tw-ml-4 tw-flex-shrink-0">
                        <a href="<%= working_hour_path(@block.working_hour) %>" class="tw-font-medium tw-text-indigo-600 hover:tw-text-indigo-500">Arbeitszeiten anzeigen</a>
                      </div>
                    </li>
                  <% end %>
              <% end %>
            </dd>
          </div>

          <% if params[:show_block] %>
            <div class="tw-py-4 sm:tw-grid sm:tw-grid-cols-3 sm:tw-gap-4 sm:tw-py-5 sm:tw-px-6">
              <dt class="tw-text-sm tw-font-medium tw-text-gray-500">Block</dt>
              <dd class="tw-mt-1 tw-text-sm tw-text-gray-900 sm:tw-col-span-2 sm:tw-mt-0 text-muted"><%= @block.inspect %></dd>
            </div>
          <% end %>


        </dl>
      </div>
    </div>
  </div>



      <%= render CardComponent.new do |card| %>
        <%= card.with_header do |header| %>

        <% end %>

        <%= card.with_body do %>
          <% GroupBlock.new(@block.user.group).for_blocks(UserBlock.for_day(@block.start_time)).user_block_groups.each do |user_id, block_groups| %>
            <% next if user_id != @block.user.id %>

            <% user = User.find(user_id) %>

            <%= render partial: "users/user_day_plan", locals: { user: user, block_groups: block_groups, current_block: @block } %>
          <% end %>

        <% end %>

      <% end %>

</div>

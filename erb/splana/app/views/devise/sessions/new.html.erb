<% content_for :page_title, "Login" %>

<div class="container-fluid">
  <div class="row align-items-center justify-content-center">
    <div class="col-12 col-md-5 col-lg-6 col-xl-4 px-lg-6 my-5">
      <img src="<%= image_path("splana_logo_green.png") %>" class="navbar-brand-img mx-auto !tw-max-h-16" alt="Splana">

      <p class="text-muted text-center mb-5">Alabor Auftragsplaner</p>

      <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <h2 class="text-center">Login</h2>

        <%= f.error_notification %>

        <%= f.input :email, required: true, autofocus: true, label: "E-Mail", placeholder: "E-Mail", input_html: { class: "form-control" } %>

        <div class="form-group">
          <div class="row">
            <div class="col"><label>Password</label></div>
            <div class="col-auto">
              <%= link_to new_password_path(resource_name), class: "form-text small text-muted" do %><i class="fe fe-lock"></i> Passwort vergessen? <% end %>
            </div>
          </div>

          <%= f.input :password, required: true, label: false, placeholder: "Passwort", input_html: { class: "form-control" } %>
        </div>

        <%= f.submit "Log in", class: "btn btn-lg btn-block btn-primary mb-3" %>
      <% end %>

    </div>
    <div class="col-12 col-md-7 col-lg-6 col-xl-8 d-none d-lg-block">
      <div class="bg-cover vh-100 mt--1 mr--3" style="background-image: url(<%= random_header %>);"></div>
    </div>
  </div>
</div>

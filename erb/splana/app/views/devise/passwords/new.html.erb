<% content_for :page_title, "Passwort vergessen" %>

<div class="container-fluid">
  <div class="row align-items-center justify-content-center">
    <div class="col-12 col-md-5 col-lg-6 col-xl-4 px-lg-6 my-5">
      <img src="<%= image_path("splana_logo_green.png") %>" class="navbar-brand-img mx-auto !tw-max-h-16" alt="Splana">

      <p class="text-muted text-center mb-5">Alabor Auftragsplaner</p>

      <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, id: "loginform"} ) do |f| %>
        <h2 class="text-center">Passwort vergessen</h2>

        <%= f.error_notification %>

        <div class="form-group m-t-40">
          <div class="col-auto">
            <%= f.input :email, required: true, autofocus: true, placeholder: "E-Mail", input_html: { class: "form-control tw-mt-2" } %>
          </div>
        </div>

        <div class="form-group m-t-40">
          <div class="col-xs-12">
            <%= f.submit "Passwort zurücksetzten", class: "btn btn-lg btn-block btn-primary mb-3", id: "login-button" %>
          </div>
        </div>

        <%= link_to new_session_path(resource_name), class: "form-text small text-muted tw-mb-12" do %><i class="fe fe-arrow-left"></i> Zurück zum Login <% end %>
      <% end %>

    </div>
    <div class="col-12 col-md-7 col-lg-6 col-xl-8 d-none d-lg-block">
      <div class="bg-cover vh-100 mt--1 mr--3" style="background-image: url(<%= random_header %>);"></div>
    </div>
  </div>
</div>

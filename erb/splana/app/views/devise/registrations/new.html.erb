<% content_for :page_title, 'Login' %>

<%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "form-horizontal form-material", id: "loginform"}) do |f| %>
  <a class="text-center db"><%= image_tag asset_path("splana_logo_green.png") %></a>

  <h2 class="m-t-40 text-center">Registrieren - Auftragsplaner</h2>

  <%= f.error_notification %>

  <div class="form-group m-t-40">
    <div class="col-xs-12">
      <%= f.input :email, required: false, autofocus: true, label: false, placeholder: "E-Mail", input_html: { class: "form-control" } %>
    </div>
  </div>

  <div class="form-group">
    <div class="col-xs-12">
      <%= f.input :password, required: true, label: false, placeholder: "Passwort", hint: ("mindestens #{@minimum_password_length} Zeichen" if @minimum_password_length), input_html: { class: "form-control" } %>
    </div>
  </div>

  <div class="form-group">
    <div class="col-xs-12">
      <%= f.input :password_confirmation, required: true, label: false, placeholder: "Passwort wiederholen", input_html: { class: "form-control" } %>
    </div>
  </div>

  <div class="form-group">
    <div class="col-md-12">
      <%= link_to new_session_path(resource_name), class: "text-dark pull-right" do %><i class="fa fa-sign-in m-r-5"></i> Hast du breits ein Login? <% end %>
    </div>
  </div>

  <div class="form-group text-center m-t-40">
    <div class="col-xs-12">
      <%= f.submit "Sign up", class: "btn btn-info btn-block text-uppercase waves-effect waves-light login-button", id: "login-button" %>
    </div>
  </div>

<% end %>

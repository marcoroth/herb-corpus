<% content_for :page_title, "Tagesplan #{I18n.t("date.day_names")[@date.wday]}, #{@date.to_fs(:default)}" %>
<% content_for :page_subtitle, "" %>

<div class="container-fluid">
  <%= render PageHeaderComponent.new %>

  <%= render CardComponent.new do |card| %>
    <% card.with_header do |header| %>
      <% header.with_title { yield(:page_title) } %>
      <% header.with_button do %>
        <%= link_to "Heute", day_plan_groups_path(start_date: Date.current), class: "btn btn-sm btn-white tw-mr-3" %>

        <%= link_to %(<i class="fa fa-arrow-left"></i>).html_safe, day_plan_groups_path(start_date: @previous_date), class: "btn btn-sm btn-white" %>
        <%= link_to %(<i class="fa fa-arrow-right"></i>).html_safe, day_plan_groups_path(start_date: @next_date), class: "btn btn-sm btn-white" %>
      <% end %>
    <% end %>

    <% card.with_body do %>
      <% @groups.in_groups_of(6) do |groups| %>
        <div class="tw-grid tw-grid-cols-[repeat(6,1fr)]  tw-place-items-stretch tw-gap-y-3 tw-gap-x-3 tw-mt-12">

          <% groups.each do |group| %>
            <% if group %>
              <a href="<%= day_plan_for_group_path(group, start_date: @date) %>" class="tw-border tw-border-gray-300 tw-text-center tw-bg-white">
                <b><%= group&.group_leader&.lastname %></b><br/>
                <%= (group.users - [group.group_leader]).map(&:lastname).join(", ") %>
              </a>
            <% else %>
              <div></div>
            <% end %>
          <% end %>

          <% groups.compact.each do |group| %>
            <%= render partial: "groups/grouped_group_day", locals: { date: @date, group: group } %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>

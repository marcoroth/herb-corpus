<div class="col-12 col-xl-8">
  <h3 class="text-muted">Termine Diese Woche</h3>

  <% appointments = Appointment.distinct.joins(:users).where(start_time: (Time.current + 1.year).all_year, users: @group.users).order(start_time: :asc) %>

  <% appointments.each do |appointment| %>
    <%= render AppointmentCardComponent.new(appointment: appointment) %>
  <% end %>

  <% if appointments.count.zero? %>
    <%= render CardComponent.new do |card| %>
      <%= card.with_body do %>
        <p class="card-text">Keine Termine diese Woche</p>
      <% end %>
    <% end %>
  <% end %>
</div>

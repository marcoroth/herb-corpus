<% content_for :page_title, "Neue #{Group.translated_name} erfassen" %>
<% content_for :page_subtitle, Group.translated_name_plural %>

<div class="container-fluid mt--6">
  <%= render PageHeaderComponent.new %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_body do %>
      <%= render "form", group: @group %>
    <% end %>
  <% end %>
</div>

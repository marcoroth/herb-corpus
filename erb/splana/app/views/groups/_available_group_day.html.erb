<% min_height ||= "150px" %>

<div class="" style="min-height: <%= min_height %>">
  <% range = date.all_day %>
  <% blocks = UserBlock.in_steps_of(15.minutes).in_blocks_of(2.hours).this_day(date).for_user(group.users.first).where(has_working_hour: true, has_pause: false).order(start_time: :asc) %>

  <% appointments = group ? Appointment.where(id: blocks.pluck(:appointment_id).compact.uniq) : [] %>
  <% grouped = blocks.chunk_while { |i, j| i.block_hash == j.block_hash }.to_a %>
  <% available_grouped = blocks.chunk_while { |i, j| i.available == j.available }.to_a %>

  <div <% if (grouped.length == 1 && grouped.first.first.available) %><% end %> class="tw-flex tw-flex-col tw-items-stretch tw-h-full tw-gap-2">
    <% grouped.each do |parts| %>
      <% if parts.first.appointment_id %>
        <% appointment = parts.first.appointment %>
        <% conflict = UserBlock.this_day(date).exists?(appointment_id: appointment.id, has_conflict: true) %>

        <%= link_to appointment, class: "tw-h-full #{"tw-bg-gray-100 hover:tw-bg-gray-200 tw-border-gray-500" } hover:tw-text-inherit tw-border-l-4 tw-p-3 tw-w-full tw-content-center" do %>
          <div>
            <%= "#{parts.first.start_time.to_fs(:time)} bis #{parts.last.end_time.to_fs(:time)}" %><br/>
          </div>
        <% end %>
      <% else %>
        <% if parts.first.available %>
          <%= link_to new_appointment_path(group_id: group.id, start_time: parts.first.start_time, end_time: parts.last.end_time), class: "tw-bg-green-100 hover:tw-bg-green-200 hover:tw-text-inherit tw-border-l-4 tw-border-green-500 tw-p-3 tw-h-full tw-grid tw-content-center" do %>
            <div data-bs-toggle="tooltip" data-bs-title="Klicke um Termin zu ertellen">
              <%= "#{parts.first.start_time.to_fs(:time)} bis #{parts.last.end_time.to_fs(:time)}" %><br/>
              <% if false %>Verfügbar (<%= ActiveSupport::Duration.build(parts.last.end_time - parts.first.start_time).in_hours %> h)<% end %>
            </div>
          <% end %>
        <% else %>

          <% if appointments.any? && !parts.first.available %>
            <div class="tw-bg-gray-100 hover:tw-bg-gray-200 tw-border-l-4 tw-border-gray-500 hover:tw-text-inherit tw-p-3 tw-w-full" data-bs-toggle="tooltip" data-bs-title="Klicke um Termin zu ertellen">
              <%= link_to "#{parts.first.start_time.to_fs(:time)} bis #{parts.last.end_time.to_fs(:time)} Keine Verfügbarkeit", new_appointment_path(group_id: group.id, start_time: parts.first.start_time, end_time: parts.last.end_time) %>
            </div>
          <% end %>

        <% end %>
      <% end %>
    <% end %>

    <% if appointments.none? %>
      <% if available_grouped.length == 1 && !available_grouped.first.first.available %>
        <div class="tw-bg-gray-100 hover:tw-bg-gray-200 tw-border-l-4 tw-border-gray-500 hover:tw-text-inherit tw-p-3 tw-w-full tw-h-full tw-text-center tw-grid tw-content-center" data-bs-toggle="tooltip" data-bs-title="Klicke um Termin zu ertellen">
          <%= link_to "Keine Verfügbarkeit", new_appointment_path(group_id: group.id, start_time: blocks.first.start_time, end_time: blocks.last.end_time) %>
        </div>
      <% end %>
    <% end %>

    <% if blocks.none? %>
      <div class="tw-bg-red-50 hover:tw-text-inherit tw-p-3 tw-w-full tw-h-full tw-border-b tw-border-black tw-text-center tw-grid tw-content-center" data-bs-toggle="tooltip" data-bs-title="Klicke um Termin zu ertellen">
        <%= link_to "Keine Verfügbarkeit", new_appointment_path(group_id: group.id, start_date: date) %>
      </div>
    <% end %>
  </div>
</div>

<div class="col-12 <% unless action_name == "info" %> col-xl-4 tw-hidden lg:tw-block <% end %>">
  <%= render CardListComponent.new do |list| %>
    <%= list.with_item(title: "Anazhl Mitarbeiter", value: @group.users.count) %>
    <%= list.with_item(title: "Erstellt am", value: @group.created_at.to_fs(:default)) %>
    <%= list.with_item(title: "Gruppen-Farbe", value: %(<div style="height: 20px; width: 20px; background: #{@group.color}; color: #{@group.color}>; border: 1px solid black;">A</div>).html_safe) %>
    <%= list.with_item(title: "Gruppen-Leiter", value: link_to(@group.group_leader&.name, user_path(@group.group_leader), class: "small")) %>
    <%= list.with_item(title: "Bauleiter/in", value: link_to(@group.leader&.name, user_path(@group.leader), class: "small"), separator: false) %>
  <% end %>
</div>

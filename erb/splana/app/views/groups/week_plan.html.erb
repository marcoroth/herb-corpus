<% content_for :page_title, "Wochenplan KW#{@date.cweek} #{@date.year}" %>
<% content_for :page_subtitle, "" %>

<div class="container-fluid">
  <%= render PageHeaderComponent.new %>

  <%= render CardComponent.new do |card| %>
    <% card.with_header do |header| %>
      <% header.with_title { yield(:page_title) } %>
      <% header.with_button do %>
        <%= link_to "Heute", week_plan_groups_path(start_date: Date.current), class: "btn btn-sm btn-white tw-mr-3" %>

        <%= link_to %(<i class="fa fa-arrow-left"></i>).html_safe, week_plan_groups_path(start_date: @previous_date), class: "btn btn-sm btn-white" %>
        <%= link_to %(<i class="fa fa-arrow-right"></i>).html_safe, week_plan_groups_path(start_date: @next_date), class: "btn btn-sm btn-white" %>
      <% end %>
    <% end %>

    <% card.with_body do %>
      <div class="tw-grid tw-mt-6 tw-gap-x-2" style="grid-template-columns: 50px repeat(<%= @groups.length %>, 150px)">

        <div class="tw-border tw-sticky tw-top-0 tw-bg-white tw-gray-300 tw-text-center tw-py-3 tw-px-3 tw-mb-2 tw-bg-white tw-z-50">KW<%= @date.cweek %></div>

        <% @groups.each do |group| %>
          <a href="<%= week_plan_for_group_path(group, start_date: @date) %>)" class="tw-border tw-sticky tw-top-0 tw-border-gray-300 tw-text-center tw-py-3 tw-px-3 tw-mb-2 tw-bg-white hover:tw-bg-gray-100 hover:tw-text-inherit tw-z-50">
            <b><%= group.group_leader.lastname %></b><br/>
            <%= (group.users - [group.group_leader]).map(&:lastname).join(", ") %>
          </a>
        <% end %>

        <% (@date.beginning_of_week..@date.end_of_week).each do |date| %>
          <div class="tw-border tw-border-gray-300">
            <a href="<%= day_plan_groups_path(start_date: date) %>" class="tw-flex tw-text-center tw-w-full tw-h-full tw-justify-center tw-items-center" style="transform: rotate(270deg)">
              <%= I18n.t("date.day_names")[date.wday] %> <%= date.day %>.<%= date.month %>
            </a>
          </div>

          <% @groups.each do |group| %>
            <%= render partial: "groups/grouped_group_day", locals: { date: date, group: group } %>
          <% end %>

          <div class="tw-h-3"></div>

          <% @groups.each do |group| %>
            <div class="tw-h-3"></div>
          <% end %>
        <% end %>


      </div>
    <% end %>
  <% end %>
</div>

<div class="container-fluid">
  <%= render PageHeaderComponent.new(title: @group, button_text: "Bearbeiten", button_url: edit_group_path(@group)) do |header| %>
    <%= header.with_avatar_group(users: @group.users, size: '') %>

    <%= header.with_tab_list do |tabs| %>
      <%= tabs.with_tab(name: "Übersicht", url: group_path(@group), active: :exclusive) %>
      <%= tabs.with_tab(name: "Termine", url: appointments_group_path(@group)) %>
      <%= tabs.with_tab(name: "Mitglieder", url: users_group_path(@group)) %>
      <%= tabs.with_tab(name: "Kalender", url: calendar_group_path(@group)) %>
      <%= tabs.with_tab(name: "Tagesplan", url: day_plan_for_group_path(@group)) %>
      <%= tabs.with_tab(name: "Wochenplan", url: week_plan_for_group_path(@group)) %>
      <%= tabs.with_tab(name: "Daueraufträge", url: recurring_orders_group_path(@group)) %>
      <%= tabs.with_tab(name: "Einzelaufträge", url: orders_group_path(@group)) %>
      <%= tabs.with_tab(name: "Konflikte", url: conflicts_group_path(@group)) %>
    <% end %>
  <% end %>
</div>

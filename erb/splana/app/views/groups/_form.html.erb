<%= simple_form_for(@group) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs" data-controller="group">
    <%= f.association :users, label: "Gruppen-Mitglieder", collection: Employee.pool_or_group(@group).order(lastname: :asc), input_html: { data: { action: "change->group#changed" } } %>
    <%= f.association :group_leader, label: "Gruppen-Leiter/in", collection: @group.users, input_html: { data: { group_target: "groupLeader", action: "change->group#updateGroupName" } } %>
    <%= f.input :name, label: "Gruppen-Name", input_html: { data: { group_target: "name" } } %>
    <%= f.association :leader, label: "Bauleiter/in", collection: Leader.all.order(lastname: :asc), input_html: { data: { action: "change->group#add" } } %>
  </div>

  <div class="form-actions tw-mb-6">
    <%= f.button :submit, class: "btn btn-primary" %>
    <%= link_to "Abbrechen", groups_path, class: "btn btn-secondary" %>
  </div>
<% end %>

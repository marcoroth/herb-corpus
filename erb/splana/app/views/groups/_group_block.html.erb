<% block = blocks.first %>

<div
  style="min-height: <%= group_start_time.blocks.count * (blocks.first.has_working_hour ? 10 : 2) %>px"
  class="
  tw-h-full

  tw-grid tw-h tw-border-l-8 tw-truncate tw-text-ellipsis tw-py-1 tw-px-2

  tw-mb-2

  <% if block.appointment_id && block.has_conflict? %>
    tw-bg-red-100 hover:tw-bg-red-200 tw-border-l-red-500 tw-border-red-300 tw-text-red-500
  <% elsif block.holiday_id %>
    tw-bg-purple-100 hover:tw-bg-purple-200 tw-border-l-purple-500 tw-border-purple-300
  <% elsif block.has_conflict? %>
    tw-bg-red-100 hover:tw-bg-red-200 tw-border-l-red-500 tw-border-red-300
  <% elsif block.available %>
    tw-bg-green-100 hover:tw-bg-green-200 tw-border-l-green-500 tw-border-green-300
  <% elsif block.appointment_id %>
    tw-bg-blue-100 hover:tw-bg-blue-200 tw-border-l-blue-500 tw-border-blue-300
  <% elsif !block.available %>
    tw-bg-gray-100 hover:tw-bg-gray-200 tw-border-l-gray-500 tw-border-gray-300
  <% else %>
    tw-bg-gray-100 hover:tw-bg-gray-200 tw-border-l-gray-500 tw-border-gray-300
  <% end %>
">
  <span>
    <%= group_start_time.start_time.to_fs(:time) %> -
    <%= group_start_time.end_time.to_fs(:time) %>
  </span>

  <div class="">
    <%= render partial: "block", locals: { block: block } %>
  </div>
</div>

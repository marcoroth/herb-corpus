<% blocks ||= [block] %>

<% if block.available? %>
  <%= link_to "Verfügbar", user_block_path(block_id_from_blocks(blocks)) %>

<% elsif block.appointment_id && block.has_conflict %>
  <%= link_to "Termin: #{block.appointment.name} (Konflikt)", user_block_path(block.appointment.user_block_id(block.user)) %>

<% elsif block.has_conflict %>
  <%= link_to block.conflicts_text, user_block_path(block_id_from_blocks(blocks)) %>

<% elsif block.holiday_id %>
  <%= link_to "#{block.holiday.holiday_type}: #{block.holiday.name}", user_block_path(block_id_from_blocks(blocks)) %>

<% elsif block.has_pause %>
  <%= link_to "Pause", user_block_path(block_id_from_blocks(blocks)) %>

<% elsif block.absence_id && !block.has_working_hour %>
  <%= link_to "Ausserhalb Arbeitszeit", user_block_path(block_id_from_blocks(blocks)) %>

<% elsif block.absence_id %>
  <%= link_to "Absenz: #{block.absence.name}", user_block_path(block.absence.user_block_id) %>

<% elsif !block.has_working_hour %>
  <%= link_to "Ausserhalb Arbeitszeit", user_block_path(block_id_from_blocks(blocks)) %>

<% elsif block.weekend %>
  <%= link_to "Wochenende", user_block_path(block_id_from_blocks(blocks)) %>

<% elsif !block.has_user_availability %>
  <%= link_to "Keine Verfügbarkeit", user_block_path(block_id_from_blocks(blocks)) %>

<% elsif block.appointment_id %>
  <%= link_to "Termin: #{block.appointment.name}", user_block_path(block.appointment.user_block_id(block.user)) %>

<% else %>
  <%= link_to "Nicht verfügbar", user_block_path(block_id_from_blocks(blocks)) %>
<% end %>

<% if block.has_conflict? %>
  <i class="fa fa-triangle-exclamation tw-text-red-500 tw-text-right" data-bs-toggle="tooltip" data-bs-title="<%= block.conflicts_text %>"></i>
<% elsif block.reasons_raw.count > 1 %>
  <i class="fa fa-info-circle tw-text-gray-500 tw-text-right" data-bs-toggle="tooltip" data-bs-title="<%= block.text %>"></i>
<% end %>

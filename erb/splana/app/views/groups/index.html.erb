<% content_for :page_title, "#{Group.translated_name}" %>
<% content_for :page_subtitle, "Alle" %>

<div class="container tw-pb-24">
  <% if @pool.any? %>
    <%= render PageHeaderComponent.new(title: "Gruppen", button_text: "Neue Gruppe", button_url: new_group_path) %>
  <% else %>
    <%= render PageHeaderComponent.new(title: "Gruppen") %>
  <% end %>

  <h2 class="tw-text-lg tw-mt-6 tw-font-bold tw-leading-7 tw-text-gray-900 sm:tw-truncate sm:tw-text-xl sm:tw-tracking-tight">Mitarbeiter-Pool</h2>

  <div class="tw-grid tw-grid-cols-2 md:tw-grid-cols-3 tw-gap-6 tw-mb-12">
    <% @pool.each do |user| %>
      <%= render UserCardComponent.new(user: user) %>
    <% end %>

    <% if @pool.none? %>
      <%= render CardComponent.new(classes: "tw-p-6") do |card| %>
        <%= card.with_card_content do %>
          <h3 class="tw-mt-2 tw-text-sm tw-font-medium tw-text-gray-900">Keine Mitarbeiter im Pool, da alle bereits einer Gruppe zugeordnet sind.</h3>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <h2 class="tw-text-lg tw-mt-6 tw-font-bold tw-leading-7 tw-text-gray-900 sm:tw-truncate sm:tw-text-xl sm:tw-tracking-tight">Gruppen</h2>

  <div class="tw-grid tw-grid-cols-1 md:tw-grid-cols-2 tw-gap-6 tw-mb-24">
    <% @groups.each do |group| %>
      <%= render GroupCardComponent.new(group: group) %>
    <% end %>
  </div>
</div>

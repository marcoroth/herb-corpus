<div class="col-md-12">
  <div class="white-box">
    <div class="row el-element-overlay m-b-40">
      <div class="col-md-12">
        <h2><%= @holiday.name %></h2><hr>

        <p>
          <strong>Name:</strong>
          <%= @holiday.name %>
        </p>

        <p>
          <strong>Start time:</strong>
          <%= @holiday.start_time %>
        </p>

        <p>
          <strong>End time:</strong>
          <%= @holiday.end_time %>
        </p>

        <p>
          <strong>Type:</strong>
          <%= @holiday.holiday_type %>
        </p>

        <%= link_to 'Edit', edit_holiday_path(@holiday) %> |
        <%= link_to 'Back', holidays_path %>
      </div>
    </div>
  </div>
</div>

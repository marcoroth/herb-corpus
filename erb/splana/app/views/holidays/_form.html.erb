<%= simple_form_for(@holiday) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs" data-controller="holiday">
    <%= f.input :name %>
    <div class="tw-grid md:tw-grid-cols-2">
      <div class="md:tw-mr-6">
        <%= f.input :start_time, label: "Von", input_html: { data: { holiday_target: "from" } } %>
      </div>
      <%= f.input :end_time, label: "Bis", input_html: { data: { holiday_target: "to" } } %>
    </div>
    <%= f.input :holiday_type, label: "Art", collection: ["Feiertag", "Ausflug", "Betriebsfrei"] %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, class: "btn btn-primary" %>
    <%= link_to "Abbrechen", holidays_path, class: "btn btn-secondary" %>
  </div>
<% end %>

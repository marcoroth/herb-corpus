<% content_for :page_title, "Feiertage" %>
<% content_for :page_subtitle, "Alle" %>

<div class="container-fluid mt--6">
  <%= render PageHeaderComponent.new do |header| %>
    <%= header.with_button(text: "Feiertage importieren", url: import_holidays_path, classes: "btn btn-secondary") %>
    <%= header.with_button(text: "Feiertage erfassen", url: new_holiday_path) %>
  <% end %>

  <% if @holidays.length.zero? %>
    <%= render CardComponent.new do |card| %>
      <%= card.with_header do |header| %>
        <%= header.with_title { "Keine Feiertage erfasst" } %>
      <% end %>
    <% end %>
  <% end %>

  <% @holidays.each do |year, holidays| %>
    <%= render CardComponent.new do |card| %>
      <%= card.with_header do |header| %>
        <%= header.with_title { "Feiertage #{year}" } %>
      <% end %>

      <%= card.with_card_content do %>
        <%= render CardTableComponent.new do |table| %>
          <%= table.with_header { "Name" } %>
          <%= table.with_header { "Datum" } %>
          <%= table.with_header { "Art" } %>
          <%= table.with_header { "Aktionen" } %>

          <% holidays.each do |holiday| %>
            <%= table.with_row do |row| %>
              <%= row.with_cell { link_to holiday, edit_holiday_path(holiday) } %>
              <%= row.with_cell { link_to holiday.time_text } %>
              <%= row.with_cell { link_to holiday.holiday_type } %>

              <%= row.with_cell do %>
                <%= render DropdownComponent.new do |dropdown| %>
                  <% dropdown.with_item { link_to "Anzeigen", edit_holiday_path(holiday) } %>
                  <% dropdown.with_item { link_to "Bearbeiten", edit_holiday_path(holiday) } %>
                  <% dropdown.with_item { link_to "Löschen", holiday, data: { turbo_confirm: "Bist du sicher, dass du den Feiertag '#{holiday.name}' löschen willst?", turbo_method: "delete" } } %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>

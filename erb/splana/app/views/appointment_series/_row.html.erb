<div class="tw-sticky tw-left-0 tw-bg-white tw-border tw-border-black tw-w-full tw-text-xs tw-grid tw-content-center tw-px-2">
  <%= link_to series.name, edit_appointment_series_path(series) %>
</div>

<div class="tw-border tw-border-black tw-h-[30px] tw-w-full tw-text-xs tw-grid tw-content-center tw-bg-white tw-px-2 hover:tw-bg-gray-100" %>
  <%= link_to "Terminserie", appointment_series_path(series) %>
</div>

<div class="tw-border tw-border-black tw-h-[30px] tw-w-full tw-text-xs tw-grid tw-content-center tw-bg-white tw-px-2 hover:tw-bg-gray-100" %>
  <%= series.description_text || "ungeplant" %>
</div>

<div class="tw-border tw-border-black tw-h-[30px] tw-w-full tw-text-xs tw-grid tw-content-center tw-bg-white tw-px-2 hover:tw-bg-gray-100" %>
  <%= series.appointments.map { |a| a.user_blocks.where(has_conflict: true).count.positive? }.count { |x| x == true } %> Konflikte
</div>

<% if series.appointments.any? %>
  <% 12.times do |i| %>
    <% appointments = series.appointments.where(start_time: (series.recurring_order_execution.start_date + i.months).to_time.all_month).to_a %>
    <div data-bs-toggle="tooltip" data-bs-title="<%= appointments.count.positive? ? "#{appointments.count} geplant / #{appointments.count} vorgeplant" : "-" %>" class="tw-border tw-border-black tw-h-[30px] tw-w-full tw-text-center tw-text-xs tw-grid tw-content-center <%= appointments.map { |a| a.user_blocks.map(&:has_conflict) }.flatten.reduce(:&) ? "tw-bg-red-300 hover:tw-bg-red-200" : "tw-bg-white hover:tw-bg-gray-100" %>">
      <%= appointments.count.positive? ? "#{appointments.count} / #{appointments.count}" : "-" %>
    </div>
  <% end %>

<% else %>
  <div class="tw-col-start-[5] tw-col-end-[17] tw-border tw-border-black tw-h-[30px] tw-w-full tw-text-center tw-text-xs tw-grid tw-content-center tw-bg-white hover:tw-bg-gray-100">
    <%= link_to "Ungeplant, jetzt Termine einplanen", edit_appointment_series_path(series) %>
  </div>
<% end %>

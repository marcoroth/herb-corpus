<% content_for :page_title, "Neue Termin-Serie in #{@series.start_date.year} planen" %>
<% content_for :page_subtitle, "Daueraufträge" %>

<div class="container-fluid mt--6" data-controller="appointment-series">
  <%= render PageHeaderComponent.new %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_body do %>
      <%= simple_form_for(@series) do |f| %>
        <%= f.error_notification %>

        <%= f.input :recurring_order_execution_id, as: :hidden %>

        <h3 class="tw-mt-6">Neue Termin-Serie in <%= @series.start_date.year %></h3>

        <div class="row">
          <div class="col-md-12">
            <%= f.input :name, label: "Serienname oder Tätigkeit" %>
          </div>
        </div>


        <div class="row">
          <div class="col-md-6">
            <%= f.input :needed_workers, as: :integer, label: "Benötige Mitarbeiter" %>
          </div>

          <div class="col-md-6">
            <%= f.input :duration, as: :float, label: "Regelaufwand in Stunden pro Termin", input_html: { step: 0.25, default: "2", min: "0.25", max: "9.0" }  %>
          </div>
        </div>

        <fieldset class="tw-mb-6" style="display: none">
          <legend class="tw-text-base tw-font-medium tw-text-gray-900">Serientyp</legend>

          <div class="tw-mt-4 tw-grid tw-grid-cols-2 tw-gap-y-6 lg:tw-grid-cols-4 tw-gap-4" data-action="click->appointment-series#changeType">
            <% [
                ["interval", "Anzahl Termine pro Interval", ["1x alle 2 Wochen", "2x jeden 2. Monat"]],
                ["per_year", "Anzahl Termine pro Jahr", ["15x pro Jahr", "3x im Winter", "1x in Mai, 2x in Juni, 2x in August, 1x in September"]],
                ["hours_per_year", "Aufwand pro Jahr", ["20h pro Jahr"]],
                ["variable", "Manuell", ["auf Abruf", "fortlaufend planend"]],
              ].each do |id, one, two| %>

            <label class="tw-relative tw-flex tw-cursor-pointer tw-rounded-lg tw-border tw-bg-white tw-p-4 tw-shadow-sm focus:tw-outline-none">
              <span class="tw-flex tw-flex-1">
                <span class="tw-flex tw-flex-col">
                  <span id="series_type-<%= id %>-label" class="tw-block tw-text-sm tw-font-medium tw-text-gray-900"><%= one %></span>
                  <span id="series_type-<%= id %>-description" class="tw-mt-1 tw-flex tw-items-center tw-text-sm tw-text-gray-500">
                    <span>

                      <% two.each do |o| %>
                        <span class=" tw-block tw-mb-3">
                          <%= "oder" if o != two.first %>
                          <%= "z.B." if o == two.first %>
                          <b class="tw-mt-3"><%= o %></b>
                        </span>
                      <% end %>
                    </span>
                  </span>
                </span>
              </span>

              <input type="radio" data-appointment-series-target="seriesType" name="series_type" value="<%= id %>" class="tw-hidden" id="series_type-<%= id %>">
            </label>
            <% end %>
          </div>
        </fieldset>

        <div class="row tw-hidden" data-series-type="interval">
          <div class="col-md-6">
            <%= f.input :appointments_per_interval, as: :integer, label: "Anzahl Termine pro Interval", input_html: { default: 1 }  %>
          </div>

          <div class="col-md-6">
            <%= f.input :interval, label: "Interval", collection: [["", nil], ["Jede Woche", "P7D"], ["Jede 2. Woche", "P14D"], ["Jede 3. Woche", "P21D"], ["Jede 4. Woche", "P28D"], ["Jede 5. Woche", "P35D"], ["Jede 6. Woche", "P42D"], ["Jede 7. Woche", "P49D"], ["Jede 8. Woche", "P56D"]]  %>
          </div>
        </div>

        <div class="row tw-hidden" data-series-type="per_year">
          <div class="col-md-12">
            <%= f.input :appointments_per_year, as: :float, label: "Anzahl Termine pro Jahr", input_html: { step: 0.25, default: "2", min: "0.25", max: "9.0" }  %>
          </div>
        </div>

        <div class="row tw-hidden" data-series-type="hours_per_year">
          <div class="col-md-12">
            <%= f.input :hours_per_year, as: :float, label: "Aufwand in Stunden pro Jahr", input_html: { step: 0.25, default: "2", min: "0.25", max: "9.0" }  %>
          </div>

        </div>

        <div class="row tw-hidden" data-series-type="variable">
        </div>

        <div>
          <%= f.input :details, as: :text, value: "", label: "Details/Notizen für die Terminplanung" %>
        </div>

        <div class="form-actions tw-mt-6">
          <%= f.button :submit, class: "btn btn-primary", id: "submit-button" %>
          <%= link_to "Zurück", @series.recurring_order_execution, class: "btn btn-secondary" %>
        </div>

      <% end %>
    <% end %>
  <% end %>
</div>

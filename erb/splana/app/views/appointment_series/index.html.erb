<% content_for :page_title, "Terminserien" %>
<% content_for :page_subtitle, "Alle" %>

<div class="container-fluid mt--6">
  <%= render PageHeaderComponent.new %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_header do |header| %>
      <%= header.with_title { "Terminserien" } %>
    <% end %>

    <%= card.with_card_content do %>
      <%= render CardTableComponent.new do |table| %>
        <%= table.with_header { "ID" } %>
        <%= table.with_header { "Name" } %>
        <%= table.with_header { "Dauerauftrag" } %>
        <%= table.with_header { "Ausführung" } %>
        <%= table.with_header { "Anzahl Termine" } %>
        <%= table.with_header { "Aktionen" } %>

        <% @series.each do |series| %>
          <%= table.with_row do |row| %>
            <%= row.with_cell { link_to series.id, series } %>
            <%= row.with_cell { link_to series, appointment_series_path(series) } %>
            <%= row.with_cell { link_to series.recurring_order, series.recurring_order } %>
            <%= row.with_cell { link_to series.recurring_order_execution, series.recurring_order_execution } %>
            <%= row.with_cell { series.appointments.count.to_s } %>

            <%= row.with_cell do %>
              <%= render DropdownComponent.new do |dropdown| %>
                <% dropdown.with_item { link_to "Anzeigen", appointment_series_path(series) } %>
                <% dropdown.with_item { link_to "Neue Termine in dieser Serie generieren", edit_appointment_series_path(series) } %>
                <% dropdown.with_item { link_to "Löschen", series, data: { turbo_confirm: "Willst du die Terminserie '#{series.name}' wirklich löschen?", turbo_method: "delete" } } %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

    <% end %>
  <% end %>
</div>

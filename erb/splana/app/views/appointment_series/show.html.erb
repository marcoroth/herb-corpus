<% content_for :page_title, "Terminserie #{@series.name}" %>
<% content_for :page_subtitle, "Terminserien" %>

<div class="container-fluid mt--6">
  <%= render PageHeaderComponent.new(button_text: "Bearbeiten", button_url: edit_appointment_series_path(@series)) %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_body do %>

      <div id="<%= dom_id(@series) %>">
        <p>
          <strong>Name:</strong>
          <%= @series.name %>
        </p>

        <p>
          <strong>Reccurring order execution:</strong>
          <%= link_to @series.recurring_order_execution %>
        </p>

        <p>
          <strong>Appointments:</strong>
          <%= @series.appointments.count %>
        </p>
      </div>

      <div>
        <%= link_to "Löschen", appointment_series_path(@series), data: {turbo_method: "delete", turbo_confirm: "Bist du sicher?"} %> |
        <%= link_to "Bearbeiten", edit_appointment_series_path(@series) %> |
        <%= link_to "Zurück", appointment_series_index_path %>
      </div>

    <% end %>
  <% end %>

</div>

<%= simple_form_for(series) do |f| %>
  <%= f.error_notification %>

  <div class="row" data-controller="workload" data-workload-duration-value="<%= @series.duration.hours.in_blocks %>" data-workload-appointments-value="<%= @series.appointments_per_interval %>">
    <div class="col col-md-7">
      <% current_start_year = series.start_date.year %>
      <% roes = series.recurring_order.recurring_order_executions %>
      <% years = roes.map(&:start_date).map(&:year) %>

      <div class="tw-grid md:tw-grid-cols-[3fr_1fr] tw-gap-x-4">
        <%= f.input :name, label: "Serienname oder Tätigkeit" %>

        <div class="form-group string optional disabled appointment_series_duration">
          <b class="control-label string optional disabled">Dauer pro Termin</b>
          <div class="tw-mt-2"><%= @series.duration %>h</div>
        </div>

        <%#= f.input :duration, label: "Dauer pro Termin (in Stunden)", disabled: true %>
      </div>

      <div class="tw-grid md:tw-grid-cols-[2fr_2fr] tw-gap-x-4">
        <div>
          <b class="control-label string optional disabled">Details/Notes</b>
          <div class="tw-mt-2"><%= @series.details || "-" %></div>
        </div>

        <div>
          <b class="control-label string optional disabled">Termine pro Interval</b>
          <div class="tw-mt-2"><%= pluralize(@series.appointments_per_interval, "Termin", "Termine") %> alle <%= pluralize(@interval, "Woche", "Wochen") %></div>
        </div>
      </div>


      <%= f.input :recurring_order_execution_id, as: :hidden, input_html: { data: { workload_target: "execution" } } %>

      <% if false %>
        <div class="row">
          <% (current_start_year-2..current_start_year+1).each do |year| %>
          <% roe = roes.select { |r| r.start_date.year == year }.first %>
            <div class="col">
              <div class="card <% if years.include?(year) %> bg-success<% end %> <% if current_start_year == year %> bg-primary text-white <% end %>">
                <div class="card-body text-center">
                  <%= year %><br/>
                  <%= roe&.appointments&.count || 0 %> Termine
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <br/>
        <br/>
        <br/>
      <% end %>

      <div class="row">
        <div class="col-12" data-reflex-permanent>
          <div class="form-group check_boxes optional recurring_order_weeks">


            <div class="tw-grid tw-grid-cols-[1fr_2fr_2fr] tw-gap-4 tw-gap-y-6">
              <!-- <div class="tw-grid tw-grid-cols-2 tw-gap-x-4"> -->
                <div>
                  <b>Alle:</b>
                  <!-- <select class="" data-workload-target="interval" data-action="change->workload#selectWeeks" name="interval">
                    <%# numbers = (1..12) %>
                    <%# wochen = (1..12).map { |i| [pluralize(i, "Woche", "Wochen"), i] } %>
                    <%# monate = (1..4).map { |i| [pluralize(i, "Monat", "Monate"), i * 4] } %>
                    <%#= options_for_select(numbers, @interval) %>
                  </select> -->
                  <input type="number" min="1" max="12" value="<%= @interval || 1 %>" class="form-control"  data-workload-target="interval" data-action="change->workload#selectWeeks" name="interval">
                </div>

                <div class="tw-hidden">
                  <div>&nbsp;</div>
                  <select class="" data-workload-target="intervalType" data-action="change->workload#selectWeeks" name="type">
                    <%= options_for_select([['Woche/n', 1], ['Monat/e', 4]], @intervalType) %>
                  </select>
                </div>
              <!-- </div>

              <div class="tw-grid tw-grid-cols-2 tw-gap-x-4"> -->
                <div>
                  <b>ab Woche </b>
                  <select class="" data-workload-target="fromWeek" data-action="change->workload#selectWeeks" name="from">
                    <% @weeks.each do |week| %>
                      <option value="<%= week.iso8601 %>" data-year="<%= week.year %>" data-week="<%= week.cweek %>">
                        <%= calendar_week(week) %>
                      </option>
                    <% end %>
                  </select>
                </div>

                <div>
                  <b>bis Woche </b>
                  <select class="" data-workload-target="toWeek" data-action="change->workload#selectWeeks" name="to">
                    <% @weeks.each do |week| %>
                      <option value="<%= week.iso8601 %>" data-year="<%= week.year %>" data-week="<%= week.cweek %>" <% if week == @weeks.last %> selected <% end %>>
                        <%= calendar_week(week) %>
                      </option>
                    <% end %>
                  </select>
                </div>
              <!-- </div> -->
            </div>

            <div class="tw-mt-6 tw-grid tw-grid-cols-2 tw-mt-12">
              <div>
                <b>Kalenderwochen</b>

                <div class="tw-w-full">
                  <% @weeks.each do |week| %>
                    <span class="checkbox checkbox-success" data-toggle="tooltip" title="<%= calendar_week(week) %>, <%= week.all_week.first.to_date.to_fs(:default) %>">
                      <input
                        data-workload-target="week"
                        data-action="change->workload#saveData"
                        data-date="<%= week.iso8601 %>"
                        data-week-number="<%= week.cweek %>"
                        class="check_boxes optional recurring_order_weeks"
                        type="checkbox"
                        value="<%= week.beginning_of_week.iso8601 %>"
                        name="appointment_series[weeks][]"
                        id="recurring_order_weeks_<%= week.iso8601 %>"
                      >

                      <label for="recurring_order_weeks_<%= week.iso8601 %>"></label>
                    </span>

                    <% if @weeks.index(week) % 13 == 12 %><br><% end %>
                  <% end %>
                </div>

              </div>
              <div>
                <b>Block-Selektionsmodus</b>
                <div class="tw-grid tw-grid-cols-[20px,135px,20px,135px] tw-content-center">
                  <input class="tw-h-full" type="radio" checked data-action="click->workload#switchType" name="switch_type" id="switch_type_x" value="x">
                  <!-- <label class="tw-h-full" for="switch_type_x"><%= @series.duration %> h (<%= @series.duration.hours.in_blocks %> Blocks)</label> -->
                  <label class="tw-h-full" for="switch_type_x">Automatisch</label>

                  <input class="tw-h-full" type="radio" data-action="click->workload#switchType" name="switch_type" id="switch_type_1" value="1">
                  <label class="tw-h-full" for="switch_type_1">Manuell</label>
                </div>
              </div>
            </div>
          </div>
        </div>


        <div class="workload-box tw-mt-8">
          <%= render(partial: "recurring_order_executions/partials/workload", locals: { group: @group, start_date: @start_date, end_date: @end_date }) %>
        </div>
      </div>

      <div class="form-actions tw-mt-6">
        <%= link_to "Zurück", @series.recurring_order_execution, class: "btn btn-secondary" %>
        <%= f.button :submit, class: "btn btn-primary tw-hidden", id: "submit-button" %>
      </div>
    </div>

    <div class="col col-md-5 tw-relative">
      <div class="tw-absolute tw-z-40 tw-top-[20%] tw-left-[40%] tw-text-center">
        <button disabled data-action="click->workload#preview" class="tw-hidden btn btn-primary tw-mt-36 tw-inline" data-workload-target="spinner">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="spinner tw-hidden tw-animate-spin tw-h-5 tw-w-5 tw-mr-1 tw-inline-block">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="new tw-hidden tw-animate-pulse tw-h-5 tw-w-5 tw-mr-1 tw-inline-block">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
          </svg>
          Konflikt-Check
        </button>
      </div>

      <div id="appointments_preview" class="tw-blur-sm">
        <%= f.simple_fields_for :appointments do |a| %>
          <%#= a.input :id, as: :hidden %>
          <%= a.input :start_time, as: :hidden %>
          <%= a.input :end_time, as: :hidden %>
        <% end %>

        <%= render(partial: "recurring_order_executions/partials/appointments", locals: { appointments: @appointments }) %>
      </div>
    </div>
  </div>
<% end %>

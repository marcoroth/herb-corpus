<% content_for :page_title, "Termin-Serie in #{@series.start_date.year} planen" %>
<% content_for :page_subtitle, "Daueraufträge" %>

<div class="container-fluid mt--6">
  <%= render PageHeaderComponent.new %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_body do %>
      <%= render "form", series: @series %>
    <% end %>
  <% end %>
</div>

<% content_for :page_title, "#{@appointment.name} (#{@appointment.start_time.to_date.to_fs(:default)})" %>
<% content_for :page_subtitle, "Termin" %>

<div class="container-fluid mt--6" data-reflex-root="#appoinment-show">
  <%= render PageHeaderComponent.new(subtitle: yield(:page_subtitle), button_text: "Bearbeiten", button_url: edit_appointment_path(@appointment)) do |header| %>
    <% header.with_labeled_avatar(title: @appointment.leader&.name, description: "Bauleiter/in", user: @appointment.leader, size: 'md') %>
    <% header.with_labeled_avatar(title: @appointment.client&.name, description: "Kunde", user: @appointment.client, size: 'md') if @appointment.client %>

    <%= header.with_body_content do |tabs| %>

    <% end %>
  <% end %>

  <% if @appointment.holiday? %>
    <div class="tw-rounded-md tw-bg-yellow-50 tw-p-4 tw-mb-4 tw-border">
      <div class="tw-flex">
        <div class="tw-flex-shrink-0">
          <svg class="tw-h-5 tw-w-5 tw-text-yellow-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="tw-ml-3">
          <h3 class="tw-text-sm tw-font-medium tw-text-yellow-800">Achtung Feiertag</h3>
          <div class="tw-mt-2 tw-text-sm tw-text-yellow-700">
            <p><%= @appointment.holiday_text %></p>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="row">
    <div class="col-lg-8 col-12">
      <%= render CardComponent.new do |card| %>
        <%= card.with_header do |header| %>
          <%= header.with_button do %>
            <%= link_to "Ganzen Tag anzeigen", day_plan_for_group_path(@appointment.group, start_date: @appointment.start_time.to_date), class: "btn btn-sm btn-white tw-mr-3" %>
            <%= link_to "Ganze Woche anzeigen", week_plan_for_group_path(@appointment.group, start_date: @appointment.start_time.to_date), class: "btn btn-sm btn-white tw-mr-3" %>
            <%#= link_to "Zurück", day_plan_for_group_path(@group, start_date: @previous_date, user_id: @user), class: "btn btn-sm btn-white" %>
            <%#= link_to "Heute", day_plan_for_group_path(@group, start_date: Date.current, user_id: @user), class: "btn btn-sm btn-white" %>
            <%#= link_to "Weiter", day_plan_for_group_path(@group, start_date: @next_date, user_id: @user), class: "btn btn-sm btn-white" %>
          <% end %>
        <% end %>

        <%= card.with_body do %>
          <% start_time = [@appointment.start_time - 2.hours, @appointment.start_time.change(hour: 6, minute: 0)].max %>
          <% end_time = [@appointment.end_time + 2.hours, @appointment.end_time.change(hour: 17, minute: 0)].min %>
          <% range = start_time..end_time %>

          <div>
            <div class="tw-grid tw-grid-cols-<%= @appointment.users.count %> tw-gap-x-6">
              <% @appointment.users.each do |user| %>
                <div>
                  <div class="tw-flex tw-gap-2 tw-items-center">
                    <%= render AvatarComponent.new(user: user, size: "xs") %>
                    <b><%= link_to user.name, user_block_path(@appointment.user_block_id(user)) %></b>
                  </div><br>

                  <% blocks = UserBlock.in_blocks_of(15.minutes).in_steps_of(15.minutes).for_user(user).for_day(@appointment.start_time).where(start_time: range).ordered %>

                  <% if false && blocks.count == blocks.where(has_user_availability: false).count %>
                    Keine Verfügbarkeit
                  <% end %>

                  <% if false && blocks.count == blocks.where(has_holiday: true).count %>
                    Feiertag
                  <% end %>

                  <% if false && blocks.count == blocks.where(has_working_hour: false).count %>
                    Keine Arbeitszeit
                  <% end %>

                  <div class="tw-grid tw-border tw-border-gray-300">
                    <% blocks.each do |block| %>
                      <div class="tw-grid tw-grid-cols-3 tw-grid-cols-[auto_auto_5%] tw-h tw-border-l-8  tw-border-r-4 tw-truncate tw-text-ellipsis tw-py-1 tw-px-2 <% if block.appointment_id == @appointment.id %> tw-bg-blue-100 tw-border-r-blue-500 <% else %> tw-opacity-50 tw-border-r-transparent <% end %> <% if block.available %>  <% elsif !block.available %> tw-bg-gray-00 <% else %> tw-bg-gray-00 <% end %> <% if block.has_conflict %> tw-border-red-500  tw-text-red-500 <% elsif !block.available? %> tw-border-gray-500 <% else %> tw-border-green-500 <% end %>">
                        <span>
                          <%= block.start_time.to_fs(:time) %>
                        </span>

                        <% if block.has_conflict %>
                          <%= link_to @appointment.name.presence ? "Termin: #{@appointment.name} (Konflikt)" : "Konflikt", user_block_path(block.long_id) %>
                          <i class="fa fa-triangle-exclamation tw-text-right" data-bs-toggle="tooltip" data-bs-title="<%= block.conflicts_text %>"></i>
                        <% else %>

                          <% if block.appointment_id == @appointment.id %>
                            <%= link_to "Termin: #{@appointment.name}", user_block_path(block.long_id) %>
                          <% else %>
                            <% if block.available? %>
                              <%= link_to "Verfügbar", user_block_path(block.long_id) %>
                            <% else %>
                              <%= link_to "Nicht verfügbar", user_block_path(block.long_id) %>
                              <i class="fa fa-info-circle tw-text-gray-500 tw-text-right" data-bs-toggle="tooltip" data-bs-title="<%= block.text %>"></i>

                            <% end %>

                          <% end %>
                        <% end %>

                      </div>
                    <% end %>
                  </div>

                </div>
              <% end %>
            </div>

          </div>

          <br><br>
          <%= link_to 'Zurück', @appointment.source || appointments_path, class: "btn btn-secondary" %>
          <%= link_to 'Termin Löschen', @appointment, class: "btn btn-danger", data: { turbo_confirm: "löschen?", turbo_method: "delete" } %>


        <% end %>
      <% end %>
    </div>

    <div class="col-lg-4 col-12">
      <%= render CardListComponent.new do |list| %>
        <%= list.with_item(title: "Name", value: @appointment.name) %>
        <%= list.with_item(title: "Beschreibung", value: @appointment.description) if @appointment.description.presence %>

        <%= list.with_item(title: "Adresse") do %>
          <%= @appointment.address %><br>
          <%= link_to "#{@appointment.place.postalcode} #{@appointment.place}", @appointment.place %>
        <% end %>

        <%= list.with_item(title: "Datum") do %>
          <%= I18n.t("date.day_names")[@appointment.start_time.wday] %>, <%= @appointment.start_time.to_date.to_fs(:default) %>
        <% end %>

        <%= list.with_item(title: "Uhrzeit") do %>
          <%= @appointment.time_text(only_time: true) %>
        <% end %>

        <%= list.with_item(title: "Status", value: @appointment.status) if @appointment.status.presence %>
        <%= list.with_item(title: "Benötigte Personen", value: "#{@appointment.users.count} benötigt / #{@appointment.needed_workers} zugeteilt") %>

        <%= list.with_item(title: "Personen-Status") do %>
          <% if @appointment.enough_workers? %>Genügend Personen zugeteilt<% end %>
          <% if @appointment.too_few_workers? %>Zu wenig Personen zugeteilt<% end %>
          <% if @appointment.too_much_workers? %>Zu viele Personen zugeteilt<% end %>
        <% end %>

        <%= list.with_item(title: "Gruppe") do %>
          <% if @appointment.group %>
            <%= link_to @appointment.group.name, @appointment.group %>
          <% else %>
            Keine Gruppe
          <% end %>
        <% end %>

        <%= list.with_item(title: "Personen") do %>
          <%= render AvatarGroupComponent.new(users: @appointment.users, size: 'xs') %>
        <% end %>

        <%= list.with_item(title: "Kunde/in") do %>
          <%= link_to @appointment.client.name, client_path(@appointment.client) if @appointment.client %>
        <% end %>

        <%= list.with_item(title: "Bauleiter/in") do %>
          <%= link_to @appointment.leader.name, user_path(@appointment.leader) if @appointment.leader %>
        <% end %>

        <%= list.with_item(title: "Gruppen-Leiter/in") do %>
          <%= link_to @appointment.group_leader.name, user_path(@appointment.group_leader) if @appointment.group_leader %>
        <% end %>

        <%= list.with_item(title: "Termin-Herkunft", separator: false) do %>
          <%= link_to (@appointment.source || "Einzeltermin"), @appointment.source %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

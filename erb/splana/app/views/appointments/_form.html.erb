<%= simple_form_for(@appointment) do |f| %>
  <%= f.error_notification %>

  <%= @appointment.errors.inspect if @appointment.errors.any? %>

  <div class="form-inputs" data-controller="appointments" <% if params[:duration] %> data-appointments-duration-value="<%= params[:duration] %>"<% end %> >
    <%= f.association :client, label: "Kunde", collection: Client.labeled, disabled: action_name == "edit" %>
    <%= f.input :name, label: "Terminname" %>

    <div class="tw-grid md:tw-grid-cols-2 tw-gap-x-4">
      <%= f.input :needed_workers, label: "Benötigte Mitarbeiter" %>
      <%= f.association :group, label: "Gruppe", collection: Group.labeled if action_name == "new" %>
      <%= f.association :users, label: "Arbeiter", collection: Employee.all, input_html: { autocomplete: "off" } if action_name == "edit" %>
    </div>

    <div class="tw-grid md:tw-grid-cols-2 tw-gap-x-4">
      <%= f.input :start_time, label: "Start", input_html: { data: { appointments_target: "from", action: "change->appointments#changeStartDate" } } %>
      <%= f.input :end_time, label: "Ende", input_html: { data: { appointments_target: "to", action: "change->appointments#changeEndDate" } } %>
    </div>

    <% #if action_name == "edit" %>
      <div class="tw-grid md:tw-grid-cols-2 tw-gap-x-4">
        <%= f.input :address, label: "Ausführung-Adresse" %>
        <%= f.association :place, label: "Ausführung-Ort", collection: Place.labeled %>
      </div>
    <% #end %>

    <%# f.input :status, collection: Appointment.statuses.keys, selected: Appointment.statuses.keys[@appointment[:status].to_i], label: "Status" %>
    <%#= f.association :leader, label: "Bauleiter/in", collection: Leader.all, input_html: { class: 'select2', 'data-ajax--url': "/search/leaders", 'data-ajax--cache': "true" } if action_name == "edit" %>
    <%#= f.association :group_leader, label: "Gruppen-Leiter/in", collection: [@appointment.group_leader], input_html: { class: 'select2', 'data-ajax--url': "/search/employees", 'data-ajax--cache': "true" } if action_name == "edit" %>

    <%= f.input :description, label: "Beschreibung, Details und/oder Tätigkeit" %>

    <%= f.input :source_id, as: :hidden %>
    <%= f.input :source_type, as: :hidden %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, class: "btn btn-primary" %>
    <%= link_to "Abbrechen", :back, class: "btn btn-secondary" %>
  </div>
<% end %>

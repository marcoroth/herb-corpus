<div class="container-fluid mt--6 tw-pb-12">
  <%= render PageHeaderComponent.new(title: "Termine", button_text: "Neuer Termin", button_url: new_appointment_path) do |header| %>
    <%= header.with_tab_list do |tabs| %>
      <%= tabs.with_tab(name: "Alle", url: appointments_path(scope: "all"), count: Appointment.all.count, active: :exact) %>
      <%= tabs.with_tab(name: "Jetzt", url: appointments_path(scope: "happening_now"), count: Appointment.happening_now.count, active: :exact) %>
      <%= tabs.with_tab(name: "Heute", url: appointments_path(scope: "today"), count: Appointment.today.count, active: :exact) %>
      <%= tabs.with_tab(name: "Diese Woche", url: appointments_path(scope: "this_week"), count: Appointment.this_week.count, active: :exact) %>
      <%= tabs.with_tab(name: "Zukünftige", url: appointments_path(scope: "upcoming"), count: Appointment.upcoming.count, active: :exact) %>
      <%= tabs.with_tab(name: "Vergangene", url: appointments_path(scope: "past"), count: Appointment.past.count, active: :exact) %>
      <%= tabs.with_tab(name: "Mit Konflikten (nächste 4 Wochen)", url: appointments_path(scope: "has_conflicts"), count: Appointment.has_conflicts.count, active: :exact) %>
    <% end %>
  <% end %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_card_content do %>
      <%= render AppointmentTableComponent.new(appointments: @appointments) %>
    <% end %>
  <% end %>
</div>

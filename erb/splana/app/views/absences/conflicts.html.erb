<% content_for :page_title, "Absenz von #{@absence.user.name}" %>
<% content_for :page_subtitle, "Konflikte" %>

<div class="container-fluid mt--6">
  <%= render PageHeaderComponent.new(button_text: "Bearbeiten", button_url: edit_absence_path(@absence)) %>

  <%= render CardComponent.new do |card| %>
    <% card.with_header do |header| %>
      <%= header.with_title { "Untenstehende Termine haben ein Konflikt mit dieser Absenz" } %>
    <% end %>

    <%= card.with_body do %>
      <p><b>Grund der Absenz:</b> <%= @absence.name %></p>
      <p><b>Art:</b> <%= @absence.absence_type %></p>
      <p><b>Anzahl Termin-Konflikte:</b> <%= @absence.conflicted_appointments.count %></p>

      <p><b>Datum:</b> <%= link_to @absence.time_text, user_block_path(@absence.user_block_id) %></p>
      <% end %>
    <% end %>

    <div class="tw-grid tw-grid-cols-3 tw-gap-3">
      <% @absence.conflicted_appointments.each do |appointment| %>

        <%= render CardComponent.new do |card| %>
          <% card.with_header do |header| %>
            <%= header.with_title do %>
              Konflikt mit <%= link_to appointment.source ? appointment.source.class.translated_name : "Einzeltermin", appointment.source_link %>
            <% end %>
          <% end %>

          <%= card.with_body do %>
            <i class="fa fa-calendar"></i> Termin: <%= link_to appointment.name, appointment %><br>
            <i class="fa fa-tasks"></i> Termin-Typ: <%= link_to (appointment.source ? appointment.source.class.translated_name : "Einzeltermin"), appointment.source_link %><br>
            <i class="fa fa-calendar-alt"></i> <%= link_to appointment.time_text, user_block_path(appointment.user_block_id(@absence.user)) %>

            <b class="tw-mt-6 tw-mb-1 tw-block">Mitarbeiter:</b>

            <% [@absence.user].each do |u| %>
              <span class="tw-text-red-500" >
                <i class="fa fa-user-times"></i> <%= u.name %>

                <% if u == appointment.group_leader %>
                  <i class="fa fa-star tw-text-yellow-500" data-toggle="tooltip" data-placement="top" title="Gruppen Leiter"></i>
                <% end %>
              </span><br>
            <% end %>

            <% (appointment.users - [@absence.user]).each do |u| %>
              <span>
                <i class="fa fa-user"></i> <%= u.name %>
                <% if u == appointment.group_leader %>
                  <i class="fa fa-star tw-text-yellow-500" data-toggle="tooltip" data-placement="top" title="Gruppen Leiter"></i>
                <% end %>
              </span><br>
            <% end %>

            <b class="tw-mt-6 tw-mb-1 tw-block">Mögliche Konflikt-Lösungen:</b>

            <i class="fa fa-user-times"></i> <%= link_to "#{@absence.user.name} entfernen", remove_user_appointment_path(user_id: @absence.user) %><br>
            <i class="fa fa-refresh"></i> <%= link_to "#{@absence.user.name} austauschen", change_user_appointment_path(old_user_id: @absence.user, new_user_id: User.last) %><br>
            <i class="fa fa-angle-double-down"></i> <%= link_to "#{@absence.user.name} entfernen und benötigte Arbeiter von #{appointment.needed_workers} auf #{appointment.needed_workers-1} reduzieren", update_needed_workers_appointment_path(appointment: appointment.id, amount: appointment.needed_workers) %><br>
            <i class="fa fa-calendar"></i> <%= link_to "Termin verschieben", update_needed_workers_appointment_path(appointment: appointment.id, amount: appointment.needed_workers) %><br>
            <i class="fa fa-calendar-times"></i> <%= link_to "Termin annulieren", update_needed_workers_appointment_path(appointment: appointment.id, amount: appointment.needed_workers) %><br>
            <i class="fa fa-clock"></i> <%= link_to "Dauer des Termins anpassen", update_needed_workers_appointment_path(appointment: appointment.id, amount: appointment.needed_workers) %><br>
            <i class="fa fa-refresh"></i> <%= link_to "Gruppe austauschen", remove_user_appointment_path(user_id: @absence.user) %><br>
            <i class="fa fa-users"></i> <%= link_to "Gruppe entfernen", remove_user_appointment_path(user_id: @absence.user) %><br>
            <i class="fa fa-check"></i> <%= link_to "Konflikt ignorieren", update_needed_workers_appointment_path(appointment: appointment.id, amount: appointment.needed_workers) %><br>
          <% end %>
        <% end %>
      <% end %>

    </div>
</div>

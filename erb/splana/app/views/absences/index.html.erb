<% content_for :page_title, "Absenzen" %>
<% content_for :page_subtitle, "Alle" %>

<div class="container-fluid mt--6">
  <%= render PageHeaderComponent.new(button_text: "Neue Absenz", button_url: new_absence_path) %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_card_content do %>
      <%= render partial: "absences/partials/absence_list", locals: { absences: @absences } %>
    <% end %>
  <% end %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_card_content do %>
    <% @grouped_absences = Absence.all.group_by(&:user_id) %>

      <table class="tw-border tw-border-black">
        <% Employee.all.each do |user| %>
          <% user_absences = Array.wrap(@grouped_absences[user.id]) %>
          <tr>
            <th class="tw-border tw-border-black"><%= user.name %></th>

            <% Date.today.all_month.each do |date| %>
              <% day_absences = user_absences.select { |a| date.between?(a.start_time, a.end_time) } %>
              <td
                class="
                  tw-border tw-border-black tw-text-center
                  <% if day_absences.any? %>
                    tw-bg-red-500
                  <% else %>
                    tw-bg-green-500
                  <% end %>
                "
              ><%= day_absences.count %></td>
            <% end %>

          </tr>
        <% end %>
      </table>
    <% end %>
  <% end %>
</div>

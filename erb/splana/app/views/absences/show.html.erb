<% content_for :page_title, "Absenz '#{@absence.name}'" %>
<% content_for :page_subtitle, "Absenzen" %>

<div class="container-fluid mt--6">
  <%= render PageHeaderComponent.new(button_text: "Bearbeiten", button_url: edit_absence_path(@absence)) %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_body do %>
      <p>
        <strong>Name:</strong>
        <%= @absence.name %>
      </p>

      <p>
        <strong>Absenz Grund:</strong>
        <%= @absence.absence_type&.name %>
      </p>

      <p>
        <strong>Mitarbeiter:</strong>
        <%= link_to @absence.user.name, user_path(@absence.user) %>
      </p>

      <p>
        <strong>Dauer:</strong>
        <%= @absence.time_text %>
      </p>

      <p>
        <strong>Termin-Konflikte:</strong>

        <% if @absence.conflicted_appointments.any? %>
          <%= @absence.conflicted_appointments.count %><br><br>

          <% @absence.conflicted_appointments.each do |appointment| %>
            - Termin <%= link_to appointment.name, appointment %><br/>
          <% end %><br><br>

          <%= link_to "Konflikte lösen", conflicts_absence_path(@absence), class: "btn btn-danger" %>
        <% else %>
          <span class="text-success">Keine Konflikte</span>
        <% end %>
      </p><br>

      <%= link_to 'Löschen', absence_path(@absence), class: "btn btn-danger", data: { turbo_method: "delete", turbo_confirm: "Willst du diese Absenz wirklich löschen?" } %>
      <%= link_to 'Zurück', absences_path, class: "btn btn-secondary" %>
    <% end %>
  <% end %>
</div>

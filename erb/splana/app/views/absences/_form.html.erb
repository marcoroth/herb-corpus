<%= simple_form_for(@absence) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs" data-controller="absences">
    <%= f.association :user, collection: Employee.all, label: "Mitarbeiter", input_html: { disabled: action_name == "edit" } %>

    <div class="tw-grid md:tw-grid-cols-2 tw-gap-4">
      <%= f.association :absence_type, label: "Absenz-Grund", input_html: { data: {action: "change->absences#changeType" } } %>
      <%= f.input :name, label: "Beschreibung", input_html: { data: { absences_target: "reason" } } %>
    </div>

    <div class="tw-grid md:tw-grid-cols-2 tw-gap-4">
      <%= f.input :start_time, label: "Von", input_html: { data: { absences_target: "from" } } %>
      <%= f.input :end_time, label: "Bis", input_html: { data: { absences_target: "to" } } %>
    </div>
  </div>

  <div class="form-actions">
    <%= f.button :submit, class: "btn btn-primary" %>
    <%= link_to "Abbrechen", absences_path, class: "btn btn-secondary" %><br/><br/>
  </div>
<% end %>

<%= render CardTableComponent.new do |table| %>
  <%= table.with_header { "Grund" } %>
  <%= table.with_header { "Absenz-Art" } %>
  <%= table.with_header { "Mitarbeiter" } %>
  <%= table.with_header { "Konflikte" } %>
  <%= table.with_header { "Datum" } %>
  <%= table.with_header { "Dauer" } %>
  <%= table.with_header { "Vor/In" } %>
  <%= table.with_header { "Aktionen" } %>

  <% absences.each do |absence| %>
    <%= table.with_row do |row| %>
      <%= row.with_cell { link_to absence.name, absence_path(absence) } %>
      <%= row.with_cell { absence.absence_type.to_s } %>
      <%= row.with_cell { link_to absence.user.name, absences_user_path(absence.user) } %>
      <%= row.with_cell do %>
        <span class="<% if absence.conflicted_appointments.count == 0 %> text-success <% else %> text-danger <% end %>">
          <%= link_to absence.conflicted_appointments.count, conflicts_absence_path(absence) %>
        </span>
      <% end %>

      <%= row.with_cell { absence.time_text } %>
      <%= row.with_cell { "#{(UserBlock.between(absence.start_time, absence.end_time).for_user(absence.user).where(absence_id: absence.id, has_working_hour: true, weekend: false).count * 15.minutes).in_hours} h" } %>
      <%= row.with_cell do %>
        <% if absence.start_time < Time.current %> vor <% else %> in <% end %><%= distance_of_time_in_words(absence.start_time, Time.current) %>
      <% end %>

      <%= row.with_cell do %>
        <%= render DropdownComponent.new do |dropdown| %>
          <% dropdown.with_item { link_to "Anzeigen", absence } %>

          <% if absence.conflicted_appointments.any? %>
            <% dropdown.with_item { link_to "Konflikte lösen", conflicts_absence_path(absence) } %>
          <% end %>

          <% dropdown.with_item { link_to "Bearbeiten", edit_absence_path(absence) } %>
          <% dropdown.with_item { link_to "Löschen", absence, data: { turbo_confirm: 'Bist du sicher, dass du diese Absenz löschen willst?', turbo_method: "delete" } } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

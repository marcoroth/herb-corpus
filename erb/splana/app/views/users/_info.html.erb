<div class="col-12 <% unless action_name == "info" %> col-xl-4 tw-hidden lg:tw-block <% end %>">
  <%= render CardListComponent.new do |list| %>
    <%= list.with_item(title: "E-Mail", value: @user.email) %>
    <%= list.with_item(title: "Erstellt am", value: @user.created_at.to_fs(:default)) %>
    <%= list.with_item(title: "Strasse", value: link_to(@user.address.presence || "Unbekannt", @user.maps_link, target: "_blank")) %>
    <%= list.with_item(title: "Ort", value: link_to(@user.place.presence || "Unbekannt", @user.place), separator: false) %>
  <% end %>

  <% if @user.class == Employee %>
    <% rule = @user.current_absence_rule %>

    <%= render CardComponent.new do |card| %>
      <%= card.with_header do |header| %>
        <%= header.with_title do %>
          Arbeitstage • <%= rule.working_percent rescue 100 %>% -
          <span class="pull-right"><small>
            <% if rule %>
              <%= link_to "Bearbeiten", edit_absence_rule_path(rule) %>
            <% else %>
              <%= link_to "Einschränken", new_absence_rule_path(user: @user) %>
            <%end %>
          </small></span>
        <% end %>
      <% end %>

      <%= card.with_body do %>
        <style media="screen">
          #absence_rule_table td {
            width: 100px;
            height: 125px;
            border: 1px solid black;
            font-size: 8pt;
            text-align: center;
          }
        </style>

        Abwesend: <%= rule&.text_form %><br/><br/>

        <table id="absence_rule_table">
          <tr>
            <td class="<%= rule&.present_on?("morning", 1) ? "bg-danger text-white" : "bg-success text-success" %>"><%= rule&.name %></td>
            <td class="<%= rule&.present_on?("morning", 2) ? "bg-danger text-white" : "bg-success text-success" %>"><%= rule&.name %></td>
            <td class="<%= rule&.present_on?("morning", 3) ? "bg-danger text-white" : "bg-success text-success" %>"><%= rule&.name %></td>
            <td class="<%= rule&.present_on?("morning", 4) ? "bg-danger text-white" : "bg-success text-success" %>"><%= rule&.name %></td>
            <td class="<%= rule&.present_on?("morning", 5) ? "bg-danger text-white" : "bg-success text-success" %>"><%= rule&.name %></td>
          </tr>
          <tr>
            <td class="<%= rule&.present_on?("afternoon", 1) ? "bg-danger text-white" : "bg-success text-success" %>"><%= rule&.name %></td>
            <td class="<%= rule&.present_on?("afternoon", 2) ? "bg-danger text-white" : "bg-success text-success" %>"><%= rule&.name %></td>
            <td class="<%= rule&.present_on?("afternoon", 3) ? "bg-danger text-white" : "bg-success text-success" %>"><%= rule&.name %></td>
            <td class="<%= rule&.present_on?("afternoon", 4) ? "bg-danger text-white" : "bg-success text-success" %>"><%= rule&.name %></td>
            <td class="<%= rule&.present_on?("afternoon", 5) ? "bg-danger text-white" : "bg-success text-success" %>"><%= rule&.name %></td>
          </tr>
        </table>
      <% end %>
    <% end %>

  <% end %>

</div>

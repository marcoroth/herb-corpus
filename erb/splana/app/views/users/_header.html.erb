<div class="container-fluid">
  <%= render PageHeaderComponent.new(title: @user.name, subtitle: @user.class.translated_name, button_text: "Bearbeiten", button_url: edit_user_path(@user)) do |header| %>
    <%= header.with_avatar(user: @user, size: "lg") %>

    <%= header.with_tab_list do |tabs| %>
      <%= tabs.with_tab(name: "Übersicht", url: user_path(@user), active: :exclusive) %>

      <% if @user.class == Employee %>
        <%= tabs.with_tab(name: "Termine", url: appointments_user_path(@user)) %>
        <%= tabs.with_tab(name: "Kalender", url: calendar_user_path(@user)) %>
        <%= tabs.with_tab(name: "Tagesplan", url: day_plan_user_path(@user)) %>
        <%= tabs.with_tab(name: "Wochenplan", url: week_plan_user_path(@user)) %>
        <%= tabs.with_tab(name: "Absenzen", url: absences_user_path(@user)) %>
        <%= tabs.with_tab(name: "Abwesenheitsregeln", url: absence_rules_user_path(@user)) %>
        <%= tabs.with_tab(name: "Verfügbarkeiten", url: availabilities_user_path(@user)) %>
        <%= tabs.with_tab(name: "Konflikte", url: conflicts_user_path(@user)) %>
        <%= tabs.with_tab(name: Group.translated_name, url: groups_user_path(@user)) %>
      <% end %>
    <% end %>
  <% end %>
</div>

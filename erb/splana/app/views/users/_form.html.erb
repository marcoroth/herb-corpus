<%= simple_form_for(user, as: :user, url: action_name == "new" ? internal_users_path : internal_user_path(user)) do |form| %>
  <div class="field">
    <%= form.input :email, label: "E-Mail (für Login)" %>
  </div>

  <div class="tw-grid md:tw-grid-cols-2 tw-gap-x-4">
    <div class="field">
      <%= form.input :firstname, label: "Vorname" %>
    </div>

    <div class="field">
      <%= form.input :lastname, label: "Nachname" %>
    </div>
  </div>

  <div class="tw-grid md:tw-grid-cols-2 tw-gap-x-4">
    <div class="field">
      <%= form.input :type, collection: user.available_types, label: "Benutzer-Art" %>
    </div>

    <div class="field">
      <%= form.input :gender, label: "Geschlecht", collection: User.genders %>
    </div>
  </div>

  <div class="tw-grid md:tw-grid-cols-2 tw-gap-x-4">
    <div class="field">
      <%= form.input :address, label: "Wohnadresse" %>
    </div>

    <div class="field">
      <%= form.association :place, label: "Ort" %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.button :submit, class: "btn btn-primary" %>
    <%= link_to "Abbrechen", type_users_path(user.type), class: "btn btn-secondary" %>
  </div>
<% end %>

<% current_block ||= nil %>

<div>
  <div class="tw-flex tw-gap-2 tw-items-center">
    <div class="tw-mx-auto">
      <%= render AvatarComponent.new(user: user, size: "xs") %>
      <b><%= link_to user.name, day_plan_user_path(user, start_date: block_groups.first.start_time.to_date) %></b>
    </div>
  </div><br>

  <div class="">
    <% block_groups.each_with_index do |blocks, index| %>
      <% blocks = blocks.blocks %>
      <% block = blocks.first %>

      <% prev_blocks = block_groups[index - 1]&.blocks || [] %>
      <% prev_block = prev_blocks.first %>

      <% next_blocks = block_groups[index + 1]&.blocks || [] %>
      <% next_block = next_blocks.first %>

      <% prev_appointment_block_has_conflict = block.appointment_id && prev_block && block.appointment_id == prev_block.appointment_id && prev_block.has_conflict? %>
      <% next_appointment_block_has_conflict = block.appointment_id && next_block && block.appointment_id == next_block.appointment_id && next_block.has_conflict? %>

      <% appointment_blocks = block_groups.select { |bg| bg.blocks.first.appointment_id == block.appointment_id }.flat_map(&:blocks).sort_by(&:start_time) %>

      <% same_appointment_as_prev_block = block.appointment_id && prev_block && block.appointment_id == prev_block.appointment_id %>
      <% same_appointment_as_next_block = block.appointment_id && next_block && block.appointment_id == next_block.appointment_id %>

      <div
        style="min-height: <%= blocks.count * (blocks.first.has_working_hour ? 10 : 2) %>px"
        class="
        tw-h-full

        <% if same_appointment_as_next_block %>
        <% else %>
          tw-mb-2
        <% end %>

        <% if current_block %>
          <% if
            (block.start_time.between?(current_block.start_time, current_block.end_time) && blocks.last.end_time.between?(current_block.start_time, current_block.end_time)) ||
            (current_block.start_time.between?(block.start_time, blocks.last.end_time) && current_block.end_time.between?(block.start_time, blocks.last.end_time))

            %>

          <% else %>
            tw-opacity-30
          <% end %>
        <% end %>


        tw-grid tw-grid-cols-3 tw-grid-cols-[auto_auto_5%] tw-h tw-border-l-8 tw-truncate tw-text-ellipsis tw-py-1 tw-px-2

        <% if block.appointment_id && block.has_conflict? %>
          tw-bg-red-100 hover:tw-bg-red-200 tw-border-l-blue-500 tw-border-r-4 tw-border-r-red-500  tw-text-red-500
        <% elsif block.holiday_id %>
          tw-bg-purple-100 hover:tw-bg-purple-200 tw-border-l-purple-500 tw-border-purple-300
        <% elsif block.has_pause %>
          tw-bg-gray-100 hover:tw-bg-gray-200 tw-border-l-gray-500 tw-border-gray-300
        <% elsif block.has_conflict? %>
          tw-bg-red-100 hover:tw-bg-red-200 tw-border-l-red-500 tw-border-red-300
        <% elsif block.available %>
          tw-bg-green-100 hover:tw-bg-green-200 tw-border-l-green-500 tw-border-green-300
        <% elsif block.appointment_id %>
          tw-bg-blue-100 hover:tw-bg-blue-200 tw-border-l-blue-500 tw-border-blue-200
        <% elsif !block.available %>
          tw-bg-gray-100 hover:tw-bg-gray-200 tw-border-l-gray-500 tw-border-gray-300
        <% else %>
          tw-bg-gray-100 hover:tw-bg-gray-200 tw-border-l-gray-500 tw-border-gray-300
        <% end %>
      ">
        <% if prev_appointment_block_has_conflict && appointment_blocks.first != prev_blocks.first %>
        <% else %>
          <span>

            <% if prev_appointment_block_has_conflict %>
              <%= appointment_blocks.first.start_time.to_fs(:time) %> -
              <%= appointment_blocks.last.end_time.to_fs(:time) %>
            <% elsif next_appointment_block_has_conflict %>
              <%= blocks.first.start_time.to_fs(:time) %> -
              <%= appointment_blocks.last.end_time.to_fs(:time) %>
            <% else %>
              <%= blocks.first.start_time.to_fs(:time) %> -
              <%= blocks.last.end_time.to_fs(:time) %>
            <% end %>
          </span>

          <% if block.has_conflict && (same_appointment_as_next_block || same_appointment_as_prev_block) %>
            <%= link_to block.conflicts_text(block.reasons_raw - ["Termin"]), user_block_path(block_id_from_blocks(blocks)) %>
          <% else %>
            <%= render partial: "groups/block", locals: { block: block, blocks: blocks } %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

</div>

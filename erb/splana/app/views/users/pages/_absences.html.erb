<div class="col-12 col-xl-8">
  <h3 class="text-muted tw-flex tw-justify-between">
    Absenzen
    <%= link_to "Neue Absenz", new_absence_path(user_id: @user.id), class: "btn btn-sm btn-primary" %>
  </h3>

  <% @user.absences.order(start_time: :asc).each do |absence| %>
    <%= render AbsenceCardComponent.new(absence: absence) %>
  <% end %>

  <% if @user.absences.count.zero? %>
    <%= render CardComponent.new do |card| %>
      <%= card.with_body do %>
        <p class="card-text">Keine Absenzen</p>
      <% end %>
    <% end %>
  <% end %>
</div>

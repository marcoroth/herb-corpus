<div class="col-12 col-xl-8">
  <h3 class="text-muted"><%= Group.translated_name %></h3>

  <% if @user.group %>
    <%= render GroupCardComponent.new(group: @user.group) %>
  <% else %>
    <%= render CardComponent.new do |card| %>
      <%= card.with_body do %>
        <p class="card-text">Keiner <%= Group.translated_name %> zugeordnet</p>
      <% end %>
    <% end %>
  <% end %>
</div>

<div class="col-12 col-xl-8">
  <h3 class="text-muted tw-flex tw-justify-between">
    Abwesenheitsregeln
    <%= link_to "Neue Abwesenheitsregel", new_absence_rule_path(user_id: @user.id), class: "btn btn-sm btn-primary" %>
  </h3>

  <% @user.absence_rules.order(start_date: :asc).each do |absence_rule| %>
    <%= render AbsenceRuleCardComponent.new(absence_rule: absence_rule) %>
  <% end %>

  <% if @user.absence_rules.count.zero? %>
    <%= render CardComponent.new do |card| %>
      <%= card.with_body do %>
        <p class="card-text">Keine Abwesenheitsregeln</p>
      <% end %>
    <% end %>
  <% end %>
</div>

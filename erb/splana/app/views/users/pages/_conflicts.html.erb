<div class="col-12 col-xl-8">
  <h3 class="text-muted">Konflikte</h3>

  <%= render CardComponent.new do |card| %>
    <%= card.with_header do |header| %>
      <%= header.with_title { "Konflikte #{@user.name} #{@date.year}" } %>
      <%= header.with_button do %>
        <%= link_to "Heute", conflicts_user_path(@user, date: Date.current), class: "btn btn-sm btn-white tw-mr-3" %>

        <%= link_to %(<i class="fa fa-arrow-left"></i>).html_safe, conflicts_user_path(@user, date: @previous_date), class: "btn btn-sm btn-white" %>
        <%= link_to %(<i class="fa fa-arrow-right"></i>).html_safe, conflicts_user_path(@user, date: @next_date), class: "btn btn-sm btn-white" %>
      <% end %>
    <% end %>

    <%= card.with_body do %>
      <table>
        <% range = @date.all_year_by_week %>
        <% blocks = UserBlock.in_blocks_of(1.hour).for_user(@user).between(range.first, range.last).where(has_conflict: true) %>

        <tr>
          <td></td>
          <% (1..7).each do |i| %>
            <td class="tw-w-24 tw-text-center"><%= I18n.t("date.day_names")[i%7] %></td>
          <% end %>
        </tr>

        <% range.group_by(&:cweek).each do |cweek, dates| %>
          <tr>
            <td class="tw-w-32">KW<%= cweek %></td>
            <% dates.each do |date| %>
              <% day_blocks = blocks.select { |block| block.day == date.day && block.week == cweek }.map(&:appointment_id).uniq.count %>
              <td
                class="
                  tw-text-center tw-border tw-border-black
                  <%= date.past? ? "tw-opacity-40" : "" %>

                  <% if date.today? %>
                    tw-bg-yellow-200 hover:tw-bg-yellow-300
                  <% elsif day_blocks.positive? %>
                    tw-bg-red-200 hover:tw-bg-red-300
                  <% elsif date.saturday? || date.sunday? %>
                    tw-bg-gray-200 tw-bg-gray-300
                  <% else %>
                    tw-bg-green-200 hover:tw-bg-green-300
                  <% end %>
                "
                data-bs-toggle="tooltip"
                data-bs-title="
                  <%= I18n.t("date.day_names")[date.wday] %>, <%= date.to_fs(:default) %>
                "
              >
                <%= day_blocks.positive? ? link_to(pluralize(day_blocks, "Konflikt", "Konflikte"), conflicts_path(start_date: date, user_id: @user.id)) : "" %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </table>
    <% end %>
  <% end %>
</div>

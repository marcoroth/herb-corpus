<div class="col-12 col-xl-8">
  <h3 class="text-muted">Verfügbarkeiten</h3>

  <% @user.user_availabilities.order(start_date: :asc).each do |user_availability| %>
    <%= render UserAvailabilityCardComponent.new(user_availability: user_availability) %>
  <% end %>

  <% if @user.user_availabilities.count.zero? %>
    <%= render CardComponent.new do |card| %>
      <%= card.with_body do %>
        <p class="card-text">Keine Verfügbarkeiten</p>
      <% end %>
    <% end %>
  <% end %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_header do |header| %>
      <%= header.with_title { "Verfügbarkeiten #{@user.name} #{@date.year}" } %>
      <%= header.with_button do %>
        <%= link_to "Heute", availabilities_user_path(@user, date: Date.current), class: "btn btn-sm btn-white tw-mr-3" %>

        <%= link_to %(<i class="fa fa-arrow-left"></i>).html_safe, availabilities_user_path(@user, date: @previous_date), class: "btn btn-sm btn-white" %>
        <%= link_to %(<i class="fa fa-arrow-right"></i>).html_safe, availabilities_user_path(@user, date: @next_date), class: "btn btn-sm btn-white" %>
      <% end %>
    <% end %>


    <%= card.with_body do %>
      <table>
        <% range = @date.all_year_by_week %>
        <% blocks = UserBlock.in_blocks_of(1.hour).in_steps_of(1.hour).for_user(@user).between(range.first, range.last) %>

        <tr>
          <td></td>
          <% (1..7).each do |i| %>
            <td class="tw-w-24 tw-text-center"><%= I18n.t("date.day_names")[i%7] %></td>
          <% end %>
        </tr>

        <% range.group_by(&:cweek).each do |cweek, dates| %>
          <tr>
            <td class="tw-w-32">KW<%= cweek %></td>
            <% dates.each do |date| %>
              <% day_blocks = blocks.select { |block| block.day == date.day && block.week == cweek && block.available == true } %>
              <td
                class="
                  tw-text-center tw-border tw-border-black
                  <%= date.past? ? "tw-opacity-40" : "" %>

                  <% if date.today? %>
                    tw-bg-yellow-200 hover:tw-bg-yellow-300 tw-text-black
                  <% elsif date.saturday? || date.sunday? %>
                    tw-bg-gray-200 tw-bg-gray-300
                  <% elsif day_blocks.count.zero? %>
                    tw-bg-white
                  <% else %>
                    <% green_color = (day_blocks.count / 1.75).floor * 100 %>
                    tw-bg-green-<%= 200 + green_color %> hover:tw-bg-green-<%= 300 + green_color %>
                  <% end %>

                  <% if day_blocks.count >= 5 && day_blocks.count.positive? %>
                    tw-text-white
                  <% else %>
                    tw-text-black
                  <% end %>
                "
                data-bs-toggle="tooltip"
                data-bs-title="
                  <%= I18n.t("date.day_names")[date.wday] %>, <%= date.to_fs(:default) %>
                "
              >
                <%= link_to "#{day_blocks.count} h", day_plan_user_path(@user, start_date: date, user_id: @user.id), class: "hover:tw-text-inherit" %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </table>
    <% end %>
  <% end %>
</div>

<% content_for :page_title, "Wochenplan KW#{@date.cweek} #{@date.year}" %>
<% content_for :page_subtitle, "#{@user.name}" %>

<div class="main-content tw-p-2">
  <%= render "header" %>

  <div class="container-fluid">
    <div class="row">

      <div class="col-12 col-xxl-8">
        <%= render CardComponent.new do |card| %>
          <%= card.with_header do |header| %>
            <%= header.with_title { "#{yield(:page_title)}" } %>
            <%= header.with_button do %>
              <%= link_to "Heute", week_plan_user_path(@user, start_date: Date.current), class: "btn btn-sm btn-white tw-mr-3" %>

              <%= link_to %(<i class="fa fa-arrow-left"></i>).html_safe, week_plan_user_path(@user, start_date: @previous_date), class: "btn btn-sm btn-white" %>
              <%= link_to %(<i class="fa fa-arrow-right"></i>).html_safe, week_plan_user_path(@user, start_date: @next_date), class: "btn btn-sm btn-white tw-mr-3" %>

              <%= link_to "Woche anzeigen", week_plan_for_group_path(@user.group, start_date: @date), class: "btn btn-sm btn-white tw-mr-3" %>

              <% if @weekend %>
                <%= link_to "Wochenende ausblenden", week_plan_user_path(@user, start_date: @date, weekend: "false"), class: "btn btn-sm btn-white" %>
              <% else %>
                <%= link_to "Wochenende anzeigen", week_plan_user_path(@user, start_date: @date, weekend: "true"), class: "btn btn-sm btn-white" %>
              <% end %>
            <% end %>
          <% end %>

          <%= card.with_body do %>
            <div class="tw-grid tw-mt-6 <% if @weekend %> tw-grid-cols-[repeat(7,1fr)] <% else %> tw-grid-cols-[repeat(5,1fr)] <% end %> tw-gap-x-4">

              <% @range.each do |date| %>
                <a href="<%= day_plan_user_path(@user, start_date: date) %>" class="tw-border tw-border-gray-300 tw-py-2 tw-px-4 tw-sticky tw-top-0 tw-bg-white hover:tw-bg-gray-100 hover:tw-text-inherit tw-border-black tw-text-center tw-mb-3">
                  <b><%= I18n.t("date.day_names")[date.wday] %></b><br>
                  <%= date.day %>.<%= date.month %>
                </a>
              <% end %>

              <% @range.each do |date| %>
                <%= render partial: "groups/grouped_group_day", locals: { date: date, group: @user.group, min_height: "350px" } %>
              <% end %>

            </div>
          <% end %>
        <% end %>
      </div>

      <%= render "info" %>
    </div>
  </div>
</div>

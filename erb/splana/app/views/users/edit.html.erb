<% content_for :page_title, "#{@user.name} bearbeiten" %>
<% content_for :page_subtitle, Employee.translated_name_plural %>

<div class="container-fluid mt--6">
  <%= render PageHeaderComponent.new %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_body do %>
      <%= render "form", user: @user %>
    <% end %>
  <% end %>
</div>

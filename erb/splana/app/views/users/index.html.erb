<% content_for :page_title, "#{@users.first&.class&.translated_name_plural || Employee.translated_name}" %>
<% content_for :page_subtitle, "Alle" %>

<div class="container-fluid">
  <%= render PageHeaderComponent.new(button_text: "Neue/r #{Employee.translated_name}", button_url: new_user_path) do |header| %>
    <%= header.with_tab_list do |tabs| %>
      <%= tabs.with_tab(name: Employee.translated_name_plural, url: type_users_path("Employee")) %>
      <%= tabs.with_tab(name: Leader.translated_name_plural, url: type_users_path("Leader")) %>
      <%= tabs.with_tab(name: Secretary.translated_name_plural, url: type_users_path("Secretary")) %>
      <%= tabs.with_tab(name: Admin.translated_name_plural, url: type_users_path("Admin")) %>
    <% end %>
  <% end %>

  <div class="row">
    <% @users.each do |user| %>
      <%= render UserStatusComponent.new(user: user) %>
    <% end %>
  </div>
</div>

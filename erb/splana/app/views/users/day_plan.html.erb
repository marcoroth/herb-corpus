<% content_for :page_title, "Tagesplan #{I18n.t("date.day_names")[@date.wday]}, #{@date.day}. #{I18n.t("date.month_names")[@date.month]} #{@date.year}" %>
<% content_for :page_subtitle, "Tagesplan #{@user.name}" %>

<div class="main-content tw-p-2">
  <%= render "header" %>

  <div class="container-fluid">
    <div class="row">

      <div class="col-12 col-xxl-8">
        <%= render CardComponent.new do |card| %>
          <%= card.with_header do |header| %>
            <%= header.with_title { "#{yield(:page_title)}" } %>
            <%= header.with_button do %>
              <%= link_to "Woche anzeigen", week_plan_user_path(@user, start_date: @previous_date), class: "btn btn-sm btn-white tw-mr-3" %>
              <%= link_to "Gruppe anzeigen", day_plan_for_group_path(@user.group, start_date: @date), class: "btn btn-sm btn-white tw-mr-3" %>
              <%= link_to "Heute", day_plan_user_path(@user, start_date: Date.current), class: "btn btn-sm btn-white tw-mr-3" %>

              <%= link_to %(<i class="fa fa-arrow-left"></i>).html_safe, day_plan_user_path(@user, start_date: @previous_date), class: "btn btn-sm btn-white" %>
              <%= link_to %(<i class="fa fa-arrow-right"></i>).html_safe, day_plan_user_path(@user, start_date: @next_date), class: "btn btn-sm btn-white" %>
            <% end %>
          <% end %>

          <%= card.with_body do %>
            <div class="tw-mx-auto">
              <div class="tw-w-[50%] md:tw-mx-auto tw-gap-x-6 tw-mb-6">
                <% GroupBlock.new(@user.group).for_blocks(UserBlock.for_day(@date)).user_block_groups.each do |user_id, block_groups| %>
                  <% next if user_id != @user.id %>

                  <% user = User.find(user_id) %>

                  <%= render partial: "users/user_day_plan", locals: { user: user, block_groups: block_groups } %>
                <% end %>
              </div>

            </div>

          <% end %>
        <% end %>
      </div>

      <%= render "info" %>
    </div>
  </div>
</div>

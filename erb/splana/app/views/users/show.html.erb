<% content_for :page_title, @user.name %>
<% content_for :page_subtitle, Employee.translated_name_plural %>

<div class="main-content tw-p-2">
  <%= render "users/header" %>

  <div class="container-fluid">
    <div class="row">
      <% if @user.type == "Client" %>
        <%= render partial: "users/pages/recurring_orders" %>
      <% elsif @user.type == "Secretary" %>
        <% # render nothing %>
      <% else %>
        <%= render partial: "users/pages/appointments" %>
      <% end %>

      <% if controller_name == "users" %>
        <%= render "users/info" %>
      <% end %>
    </div>
  </div>
</div>

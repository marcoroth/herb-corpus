<% content_for :page_title, "Absenzregel '#{@absence_rule.name}'" %>
<% content_for :page_subtitle, "Absenzen" %>

<div class="container-fluid mt--6">
  <%= render PageHeaderComponent.new(button_text: "Bearbeiten", button_url: edit_absence_rule_path(@absence_rule)) %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_body do %>
      <p>
        <strong>Name:</strong>
        <%= @absence_rule.name %>
      </p>

      <p>
        <strong>Datum:</strong>
        <%= @absence_rule.date_text %>
      </p>

      <p>
        <strong>User:</strong>
        <%= link_to @absence_rule.user.name, user_path(@absence_rule.user) %>
      </p>

      <p>
        <strong>Entries:</strong><br>
        <% @absence_rule.absence_rule_entries.each do |entry| %>
          <%= "KW#{entry.week} #{entry.dow}: #{entry.absent_morning}, #{entry.absent_afternoon}" %><br>
        <% end %>
      </p>

      <%= link_to 'Edit', edit_absence_rule_path(@absence_rule) %>
      <%= link_to 'Back', absence_rules_path %>
    </div>
  <% end %>
<% end %>

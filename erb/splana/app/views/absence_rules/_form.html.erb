<%= simple_form_for(@absence_rule, html: { data: { controller: "absence-rule", action: "change->absence-rule#setWeeksBasedOnSelection", reflex_serialize_form: "true", reflex_root: "#weeks" } }) do |f| %>
  <% if f.object.errors[:base].present? %>
    <%= f.error_notification message: f.object.errors[:base].to_sentence %>
  <% else %>
    <%= f.error_notification %>
  <% end %>

  <div class="form-inputs">
    <%= f.association :user, collection: Employee.all, label: "Mitarbeiter/in", disabled: action_name == "edit" %>

    <div class="tw-grid md:tw-grid-cols-2 tw-gap-4">
      <%= f.input :name, label: "Grund", collection: ["Pensum", "Schule", "Ärztliches Zeugnis", "Anderes"], input_html: { data: { ts_create: "true" } } %>
      <%= f.input :interval, label: "Intervall", disabled: action_name == "edit", selected: @absence_rule.interval&.iso8601, collection: { "Jede Woche": "P7D", "Jede 2. Woche": "P14D", "Jede 3. Woche": "P21D", "Jede 4. Woche": "P28D", "Jede 5. Woche": "P35D", "Jede 6. Woche": "P42D", "Jede 7. Woche": "P49D", "Jede 8. Woche": "P56D" }, input_html: { data: { absence_rule_target: "interval", action: "change->absence-rule#changeInterval" } } %>
    </div>

    <div class="tw-grid md:tw-grid-cols-2 tw-gap-4">
      <%= f.input :start_date, label: "Gültig von", as: :only_date, disabled: action_name == "edit" %>
      <%= f.input :end_date, label: "Gültig bis", as: :only_date, disabled: action_name == "edit" %>
    </div>
  </div>

  <% start_date = @absence_rule.start_date %>
  <% end_date = @absence_rule.end_date %>
  <% interval = @absence_rule.interval %>
  <% entries = @absence_rule.absence_rule_entries %>

  <%= render AbsenceRuleWeeksPreviewComponent.new(start_date:, end_date:, interval:, entries:) %>

  <div class="tw-grid tw-grid-cols-6">
    <b>Abwesenheit</b>
    <b>Montag</b>
    <b>Dienstag</b>
    <b>Mittwoch</b>
    <b>Donnerstag</b>
    <b>Freitag</b>

    <% previous_week = nil %>

    <div class="tw-mt-6">
      <b></b>
    </div>

    <% (1..5).each do |i| %>
      <div>
        <div class="form-group boolean">
          <div class="checkbox">
            <label class="boolean optional">
              <input
                data-action="click->absence-rule#selectDayPart"
                data-dow="<%= i %>"
                data-part="morning"
                data-abstract="true"
                class="boolean optional"
                type="checkbox"
                <%= "checked=checked" if @absence_rule.absence_rule_entries.any? { |e| e.dow == i && e.absent_morning } %>
                <%#= "disabled=disabled" if action_name == "edit" %>
              >
                Morgen
            </label>
          </div>
        </div>

        <div class="form-group boolean">
          <div class="checkbox">
            <label class="boolean optional">
              <input
                data-action="click->absence-rule#selectDayPart"
                data-dow="<%= i %>"
                data-part="afternoon"
                data-abstract="true"
                class="boolean optional"
                type="checkbox"
                value="0"
                <%= "checked=checked" if @absence_rule.absence_rule_entries.any? { |e| e.dow == i && e.absent_afternoon } %>
                <%#= "disabled=disabled" if action_name == "edit" %>
              >
                Nachmittag
              </label>
          </div>
        </div>
      </div>
    <% end %>

    <% if params[:debug].blank? %><div class="tw-hidden"><% end %>

    <%= f.simple_fields_for :absence_rule_entries do |e| %>
      <% if previous_week != e.object.week %>
        <div class="">
          <b>KW <%= e.object.week %></b>
        </div>

        <% previous_week = e.object.week %>
      <% end %>

      <div>
        <%= e.input :id, as: :hidden %>
        <%= e.input :week, as: :hidden %>
        <%= e.input :dow, as: :hidden %>

        <%= e.input :absent_morning, label: 'Morgen', input_html: { data: { week: e.object.week, dow: e.object.dow, part: "morning", abstract: "false" } } %>
        <%= e.input :absent_afternoon, label: 'Nachmittag', input_html: { data: { week: e.object.week, dow: e.object.dow, part: "afternoon", abstract: "false" } } %>
      </div>
    <% end %>

    <% if params[:debug].blank? %></div><% end %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, class: "btn btn-primary" %>
    <%= link_to "Abbrechen", absence_rules_path, class: "btn btn-secondary" %>
  </div>
<% end %>

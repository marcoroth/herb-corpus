<% content_for :page_title, "Abwesenheitsregeln" %>
<% content_for :page_subtitle, "Alle" %>

<div class="container-fluid mt--6">
  <%= render PageHeaderComponent.new(button_text: "Neue Abwesenheitsregel", button_url: new_absence_rule_path) %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_card_content do %>
      <%= render CardTableComponent.new do |table| %>
        <%= table.with_header { "Grund" } %>
        <%= table.with_header { "Mitarbeiter/in" } %>
        <%= table.with_header { "Pensum" } %>
        <%= table.with_header { "Gültigkeit" } %>
        <%= table.with_header { "Aktionen" } %>

        <% @absence_rules.each do |rule| %>
          <%= table.with_row do |row| %>
            <%= row.with_cell { link_to rule.name, edit_absence_rule_path(rule) } %>
            <%= row.with_cell { link_to rule.user.name, absence_rules_user_path(rule.user) } %>
            <%= row.with_cell { "#{rule.working_percent}%" } %>
            <%= row.with_cell { rule.date_text } %>

            <%= row.with_cell do %>
              <%= render DropdownComponent.new do |dropdown| %>
                <% dropdown.with_item { link_to "Anzeigen", edit_absence_rule_path(rule) } %>
                <% dropdown.with_item { link_to "Bearbeiten", edit_absence_rule_path(rule) } %>
                <% dropdown.with_item { link_to "Löschen", rule, data: { turbo_confirm: "Möchtest du wirklich #{rule.user.name}'s Abwesenheitsregel löschen?", turbo_method: "delete" } } %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>

<% content_for :page_title, "Konflikt-Kalender #{I18n.t("date.month_names")[@start_date.month]} #{@start_date.year}" %>
<% content_for :page_subtitle, "#{@blocks.first.date.to_fs(:default)} bis #{@blocks.last.date.to_fs(:default)}" %>

<style>

#planer {
  margin-left: 10px;
  margin-bottom: 50px;
}

#planer th {
  border: 1px solid black;
}

#planer td {
  border: 1px solid black;
  border-left: none;
  border-right: none;
}

#planer td:nth-child(4n+1) {
  border-right: 1px solid black;
}

#planer td:hover {
  background: lightgray;
  cursor: pointer;
}

#planer td:first-child {
  width: 100px;
  border-left: 1px solid black
}

#planer td,  #planer th {
  text-align: center;
  font-size: 9pt;
}

#planer th {
  -moz-transform: rotate(270deg);
  -o-transform: rotate(270deg);
  -webkit-transform: rotate(270deg);
  transform: rotate(270deg);
  height: 60px;
  width: 20px;
}

.free {
  background: #e0a800;
  color: black;
}

.used {
  background: brown;
  color: brown;
}

.absence {
  background: blue;
  color: blue;
}

.partially {
  background: #28a745;
  color: #28a745 !important;
}

.partially a {
  color: black !important;
}

.holiday {
  background: purple !important;
  color: purple;
}

.holiday:hover {
  background: gray !important;
  color: lightgray;
}

.weekend {
  background: gray !important;;
  color: gray !important;;
}

.weekend:hover {
  background: gray;
  color: white;
}

.out_of_bounds {
  background: lightgray;
  color: lightgray;
}

.out_of_bounds:hover {
  background: gray !important;
  color: lightgray;
}

.conflict {
  background: orange !important;
  color: black;
}

</style>

<div class="container-fluid mt--6">
  <%= render PageHeaderComponent.new %>


  <%= render CardComponent.new do |card| %>
    <%= card.with_header do |header| %>
      <%= header.with_title do %>
        <form action="/planer/conflicts" method="get" data-controller="planer">
          <input type="hidden" value="<%= @start_date %>" name="start_date">

          <%= select_tag "user_id", options_from_collection_for_select(Employee.all, "id", "name", @user.id), data: { action: "change->planer#submit" } %>
        </form>
      <% end %>

      <%= header.with_button do %>
        <%= link_to "Verfügbarkeiten", planer_path(start_date: @start_date, user_id: @user), class: "btn btn-sm btn-white" %>
        <%= link_to "Konflikt-Kalender", planer_conflicts_path(start_date: @start_date, user_id: @user), class: "btn btn-sm tw-bg-gray-300 hover:tw-bg-gray-200" %>
        <%= link_to "Konflikt-Liste", conflicts_path(start_date: @start_date, user_id: @user), class: "btn btn-sm btn-white tw-mr-3" %>
        <%= link_to "Zurück", planer_conflicts_path(start_date: @previous_date, user_id: @user), class: "btn btn-sm btn-white" %>
        <%= link_to "Heute", planer_conflicts_path(start_date: Date.current, user_id: @user), class: "btn btn-sm btn-white" %>
        <%= link_to "Weiter", planer_conflicts_path(start_date: @next_date, user_id: @user), class: "btn btn-sm btn-white" %>
      <% end %>
    <% end %>

    <%= card.with_card_content do %>
      <% minimum_working_hour = (WorkingHour.minimum(:morning_start_time)&.hour || 7) - 1 %>
      <% maximum_working_hour = (WorkingHour.maximum(:afternoon_end_time)&.hour || 17) + 1 %>

      <h3 class="tw-ml-6 tw-mt-6"><%= "#{@blocks.first.date.to_fs(:default)} bis #{@blocks.last.date.to_fs(:default)}" %></h3>

      <div class="tw-ml-6 tw-mb-6"><br><br>
        <table id="planer">
          <tr>
            <th style="transform: rotate(0deg)"><%= @user.name %></th>
            <% @days.first.last.each do |block| %>
              <% next if block.start_time.hour < minimum_working_hour %>
              <% next if block.start_time.hour >= maximum_working_hour %>

              <% if block.start_time.min == 0 %>
                <th colspan="4"><%= block.start_time.to_fs(:time) %></th>
              <% end %>
            <% end %>
          </tr>

          <% @days.each do |day, blocks| %>
            <tr>
              <td><%= day.to_fs(:default) %></td>
              <% blocks.each do |block| %>
                <% next if block.start_time.hour < minimum_working_hour %>
                <% next if block.start_time.hour >= maximum_working_hour %>

                <td class="
                  <%= block.available ? ' free ' : '' %>
                  <%= block.has_appointment && !block.has_conflict ? 'partially' : '' %>
                  <%= block.weekend ? 'weekend' : '' %>
                  <%= !block.has_user_availability || !block.has_working_hour || block.has_holiday || block.has_absence || block.has_absence_rule ? 'out_of_bounds' : '' %>
                  <%= block.has_conflict ? 'out_of_bounds' : '' %>
                "
                data-toggle="tooltip"
                title="<%= block.time_text(only_time: true) %>, <%= block.conflicts_text %>"
                ><%= link_to ".".html_safe, user_block_path(block.long_id) %></td>
              <% end %>
            </tr>
          <% end %>
        </table>
      </div>
    <% end %>
  <% end %>
</div>

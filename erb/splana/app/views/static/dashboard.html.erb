<% content_for :page_title, 'Dashboard' %>

<div class="container-fluid mt--6">
  <%= render PageHeaderComponent.new %>

  <div class="row">
    <div class="col-12 col-lg-6 col-xl">
      <%= render DashboardCellComponent.new(title: "Kunden", number: Client.count, icon: "users") %>
    </div>
    <div class="col-12 col-lg-6 col-xl">
      <%= render DashboardCellComponent.new(title: "Daueraufträge", number: RecurringOrder.count, icon: "briefcase") %>
    </div>
    <div class="col-12 col-lg-6 col-xl">
      <%= render DashboardCellComponent.new(title: "Mitarbeiter", number: Worker.count, icon: "user") %>
    </div>
    <div class="col-12 col-lg-6 col-xl">
      <%= render DashboardCellComponent.new(title: "Gruppen", number: Group.count, icon: "users") %>
    </div>
  </div>

  <div class="row">
    <div class="col-12 col-lg-6 col-xl">
      <%= render DashboardCellComponent.new(title: "Diese Woche", icon: "clock") do %>
        <% appointments_this_week = UserBlock.distinct.this_week.pluck(:appointment_id, :start_time).map(&:first).compact %>
        <% conflicted_appointments_this_week = UserBlock.distinct.this_week.where(has_conflict: true).pluck(:appointment_id, :start_time).map(&:first).compact %>

        <div class="col-auto"><span class="h2 mr-2 mb-0">Termine: <%= appointments_this_week.count %></span></div>
        <div class="col-auto"><span class="h2 mr-2 mb-0">Konflikte: <%= conflicted_appointments_this_week.count %></span></div>
      <% end %>
    </div>

    <div class="col-12 col-lg-6 col-xl">
      <%= render DashboardCellComponent.new(title: "Nächste Woche", icon: "clock") do %>
        <% appointments_next_week = UserBlock.distinct.next_week.pluck(:appointment_id, :start_time).map(&:first).compact %>
        <% conflicted_appointments_next_week = UserBlock.distinct.next_week.where(has_conflict: true).pluck(:appointment_id, :start_time).map(&:first).compact %>

        <div class="col-auto"><span class="h2 mr-2 mb-0">Termine: <%= appointments_next_week.count %></span></div>
        <div class="col-auto"><span class="h2 mr-2 mb-0">Konflikte: <%= conflicted_appointments_next_week.count %></span></div>
      <% end %>
    </div>

    <div class="col-12 col-lg-6 col-xl">
      <%= render DashboardCellComponent.new(title: "Diesen Monat", icon: "clock") do %>
        <% appointments_this_month = UserBlock.distinct.this_month.pluck(:appointment_id, :start_time).map(&:first).compact %>
        <% conflicted_appointments_this_month = UserBlock.distinct.this_month.where(has_conflict: true).pluck(:appointment_id, :start_time).map(&:first).compact %>

        <div class="col-auto"><span class="h2 mr-2 mb-0">Termine: <%= appointments_this_month.count %></span></div>
        <div class="col-auto"><span class="h2 mr-2 mb-0">Konflikte: <%= conflicted_appointments_this_month.count %></span></div>
      <% end %>
    </div>

    <div class="col-12 col-lg-6 col-xl">
      <%= render DashboardCellComponent.new(title: "Nächsten Monat", icon: "clock") do %>
        <% appointments_next_month = UserBlock.distinct.next_month.pluck(:appointment_id, :start_time).map(&:first).compact %>
        <% conflicted_appointments_next_month = UserBlock.distinct.next_month.where(has_conflict: true).pluck(:appointment_id, :start_time).map(&:first).compact %>

        <div class="col-auto"><span class="h2 mr-2 mb-0">Termine: <%= appointments_next_month.count %></span></div>
        <div class="col-auto"><span class="h2 mr-2 mb-0">Konflikte: <%= conflicted_appointments_next_month.count %></span></div>
      <% end %>
    </div>
  </div>

  <%= render CardComponent.new do |card| %>
    <%= card.with_header do |header| %>
      <%= header.with_title { "Laufende Termine" } %>
    <% end %>

    <%= card.with_card_content do %>
      <%= render AppointmentTableComponent.new(appointments: Appointment.happening_now) %>
    <% end %>
  <% end %>
</div>

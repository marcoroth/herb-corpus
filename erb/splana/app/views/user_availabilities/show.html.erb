<% content_for :page_title, "Verfügbarkeit #{@user_availability.id}" %>
<% content_for :page_subtitle, "Verfügbarkeiten" %>

<div class="container-fluid mt--6">
  <%= render PageHeaderComponent.new(button_text: "Bearbeiten", button_url: edit_user_availability_path(@user_availability)) %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_body do %>
      <p>
        <strong>User:</strong>
        <%= @user_availability.user_id %>
      </p>

      <p>
        <strong>Start date:</strong>
        <%= @user_availability.start_date %>
      </p>

      <p>
        <strong>End date:</strong>
        <%= @user_availability.end_date %>
      </p>

      <p>
        <strong>Anzahl Blocks:</strong>
        <%= @user_availability.user_blocks.count %>
      </p>

      <%= render partial: "conflicts/partials/blocks", locals: { blocks: @user_availability.user_blocks } %>

      <%= link_to 'Zurück', user_availabilities_path, class: "btn btn-secondary" %>
    <% end %>
  <% end %>
</div>

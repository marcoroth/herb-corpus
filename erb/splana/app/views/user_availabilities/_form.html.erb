<%= simple_form_for(@user_availability) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.association :user, collection: Worker.all, label: "Mitarbeiter" %>
    <%= f.input :start_date, label: "Start-Datum", as: :only_date %>
    <%= f.input :end_date, label: "End-Datum (leer lassen falls unbefristet)", as: :only_date, required: false %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, class: "btn btn-primary" %>
    <%= link_to "Abbrechen", user_availabilities_path, class: "btn btn-secondary" %>
  </div>
<% end %>

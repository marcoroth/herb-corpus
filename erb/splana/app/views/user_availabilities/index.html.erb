<% content_for :page_title, "Verfügbarkeiten" %>
<% content_for :page_subtitle, "Alle" %>

<div class="container-fluid tw-mb-6 tw-pb-12">
  <%= render PageHeaderComponent.new(button_text: "Verfügbarkeit erfassen", button_url: new_user_availability_path) %>

  <%= render CardComponent.new(classes: "tw-pb-6") do |card| %>
    <%= card.with_header do |header| %>
      <%= header.with_title { "Verfügbarkeiten #{@date.year}" } %>

      <%= header.with_button do %>
        <%= link_to "#{@date.year - 1}", user_availabilities_path(date: @date - 1.year), class: "btn btn-sm btn-white" %>
        <%= link_to "Heute", user_availabilities_path(date: Date.current), class: "btn btn-sm btn-white" %>
        <%= link_to "#{@date.year + 1}", user_availabilities_path(date: @date + 1.year), class: "btn btn-sm btn-white" %>
      <% end %>
    <% end %>

    <%= card.with_card_content do %>
      <div class="tw-grid tw-grid-cols-2 tw-grid-cols-[200px_repeat(12,1fr)] tw-mt-6 tw-px-6 tw-gap-y-2 tw-divide-x">
        <div><%= @date.year %></div>
        <% 12.times do |i| %>
          <div class="tw-text-center">
            <%= I18n.t("date.month_names").compact[i] %>
          </div>
        <% end %>
      </div>

      <div class="tw-grid tw-grid-cols-2 tw-grid-cols-[200px_1fr] tw-mt-6 tw-px-6 tw-gap-y-2 tw-divide-y tw-divide-gray-300">
        <% @users.each do |user| %>
          <div class="text-muted tw-pt-2">
            <%= link_to user.name, availabilities_user_path(user) %>
          </div>

          <div>
            <div class="tw-w-full tw-h-9 tw-grid tw-grid-cols-12 tw-gap-2">
              <% blocks = UserBlock.in_blocks_of(1.day).for_user(user).for_year(@date).where(has_user_availability: true) %>

              <% (1..12).each do |month| %>
                <% month_blocks = blocks.select { |b| b.month == month } %>
                <% count = month_blocks.count %>
                <% shared_classes = "tw-border tw-border-gray-900 tw-text-center tw-text-xs tw-mt-2 tw-pt-1" %>

                <% if count >= Time.days_in_month(month, @date.year) %>
                  <div class="<%= shared_classes %> tw-bg-green-300"><%= link_to pluralize(Time.days_in_month(month, @date.year), "Tag", "Tage"), edit_user_availability_path(month_blocks.first.user_availability_id) %></div>
                <% elsif count.positive? %>
                  <div class="<%= shared_classes %> tw-bg-yellow-200"><%= link_to pluralize(count, "Tag", "Tage"), edit_user_availability_path(month_blocks.first.user_availability_id) %></div>
                <% else count.zero? %>
                  <div class="<%= shared_classes %> tw-bg-red-300" data-bs-toggle=tooltip data-bs-title="Neue Verfügbarkeit erstellen ab diesem Monat">
                    <%= link_to pluralize(count, "Tag", "Tage"), new_user_availability_path(user_id: user, start_date: Date.current.change(year: @date.year, month: month).beginning_of_month) %>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

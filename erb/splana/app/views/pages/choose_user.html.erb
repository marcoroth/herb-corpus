<div class="container">
<h1>Mitarbeiter austauschen</h1><br />

<% appointment = Appointment.first %>

<div class="row">
  <div class="col-md-6">
    <div class="white-box">
      <h3><%= appointment.name %></h3>

      <b>Zeit:</b> <%= appointment.start_time.to_s(:time) %> bis <%= appointment.end_time.to_s(:time) %> Uhr<br />
      <b>Ursprung:</b> <%= link_to appointment.source, appointment.source %><br /><br />

      <b>Mitarbeiter:</b> <br />
      <% appointment.users.each do |user| %>
        - <%= link_to user.name, user_path(user) %><br />
      <% end %>
    </div>
  </div>
  <div class="col-md-6">
    <div class="white-box">
      <h3>Auszutauschender Mitarbeiter</h3><br />

      <div class="row">
        <div class="col-xs-2 col-lg-2">
          <img src="<%= image_path("Claude.png") %>" class="img img-circle" width="100%" style="max-width: 100px"/>
        </div>
        <div class="col-xs-6 col-lg-6">
          <h3><%= User.first.name %></h3>
          <h4><small>Bereits eingeteilt</small></h4>
        </div>

      </div>
      </div>
    </div>
  </div>

  <br>


  <h2>Verfügbare Mitarbeiter</h2>

  <% User.all.take(20).group_by { |u| u&.group&.leader }.each do |leader, users| %>
    <% if leader.nil? %>
      <h2><small>Mitarbeiter ohne Gruppe</small></h2>
    <% else %>
      <h2><small>Gruppen von <%= leader&.name %></small></h2>
    <% end %>

    <div class="row">
      <% users.each do |user| %>
        <div class="col-sm-6 col-lg-4">
          <div class="white-box">
            <div class="row">
              <div class="col-xs-3 col-lg-3">
                <img src="<%= image_path("Claude.png") %>" class="img img-circle" width="100%" style="max-width: 100px"/>
              </div>
              <div class="col-xs-6 col-lg-6">
                <h3><%= user.name %></h3>
                <h4><small>Frei von 15:00 bis 16:00</small></h4>
              </div>
              <div class="col-xs-3 col-lg-3"><br>
                <a href="" class="btn btn-primary btn-sm">Austaushen</a>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

  <% end %>

</div>

<%= simple_form_for(client) do |form| %>
  <div class="">
    <div class="field">
      <%= form.input :salutation, label: "Anrede" %>
    </div>
  </div>

  <div class="tw-grid md:tw-grid-cols-2 tw-gap-x-4">
    <div class="field">
      <%= form.input :firstname, label: "Vorname" %>
    </div>

    <div class="field">
      <%= form.input :lastname, label: "Nachname" %>
    </div>
  </div>

  <div class="tw-grid md:tw-grid-cols-2 tw-gap-x-4">
    <div class="field">
      <%= form.input :email, label: "E-Mail" %>
    </div>

    <div class="field">
      <%= form.input :external_id, label: "Kundennummer" %>
    </div>
  </div>

  <div class="tw-grid md:tw-grid-cols-2 tw-gap-x-4">
    <div class="field">
      <%= form.input :phone_primary, label: "Telefonnummer" %>
    </div>

    <div class="field">
      <%= form.input :phone_secondary, label: "2. Telefonnummer" %>
    </div>
  </div>

  <div class="">
    <div class="field">
      <%= form.input :contact_person, label: "Kontakt-Person (z.B. bei Firmen)" %>
    </div>
  </div>

  <div class="tw-grid md:tw-grid-cols-2 tw-gap-x-4">
    <div class="field">
      <%= form.input :address, label: "Adresse" %>
    </div>

    <div class="field">
      <%= form.association :place, label: "Ort", collection: Place.labeled %>
    </div>
  </div>

  <div class="tw-grid md:tw-grid-cols-2 tw-gap-x-4">
    <div class="field">
      <%= form.association :leader, label: "Zuständiger Bauleiter/in" %>
    </div>

    <div class="field">
      <%= form.association :group, label: "Bevorzugte Gruppe" %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.button :submit, class: "btn btn-primary" %>
    <%= link_to "Abbrechen", (client_path(client) rescue clients_path), class: "btn btn-secondary" %>
  </div>
<% end %>

<div class="col-12 col-xl-8">
  <h3 class="text-muted">Daueraufträge</h3>

  <% @client.recurring_orders.each do |recurring_order| %>
    <%= render RecurringOrderCardComponent.new(recurring_order: recurring_order) %>
  <% end %>

  <% if @client.recurring_orders.none? %>
    <%= render CardComponent.new(classes: "tw-p-6") do |card| %>
      <% card.with_card_content { "Keine Daueraufträge" } %>
    <% end %>
  <% end %>
</div>

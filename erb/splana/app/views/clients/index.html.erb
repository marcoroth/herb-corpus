<% content_for :page_title, "Kunden" %>
<% content_for :page_subtitle, "Alle" %>

<div class="tw-h-full" data-controller="clients">
  <div class="tw-h-full tw-overflow-hidden">

    <div class="tw-flex tw-min-w-0 tw-flex-1 tw-flex-col tw-overflow-hidden">
      <div class="tw-relative tw-z-0 tw-flex tw-flex-1 tw-overflow-hidden">
        <main class="tw-relative tw-z-0 tw-flex-1 tw-overflow-y-auto focus:tw-outline-none xl:tw-order-last">
          <!-- Breadcrumb -->
          <nav class="tw-flex tw-items-start tw-px-4 tw-py-3 sm:tw-px-6 lg:tw-px-8 xl:tw-hidden" aria-label="Breadcrumb">
            <a href="#" class="tw-inline-flex tw-items-center tw-space-x-3 tw-text-sm tw-font-medium tw-text-gray-900">
              <!-- Heroicon name: mini/chevron-left -->
              <svg class="tw--ml-2 tw-h-5 tw-w-5 tw-text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" />
              </svg>
              <span>Directory</span>
            </a>
          </nav>

          <article>
            <turbo-frame id="clients">
              <%= render template: "clients/show" if @client %>
            </turbo-frame>
          </article>
        </main>

        <%= render partial: "directory" %>
      </div>
    </div>
  </div>
</div>

<div class="col-12 <% unless action_name == "info" %> col-xl-4 tw-hidden lg:tw-block <% end %>">
  <%= render CardListComponent.new do |list| %>
    <%= list.with_item(title: "Anrede", value: @client.salutation) %>
    <%= list.with_item(title: "Kontakt-Person", value: @client.contact_person) %>
    <%= list.with_item(title: "Strasse", value: link_to(@client.address.presence || "Unbekannt", @client.maps_link, target: "_blank")) %>
    <%= list.with_item(title: "Ort", value: link_to(@client.place.presence ? "#{@client.place.postalcode} #{@client.place.name}" : "Unbekannt", @client.place)) %>
    <%= list.with_item(title: "Kundennummer", value: @client.external_id) %>
    <%= list.with_item(title: "E-Mail", value: @client.email) %>
    <%= list.with_item(title: "Telefonnummer", value: @client.phone_primary) %>
    <%= list.with_item(title: "2. Telefonnummer", value: @client.phone_secondary) if @client.phone_secondary %>
    <%= list.with_item(title: "Erstellt am", value: @client.created_at.to_fs(:default)) %>
    <%= list.with_item(title: "Anzahl Daueraufträge", value: @client.recurring_orders.count, separator: false) %>
  <% end %>
</div>

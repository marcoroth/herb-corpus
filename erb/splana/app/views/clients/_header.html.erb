<div class="container-fluid">
  <%= render PageHeaderComponent.new(title: @client.stylized_name, subtitle: @client.class.translated_name, button_text: "Bearbeiten", button_url: edit_client_path(@client)) do |header| %>
    <%= header.with_avatar(user: @client, size: "lg") %>

    <%= header.with_tab_list do |tabs| %>
      <%= tabs.with_tab(name: "Übersicht", url: client_path(@client)) %>
      <%= tabs.with_tab(name: "Termine", url: appointments_client_path(@client)) %>
      <%= tabs.with_tab(name: "Kalender", url: calendar_client_path(@client)) %>
      <%= tabs.with_tab(name: "Daueraufträge", url: recurring_orders_client_path(@client)) %>
      <%= tabs.with_tab(name: "Einzelaufträge", url: orders_client_path(@client)) %>
      <%= tabs.with_tab(name: "Konflikte", url: conflicts_client_path(@client)) %>
    <% end %>
  <% end %>
</div>

<aside class="tw-bg-white tw-hidden tw-w-96 tw-h-[100vh] tw-flex-shrink-0 tw-border-r tw-border-gray-200 xl:tw-order-first xl:tw-flex xl:tw-flex-col">
  <div class="tw-px-6 tw-pt-6 tw-pb-4">
    <h2 class="tw-text-lg tw-font-medium tw-text-gray-900">Kunden</h2>
    <p class="tw-mt-1 tw-text-sm tw-text-gray-600">Alle <%= @clients.values.flatten.count %> Kunden</p>

    <form class="tw-mt-6 tw-flex tw-space-x-4 tw-hidden" action="#">

      <div class="tw-min-w-0 tw-flex-1">
        <label for="search" class="tw-sr-only">Search</label>
        <div class="tw-relative tw-rounded-md tw-shadow-sm">
          <div class="tw-pointer-events-none tw-absolute tw-inset-y-0 tw-left-0 tw-flex tw-items-center tw-pl-3">
            <!-- Heroicon name: mini/magnifying-glass -->
            <svg class="tw-h-5 tw-w-5 tw-text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
            </svg>
          </div>
          <input type="search" name="search" id="search" class="tw-block tw-w-full tw-rounded-md tw-border-gray-300 tw-pl-10 focus:tw-border-pink-500 focus:tw-ring-pink-500 sm:tw-text-sm" placeholder="Search">
        </div>
      </div>

      <button type="submit" class="tw-inline-flex tw-justify-center tw-rounded-md tw-border tw-border-gray-300 tw-bg-white tw-px-3.5 tw-py-2 tw-text-sm tw-font-medium tw-text-gray-700 tw-shadow-sm hover:tw-bg-gray-50 focus:tw-outline-none focus:tw-ring-2 focus:tw-ring-pink-500 focus:tw-ring-offset-2">
        <!-- Heroicon name: mini/funnel -->
        <svg class="tw-h-5 tw-w-5 tw-text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M2.628 1.601C5.028 1.206 7.49 1 10 1s4.973.206 7.372.601a.75.75 0 01.628.74v2.288a2.25 2.25 0 01-.659 1.59l-4.682 4.683a2.25 2.25 0 00-.659 1.59v3.037c0 .684-.31 1.33-.844 1.757l-1.937 1.55A.75.75 0 018 18.25v-5.757a2.25 2.25 0 00-.659-1.591L2.659 6.22A2.25 2.25 0 012 4.629V2.34a.75.75 0 01.628-.74z" clip-rule="evenodd" />
        </svg>
        <span class="tw-sr-only">Search</span>
      </button>

    </form>
  </div>

  <nav class="tw-min-h-0 tw-flex-1 tw-overflow-y-auto" aria-label="Directory">
    <div class="tw-relative">
      <% @clients.each do |char, clients| %>

        <div class="tw-sticky tw-top-0 tw-z-10 tw-border-t tw-border-b tw-border-gray-200 tw-bg-gray-50 tw-px-6 tw-py-1 tw-text-sm tw-font-medium tw-text-gray-500">
          <h3><%= char %></h3>
        </div>

        <style>
          .client-name[data-active] span {
            color: white;
          }
        </style>

        <ul role="list" class="tw-relative tw-z-0 tw-divide-y tw-divide-gray-200">
          <% clients.each do |client| %>
            <li id="<%= dom_id(client, :directory) %>">
              <div <% if client == @client %>data-active <% end %> class="<%= dom_class(@client) %> tw-relative tw-flex tw-items-center tw-space-x-3 tw-px-6 tw-py-5 focus-within:tw-ring-2 focus-within:tw-ring-inset focus-within:tw-ring-pink-500 hover:tw-bg-gray-50 data-[active]:tw-bg-blue-700 text-white hover:data-[active]:tw-bg-blue-800 ">
                <div class="tw-flex-shrink-0">
                  <%= render AvatarComponent.new(user: client, size: "sm", url: client_path(client)) %>
                </div>

                <div class="tw-min-w-0 tw-flex-1">
                  <a data-action="click->clients#click" href="#" data-href="<%= client_path(client) %>" class="focus:tw-outline-none">
                    <span class="tw-absolute tw-inset-0" aria-hidden="true"></span>
                    <p <% if client == @client %>data-active <% end %> class="client-name tw-text-sm tw-font-medium tw-text-gray-900 data-[active]:tw-text-white"><%= client.stylized_name %></p>
                    <p <% if client == @client %>data-active <% end %> class="client-address tw-truncate tw-text-sm tw-text-gray-500 data-[active]:tw-text-white"><%= client.address %><br/><%= client.place&.postalcode %> <%= client.place %></p>
                  </a>
                </div>

              </div>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </nav>
</aside>

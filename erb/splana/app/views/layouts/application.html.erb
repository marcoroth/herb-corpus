<!DOCTYPE html>
<html lang="de">
  <head>
    <% title = yield(:page_title).present? ?  yield(:page_title) : params[:controller].capitalize  %>
    <% subtitle = yield(:page_subtitle).present? ? yield(:page_subtitle) : params[:action].capitalize  %>

    <title><%= title %><% if subtitle && title != subtitle %> (<%= subtitle %>)<% end %> - Splana</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <%= render "layouts/current" %>
    <%= render "layouts/favicons" %>

    <%= stylesheet_link_tag "dartsass", media: 'all', "data-turbo-track": "reload" %>

    <%= vite_javascript_tag "packs/application", media: 'all', "data-turbo-track": "reload" %>
    <%= vite_stylesheet_tag "packs/application", media: 'all', "data-turbo-track": "reload" unless ViteRuby.instance.dev_server_running? %>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css" integrity="sha512-xh6O/CkQoPOWDdYTDqeRdPCVd1SpvCA9XXcUnZS2FmJNp1coAFzvtCN9BmamE+4aHK8yyUHUSCcJHgXloTyT2A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <%= vite_client_tag %>
  </head>

  <body>
    <%# render partial: "layouts/sidebar_modal_search" %>
    <%# render partial: "layouts/sidebar_modal_activity" %>
    <%= render partial: "layouts/sidebar"if user_signed_in? %>


    <style>
      .navbar-vertical-sm.navbar-expand-md.fixed-start:not([style*="display: none"])~.main-content {
        margin-left: 66px;
      }
    </style>

    <div class="main-content">
      <%= yield %>
    </div>

    <% if notice %>
      <%= turbo_stream.toast(notice) %>
    <% end %>
  </body>
</html>

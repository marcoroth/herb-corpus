<% return %>

<div class="mb-4" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-original-title="<%= current_user.layout == "wide" ? "Einklappen" : "Ausklappen" %>">
  <form action="<%= layout_path %>" method="post">
    <input type="hidden" name="layout" value="<%= current_user.layout == "wide" ? "small" : "wide" %>">

    <button class="btn w-100 btn-primary">
      <% if current_user.layout == "wide" %>
        <i class="fe fe-arrow-left"></i>
        <span class="ms-2">Einklappen</span>
      <% else %>
        <i class="fe fe-arrow-right"></i>
      <% end %>
    </button>

  </form>
</div>

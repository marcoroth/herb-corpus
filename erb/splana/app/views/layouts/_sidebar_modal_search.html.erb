<div class="modal fade" id="sidebarModalSearch" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-dialog-vertical" role="document">
    <div class="modal-content">
      <div class="modal-body" data-toggle="lists" data-options='{"valueNames": ["name"]}'>
        <form class="mb-4">
          <div class="input-group input-group-merge input-group-rounded">
            <input type="search" class="form-control form-control-prepended search" placeholder="Search">

            <div class="input-group-prepend">
              <div class="input-group-text">
                <span class="fe fe-search"></span>
              </div>
            </div>
          </div>
        </form>

        <div class="my-n3">
          <div class="list-group list-group-flush list">

            <% RecurringOrder.all.limit(5).each do |ro| %>
              <a class="list-group-item" href="/">
                <div class="row align-items-center">
                  <div class="col-auto">
                    <div class="avatar">
                      <img src="<%= random_header %>" alt="..." class="avatar-img rounded">
                    </div>
                  </div>
                  <div class="col ml-n2">
                    <h4 class="text-body mb-1 name"><%= ro.name %></h4>
                    <p class="small text-muted mb-0">
                      <span class="fe fe-clock"></span> <time datetime="2018-05-24">Updated 2hr ago</time>
                    </p>
                  </div>
                </div>
              </a>
            <% end %>

            <a class="list-group-item" href="/">
              <div class="row align-items-center">
                <div class="col-auto">
                  <div class="avatar">
                    <img src="<%= random_avatar_image %>" alt="..." class="avatar-img rounded-circle">
                  </div>
                </div>

                <div class="col ml-n2">
                  <h4 class="text-body mb-1 name">Dianna Smiley</h4>
                  <p class="text-body small mb-0">
                    <span class="text-success">●</span> Online
                  </p>
                </div>
              </div>
            </a>

            <a class="list-group-item" href="/">
              <div class="row align-items-center">
                <div class="col-auto">
                  <div class="avatar">
                    <img src="<%= random_avatar_image %>" alt="..." class="avatar-img rounded-circle">
                  </div>
                </div>

                <div class="col ml-n2">
                  <h4 class="text-body mb-1 name">Ab Hadley</h4>
                  <p class="text-body small mb-0">
                    <span class="text-danger">●</span> Offline
                  </p>
                </div>
              </div>
            </a>

          </div>
        </div>

      </div>
    </div>
  </div>
</div>

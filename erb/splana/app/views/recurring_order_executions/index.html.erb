<% content_for :page_title, "Daueraufträge" %>
<% content_for :page_subtitle, "Alle" %>

<div class="container-fluid mt--6 tw-pb-12">
  <%= render PageHeaderComponent.new(title:" Daueraufträge", button_text: "Neuer Dauerauftrag", button_url: new_recurring_order_path) do |header| %>
    <%= header.with_tab_list do |tabs| %>
      <%= tabs.with_tab(name: "Aktuelle", url: recurring_order_executions_path(scope: "current"), count: RecurringOrderExecution.current.count, active: :exact) %>
      <%= tabs.with_tab(name: "Zukünftige", url: recurring_order_executions_path(scope: "upcoming"), count: RecurringOrderExecution.upcoming.count, active: :exact) %>
      <%= tabs.with_tab(name: "Vergangene", url: recurring_order_executions_path(scope: "past"), count: RecurringOrderExecution.past.count, active: :exact) %>
      <%= tabs.with_tab(name: "Ungeplant", url: recurring_order_executions_path(scope: "unplanned"), count: RecurringOrder.unplanned.count, active: :exact) %>
    <% end %>
  <% end %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_header do |header| %>
      <%= header.with_title { "Daueraufträge" } %>
    <% end %>

    <%= card.with_card_content do %>
      <% if @executions.any? %>
        <%= render partial: "execution_list", locals: { executions: @executions } %>
      <% end %>

      <% if @recurring_orders.any? %>
        <%= render partial: "recurring_orders_list", locals: { recurring_orders: @recurring_orders } %>
      <% end %>
    <% end %>
  <% end %>
</div>

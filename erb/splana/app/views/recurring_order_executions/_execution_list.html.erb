<%= render CardTableComponent.new do |table| %>
  <%= table.with_header { "Name" } %>
  <%= table.with_header { "Jahr" } %>
  <%= table.with_header { "Kunde" } %>
  <%= table.with_header { "Adresse" } %>
  <%= table.with_header { "Anzahl Termine" } %>
  <%= table.with_header { "Bauleiter/in" } %>
  <%= table.with_header { Group.translated_name } %>
  <%= table.with_header { "Aktionen" } %>

  <% executions.each do |execution| %>
    <%= table.with_row do |row| %>
      <%= row.with_cell { link_to execution.recurring_order.name, execution } %>
      <%= row.with_cell { link_to execution.year, execution } %>
      <%= row.with_cell { link_to execution.client&.name, execution.client } %>
      <%= row.with_cell do %>
        <%= execution.client.address %>, <%= link_to execution.client.place %>
      <% end %>
      <%= row.with_cell { "#{execution.all_appointments.count}" } %>
      <%= row.with_cell { render AvatarComponent.new(user: execution.leader, size: "sm") } %>
      <%= row.with_cell { render AvatarGroupComponent.new(users: execution&.group&.users, size: "sm") } %>

      <%= row.with_cell do %>
        <%= render DropdownComponent.new do |dropdown| %>
          <% dropdown.with_item { link_to "Anzeigen", execution } %>
          <% dropdown.with_item { link_to "Bearbeiten", edit_recurring_order_execution_path(execution) } %>
          <% dropdown.with_item { link_to "Löschen", execution, data: { turbo_confirm: "Willst du diese Ausführung wirklich löschen?", turbo_method: "delete" } } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

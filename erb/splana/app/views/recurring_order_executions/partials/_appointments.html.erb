<% appointments ||= [] %>
<% grouped = appointments.group_by { |a| a.start_time.month } %>

<%= render CardComponent.new do |card| %>
  <%= card.with_card_content do %>
    <div class="row tw-p-4">
      <% (1..12).each do |month| %>
        <div class="col">
          <%= Date::MONTHNAMES[month][0] %><br/>
          <%= grouped[month]&.count || 0 %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

<%= render CardComponent.new do |card| %>
  <%= card.with_card_content do %>
    <div class="tw-p-4">
      <div class="row align-items-center">
        <div class="col"><h4 class="mb-0">Anzahl Termine</h4></div>
        <div class="col-auto">
          <%= appointments.count %> Termine
        </div>
      </div>

      <% @group.users.each do |user| %>
        <hr><div class="row align-items-center">
          <div class="col"><h4 class="mb-0">Konflikte <%= user.name %></h4></div>
          <div class="col-auto">
            <div class="btn-group btn-group-sm" role="group" id="<%= dom_id(user, "conflicts_count") %>">
              0 Konflikte
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

<%= render CardComponent.new do |card| %>
  <%= card.with_header do |header| %>
    <%= header.with_title do %>
      <%= appointments.count %> Termine
    <% end %>
  <% end %>

  <%= card.with_card_content do %>
    <div class="table-responsive mb-0 tw-min-h-[50vh] tw-max-h-[50vh] tw-overflow-auto" data-toggle="lists" data-lists-values="[&quot;goal-project&quot;, &quot;goal-status&quot;, &quot;goal-progress&quot;, &quot;goal-date&quot;]">
      <table class="table table-sm table-nowrap card-table">
        <tbody class="list">
          <% # Block.where(id: Block.where(user_id: 1).where("start_time BETWEEN date('2018-01-01') AND date('2019-12-31')").map(&:id)).available %>
          <% # Block.where(id: Block.where(user_id: 1).where("start_time BETWEEN date(?) AND (?)", appointment.start_time, appointment.end_time).map(&:id)).used %>

          <% available_results = {} %>

          <% grouped.each do |month, appointments| %>
            <tr class="table-info tw-sticky tw-top-0 tw-z-40 tw-mt-[-2px]">
              <th colspan="2"><%= I18n.t("date.month_names")[month] %> <%= appointments.first.start_time.year %> (<%= pluralize(appointments.count, "Termin", "Termine") %>)</th>
            </tr>

            <% appointments.each do |appointment| %>
              <tr>
                <td class="">
                  <div>
                    <div class="tw-mb-6 tw-py-2 tw-w-full tw-bg-white">
                      <%= appointment.start_time.utc.strftime("%a") %>, <%= appointment.start_time.to_date.to_fs(:default) %>,
                      <%= appointment.time_text(only_time: true) %>
                    </div>

                    <div class="tw-grid tw-grid-cols-[1fr_2fr] tw-gap-4 tw-gap-y-4">
                      <% @group.users.each do |user| %>
                        <% blocks = UserBlock.for_user(user).for_day(appointment.start_time.to_date).where("start_time BETWEEN ? and ?", appointment.start_time, appointment.end_time - 1.second) %>
                        <% available = blocks.pluck(:available).reduce(:&) %>

                        <% available_results[user.id] ||= [] %>
                        <% available_results[user.id] << available %>

                        <div>
                          <%= render AvatarComponent.new(user: user) %>
                          <%= user.name %>
                        </div>

                        <div class="">
                          <% if available %>
                            <span class="text-success">●</span> OK
                          <% else %>

                            <span class="text-danger">●</span> Konflikt (<%= blocks.map(&:reasons_raw).flatten.uniq.to_sentence %>)
                          <% end %>
                        </div>

                        <% end %>
                    </div>
                  </div>

                </td>
                <%# Block.where(id: Block.where(user_id: @group.users.map(&:id)).where("date(start_time) BETWEEN date(?) AND date(?)", appointment.start_time, appointment.end_time).map(&:id)).used.to_a %>
                <!-- <td><%#= render AvatarGroupComponent.new(users: @group.users) %></td>  -->
              </tr>
            <% end %>
          <% end %>

        </tbody>
      </table>
    </div>

    <% @group.users.each do |user| %>
      <turbo-stream action="replace" target="<%= dom_id(user, "conflicts_count") %>">
        <template>
          <%= conflicts = Array.wrap(available_results[user.id]).select { |i| !i }.count %> Konflikte
          (<%= ((conflicts.to_f / appointments.count.to_f) * 100.0).round rescue 0 %> %)
        </template>
      </turbo-stream>
    <% end %>

    <% if @stimulus_reflex %>
      <turbo-stream action="remove_css_class" target="appointments_preview" classes="tw-blur-sm"></turbo-stream>
      <turbo-stream action="remove_css_class" target="submit-button" classes="tw-hidden"></turbo-stream>

      <turbo-stream action="set_attribute" attribute="value" value="Terminserie mit <%= appointments.count %> Terminen erstellen" target="submit-button"></turbo-stream>
    <% end %>
  <% end %>

<% end %>

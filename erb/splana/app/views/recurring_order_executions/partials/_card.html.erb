<%= render CardComponent.new(classes: execution == current ? "bg-primary text-light" : "") do |card| %>
  <%= card.with_body do %>
    <div class="row align-items-center">
      <div class="col ml-n2">
        <h4 class="card-title mb-1 name"><%= link_to execution.to_s, execution %></h4>
        <p class="card-text small text-muted mb-1">
          <time><%= execution.start_date.to_s %> bis <%= execution.end_date.to_s(:time) %></time>
        </p>
      </div>
      <div class="col-auto">
        <%= render AvatarGroupComponent.new(users: execution.group&.users) %>
      </div>
    </div>
  <% end %>
<% end %>

<% range = (start_date.to_time)..(end_date.to_time) %>
<% appointments = (group&.appointments || Appointment.none).where(start_time: range) %>

<% appointments.each do |a| %>
  <% step = 15.minutes.to_i %>
  <% start_time = a.start_time %>
  <% end_time = a.end_time %>
  <% amount = (end_time-start_time).ceil/step %>

  <% if amount != 1 %>
    <% appointments -= [a] %>

    <% amount.times do |i| %>
      <% b = a.dup %>
      <% b.start_time = start_time + (i * step).seconds %>
      <% b.end_time = start_time + ((i+1) * step).seconds %>
      <% appointments += [b] %>
    <% end %>
  <% end %>
<% end %>

<% grouped_appointments = appointments.group_by { |a|
  time = a.start_time.floor_to(15.minutes).to_time
  [
    time.wday.to_s,
    time.hour.to_s,
    time.min.to_s
  ]
} %>

<table id="table" class="tw-w-full" data-reflex-permanent>
  <thead>
    <tr>
      <td>Uhrzeit</td>
      <td>Montag</td>
      <td>Dienstag</td>
      <td>Mittwoch</td>
      <td>Donnerstag</td>
      <td>Freitag</td>
    </tr>
  </thead>
  <tbody>

    <% (6..17).each do |block| %>
      <% if block == 12 || block == 13 %>
        <tr><td style="font-size: 3pt;">&nbsp;</td><tr>
      <% end %>

      <tr>
        <td>
          <span style="" class="tw-text-xs">
            <%= float_to_time(block) %> <span class="tw-hidden lg:tw-inline-block">bis <%= float_to_time(block+1.0) %></span>
          </span>
        </td>

        <% 5.times do |day| %>
          <td>
            <div class="tw-grid tw-place-content-start tw-grid-cols-4 px-1 md:px-2">
              <% 4.times do |hour| %>
                <% day_key = day+1 %>
                <% hour_key = float_to_time(block).split(":").first %>
                <% minute_key = hour*15 %>
                <% key_int = [day_key, hour_key.to_i, minute_key] %>
                <% key = key_int.map(&:to_s) %>
                <% amount = grouped_appointments[key].to_a.count  %>
                <% checked = @blocks.include?(key_int) %>

                <input
                  id="input-block-<%= key.join("-") %>"
                  type="checkbox"
                  name="appointment_series[blocks][]"
                  value="<%= (@series.start_date.to_time.utc + (day_key - 1).days + hour_key.to_i.hours + minute_key.to_i.minutes).to_i %>"
                  class="input-blocks tw-hidden"
                />


                <div
                  data-action="click->workload#blockUpdate"
                  data-value="<%= day_key %>/<%= hour %>"
                  data-checked="<%= checked ? 'true' : 'false' %>"
                  data-day="<%= day_key %>"
                  data-hour="<%= hour_key %>"
                  data-minute="<%= minute_key %>"
                  data-key="<%= key %>"
                  data-toggle="tooltip"
                  data-placement="top"
                  data-workload-target="block"
                  class="workload workload-<%= workload_color(amount, 52) %> <%= checked ? 'checked' : nil %>"
                  id="block-<%= key.join("-") %>"
                  title="<%= float_to_time(block+((hour+1)*0.25)) %>"
                ><%= amount %></div>
              <% end %>
            </div>
          </td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>

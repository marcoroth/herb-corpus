<%= render CardTableComponent.new do |table| %>
  <%= table.with_header { "Name" } %>
  <%= table.with_header { "Kunde" } %>
  <%= table.with_header { "Anzahl Termine" } %>
  <%= table.with_header { "Aktionen" } %>

  <% @recurring_orders.each do |recurring_order| %>
    <%= table.with_row do |row| %>
      <%= row.with_cell { link_to recurring_order.name, recurring_order } %>
      <%= row.with_cell { link_to recurring_order.client&.name, recurring_order.client } %>
      <%= row.with_cell { recurring_order.recurring_order_executions.map(&:all_appointments).map(&:count).sum.to_s } %>

      <%= row.with_cell do %>
        <%= render DropdownComponent.new do |dropdown| %>
          <% dropdown.with_item { link_to "Anzeigen", recurring_order_url(recurring_order) } %>
          <% dropdown.with_item { link_to "Bearbeiten", edit_recurring_order_path(recurring_order) } %>
          <% dropdown.with_item { link_to "Löschen", recurring_order_url(recurring_order), data: { turbo_confirm: "Möchtest du die Dauerauftrag '#{recurring_order.name}' wirklich löschen?", turbo_method: "delete" } } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= simple_form_for(@execution) do |f| %>
  <%= f.error_notification %>

  <div class="row">
    <div class="tw-grid md:tw-grid-cols-2 tw-gap-x-4">
      <%= f.input :start_date, label: "Start-Datum #{action_name == "new" ? "(Montag in KW1)" : "" }", as: :only_date %>
      <%= f.input :end_date, label: "End-Datum #{action_name == "new" ? "(Sonntag in KW52)" : "" }", as: :only_date %>
    </div>

    <div class="tw-grid md:tw-grid-cols-2 tw-gap-x-4">
      <%#= f.input :needed_workers, label: "Benötigte Mitarbeiter" %>
      <%#= f.input :duration, label: "Regelaufwand in Stunden pro Termin", input_html: { step: 0.25, default: "2", min: "0.25", max: "9.0" } %>
    </div>

    <div class="tw-grid md:tw-grid-cols-2 tw-gap-x-4">
      <%= f.association :group, label: "Zuständige Gruppe" %>
      <%= f.association :leader, label: Leader.translated_name %>
    </div>

    <div class="tw-grid md:tw-grid-cols-2 tw-gap-x-4">
      <%= f.input :address, label: "Adresse" %>
      <%= f.association :place, label: "Ort" %>
    </div>

    <div class="tw-grid md:tw-grid-cols-2 tw-gap-x-4">
      <%= f.input :report_number, label: "Auftragsnummer" %>
    </div>

    <%= f.input :recurring_order_id, as: :hidden %>

    <div class="form-actions">
      <%= f.button :submit, class: "btn btn-primary" %>
      <%= link_to "Abbrechen", @execution.recurring_order, class: "btn btn-secondary" %>
    </div>
  </div>
<% end %>

<%= simple_form_for(@working_hour, remote: false, local: true) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.input :name %>

    <div class="tw-grid md:tw-grid-cols-2">
      <div class="md:tw-mr-6">
        <%= f.input :morning_start_time, label: "Morgen Startzeit", as: :only_time %>
      </div>
      <div class="">
        <%= f.input :morning_end_time, label: "Morgen Endzeit", as: :only_time %>
      </div>
    </div>

    <div class="tw-grid md:tw-grid-cols-2">
      <div class="md:tw-mr-6">
        <%= f.input :afternoon_start_time, label: "Nachmittag Startzeit", as: :only_time %>
      </div>
      <div class="">
        <%= f.input :afternoon_end_time, label: "Nachmittag Endzeit",  as: :only_time %>
      </div>
    </div>

    <div class="tw-grid md:tw-grid-cols-2">
      <div class="md:tw-mr-6">
        <%= f.input :start_date, label: "Gültig von", as: :only_date %>
      </div>
      <div class="">
        <%= f.input :end_date, label: "Gültig bis", as: :only_date %>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <%= f.button :submit, class: "btn btn-primary" %>
    <%= link_to "Abbrechen", working_hours_path, class: "btn btn-secondary" %><br/><br/>

    <% if action_name == "edit" %>
      <%= link_to "Löschen", working_hour_path(@working_hour), class: "btn btn-danger", data: { turbo_confirm: "Willst du die #{@working_hour.name} wirklich löschen?", turbo_method: "delete" } %>
    <% end %>
  </div>
<% end %>

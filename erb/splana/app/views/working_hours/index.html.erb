<% content_for :page_title, "Arbeitszeiten" %>
<% content_for :page_subtitle, "Alle" %>

<div class="container-fluid mt--6">
  <%= render PageHeaderComponent.new(button_text: "Arbeitszeiten erfassen", button_url: new_working_hour_path) %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_header do |header| %>
      <%= header.with_title { "Arbeitszeiten (#{@working_hours.count})" } %>
    <% end %>

    <%= card.with_body do %>
      <div class="container-fluid"><br><br>
        <% if @working_hours.none? %>
          <div class="tw-mb-12">Keine Arbeitszeiten erfasst</div>
        <% end %>

        <% @working_hours.order(start_date: :asc).each do |working_hour| %>
          <%= link_to edit_working_hour_path(working_hour) do %>
            <h2><%= working_hour.start_date.to_fs(:default) %> bis <%= working_hour.end_date.to_fs(:default) %> <small><%= working_hour.name %></small></h2>
          <% end %>

          <table style="width: 100%; height: 25px">
            <tbody>
              <tr>
                <% i = Time.zone.parse("06:00") %>

                <% while (i) < Time.zone.parse("18:00") %>
                  <th colspan="4">| <%= i.to_fs(:time) %></th>
                  <% i += 60.minutes %>
                <% end %>
              </tr>
              <tr>
                <% i = Time.zone.parse("06:00") %>

                <% while (i) < Time.zone.parse("18:00") %>
                  <td data-toggle="tooltip" data-placement="top" title="<%= i.to_fs(:time) %> bis <%= (i + 15.minutes).to_fs(:time) %> " style="border: 1px solid black"
                    <% if working_hour.in_tod?(i) && working_hour.in_tod?(i + 15.minutes) %>
                      class="bg-success"
                    <% else %>
                      class="bg-danger"
                    <% end %>
                  >&nbsp;</td>
                  <% i += 15.minutes %>
                <% end %>
              </tr>
            </tbody>
          </table><br><br>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

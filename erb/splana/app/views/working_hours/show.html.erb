<% content_for :page_title, @working_hour.name %>
<% content_for :page_subtitle, "Arbeitsstunden" %>

<div class="container-fluid mt--6">
  <%= render PageHeaderComponent.new(button_text: "Bearbeiten", button_url: edit_working_hour_path(@working_hour)) %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_body do %>
      <div class="row el-element-overlay m-b-40">
        <div class="col-md-12">
          <p>
            <strong>Name:</strong>
            <%= @working_hour.name %>
          </p><br/>

          <p>
            <strong>Morning Working Hours:</strong>
            <% if @working_hour.morning_start_time && @working_hour.morning_end_time %>
              <%= @working_hour.morning_start_time.to_s(:time) %> bis
              <%= @working_hour.morning_end_time.to_s(:time) %>
            <% end %>
          </p><br/>

          <p>
            <strong>Afternoon Working Hours:</strong>
            <% if @working_hour.afternoon_start_time && @working_hour.afternoon_end_time %>
              <%= @working_hour.afternoon_start_time.to_s(:time) %> bis
              <%= @working_hour.afternoon_end_time.to_s(:time) %>
            <% end %>
          </p><br/>

          <p>
            <strong>Date Range:</strong>
            <%= @working_hour.start_date %> bis
            <%= @working_hour.end_date %>
          </p><br/>

          <p>
            <strong>Total working hours:</strong>
            <%= @working_hour.total_hours %>h
          </p><br/>

          <%= link_to 'Back', working_hours_path %>
        </div>
      </div>

    <% end %>
  <% end %>

</div>

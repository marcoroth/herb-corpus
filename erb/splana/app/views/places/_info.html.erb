<div class="col-12 col-xl-4">
  <%= render CardListComponent.new do |list| %>
    <%= list.with_item(title: "Kunden in #{@place.name}", value: @place.clients.count) %>
    <%= list.with_item(title: "Mitarbeiter in #{@place.name}", value: @place.users.count) %>
    <%= list.with_item(title: "Erstellt am", value: @place.created_at.to_fs(:default)) %>
    <%= list.with_item(title: "Kanton", value: @place.canton) %>
    <%= list.with_item(title: "Land", value: @place.country, separator: false) %>
  <% end %>
</div>

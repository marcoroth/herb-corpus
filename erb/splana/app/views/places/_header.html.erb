<div class="container-fluid">
  <%= render PageHeaderComponent.new(button_text: "Bearbeiten", button_url: edit_place_path(@place)) do |header| %>
    <%= header.with_tab_list do |tabs| %>
      <%= tabs.with_tab(name: "Übersicht", url: place_path(@place), active: :exclusive) %>
      <%= tabs.with_tab(name: "Kunden", url: clients_place_path(@place)) %>
      <%= tabs.with_tab(name: "Daueraufträge", url: recurring_orders_place_path(@place)) %>
      <%= tabs.with_tab(name: "Einzelaufträge", url: orders_place_path(@place)) %>
      <%= tabs.with_tab(name: "Termine", url: appointments_place_path(@place)) %>
      <%= tabs.with_tab(name: "Mitarbeiter", url: workers_place_path(@place)) %>
    <% end %>
  <% end %>
</div>

<%= simple_form_for(@place) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <div class="tw-grid md:tw-grid-cols-2 tw-gap-4">
      <%= f.input :name, label: "Ortschaft" %>
      <%= f.input :postalcode, label: "PLZ" %>
    </div>
    <%= f.input :country_code, collection: ISO3166::Country.all.map { |c| [c.translation(I18n.locale), c.alpha2] }, label: "Land" %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, class: "btn btn-primary" %>
    <%= link_to "Abbrechen", places_path, class: "btn btn-secondary" %>
  </div>
<% end %>

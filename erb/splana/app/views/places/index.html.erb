<% content_for :page_title, "Ortschaften" %>
<% content_for :page_subtitle, "Alle" %>

<div class="container-fluid">
  <%= render PageHeaderComponent.new(title: "Alle Ortschaften", button_text: "Neue Ortschaft", button_url: new_place_path) %>

  <div class="row">
    <% @places.each do |p| %>
      <% if p.clients.to_a.count > 0 %>
        <div class="col-xl-2 col-lg-3 col-sm-4 col-xs-6">

          <%= render CardComponent.new do |card| %>
            <%= card.with_body do %>
              <%= render DropdownComponent.new(classes: "card-dropdown") do |dropdown| %>
                <%= dropdown.with_item { link_to "Anzeigen", p } %>
                <%= dropdown.with_item { link_to "Bearbeiten", edit_place_path(p) } %>
              <% end %>

              <h2 class="card-title text-center mb-3 tw-overflow-hidden tw-whitespace-nowrap"><%= link_to "#{p.postalcode} #{p.name}", p %></h2>
              <p class="card-text text-center text-muted mb-4"><%= pluralize(p.clients.to_a.count, "Kunde", "Kunden") %> </p>

              <hr>

              <div class="row align-items-center">
                <div class="col-auto">
                  <%= render AvatarGroupComponent.new(users: p.clients.take(6), size: "xs", extra_classes: "pull-left", plus: p.clients.to_a.count-6) %>
                </div>
              </div>
            <% end %>
          <% end %>

        </div>
      <% end %>
    <% end %>
  </div>
</div>

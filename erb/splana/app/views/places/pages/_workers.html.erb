<div class="col-12 col-xl-8">
  <h3 class="text-muted">Mitarbeiter</h3>

  <% @place.users.each do |user| %>
    <%= render UserCardComponent.new(user: user) %>
  <% end %>

  <% if @place.users.none? %>
    <%= render CardComponent.new(classes: "tw-p-6") do |card| %>
      <% card.with_card_content { "Keine Mitarbeiter in #{@place.name}" } %>
    <% end %>
  <% end %>
</div>

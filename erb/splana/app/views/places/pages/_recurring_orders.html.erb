<div class="col-12 col-xl-8">
  <h3 class="text-muted">Daueraufträge</h3>

  <% Array.wrap(@place.recurring_order_executions).each do |execution| %>
    <%= render CardComponent.new(classes: "mb-3") do |card| %>
      <%= card.with_body do %>
        <div class="row align-items-center">
          <div class="col-auto"><%= render AvatarGroupComponent.new(users: execution.group&.users, size: "sm") %></div>
          <div class="col ml--2">
            <h4 class="card-title mb-1"><%= link_to "#{execution.recurring_order.name} #{execution.year}", execution %></h4>
            <h5 class="card-title mb-1 text-muted mt-3"><%= link_to execution.client.stylized_name, execution.client %></h5>
            <p class="card-text small text-muted"><%= execution.address %></p>
          </div>

          <div class="col-auto">
            <%= link_to "Anzeigen", execution, class: "btn btn-sm btn-primary d-none d-md-inline-block" %>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>

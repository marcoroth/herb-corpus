<div class="modal fade" id="modalMembers" tabindex="-1" role="dialog" aria-hidden="true" data-controller="appointment--employee">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-card card" data-toggle="lists" data-options='{"valueNames": ["name"]}'>
        <div class="card-header">

          <h4 class="card-header-title" id="exampleModalCenterTitle">
            Mitarbeiter hinzufügen
          </h4>

          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>

        <div class="card-header">
          <form>
            <div class="input-group input-group-flush input-group-merge">
              <input type="search" class="form-control form-control-prepended search" placeholder="Suche" />

              <div class="input-group-prepend">
                <div class="input-group-text">
                  <span class="fe fe-search"></span>
                </div>
              </div>
            </div>
          </form>
        </div>

        <div class="card-body">
          <ul class="list-group list-group-flush list my-n3">

            <% (appointment.users + Employee.all).uniq.each do |employee| %>
              <li class="list-group-item">
                <div class="row align-items-center">
                  <div class="col-auto">
                    <%= render AvatarComponent.new(user: employee, size: 'md') %>
                  </div>

                  <div class="col ml-n2">
                    <h4 class="mb-1 name">
                      <%= link_to employee.name, user_path(employee) %>
                    </h4>

                    <p class="small mb-0">
                      <span class="text-success">●</span> Online
                    </p>
                  </div>

                  <div class="col-auto">
                    <% if appointment.users.include?(employee) %>
                      <a
                        href="#"
                        class="btn btn-sm btn-primary"
                        data-reflex="click->AppointmentEmployeeReflex#remove_employee"
                        data-user-id="<%= employee.id %>"
                        data-appointment-id="<%= appointment.id %>"
                      >
                      Remove</a>
                    <% else %>
                      <span
                        href="#"
                        class="btn btn-sm btn-white"
                        data-reflex="click->AppointmentEmployeeReflex#add_employee"
                        data-user-id="<%= employee.id %>"
                        data-appointment-id="<%= appointment.id %>"
                      >
                      Add</span>
                    <% end %>
                  </div>
                </div>
              </li>
            <% end %>


          </ul>

        </div>
      </div>
    </div>
  </div>
</div>

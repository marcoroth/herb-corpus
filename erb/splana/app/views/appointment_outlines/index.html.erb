<% content_for :page_title, "Terminrahmenpläne" %>
<% content_for :page_subtitle, "Alle" %>

<div class="container-fluid mt--6">
  <%= render PageHeaderComponent.new %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_header do |header| %>
      <%= header.with_title { "Terminrahmenpläne" } %>
    <% end %>

    <%= card.with_card_content do %>
      <%= render CardTableComponent.new do |table| %>
        <%= table.with_header { "ID" } %>
        <%= table.with_header { "Name" } %>
        <%= table.with_header { "Ausführung" } %>
        <%= table.with_header { "Terminplanungsaufgaben" } %>
        <%= table.with_header { "Aktionen" } %>

        <% @outlines.each do |outline| %>
          <%= table.with_row do |row| %>
            <%= row.with_cell { link_to outline.id, outline } %>
            <%= row.with_cell { link_to outline.name, appointment_outline_path(outline) } %>
            <%= row.with_cell { link_to outline.recurring_order_execution, outline.recurring_order_execution } %>
            <%= row.with_cell { outline.appointment_planning_tasks.count.to_s } %>

            <%= row.with_cell do %>
              <%= render DropdownComponent.new do |dropdown| %>
                <% dropdown.with_item { link_to "Anzeigen", outline } %>
                <% dropdown.with_item { link_to "Bearbeiten", edit_appointment_outline_path(outline) } %>
                <% dropdown.with_item { link_to "Löschen", outline, data: { turbo_confirm: "Willst du den Terminrahmenplan '#{outline.name}' wirklich löschen?", turbo_method: "delete" } } %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

    <% end %>
  <% end %>
</div>

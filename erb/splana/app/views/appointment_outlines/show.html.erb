<% content_for :page_title, "Terminrahmenplan" %>
<% content_for :page_subtitle, "Terminrahmenpläne" %>

<div class="container-fluid mt--6">
  <%= render PageHeaderComponent.new(button_text: "Bearbeiten", button_url: edit_appointment_outline_path(@outline)) %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_body do %>

      <div class="tw-grid tw-grid-cols-[auto,auto,auto,auto,repeat(12,auto)] tw-justify-items-start tw-overflow-scroll tw-pb-6">
        <div class="tw-text-xs tw-sticky tw-left-0 tw-bg-white tw-border tw-border-black tw-w-full tw-grid tw-content-center tw-px-2">Monat</div>

        <div class="tw-text-xs tw-w-full tw-mb-3 tw-border tw-border-black tw-bg-white tw-h-full tw-grid tw-content-center tw-px-2">Art</div>
        <div class="tw-text-xs tw-w-full tw-mb-3 tw-border tw-border-black tw-bg-white tw-h-full tw-grid tw-content-center tw-px-2">Details</div>
        <div class="tw-text-xs tw-w-full tw-mb-3 tw-border tw-border-black tw-bg-white tw-h-full tw-grid tw-content-center tw-px-2">Status</div>

        <% 12.times do |i| %>
          <div class="tw-text-center tw-text-xs tw-w-full tw-mb-3 tw-border tw-border-black tw-bg-white tw-h-full tw-grid tw-content-center"><%= I18n.t("date.month_names")[i + 1][0..2] rescue "-" %></div>
        <% end %>

        <%= render partial: "appointment_outlines/row", locals: { outline: @outline } %>
      </div>
    <% end %>
  <% end %>

  <%= render CardComponent.new do |card| %>
    <%= card.with_body do %>
      <div id="<%= dom_id(@outline) %>">
        <p>
          <strong>Tätigkeit:</strong>
          <%= @outline.name %>
        </p>

        <p>
          <strong>Termine pro Jahr:</strong>
          <%= @outline.planned_appointments %>
        </p><br/>

        <strong>Terminplanungsaufgaben:</strong><br/>
        <ul>

          <% @outline.appointment_planning_tasks.each do |task| %>
            <li <% if task.due? %> class="tw-text-red-500" <% end %>>
              <% if task.done? %>
                <i class="fa fa-square-check"></i>
              <% else %>
                <i class="far fa-square"></i>
              <% end %>

              <%= link_to task.due_date.to_fs(:default), task %> - <%= task.date_text %>
            <li>
          <% end %>
        </ul><br/>

        <p>
          <strong>Dauerauftrag:</strong>
          <%= link_to @outline.recurring_order_execution %>
        </p>
      </div>

      <div class="tw-flex tw-gap-x-1 tw-mt-6">
        <%= button_to "Löschen", @outline, method: :delete, class: "btn btn-danger" %>
        <%= link_to "Zurück", appointment_outlines_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  <% end %>
</div>

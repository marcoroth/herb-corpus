<%= simple_form_for(@outline) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.input :name, label: "Tätigkeit" %>
    <%= f.input :recurring_order_execution_id, as: :hidden %>

    <div class="tw-grid tw-grid-cols-2 tw-gap-4">
      <%= f.input :duration, label: "Regelaufwand in Stunden pro Termin", input_html: { step: 0.5 } %>
      <%= f.input :needed_workers, label: "Benötige Mitarbeiter" %>
    </div>

    <% if action_name == "new" %>

    <fieldset class="tw-mb-6">
      <legend class="tw-text-base tw-font-medium tw-text-gray-900">Art</legend>

      <div class="tw-mt-4 tw-grid tw-grid-cols-2 tw-gap-y-6 lg:tw-grid-cols-2 tw-gap-4" data-action="click->appointment-outline#changeType">
        <% [
            ["per_year", "Anzahl Termine pro Jahr", ["15x pro Jahr", "1x in Mai, 2x in Juni, 2x in August, 1x in September"]],
            ["variable", "Manuell", ["auf Abruf", "fortlaufend planend"]],
          ].each do |id, one, two| %>

        <label class="tw-relative tw-flex tw-cursor-pointer tw-rounded-lg tw-border tw-bg-white tw-p-4 tw-shadow-sm focus:tw-outline-none">
          <span class="tw-flex tw-flex-1">
            <span class="tw-flex tw-flex-col">
              <span id="outline_type-<%= id %>-label" class="tw-block tw-text-sm tw-font-medium tw-text-gray-900"><%= one %></span>
              <span id="outline_type-<%= id %>-description" class="tw-mt-1 tw-flex tw-items-center tw-text-sm tw-text-gray-500">
                <span>

                  <% two.each do |o| %>
                    <span class=" tw-block tw-mb-3">
                      <%= "oder" if o != two.first %>
                      <%= "z.B." if o == two.first %>
                      <b class="tw-mt-3"><%= o %></b>
                    </span>
                  <% end %>
                </span>
              </span>
            </span>
          </span>

          <%#= f.input :outline_type, as: :radio_buttons, input_html: { data_appointment_outline_target: "outlineType", class: "tw-hidden", id: "value_type-#{id}" }, value: id %>

          <input type="radio" data-appointment-outline-target="outlineType" name="appointment_outline[outline_type]" value="<%= id %>" class="tw-hidden" id="outline_type-<%= id %>">
        </label>
        <% end %>
      </div>
    </fieldset>

    <%#= f.input :planned_appointments, label: "Geplante Termine pro Jahr" %>
    <%#= f.input :planned_hours, label: "Geplante Stunden pro Jahr" %>

    <div class="tw-hidden" data-outline-type="per_year">
      <div class="form-group float optional appointment_outline_duration">
        <label class="control-label float optional" for="appointment_outline_vorlauf">Vorlaufzeit für Planungserinnerungen in Tagen</label>
        <input class="form-control numeric optional" type="number" value="30" name="vorlauf" id="appointment_outline_vorlauf">
      </div>

      <label class="control-label float optional">Rahmenplan (Anzahl Termine pro Monat)</label><br/><br/>

      <div class="tw-grid tw-grid-cols-6 tw-gap-x-12 tw-gap-y-3">
        <% (1..12).each do |month| %>
          <div>
            <label class="control-label" for="month_<%= month %>"><%= I18n.t("date.month_names")[month] %></label><br/>

            <input class="form-control" type="number" name="month[<%= month %>]" value="0" id="month_<%= month %>">
          </div>
        <% end %>
      </div>
    </div>

    <div class="tw-hidden" data-outline-type="variable">
      <div class="form-group float optional appointment_outline_duration">
        <%= f.fields_for :appointment_planning_tasks do |task| %>
          <%= task.input :due_date, label: "Planungserinnerung am", as: :date %>
          <%= task.input :start_date, as: :hidden %>
          <%= task.input :end_date, as: :hidden %>
        <% end %>
      </div>
    </div>
  </div><br/>

  <% else %>
    <div class="form-group float optional appointment_outline_duration">
      <h3>Planungserinnerungen</h3>
      <div class="tw-grid tw-grid-cols-3 tw-gap-x-6">
        <%= f.fields_for :appointment_planning_tasks do |task| %>
          <%= task.input :due_date, label: "Planungserinnerung am", as: :date %>
          <%= task.input :start_date, label: "Termin geplant zwischen" %>
          <%= task.input :end_date, label: "und" %>
        <% end %>
      </div>
    </div>
  <% end %>

  <div>
    <%= f.input :details, as: :text, value: "", label: "Details/Notizen für die Terminplanung" %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, "Terminrahmenplan #{action_name == "new" ? "erstellen" : "aktualisieren"}", class: "btn btn-primary", id: "submit-button" %>
    <%= link_to "Zurück", @outline.recurring_order_execution, class: "btn btn-secondary" %>
  </div>
<% end %>

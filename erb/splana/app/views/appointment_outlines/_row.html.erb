<div class="tw-sticky tw-left-0 tw-bg-white tw-border tw-border-black tw-w-full tw-text-xs tw-grid tw-content-center tw-px-2">
  <%= link_to "#{outline.name}", appointment_outline_path(outline) %>
</div>

<div class="tw-border tw-border-black tw-h-[30px] tw-w-full tw-text-xs tw-grid tw-bg-white tw-content-center tw-px-2 hover:tw-bg-gray-100" %>
  <%= link_to "Terminrahmenplan", appointment_outline_path(outline) %>
</div>

<div class="tw-border tw-border-black tw-h-[30px] tw-w-full tw-text-xs tw-grid tw-bg-white tw-content-center tw-px-2 hover:tw-bg-gray-100" %>
  <%= "#{outline.appointment_planning_tasks.count} vorgeplante Termine - #{outline.appointment_planning_tasks.assigned.count} geplant, #{outline.appointment_planning_tasks.unassigned.count} ungeplant" %>
</div>

<div class="tw-border tw-border-black tw-h-[30px] tw-w-full tw-text-xs tw-grid tw-bg-white tw-content-center tw-px-2 hover:tw-bg-gray-100" %>
  <%= "#{outline.appointment_planning_tasks.unresolved.count} überfällige Termine" %>
</div>

<% if outline.appointment_planning_tasks.any? %>
  <% if outline.outline_type == "per_year" %>
    <% 12.times do |i| %>
      <% outlined_appointments = outline.appointment_planning_tasks.where("? BETWEEN start_date AND end_date", (outline.recurring_order_execution.start_date + i.months)) %>
      <% planned_appointments = outlined_appointments.where.not(appointment_id: nil) %>

      <div data-bs-toggle="tooltip" data-bs-title="<%= outlined_appointments.count.positive? ? "#{planned_appointments.count} geplant / #{outlined_appointments.count} vorgeplant" : "-" %>" class="tw-border tw-border-black tw-h-[30px] tw-w-full tw-text-center tw-text-xs tw-grid tw-content-center <%= outlined_appointments.unresolved.count.positive? ? "tw-bg-red-300 hover:tw-bg-red-200" : "tw-bg-white hover:tw-bg-gray-100" %>">
        <%= outlined_appointments.count.positive? ? "#{planned_appointments.count} / #{outlined_appointments.count}" : "-" %>
      </div>
    <% end %>
  <% else %>
    <% 12.times do |i| %>
      <% date = (@execution.start_date + i.months) %>
      <% outlined_appointments = outline.appointment_planning_tasks.where("due_date BETWEEN ? AND ?", date.beginning_of_month, date.end_of_month) %>
      <% planned_appointments = outlined_appointments.where.not(appointment_id: nil) %>

      <div data-bs-toggle="tooltip" data-bs-title="<%= outlined_appointments.count.positive? ? "#{planned_appointments.count} geplant / #{outlined_appointments.count} vorgeplant" : "-" %>" class="tw-border tw-border-black tw-h-[30px] tw-w-full tw-text-center tw-text-xs tw-grid tw-content-center <%= outlined_appointments.unresolved.count.positive? ? "tw-bg-red-300 hover:tw-bg-red-200" : "tw-bg-white hover:tw-bg-gray-100" %>">
        <%= outlined_appointments.count.positive? ? "#{planned_appointments.count} / #{outlined_appointments.count}" : "-" %>
      </div>
    <% end %>
  <% end %>

<% else %>
  <div class="tw-col-start-[5] tw-col-end-[17] tw-border tw-border-black tw-h-[30px] tw-w-full tw-text-center tw-text-xs tw-grid tw-content-center tw-bg-white hover:tw-bg-gray-100"><%= "-" %></div>
<% end %>

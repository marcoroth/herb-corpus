<%= render CardTableComponent.new do |table| %>
  <%= table.with_header { "Name" } %>
  <%= table.with_header { "Uhrzeit" } %>
  <%= table.with_header { "Gruppe" } %>
  <%= table.with_header { "Herkunft" } %>
  <%= table.with_header { "Kunde" } %>
  <%= table.with_header { "Bauleiter" } %>
  <%= table.with_header { "Mitarbeiter" } %>
  <%= table.with_header { "Aktionen" } %>

  <% @appointments.each do |appointment| %>
    <%= table.with_row do |row| %>
      <%= row.with_cell { link_to appointment.name, appointment } %>
      <%= row.with_cell { appointment.time_text } %>
      <%= row.with_cell { link_to appointment.group, appointment.group if appointment.group } %>
      <%= row.with_cell { appointment.source ? link_to(appointment.source) : "Einzeltermin" } %>

      <%= row.with_cell { render AvatarComponent.new(user: appointment.client, size: "sm", url: client_path(appointment.client)) if appointment.client } %>
      <%= row.with_cell { render AvatarComponent.new(user: appointment.leader, size: "sm") } %>
      <%= row.with_cell { render AvatarGroupComponent.new(users: appointment&.group&.users, size: "sm") } %>

      <%= row.with_cell do %>
        <%= render DropdownComponent.new do |dropdown| %>
          <% dropdown.with_item { link_to "Anzeigen", appointment } %>
          <% dropdown.with_item { link_to "Bearbeiten", edit_appointment_path(appointment) } %>
          <% dropdown.with_item { link_to "Löschen", appointment, data: { turbo_confirm: "Möchtest du den Termin '#{appointment.name}' wirklich löschen?", turbo_method: "delete" } } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

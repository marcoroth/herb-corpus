<div class="card-header">
  <div class="row align-items-center">
    <div class="col">
      <h4 class="card-header-title">
        <%= title %>
      </h4>
    </div>

    <% if button? %>
      <div class="col-auto">
        <%= button %>
      </div>
    <% end %>
  </div>

  <% if tabs.any? %>
    <ul class="nav nav-tabs nav-tabs-sm card-header-tabs">
      <% tabs.each do |tab| %>
        <li class="nav-item">
          <%= tab %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>

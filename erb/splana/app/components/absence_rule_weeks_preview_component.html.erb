<div id="weeks">
  <h3 class="">Abwesenheitsregel gilt in folgenden KWs:</h3>


  <div class="tw-mb-12 tw-grid tw-grid-cols-2 md:tw-grid-cols-6 lg:tw-grid-cols-12 tw-gap-1">
    <% s = @start_date.beginning_of_week %>
    <% ar_dates = [] %>

    <% while (s + @interval) < (@end_date.end_of_week + @interval) %>
      <% ar_dates << s %>
      <% s += @interval %>
    <% end %>

    <% s = @start_date.beginning_of_week %>

    <% while s + 1.week < @end_date.end_of_week + 1.week %>
      <div data-selected="" data-action="click->absence-rule#selectWeek" data-week="<%= s.cweek %>" class="data-week-selection tw-text-center tw-border tw-cursor-pointer tw-border-gray-900 text-white data-[selected=true]:tw-bg-[#00D97E] data-[selected=false]:tw-bg-[#E63757]" data-bs-toggle="tooltip" data-bs-title="<%= s.beginning_of_week.to_fs(:default) %> - <%= s.end_of_week.to_fs(:default) %>">
        KW<%= s.cweek.to_s.rjust(2, '0') %>
      </div>
      <% s += 1.week %>
    <% end %>


  </div>
</div>

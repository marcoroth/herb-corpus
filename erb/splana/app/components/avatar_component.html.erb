<%= content_tag tag_name, href: link_to_url, class: "avatar avatar-#{@size} #{@extra_classes}", data: { toggle: 'tooltip' }, title: title do %>
  <% if @user %>
    <% if users.include?(@user.firstname) %>
      <%= image_tag(asset_path(@user.firstname + '.png'), class: 'avatar-img rounded-circle') %>
    <% else %>
      <span class="avatar-title avatar-img rounded-circle"><%= @user.initials %></span>
    <% end %>
  <% else %>
    <span class="avatar-title avatar-img rounded-circle">?</span>
  <% end %>
<% end %>

<%= render CardComponent.new do |card| %>
  <%= card.with_body do %>
    <div class="row align-items-center">
      <div class="col-auto">
        <%= render AvatarComponent.new(user: absence.user, size: "md", url: absence_path(absence)) %>
      </div>

      <div class="col ms-n2">
        <%= link_to absence do %>
          <h4 class="mb-1">
            <%= absence.name %> (<%= absence.absence_type&.name %>)
          </h4>

          <small class="text-muted">
            <i class="fe fe-clock"></i> <%= absence.time_text %>
          </small>
        <% end %>
      </div>

      <div class="col-auto">
        <%= render DropdownComponent.new do |dropdown| %>
          <% dropdown.with_item { link_to "Anzeigen", absence_url(absence) } %>
          <% dropdown.with_item { link_to "Bearbeiten", edit_absence_url(absence) } %>
          <% dropdown.with_item { link_to "Löschen", absence_url(absence), data: { turbo_confirm: "Möchtest du die Absenz '#{absence.name}' wirklich löschen?", turbo_method: "delete" } } %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>

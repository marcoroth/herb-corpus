<% if @title %>
  <h4><small class="text-muted"><%= @appointment.time_text %></small></h4>
<% end %>

<%= render CardComponent.new(classes: @classes) do |card| %>
  <% if @header %>
    <%= card.with_header do |header| %>
      <%= header.with_title do %>
        <%= @header %>
      <% end %>
    <% end %>
  <% end %>

  <%= card.with_body do %>
    <div class="row align-items-center">
      <% if @leader %>
        <div class="col-auto">
          <%= render AvatarComponent.new(user: @appointment.group_leader, size: "md") %>
        </div>
      <% end %>

      <div class="col ml--2">
        <h4 class="card-title mb-1 name <% if conflict? %> tw-text-red-500 <% end %>">
          <% if conflict? %>
            <i class="fa fa-triangle-exclamation" data-bs-toggle="tooltip" data-bs-title="<%= conflict_reasons_by_user.map { |user, reasons| "#{user.name}: #{reasons.to_sentence}"}.join(" - ") %>"></i>
          <% end %>
          <%= link_to @appointment.name, @appointment %>
        </h4>

        <% if @client %>
          <p class="card-text small text-muted mb-1">
            Kunde: <%= link_to @appointment.client.name, @appointment.client %> • <%= link_to "#{@appointment.address}, #{@appointment.place}", @appointment.maps_link %>
          </p>
        <% end %>

        <%#= conflict_reasons %>

        <p class="card-text small text-muted">
          <i class="fe fe-clock"></i> <%= @appointment.time_text %>
          <% if @duration %>
            , Dauer: <%= (@appointment.end_time-@appointment.start_time)/60.0/60.0 %>h
          <% end %>
        </p>
      </div>

      <% if @avatar_group %>
        <div class="col-auto">
          <%= render AvatarGroupComponent.new(users: @appointment.users) %>
        </div>
      <% end %>

      <% if @dropdown %>
        <div class="col-auto">
          <%= render DropdownComponent.new do |dropdown| %>
            <% dropdown.with_item { link_to "Anzeigen", @appointment } %>
            <% dropdown.with_item { link_to "Bearbeiten", edit_appointment_path(@appointment) } %>
            <% dropdown.with_item { link_to "Verschieben", edit_appointment_path(@appointment) } %>
            <% dropdown.with_item { link_to "Löschen", appointment_path(@appointment), data: { turbo_confirm: "Möchtest du den Termin '#{@appointment.name}' vom #{@appointment.start_time.to_date.to_fs(:default)} wirklich löschen?", turbo_method: "delete" } } %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

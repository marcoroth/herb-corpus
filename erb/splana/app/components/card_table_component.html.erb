<div class="table-responsive tw-pb-6" style="min-height: 300px"  data-toggle="lists" data-options='{"valueNames": <%= header_names %> }'>
  <table class="table table-sm table-nowrap card-table">
    <thead>
      <tr>
        <% headers.each_with_index do |header, index| %>
          <th><a href="#" class="text-muted sort" data-sort="<%= header_names[index] %>"><%= header %></a></th>
        <% end %>
      </tr>
    </thead>

    <tbody class="list">
      <% rows.each do |row| %>
        <%= row %>
      <% end %>
    </tbody>
  </table>
</div>

<%= render CardComponent.new do |card| %>
  <%= card.with_body do %>
    <div class="row align-items-center">
      <div class="col">
        <h6 class="card-title text-uppercase text-muted mb-2"><%= @title %></h6>

        <% if @number %>
          <span class="h2 mb-0"><%= @number %></span>
          <span class="badge badge-soft-success mt--1"></span>
        <% else %>
          <div class="align-items-center no-gutters">
            <%= content %>
          </div>
        <% end %>
      </div>

      <div class="col-auto"><span class="h2 fe fe-<%= @icon %> text-muted mb-0"></span></div>
    </div>
  <% end %>
<% end %>

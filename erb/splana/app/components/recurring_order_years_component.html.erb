<div class="row align-items-center">
  <div class="col">
    <ul class="nav nav-tabs nav-overflow header-tabs">
      <% if @recurring_order.current_execution %>
        <li class="nav-item"><%= active_link_to "Übersicht", recurring_order_execution_path(@recurring_order.current_execution), class: "nav-link" %></li>
      <% elsif @recurring_order.next_execution %>
        <li class="nav-item"><%= active_link_to "Übersicht", recurring_order_execution_path(@recurring_order.next_execution), class: "nav-link" %></li>
      <% else %>
        <li class="nav-item"><%= active_link_to "Übersicht", recurring_order_path(@recurring_order), class: "nav-link" %></li>
      <% end %>

      <% if @recurring_order.current_execution && @recurring_order.next_execution %>
        <li class="nav-item"><%= active_link_to "Nächste Ausführung", recurring_order_execution_path(@recurring_order.next_execution), class: "nav-link" %></li>
      <% end %>

      <% if !@recurring_order.next_execution %>
        <li class="nav-item"><%= active_link_to "Nächste Ausführung planen", new_recurring_order_execution_path(recurring_order_id: @recurring_order.id), class: "nav-link" %></li>
      <% end %>

      <% if @recurring_order.past_executions.any? && @recurring_order.recurring_order_executions.count > 1 %>
        <li class="nav-item"><%= active_link_to "Alle Ausführungen", recurring_order_path(@recurring_order), class: "nav-link" %></li>
      <% end %>
    </ul>
  </div>
</div>

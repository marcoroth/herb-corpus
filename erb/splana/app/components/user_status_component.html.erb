<div class="<%= @extra_classes %>">
  <%= render CardComponent.new(classes: "mb-3") do |card| %>
    <%= card.with_body do %>
      <div class="row align-items-center">
        <div class="col-auto">
          <%= render AvatarComponent.new(user: user, size: "lg", extra_classes: "avatar-img rounded-circle") %>
        </div>
        <div class="col ml-n2">
          <h4 class="card-title mb-1"><%= link_to user.name, user_path(user) %></h4>
          <p class="card-text small text-muted mb-1"><%= user.group.try(:name) %></p>

          <p class="card-text small">
            <% if user.type == "Employee" %>
              <% appoinement = Appointment.for_user(user).happening_now.first %>
              <% next_appoinement = Appointment.for_user(user).upcoming.first %>

              <% if appoinement %>
                <span class="text-success">●</span> Aktuell: <%= link_to appoinement %>
              <% elsif next_appoinement %>
                <span class="text-info">●</span> Nächster Termin: <%= link_to next_appoinement %>
              <% else %>
                <span class="text-warning">●</span> Zurzeit kein Termin
              <% end %>
          <% else %>
            <%= user.class.translated_name %>
          <% end %>
          </p>
        </div>

        <div class="col-auto">
          <%= render DropdownComponent.new do |dropdown| %>
            <% dropdown.with_item { link_to "Anzeigen", user_path(user) } %>
            <% dropdown.with_item { link_to "Bearbeiten", edit_user_path(user) } %>
            <% dropdown.with_item { link_to "Löschen", user_path(user), data: { turbo_confirm: "Bist du sicher, dass du #{user.name} wirklich löschen willst?", turbo_method: "delete" } } %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

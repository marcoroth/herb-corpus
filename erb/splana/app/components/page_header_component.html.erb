<div class="header">
  <div class="header-body">
    <div class="row align-items-center">
      <% if avatar? %>
        <div class="col-auto">
          <%= avatar %>
        </div>
      <% end %>

      <div class="col">
        <% if @subtitle %>
          <h6 class="header-pretitle"><%= @subtitle.is_a?(String) ? @subtitle : content_for(:page_subtitle) %></h6>
        <% end %>
        <h1 class="header-title"><%= @title || content_for(:page_title) %></h1>
      </div>

      <% if labeled_avatars.any? %>
        <% labeled_avatars.each do |labeled_avatar| %>
          <%= labeled_avatar %>
        <% end %>
      <% end %>

      <% if avatar_group? %>
        <div class="col-12 col-md-auto mt-3 mt-md-0 tw-hidden lg:tw-block">
          <%= avatar_group %>
        </div>
      <% end %>

      <% if @button_text && @button_url %>
        <div class="col-auto">
          <%= link_to @button_text, @button_url, class: 'btn btn-primary' %>
        </div>
      <% end %>

      <% if buttons? %>
        <% buttons.each do |button| %>
          <%= button %>
        <% end %>
      <% end %>
    </div>

    <% if body_content? %>
      <%= body_content %>
    <% end %>

    <% if tab_list? %>
      <%= tab_list %>
    <% end %>
  </div>
</div>

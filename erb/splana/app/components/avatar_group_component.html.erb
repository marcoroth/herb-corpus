<div class="avatar-group">
  <% Array.wrap(@users).each do |user| %>
    <%= render AvatarComponent.new(user: user, size: @size, extra_classes: @extra_classes, tag_name: @tag_name) %>
  <% end %>

  <% if !@plus.zero? && @plus.positive? %>
    <div class="avatar avatar-xs" data-toggle="tooltip" title="<%= @plus %> weitere">
      <span class='avatar-title rounded-circle'>+<%= @plus %></span>
    </div>
  <% end %>
</div>

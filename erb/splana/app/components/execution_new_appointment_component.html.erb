<%= render CardComponent.new do |card| %>
  <%= card.with_body do %>
    <h3>Neuen Termin planen</h3>
    <p class="text-muted">Willst du Termine im Jahr <%= @execution.year %> planen?</p>
    <div>
      <%= link_to "Termin planen", new_appointment_path(source_id: @execution.id, source_type: "RecurringOrderExecution", client_id: @execution.client.id, name: @execution.recurring_order.name, group_id: @execution.group_id), class: 'btn btn-primary btn-sm tw-mt-3' %>
      <%= link_to "Terminserie planen", new_appointment_series_path(recurring_order_execution_id: @execution.id, name: @execution.recurring_order.name), class: 'btn btn-primary btn-sm tw-mt-3' %>
      <%= link_to "Terminrahmenplan erstellen", new_appointment_outline_path(recurring_order_execution_id: @execution.id, name: @execution.recurring_order.name), class: 'btn btn-primary btn-sm tw-mt-3' %>
    </div>
  <% end %>
<% end %>

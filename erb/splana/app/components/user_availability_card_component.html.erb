<%= render CardComponent.new do |card| %>
  <%= card.with_body do %>
    <div class="row align-items-center">
      <div class="col-auto">
        <%= render AvatarComponent.new(user: user_availability.user, size: "md", url: edit_user_availability_path(user_availability)) %>
      </div>

      <div class="col ms-n2">
        <%= link_to edit_user_availability_path(user_availability) do %>
          <h4 class="mb-1">
            Verfügbarkeit
          </h4>

          <small class="text-muted">
            <i class="fe fe-clock"></i> Gültigkeit: <%= user_availability.date_text() %>
          </small>
        <% end %>
      </div>

      <div class="col-auto">
        <%= render DropdownComponent.new do |dropdown| %>
          <% dropdown.with_item { link_to "Anzeigen", user_availability_url(user_availability) } %>
          <% dropdown.with_item { link_to "Bearbeiten", edit_user_availability_url(user_availability) } %>
          <% dropdown.with_item { link_to "Löschen", user_availability_url(user_availability), data: { turbo_confirm: "Möchtest du die Verfügbarkeit von '#{user_availability.user.name}' wirklich löschen?", turbo_method: "delete" } } %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>

<%= render CardComponent.new do |card| %>
  <%= card.with_body do %>
    <div class="row align-items-center">
      <div class="col-auto">
        <%= render AvatarComponent.new(user: absence_rule.user, size: "md", url: edit_absence_rule_path(absence_rule)) %>
      </div>

      <div class="col ms-n2">
        <%= link_to edit_absence_rule_path(absence_rule) do %>
          <h4 class="mb-1">
            <%= absence_rule.name %> (<%= absence_rule.working_percent %>%)
          </h4>

          <small class="text-muted">
            <i class="fe fe-clock"></i> Gültigkeit: <%= absence_rule.date_text(:start_date, :end_date) %>
          </small><br/>
          <small class="text-muted">
            <i class="fe fe-clock"></i> Intervall: <%= absence_rule.interval.parts.to_a.flatten.map(&:to_s).reverse.join(" ") %>
          </small>
        <% end %>
      </div>

      <div class="col-auto">
        <%= render DropdownComponent.new do |dropdown| %>
          <% dropdown.with_item { link_to "Anzeigen", absence_rule_url(absence_rule) } %>
          <% dropdown.with_item { link_to "Bearbeiten", edit_absence_rule_url(absence_rule) } %>
          <% dropdown.with_item { link_to "Löschen", absence_rule_url(absence_rule), data: { turbo_confirm: "Möchtest du die Absenz-Regel '#{absence_rule.name}' wirklich löschen?", turbo_method: "delete" } } %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>

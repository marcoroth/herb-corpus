<div class="card <%= @classes %> tw-shadow-none" style="border-color: #E5E7EB; border-width: 0.87px">
  <% if header? %>
    <%= header %>
  <% end %>

  <% if card_content? %>
    <%= card_content %>
  <% end %>

  <% if body? %>
    <div class="card-body <%= @body_classes %>">
      <%= body %>
    </div>
  <% end %>
</div>

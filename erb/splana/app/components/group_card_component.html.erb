<%= render CardComponent.new(classes: "tw-mb-0") do |card| %>
  <%= card.with_body do %>
    <div class="row align-items-center">
      <div class="col-auto"><%= render AvatarComponent.new(user: group.group_leader, size: "lg", url: group_url(group)) if group.group_leader %></div>
      <div class="col ml--2">
        <h4 class="card-title name"><%= link_to group.to_s, group %></h4>

        <p class="card-text small text-muted">
          <%= group.ordered_users.map(&:name).join(", ") %>
        </p>
      </div>
      <div class="col-auto">
        <%= render AvatarGroupComponent.new(users: group.ordered_users) %>
      </div>

      <div class="col-auto">
        <%= render DropdownComponent.new do |dropdown| %>
          <% dropdown.with_item { link_to "Anzeigen", group_url(group) } %>
          <% dropdown.with_item { link_to "Bearbeiten", edit_group_url(group) } %>
          <% dropdown.with_item { link_to "Löschen", group_url(group), data: { turbo_confirm: "Möchtest du die '#{group.name}' wirklich löschen?", turbo_method: "delete" } } %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>

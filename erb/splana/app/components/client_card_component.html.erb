<%= render CardComponent.new(classes: "mb-3") do |card| %>
  <%= card.with_body do %>
    <div class="row align-items-center">
      <div class="col-auto"><%= render AvatarComponent.new(user: client, size: "lg", url: client_path(client)) %></div>
      <div class="col ml--2">
        <h4 class="card-title mb-1"><%= link_to client.stylized_name, client %></h4>
        <p class="card-text small">
          <%= client.address %><br/>
          <%= client.place.postalcode %> <%= client.place.name %>
        </p>
      </div>

      <div class="col-auto">
        <%= link_to "Anzeigen", client, class: "btn btn-sm btn-primary d-none d-md-inline-block" %>
      </div>
    </div>
  <% end %>
<% end %>

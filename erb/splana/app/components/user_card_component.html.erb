<%= render CardComponent.new(classes: "tw-mb-0") do |card| %>
  <%= card.with_body do %>
    <div class="row align-items-center">
      <div class="col-auto"><%= render AvatarComponent.new(user: user, size: "lg") %></div>
      <div class="col ml--2">
        <h4 class="card-title name"><%= link_to user.name, user_path(user) %></h4>
      </div>

      <div class="col-auto">
        <%= render DropdownComponent.new do |dropdown| %>
          <% dropdown.with_item { link_to "Anzeigen", user_url(user) } %>
          <% dropdown.with_item { link_to "Bearbeiten", edit_user_url(user) } %>
          <% dropdown.with_item { link_to "Löschen", user_url(user), data: { turbo_confirm: "Möchtest du '#{user.name}' wirklich löschen?", turbo_method: "delete" } } %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>

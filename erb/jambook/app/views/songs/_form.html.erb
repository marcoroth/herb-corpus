<%# locals: (song:) %>
<%= form_with model: song, data: { controller: "sheet-editor", action: "submit->sheet-editor#submit" } do |form| %>
  <% if song.errors.any? %>
    <ul class="errors">
      <% song.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= form.label :title, "Title" %>
  <%= form.text_field :title, required: true %>

  <%= form.label :artist, "Artist" %>
  <%= form.text_field :artist, required: true %>

  <%= form.label :status, "Status" %>
  <%= form.select :status, Song.statuses.keys %>

  <%= form.label :tag_names, "Tags" %>
  <%= form.text_field :tag_names, value: song.tag_names.join(", ") %>

  <%= form.label :sheet, "Sheet" %>
  <%= form.text_area :sheet, rows: 16, data: { sheet_editor_target: "sheet", action: "input->sheet-editor#preview" } %>
  <%= form.hidden_field :sheet_format, data: { sheet_editor_target: "format" } %>

  <%= tag.p("Key guessed from the first chord: check it.", class: "alert") if song.key_guessed? %>
  <%= form.label :written_key, "Written key" %>
  <%= form.select :written_key, MusicKey::KEYS, { include_blank: true }, data: { sheet_editor_target: "writtenKey" } %>

  <%= form.label :written_capo, "Written capo" %>
  <%= form.number_field :written_capo, in: 0..11, data: { sheet_editor_target: "writtenCapo" } %>

  <%= form.label :house_key, "House key" %>
  <%= form.select :house_key, MusicKey::KEYS, include_blank: true %>

  <%= form.label :notes, "Notes" %>
  <%= form.text_area :notes, rows: 3 %>

  <%= form.label :ug_url, "UG link" %>
  <%= form.url_field :ug_url %>

  <%= form.label :ug_type, "UG type" %>
  <%= form.text_field :ug_type %>

  <%= form.label :listen_url, "Listen link" %>
  <%= form.url_field :listen_url %>

  <%= form.submit "Save", class: "primary" %>

  <div class="sheet-output" data-sheet-editor-target="preview"></div>
<% end %>

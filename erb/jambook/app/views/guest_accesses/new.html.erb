<section class="door">
  <%= image_tag "chalk-guitar.webp", alt: "", class: "chalk-sketch", width: 556, height: 720 %>
  <h1>Jambook</h1>
  <p class="muted">Type the password from your host to follow tonight's songs.</p>

  <%= tag.p(flash[:alert], class: "alert", role: "alert") if flash[:alert] %>

  <%= form_with url: guest_access_path do |form| %>
    <%= form.label :password, "Password" %>
    <%= form.password_field :password, required: true, autofocus: true, autocomplete: "current-password" %>
    <%= form.submit "Let me in", class: "primary wide" %>
  <% end %>
</section>

<header class="page-head"><h1>Settings</h1></header>

<%= tag.p(notice, class: "notice") if notice %>

<%= form_with model: @setting, url: settings_path, method: :patch do |form| %>
  <% if @setting.errors.any? %>
    <ul class="errors">
      <% @setting.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <p>Changing the guest password signs every guest out.</p>
  <%= form.label :guest_password, "New guest password" %>
  <%= form.password_field :guest_password, required: true, autocomplete: "new-password" %>
  <%= form.label :guest_password_confirmation, "Type it again" %>
  <%= form.password_field :guest_password_confirmation, required: true, autocomplete: "new-password" %>
  <%= form.submit "Save", class: "primary" %>
<% end %>

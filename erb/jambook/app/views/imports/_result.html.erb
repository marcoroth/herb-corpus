<%# locals: (result:) %>
<h2>Created (<%= result.created.size %>)</h2>
<ul>
  <% result.created.each do |song| %>
    <li><%= link_to "#{song.title} – #{song.artist}", song %></li>
  <% end %>
</ul>

<h2>Matched existing songs (<%= result.matched.size %>)</h2>
<ul>
  <% result.matched.each do |song| %>
    <li><%= link_to "#{song.title} – #{song.artist}", song %></li>
  <% end %>
</ul>

<% if result.needs_paste.any? %>
  <h2>Need a pasted sheet (<%= result.needs_paste.size %>)</h2>
  <ul>
    <% result.needs_paste.each do |song| %>
      <li><%= link_to "#{song.title} – #{song.artist}", edit_song_path(song) %></li>
    <% end %>
  </ul>
<% end %>

<% if result.alternates.any? %>
  <h2>Other versions you saved (<%= result.alternates.size %>)</h2>
  <ul>
    <% result.alternates.each do |entry| %>
      <li><%= entry["title"] %> – <%= entry["artist"] %> (<%= entry["type"] %>) <%= web_link_to "open", entry["url"] %></li>
    <% end %>
  </ul>
<% end %>

<% if result.skipped.any? %>
  <p>Skipped (no usable title or artist): <%= result.skipped.to_sentence %></p>
<% end %>

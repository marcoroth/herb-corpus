<header class="page-head"><h1>Import a song list</h1></header>

<%= tag.p(flash[:alert], class: "alert") if flash[:alert] %>
<p><%= link_to "Or import Ultimate Guitar tabs", new_imports_ug_bundle_path %></p>

<p>A CSV with the header <code>title,artist,status,tags</code>. Status is <code>liked</code> or <code>maybe</code>; separate tags with <code>;</code>.</p>

<%= form_with url: imports_song_list_path, multipart: true do |form| %>
  <%= form.label :file, "CSV file" %>
  <%= form.file_field :file, accept: ".csv,text/csv", required: true %>
  <%= form.submit "Import", class: "primary" %>
<% end %>

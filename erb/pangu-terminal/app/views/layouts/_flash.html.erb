<%# locals: () %>

<% flash.each do |type, message| %>
  <% next if type == "api_token" %>

  <%= tag.div class: "flash-message #{type}",
              role: ("alert" if type == "alert"),
              data: { controller: "flash", flash_persist_value: (type == "alert") } do %>
    <span class="flash-prefix">
      <%= type == 'alert' ? '[ERROR]' : '[SYSTEM]' %>
    </span>
    <%= message %>
    <% if type == "alert" %>
      <button type="button" class="flash-close" title="Dismiss message" aria-label="Dismiss message" data-action="click->flash#dismiss">&times;</button>
    <% end %>
  <% end %>
<% end %>

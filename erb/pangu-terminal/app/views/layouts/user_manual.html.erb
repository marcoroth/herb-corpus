<!DOCTYPE html>
<html lang="en">
  <head>
    <title>User Manual: Pangu Terminal</title>
    <%= render "layouts/meta",
          title: "User Manual: Pangu Terminal",
          description: "How to plan materials, track your inventory and use the Waveplate optimizer in Pangu Terminal.",
          url: canonical_url,
          image_url: canonical_url("/og-image.png") %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Pangu Terminal">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/favicon.ico?v=1" sizes="any">
    <link rel="icon" href="/favicon.png?v=1" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/favicon.png?v=1">

    <%= render "layouts/fonts" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="manual-body">
    <%= yield %>
  </body>
</html>

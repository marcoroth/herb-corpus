<%= render layout: "shared/modal", locals: { container_class: "smaller-width", content_class: "share-container" } do %>
  <div class="modal-header">
    <h2 class="modal-title">Share <%= @plan.subject.name %></h2>
  </div>

  <% if @plan.shared? %>
    <% url = canonical_url(shared_plan_path(@plan.share_token)) %>
    <div class="share-box" data-controller="clipboard">
      <label class="share-label" for="share-url">Anyone with this link can see this plan's materials</label>
      <div class="share-row">
        <input id="share-url" class="share-input" type="text" readonly value="<%= url %>"
               data-clipboard-target="source" data-action="focus->clipboard#select">
        <button type="button" class="share-copy" data-action="click->clipboard#copy">Copy link</button>
      </div>
      <p class="share-status" role="status" data-clipboard-target="status"></p>
    </div>

    <p class="share-note">
      The page shows the plan and its material totals only: no name, email or inventory. It is not listed in search engines.
      Stopping sharing turns the link off for good.
    </p>

    <%= button_to "Stop sharing", plan_share_path(@plan), method: :delete, class: "share-stop" %>
  <% else %>
    <p class="share-note">
      Create a link to this plan for a friend or a forum post. The page shows the plan and its material totals only: no name, email or inventory.
      You can turn the link off at any time.
    </p>

    <%= button_to "Create link", plan_share_path(@plan), method: :post, class: "share-create" %>
  <% end %>
<% end %>

<%# locals: (plans:, materials_lookup:, focus: nil) %>
<%# focus: { plan_id:, direction: } puts keyboard focus back on the move button just used. %>
<% ordered = plans.to_a %>
<% ordered.each_with_index do |plan, index| %>
  <%= render "plans/plan",
        plan: plan,
        materials_lookup: materials_lookup,
        rank: index + 1,
        total: ordered.size,
        focus_direction: (focus[:direction] if focus && focus[:plan_id] == plan.id) %>
<% end %>

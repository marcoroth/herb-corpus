<%= main_content_frame do %>
  <div id="sync-banner-container">
    <%= render "plans/sync_banner" %>
  </div>

  <div class="planner-container">
    <div class="planner-header">
      <h1 class="planner-title">Planner</h1>
      <%# <h2 class="planner-subtitle">Your definitive shopping list for Resonator and Weapon ascension, level,
        skill, and forte upgrade materials!</h2> %>

      <%= link_to "✚ New Plan",
      new_plan_path(step: 1),
      data: {
        turbo_frame: "modal",
      },
      class: "new-plan-btn" %>
    </div>

    <section class="materials-accordion" data-controller="accordion">
      <button type="button" class="accordion-header" aria-expanded="false" aria-controls="materials-summary-content" data-action="click->accordion#toggle">
        <span class="header-content">
          <svg xmlns="http://www.w3.org/2000/svg" class="header-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
          <span class="header-title">Material Summary</span>
        </span>

        <svg xmlns="http://www.w3.org/2000/svg" class="accordion-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>

      <div id="materials-summary-content" data-accordion-target="content">
        <%= render "materials_summary", materials_summary: @materials_summary, materials_lookup: @materials_lookup %>
      </div>
    </section>

    <h2 class="visually-hidden">Your plans</h2>
    <div id="plans-list-container" class="plans-container">
      <%# Hidden by CSS as soon as a plan card exists, so create and delete need no extra stream updates. %>
      <div class="plans-empty">
        <span class="plans-empty-icon" aria-hidden="true">📋</span>
        <h2 class="plans-empty-title">No plans yet</h2>
        <p class="plans-empty-text">Pick a Resonator or weapon and the planner totals every material it needs, from ascension to skills.</p>
        <% unless user_signed_in? %>
          <p class="plans-empty-note">No account is needed to try it. Sign in later to keep your plans and unlock the optimizer.</p>
        <% end %>
        <%= link_to "✚ Create your first plan", new_plan_path(step: 1), data: { turbo_frame: "modal" }, class: "new-plan-btn" %>
      </div>
      <turbo-frame id="plans-list">
        <%= render "plans/list", plans: @plans, materials_lookup: @materials_lookup %>
      </turbo-frame>
    </div>
  </div>
<% end %>

<%# locals: (plan:, materials_lookup:, rank: nil, total: nil, focus_direction: nil) %>

<div id="<%= dom_id(plan) %>" class="plan-card">
  <div class="plan-card-header">
    <div class="plan-card-subject">
      <%= render "shared/subject_portrait", subject: plan.subject %>

      <h3 class="plan-card-title">
        <%= plan.subject.name %>
        <% if rank %>
          <span class="plan-rank" aria-label="Priority <%= rank %> of <%= total %>">#<%= rank %></span>
        <% end %>
        <% if plan.shared? %>
          <span class="shared-badge">Shared</span>
        <% end %>
      </h3>
    </div>

    <div class="plan-actions">
      <% if rank && total > 1 %>
        <%# A button that has just been used and is now disabled (the plan reached an end) cannot keep focus, so focus goes to the other arrow. %>
        <% focus_on = focus_direction %>
        <% focus_on = (focus_direction == "up" ? "down" : "up") if (focus_direction == "up" && rank == 1) || (focus_direction == "down" && rank == total) %>
        <% { "up" => "▲", "down" => "▼" }.each do |direction, arrow| %>
          <% unavailable = (direction == "up" && rank == 1) || (direction == "down" && rank == total) %>
          <%= button_to arrow, move_plan_path(plan, direction: direction),
                method: :patch,
                class: "plan-move",
                disabled: unavailable,
                form_class: "plan-move-form",
                aria: { label: "Move #{plan.subject.name} #{direction}, priority #{rank} of #{total}" },
                data: ({ controller: "focus-on-connect" } if focus_on == direction) %>
        <% end %>
      <% end %>

      <%= link_to "Share",
          plan_share_path(plan),
          data: { turbo_frame: "modal" },
          class: "edit-link",
          aria: { label: "Share #{plan.subject.name}" } %>

      <%= link_to "Edit",
          edit_plan_path(plan),
          data: { turbo_frame: "modal" },
          class: "edit-link" %>

      <%= link_to "Delete",
          confirm_delete_plan_path(plan),
          data: { turbo_frame: "modal" },
          class: "delete-link" %>
    </div>
  </div>

  <div class="plan-card-body">
    <% sorted_plan_materials(plan.plan_data.dig("output"), materials_lookup).each do |mat_id, qty| %>
      <% material = materials_lookup[mat_id.to_i] %>

      <div class="material-grid-item" data-tooltip="<%= material.name %>">
        <%= render "shared/material_icon", material: material %>

        <div class="mat-details">
          <span class="quantity-number"><%= format_quantity(qty) %></span>
        </div>
      </div>
    <% end %>
  </div>
</div>

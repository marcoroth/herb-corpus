<%= turbo_stream.update "flash-container", partial: "layouts/flash" %>

<%= turbo_stream.update "materials-summary-content" do %>
  <%= render "plans/materials_summary", materials_summary: @materials_summary, materials_lookup: @materials_lookup %>
<% end %>

<%# Re-render the list so the remaining plans get their new ranks %>
<%= turbo_stream.update "plans-list" do %>
  <%= render "plans/list", plans: @plans, materials_lookup: @materials_lookup %>
<% end %>

<%# Close the confirm delete modal %>
<%= turbo_stream.replace "modal" do %>
  <turbo-frame id="modal"></turbo-frame>
<% end %>

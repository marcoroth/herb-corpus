<%# locals: (container_class: nil, content_class: nil, close_on_esc: true) %>
<%# Shared modal shell. Render with a block: render layout: "shared/modal", locals: { ... } do ... end %>
<%# The modal controller names the dialog after its first heading, moves focus in, traps Tab and returns focus on close. %>

<%= turbo_frame_tag "modal" do %>
  <%= tag.div class: "modal-backdrop",
              data: { controller: "modal", action: [ ("keydown.esc->modal#close" if close_on_esc), "keydown->modal#trapFocus", "click->modal#closeOutside" ].compact.join(" ") } do %>
    <%= tag.div class: class_names("modal-container", container_class), role: "dialog", aria: { modal: true, label: "Dialog" }, tabindex: -1, data: { modal_target: "dialog" } do %>
      <button type="button" class="modal-close-btn" title="Close dialog" aria-label="Close dialog" data-action="click->modal#close">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <%= tag.div id: "modal-content", class: content_class do %>
        <%= yield %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

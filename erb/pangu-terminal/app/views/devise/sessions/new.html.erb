<div class="auth-container">
  <h1 class="auth-title">Sign In</h1>

  <%= render "devise/shared/oauth_buttons" %>

  <%# With no provider configured the email form is the only way in, so show it open. %>
  <details class="auth-email-toggle" <%= "open" if !OauthProviders.any? || flash[:alert].to_s.match?(/invalid/i) %>>
    <% if OauthProviders.any? %>
      <summary>Sign in with email</summary>
    <% end %>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), data: { turbo: false }) do |f| %>
      <div class="auth-form-group">
        <%= f.label :email, class: "auth-label" %>
        <%= f.email_field :email,
                      autofocus: true,
                      autocomplete: "email",
                      class: "auth-input" %>
      </div>

      <div class="auth-form-group">
        <%= f.label :password, class: "auth-label" %>
        <%= f.password_field :password,
                         autocomplete: "current-password",
                         class: "auth-input" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="auth-form-group checkbox-group">
          <%= f.check_box :remember_me, class: "auth-checkbox" %>
          <%= f.label :remember_me, class: "auth-label-inline" %>
        </div>
      <% end %>

      <div>
        <%= f.submit "Sign In", class: "auth-submit" %>
      </div>
    <% end %>
  </details>

  <div class="auth-links">
    <%= render "devise/shared/links" %>
  </div>
</div>

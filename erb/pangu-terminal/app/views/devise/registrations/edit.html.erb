<div class="auth-container" style="max-width: 500px;">
  <h1 class="auth-title">Account Settings</h1>

  <%= render "devise/shared/error_messages", resource: resource %>

  <%= form_for(resource, as: resource_name, url: update_user_registration_path,
    html: { method: :patch, data: { turbo: false } }) do |f| %>
    <div class="auth-form-group">
      <div class="label-with-hint">
        <%= f.label :display_name, "Username", class: "auth-label" %>
        <span class="hint-text">3 to 16 characters, lowercase</span>
      </div>
      <%= f.text_field :display_name, maxlength: User::DISPLAY_NAME_LENGTH.max, autocomplete: "nickname", class: "auth-input" %>
    </div>

    <%= f.submit "Save Username", class: "auth-submit" %>
  <% end %>

  <%= form_for(
    resource,
    as: resource_name,
    url: update_user_registration_path,
    html: { method: :patch, data: { turbo: false } }
    ) do |f| %>

    <div class="auth-form-group">
      <%= f.label :email, class: "auth-label" %>
      <%= f.email_field :email, autocomplete: "email", class: "auth-input" %>
    </div>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <div class="status-msg">Currently waiting confirmation for: <b><%= resource.unconfirmed_email %></b></div>
    <% end %>

    <% if resource.password? %>
      <div class="auth-form-group secondary-border">
        <div class="label-with-hint">
          <%= f.label :current_password, class: "auth-label" %>
          <span class="hint-text">Required</span>
        </div>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "auth-input highlight-input" %>
      </div>
    <% end %>

    <div class="auth-form-group">
      <div class="label-with-hint">
        <%= f.label :password, "New Password", class: "auth-label" %>
        <span class="hint-text">Leave blank to keep current</span>
      </div>
      <%= f.password_field :password, autocomplete: "new-password", class: "auth-input" %>
    </div>

    <div class="auth-form-group">
      <%= f.label :password_confirmation, "Confirm New Password", class: "auth-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "auth-input" %>
    </div>

    <div style="padding-top: 1rem;">
      <%= f.submit "Update Profile", class: "auth-submit" %>
    </div>
  <% end %>

  <div class="sign-in-methods" id="sign-in-methods">
    <h2 class="settings-heading">Sign-in methods</h2>
    <% linked = current_user.identities.index_by(&:provider) %>
    <% OauthProviders.names.each do |provider| %>
      <% identity = linked[provider.to_s] %>
      <% next if identity.nil? && !OauthProviders.configured?(provider) %>
      <div class="sign-in-method-row">
        <span><%= OauthProviders.label(provider) %><%= identity ? " (linked)" : "" %></span>
        <% if identity %>
          <% if current_user.can_unlink?(identity) %>
            <%= button_to "Unlink", identity_path(identity), method: :delete, data: { turbo: false }, class: "btn-revoke" %>
          <% else %>
            <span class="hint-text">Add another sign-in method to unlink</span>
          <% end %>
        <% else %>
          <%= button_to "Link", omniauth_authorize_path(:user, provider), method: :post, data: { turbo: false }, class: "btn-revoke" %>
        <% end %>
      </div>
    <% end %>
    <% unless resource.password? %>
      <p class="hint-text">You sign in with a provider and have no password. Add an email and a password above if you want to sign in with email as well.</p>
    <% end %>
  </div>

  <div class="danger-zone">
    <h2 class="danger-title">Danger Zone</h2>
    <p>Once you delete your account, all your saved plans will be permanently removed.</p>
    <%= button_to "Delete Account", user_registration_path, 
    method: :delete,
    class: "btn-danger",
    data: { 
      turbo_confirm: "Are you sure? This cannot be undone.",
      turbo_method: :delete,
      turbo_frame: "_top"
    } %>
  </div>

  <div class="api-keys-section" id="api-keys">
    <h2>API Keys</h2>

    <% if flash[:api_token] %>
      <div class="api-token-reveal">
        <p>Copy this token now! It won't be shown again.</p>
        <code><%= flash[:api_token] %></code>
      </div>
    <% end %>

    <% current_user.api_keys.each do |key| %>
      <div class="api-key-row">
        <span class="api-key-name"><%= key.name %></span>
        <span class="api-key-meta">Created <%= time_ago_in_words(key.created_at) %> ago</span>
        <%= button_to "Revoke", api_key_path(key), method: :delete, data: { turbo: false }, class: "btn-revoke" %>
      </div>
    <% end %>

    <div class="api-key-form">
      <%= form_with url: api_keys_path, data: { turbo: false } do |f| %>
        <%= f.text_field :name, placeholder: "A unique name for this key" %>
        <%= f.submit "Generate Key" %>
      <% end %>
    </div>
  </div>

  <div class="auth-links">
    <%= link_to "← Back to Dashboard", authenticated_root_path, data: { turbo: false } %>
  </div>
</div>
<%# locals: () %>
<% if OauthProviders.any? %>
  <div class="oauth-buttons">
    <% OauthProviders.enabled.each do |provider| %>
      <%= button_to omniauth_authorize_path(:user, provider),
            method: :post,
            data: { turbo: false },
            class: "oauth-button oauth-#{provider}" do %>
        <%= render "devise/shared/oauth_icon", provider: provider %>
        <span>Continue with <%= OauthProviders.label(provider) %></span>
      <% end %>
    <% end %>
  </div>
<% end %>

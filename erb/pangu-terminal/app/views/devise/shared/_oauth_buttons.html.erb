<%# locals: () %>
<% if OauthProviders.any? %>
  <div class="oauth-buttons">
    <% OauthProviders.enabled.each do |provider| %>
      <%= button_to "Continue with #{OauthProviders.label(provider)}",
            omniauth_authorize_path(:user, provider),
            method: :post,
            data: { turbo: false },
            class: "oauth-button oauth-#{provider}" %>
    <% end %>
  </div>
<% end %>

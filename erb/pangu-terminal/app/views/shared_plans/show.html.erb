<% subject = @plan.subject %>
<% title = "#{subject.name} plan on Pangu Terminal" %>
<% materials = sorted_plan_materials(@plan.plan_data["output"], @materials_lookup) %>
<% content_for :title, title %>
<% content_for :description, "Materials needed for #{subject.name} (#{materials.size} kinds), planned with Pangu Terminal for Wuthering Waves." %>
<% content_for :head do %>
  <meta name="robots" content="noindex, nofollow">
<% end %>

<%= main_content_frame do %>
  <article class="shared-plan">
    <header class="shared-plan-header">
      <%= render "shared/subject_portrait", subject: subject %>
      <div>
        <h1 class="shared-plan-title"><%= subject.name %></h1>
        <p class="shared-plan-subtitle"><%= subject.class.model_name.human %> plan, shared from Pangu Terminal</p>
      </div>
    </header>

    <h2 class="shared-plan-heading">Materials needed</h2>
    <% if materials.empty? %>
      <p class="shared-plan-empty">This plan does not need any materials.</p>
    <% else %>
      <ul class="shared-plan-materials">
        <% materials.each do |material_id, quantity| %>
          <% material = @materials_lookup[material_id.to_i] %>
          <% next unless material %>
          <li class="shared-plan-material">
            <%= render "shared/material_icon", material: material %>
            <span class="shared-plan-material-name"><%= material.name %></span>
            <span class="shared-plan-material-qty"><%= number_with_delimiter(quantity) %></span>
          </li>
        <% end %>
      </ul>
    <% end %>

    <p class="shared-plan-cta">
      Plan your own materials, track what you own and see what to farm next.
      <%= link_to "Try Pangu Terminal", root_path, data: { turbo: false } %>
    </p>
  </article>
<% end %>

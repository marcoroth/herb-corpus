<%= turbo_stream.replace dom_id(@inventory_item) do %>
  <%= render partial: "inventory_items/inventory_item", locals: { inventory_item: @inventory_item, synthesis_result: @synthesis_result, plan_id: params[:plan_id] } %>
<% end %>

<% @related_items.each do |item| %>
  <%= turbo_stream.replace dom_id(item) do %>
    <%= render partial: "inventory_items/inventory_item", locals: { inventory_item: item, synthesis_result: @synthesis_result, plan_id: params[:plan_id] } %>
  <% end %>
<% end %>
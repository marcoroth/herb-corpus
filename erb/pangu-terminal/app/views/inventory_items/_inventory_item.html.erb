<%# locals: (inventory_item:, synthesis_result: nil, plan_id: nil) %>

<% reconciliation = synthesis_result&.dig(inventory_item.material_id) %>

<%= link_to edit_inventory_item_path(inventory_item, plan_id: plan_id), data: { turbo_frame: "modal" }, class: "item-edit-link" do %>
  <div class="inventory-card <%= inventory_card_classes(reconciliation) %>" id="<%= dom_id(inventory_item) %>">
    
    <%# Using Higher Rarity EXP Potion Badge %>
    <% if reconciliation&.dig(:used_higher_rarity) %>
      <div class="higher-rarity-badge">
        <%= image_tag("potion.svg", class: "craft-icon", alt: "") %>
        <span class="badge-count">
          <%= reconciliation[:satisfied] - reconciliation[:owned] %>
        </span>
      </div>
    <% end %>

    <%# Can Synthesize Quantity Badge %>
    <% if reconciliation&.dig(:craftable_count) %>
      <div class="synthesis-badge">
        <%= image_tag("purification.webp", class: "synthesis-icon", alt: "") %>
        <span class="badge-count">
          <%= reconciliation[:craftable_count] %>
        </span>
      </div>
    <% end %>


    <%# Icon with Rarity Border %>
    <%= render "shared/material_icon", material: inventory_item %>
    
    <h3 class="item-name"><%= inventory_item.name %></h3>

    <%# Progress Info %>
    <div class="progress-container">
      <% if reconciliation %>
        <% needed = reconciliation[:needed] %>
        <% satisfied = reconciliation[:satisfied] %>
        <% percent = (needed > 0) ? ((satisfied / needed.to_f) * 100).round.clamp(0, 100) : 0 %>

        <%# Determine color class based on status %>
        <% status_class = reconciliation[:fulfilled] ? 'sufficient' : 'deficit' %>
        
        <div class="progress-bar">
          <div class="progress-fill <%= status_class %>" style="width: <%= percent %>%"></div>
        </div>
        <span class="qty-display"><%= format_quantity(satisfied) %> / <%= format_quantity(needed) %></span>
      <% else %>
        <%# No data state: Keep bar visible but empty/neutral to maintain layout %>
        <div class="progress-bar no-data">
          <div class="progress-fill" style="width: 0%"></div>
        </div>
        <span class="qty-display">
          <%= format_quantity(inventory_item.quantity) %> 
          <span class="qty-separator">/ -</span>
        </span>
      <% end %>
    </div>

  </div>
<% end %>
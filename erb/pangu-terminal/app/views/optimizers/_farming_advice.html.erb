<%# locals: (pending:, advice: nil) %>

<%= turbo_frame_tag "farming-advisor", data: { controller: "advisor-poll" } do %>
  <% if pending %>
    <div class="optimizer-advisor" data-advisor-poll-target="pending">
      <h2 class="optimizer-results-title">&gt; FARMING_ADVISOR</h2>
      <%= render "optimizers/advisor_loading" %>
    </div>
  <% elsif advice.present? %>
    <div class="optimizer-advisor">
      <h2 class="optimizer-results-title">&gt; FARMING_ADVISOR</h2>
      <div class="optimizer-advisor-card">
        <p class="optimizer-advisor-text"><%= advice %></p>
      </div>
    </div>
  <% end %>
<% end %>

<%# locals: (tracker:, date:) %>
<%
  days = tracker.schedule_days.sort
  schedule = days.size == 7 ? "Every day" : days.map { |wday| Date::ABBR_DAYNAMES[wday] }.join(", ")
  statistics = tracker.statistics(as_of: date)
%>
<%= tracker.name %> — <%= schedule %><% if statistics[:streak] > 0 %> · <%= statistics[:streak] %> day streak<% end %><% if tracker.completed?(date) %> · Done today<% end %>

<%# locals: (tracker:, date:) %>
<%= turbo_stream.replace dom_id(tracker, "date_#{date.iso8601}") do %>
  <% if @dom_key == "monthlylog" || @dom_key == "daylog" %>
    <%= render "trackers/date_toggle", tracker: tracker, date: date, dom_key: @dom_key %>
  <% else %>
    <%= render "trackers/cell", tracker: tracker, date: date %>
  <% end %>
<% end %>

<%= turbo_stream.replace dom_id(tracker, :statistics) do %>
  <%= render "trackers/statistics", tracker: tracker %>
<% end %>

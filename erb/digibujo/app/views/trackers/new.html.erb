<% content_for(:title) { "New tracker" } %>

<div class="layout--page layout--container layout--container-md">
  <div class="layout--mx-auto tracker--header">
    <%= icon_tag("target", style: "color: var(--color-text-base);", class: "tracker--header-icon") %>
    <h2>New tracker</h2>
    <p class="layout--mx-auto layout--container layout--container-sm typography--paragraph-sm layout--padded">Trackers are repeating habits — mark them off each day on your daily log or monthly spread.</p>
  </div>
  <div class="layout--surface">
    <div class="layout--flex layout--justify-between layout--surface-header">
      <%= back_link_to root_path, class: "button--tertiary button--sm" do %>
        <%= icon_tag("arrow-left") %>
        Back
      <% end %>
    </div>
    <div class="layout--padded">
      <%= render "trackers/form",
            tracker: @tracker,
            name_hint: "Give your tracker a name. Examples: Morning run, Meditate, Drink water." %>
    </div>
  </div>
</div>

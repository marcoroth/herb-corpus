<%# locals: (tracker:) %>
<li id="<%= dom_id(tracker) %>" class="layout--flex layout--justify-between layout--padded layout--surface">
  <%= link_to tracker_path(tracker), class: "layout--flex layout--padded layout--justify-between utilities--stretch", data: { turbo_frame: "_top" } do %>
    <div class="layout--flex layout--gapped layout--justify-center">
      <%= icon_tag(tracker.icon, style: "color: #{colour(tracker.colour)};") %>
      <span class="typography--paragraph-md typography--bold utilities--line-clamp-1"><%= tracker.name %></span>
    </div>

    <span class="typography--paragraph-sm utilities--line-clamp-1">
      <% if tracker.statistics[:streak] > 0 %><%= tracker.statistics[:streak] %> streak · <% end %>
      <%= tracker.statistics[:total] %> total ·
      <%= tracker.statistics[:period_scheduled].zero? ? 0 : ((tracker.statistics[:period_completed] * 100.0) / tracker.statistics[:period_scheduled]).round %>%
    </span>
    <% end %>
</li>

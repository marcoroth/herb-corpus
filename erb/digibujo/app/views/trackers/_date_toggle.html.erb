<%# locals: (tracker:, date:, dom_key: "monthlylog") %>
<% completed = tracker.completed?(date) %>
<% cell_id = dom_id(tracker, "date_#{date.iso8601}") %>
<% hint_id = dom_id(tracker, "hint_date_#{date.iso8601}") %>
<% hint_anchor = "--hint-tracker-#{tracker.id}-date-#{date.iso8601}" %>

<div id="<%= cell_id %>" class="tracker--day-toggle-wrap">
  <%= form_with url: tracker_status_path(tracker),
        method: completed ? :delete : :post,
        class: "tracker--day-toggle-form",
        data: { turbo_stream: true } do %>
    <%= hidden_field_tag :date, date.iso8601 %>
    <%= hidden_field_tag :dom_key, dom_key %>
    <button
      type="submit"
      class="button--tertiary  tracker--day-toggle<%= " tracker--day-toggle-done" if completed %>"
      aria-label="<%= completed ? "Mark #{tracker.name} incomplete on #{date}" : "Mark #{tracker.name} complete on #{date}" %>"
      aria-pressed="<%= completed %>"
      interestfor="<%= hint_id %>"
      style="anchor-name: <%= hint_anchor %>"
    >
      <%= icon_tag(
            tracker.icon_name,
            class: "tracker--day-toggle-icon",
            style: ("color: #{colour(tracker.colour)};" if completed)
          ) %>
    </button>
  <% end %>
  <div
    id="<%= hint_id %>"
    class="hint"
    popover="hint"
    style="position-anchor: <%= hint_anchor %>"
  >
    <%= tracker.name %> — <%= completed ? "Done" : "Not done" %>
  </div>
</div>

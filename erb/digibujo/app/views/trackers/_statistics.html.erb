<%# locals: (tracker:) %>
<% statistics = tracker.statistics %>

<dl id="<%= dom_id(tracker, :statistics) %>" class="layout--flex layout--surface tracker--statistics" data-elevation="2" data-padding="true">
  <div class="layout--surface" data-elevation="1" data-padding="true">
    <dt>Current streak</dt>
    <dd><%= statistics[:streak] %></dd>
  </div>
  <div class="layout--surface" data-elevation="1" data-padding="true">
    <dt>Best streak</dt>
    <dd><%= statistics[:best_streak] %></dd>
  </div>
  <div class="layout--surface" data-elevation="1" data-padding="true">
    <dt>Total days</dt>
    <dd><%= statistics[:total] %></dd>
  </div>
</dl>

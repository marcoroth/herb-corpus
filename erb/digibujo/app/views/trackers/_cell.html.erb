<%# locals: (tracker:, date:) %>
<% scheduled = tracker.scheduled_on?(date) %>
<% completed = tracker.completed?(date) %>
<% current = date == Date.current %>
<% cell_id = dom_id(tracker, "date_#{date.iso8601}") %>
<% hint_id = dom_id(tracker, "hint_date_#{date.iso8601}") %>
<% hint_anchor = "--hint-tracker-#{tracker.id}-date-#{date.iso8601}" %>
<% date_label = date.strftime("%a, %b %-d") %>
<% status = scheduled ? (completed ? "Done" : "Not done") : "Not scheduled" %>
<% date_content = capture do %>
  <time class="tracker--heatmap-date-label" datetime="<%= date.iso8601 %>">
    <span class="tracker--heatmap-weekday"><%= date.strftime("%a") %></span>
    <span class="tracker--heatmap-day"><%= date.day %></span>
  </time>
<% end %>

<div id="<%= cell_id %>" class="utilities--contents tracker--heatmap-date">
  <% if scheduled %>
    <%= form_with url: tracker_status_path(tracker),
          method: completed ? :delete : :post,
          class: "tracker--heatmap-cell tracker--heatmap-cell-scheduled tracker--heatmap-form",
          data: { turbo_stream: true } do %>
      <%= hidden_field_tag :date, date.iso8601 %>
      <%= hidden_field_tag :dom_key, "date" %>
      <button type="submit"
              class="tracker--heatmap-cell-button"
              data-completed="<%= completed %>"
              aria-label="<%= completed ? "Mark #{tracker.name} incomplete on #{date}" : "Mark #{tracker.name} complete on #{date}" %>"
              aria-pressed="<%= completed %>"
              interestfor="<%= hint_id %>"
              style="anchor-name: <%= hint_anchor %>">
        <%= date_content %>
      </button>
    <% end %>
  <% else %>
    <button class="tracker--heatmap-cell tracker--heatmap-cell-disabled<%= " tracker--heatmap-cell-current" if current %>"
            disabled
            aria-label="<%= tracker.name %> not scheduled on <%= date %>"
            interestfor="<%= hint_id %>"
            style="anchor-name: <%= hint_anchor %>">
      <%= date_content %>
    </button>
  <% end %>
  <div id="<%= hint_id %>"
       class="hint"
       popover="hint"
       style="position-anchor: <%= hint_anchor %>">
    <%= date_label %> — <%= status %>
  </div>
</div>

<%# locals: (tracker:, date:) %>
<% scheduled = tracker.scheduled_on?(date) %>
<% completed = tracker.completed?(date) %>
<% current = date == Date.current %>
<% cell_id = dom_id(tracker, "date_#{date.iso8601}") %>
<% hint_id = dom_id(tracker, "hint_date_#{date.iso8601}") %>
<% hint_anchor = "--hint-tracker-#{tracker.id}-date-#{date.iso8601}" %>
<% date_label = date.strftime("%a, %b %-d") %>
<% status = scheduled ? (completed ? "Done" : "Not done") : "Not scheduled" %>

<div id="<%= cell_id %>" class="tracker--heatmap-cell">
  <% if scheduled %>
    <%= form_with url: tracker_status_path(tracker),
          method: completed ? :delete : :post,
          class: "tracker--heatmap-form",
          data: { turbo_stream: true } do %>
      <%= hidden_field_tag :date, date.iso8601 %>
      <%= hidden_field_tag :dom_key, "date" %>
      <button type="submit"
              class="tracker--heatmap-date<%= " tracker--heatmap-date-done" if completed %><%= " tracker--heatmap-date-current" if current %>"
              aria-label="<%= completed ? "Mark #{tracker.name} incomplete on #{date}" : "Mark #{tracker.name} complete on #{date}" %>"
              aria-pressed="<%= completed %>"
              interestfor="<%= hint_id %>"
              style="anchor-name: <%= hint_anchor %>">
      </button>
    <% end %>
  <% else %>
    <button class="tracker--heatmap-date tracker--heatmap-date-disabled<%= " tracker--heatmap-date-current" if current %>"
            disabled
            aria-label="<%= tracker.name %> not scheduled on <%= date %>"
            interestfor="<%= hint_id %>"
            style="anchor-name: <%= hint_anchor %>">
    </button>
  <% end %>
  <div id="<%= hint_id %>"
       class="hint"
       popover="hint"
       style="position-anchor: <%= hint_anchor %>">
    <%= date_label %> — <%= status %>
  </div>
</div>

<% content_for(:title) { @tracker.name } %>

<div class="layout--page layout--container layout--container-md">
  <header class="layout--flex layout--justify-between">
    <div class="layout--flex layout--gapped">
      <%= back_link_to home_path, class: "button--tertiary button--sm" do %>
        <%= icon_tag("arrow-left") %>
        Back
      <% end %>
      <div class="button--secondary button--sm">
      <%= icon_tag(@tracker.icon, style: "color: #{colour(@tracker.colour)};") %>
      <span><%= @tracker.name %></span>
      </div>
    </div>

    <div class="layout--flex layout--gapped">
  <div class="dropdown--dock">

    <button
      type="button"
      class="button--secondary button--sm"
      popovertarget="tracker_actions"
      aria-label="Tracker options"
      aria-haspopup="menu"
    >
      <%= icon_tag("dots") %>
    </button>

    <div
      id="tracker_actions"
      class="dropdown dropdown--element dropdown--element-bottom animations--side-in"
      style="position-anchor: collection_actions"
      popover
      data-controller="grid-navigation"
      data-grid-navigation-columns-value="1"
      data-action="keydown->grid-navigation#navigate"
    >
      <div class="dropdown--element-body">
        <nav class="dropdown--menu" aria-label="Tracker options">


          <%= link_to edit_tracker_path(@tracker),
                class: "dropdown-item",
                data: { turbo_frame: "_top", grid_navigation_target: "item", action: "focus->grid-navigation#syncPosition" } do %>
            <%= icon_tag("pencil") %>
            Edit
          <% end %>
        </nav>
      </div>
    </div>
  </div>
  </div>
</header>

    <% statistics = @tracker.statistics %>

    <dl class="layout--padded layout--surface tracker--statistics">
      <div>
        <dt>Current streak</dt>
        <dd><%= statistics[:streak] %></dd>
      </div>

      <div>
        <dt>Best streak</dt>
        <dd><%= statistics[:best_streak] %></dd>
      </div>

      <div>
        <dt>Total days</dt>
        <dd><%= statistics[:total] %></dd>
      </div>
    </dl>

    <br>
    <section class="layout--padded layout--surface" aria-label="Last 30 days">

      <div class="tracker--heatmap">
        <% @heatmap_days.each do |day| %>
          <%= render "cell", tracker: @tracker, date: day %>
        <% end %>
      </div>
    </section>
</div>

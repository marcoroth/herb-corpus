<%# locals: (tracker:, url: nil, name_hint:) %>
<%= form_with model: tracker, url: url, class: "form" do |f| %>
  <div class="form-section">
    <%= f.label :name %>
    <small><%= name_hint %></small>
    <%= f.text_field :name, required: true, autofocus: true %>
  </div>

  <%= render "shared/form/colour_picker", form: f %>
  <%= render "shared/form/icon_picker", form: f %>
  <%= render "shared/form/schedule_days_picker", form: f %>
  <%= f.submit class: "button form--submit", data: { intent: "primary", radius: "full", size: "sm" } %>
<% end %>

<% content_for(:title) { "Trackers" } %>

<div class="layout--page layout--container layout--container-md">
    <div class="layout--flex layout--padded layout--justify-between">
      <%= back_link_to home_path, class: "button--tertiary button--sm" do %>
        <%= icon_tag("arrow-left", style: "color: var(--color-text-base);", class: "button--icon") %>
        Back
      <% end %>
      <div class="button--secondary button--sm">
        <%= icon_tag("folder") %>
        Trackers
      </div>
    </div>

    <div class="layout--surface">
      <turbo-frame id="trackers">
        <% if @trackers.any? %>
          <ul class="layout--list layout--padded">
            <%= render partial: "trackers/tracker", collection: @trackers, as: :tracker %>
          </ul>
        <% else %>
          <p>No trackers yet.</p>
        <% end %>
      </turbo-frame>
    </div>
  </div>

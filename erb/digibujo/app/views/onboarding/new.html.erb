<% content_for(:title) { "Welcome" } %>

<div class="onboarding-carousel"
     data-controller="onboarding"
     data-action="keydown.arrow_right@document->onboarding#next keydown.arrow_left@document->onboarding#previous">
  <section class="onboarding-section" data-onboarding-target="section">
    <div class="layout--container" data-size="md">
      <h1 class="typography--h1 typography--center typography--sans onboarding--heading">Welcome to Digibujo</h1>
      <br>
<ul class="onboarding--basics">
      <li class="onboarding--basics-item typography--center typography--balanced">
        <p>Let's take a quick tour of the app, so you feel more comfortable with it.</p>
      </li>
      <div class="layout--flex" data-justify="center" data-wrap="true">
        <button type="button" class="button typography--bold" data-intent="primary" data-radius="full" data-size="sm" data-action="onboarding#next">Swipe to start a quick tour

          <%= icon_tag("arrow-right") %>
        </button>
      </div>
    </ul>
</div>


    <% if @onboarding.errors.any? %>
      <div class="form--errors" role="alert">
        <ul>
          <% @onboarding.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </section>

  <section class="onboarding-section" data-onboarding-target="section">
    <div class="layout--container" data-size="md">
    <h2 class="typography--h1 typography--center onboarding--heading">Follow the rapid logging nature</h2>
    <br>
    <ul class="onboarding--basics">
      <li class="onboarding--basics-item typography--center typography--balanced">
        <p>Use chat composer at the bottom of Daylog page. Just start typing. <span class="hotkey-hint hotkey-hint--key">⎋ Escape</span> cancels, <span class="hotkey-hint hotkey-hint--key">↵ Enter</span>  sends.
        Capture fast, organize later. This is the key principle of bullet journal.</p>
      </li>

      <li class="onboarding--basics-item typography--center typography--balanced">
        <span class="typography--paragraph-sm onboarding--basics-tips">Even though bullet journal is about short notes, you can use the whole power of the text editor to write longer notes and save files.</span>
      </li>
      </ul>
    </div>

  </section>


  <section class="onboarding-section" data-onboarding-target="section">
    <div class="layout--container" data-size="md">
    <h2 class="typography--h1 typography--center onboarding--heading">Plan ahead with future logs</h2>
    <br>
    <ul class="onboarding--basics">
      <li class="onboarding--basics-item typography--center typography--balanced">
        <p>Bullet journal allows to plan ahead using special monthly spread — separate bucket for your bullets. Digibujo supports this too, making it possible to make some drafts for a future use</p>
      </li>
      <li class="onboarding--basics-item typography--center typography--balanced">
        <span class="typography--paragraph-sm onboarding--basics-tips">For even bigger goals, you can use future log. For the most ambitious ideas and life-changing projects.</span>
      </li>
    </ul>
    </div>
  </section>

  <section class="onboarding-section" data-onboarding-target="section">
    <div class="layout--container" data-size="md">
    <h2 class="typography--h1 typography--center onboarding--heading">Migrate as needed. By yourself</h2>
    <br>
    <ul class="onboarding--basics">
      <li class="onboarding--basics-item typography--center typography--balanced">
        <p>When time comes you can migrate your bullets from the future log to monthly spread and then to the daylog, making them your priority. Everything has its actual place to exist in</p>
      </li>
      <li class="onboarding--basics-item typography--center typography--balanced">
        <span class="typography--paragraph-sm onboarding--basics-tips">Moving bullets manually is an important part of the bullet journal methodology. Intention forcing things to be done, not staying stuck in the planning phase.</span>
      </li>
    </ul>
    </div>
  </section>


  <section class="onboarding-section last-section" data-onboarding-target="section">
    <div class="layout--container" data-size="md" data-padding="true">
    <h2 class="typography--h1 typography--center">Explore Digibujo</h2>
    <br>
    <nav class="layout--surface layout--container" data-size="sm" data-elevation="1" data-padding="true">
      <%= form_with url: onboarding_path, class: "onboarding-form", data: { onboarding_target: "form" } do |form| %>
      <div>
        <label class="onboarding-sample-checkbox" style="color: var(--model-color-2);">
          <%= form.radio_button :data_seed, true, class: "utilities--sr-only", include_hidden: false, checked: true %>
          <%= icon_tag("circle", class: "form--icon") %>
          <div>
          <strong>Add sample data</strong>

            <p class="typography--paragraph-sm"> We can add some notes, tasks and events to make it look more natural.</p>
          </div>

        </label>
        <br>
        <label class="onboarding-sample-checkbox" style="color: var(--model-color-2);">
          <%= form.radio_button :data_seed, false, class: "utilities--sr-only", include_hidden: false %>
          <%= icon_tag("circle", class: "form--icon") %>
          <div>
            <strong>Start with an empty journal</strong>
            <p class="typography--paragraph-sm"> If you prefer to start clean.</p>
          </div>
        </label>
      </div>
      <br>
      <p class="typography--paragraph-sm"> If you wish, we can add sample data to your journal, so you understand how it works and structure your journal. Everything can be deleted later.</p>
      <br>
      <div class="layout--flex" data-justify="center">
        <%= form.button "Start my journal", class: "button typography--bold",
              data: { intent: "primary", radius: "full", size: "sm" } %>
      </div>
      <% end %>
    </nav>

    <br>
    <nav class="layout--flex layout--surface layout--container" data-size="sm" data-elevation="1" data-padding="true" data-justify="center" data-wrap="true" aria-label="About">
      <%= link_to features_path, class: "session--footer-link" do %>
        <%= icon_tag("list", class: "session--footer-icon") %>
        Features
      <% end %>
      <%= link_to support_path, class: "session--footer-link" do %>
        <%= icon_tag("mail", class: "session--footer-icon") %>
        Support
      <% end %>
    </nav>
    </div>
  </section>
  <br>

  <footer class="onboarding-footer">
    <ol class="onboarding-dots"
        data-onboarding-target="dots"
        data-action="click->onboarding#jumpToDot">
      <% 5.times do |i| %>
        <li data-index="<%= i %>"></li>
      <% end %>
    </ol>
    <br>
  </footer>
</div>

<% content_for(:title) { "Welcome" } %>
<% content_for(:main_class) { "session-layout--main-wide" } %>

<div class="session--page">
  <div class="session--welcome">
    <h1 class="session--name">Welcome to Digibujo</h1>
    <p class="typography--paragraph-md typography--center typography--balanced">
      You're signed in as <strong><%= @onboarding.user.email_address %></strong>.
      Digibujo follows the
      <%= link_to "Bullet Journal", "https://bulletjournal.com/", target: "_blank", rel: "noopener noreferrer", class: "onboarding--external-link" %>
      method — rapid logging on paper, adapted for a digital workflow.
    </p>
  </div>

  <% if @onboarding.errors.any? %>
    <div class="form--errors" role="alert">
      <ul>
        <% @onboarding.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <ul class="onboarding--basics">
    <li>
      <strong>Daily log</strong>
      <span>Your daylog is ready from the start; open it anytime to add today's bullets.</span>
    </li>
    <li>
      <strong>Monthly spread &amp; Future log</strong>
      <span>Optional parks for the month and farther out; add them when you need them.</span>
    </li>
    <li>
      <strong>Activity</strong>
      <span>A running log on the home page of what moved, completed, or changed in your journal.</span>
    </li>
  </ul>

  <%= form_with url: onboarding_path, class: "form session--form" do |form| %>
    <%= form.button type: "submit", class: "button--primary button--wide" do %>
      Start my journal
    <% end %>
  <% end %>
</div>

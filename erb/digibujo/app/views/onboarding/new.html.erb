<% content_for(:title) { "Welcome" } %>

<div class="session--page onboarding-carousel"
     data-controller="onboarding"
     data-action="keydown.arrow_right@document->onboarding#next keydown.arrow_left@document->onboarding#previous">
  <section class="onboarding-section session--welcome" data-onboarding-target="section">
    <div class="onboarding-welcome layout--surface layout--padded" aria-hidden="true">
      <img src="/icon.svg" alt="" class="onboarding-welcome-logo">
      <div class="onboarding-welcome-bullets">
        <div class="onboarding-demo-bullet onboarding-welcome-reps">
          <span class="onboarding-demo-marker"><%= icon_tag("text", style: "color: var(--model-color-4);") %></span>
          <span class="onboarding-demo-text">Made 20 reps today 💪</span>
        </div>
        <div class="onboarding-demo-bullet onboarding-welcome-task">
          <span class="onboarding-demo-marker"><%= icon_tag("square", style: "color: var(--model-color-2);") %></span>
          <span class="onboarding-demo-text">Buy groceries</span>
        </div>
        <div class="onboarding-demo-bullet onboarding-welcome-dentist">
          <span class="onboarding-demo-marker"><%= icon_tag("circle", style: "color: var(--model-color-5);") %></span>
          <span class="onboarding-demo-text">Visit the dentist</span>
        </div>
        <div class="onboarding-demo-bullet onboarding-welcome-note">
          <span class="onboarding-demo-marker"><%= icon_tag("text", style: "color: var(--model-color-4);") %></span>
          <span class="onboarding-demo-text">Ideas for the weekend hike</span>
        </div>
        <div class="onboarding-demo-bullet onboarding-welcome-event">
          <span class="onboarding-demo-marker onboarding-welcome-slot"></span>
          <span class="onboarding-demo-typing">Time to try Digibujo</span>
        </div>
      </div>
    </div>
    <div class="layout--container layout--container-md">
      <h1 class="typography--h1 typography--center onboarding--heading">Welcome to Digibujo</h1>
      <br>
<ul class="onboarding--basics">
      <li class="onboarding--basics-item typography--center typography--balanced">
        <p>You're signed in as
          <strong class="pill pill--accent"><%= @onboarding.user.email_address %></strong>
        </p>
        <br>
        <p>Let's take a quick tour of the app, so you feel more comfortable with it. Or skip it if you prefer learning on your own.</p>
      </li>
      <div class="layout--flex layout--justify-center layout--gapped">
        <button type="button" class="button--secondary button--md typography--bold" data-action="onboarding#jumpToLast">Skip</button>
        <button type="button" class="button--primary button--md typography--bold" data-action="onboarding#next">Start the quick tour</button>
      </div>
    </ul>
</div>


    <% if @onboarding.errors.any? %>
      <div class="form--errors" role="alert">
        <ul>
          <% @onboarding.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </section>

  <section class="onboarding-section" data-onboarding-target="section">
    <div class="onboarding-demo layout--surface layout--padded" aria-hidden="true">
      <p class="typography--paragraph-sm">Daylog, 7 december</p>
      <div class="onboarding-demo-bullet onboarding-demo-bullet--existing">
        <span class="onboarding-demo-marker"><%= icon_tag("text", style: "color: var(--model-color-4);") %></span>
        <span class="onboarding-demo-text">Made 20 reps today 💪</span>
        <span class="onboarding-demo-time">07:55</span>
      </div>
      <div class="onboarding-demo-bullet onboarding-demo-bullet--existing">
        <span class="onboarding-demo-marker"><%= icon_tag("square", style: "color: var(--model-color-2);") %></span>
        <span class="onboarding-demo-text">Buy groceries</span>
        <span class="onboarding-demo-time">08:00</span>
      </div>
      <div class="onboarding-demo-bullet onboarding-demo-bullet--existing">
        <span class="onboarding-demo-marker"><%= icon_tag("circle", style: "color: var(--model-color-5);") %></span>
        <span class="onboarding-demo-text">Visit the dentist</span>
        <span class="onboarding-demo-time">09:12</span>
      </div>
      <div class="onboarding-demo-bullet onboarding-demo-bullet--new">
        <span class="onboarding-demo-marker"><%= icon_tag("text", style: "color: var(--model-color-4);") %></span>
        <span class="onboarding-demo-text">Ideas for the weekend hike</span>
        <span class="onboarding-demo-time">09:13</span>
      </div>
      <div class="onboarding-demo-composer">
        <span class="onboarding-demo-marker"><%= icon_tag("text") %></span>
        <span class="onboarding-demo-typing">Ideas for the weekend hike</span>
      </div>
    </div>
    <div class="layout--container layout--container-md">
    <h2 class="typography--h1 typography--center onboarding--heading">Follow the rapid logging nature</h2>
    <br>
    <ul class="onboarding--basics">
      <li class="onboarding--basics-item typography--center typography--balanced">
        <p>Use chat composer at the bottom of Daylog page. Just start typing. <span class="hotkey-hint hotkey-hint--key">⎋ Escape</span> cancels, <span class="hotkey-hint hotkey-hint--key">↵ Enter</span>  sends.
        Capture fast, organize later. This is the key principle of bullet journal.</p>
      </li>

      <li class="onboarding--basics-item typography--center typography--balanced">
        <span class="typography--paragraph-sm onboarding--basics-tips">Even though bullet journal is about short notes, you can use the whole power of the text editor to write longer notes and save files.</span>
      </li>
      </ul>
    </div>

  </section>


  <section class="onboarding-section" data-onboarding-target="section">
    <div class="onboarding-demo layout--surface layout--padded" aria-hidden="true">
      <p class="typography--paragraph-sm">Daylog, 7 december</p>
      <div class="onboarding-demo-bullet onboarding-demo-bullet--existing">
        <span class="onboarding-demo-marker"><%= icon_tag("text", style: "color: var(--model-color-4);") %></span>
        <span class="onboarding-demo-text">Made 20 reps today 💪</span>
        <span class="onboarding-demo-time">07:55</span>
      </div>
      <div class="onboarding-demo-bullet onboarding-demo-bullet--existing">
        <span class="onboarding-demo-marker"><%= icon_tag("square", style: "color: var(--model-color-2);") %></span>
        <span class="onboarding-demo-text">Buy groceries</span>
        <span class="onboarding-demo-time">08:00</span>
      </div>
      <div class="onboarding-demo-bullet onboarding-demo-bullet--existing">
        <span class="onboarding-demo-marker"><%= icon_tag("circle", style: "color: var(--model-color-5);") %></span>
        <span class="onboarding-demo-text">Visit the dentist</span>
        <span class="onboarding-demo-time">09:12</span>
      </div>
      <div class="onboarding-demo-bullet onboarding-demo-bullet--new">
        <span class="onboarding-demo-marker"><%= icon_tag("text", style: "color: var(--model-color-4);") %></span>
        <span class="onboarding-demo-text">Ideas for the weekend hike</span>
        <span class="onboarding-demo-time">09:13</span>
      </div>
      <div class="onboarding-demo-composer">
        <span class="onboarding-demo-marker"><%= icon_tag("text") %></span>
        <span class="onboarding-demo-typing">Ideas for the weekend hike</span>
      </div>
    </div>
    <div class="layout--container layout--container-md">
    <h2 class="typography--h1 typography--center onboarding--heading">Plan ahead with future logs</h2>
    <br>
    <ul class="onboarding--basics">
      <li class="onboarding--basics-item typography--center typography--balanced">
        <p>Bullet journal allows to plan ahead using special monthly spread — separate bucket for your bullets. Digibujo supports this too, making it possible to make some drafts for a future use</p>
      </li>
      <li class="onboarding--basics-item typography--center typography--balanced">
        <span class="typography--paragraph-sm onboarding--basics-tips">For even bigger goals, you can use future log. For the most ambitious ideas and life-changing projects.</span>
      </li>
    </ul>
    </div>
  </section>

  <section class="onboarding-section" data-onboarding-target="section">
    <div class="onboarding-demo layout--surface layout--padded" aria-hidden="true">
      <p class="typography--paragraph-sm">Daylog, 7 december</p>
      <div class="onboarding-demo-bullet onboarding-demo-bullet--existing">
        <span class="onboarding-demo-marker"><%= icon_tag("text", style: "color: var(--model-color-4);") %></span>
        <span class="onboarding-demo-text">Made 20 reps today 💪</span>
        <span class="onboarding-demo-time">07:55</span>
      </div>
      <div class="onboarding-demo-bullet onboarding-demo-bullet--existing">
        <span class="onboarding-demo-marker"><%= icon_tag("square", style: "color: var(--model-color-2);") %></span>
        <span class="onboarding-demo-text">Buy groceries</span>
        <span class="onboarding-demo-time">08:00</span>
      </div>
      <div class="onboarding-demo-bullet onboarding-demo-bullet--existing">
        <span class="onboarding-demo-marker"><%= icon_tag("circle", style: "color: var(--model-color-5);") %></span>
        <span class="onboarding-demo-text">Visit the dentist</span>
        <span class="onboarding-demo-time">09:12</span>
      </div>
      <div class="onboarding-demo-bullet onboarding-demo-bullet--new">
        <span class="onboarding-demo-marker"><%= icon_tag("text", style: "color: var(--model-color-4);") %></span>
        <span class="onboarding-demo-text">Ideas for the weekend hike</span>
        <span class="onboarding-demo-time">09:13</span>
      </div>
      <div class="onboarding-demo-composer">
        <span class="onboarding-demo-marker"><%= icon_tag("text") %></span>
        <span class="onboarding-demo-typing">Ideas for the weekend hike</span>
      </div>
    </div>
    <div class="layout--container layout--container-md">
    <h2 class="typography--h1 typography--center onboarding--heading">Migrate as needed. By yourself</h2>
    <br>
    <ul class="onboarding--basics">
      <li class="onboarding--basics-item typography--center typography--balanced">
        <p>When time comes you can migrate your bullets from the future log to monthly spread and then to the daylog, making them your priority. Everything has its actual place to exist in</p>
      </li>
      <li class="onboarding--basics-item typography--center typography--balanced">
        <span class="typography--paragraph-sm onboarding--basics-tips">Moving bullets manually is an important part of the bullet journal methodology. Intention forcing things to be done, not staying stuck in the planning phase.</span>
      </li>
    </ul>
    </div>
  </section>


  <section class="onboarding-section" data-onboarding-target="section">
    <div class="onboarding-demo layout--surface layout--padded" aria-hidden="true">
      <p class="typography--paragraph-sm">Daylog, 7 december</p>
      <div class="onboarding-demo-bullet onboarding-demo-bullet--existing">
        <span class="onboarding-demo-marker"><%= icon_tag("text", style: "color: var(--model-color-4);") %></span>
        <span class="onboarding-demo-text">Made 20 reps today 💪</span>
        <span class="onboarding-demo-time">07:55</span>
      </div>
      <div class="onboarding-demo-bullet onboarding-demo-bullet--existing">
        <span class="onboarding-demo-marker"><%= icon_tag("square", style: "color: var(--model-color-2);") %></span>
        <span class="onboarding-demo-text">Buy groceries</span>
        <span class="onboarding-demo-time">08:00</span>
      </div>
      <div class="onboarding-demo-bullet onboarding-demo-bullet--existing">
        <span class="onboarding-demo-marker"><%= icon_tag("circle", style: "color: var(--model-color-5);") %></span>
        <span class="onboarding-demo-text">Visit the dentist</span>
        <span class="onboarding-demo-time">09:12</span>
      </div>
      <div class="onboarding-demo-bullet onboarding-demo-bullet--new">
        <span class="onboarding-demo-marker"><%= icon_tag("text", style: "color: var(--model-color-4);") %></span>
        <span class="onboarding-demo-text">Ideas for the weekend hike</span>
        <span class="onboarding-demo-time">09:13</span>
      </div>
      <div class="onboarding-demo-composer">
        <span class="onboarding-demo-marker"><%= icon_tag("text") %></span>
        <span class="onboarding-demo-typing">Ideas for the weekend hike</span>
      </div>
    </div>
    <div class="layout--container layout--container-md">
    <h2 class="typography--h1 typography--center onboarding--heading">Single control. Bulk actions</h2>
    <br>
    <ul class="onboarding--basics">
      <li class="onboarding--basics-item typography--center typography--balanced">
        <p>All the manipulations around your notes, tasks and events start from selecting one via circle on the left side of the bullet</p>
      </li>
        <li class="onboarding--basics-item typography--center typography--balanced">
          <span class="typography--paragraph-sm onboarding--basics-tips">Later (postpone), Save (collect), Pin, Archive, Complete or share things you've created — applied to everything selected.</span>
        </li>

    </ul>
    </div>
  </section>

  <section class="onboarding-section last-section" data-onboarding-target="section">
    <div class="layout--container layout--container-md layout--padded">
    <h2 class="typography--h1 typography--center">Explore Digibujo</h2>
    <br>
    <nav class="layout--padded layout--surface layout--container layout--container-sm">
      <%= form_with url: onboarding_path, class: "onboarding-form", data: { onboarding_target: "form" } do |form| %>
      <div>
        <label class="onboarding-sample-checkbox" style="color: var(--model-color-4);">
          <%= form.radio_button :data_seed, true, class: "utilities--sr-only", include_hidden: false %>
          <%= icon_tag("circle", class: "form--icon") %>
          <div>
          <strong>Add sample data</strong>

            <p class="typography--paragraph-sm"> We can add some notes, tasks and events to make it look more natural.</p>
          </div>

        </label>
        <br>
        <label class="onboarding-sample-checkbox" style="color: var(--model-color-4);">
          <%= form.radio_button :data_seed, false, class: "utilities--sr-only", include_hidden: false, checked: true %>
          <%= icon_tag("circle", class: "form--icon") %>
          <div>
            <strong>Start with an empty journal</strong>
            <p class="typography--paragraph-sm"> If you prefer to start clean.</p>
          </div>
        </label>
      </div>
      <br>
      <small class="typography--paragraph-sm"> If you wish, we can add sample data to your journal, so you understand how it works and structure your journal. Everything can be deleted later.</small>
      <br>
      <%= form.button "Start my journal", class: "button--primary button--md layout--mx-auto typography--bold" %>
      <% end %>
    </nav>

    <br>
    <nav class="layout--flex layout--padded layout--gapped layout--surface layout--container layout--container-sm" aria-label="About">
      <%= link_to features_path, class: "session--footer-link" do %>
        <%= icon_tag("list", class: "session--footer-icon") %>
        Features
      <% end %>
      <%= link_to support_path, class: "session--footer-link" do %>
        <%= icon_tag("mail", class: "session--footer-icon") %>
        Support
      <% end %>
    </nav>
    </div>
  </section>
  <br>

  <footer class="onboarding-footer">
    <ol class="onboarding-dots"
        data-onboarding-target="dots"
        data-action="click->onboarding#jumpToDot">
      <% 6.times do |i| %>
        <li data-index="<%= i %>"></li>
      <% end %>
    </ol>
    <br>
  </footer>
</div>

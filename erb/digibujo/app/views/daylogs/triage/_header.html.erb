<%# locals: (triage:, selected_date:) %>
<div class="layout--flex" data-justify="center">
  <%= link_to daylog_triage_path(preview: :expanded),
        class: "button typography--mono hotkey-hint",
        data: {
          controller: "hotkey",
          hotkey: "T",
          action: "keydown.shift+t@document->hotkey#click",
          intent: "secondary",
          radius: "full",
          size: "xs",
          turbo_frame: "daylog_triage_preview"
        },
        aria: { label: "Open triage" } do %>
    <time datetime="<%= selected_date.iso8601 %>">
      <%= selected_date.strftime("%a, %b %-d") %>
    </time>
    <% if triage.number.positive? %>
      <span class="pill pill--accent"><%= triage.number %></span>
    <% end %>
    <%= icon_tag("arrow-down") %>
  <% end %>
</div>

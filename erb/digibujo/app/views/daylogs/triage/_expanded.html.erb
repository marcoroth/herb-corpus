<%# locals: (triage:, selected_date:) %>
<div class="daylog--triage-preview layout--container" data-size="sm" data-margin="horizontal">
  <section class="layout--surface layout--flex" data-direction="column" data-elevation="2" data-padding="true">
    <div class="layout--flex" data-justify="between" data-align="center">
      <h2>Good <%= time_period %>, <%= Current.user.name %></h2>
      <%= link_to daylog_triage_path(preview: :collapsed),
            class: "button",
            data: {
              content: "icon",
              intent: "secondary",
              radius: "full",
              size: "xs",
              turbo_frame: "daylog_triage_preview"
            },
            aria: { label: "Close triage review" } do %>
        <%= icon_tag("x") %>
      <% end %>
    </div>

    <p class="daylog--triage-summary"><%= daylog_triage_summary(triage) %></p>

    <div class="layout--flex" data-justify="center">
      <%= link_to "Review", daylog_triage_path,
            class: "button",
            data: { intent: "primary", radius: "full", size: "xs", turbo_frame: "_top" } %>
    </div>
  </section>
</div>

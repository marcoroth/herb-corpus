<div
  id="triage_chip"
  class="daylog--triage-chip"
  data-controller="triage-chip"
  data-triage-chip-number-url-value="<%= triage_number_path %>"
>
  <%= link_to triage_path,
        id: "triage_chip_button",
        class: "triage--chip animations--popout",
        aria: { label: "Triage" },
        hidden: true do %>
    <%= icon_tag("mail", class: "daylog--triage-chip-icon") %>
    <span id="triage_chip_number" class="daylog--triage-number"></span>
  <% end %>
</div>

<%# locals: (date:, entity:) %>
<% mood_id = "mood_entity_#{date.iso8601}" %>
<div id="<%= mood_id %>-wrap" class="layout--flex layout--gapped layout--padded layout--surface">
<%= render "calendar_dates/mood_entities/mood_entity", date: date, entity: entity %>
</div>
<div>
<p class="typography--paragraph-lg">Mood</p>
<p id="mood_entity_name_<%= date.iso8601 %>" class="typography--paragraph-sm"><%= entity ? entity.mood.humanize : "Pick mood" %></p>
</div>
</div>

<%# locals: (date:, picture:) %>
<% picture_id = "daylog_picture_#{date.iso8601}" %>
<div id="<%= picture_id %>-wrap" class="layout--flex layout--gapped layout--padded layout--surface">
  <% if picture&.picture&.attached? %>
    <div id="<%= picture_id %>" class="dropdown--dock">
      <button
        type="button"
        id="anchor-<%= picture_id %>"
        class="button--tertiary "
        aria-label="Picture menu"
        popovertarget="dropdown-<%= picture_id %>"
        style="anchor-name: --dropdown-<%= picture_id %>"
        aria-haspopup="menu"
      >
        <%= image_tag picture.picture, class: "daylog--picture" %>
      </button>
      <div
        id="dropdown-<%= picture_id %>"
        popover
        style="position-anchor: --dropdown-<%= picture_id %>"
        class="dropdown dropdown--element dropdown--element-bottom animations--side-in"
      >
        <div class="dropdown--element-body">
          <nav class="dropdown--menu" aria-label="Picture">
            <%= link_to attachment_path(picture.picture.blob.signed_id), class: "dropdown-item picker--item", data: { turbo_frame: "_top" } do %>
              <%= icon_tag("zoom-in") %> View photo
            <% end %>
            <%= form_with url: calendar_date_picture_path,
              method: :post,
              multipart: true,
              data: { turbo_stream: true } do %>
              <%= hidden_field_tag :date, date.iso8601 %>

              <label class="dropdown-item picker--item" aria-label="Add photo">
                <%= icon_tag("camera") %> Change photo
                <%= file_field_tag :picture,
                  accept: CalendarDate::Picture::ALLOWED_CONTENT_TYPES.join(","),
                  class: "utilities--sr-only",
                  onchange: "this.form.requestSubmit()" %>
              </label>
            <% end %>
              <%= button_to calendar_date_picture_path(date: date.iso8601), method: :delete, class: "dropdown-item picker--item" do %>
              <%= icon_tag("trash") %> Delete photo
            <% end %>
          </nav>
        </div>
      </div>
    </div>
  <% else %>
    <%= form_with url: calendar_date_picture_path,
      method: :post,
      multipart: true,
      data: { turbo_stream: true } do %>
      <%= hidden_field_tag :date, date.iso8601 %>
      <label class="button--secondary button--circle button-sm" aria-label="Add photo">
        <%= icon_tag("camera") %>
        <%= file_field_tag :picture,
          accept: CalendarDate::Picture::ALLOWED_CONTENT_TYPES.join(","),
          class: "utilities--sr-only",
          onchange: "this.form.requestSubmit()" %>
      </label>
    <% end %>

  <% end %>

  <div>
    <p class="typography--paragraph-lg">Photo of the day</p>
    <p class="typography--paragraph-sm utilities--line-clamp-1">
      <% if picture&.picture&.attached? %>
        <%= picture.picture.filename %>
      <% else %>
        No photo
      <% end %>
    </p>


  </div>
</div>

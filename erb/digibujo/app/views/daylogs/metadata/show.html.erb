<turbo-frame
  id="daylog_metadata_<%= @date.iso8601 %>"
  class="dropdown dropdown--element dropdown--element-up animations--side-in"
  popover
>
  <div class="layout--grid layout--gapped">
    <%= render "mood_entity", date: @date, entity: @mood_entity %>
    <%= render "picture", date: @date, picture: @picture %>
  </div>
</turbo-frame>


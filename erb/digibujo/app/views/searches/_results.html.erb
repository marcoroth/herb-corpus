<% if q.present? %>
  <% if entries.any? %>
    <ul class="search--results" role="listbox">
      <% entries.each do |entity| %>
        <%= render "searches/item", entity: entity %>
      <% end %>
    </ul>
  <% else %>
    <p class="search--no-results">No results for "<%= q %>"</p>
  <% end %>
<% elsif selections&.any? %>
  <ul class="search--results" role="listbox">
    <% selections.each do |selection| %>
      <%= render "searches/item", entity: selection.searchable %>
    <% end %>
  </ul>
<% else %>
  <p class="search--no-results">No recent searches.</p>
<% end %>

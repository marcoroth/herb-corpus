<li class="layout--list-item" role="option">
  <%= link_to polymorphic_path(entity), class: "search--item", data: { turbo_frame: "_top", combobox_target: "item", action: "click->search#rememberSelection", searchable_type: entity.class.name, searchable_id: entity.id } do %>
    <%= icon_tag(entity.icon, style: "color: #{colour(entity.colour)};", class: "") %>
    <%= entity.name %>
  <% end %>
</li>

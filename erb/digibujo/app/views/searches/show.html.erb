<% if turbo_frame_request? %>
  <turbo-frame id="menu_search" class="search--palette">
    <%= render "searches/results", q: @q, entries: @entries, selections: @selections %>
  </turbo-frame>
<% else %>
  <% content_for(:title, "Search") %>

  <main class="search--page layout--container" data-size="md" data-padding="true">
    <header class="layout--flex" data-align="center">
      <%= back_link_to home_path,
            class: "button",
            data: { intent: "secondary", radius: "full", size: "sm", content: "icon", turbo_frame: "_top" },
            aria: { label: "Back to Home" } do %>
        <%= icon_tag("arrow-left") %>

      <% end %>
      <h1>Search</h1>
    </header>

    <div
      class="search search--open search--standalone"
      data-controller="combobox search"
      data-combobox-path-value="<%= search_path %>"
      data-search-selection-path-value="<%= search_selection_path %>"
    >
      <%= render "searches/form" %>
      <turbo-frame id="menu_search" class="search--palette">
        <%= render "searches/results", q: @q, entries: @entries, selections: @selections %>
      </turbo-frame>
    </div>
  </main>
<% end %>

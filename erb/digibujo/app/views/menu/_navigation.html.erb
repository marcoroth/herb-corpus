<nav class="menu--navigation"
     data-controller="grid-navigation"
     data-grid-navigation-columns-value="4"
     data-action="keydown->grid-navigation#navigate">
  <%= link_to home_path,
        class: "menu--navigation-item hotkey-hint hotkey-hint--always",
        data: {
          turbo_frame: "_top",
          controller: "hotkey",
          hotkey: "1",
          grid_navigation_target: "item",
          action: "keydown.1@document->hotkey#click focus->grid-navigation#syncPosition"
        },
        aria: { keyshortcuts: "1", label: "Home" } do %>
    <i class="icon" style="--icon-mask: var(--icon-home)" aria-hidden="true"></i>
    <span class="menu--navigation-name">Home</span>
  <% end %>
  <%= link_to daylog_path,
        class: "menu--navigation-item hotkey-hint hotkey-hint--always",
        data: {
          turbo_frame: "_top",
          controller: "hotkey",
          hotkey: "2",
          grid_navigation_target: "item",
          action: "keydown.2@document->hotkey#click keydown.ctrl+d@document->hotkey#click keydown.meta+d@document->hotkey#click focus->grid-navigation#syncPosition"
        },
        aria: { keyshortcuts: "2", label: "Daylog" } do %>
    <i class="icon" style="--icon-mask: var(--icon-menu)" aria-hidden="true"></i>
    <span class="menu--navigation-name">Daylog</span>
  <% end %>
  <%= link_to current_monthlylog_path,
        class: "menu--navigation-item hotkey-hint hotkey-hint--always",
        data: {
          turbo_frame: "_top",
          controller: "hotkey",
          hotkey: "3",
          grid_navigation_target: "item",
          action: "keydown.3@document->hotkey#click focus->grid-navigation#syncPosition"
        },
        aria: { keyshortcuts: "3", label: "Monthly" } do %>
    <i class="icon" style="--icon-mask: var(--icon-calendar)" aria-hidden="true"></i>
    <span class="menu--navigation-name">Monthly</span>
  <% end %>
  <%= link_to review_path,
        class: "menu--navigation-item hotkey-hint hotkey-hint--always",
        data: {
          turbo_frame: "_top",
          controller: "hotkey",
          hotkey: "4",
          grid_navigation_target: "item",
          action: "keydown.4@document->hotkey#click focus->grid-navigation#syncPosition"
        },
        aria: { keyshortcuts: "4", label: "Review" } do %>
    <i class="icon" style="--icon-mask: var(--icon-circle-check)" aria-hidden="true"></i>
    <span class="menu--navigation-name">Review</span>
  <% end %>
</nav>

<% content_for(:title) { @activity.action.humanize } %>

<div class="layout--page layout--container layout--container-md">
  <div class="layout--mx-auto activity--header">
    <%= icon_tag("history", style: "color: var(--color-text-base);", class: "activity--header-icon") %>
    <h2><%= @activity.action.humanize %></h2>
  </div>

  <div class="layout--surface">
    <div class="layout--flex layout--justify-between layout--surface-header">
      <%= back_link_to activities_path, class: "button--tertiary button--sm", data: { turbo_frame: "_top" } do %>
        <%= icon_tag("arrow-left", style: "color: var(--color-text-base);", class: "button--icon") %>
        Back
      <% end %>
    </div>

    <div class="layout--padded activity--show">
      <div class="activity--show-summary">
        <div class="activity--show-summary-body">
          <p class="activity--show-summary-text"><%= activity_sentence(@activity) %></p>
          <time class="activity--time" datetime="<%= @activity.created_at.to_fs(:db) %>">
            <%= @activity.created_at.strftime('%A, %B %-d at %-l:%M %p') %>
            <span class="activity--time-relative">
              (<%= time_ago_in_words(@activity.created_at) %> ago)
            </span>
          </time>
        </div>
      </div>
    </div>
  </div>
</div>

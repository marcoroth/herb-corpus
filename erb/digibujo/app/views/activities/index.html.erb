<% content_for(:title) { "Activity" } %>

<div class="layout--page layout--container layout--container-md">
  <div class="layout--mx-auto activity--header">
    <%= icon_tag("history", style: "color: var(--color-text-base);", class: "activity--header-icon") %>
    <h2>Activity</h2>
  </div>

  <div class="layout--surface">
    <div class="layout--flex layout--justify-between layout--surface-header">
      <%= back_link_to home_path, class: "button--tertiary button--sm" do %>
        <%= icon_tag("arrow-left", style: "color: var(--color-text-base);", class: "button--icon") %>
        Back
      <% end %>
    </div>

    <div class="layout--padded activity--feed">
      <% if @page.records.any? %>
        <%= render layout: "pagination/paginated_list",
              locals: {
                page: @page,
                container_id: "activity-feed",
                pagination_link_path: ->(next_param) { activities_path(page: next_param) }
              } do %>
          <div class="activity--feed-list">
            <% previous_date = nil %>
            <% @page.records.each do |activity| %>
              <% activity_date = activity.created_at.to_date %>
              <% if previous_date != activity_date %>
                <h3 class="activity--date"><%= activity_date.strftime('%A, %B %-d') %></h3>
                <% previous_date = activity_date %>
              <% end %>
              <%= render "activities/activity", activity: activity %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="activity--empty typography--paragraph-sm">No activity yet.</p>
      <% end %>
    </div>
  </div>
</div>

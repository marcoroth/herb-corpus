<%# locals: (date:, bullets: [], daylog_bucket:) %>
<div class="review--date-band">
  <div class="review--date-rail">
    <%= link_to daylog_path(date: date.iso8601),
          class: "review--date-number",
          aria: { label: "Open #{date.strftime('%B %-d')} on daily log" },
          data: { turbo_frame: "_top" } do %>
      <span class="review--date-day"><%= date.day %></span>
      <span class="review--date-weekday"><%= date.strftime("%a") %></span>
    <% end %>

    <div class="review--date-entries"
         data-controller="pops-drop drop-postpone-optimistic"
         data-drop-zone-value="<%= date.iso8601 %>"
         data-pops-drop-pops-url-value="<%= postpone_path %>"
         data-pops-drop-bucket-id-value="<%= daylog_bucket.id %>"
         data-pops-drop-pops-on-value="<%= date.iso8601 %>"
         data-pops-drop-requested-with-value="review-pops-drop"
         data-pops-drop-optimistic-value="drop-postpone-optimistic"
         data-action="dragover->pops-drop#dragover dragleave->pops-drop#dragleave drop->pops-drop#drop">
      <% bullets.each do |bullet| %>
        <%= render partial: bullet.to_partial_path, locals: { bullet: bullet } %>
      <% end %>
    </div>
  </div>
</div>

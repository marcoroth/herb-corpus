<%# locals: (collection:) %>
<li class="review--collections-item">
  <div class="review--collection-drop-target"
       data-controller="collect-drop drop-collection-optimistic"
       data-collect-drop-collect-url-value="<%= collect_path %>"
       data-collect-drop-bucket-id-value="<%= collection.bucket.id %>"
       data-action="dragover->collect-drop#dragover dragleave->collect-drop#dragleave drop->collect-drop#drop">
    <%= link_to collection_path(collection),
          class: "collection--section-list-item",
          data: { turbo_frame: "_top", combobox_target: "item" } do %>
      <%= icon_tag(collection.bucket.icon, style: "color: #{colour(collection.bucket.colour)};", class: "home--section-list-item-icon") %>
      <span class="utilities--line-clamp-1"><%= collection.name %></span>
    <% end %>
  </div>
</li>

<% content_for(:title) { "Review" } %>

<div
  class="layout--page review--page review--page-mobile"
  data-controller="review-mobile-sections"
>
  <div class="review--spread-sections" data-review-mobile-sections-target="track">
    <section class="review--section review--section-collections" aria-label="Collections">
      <turbo-frame id="review_collections_frame" src="<%= review_collections_path(from: @review_from, to: @review_to) %>">
      </turbo-frame>
    </section>

    <section
      class="review--section review--section-to-review"
      aria-label="To review"
      data-review-mobile-sections-target="review"
    >
      <%= render "reviews/to_review",
            review_from: @review_from,
            review_to: @review_to,
            page: @page,
            amount_in_review: @amount_in_review,
            previous_date: @previous_date %>
    </section>

    <section class="review--section review--section-schedule" aria-label="Schedule">
      <turbo-frame id="review_scheduled_frame" src="<%= review_scheduled_path(from: @review_from, to: @review_to) %>">
      </turbo-frame>
    </section>
  </div>
</div>

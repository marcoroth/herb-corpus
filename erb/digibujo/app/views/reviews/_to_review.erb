<%# locals: (review_from:, review_to:, page:, amount_in_review:, previous_date: nil) %>
<main class="review--to-review" aria-label="To review">
  <header class="review--to-review-header">
    <h3 class="review--side-name">To review</h3>
    <p class="review--side-description">
      <% if review_from == review_to %>
        <%= review_from.strftime("%a, %b %-d, %Y") %>
      <% else %>
        <%= review_from.strftime("%b %-d") %> – <%= review_to.strftime("%b %-d, %Y") %>
      <% end %>
      · <strong id="review-amount-in-review"><%= amount_in_review %></strong> total
    </p>
  </header>

  <article class="review--to-review-body review--to-review-list" data-bulk-menu-target="list">
    <% if page.records.any? %>
      <%= render layout: "pagination/paginated_list",
            locals: {
              page: page,
              container_id: "paginated-review-to-review",
              pagination_link_path: lambda { |next_param|
                review_path(from: review_from.iso8601, to: review_to.iso8601, page: next_param)
              }
            } do %>
        <% previous_date = previous_date %>
        <% page.records.each do |bullet| %>
          <% date = bullet.pops_on %>
          <% if date.present? && previous_date != date %>
          <div class="collection--date-divider layout--flex" data-justify="center" role="separator" aria-label="<%= date.strftime('%b %-d, %Y') %>">
            <%= link_to daylog_path(date: date.iso8601),
                    class: "button",
                    data: { content: "text", turbo_frame: "_top" } do %>
                <time datetime="<%= date.iso8601 %>"><%= date.strftime('%b %-d, %Y') %></time>
              <% end %>
            </div>
            <% previous_date = date %>
          <% end %>
          <%= render "reviews/bullet", bullet: bullet %>
        <% end %>
      <% end %>
    <% else %>
      <p class="review--to-review-empty">Nothing to review</p>
    <% end %>
  </article>
</main>

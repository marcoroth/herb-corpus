<%# locals: (calendar_days:, calendar_bullets_by_date:) %>
<aside class="review--calendar" aria-label="This week">
  <header class="review--calendar-header">
    <h3 class="review--side-name">Schedule</h3>
    <p class="review--side-description">
      <%= calendar_days.first.strftime("%b %-d") %> – <%= calendar_days.last.strftime("%b %-d") %>
    </p>
  </header>

  <div class="review--calendar-body">
    <% daylog_bucket = Current.user.daylog.bucket %>
    <% calendar_days.each do |date| %>
      <%= render "reviews/calendar_date",
            date: date,
            bullets: calendar_bullets_by_date[date] || [],
            daylog_bucket: daylog_bucket %>
    <% end %>
  </div>
</aside>

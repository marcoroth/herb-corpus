<% content_for(:title) { "Archived" } %>

<main class="layout--container" data-size="md" data-padding="true">
  <div class="layout--surface layout--flex" data-elevation="1" data-padding="true" data-direction="column">
  <header class="layout--flex" data-align="center">
      <%= back_link_to home_path, class: "button", data: { intent: "secondary", radius: "full", size: "sm", content: "icon" }, aria: { label: "Back to Home" } do %>
        <%= icon_tag("arrow-left") %>
      <% end %>
      <h2>Archived</h2>
      <% if @amount_of_archived.positive? %>
        <p class="typography--paragraph-sm"><%= @amount_of_archived %> total</p>
      <% end %>
  </header>


  <% if @amount_of_archived.positive? %>
    <div>
      <div data-bulk-menu-target="list">
        <%= render layout: "pagination/paginated_list",
              locals: {
                page: @page,
                pagination_link_path: ->(next_param) { archived_index_path(page: next_param) }
              } do %>
          <% @page.records.each do |bullet| %>
            <%= render partial: bullet.to_partial_path, locals: { bullet: bullet } %>
          <% end %>
        <% end %>
      </div>
    </div>

    <% else %>
    <p class="typography--paragraph-sm">You haven't archived any bullets yet. When you archive a bullet, it will be moved to the archived section and you will be able to restore it if you need to.</p>
  <% end %>
  </div>
</main>

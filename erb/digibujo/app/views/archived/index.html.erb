<% content_for(:title) { "Archived" } %>

<div class="layout--page layout--container layout--container-md">
  <div class="layout--mx-auto archived--header">
    <%= icon_tag("archive", style: "color: var(--color-text-base);", class: "archived--header-icon") %>
    <h2>Archived</h2>
    <% if @amount_of_archived.positive? %>
      <p class="typography--paragraph-sm"><%= @amount_of_archived %> total</p>
    <% end %>
  </div>

  <div class="layout--surface">
    <div class="layout--flex layout--justify-between layout--surface-header">
      <%= back_link_to home_path, class: "button--tertiary button--sm" do %>
        <%= icon_tag("arrow-left", style: "color: var(--color-text-base);", class: "button--icon") %>
        Back
      <% end %>
    </div>

    <div class="layout--list layout--padded archived--list">
      <div data-bulk-menu-target="list">
        <%= render layout: "pagination/paginated_list",
              locals: {
                page: @page,
                pagination_link_path: ->(next_param) { archived_index_path(page: next_param) }
              } do %>
          <% @page.records.each do |bullet| %>
            <%= render partial: bullet.to_partial_path, locals: { bullet: bullet } %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>

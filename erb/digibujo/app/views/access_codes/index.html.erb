<% content_for(:title) { "Access codes" } %>

<div class="layout--page layout--container layout--container-md">
  <div class="layout--mx-auto">
    <%= icon_tag("code", style: "color: var(--color-fg-base);") %>
    <h2>Access codes</h2>
    <p class="layout--mx-auto layout--container layout--container-sm typography--paragraph-sm layout--padded">
      Long-lived codes for CLI and integrations. Create them via the API; revoke any code you no longer trust here.
    </p>
  </div>

  <div class="layout--surface">
    <div class="layout--flex layout--justify-between layout--surface-header">
      <%= back_link_to user_path, class: "button--tertiary button--sm" do %>
        <%= icon_tag("arrow-left") %>
        Back
      <% end %>
    </div>

    <div class="layout--padded">
      <% if @access_codes.any? %>
        <ul id="access_codes" class="layout--list">
          <%= render partial: "access_codes/access_code", collection: @access_codes, as: :access_code %>
        </ul>
      <% else %>
        <p id="access_codes_empty">No access codes yet.</p>
      <% end %>
    </div>
  </div>
</div>

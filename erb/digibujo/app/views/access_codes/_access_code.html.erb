<%# locals: (access_code:) %>
<article
  id="<%= dom_id(access_code) %>"
  class="layout--surface layout--flex"
  data-elevation="2"
  data-padding="true"
  data-justify="between"
  data-align="center"
>
  <div class="layout--flex" data-direction="column">
    <div>
      <code><%= access_code.code_prefix %>…</code>
      <% if access_code.description.present? %>
        <span><%= access_code.description %></span>
      <% end %>
    </div>
    <span class="typography--paragraph-sm"><%= l(access_code.created_at.to_date, format: :long) %></span>
  </div>

  <%= button_to access_code_path(access_code),
        method: :delete,
        class: "button",
        data: { intent: "secondary", radius: "full", size: "xs", status: "negative" },
        form: { data: { turbo_confirm: "Revoke this access code? Anything using it will stop working." } } do %>
    <%= icon_tag("trash") %>
    <span>Revoke</span>
  <% end %>
</article>

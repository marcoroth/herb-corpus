<%# locals: (access_code:) %>
<li id="<%= dom_id(access_code) %>" class="layout--flex layout--justify-between layout--padded">
  <div>
    <code><%= access_code.code_prefix %>…</code>
    <% if access_code.description.present? %>
      <span><%= access_code.description %></span>
    <% end %>
    <div class="typography--paragraph-sm"><%= l(access_code.created_at.to_date, format: :long) %></div>
  </div>
  <%= button_to access_code_path(access_code),
        method: :delete,
        class: "button--secondary button--sm button--danger",
        form: { data: { turbo_confirm: "Revoke this access code? Anything using it will stop working." } } do %>
    <%= icon_tag("trash") %>
    Revoke
  <% end %>
</li>

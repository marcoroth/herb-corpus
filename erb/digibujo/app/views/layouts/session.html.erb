<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Digibujo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,interactive-widget=resizes-visual">
    <meta name="application-name" content="Digibujo">
    <meta name="view-transition" content="same-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= render "shared/fonts" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="session-body<%= " session-body--dots" if @session_dots %>">
    <% if @session_dots %>
      <div
        id="session-dots"
        class="session-dots"
        data-turbo-permanent
        data-controller="session-dots"
      >
        <canvas
          data-session-dots-target="canvas"
          aria-hidden="true"
        ></canvas>
      </div>
    <% end %>

    <%= render "shared/toasts_host" %>

    <div class="session-layout">
      <header class="session-layout--header">
        <img src="/icon.svg" alt="Digibujo" class="public-logo session--logo">
      </header>
      <main class="session-layout--main">
        <%= yield %>
      </main>
    </div>
  </body>
</html>

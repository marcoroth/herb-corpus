<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Digibujo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,interactive-widget=resizes-visual">
    <meta name="application-name" content="Digibujo">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body>
    <div class="public-layout">
      <aside class="public-side">
        <%= link_to root_path, class: "public-brand" do %>
          <%= image_tag "/icon.svg", alt: "Digibujo", class: "public-logo" %>
          <span class="public-application-name">Digibujo</span>
        <% end %>
        <div class="public-register">
          <p>Capture ideas without friction.</p>
          <%= link_to "Create your own", new_authentication_path, class: "button--primary" %>
        </div>
      </aside>
      <main class="public-main">
        <%= yield %>
      </main>
    </div>
  </body>
</html>

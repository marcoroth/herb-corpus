<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title><%= content_for(:title) || "Digibujo" %></title>
  </head>

  <body style="margin: 0; padding: 0; background-color: #f7f6f4; color: #3d3d44; font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 14px; line-height: 1.5; -webkit-font-smoothing: antialiased;">
    <div style="min-height: 100vh; display: flex; flex-direction: column;">
      <header style="padding: 32px 24px 16px; text-align: center; background-color: #f7f6f4;">
        <img src="https://digibujo.app/icon.svg" alt="Digibujo" style="width: 48px; height: 48px; display: inline-block;">
      </header>

      <main style="flex: 1; padding: 0 24px 32px; display: flex; justify-content: center; background-color: #f7f6f4;">
        <div style="width: 100%; max-width: 38rem; background-color: #fff; border: 1px solid #e8e6e2; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.07), 0 0 0 1px rgba(0,0,0,0.04);">
          <div style="padding: 32px;">
            <%= yield %>
          </div>
        </div>
      </main>

      <footer style="padding: 24px; text-align: center; background-color: #f7f6f4;">
        <p style="margin: 0; font-size: 12px; color: #8a8a94; font-weight: 400;">
          Digibujo &mdash; Your digital bujo
        </p>
      </footer>
    </div>
  </body>
</html>

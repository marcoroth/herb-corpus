<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for?(:title) ? yield(:title) : "Digibujo export" %></title>
    <style>
      :root {
        color-scheme: light;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 2rem 1.5rem 3rem;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1rem;
        line-height: 1.5;
        color: #2a2a2a;
        background: #faf9f7;
      }

      .export--header {
        margin: 0 auto 2rem;
        max-width: 42rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #ddd;
      }

      .export--title {
        margin: 0 0 0.25rem;
        font-size: 1.5rem;
        font-weight: 600;
      }

      .export--meta {
        margin: 0;
        font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
        font-size: 0.875rem;
        color: #666;
      }

      .export--list {
        margin: 0 auto;
        max-width: 42rem;
      }

      .export--bullet {
        margin: 0 0 2rem;
        padding: 1.25rem 1.5rem;
        border: 1px solid #ddd;
        border-radius: 0.5rem;
        background: #fff;
      }

      .export--bullet-header {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.5rem 1rem;
        margin-bottom: 1rem;
        font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
        font-size: 0.8125rem;
        color: #666;
      }

      .export--bullet-type {
        font-weight: 600;
        color: #2a2a2a;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      .export--bullet-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
      }

      .export--tag {
        display: inline-block;
        padding: 0.125rem 0.5rem;
        border: 1px solid #ddd;
        border-radius: 999px;
        background: #f5f4f2;
      }

      .export--bullet-body {
        word-break: break-word;
      }

      .export--bullet-body.export--bullet-body--completed {
        text-decoration: line-through;
        color: #888;
      }

      .export--bullet-body p {
        margin: 0 0 0.75rem;
      }

      .export--bullet-body p:last-child {
        margin-bottom: 0;
      }

      .export--bullet-body img {
        max-width: 100%;
        height: auto;
        border-radius: 0.25rem;
      }

      .export--bullet-body figure.attachment--preview,
      .export--bullet-body figure.attachment--inline {
        margin: 0.5rem 0;
      }

      .export--bullet-body a {
        color: #1a6b7a;
      }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>

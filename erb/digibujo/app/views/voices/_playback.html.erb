<%# locals: (recording: nil, recording_duration: 0) %>
<% duration = recording_duration.to_i %>
<% audio_src = recording&.attached? ? url_for(recording) : nil %>
<% minutes, seconds = duration.divmod(60) %>
<%# Static decorative heights (promo phone mock); progress fills left→right. %>
<% wave_heights = [4, 9, 14, 7, 11, 16, 8, 12, 5, 10, 15, 6, 13, 9, 4, 11, 7, 14, 8, 5, 12, 6, 15, 9] %>
<div class="voice--playback"
     data-controller="voice-player"
     data-voice-player-duration-value="<%= duration %>">
  <audio class="utilities--sr-only"
         data-voice-player-target="audio"
         data-voice-recorder-target="preview"
         preload="metadata"
         <% if audio_src.present? %>src="<%= audio_src %>"<% end %>
         aria-hidden="true"></audio>

  <button type="button"
          class="voice--play"
          data-voice-player-target="playButton"
          data-action="voice-player#toggle"
          aria-label="Play">
    <span data-voice-player-target="playIcon">
      <%= icon_tag("play") %>
    </span>
    <span data-voice-player-target="stopIcon" hidden>
      <%= icon_tag("stop") %>
    </span>
  </button>

  <div class="voice--wave"
       data-voice-player-target="progress"
       data-action="click->voice-player#seek keydown->voice-player#progressKeydown"
       role="slider"
       aria-label="Playback position"
       aria-valuemin="0"
       aria-valuemax="<%= duration %>"
       aria-valuenow="0"
       tabindex="0">
    <% wave_heights.each do |height| %>
      <i class="voice--wave-bar" style="--voice-bar-height: <%= height %>px" aria-hidden="true"></i>
    <% end %>
  </div>

  <span class="voice--duration"
        data-voice-player-target="duration"
        aria-hidden="true"><%= minutes %>:<%= seconds.to_s.rjust(2, "0") %></span>
</div>


<%= render layout: "bullets/bullet", locals: { bullet: } do %>
  <% if bullet.body_as_text.present? %>
    <span class="voice--caption"><%= bullet.body_as_text %></span>
  <% end %>
  <%= render "voices/playback",
        recording_source: url_for(bullet.voice.recording),
        recording_duration: bullet.voice.duration_seconds %>
<% end %>

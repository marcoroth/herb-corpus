<turbo-frame id="<%= dom_id(bucket, :pin_button) %>">
  <% if bucket.pinned? %>
    <%= button_to buckets_pin_path,
          method: :delete,
          params: { bucket_id: bucket.id },
          class: "button",
          data: { intent: "secondary", radius: "full", size: "xs", content: "icon" },
          form: { data: { turbo_stream: true } },
          aria: { label: "Unpin #{bucket.name}", pressed: true } do %>
      <%= icon_tag("unpin") %>
    <% end %>
  <% else %>
    <%= button_to buckets_pin_path,
          method: :post,
          params: { bucket_id: bucket.id },
          class: "button",
          data: { intent: "secondary", radius: "full", size: "xs", content: "icon" },
          form: { data: { turbo_stream: true } },
          aria: { label: "Pin #{bucket.name}", pressed: false } do %>
      <%= icon_tag("pin") %>
    <% end %>
  <% end %>
</turbo-frame>

<turbo-frame id="<%= dom_id(bucket, :pin_button) %>">
  <% if bucket.pinned? %>
    <%= button_to buckets_pin_path,
          method: :delete,
          params: { bucket_id: bucket.id },
          class: "button--secondary button--sm",
          form: { data: { turbo_stream: true } },
          aria: { label: "Unpin #{bucket.name}" } do %>
      <%= icon_tag("unpin", style: "color: var(--color-text-base);", class: "button--icon") %>
    <% end %>
  <% else %>
    <%= button_to buckets_pin_path,
          method: :post,
          params: { bucket_id: bucket.id },
          class: "button--secondary button--sm",
          form: { data: { turbo_stream: true } },
          aria: { label: "Pin #{bucket.name}" } do %>
      <%= icon_tag("pin", style: "color: var(--color-text-base);", class: "button--icon") %>
    <% end %>
  <% end %>
</turbo-frame>

<% content_for(:title) { "Projects" } %>

<div class="layout--page layout--container layout--container-md">
  <div class="layout--mx-auto project--header">
    <%= icon_tag("hash", style: "color: var(--color-text-base);", class: "project--header-icon") %>
    <h2>Projects</h2>
  </div>  
  <div class="layout--surface">
    <div class="layout--flex layout--justify-between layout--surface-header">
      <%= back_link_to home_path, class: "button--tertiary button--sm" do %>
        <%= icon_tag("arrow-left") %>
        Back
      <% end %>
    </div>
    
    <turbo-frame id="projects">
      <% if @projects.any? %>
      <ul class="layout--list layout--padded project--list">
        <%= render partial: "projects/project", collection: @projects, as: :project %>
      </ul>
      <% end %>
    </turbo-frame>
  </div>
</div>

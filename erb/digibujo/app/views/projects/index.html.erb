<% content_for(:title) { "Projects" } %>

<main class="layout--container" data-size="md" data-padding="true">
  <div class="layout--surface layout--flex" data-elevation="1" data-padding="true" data-direction="column">
    <header class="layout--container-header">
      <%= back_link_to home_path, class: "button", data: { content: "text", turbo_frame: "_top" } do %>
        <%= icon_tag("arrow-left") %><span>Home</span>
      <% end %>
      <h1>Projects</h1>
      <%= link_to new_project_path, class: "button layout--container-header-action", data: { intent: "primary", radius: "full", size: "xs" } do %>
        <%= icon_tag("plus") %><span>Create</span>
      <% end %>
    </header>
    
    <div id="projects">
      <% if @projects.any? %>
      <ul class="layout--flex project--list" data-direction="column">
        <%= render partial: "projects/project", collection: @projects, as: :project %>
      </ul>
      <% else %>
        <p class="typography--paragraph-sm">No projects yet.</p>
      <% end %>
    </div>
  </div>
</main>

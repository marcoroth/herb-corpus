<%# locals: (project:, pin_path:, pin_params:) %>
<turbo-frame id="<%= dom_id(project, :pin_button) %>">
  <% if project.pinned? %>
    <%= button_to pin_path,
          method: :delete,
          params: pin_params,
          class: "button",
          data: { intent: "secondary", radius: "full", size: "xs", content: "icon" },
          form: { data: { turbo_stream: true } },
          aria: { label: "Unpin #{project.name}", pressed: true } do %>
      <%= icon_tag("unpin") %>
    <% end %>
  <% else %>
    <%= button_to pin_path,
          method: :post,
          params: pin_params,
          class: "button",
          data: { intent: "secondary", radius: "full", size: "xs", content: "icon" },
          form: { data: { turbo_stream: true } },
          aria: { label: "Pin #{project.name}", pressed: false } do %>
      <%= icon_tag("pin") %>
    <% end %>
  <% end %>
</turbo-frame>

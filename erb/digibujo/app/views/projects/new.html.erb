<% content_for(:title) { "New project" } %>

<div class="layout--page layout--container layout--container-md">
  <div class="layout--mx-auto project--header">
    <%= icon_tag("hash", style: "color: var(--color-text-base);", class: "project--header-icon") %>
    <h2>New project</h2>
    <p class="layout--mx-auto layout--container layout--container-sm typography--paragraph-sm layout--padded">Projects work like topic tags — mark bullets with a project and you can instantly see everything related to that goal in one place.</p>
  </div>
  <div class="layout--surface">
    <div class="layout--flex layout--justify-between layout--surface-header">
      <%= back_link_to projects_path, class: "button--tertiary button--sm" do %>
        <%= icon_tag("arrow-left") %>
        Back
      <% end %>
    </div>
    <div class="layout--padded">
      <%= render "projects/form",
            project: @project,
            url: projects_path,
            hint: "Projects work like topic tags — mark bullets with a project and you can instantly see everything related to that goal in one place.",
            name_hint: "Name the project you are working on. Examples: Website redesign, Book draft, Home renovation." %>
    </div>
  </div>
</div>

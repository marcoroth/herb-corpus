<% content_for(:title) { @project.name } %>

<main class="chat--window layout--container" data-size="md">
  <div class="chat--surface layout--surface" data-elevation="1">
    <header class="chat--header chat--resource-header">
      <div class="layout--container-header">
        <%= back_link_to projects_path, class: "button", data: { content: "text", turbo_frame: "_top" } do %>
          <%= icon_tag("arrow-left") %><span>Projects</span>
        <% end %>
        <h1><%= @project.name %></h1>

        <div class="layout--container-header-action dropdown--dock">
          <button type="button" class="button" data-intent="secondary" data-radius="full" data-size="xs"
                  data-content="icon" popovertarget="project_actions" aria-label="Project options" aria-haspopup="menu">
            <%= icon_tag("dots") %>
          </button>

          <div id="project_actions" class="dropdown dropdown--element dropdown--element-bottom animations--side-in"
               style="position-anchor: project_actions" popover data-controller="grid-navigation"
               data-grid-navigation-columns-value="1" data-action="keydown->grid-navigation#navigate">
            <div class="dropdown--element-body">
              <nav class="dropdown--menu" aria-label="Project options">
                <%= link_to edit_project_path(@project), class: "dropdown-item picker--item",
                      data: { turbo_frame: "_top", grid_navigation_target: "item", action: "focus->grid-navigation#syncPosition" } do %>
                  <%= icon_tag("pencil") %>
                  Edit
                <% end %>
              </nav>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="chat--scroller" data-bulk-menu-target="list">
      <% if @bullets.any? %>
        <%= render layout: "pagination/paginated_list",
              locals: {
                page: @page,
                container_id: dom_id(@project, :bullets_container),
                pagination_link_path: ->(next_param) { project_path(@project, page: next_param) }
              } do %>
          <% @page.records.each do |bullet| %>
            <%= render partial: bullet.to_partial_path, locals: { bullet: bullet } %>
          <% end %>
        <% end %>
      <% else %>
        <p class="typography--paragraph-sm">No bullets found</p>
      <% end %>
    </div>
  </div>
</main>

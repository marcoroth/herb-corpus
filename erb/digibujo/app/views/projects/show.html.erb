<% content_for(:title) { @project.name } %>

<div class="layout--page layout--container layout--container-md">
  <div class="layout--mx-auto project--header">
    <%= icon_tag("hash", style: "color: #{colour(@project.colour)};", class: "project--header-icon") %>
    <h2><%= @project.name %></h2>
  </div>
  <p class="utilities--mx-auto typography--paragraph-sm">Type # symbol during writing note to append it to project</p>

  <div class="layout--surface">
    <div class="layout--flex layout--justify-between layout--surface-header">
      <%= back_link_to home_path, class: "button--tertiary button--sm" do %>
        <%= icon_tag("arrow-left", style: "color: var(--color-stroke-base);") %>
      Back
      <% end %>
      <div class="layout--flex layout--gapped">
      <%= render "projects/pins_button",
            project: @project,
            pin_path: projects_pin_path,
            pin_params: { project_id: @project.id } %>
      </div>

  </div>

  <div class="layout--list-grid layout--padded project--list ">
    <div
          data-bulk-menu-target="list"
        >
          <% if @bullets.any? %>
            <%= render layout: "pagination/paginated_list",
                  locals: {
                    page: @page,
                    container_id: dom_id(@project, :bullets_container),
                    pagination_link_path: ->(next_param) { project_path(@project, page: next_param) }
                  } do %>
              <% @page.records.each do |bullet| %>
                <%= render partial: bullet.to_partial_path, locals: { bullet: bullet } %>
              <% end %>
            <% end %>
          <% else %>
          <% end %>
        </div>
  </div>
  
</div>

<% content_for(:title) { @project.name } %>

<div class="layout--page layout--container layout--container-md">
  <header class="layout--padded layout--flex layout--justify-between">

    <div class="layout--flex layout--gapped">
      <%= back_link_to home_path, class: "button--secondary button--sm" do %>
        <%= icon_tag("arrow-left") %>
      <% end %>
      <div class="button--secondary button--sm">
      <%= icon_tag(@project.icon, style: "color: #{colour(@project.colour)};") %>
        <span><%= @project.name %></span>
        </div>
    </div>


    <div class="layout--flex layout--gapped">

  <div class="dropdown--dock">

    <button
      type="button"
      class="button--secondary button--sm"
      popovertarget="project_actions"
      aria-label="Project options"
      aria-haspopup="menu"
    >
      <%= icon_tag("dots") %>
    </button>

    <div
      id="project_actions"
      class="dropdown dropdown--element dropdown--element-bottom animations--side-in"
      style="position-anchor: project_actions"
      popover
      data-controller="grid-navigation"
      data-grid-navigation-columns-value="1"
      data-action="keydown->grid-navigation#navigate"
    >
      <div class="dropdown--element-body">
        <nav class="dropdown--menu" aria-label="Project options">

            <%= link_to edit_project_path(@project),
                class: "dropdown-item",
                data: { turbo_frame: "_top", grid_navigation_target: "item", action: "focus->grid-navigation#syncPosition" } do %>
            <%= icon_tag("pencil") %>
            Edit
          <% end %>
        </nav>
      </div>
    </div>
  </div>
  </div>
</header>

  <div class="layout--list layout--padded ">
    <div
          data-bulk-menu-target="list"
    >
          <% if @bullets.any? %>
            <%= render layout: "pagination/paginated_list",
                  locals: {
                    page: @page,
                    container_id: dom_id(@project, :bullets_container),
                    pagination_link_path: ->(next_param) { project_path(@project, page: next_param) }
                  } do %>
              <% @page.records.each do |bullet| %>
                <%= render partial: bullet.to_partial_path, locals: { bullet: bullet } %>
              <% end %>
            <% end %>
          <% else %>
            <p class="typography--paragraph-sm">No bullets found</p>
          <% end %>
        </div>
        </div>
      </div>

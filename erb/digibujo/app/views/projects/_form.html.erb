<%# locals: (project:, url:, hint:, name_hint:) %>
<%= form_with model: project, url: url, class: "form" do |f| %>
  <div class="form-section">
    <%= f.label :name %>
    <small><%= name_hint %></small>
    <%= f.text_field :name, required: true %>
  </div>
  <%= render "shared/form/colour_picker", form: f %>
  <%= f.submit class: "button form--submit", data: { intent: "primary", radius: "full", size: "sm" } %>
<% end %>

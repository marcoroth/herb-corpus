<%# locals: (hook:) %>
<article
  id="<%= dom_id(hook) %>"
  class="layout--surface layout--flex"
  data-elevation="2"
  data-padding="true"
  data-justify="between"
  data-align="center"
>
  <div class="layout--flex" data-direction="column">
    <div>
      <strong><%= hook.name %></strong>
      <code><%= hook.code_prefix %>…</code>
    </div>
    <span class="typography--paragraph-sm"><%= l(hook.created_at.to_date, format: :long) %></span>
  </div>

  <%= button_to hook_path(hook),
        method: :delete,
        class: "button",
        data: { intent: "secondary", radius: "full", size: "xs", status: "negative" },
        form: { data: { turbo_confirm: "Revoke this hook? External apps using it will stop working." } } do %>
    <%= icon_tag("trash") %>
    <span>Revoke</span>
  <% end %>
</article>

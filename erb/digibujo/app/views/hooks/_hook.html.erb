<%# locals: (hook:) %>
<li id="<%= dom_id(hook) %>" class="layout--flex layout--justify-between layout--padded layout--surface">
  <div class="hooks--row-meta">
    <div class="hooks--row-title">
      <strong><%= hook.name %></strong>
      <code><%= hook.code_prefix %>…</code>
    </div>
    <div class="typography--paragraph-sm"><%= l(hook.created_at.to_date, format: :long) %></div>
  </div>
  <%= button_to hook_path(hook),
        method: :delete,
        class: "button--secondary button--sm button--danger",
        form: { class: "hooks--row-action", data: { turbo_confirm: "Revoke this hook? External apps using it will stop working." } } do %>
    <%= icon_tag("trash") %>
    Revoke
  <% end %>
</li>

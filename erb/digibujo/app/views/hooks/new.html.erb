<% content_for(:title) { "New hook" } %>

<div class="layout--page layout--container layout--container-md">
  <div class="layout--mx-auto hooks--header">
    <span class="hooks--header-shell" aria-hidden="true">
      <%= icon_tag("webhook", class: "hooks--header-icon") %>
    </span>
    <h2>New hook</h2>
    <p class="typography--paragraph-sm">
      Name the integration, then share the URL Digibujo gives you.
    </p>
  </div>

  <div class="layout--surface">
    <div class="layout--flex layout--justify-between layout--surface-header">
      <%= back_link_to hooks_path, class: "button--tertiary button--sm" do %>
        <%= icon_tag("arrow-left") %>
        Back
      <% end %>
    </div>

    <div class="hooks--body">
      <section class="hooks--section">
        <h3 class="hooks--section-title">How to call it</h3>
        <p class="typography--paragraph-sm">
          After create you’ll get a URL. External apps <strong>POST</strong> JSON to it.
          <code>bulletable_type</code> is <code>Note</code> or <code>Task</code>.
          <code>author_name</code> is optional.
        </p>
        <pre class="hooks--sample" role="doc-example"><%=
          JSON.pretty_generate(
            author_name: "Zapier",
            bulletable_type: "Note",
            body: "Ship the release"
          )
        %></pre>
      </section>

      <section class="hooks--section">
        <h3 class="hooks--section-title">Details</h3>
        <%= form_with model: @hook, url: hooks_path, class: "form hooks--form" do |f| %>
          <div class="form-section">
            <label for="hook_name">Name</label>
            <small>Label for you, e.g. “Zapier” or “GitHub”.</small>
            <%= f.text_field :name, class: "form-input", required: true, autofocus: true %>
            <% if @hook.errors[:name].any? %>
              <small class="form--errors"><%= @hook.errors.full_messages_for(:name).to_sentence %></small>
            <% end %>
          </div>
          <%= f.submit "Create hook", class: "button--primary form--submit" %>
        <% end %>
      </section>
    </div>
  </div>
</div>

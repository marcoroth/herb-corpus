<% content_for(:title) { "Hooks" } %>

<div class="layout--page layout--container layout--container-md">
  <div class="layout--mx-auto layout--padded layout--justify-between">
    <div class="layout--padded layout--flex layout--gapped layout--justify-center layout--surface-accented" aria-hidden="true">
      <%= icon_tag("webhook", class: "hooks--header-icon") %>
    </div>
    <br>
    <h2>Hooks</h2>

  </div>
  <p class="layout--padded layout--mx-auto">
    Give an external app a URL. When it posts, Digibujo drops a Note or Task into Pending.
  </p>

  <div class="layout--surface">
    <div class="layout--flex layout--justify-between layout--surface-header">
      <%= back_link_to user_path, class: "button--tertiary button--sm" do %>
        <%= icon_tag("arrow-left") %>
        Back
      <% end %>
      <%= link_to new_hook_path, class: "button--primary button--sm" do %>
        <%= icon_tag("plus") %>
        Create
      <% end %>
    </div>

    <div class="layout--padded">
      <% if @created_hook_code.present? %>
        <section class="layout--grid layout--gapped layout--padded layout--surface-sunken" role="status">
          <p class="typography--paragraph-md typography--bold">
            <strong>Copy this URL now.</strong> You won’t see the code again.
          </p>
          <code class="layout--padded layout--surface-accented"><%= hook_intake_url(@created_hook_code) %></code>
        </section>
      <% end %>

      <% if @hooks.any? %>
        <ul id="hooks" class="layout--padded layout--list">
          <%= render partial: "hooks/hook", collection: @hooks, as: :hook %>
        </ul>
      <% else %>
        <p id="hooks_empty" class="typography--paragraph-sm hooks--empty">No hooks yet.</p>
      <% end %>
    </div>
  </div>
</div>

<% content_for(:title) { "Account" } %>

<main class="layout--page layout--container layout--container-sm">
  <div class="layout--flex layout--justify-between layout--padded">
    <div class="button--primary layout--mx-auto">
      <%= Current.user.email_address.first.upcase %>
    </div>

  </div>


      <div class="layout--grid layout--justify-between">
        <div class="layout--flex layout--gapped layout--justify-between">
      <%= back_link_to home_path, class: "button--secondary button--sm" do %>
        <%= icon_tag("arrow-left") %>

      Back
    <% end %>
    <p class="button--secondary button--sm"><%= Current.user.email_address %></p>
        </div>

        <br>
    <div class="layout--padded layout--flex layout--gapped layout--surface layout--flex-wrap">

      <%= link_to access_codes_path, class: "button--secondary" do %>
        <%= icon_tag("code") %>
        Access codes
      <% end %>

      <%= link_to hooks_path, class: "button--secondary" do %>
        <%= icon_tag("webhook") %>
        Hooks
      <% end %>

      <%= button_to authentication_path,
              method: :delete,
              class: "button--secondary",
              form: { data: { turbo_confirm: "Sign out of Digibujo?" } } do %>
        <%= icon_tag("sign-out") %>
        Sign out
      <% end %>
    </div>
    </div>
</main>

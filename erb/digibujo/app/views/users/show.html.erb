<% content_for(:title, "Account") %>

<main class="layout--container" data-size="sm">
  <div class="layout--surface layout--flex" data-padding="true" data-direction="column">


    <div class="layout--surface" data-elevation="1" data-padding="true" aria-label="Account settings">
      <header class="layout--flex" data-align="center" data-elevation="1" data-padding="true">
        <%= back_link_to home_path,
              class: "button",
              data: { intent: "secondary", radius: "full", size: "sm", content: "icon", turbo_frame: "_top" },
              aria: { label: "Back to Home" } do %>
          <%= icon_tag("arrow-left") %>
        <% end %>
        <h2>Account</h2>
      </header>
      <section class="layout--flex" data-direction="column" data-align="center">
        <span
          class="button"
          data-intent="primary"
          data-radius="full"
          data-size="xl"
          data-content="icon"
          aria-hidden="true"
        ><%= Current.user.email_address.first.upcase %></span>
        <p class="typography--paragraph-sm"><%= Current.user.email_address %></p>
      </section>
      <br>
      <nav class="layout--flex" data-justify="center" data-wrap="true">
      <%= link_to access_codes_path,
            class: "button",
            data: { intent: "secondary", radius: "full", size: "sm" } do %>
        <%= icon_tag("code") %>
        <span>Access codes</span>
      <% end %>

      <%= link_to hooks_path,
            class: "button",
            data: { intent: "secondary", radius: "full", size: "sm" } do %>
        <%= icon_tag("webhook") %>
        <span>Hooks</span>
      <% end %>

      <%= button_to authentication_path,
            method: :delete,
            class: "button",
            data: { intent: "secondary", radius: "full", size: "sm", status: "negative" },
            form: { data: { turbo_confirm: "Sign out of Digibujo?" } } do %>
        <%= icon_tag("sign-out") %>
        <span>Sign out</span>
      <% end %>
    </nav>
  </div>
  </div>
</main>

<% content_for(:title) { "Account" } %>

<main class="layout--page layout--container layout--container-sm layout--surface-sunken">
  <div class="layout--mx-auto user--header">
    <div class="button--primary layout--mx-auto">
      <%= Current.user.email_address.first.upcase %>
    </div>
  
  </div>

    <div class="layout--surface">
      <div class="layout--flex layout--justify-between layout--surface-header">
      <%= back_link_to home_path, class: "button--tertiary button--sm" do %>
        <%= icon_tag("arrow-left") %>

      Back
    <% end %>
    </div>
    <div class="layout--padded layout--flex layout--gapped">
  

      <%= link_to access_codes_path, class: "button--secondary" do %>
        <%= icon_tag("code") %>
        Access codes
      <% end %>

      <%= link_to hooks_path, class: "button--secondary" do %>
        <%= icon_tag("webhook") %>
        Hooks
      <% end %>

      <%= button_to authentication_path,
              method: :delete,
              class: "button--secondary",
              form: { data: { turbo_confirm: "Sign out of Digibujo?" } } do %>
        <%= icon_tag("sign-out") %>
        Sign out
      <% end %>
    </div>
    </div>
</main>

<% content_for(:title, "Attachments") %>

<main class="layout--container" data-size="md" data-padding="true">
  <div class="layout--surface" data-elevation="1" data-padding="true">
    <header class="layout--flex" data-align="center" data-justify="between">
      <div class="layout--flex" data-align="center">
      <%= back_link_to home_path,
            class: "button",
            data: { intent: "secondary", radius: "full", size: "sm", content: "icon" } do %>
        <%= icon_tag("arrow-left") %>
      <% end %>
      <h2>Attachments</h2>
      </div>
    </header>
    <br>
    <% if @attachments.any? %>
      <div class="layout--flex" data-direction="column" data-padding="true">
        <% @attachments.each do |attachment| %>
          <%= link_to attachment_path(attachment.blob.signed_id),
                class: "button",
                data: { intent: "secondary", radius: "full", size: "sm", turbo_frame: "_top" },
                aria: { label: "View #{attachment.blob.filename}" } do %>
            <%= icon_tag(attachment.blob.image? ? "camera" : attachment.blob.audio? ? "microphone" : "paperclip") %>
            <span><%= attachment.blob.filename %></span>
            <span><%= number_to_human_size(attachment.blob.byte_size) %></span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="typography--paragraph-sm typography--balanced">No attachments yet.</p>
    <% end %>
  </div>
</main>

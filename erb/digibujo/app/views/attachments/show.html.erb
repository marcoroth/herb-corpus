<% content_for(:title) { @blob.filename.to_s } %>

<div class="layout--page layout--container layout--container-md">
  <div class="layout--flex layout--justify-between layout--surface-header">
    <div class="header--controls button--secondary button--sm">
      <%= back_link_to home_path, class: "button--tertiary button--sm" do %>
        <%= icon_tag("arrow-left") %>
        Back
      <% end %>
    </div>
    <div class="header--controls button--secondary button--sm">
      <%= icon_tag("attachment") %>
      <p>Attachment</p>
    </div>
  </div>

  <article class="layout--surface attachment--show">
    <% if @blob.representable? %>
      <%= represent_image_tag @blob,
            variant: :display,
            alt: @blob.filename,
            class: "attachment--show-image" %>
    <% else %>
      <p class="typography--paragraph">
        <%= link_to @blob.filename,
              rails_blob_path(@blob, disposition: "attachment"),
              data: { turbo: false } %>
        · <%= number_to_human_size @blob.byte_size %>
      </p>
    <% end %>
  </article>
</div>

<% content_for(:title) { @blob.filename.to_s } %>

<div class="layout--container" data-size="md">
  <div class="layout--surface" data-elevation="1" data-padding="true">
    <div class="layout--flex" data-align="center" data-justify="between">
      <div class="layout--flex" data-align="center">
        <%= back_link_to home_path, class: "button", data: { intent: "secondary", radius: "full", size: "sm", content: "icon" } do %>
          <%= icon_tag("arrow-left") %>
        <% end %>
        <h2>Attachment</h2>
      </div>
    </div>
  </div>

  <article class="layout--surface attachment--show" data-padding="true">
    <% if @blob.representable? %>
      <%= represent_image_tag @blob,
            variant: :display,
            alt: @blob.filename,
            class: "attachment--show-image" %>
    <% else %>
      <p class="typography--paragraph">
        <%= link_to @blob.filename,
              rails_blob_path(@blob, disposition: "attachment"),
              data: { turbo: false } %>
        · <%= number_to_human_size @blob.byte_size %>
      </p>
    <% end %>
  </article>
</div>

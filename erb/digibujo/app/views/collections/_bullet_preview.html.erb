<%# locals: (bullet:) %>
<li class="bucket--collect-preview-item" data-bullet-type="<%= bullet.bulletable_type.downcase %>">
  <span class="bullet--marker bucket--collect-preview-marker" aria-hidden="true">
    <%= icon_tag(bullet.marker_icon, style: "color: #{colour(bullet.colour)};", class: "") %>
  </span>
  <span class="bucket--collect-preview-name utilities--line-clamp-1"><%= bullet.name %></span>
</li>

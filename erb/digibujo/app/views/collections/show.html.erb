<% content_for(:title) { @collection.name } %>

<div class="chat--window collection--window layout--container" data-size="md">
  <div class="chat--surface layout--surface" data-elevation="1">
  <header class="chat--header">
    <div class="layout--flex layout--surface" data-elevation="1" data-align="center" data-justify="between">
      <div class="layout--flex" data-align="center">
      <%= back_link_to collections_path, class: "button", data: { intent: "secondary", radius: "full", size: "sm", content: "icon", turbo_frame: "_top" } do %>
        <%= icon_tag("arrow-left") %>
      <% end %>
      <h1 class="typography--line-clamp-1"><%= @collection.name %></h1>
      </div>

      <div class="layout--container-header-action layout--flex" data-align="center">
        <%= render "buckets/pins_button", bucket: @collection.bucket %>
        <div class="dropdown--dock">

      <button
        type="button"
        class="button"
        data-intent="secondary"
        data-radius="full"
        data-size="xs"
        data-content="icon"
        popovertarget="collection_actions"
        aria-label="Collection options"
        aria-haspopup="menu"
      >
        <%= icon_tag("dots") %>
      </button>

      <div
        id="collection_actions"
        class="dropdown dropdown--element dropdown--element-bottom animations--side-in"
        style="position-anchor: collection_actions"
        popover
        data-controller="grid-navigation"
        data-grid-navigation-columns-value="1"
        data-action="keydown->grid-navigation#navigate"
      >
        <div class="dropdown--element-body">
          <nav class="dropdown--menu" aria-label="Collection options">


            <%= link_to collection_export_path(@collection),
                  class: "dropdown-item picker--item",
                  data: { turbo: false, grid_navigation_target: "item", action: "focus->grid-navigation#syncPosition" } do %>
              <%= icon_tag("file") %>
              Export
            <% end %>

            <%= link_to edit_collection_path(@collection),
                  class: "dropdown-item picker--item",
                  data: { turbo_frame: "_top", grid_navigation_target: "item", action: "focus->grid-navigation#syncPosition" } do %>
              <%= icon_tag("pencil") %>
              Edit
            <% end %>
          </nav>
        </div>
      </div>
        </div>
      </div>
    </div>
    <% if @collection.description.present? %>
    <br>
      <div class="layout--surface" data-elevation="2" data-padding="true">
        <%= @collection.description %>
      </div>
    <% end %>
  </header>


  <div
    id="<%= dom_id(@collection.bucket, nil) %>"
    class="chat--scroller"
    data-controller="chat-scroll"
    data-chat-scroll-path-value="<%= collection_bullets_path(@collection) %>"
    data-bulk-menu-target="list"
  >
      <% if @more_bullets %>
        <div
          class="chat--load-more-trigger"
          data-chat-scroll-target="trigger"
        >
          <%= icon_tag("spinner", class: "icon icon--spin") %>
          <span class="utilities--sr-only">Loading more bullets</span>
        </div>
      <% end %>

      <% previous_date = nil %>
      <% @bullets.each do |bullet| %>
        <% date = bullet.created_at.in_time_zone.to_date %>
        <% if previous_date != date %>
        <div class="layout--flex" data-justify="center" role="separator" aria-label="<%= date.strftime('%b %-d, %Y') %>">
          <%= link_to daylog_path(date: date.iso8601),
                  class: "button collection--date-pill",
                  data: { content: "text", turbo_frame: "_top" } do %>
              <time datetime="<%= date.iso8601 %>"><%= date.strftime('%b %-d, %Y') %></time>
            <% end %>
          </div>
          <% previous_date = date %>
        <% end %>
        <%= render partial: bullet.to_partial_path, locals: { bullet: bullet } %>
      <% end %>
  </div>

  <div id="<%= dom_id(@collection, :composer) %>" class="chat--composer composer--dock" data-controller="chat-composer">
    <%= render "bullets/composer_v2",
          bullet: Bullet.new,
          bucket_id: @collection.bucket.id,
          pops_on: nil,
          allowed_bulletable_variants: ["Note", "Task", "Event", "Voice"],
          preset: "default",
          autofocus: false,
          composer_id: dom_id(@collection, :bullets_composer) %>
  </div>
  </div>
</div>

<% content_for(:title) { @collection.name } %>

<div class="layout--page layout--container layout--container-md">
  <div class="utilities--mx-auto collection--header">
    <%= icon_tag(@collection.bucket.icon, style: "color: #{colour(@collection.bucket.colour)};", class: "collection--header-icon") %>
      <h2><%= @collection.name %></h2>
      <% if @collection.description.present? %>
        <p><%= @collection.description %></p>
      <% end %>
  </div>
  <div class="layout--surface">
  <div class="layout--flex layout--justify-between layout--surface-header">
    <%= back_link_to home_path, class: "button--tertiary button--sm" do %>
      <%= icon_tag("arrow-left", style: "color: var(--color-text-base);", class: "button--icon") %>
      Back
    <% end %>

    <div class="layout--flex layout--gapped">
    <%= render "buckets/pins_button", bucket: @collection.bucket %>
    <%= link_to collection_export_path(@collection),
          class: "button--secondary button--sm",
          data: { turbo: false } do %>
      <%= icon_tag("file", style: "color: var(--color-text-base);", class: "button--icon") %>
      Export
    <% end %>
    <%= link_to edit_collection_path(@collection), class: "button--secondary button--sm" do %>
      <%= icon_tag("pencil", style: "color: var(--color-text-base);", class: "button--icon") %>
      Edit
    <% end %>
    </div>
  </div>

  <div class="layout--list layout--padded collection--list">
        <div
          data-bulk-menu-target="list"
        >
          <%= render layout: "pagination/paginated_list",
                locals: {
                  page: @page,
                  container_id: dom_id(@collection, :bullets_container),
                  pagination_link_path: ->(next_param) { collection_path(@collection, page: next_param) }
                } do %>
            <% previous_date = @previous_date %>
            <% @page.records.each do |bullet| %>
              <% date = bullet.created_at.in_time_zone.to_date %>
              <% if previous_date != date %>
                <%= render "collections/date_divider", date: date %>
                <% previous_date = date %>
              <% end %>
              <%= render partial: bullet.to_partial_path, locals: { bullet: bullet } %>
            <% end %>
          <% end %>
        </div>
  </div>

  <%= render "bullets/composer",
        bucket_id: @collection.bucket.id,
        composer_id: dom_id(@collection, :bullets_composer) %>
</div>
</div>

<%# locals: (date:) %>
<div class="collection--date-divider" role="separator" aria-label="<%= date.strftime('%b %-d, %Y') %>">
  <%= link_to daylog_path(date: date.iso8601),
        class: "collection--date-pill",
        data: { turbo_frame: "_top" } do %>
    <time datetime="<%= date.iso8601 %>"><%= date.strftime('%b %-d, %Y') %></time>
  <% end %>
</div>

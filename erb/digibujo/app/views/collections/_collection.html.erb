<%= link_to collection_path(collection), class: "bucket--section-list-item" do %>
  <%= icon_tag(collection.bucket.icon, style: "color: #{colour(collection.bucket.colour)};", class: "bucket--section-list-item-icon") %>
  <span class="typography--line-clamp-1"><%= collection.name %></span>
  <span aria-hidden="true">·</span>
  <span class="typography--paragraph-sm typography--line-clamp-1">
    <%= collection.bullets.count %>
    <%= "bullet".pluralize(collection.bullets.count) %>,
    <%= collection.created_at.strftime("%b %d") %>
  </span>
<% end %>

<%# locals: (collection:, bullet_ids: nil, return_to: nil) %>
<%= form_with model: collection, class: "form" do |f| %>
  <% if bullet_ids.present? %>
    <%= hidden_field_tag :bullet_ids, bullet_ids %>
    <%= hidden_field_tag :return_to, return_to if return_to.present? %>
  <% end %>

  <div class="form-section">
    <%= f.label :name %>
    <small><%= bullet_ids.present? ? "Give your collection a name." : "Give your collection a name. Examples: Reading list, Travel plans, Work ideas." %></small>
    <%= f.text_field :name, class: "form-input", required: true %>
  </div>
  <%= render "shared/form/colour_picker", form: f %>
  <%= render "shared/form/icon_picker", form: f %>

  <div class="form-section">
    <%= f.label :description %>
    <small>Optional. A short note about what belongs in this collection.</small>
    <%= f.text_area :description, class: "form-input", maxlength: 280, rows: 3 %>
  </div>

  <% if bullet_ids.present? %>
    <%= f.submit "Create and collect", class: "button form--submit", data: { intent: "primary", radius: "full", size: "sm" } %>
  <% else %>
    <%= f.submit class: "button form--submit", data: { intent: "primary", radius: "full", size: "sm" } %>
  <% end %>
<% end %>

<% content_for(:title) { "New collection" } %>


<div class="layout--page layout--container layout--container-md">
  <% unless @bullets.present? %>
  <div class="layout--grid layout--gapped">
    <div class="button--secondary button--sm layout--mx-auto">
    <%= icon_tag("folder") %>
    <span>New collection</span>
    </div>
    <p class="layout--mx-auto layout--container layout--container-sm typography--paragraph-sm layout--padded typography--balanced typography--center">Collections are like folders in a traditional notebook — group related tasks, notes, or events together and keep them organised for as long as you need</p>
  </div>
  <% end %>
  <div class="layout--surface">
    <div class="layout--flex layout--justify-between layout--surface-header">
      <%= back_link_to @return_to.presence || home_path, class: "button--tertiary button--sm" do %>
        <%= icon_tag("arrow-left") %>
        Back
      <% end %>
    </div>

  <div id="<%= dom_id(@collection) %>" class="layout--padded">

    <%= render "form",
          collection: @collection,
          bullet_ids: @bullet_ids,
          return_to: @return_to %>

    <% if @bullets.present? %>
      <section class="bucket--collect-preview">
        <h3 class="bucket--collect-preview-heading">
          <%= pluralize(@bullets.size, "bullet") %> will be added
        </h3>
        <ul class="bucket--collect-preview-list">
          <%= render partial: "collections/bullet_preview", collection: @bullets, as: :bullet %>
        </ul>
      </section>
    <% end %>
  </div>
</div>
</div>

<% content_for(:title) { "#{@collection.name} export (#{@bullets.size} #{"bullet".pluralize(@bullets.size)})" } %>

<header class="export--header">
  <div class="button--secondary button--sm">
    <%= icon_tag("folder") %>
    <%= @collection.name %> export
  </div>
  <p class="export--meta">
    <%= @bullets.size %> <%= "bullet".pluralize(@bullets.size) %> · exported <%= Time.current.strftime("%-d %b %Y") %>
  </p>
</header>

<div class="export--list">
  <% @bullets.each do |bullet| %>
    <% task_completed = bullet.completed? %>
    <article class="export--bullet">
      <header class="export--bullet-header">
        <span class="export--bullet-type"><%= bullet.bulletable_type %></span>
        <time datetime="<%= bullet.created_at.iso8601 %>"><%= bullet.created_at.strftime("%-d %b %Y") %></time>
        <% if bullet.pops_on.present? %>
          <span>Pop: <%= bullet.pops_on.strftime("%-d %b %Y") %></span>
        <% end %>
        <% if bullet.bucket&.bucketable %>
          <span class="export--tag"><%= bullet.bucket.name %></span>
        <% end %>
        <% if bullet.pinned? %>
          <span class="export--tag">Pinned</span>
        <% end %>
        <% if bullet.archived? %>
          <span class="export--tag">Archived</span>
        <% end %>
        <% if task_completed %>
          <span class="export--tag">Completed</span>
        <% end %>
      </header>
      <div class="export--bullet-body<%= " export--bullet-body--completed" if task_completed %>">
        <%= bullet.body %>
      </div>
    </article>
  <% end %>
</div>

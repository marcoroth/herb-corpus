<% content_for(:title) { "New future log" } %>

<div class="layout--page layout--container layout--container-md">
  <div class="layout--mx-auto future--header">
    <%= icon_tag("calendar", style: "color: var(--color-text-base);", class: "future--header-icon") %>
    <h2>New future log</h2>
    <p class="layout--mx-auto layout--container layout--container-sm typography--paragraph-sm layout--padded">Future logs are like a time machine — capture your dreams, goals, and aspirations for the future, and revisit them whenever you need a reminder of what's important to you.</p>
  </div>
  <div class="layout--surface">
    <div class="layout--flex layout--justify-between layout--surface-header">
    <%= back_link_to home_path, class: "button--tertiary button--sm" do %>
        <%= icon_tag("arrow-left") %>
        Back
      <% end %>
    </div>
    <div class="layout--padded">
      <%= render "form", future: @future %>
    </div>
  </div>
</div>

<% if @future %>
  <% content_for(:title) { @future.name } %>

  <div class="layout--page layout--container layout--container-md future future--chat">
    <header class="future--chat-header">
      <div class="layout--flex layout--gapped layout--justify-between">
        <div class="future--header-controls">
          <%= back_link_to home_path, class: "button--tertiary button--circle", aria: { label: "Home" } do %>
            <%= icon_tag("arrow-left") %>
          <% end %>
          <span class="typography--mono typography--paragraph-sm"><%= @future.name %></span>
        </div>

        <div class="future--header-controls">
          <%= render "buckets/pins_button", bucket: @future.bucket %>
        </div>
      </div>
    </header>

    <div
      class="chat--wrap"
      data-bulk-menu-target="list"
    >
      <div
        id="future_scroller"
        class="chat--scroller"
        data-controller="pops-drop drop-postpone-optimistic"
        data-pops-drop-pops-url-value="<%= postpone_path %>"
        data-pops-drop-bucket-id-value="<%= @future.bucket.id %>"
        data-pops-drop-requested-with-value="pops-drop"
        data-pops-drop-optimistic-value="drop-postpone-optimistic"
        data-drop-zone-value=""
        data-action="dragover->pops-drop#dragover dragleave->pops-drop#dragleave drop->pops-drop#drop"
      >
        <div
          id="future_bullets_unplanned_container"
          class="layout--list chat--compact-list-pinned"
        >
          <% @bullets.each do |bullet| %>
            <%= render "futures/bullets/bullet", bullet: bullet %>
          <% end %>

          <% if @bullets.empty? %>
            <p
              id="no_bullets_container"
              class="typography--paragraph-sm typography--center layout--padded layout--mx-auto"
            >
              Dump year goals, long-term thoughts, and potential projects here.
            </p>
          <% end %>
        </div>
      </div>
    </div>

    <%= render "bullets/composer",
          bucket_id: @future.bucket.id,
          pops_on: nil,
          variants: %w[Task Note],
          composer_id: "future_bullets_unplanned_composer" %>
  </div>
<% else %>
  <% content_for(:title) { "Future log" } %>

  <div class="layout--page layout--container layout--container-md">
    <div class="layout--surface layout--mx-auto">
      <div class="layout--surface-header">
        <h2>Future log</h2>
      </div>
      <div class="layout--surface layout--padded layout--mx-auto">
        <p class="typography--paragraph-sm typography--center">No future log yet. Create one to capture long-term plans and someday ideas.</p>
        <div class="layout--padded">
          <%= link_to "Create future log", new_future_path, class: "button--primary layout--mx-auto" %>
        </div>
      </div>
    </div>
  </div>
<% end %>

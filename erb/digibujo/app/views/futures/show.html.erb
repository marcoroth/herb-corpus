<% if @future %>
  <% content_for(:title) { @future.name } %>

  <div class="chat--window layout--container" data-size="md">
    <div class="chat--surface layout--surface" data-elevation="1">
      <header class="chat--header">
        <div class="layout--flex" data-align="center" data-justify="between">
          <%= back_link_to home_path, class: "button", data: { intent: "secondary", radius: "full", size: "sm", content: "icon", turbo_frame: "_top" } do %>
            <%= icon_tag("arrow-left") %>
          <% end %>
          <h1><%= @future.name %></h1>
          <%= render "buckets/pins_button", bucket: @future.bucket %>
        </div>
      </header>

    <div
      id="<%= dom_id(@future.bucket, nil) %>"
      class="chat--scroller"
      data-chat-scroll-path-value="<%= future_bullets_path(@future) %>"
      data-bulk-menu-target="list"
      data-controller="chat-scroll pops-drop drop-postpone-optimistic"
      data-pops-drop-pops-url-value="<%= postpone_path %>"
      data-pops-drop-bucket-id-value="<%= @future.bucket.id %>"
      data-pops-drop-requested-with-value="pops-drop"
      data-pops-drop-optimistic-value="drop-postpone-optimistic"
      data-drop-zone-value=""
      data-action="dragover->pops-drop#dragover dragleave->pops-drop#dragleave drop->pops-drop#drop"
    >
        <% if @more_bullets %>
          <div
            class="chat--load-more-trigger"
            data-chat-scroll-target="trigger"
          >
            <%= icon_tag("spinner", class: "icon icon--spin") %>
            <span class="utilities--sr-only">Loading more bullets</span>
          </div>
        <% end %>
        <% @bullets.each do |bullet| %>
          <%= render "futures/bullets/bullet", bullet: bullet %>
        <% end %>

        <% if @bullets.empty? %>
          <p
            id="no_bullets_container"
            class="typography--paragraph-sm typography--center"
          >
            Dump year goals, long-term thoughts, and potential projects here.
          </p>
        <% end %>
    </div>

    <div class="chat--composer composer--dock" data-controller="chat-composer">
      <%= render "bullets/composer_v2",
            bullet: Bullet.new,
            bucket_id: @future.bucket.id,
            pops_on: nil,
            allowed_bulletable_variants: ["Task", "Note"],
            preset: "default",
            autofocus: false,
            composer_id: "future_bullets_unplanned_composer" %>
    </div>
    </div>
  </div>
<% else %>
  <% content_for(:title) { "Future log" } %>

  <main class="layout--container" data-size="md" data-padding="true">
    <div class="layout--surface layout--flex" data-elevation="1" data-padding="true" data-direction="column">
      <header class="layout--container-header">
        <%= back_link_to home_path, class: "button", data: { content: "text", turbo_frame: "_top" } do %>
          <%= icon_tag("arrow-left") %><span>Home</span>
        <% end %>
        <h1>Future log</h1>
      </header>
      <p class="typography--paragraph-sm typography--center">No future log yet. Create one to capture long-term plans and someday ideas.</p>
      <%= link_to "Create future log", new_future_path, class: "button",
            data: { intent: "primary", radius: "full", size: "sm" } %>
    </div>
  </main>
<% end %>

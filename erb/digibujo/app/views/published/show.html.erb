<% content_for(:title) { @bullet.name } %>


  <article class="layout--surface layout--padded">
    <div class="utilities--text-lg">
      <%= @bullet.body %>

    </div>


    <footer class="public--published-footer">
      <time class="public--published-date" datetime="<%= @bullet.created_at.iso8601 %>"><%= @bullet.created_at.strftime("%-d %b %Y") %></time>
    </footer>


  </article>
  <br>
  <input class="public--published-link"
  type="text"
  value="<%= published_url(@bullet.public_code) %>"
  readonly
  onclick="this.select()"
  >

<% if type == "errmsg" %>
  <div
    class="toasts--message toasts--errmsg"
    data-toasts-target="errmsg"
    role="alert"
    aria-live="assertive">
    <ul>
      <% messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% elsif type == "notify" %>
  <div
    class="toasts--message toasts--notify"
    data-toasts-target="notify"
    role="status"
    aria-live="polite">
    <%= messages.first %>
  </div>
<% end %>

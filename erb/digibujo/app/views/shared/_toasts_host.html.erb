<%# Toast host: seeded from redirect flash; turbo-stream updates inject .toasts--message. %>
<div
  id="toasts"
  class="toasts"
  data-controller="toasts"
  aria-live="polite"
>
  <% if flash[:alert].present? %>
    <%= render "shared/toasts", type: "errmsg", messages: Array.wrap(flash[:alert]) %>
  <% end %>
  <% if flash[:notice].present? %>
    <%= render "shared/toasts", type: "notify", messages: Array.wrap(flash[:notice]) %>
  <% end %>
</div>

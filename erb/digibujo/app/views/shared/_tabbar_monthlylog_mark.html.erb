<%# Monthlylog tabbar mark — square sibling of the daylog mark, day number as accent. %>
<svg
  class="tabbar--mark tabbar--item-icon"
  viewBox="0 0 32 32"
  width="32"
  height="32"
  aria-hidden="true"
  focusable="false"
>
  <rect class="tabbar--mark-ring" x="5" y="5" width="22" height="22" rx="3" />
  <text
    class="tabbar--mark-date"
    x="16"
    y="16"
    text-anchor="middle"
    dominant-baseline="central"
    font-size="12"
  ><%= Date.current.day %></text>
</svg>

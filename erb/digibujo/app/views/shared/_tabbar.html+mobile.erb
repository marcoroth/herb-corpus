<nav class="tabbar--navigation">
  <%= link_to home_path, class: "tabbar--item #{'tabbar--item-active' if controller_name == 'home'}", aria: { label: "Menu" } do %>
    <i class="icon tabbar--item-icon" style="--icon-mask: var(--icon-home)" aria-hidden="true"></i>
  <% end %>
  <%= link_to daylog_path, class: "tabbar--item #{'tabbar--item-active' if controller_name == 'daylogs'}", aria: { label: "Daily log" } do %>
    <%= render "shared/tabbar_daylog_mark" %>
  <% end %>
  <%= link_to current_monthlylog_path, class: "tabbar--item #{'tabbar--item-active' if controller_name == 'monthlylogs'}", aria: { label: "Monthly log" } do %>
    <%= render "shared/tabbar_monthlylog_mark" %>
  <% end %>
  <%= link_to pinned_index_path, class: "tabbar--item #{'tabbar--item-active' if controller_name == 'pinned'}", aria: { label: "Pinned" } do %>
    <i class="icon tabbar--item-icon" style="--icon-mask: var(--icon-pin)" aria-hidden="true"></i>
  <% end %>
</nav>

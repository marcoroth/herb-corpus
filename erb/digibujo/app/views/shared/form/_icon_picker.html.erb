<% primary_icons, more_icons = Iconable::ICON_MAPPINGS.partition.with_index { |_, index| index < 8 } %>

<div class="form-section">
  <label>Icon</label>
  <small>
    Pick an icon to make this record easy to spot.
  </small>
  <input
    class="form--icon-picker-more-toggle"
    type="checkbox"
    id="<%= form.field_id(:icon, :more) %>"
    <%= "checked" if form.object.icon.in?(more_icons) %>
  >
  <div class="form--picker form--icon-picker" role="radiogroup" aria-label="Icon picker">
    <% primary_icons.each do |icon| %>
      <label class="form--picker-option">
        <%= form.radio_button :icon, icon %>
        <%= icon_tag(icon, class: "form--picker-control form--icon") %>
        <span class="utilities--sr-only"><%= icon.humanize %></span>
      </label>
    <% end %>

    <label
      class="form--picker-option form--icon-picker-more-button"
      for="<%= form.field_id(:icon, :more) %>"
      aria-label="More icons"
    >
      <%= icon_tag("dots", class: "form--picker-control form--icon") %>
    </label>

    <% more_icons.each do |icon| %>
      <label class="form--picker-option form--icon-picker-more-option">
        <%= form.radio_button :icon, icon %>
        <%= icon_tag(icon, class: "form--picker-control form--icon") %>
        <span class="utilities--sr-only"><%= icon.humanize %></span>
      </label>
    <% end %>
  </div>
</div>

<%# locals: (bullet:) %>
<%= render layout: "bullets/bullet", locals: { bullet: } do %>
  <% if bullet.long? %>
    <div class="bullet--document">
      <h2 class="bullet--name"><%= bullet.name %></h2>
      <p><%= bullet.excerpt %></p>
      <div class="read-more button--secondary button--sm">
        <%= link_to "Read more", bullet_path(bullet), data: { turbo_frame: "_top", action: "click->chat-scroll#preserveScrollPosition" } %>
      </div>
    </div>
  <% else %>
    <div class="bullet--note"><%= bullet.excerpt %></div>
  <% end %>
<% end %>

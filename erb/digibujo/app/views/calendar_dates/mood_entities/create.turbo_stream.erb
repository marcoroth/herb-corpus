
<%= turbo_stream.replace "mood_entity_#{@date.iso8601}" do %>
  <%= render "calendar_dates/mood_entities/mood_entity", date: @date, entity: @mood_entity %>
<% end %>

<%= turbo_stream.replace "mood_entity_name_#{@date.iso8601}" do %>
  <p class="typography--paragraph-sm"><%= @mood_entity ? @mood_entity.mood.humanize : "Pick mood" %></p>
<% end %>
<%# locals: (page:, pagination_link_path:, container_id: "paginated-records", turbo_frame: nil) %>
<div id="<%= container_id %>"
     class="layout--list"
     data-controller="pagination"
     <% if turbo_frame.present? %>data-pagination-turbo-frame-value="<%= turbo_frame %>"<% end %>>
  <%= yield %>
  <% unless page.last? %>
    <% next_href = pagination_link_path.call(page.next_param) %>
    <%= link_to next_href,
          class: "pagination-trigger",
          data: { pagination_target: "nextPageLink", preload: page.first? } do %>
      <i class="icon icon--spin" style="--icon-mask: var(--icon-spinner)" aria-hidden="true"></i>
    <% end %>
  <% end %>
</div>

<div class="dropdown--element-body">
  <nav class="dropdown--menu" aria-label="Create">
    <%= link_to new_collection_path,
          class: "dropdown-item",
          data: {
            turbo_frame: "_top",
            grid_navigation_target: "item",
            action: "focus->grid-navigation#syncPosition"
          } do %>
      <%= icon_tag("plus") %>
      Add collection
    <% end %>

    <%= link_to new_future_path,
          class: "dropdown-item",
          data: {
            turbo_frame: "_top",
            grid_navigation_target: "item",
            action: "focus->grid-navigation#syncPosition"
          } do %>
      <%= icon_tag("calendar") %>
      Add future log
    <% end %>

    <%= link_to current_monthlylog_path,
          class: "dropdown-item",
          data: {
            turbo_frame: "_top",
            grid_navigation_target: "item",
            action: "focus->grid-navigation#syncPosition"
          } do %>
      <%= icon_tag("calendar") %>
      Monthly log
    <% end %>

    <%= link_to new_project_path,
          class: "dropdown-item",
          data: {
            turbo_frame: "_top",
            grid_navigation_target: "item",
            action: "focus->grid-navigation#syncPosition"
          } do %>
      <%= icon_tag("tag") %>
      New project
    <% end %>
  </nav>
</div>


<main class="layout--page">
<p class="utilities--mx-auto typography--paragraph-sm">Press ⌘+K to open the menu</p>
<div class="layout--container layout--container-md layout--gapped layout--grid layout--grid-auto-fill" style="--grid-item-size: 10rem;">
  <aside class="home--side layout--grid-item">
    <%= render "home_actions" %>
    <%= render "appearance_picker", appearance: @appearance %>
  </aside>

  <div class="layout--surface layout--grid-item span-2 home--section-list layout--padded">
    <div class="layout--flex layout--justify-between layout--surface layout--surface-sunken layout--padded">
      <div>
    <h2 class="typography--h2">Hi there, <%= current_user.email_address.split("@").first %> 😉 </h2>
    <p class="typography--paragraph-sm">Welcome to your home page</p>
    </div>

    </div>
    <% @sections.each do |section| %>
      <%= render "home_section", section: section %>
    <% end %>
  </div>

  <aside class="layout--grid-item home--side home--activity">
    <turbo-frame
      id="home_activities"
      src="<%= home_activities_path %>"
      loading="lazy"
    >
    <%= icon_tag("spinner", class: "animations--spin", style: "margin-top: var(--spacing-vertical-triple); layout--mx-auto;") %>
  </turbo-frame>
</aside>
</div>
</main>
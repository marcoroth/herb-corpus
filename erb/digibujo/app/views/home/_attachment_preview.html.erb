<%# locals: (attachment:) %>
<% blob = attachment.blob %>

<%= link_to attachment_path(blob.signed_id),
      class: "home--attachment-preview",
      title: blob.filename.to_s,
      data: { turbo_frame: "_top" } do %>
  <span class="home--attachment-preview-visual">
    <% if blob.image? %>
      <%= represent_image_tag blob,
            variant: :thumb,
            alt: "",
            class: "home--attachment-preview-image" %>
    <% else %>
      <%= icon_tag("paperclip") %>
      <span class="home--attachment-preview-name utilities--line-clamp-1"><%= blob.filename %></span>
    <% end %>
  </span>
<% end %>

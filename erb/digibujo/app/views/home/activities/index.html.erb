<turbo-frame id="home_activities">
  <div class="layout--list">
    <% if @activities.any? %>
      <% @activities.each do |activity| %>
        <%= render "home/activities/activity", activity: activity %>
      <% end %>
    <% else %>
      <p class="utilities--text-sm" style="color: var(--color-fg-subtle);">No recent activity</p>
    <% end %>
  </div>
  <%= link_to activities_path, class: "typography--paragraph-sm", data: { turbo_frame: "_top" }, aria: { label: "Earlier activity" } do %>
  Show more...
<% end %>
</turbo-frame>

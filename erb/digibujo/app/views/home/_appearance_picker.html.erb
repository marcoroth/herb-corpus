<div class="button--secondary home--action home--appearance">
  <div
    class="home--appearance colour-picker"
    role="radiogroup"
    aria-label="Background appearance"
    data-controller="appearance"
    data-appearance-url-value="<%= home_appearance_path %>"
    data-action="change->appearance#changeAppearance"
  >
    <% User::Settings::APPEARANCES.each do |name| %>
      <label class="colour-picker-option">
        <%= radio_button_tag :appearance, name, appearance == name, class: "utilities--sr-only" %>
        <span
          class="
            <%= class_names(
            'colour-swatch',
            "home--appearance-swatch--#{name}"
            ) %>
          "
          aria-hidden="true"
        ></span>
        <span class="utilities--sr-only"><%= name.capitalize %></span>
      </label>
    <% end %>
  </div>
</div>

<% if mobile_variant? %>
<div class="layout--flex layout--surface" data-align="center" data-justify="center" data-padding="true">
<%= render "home/account_button" %>
<%= link_to "Digibujo", home_path, class: "home--wordmark", data: { turbo_frame: "_top" } %>
</div>
  <header class="home--header">

    <div class="home--header-controls">


      <%= link_to search_path,
            class: "home--search-link",
            data: { turbo_frame: "_top" } do %>
        <%= icon_tag("search") %>
        <span>Search</span>
      <% end %>
    </div>
  </header>
<% end %>

<%
    date_composer_id = "date_#{@date.iso8601}_bullets_composer"
    unplanned_composer_id = "monthlylog_bullets_unplanned_composer"
  %>
<div class="chat--window">
    <div class="layout--flex layout--justify-center layout--gapped">
    <%= render "monthlylogs/calendar",
        monthlylog: @monthlylog,
        days: @days,
        date: @date,
        bullet_counts_by_date: @bullet_counts_by_date,
        pictures_by_date: @pictures_by_date %>

    </div>
      <turbo-frame
      id="monthlylog_bullets"
      src="<%= monthlylog_bullets_path(@monthlylog, date: @date.iso8601) %>"
      class="utilities--contents animations--popout"
      data-turbo-temporary="true"
      data-pops-on="<%= @date.iso8601 %>">
    </turbo-frame>
</div>

<% content_for(:title) { @monthlylog.name } %>

<% date_composer_id = "date_#{@date.iso8601}_bullets_composer"
    unplanned_composer_id = "monthlylog_bullets_unplanned_composer" %>

<div class="layout--page">
  <main
    class="
      layout--container layout--container-xl layout--surface
      layout--snap-grid-container
    "
    style="--grid-cols-number: 2; height: 90vh;"
  >
    <section
      class="layout--padded layout--grid-item layout--flex"
      data-column="true"
      style="--grid-column: span 1;"
      aria-label="Planned by date"
    >
    <div class="layout--grid layout--gapped">
      <h3>Planned by date</h3>

      <p>
        View your planned bullets by date.
      </p>
    </div>
    <br>
      <%= render "monthlylogs/calendar",
                monthlylog: @monthlylog,
                days: @days,
                date: @date,
                bullet_counts_by_date: @bullet_counts_by_date,
                pictures_by_date: @pictures_by_date %>

      <div class="layout--flex layout--flex-auto" data-column="true">
        <turbo-frame
          id="monthlylog_bullets"
          src="<%= monthlylog_bullets_path(@monthlylog, date: @date&.iso8601) %>"
          class="utilities--contents"
          data-pops-on="<%= @date&.iso8601 %>"
        ></turbo-frame>
      </div>
    </section>

    <section
      class="layout--padded layout--grid-item layout--flex"
      data-column="true"
      style="--grid-column: span 1;"
      aria-label="Unplanned"
    >
      <div class="layout--grid layout--gapped">
        <h3>Unplanned</h3>

        <p>
          Brain dump for the month — park ideas here until you assign them to a
          day.
        </p>
      </div>

      <div class="layout--flex layout--flex-auto" data-column="true">
        <turbo-frame
          id="monthlylog_bullets"
          src="<%= monthlylog_bullets_path(@monthlylog) %>"
          class="utilities--contents"
        ></turbo-frame>
      </div>
    </section>
  </main>
</div>

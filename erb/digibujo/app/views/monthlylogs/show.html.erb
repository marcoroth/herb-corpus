<% if @monthlylog %>
  <% content_for(:title) { @monthlylog.name } %>
  <%
    date_composer_id = "date_#{@date.iso8601}_bullets_composer"
    unplanned_composer_id = "monthlylog_bullets_unplanned_composer"
  %>

  <div
    class="layout--page<%= " monthlylog--page-mobile" if mobile_variant? %>"
    data-controller="monthlylog-composer"
    data-monthlylog-composer-bucket-id-value="<%= @monthlylog.bucket.id %>"
    data-monthlylog-composer-unplanned-composer-id-value="<%= unplanned_composer_id %>"
    data-monthlylog-composer-initial-date="<%= @date.iso8601 %>"
    data-action="turbo:frame-load->monthlylog-composer#dateFrameLoaded keydown.esc@document->monthlylog-composer#close:capture"
  >
    <main class="layout--container layout--container-md<%= " layout--surface" unless mobile_variant? %> monthlylog--chat">
      <div class="monthlylog--spread<%= " monthlylog--spread-sections" if mobile_variant? %>">
        <section class="monthlylog--section monthlylog--calendar" aria-label="Planned by date">
          <%= render "monthlylogs/calendar",
                monthlylog: @monthlylog,
                days: @days,
                date: @date,
                bullet_counts_by_date: @bullet_counts_by_date,
                pictures_by_date: @pictures_by_date %>

          <div
            class="chat--wrap monthlylog--pane"
            data-monthlylog-composer-target="datePane"
          >
            <turbo-frame
              id="monthlylog_date"
              src="<%= monthlylog_bullets_path(@monthlylog, date: @date.iso8601) %>"
              class="monthlylog--date-section"
              data-pops-on="<%= @date.iso8601 %>">
            </turbo-frame>
            <div
              class="monthlylog--composer-dock"
              data-monthlylog-composer-target="dateDock"
            >
              <button
                type="button"
                class="button--secondary monthlylog--create-bullet"
                data-action="monthlylog-composer#openDate"
              >
                Create bullet
              </button>
            </div>
          </div>
        </section>

        <% unless mobile_variant? %>
          <div class="monthlylog--divider" aria-hidden="true"></div>
        <% end %>

        <section class="monthlylog--section monthlylog--unplanned" aria-label="Unplanned">
          <header class="monthlylog--pill monthlylog--unplanned-header">
            <h3 class="monthlylog--unplanned-name">Unplanned</h3>
            <p class="monthlylog--unplanned-description">
              Brain dump for the month — park ideas here until you assign them to a day.
            </p>
          </header>

          <div
            class="chat--wrap monthlylog--pane"
            data-monthlylog-composer-target="unplannedPane"
          >
            <turbo-frame
              id="monthlylog_unplanned"
              src="<%= monthlylog_bullets_path(@monthlylog) %>"
              class="monthlylog--unplanned-entries">
            </turbo-frame>
            <div
              class="monthlylog--composer-dock"
              data-monthlylog-composer-target="unplannedDock"
            >
              <button
                type="button"
                class="button--secondary monthlylog--create-bullet"
                data-action="monthlylog-composer#openUnplanned"
              >
                Create bullet
              </button>
            </div>
          </div>
        </section>
      </div>

      <div class="monthlylog--composer-park" data-monthlylog-composer-target="park" hidden>
        <%= render "bullets/composer",
              bucket_id: @monthlylog.bucket.id,
              pops_on: @date,
              variants: %w[Task Event],
              composer_id: date_composer_id %>
      </div>
    </main>
  </div>
<% else %>
  <%= render "monthlylogs/placeholder" %>
<% end %>

<%# locals: (monthlylog:, days:, date:, bullet_counts_by_date:, pictures_by_date:) %>
<% if days.any? %>
  <div
    class="monthlylog--pill monthlylog--inline-calendar"
    data-controller="monthlylog-inline-calendar"
    role="list"
    aria-label="Days of the month"
  >
    <% days.each do |day| %>
      <% count = bullet_counts_by_date[day].to_i %>
      <%= link_to monthlylog_bullets_path(monthlylog, date: day.iso8601),
            data: { turbo_frame: "monthlylog_date", monthlylog_date: day.iso8601 },
            role: "listitem",
            class: [
              "monthlylog--date-cell-inline",
              ("is-selected" if day == date),
              ("is-current" if day == Date.current)
            ].compact.join(" ") do %>
        <span class="monthlylog--date-number"><%= day.day %></span>
        <span class="monthlylog--date-weekday"><%= day.strftime("%a") %></span>
        <span
          class="monthlylog--indicator"
          <%= "hidden" unless count > 0 %>
          aria-hidden="true"></span>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p class="monthlylog--by-date-placeholder">No period set for this spread.</p>
<% end %>

<%# locals: (monthlylog:, days:, date:, bullet_counts_by_date:, pictures_by_date:) %>
<% if days.any? %>

  <div
    class="chat--header header--controls layout--padded monthlylog--inline-calendar"
    data-controller="calendar"
    role="list"
    aria-label="Days of the month"
  >
    <% days.each do |day| %>
      <% count = bullet_counts_by_date[day].to_i %>
      <%= link_to monthlylog_bullets_path(monthlylog, date: day.iso8601),
            data: { turbo_frame: "monthlylog_bullets", calendar_date_value: day.iso8601, calendar_date_param: day.to_s, calendar_target: "cell", action: "click->calendar#navigateToDate" },
            role: "listitem",
            aria: { selected: (day == date) },
            class: "button--secondary button--sm" do %>
        <span class="monthlylog--date-number"><%= day.day %></span>
        <span class="monthlylog--date-weekday"><%= day.strftime("%a") %></span>
        <%= tag.span class: "monthlylog--indicator", aria: { hidden: "true" } do %><% end %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p class="monthlylog--by-date-placeholder">No period set for this spread.</p>
<% end %>

<% date_composer_id = dom_id(@monthlylog.bucket, "composer_#{@date&.iso8601}")
   variants = @date.present? ? %w[Task Event] : %w[Task Note]
   bullets_container_id = dom_id(@monthlylog.bucket, @date) %>

<div class="chat--window layout--container" data-size="md">
  <turbo-frame
    id="monthlylog_bullets"
    class="chat--surface layout--surface"
    data-elevation="1"
    data-pops-on="<%= @date&.iso8601 %>"
  >
    <header class="chat--header">
      <div class="layout--flex" data-justify="between" data-align="center">
        <%= back_link_to monthlylog_path(@monthlylog),
              class: "button",
              data: { content: "text", turbo_frame: "_top" },
              aria: { label: "Monthly log" } do %>
          <%= icon_tag("arrow-left") %>
          <span>Monthly log</span>
        <% end %>

        <% if @date %>
          <%= link_to daylog_path(date: @date.iso8601),
                class: "button typography--mono typography--paragraph-sm",
                data: { content: "text", turbo_frame: "_top" } do %>
            <time datetime="<%= @date.iso8601 %>"><%= @date.strftime("%a, %b %-d") %></time>
          <% end %>
        <% else %>
          <span class="typography--mono typography--paragraph-sm">Unplanned</span>
        <% end %>
      </div>
    </header>

    <div
      id="<%= bullets_container_id %>"
      class="chat--scroller"
      data-controller="chat-scroll pops-drop drop-postpone-optimistic"
      data-chat-scroll-path-value="<%= monthlylog_bullets_path(@monthlylog, date: @date&.iso8601) %>"
      data-bulk-menu-target="list"
      data-monthlylog-date-list
      data-pops-drop-pops-url-value="<%= postpone_path %>"
      data-pops-drop-bucket-id-value="<%= @monthlylog.bucket.id %>"
      data-pops-drop-pops-on-value="<%= @date&.iso8601 %>"
      data-pops-drop-requested-with-value="pops-drop"
      data-pops-drop-optimistic-value="drop-postpone-optimistic"
      data-drop-zone-value="<%= @date&.iso8601 %>"
      data-action="dragover->pops-drop#dragover dragleave->pops-drop#dragleave drop->pops-drop#drop"
    >
      <% if @more_bullets %>
        <div class="chat--load-more-trigger" data-chat-scroll-target="trigger">
          <%= icon_tag("spinner", class: "icon icon--spin") %>
          <span class="utilities--sr-only">Loading more bullets</span>
        </div>
      <% end %>

      <% @bullets.each do |bullet| %>
        <%= render "monthlylogs/bullets/bullet", bullet: bullet %>
      <% end %>
    </div>

    <div class="chat--composer composer--dock" data-controller="chat-composer">
      <%= render "bullets/composer_v2",
            bullet: Bullet.new,
            bucket_id: @monthlylog.bucket.id,
            pops_on: @date&.iso8601,
            allowed_bulletable_variants: variants,
            preset: "default",
            autofocus: false,
            composer_id: date_composer_id %>
    </div>
  </turbo-frame>
</div>

<%
  date_composer_id = "date_#{@date&.iso8601}_bullets_composer"
  unplanned_composer_id = "monthlylog_bullets_unplanned_composer"
%>
  <turbo-frame
    id="monthlylog_bullets"
    class="utilities--contents"
    data-pops-on="<%= @date&.iso8601 %>"
  >


    <div
      class="chat--wrap"
      data-controller="chat-scroll"
      data-chat-scroll-path-value="<%= monthlylog_bullets_path(@monthlylog, date: @date&.iso8601) %>"
    >
      <div
        id="<%= "date_#{@date&.iso8601}_bullets_container" %>"
        class="chat--scroller"
        data-chat-scroll-target="scroller"
        data-bulk-menu-target="list"
        data-monthlylog-date-list
      >
        <% if @more_bullets %>
          <div
            class="chat--load-more-trigger"
            data-chat-scroll-target="trigger"
          >
            <%= icon_tag("spinner", class: "icon icon--spin") %>
            <span class="utilities--sr-only">Loading more bullets</span>
          </div>
        <% end %>
        <% @bullets.each do |bullet| %>
          <%= render "monthlylogs/bullets/bullet", bullet: bullet %>
        <% end %>
        <%= render "bullets/composer",
          bucket_id: @monthlylog.bucket.id,
          pops_on: @date&.iso8601,
          variants: %w[Task Event],
          composer_id: date_composer_id %>
      </div>
    </div>
  </turbo-frame>

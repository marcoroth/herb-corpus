<%# locals: (monthlylog:, days:, date:, bullet_counts_by_date:, pictures_by_date:) %>

  <% padded = Array.new(days.first.wday, nil) + days %>

  <div class="monthlylog--calendar layout--surface-sunken" data-controller="calendar">
    <% Date::DAYNAMES.each do |weekday| %>
      <div class="monthlylog--calendar-weekday-name">
        <%= weekday.first(3) %>
      </div>
    <% end %>
    <% padded.each do |day| %>
      <% if day.blank? %>
        <div aria-hidden="true"></div>
      <% else %>
        <% count = bullet_counts_by_date[day].to_i %>
        <% picture = pictures_by_date[day] %>
        <div
          class="monthlylog--calendar-date-cell"
          aria-selected="<%= day == date %>"
          data-controller="pops-drop monthlylog-calendar-drop-optimistic"
          data-calendar-target="cell"
          data-calendar-date-value="<%= day.to_s %>"
          data-pops-drop-pops-url-value="<%= postpone_path %>"
          data-pops-drop-bucket-id-value="<%= monthlylog.bucket.id %>"
          data-pops-drop-pops-on-value="<%= day.iso8601 %>"
          data-pops-drop-requested-with-value="pops-drop"
          data-pops-drop-optimistic-value="monthlylog-calendar-drop-optimistic"
          data-drop-zone-value="<%= day.iso8601 %>"
          data-monthlylog-calendar-drop-optimistic-count-value="<%= count %>"
          data-action="dragover->pops-drop#dragover dragleave->pops-drop#dragleave drop->pops-drop#drop"
        >
          <%= link_to monthlylog_bullets_path(monthlylog, date: day.iso8601),
                data: { turbo_frame: "monthlylog_bullets", calendar_date_param: day.to_s, action: "click->calendar#navigateToDate" },
                class: "monthlylog--calendar-date-link" do %>
            <span class="monthlylog--date-number"><%= day.day %></span>
            <%= tag.span class: "monthlylog--indicator", data: { monthlylog_calendar_drop_optimistic_target: "indicator" }, aria: { hidden: "true" } do %><% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

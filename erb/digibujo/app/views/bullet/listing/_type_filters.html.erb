<nav class="layout--filter-group" aria-label="Filter bullets">
  <div class="layout--filter-surface">
    <% listing.filters.each do |type_key, label, icon, bullet_type| %>
      <% hint_id = "filter_#{type_key || "all"}" %>
      <% anchor = "--filter-#{type_key || "all"}" %>
      <%= link_to listing.path(type: type_key),
            class: "layout--filter-option",
            interestfor: hint_id,
            style: "anchor-name: #{anchor}",
            data: { bullet_type: bullet_type }.compact,
            aria: { label: label, current: (type_key.blank? ? listing.type_param.blank? : listing.type_param == type_key) ? "page" : false } do %>
        <%= icon_tag(icon.to_s.dasherize) %>
      <% end %>
    <% end %>
  </div>
  <% listing.filters.each do |type_key, label, _icon, _bullet_type| %>
    <% hint_id = "filter_#{type_key || "all"}" %>
    <% anchor = "--filter-#{type_key || "all"}" %>
    <div
      id="<%= hint_id %>"
      class="hint"
      popover="hint"
      style="position-anchor: <%= anchor %>"
    >
      <%= label %>
    </div>
  <% end %>
</nav>

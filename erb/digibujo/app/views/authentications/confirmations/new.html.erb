<% content_for(:title) { "Enter code" } %>

<div class="session--page session--page-auth">
  <div class="session--welcome">
    <h1 class="session--name">Check your email</h1>
    <p class="typography--paragraph-md typography--center typography--balanced">
      We sent a 6-character code to <strong><%= @email %></strong>.
    </p>
  </div>

  <%= form_with url: authentication_confirmation_path, class: "form session--form" do |form| %>
    <%= form.text_field :code,
          class: "session--code-input",
          required: true,
          autofocus: true,
          autocomplete: "one-time-code",
          inputmode: "text",
          maxlength: 6,
          placeholder: "······",
          aria: { label: "6-character login code" } %>

    <%= form.button type: "submit", class: "button--primary session--submit" do %>
      Verify code
    <% end %>
  <% end %>

  <div class="session--footer-links layout--flex layout--mx-auto">
    <%= link_to "Didn't receive it? Try again", new_authentication_path, class: "session--footer-link" %>
  </div>
</div>

<% if @failed_message.present? %>
  <%= turbo_stream.update "toasts" do %>
    <%= render "shared/toasts", type: "errmsg", messages: [@failed_message] %>
  <% end %>
<% else %>
  <%= turbo_stream.remove dom_id(@bullet, :triage) %>
  <%= turbo_stream.update "toasts" do %>
    <%= render "shared/toasts", type: "notify", messages: ["Discarded"] %>
  <% end %>
<% end %>

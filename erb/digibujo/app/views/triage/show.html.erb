<% content_for(:title) { "Triage" } %>

<div class="layout--page layout--container layout--container-md">

  <div class="layout--flex layout--gapped layout--justify-between layout--padded">
    <%= back_link_to daylog_path, class: "button--secondary button--sm" do %>
      <%= icon_tag("arrow-left") %>

    <% end %>
    <div class="button--secondary button--sm">
    <%= icon_tag("mail") %>
    <span>Triage</span>
    </div>
  </div>
    <div class="layout--flex layout--gapped layout--padded layout--mx-auto">
      Bullets waiting to be added to your daylog
    </div>


  <div class="layout--surface">


    <div class="layout--list layout--padded">
      <div data-bulk-menu-target="list">
        <%= render layout: "pagination/paginated_list",
              locals: {
                page: @page,
                container_id: dom_id(@pending, :bullets_container),
                pagination_link_path: ->(next_param) { triage_path(page: next_param) }
              } do %>
          <% if @page.records.empty? && @page.first? %>
            <p id="no_bullets_container" class="typography--paragraph-sm typography--center layout--padded layout--mx-auto">
              Nothing pending right now.
            </p>
          <% end %>
          <% @page.records.each do |bullet| %>
            <%= render "triage/bullet", bullet: bullet %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>


<div id="<%= dom_id(bullet, :triage) %>" class="triage--bullet">
  <% if bullet.author_name.present? %>
    <p class="typography--paragraph-sm triage--author"><%= bullet.author_name %></p>
  <% end %>
  <%= render partial: bullet.to_partial_path, locals: { bullet: bullet } %>
  <div class="layout--flex">
    <%= button_to triage_bullet_accept_path(bullet),
          method: :post,
          class: "button--secondary button--sm",
          form: { class: "triage--action-form" },
          aria: { label: "Add to today" } do %>
      <%= icon_tag("arrow-right") %>
      Today
    <% end %>
    <%= button_to triage_bullet_discard_path(bullet),
          method: :post,
          class: "button--secondary button--sm",
          form: { class: "triage--action-form" },
          aria: { label: "Discard" } do %>
      <%= icon_tag("archive") %>
      Discard
    <% end %>
  </div>
</div>

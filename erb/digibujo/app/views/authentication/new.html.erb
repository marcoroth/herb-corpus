<% content_for(:title) { "Digibujo — Welcome" } %>

<div class="session--page session--page-auth">
  <div
    class="session--welcome"
    data-controller="session-hello"
  >
    <h1 class="session--name session--hello">
      <span data-session-hello-target="word" aria-live="polite">Hello</span>
    </h1>
  </div>

  <p class="typography--paragraph-md typography--center typography--balanced session--lede">
    Enter your email and we'll send you a one-time code to sign in or create an account.
  </p>

  <%= form_with url: authentication_path,
        class: "form session--form",
        data: { controller: "session-submit" } do |form| %>
    <% if @user&.errors&.any? %>
      <div class="form--errors" role="alert">
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form.email_field :email_address,
          class: "session--email-input",
          required: true,
          autofocus: true,
          autocomplete: "username",
          placeholder: "you@example.com",
          aria: { label: "Email" },
          value: params[:email_address] %>

    <%= form.button type: "submit",
          class: "button--primary session--submit",
          data: { session_submit_target: "button" } do %>
      <span class="session--submit-label">Continue</span>
      <span class="session--submit-spinner" aria-hidden="true"></span>
    <% end %>
  <% end %>

  <nav class="session--footer-links" aria-label="About">
    <%= link_to features_path, class: "session--footer-link" do %>
      <%= icon_tag("list", class: "session--footer-icon") %>
      Features
    <% end %>
    <%= link_to support_path, class: "session--footer-link" do %>
      <%= icon_tag("mail", class: "session--footer-icon") %>
      Support
    <% end %>
  </nav>
</div>

<%= tag.figure class: "attachment attachment--#{blob.representable? ? "preview" : "file"} attachment--#{blob.filename.extension}" do %>
  <% if blob.representable? %>
    <%= image_tag blob,
          alt: blob.filename,
          class: "attachment--preview" %>
  <% end %>

  <%= tag.figcaption class: "attachment__caption" do %>
    <% if caption = blob.try(:caption) %>
      <%= caption %>
    <% else %>
      <%= tag.span class: "attachment__name" do %>
        <%= blob.filename %>
      <% end %>
      <%= tag.span class: "attachment__size" do %>
        <%= number_to_human_size blob.byte_size %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if request.headers["Turbo-Frame"] == "pinned_list" %>
  <turbo-frame
    id="pinned_list"
    class="dropdown dropdown--element dropdown--element-up animations--side-in pinned--dropdown"
    popover
    style="position-anchor: --pinned-dropdown;"
    data-controller="grid-navigation"
    data-grid-navigation-columns-value="1"
    data-action="keydown->grid-navigation#navigate"
  >
    <div class="dropdown--element-body">
      <% if @pinned_entities.any? %>
        <ul class="pinned--list">
          <% @pinned_entities.each do |pinned_entity| %>
            <%= render "pinned/pinned_entity", pinned_entity: pinned_entity %>
          <% end %>
        </ul>
      <% else %>
        <p class="pinned--no-entities">Nothing pinned yet.</p>
      <% end %>
    </div>
  </turbo-frame>
<% else %>
  <% content_for(:title, "Pins") %>

  <main class="layout--container" data-size="md" data-padding="true">
    <div class="layout--surface layout--flex" data-elevation="1" data-padding="true" data-direction="column">
      <header class="layout--flex" data-align="center">
        <%= back_link_to home_path,
              class: "button",
              data: { intent: "secondary", radius: "full", content: "icon", size: "sm", turbo_frame: "_top" },
              aria: { label: "Back to Home" } do %>
          <%= icon_tag("arrow-left") %>
        <% end %>
        <h1>Pins</h1>
      </header>

      <% if @pinned_entities.any? %>
        <ul class="pinned--list">
          <% @pinned_entities.each do |pinned_entity| %>
            <%= render "pinned/pinned_entity", pinned_entity: pinned_entity %>
          <% end %>
        </ul>
      <% else %>
        <p class="pinned--no-entities">Nothing pinned yet.</p>
      <% end %>
    </div>
  </main>
<% end %>

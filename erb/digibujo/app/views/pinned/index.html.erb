<% if request.headers["Turbo-Frame"] == "pinned_list" %>
  <turbo-frame
    id="pinned_list"
    class="dropdown dropdown--element dropdown--element-up animations--side-in pinned--dropdown"
    popover
    style="position-anchor: --pinned-dropdown;"
    data-controller="grid-navigation"
    data-grid-navigation-columns-value="1"
    data-action="keydown->grid-navigation#navigate"
  >
    <div class="dropdown--element-body">
      <% if @pinned_entities.any? %>
        <ul class="layout--list bucket--list">
          <% @pinned_entities.each do |pinned_entity| %>
            <%= render "pinned/pinned_entity", pinned_entity: pinned_entity %>
          <% end %>
        </ul>
      <% else %>
        <p class="pinned--no-entities">Nothing pinned yet.</p>
      <% end %>
    </div>
  </turbo-frame>
<% else %>
  <% content_for(:title) { "Pinned" } %>

  <div class="layout--page layout--container layout--container-md layout--padded">
    <div class="layout--flex layout--justify-between layout--padded">
    <div class="header--controls">
      <%= back_link_to home_path, class: "button--tertiary button--sm" do %>
      <%= icon_tag("arrow-left") %>
      Back
      <% end %>
    </div>
    <div class="button--secondary button--sm">
        <%= icon_tag("pin") %>
        Pinned
    </div>
    </div>

    <div class="layout--surface">
      <% if @pinned_entities.any? %>
        <ul class="layout--list layout--padded pinned--list">
          <% @pinned_entities.each do |pinned_entity| %>
            <%= render "pinned/pinned_entity", pinned_entity: pinned_entity %>
          <% end %>
        </ul>
      <% else %>
        <p class="pinned--no-entities">Nothing pinned yet.</p>
      <% end %>
    </div>
  </div>
<% end %>

<div class="dropdown--dock" style="anchor-name: --pinned-dropdown;">
  <button
    type="button"
    class="button--secondary button--circle hotkey-hint pinned--button-control"
    style="position-anchor: --pinned-button;"
    popovertarget="pinned_list"
    data-controller="hotkey"
    data-hotkey="P"
    data-action="keydown.shift+p@document->hotkey#click"
    aria-label="Pinned"
    aria-keyshortcuts="Shift+P"
  >
    <i class="icon" style="--icon-mask: var(--icon-pin)" aria-hidden="true"></i>
  </button>
  <turbo-frame
    id="pinned_list"
    class="dropdown dropdown--element dropdown--element-up animations--side-in pinned--dropdown"
    src="<%= pinned_index_path %>"
    loading="lazy"
    popover
    style="position-anchor: --pinned-dropdown;"
    data-controller="grid-navigation"
    data-grid-navigation-columns-value="1"
    data-action="keydown->grid-navigation#navigate"
  ></turbo-frame>
</div>

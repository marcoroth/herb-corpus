<% content_for(:title, "Bullets") %>

<main class="activity--page layout--container" data-size="md">
  <section class="activity--surface layout--surface" data-elevation="1">
    <header class="activity--header layout--flex" data-align="center">
      <%= back_link_to home_path,
            class: "button",
            data: { intent: "secondary", radius: "full", size: "sm", content: "icon" },
            aria: { label: "Back to Home" } do %>
        <%= icon_tag("arrow-left") %>
      <% end %>
      <h1>Bullets</h1>
    </header>

    <% if @page.records.any? %>
      <%= render layout: "pagination/paginated_list",
            locals: {
              page: @page,
              container_id: "bullets-timeline",
              pagination_link_path: ->(next_param) { bullets_path(page: next_param) }
            } do %>
        <div class="activity--feed-list" data-bulk-menu-target="list">
          <% previous_date = nil %>
          <% @page.records.each do |bullet| %>
            <% date = bullet.created_at.in_time_zone.to_date %>
            <% if previous_date != date %>
              <div class="activity--date-divider layout--flex"
                   data-justify="center"
                   role="separator"
                   aria-label="<%= date.strftime('%b %-d, %Y') %>">
                <%= link_to daylog_path(date: date.iso8601),
                      class: "button activity--date-pill",
                      data: { content: "text", turbo_frame: "_top" } do %>
                  <time datetime="<%= date.iso8601 %>"><%= date.strftime("%b %-d, %Y") %></time>
                <% end %>
              </div>
              <% previous_date = date %>
            <% end %>

            <%= render partial: bullet.to_partial_path, locals: { bullet: bullet } %>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <p class="activity--empty typography--paragraph-sm">No bullets yet.</p>
    <% end %>
  </section>
</main>

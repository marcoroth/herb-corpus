<!-- Recorder is a part of composer. One of possible states and bulletable variants. So it is tightly bound to the general purpose text form and not supposed to be used as a standalone component. -->

<div data-composer-recorder-target="recorder"
     class="voice-recorder">

    <%= file_field_tag "bullet[bulletable_attributes][recording]",
        accept: "audio/webm,audio/mp4",
        hidden: true,
        data: { composer_recorder_target: "file" } %>
    <%= hidden_field_tag "bullet[bulletable_attributes][duration_seconds]", nil,
        id: "#{composer_id}_duration_seconds",
        data: { composer_recorder_target: "duration" } %>

<button type="button" class="button voice-recorder--button" data-intent="secondary" data-size="xs" data-radius="full" data-content="icon" data-composer-recorder-target="playButton" data-action="composer-recorder#togglePlay" aria-label="Play recording" aria-pressed="false" hidden>
    <%= icon_tag("play", class: "paused") %>
    <%= icon_tag("pause", class: "playing", hidden: true) %>
</button>
<button type="button" class="button voice-recorder--button" data-intent="secondary" data-status="negative" data-size="xs" data-radius="full" data-content="icon" data-composer-recorder-target="recordButton" data-action="composer-recorder#record" aria-label="Start recording">
        <%= icon_tag("circle") %>
</button>
<button type="button" class="button voice-recorder--button" data-intent="secondary" data-size="xs" data-radius="full" data-content="icon" data-composer-recorder-target="stopButton" data-action="composer-recorder#stop" aria-label="Stop recording" hidden>
    <%= icon_tag("stop") %>
</button>
<button type="button" class="button voice-recorder--button" data-intent="secondary" data-status="negative" data-size="xs" data-radius="full" data-content="icon" data-composer-recorder-target="discardButton" data-action="composer-recorder#discard" aria-label="Discard recording" hidden>
    <%= icon_tag("trash") %>
</button>
    <div data-composer-recorder-target="waveform"
         data-action="click->composer-recorder#seek keydown->composer-recorder#seekByKeyboard"
         class="voice-recorder--waveform"
         role="slider"
         aria-label="Recording playback position"
         aria-valuemin="0"
         aria-valuemax="0"
         aria-valuenow="0"
         aria-disabled="true"
         tabindex="-1">
        <svg viewBox="0 0 160 32" preserveAspectRatio="none">
            <% 80.times do |index| %>
            <rect class="voice--waveform-item" x="<%= index * 2 %>" y="15" width="1.25" height="2" rx="0.5" />
            <% end %>
        </svg>
    </div>
    <span
    class="typography--paragraph-sm"
    data-composer-recorder-target="remaining"
    aria-live="polite">0:00</span>
    <audio
        data-composer-recorder-target="preview"
        data-action="play->composer-recorder#syncPlaybackStatus pause->composer-recorder#syncPlaybackStatus ended->composer-recorder#finishPlayback timeupdate->composer-recorder#updatePlaybackProgress loadedmetadata->composer-recorder#updatePlaybackProgress"
        preload="metadata"
        hidden></audio>
    <p class="utilities--sr-only" data-composer-recorder-target="status" aria-live="polite" hidden></p>
    <p class="voice-recorder--unsupported typography--paragraph-sm" data-composer-recorder-target="unsupported" hidden>
        Voice recording is not supported in this browser.
    </p>
</div>

<%# locals: (bullet_ids: "", postpone_options: [], manual_bucket:) %>
<div class="dropdown--element-body">
  <div class="dropdown--header">
    <h2>Schedule</h2>
    <button
      type="button"
      class="button dropdown--element-hide"
      data-intent="secondary"
      data-radius="full"
      data-size="xs"
      data-content="icon"
      popovertarget="postpone_picker_dropdown_id"
      popovertargetaction="hide"
      aria-label="Close schedule"
    >
      <%= icon_tag("x") %>
    </button>
  </div>

  <nav class="dropdown--menu" aria-label="Schedule">
    <% postpone_options.each do |option| %>
      <%= form_with url: postpone_path, method: :post, class: "dropdown--menu-form", data: { turbo_stream: true } do %>
        <%= hidden_field_tag :bullet_ids, bullet_ids, data: { bulk_menu_target: "idList" } %>
        <%= hidden_field_tag :bucket_id, option[:bucket_id] %>
        <%= hidden_field_tag :pops_on, option[:pops_on] %>

        <%= button_tag type: :submit,
              class: "dropdown-item picker--item",
              data: {
                grid_navigation_target: "item",
                action: "focus->grid-navigation#syncPosition"
              } do %>
          <%= icon_tag(option[:icon]) %>
          <%= option[:name] %><% if option[:pops_on] %> · <%= option[:pops_on].strftime("%a, %b %-d") %><% end %>
        <% end %>
      <% end %>
    <% end %>

    <div class="bulk-menu--picker-date">
      <label
        for="pops_on_date_picker"
        class="dropdown-item picker--item"
        tabindex="-1"
        data-grid-navigation-target="item"
        data-action="focus->grid-navigation#syncPosition"
      >
        <%= icon_tag("calendar") %>
        <span>Pick a date</span>

        <input
          type="checkbox"
          id="pops_on_date_picker"
          name="pops_on_date_picker"
          class="utilities--sr-only"
        >
      </label>

      <%= form_with url: postpone_path, method: :post, class: "form bulk-menu--picker-date-form", data: { turbo_stream: true } do %>
        <%= hidden_field_tag :bullet_ids, bullet_ids, data: { bulk_menu_target: "idList" } %>
        <%= hidden_field_tag :bucket_id, manual_bucket.id %>
        <%= date_field_tag :pops_on, Date.current %>

        <%= button_tag type: :submit, class: "button", data: { intent: "primary", radius: "full", size: "xs" } do %>
          Confirm
        <% end %>
      <% end %>
    </div>
  </nav>
</div>

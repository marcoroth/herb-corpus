<div class="bulk-menu animations--fall-in"
     data-bulk-menu-target="menu"
     data-action="keydown.esc@document->bulk-menu#escape"
     tabindex="0"
     hidden>
  <div class="bulk-menu--actions">

    <% if Current.user&.daylog %>
      <div data-bulk-menu-target="conditionalAction" data-require-scheduled="not-today" hidden>
        <%= form_with url: postpone_path, method: :post, data: { turbo_stream: true } do %>
          <%= hidden_field_tag :bullet_ids, "", data: { bulk_menu_target: "idList" } %>
          <%= hidden_field_tag :bucket_id, Current.user.daylog.bucket.id %>
          <%= hidden_field_tag :pops_on, Date.current.iso8601 %>
          <%= button_tag type: :submit,
                class: "button hotkey-hint hotkey-hint--always",
                data: {
                  intent: "secondary",
                  radius: "base",
                  size: "sm",
                  controller: "hotkey",
                  hotkey: "T",
                  action: "keydown.t@document->hotkey#click"
                },
                aria: { keyshortcuts: "T" } do %>
            <%= icon_tag("arrow-right") %>
            Today
          <% end %>
        <% end %>
      </div>
    <% end %>

    <div data-bulk-menu-target="conditionalAction" data-require-completable="incomplete" hidden>
      <%= form_with url: complete_path, method: :post, data: { turbo_stream: true } do %>
        <%= hidden_field_tag :bullet_ids, "", data: { bulk_menu_target: "idList" } %>
        <%= button_tag type: :submit,
              class: "button hotkey-hint hotkey-hint--always",
              data: {
                intent: "secondary",
                radius: "base",
                size: "sm",
                controller: "hotkey",
                hotkey: "C",
                action: "keydown.c@document->hotkey#click"
              },
              aria: { keyshortcuts: "C" } do %>
          <%= icon_tag("check") %>
          Complete
        <% end %>
      <% end %>
    </div>

    <div data-bulk-menu-target="conditionalAction" data-require-completable="completed" hidden>
      <%= form_with url: complete_path, method: :delete, data: { turbo_stream: true } do %>
        <%= hidden_field_tag :bullet_ids, "", data: { bulk_menu_target: "idList" } %>
        <%= button_tag type: :submit,
              class: "button hotkey-hint hotkey-hint--always",
              data: {
                intent: "secondary",
                radius: "base",
                size: "sm",
                controller: "hotkey",
                hotkey: "U",
                action: "keydown.u@document->hotkey#click"
              },
              aria: { keyshortcuts: "U" } do %>
          <%= icon_tag("square") %>
          Uncomplete
        <% end %>
      <% end %>
    </div>

    <div data-bulk-menu-target="conditionalAction" data-require-pinnable="unpinned" hidden>
      <%= form_with url: pin_path, method: :post, data: { turbo_stream: true } do %>
        <%= hidden_field_tag :bullet_ids, "", data: { bulk_menu_target: "idList" } %>
        <%= button_tag type: :submit,
              class: "button hotkey-hint hotkey-hint--always",
              data: {
                intent: "secondary",
                radius: "base",
                size: "sm",
                controller: "hotkey",
                hotkey: "P",
                action: "keydown.p@document->hotkey#click"
              },
              aria: { keyshortcuts: "P" } do %>
          <%= icon_tag("pin") %>
          Pin
        <% end %>
      <% end %>
    </div>

    <div data-bulk-menu-target="conditionalAction" data-require-pinnable="pinned" hidden>
      <%= form_with url: pin_path, method: :delete, data: { turbo_stream: true } do %>
        <%= hidden_field_tag :bullet_ids, "", data: { bulk_menu_target: "idList" } %>
        <%= button_tag type: :submit,
              class: "button hotkey-hint hotkey-hint--always",
              data: {
                intent: "secondary",
                radius: "base",
                size: "sm",
                controller: "hotkey",
                hotkey: "P",
                action: "keydown.p@document->hotkey#click"
              },
              aria: { keyshortcuts: "P" } do %>
          <%= icon_tag("pin") %>
          Unpin
        <% end %>
      <% end %>
    </div>

    <div data-bulk-menu-target="conditionalAction" data-require-publishable="unpublished" hidden>
      <%= form_with url: publish_path, method: :post, data: { turbo_stream: true } do %>
        <%= hidden_field_tag :bullet_ids, "", data: { bulk_menu_target: "idList" } %>
        <%= button_tag type: :submit,
              class: "button hotkey-hint hotkey-hint--always",
              data: {
                intent: "secondary",
                radius: "base",
                size: "sm",
                controller: "hotkey",
                hotkey: "Shift+P",
                action: "keydown.shift+p@document->hotkey#click"
              },
              aria: { keyshortcuts: "Shift+P" } do %>
          <%= icon_tag("link") %>
          Publish
        <% end %>
      <% end %>
    </div>

    <div data-bulk-menu-target="conditionalAction" data-require-publishable="published" hidden>
      <%= form_with url: publish_path, method: :delete, data: { turbo_stream: true } do %>
        <%= hidden_field_tag :bullet_ids, "", data: { bulk_menu_target: "idList" } %>
        <%= button_tag type: :submit,
              class: "button hotkey-hint hotkey-hint--always",
              data: {
                intent: "secondary",
                radius: "base",
                size: "sm",
                controller: "hotkey",
                hotkey: "Shift+P",
                action: "keydown.shift+p@document->hotkey#click"
              },
              aria: { keyshortcuts: "Shift+P" } do %>
          <%= icon_tag("link") %>
          Unpublish
        <% end %>
      <% end %>
    </div>

    <%= form_with url: archive_path, method: :post, data: { turbo_stream: true } do %>
      <%= hidden_field_tag :bullet_ids, "", data: { bulk_menu_target: "idList" } %>
      <%= button_tag type: :submit,
            class: "button hotkey-hint hotkey-hint--always",
            data: {
              intent: "secondary",
                radius: "base",
                size: "sm",
              controller: "hotkey",
              hotkey: "A",
              action: "keydown.a@document->hotkey#click"
            },
            aria: { keyshortcuts: "A" } do %>
        <%= icon_tag("archive") %>
        Archive
      <% end %>
    <% end %>

    <div class="dropdown--dock bulk-menu--action-dock" data-bulk-menu-target="popsDropdown">
      <button type="button"
              class="button hotkey-hint hotkey-hint--always"
              data-controller="hotkey"
              data-intent="secondary"
              data-radius="base"
              data-size="sm"
              data-hotkey="L"
              data-action="bulk-menu#openPopsPicker keydown.l@document->hotkey#click"
              aria-keyshortcuts="L"
              aria-haspopup="menu">
        <%= icon_tag("arrow-up") %>
        Later
      </button>
      <turbo-frame id="postpone_picker_dropdown_id"
                   class="dropdown dropdown--element dropdown--element-up animations--side-in bulk-menu--picker bulk-menu--picker--schedule"
                   popover
                   loading="lazy"
                   data-controller="grid-navigation"
                   data-grid-navigation-columns-value="1"
                   data-action="keydown->grid-navigation#navigate"></turbo-frame>
    </div>

    <div class="dropdown--dock bulk-menu--action-dock" data-bulk-menu-target="collectsDropdown">
      <button type="button"
              class="button hotkey-hint hotkey-hint--always"
              data-controller="hotkey"
              data-intent="secondary"
              data-radius="base"
              data-size="sm"
              data-hotkey="S"
              data-action="bulk-menu#openCollectsPicker keydown.s@document->hotkey#click"
              aria-keyshortcuts="S"
              aria-haspopup="menu">
        <%= icon_tag("arrow-left") %>
        Save
      </button>
      <turbo-frame id="collects_picker_dropdown_id"
                   class="dropdown dropdown--element dropdown--element-up animations--side-in bulk-menu--picker bulk-menu--picker--collects"
                   popover
                   loading="lazy"></turbo-frame>
    </div>


    <button type="button"
            class="button dropdown--element-hide bulk-menu--hide"
            data-intent="primary"
            data-radius="full"
            data-size="xs"
            data-content="icon"
            data-action="bulk-menu#clear"
            aria-label="Clear selection">
      <%= icon_tag("x") %>
    </button>
  </div>

  <p class="bulk-menu--amount" data-bulk-menu-target="amount">0 selected</p>
</div>

<%# locals: (bullet_ids:, return_to:, collects_q:, collections:, collections_page:) %>
<div class="dropdown--element-body">
  <div class="dropdown--header">
    <h2>Save to collection</h2>
    <button
      type="button"
      class="button dropdown--element-hide"
      data-intent="secondary"
      data-radius="full"
      data-size="xs"
      data-content="icon"
      popovertarget="collects_picker_dropdown_id"
      popovertargetaction="hide"
      aria-label="Close save to collection"
    >
      <%= icon_tag("x") %>
    </button>
  </div>

  <div class="bulk-menu--collect-picker"
       data-controller="combobox"
       data-combobox-path-value="<%= new_collect_path %>">
    <%= form_with url: new_collect_path,
          method: :get,
          class: "form bulk-menu--collect-search",
          data: { combobox_target: "searchForm" } do %>
      <%= hidden_field_tag :bullet_ids, bullet_ids, data: { bulk_menu_target: "idList" } %>
      <%= hidden_field_tag :return_to, return_to if return_to.present? %>
      <%= label_tag :q, "Search collections", class: "form-label utilities--sr-only" %>
      <%= search_field_tag :q, collects_q,
            placeholder: "Search collections",
            autofocus: true,
            data: {
              combobox_target: "searchField",
              action: "input->combobox#search search->combobox#commit keydown->combobox#navigate"
            } %>
    <% end %>

    <nav class="dropdown--menu" aria-label="Collections">
      <%= render "bullets/collects/collections_list",
            bullet_ids: bullet_ids,
            return_to: return_to,
            collects_q: collects_q,
            collections: collections,
            collections_page: collections_page %>
    </nav>

    <% if collections.empty? %>
      <p class="bulk-menu--collect-empty">No collections found.</p>
    <% end %>
  </div>
</div>

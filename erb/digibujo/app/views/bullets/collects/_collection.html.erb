<%# locals: (collection:, bullet_ids: "") %>
<li class="bulk-menu--picker-list-item" role="option">
  <%= form_with url: collect_path,
        method: :post,
        class: "dropdown--menu-form",
        data: { turbo_stream: true } do %>
    <%= hidden_field_tag :bullet_ids, bullet_ids, data: { bulk_menu_target: "idList" } %>
    <%= hidden_field_tag :bucket_id, collection.bucket.id %>
    <button type="submit"
            class="collection--section-list-item"
            data-combobox-target="item">
      <%= icon_tag(collection.bucket.icon, style: "color: #{colour(collection.bucket.colour)};", class: "home--section-list-item-icon") %>
      <span class="utilities--line-clamp-1"><%= collection.name %></span>
      •
      <span class="typography--paragraph-sm utilities--line-clamp-1">
        <%= collection.bullets.count %>
        <%= "bullet".pluralize(collection.bullets.count) %>,
        <%= collection.created_at.strftime("%b %d") %>
      </span>
    </button>
  <% end %>
</li>

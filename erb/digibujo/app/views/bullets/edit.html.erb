<% content_for(:title) { "Edit bullet" } %>

<% bullet_colour = colour(@bullet.colour) || "var(--#{@bullet.bulletable_type.downcase}-color)" %>

<div class="layout--page layout--container layout--container-md">
  <div class="layout--mx-auto bullet--header">
    <%= icon_tag(@bullet.marker_icon.to_s.dasherize,
          style: "color: #{bullet_colour};",
          class: "bullet--header-icon") %>
    <h2>Edit bullet</h2>
  </div>

  <div class="layout--surface">
    <div class="layout--flex layout--justify-between layout--surface-header">
      <%= back_link_to bullet_path(@bullet), class: "button--tertiary button--sm", data: { turbo_frame: "_top" } do %>
        <%= icon_tag("arrow-left", style: "color: var(--color-text-base);", class: "button--icon") %>
        Back
      <% end %>

      <%= button_to bullet_path(@bullet),
            method: :delete,
            class: "button--secondary button--sm button--danger",
            form: { data: { turbo_confirm: "Are you sure?" } } do %>
        <%= icon_tag("trash", style: "color: var(--color-text-base);", class: "button--icon") %>
        Delete
      <% end %>
    </div>

    <div class="layout--padded">
      <turbo-frame id="<%= dom_id(@bullet) %>"
                   class="bullet"
                   data-bullet-type="<%= @bullet.bulletable_type.downcase %>">
        <%= render "bullets/edit_form",
              bullet: @bullet,
              return_path: bullet_path(@bullet) %>
      </turbo-frame>
    </div>
  </div>
</div>

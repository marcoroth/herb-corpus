<% id = turbo_frame_request_id.to_s %>

<%
  partial = case @bullet.bucket&.bucketable_type
  when "Monthlylog" then "monthlylogs/bullets/bullet"
  when "Future" then "futures/bullets/bullet"
  else @bullet.to_partial_path
  end
%>

<%= turbo_stream.before turbo_frame_request_id do %>
  <%= render partial: partial, locals: { bullet: @bullet } %>
<% end %>

<%= turbo_stream.remove "no_bullets_container" %>

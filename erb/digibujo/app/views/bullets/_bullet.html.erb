<%# locals: (bullet:) %>
<% bullet_colour = colour(bullet.colour) || "var(--#{bullet.bulletable_type.downcase}-color)" %>
<turbo-frame id="<%= dom_id(bullet) %>" class="bullet" data-bullet-type="<%= bullet.bulletable_type.downcase %>" data-task-completed="<%= bullet.completed? ? "true" : "false" %>"
  data-bullet-data-attributes="<%= bullet.data_attributes.to_json %>">

  <input
    type="checkbox"
    id="<%= dom_id(bullet, :select_checkbox) %>"
    value="<%= bullet.id %>"
    data-bulk-menu-target="checkbox"
    data-bulk-pinnable="<%= bullet.pinned? ? "pinned" : "unpinned" %>"
    data-bulk-publishable="<%= bullet.published? ? "published" : "unpublished" %>"
    data-bulk-scheduled="<%= bullet.bucket&.bucketable_type == "Daylog" && bullet.pops_on == Date.current ? "today" : "not-today" %>"
    <% if bullet.completable? %>
      data-bulk-completable="<%= bullet.completed? ? "completed" : "incomplete" %>"
    <% end %>
    data-action="bulk-menu#toggle"
    class="utilities--sr-only"
  >

  <div class="bullet--rail">
    <% migrated = bullet.collected_migration? || bullet.rescheduled_migration? %>
    <label
      class="bullet--marker<%= " bullet--marker-migration" if migrated %>"
      for="<%= dom_id(bullet, :select_checkbox) %>"
      aria-label="Select bullet"
    >
      <span aria-hidden="true" style="display: flex;">
        <% if migrated %>
          <%= icon_tag(bullet.collected_migration? ? "arrow-left" : "arrow-right", class: "bullet--marker-icon") %>
        <% else %>
          <%= icon_tag(bullet.marker_icon.to_s.dasherize, class: "bullet--marker-icon") %>
        <% end %>
        <span class="bullet--marker-select-indicator" aria-hidden="true"></span>
      </span>
    </label>
  </div>

  <div class="bullet--content">
    <div class="bullet--body">
      <%= yield %>

    </div>
    <label
    class="bullet--select-checkbox"
    for="<%= dom_id(bullet, :select_checkbox) %>"
    aria-label="Select bullet"
    ></label>
  </div>
</turbo-frame>

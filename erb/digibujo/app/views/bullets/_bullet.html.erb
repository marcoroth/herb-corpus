<%# locals: (bullet:) %>
<turbo-frame id="<%= dom_id(bullet) %>" class="bullet" data-bullet-type="<%= bullet.bulletable_type.downcase %>" data-task-completed="<%= bullet.completed? ? "true" : "false" %>"
  data-bullet-data-attributes="<%= bullet.data_attributes.to_json %>">

  <input
    type="checkbox"
    id="<%= dom_id(bullet, :select_checkbox) %>"
    value="<%= bullet.id %>"
    
    data-bulk-menu-target="checkbox"
    data-bulk-pinnable="<%= bullet.pinned? ? "pinned" : "unpinned" %>"
    data-bulk-publishable="<%= bullet.published? ? "published" : "unpublished" %>"
    <% if bullet.completable? %>
      data-bulk-completable="<%= bullet.completed? ? "completed" : "incomplete" %>"
    <% end %>
    data-action="bulk-menu#toggle"
    class="utilities--sr-only"
  >

  <div class="bullet--rail">
    <label
      class="bullet--marker"
      for="<%= dom_id(bullet, :select_checkbox) %>"
      aria-label="Select bullet"
    >
      <span aria-hidden="true" style="display: flex;">
        <%= icon_tag(bullet.marker_icon.to_s.dasherize, style: "color: #{colour(bullet.colour)};", class: "bullet--marker-type") %>
        <span class="bullet--marker-select-indicator" aria-hidden="true"></span>
      </span>
    </label>

    <% if bullet.collected_migration? || bullet.rescheduled_migration? %>
      <% migration_popover_id = dom_id(bullet, :migration) %>
      <% migration_anchor = "--migration-#{bullet.id}" %>
      <% migration_title = bullet.collected_migration? ? "Collected" : "Rescheduled" %>
      <% migration_icon = bullet.collected_migration? ? "arrow-left" : "arrow-right" %>
      <span class="bullet--metadata-marker dropdown--dock" style="anchor-name: <%= migration_anchor %>">
        <button
          type="button"
          class="bullet--metadata-link"
          popovertarget="<%= migration_popover_id %>"
          aria-label="<%= migration_title %>"
          aria-haspopup="dialog"
        >
          <%= icon_tag(migration_icon, class: "bullet--metadata-icon") %>
        </button>
        <div
          id="<%= migration_popover_id %>"
          class="dropdown dropdown--element dropdown--element-up animations--side-in bullet--migration-dropdown"
          style="position-anchor: <%= migration_anchor %>"
          popover
        >
          <div class="dropdown--element-body">
            <p class="bullet--migration-text"><%= bullet.migration_hint %></p>
          </div>
        </div>
      </span>
    <% end %>
  </div>

  <!-- this is the checkbox for the bullet that allows it to be selected for bulk actions -->
  <label class="bullet--select-checkbox" for="<%= dom_id(bullet, :select_checkbox) %>" aria-hidden="true"></label>

  <div class="bullet--content">
    <div class="bullet--body">
      <%= yield %>
    </div>
    <time
      class="bullet--time"
      datetime="<%= bullet.created_at.iso8601 %>"
    ><%= bullet.created_at.strftime("%H:%M") %></time>
  </div>
</turbo-frame>

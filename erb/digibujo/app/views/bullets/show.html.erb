<% content_for(:title) { @bullet.name } %>

<% bullet_colour = colour(@bullet.colour) || "var(--#{@bullet.bulletable_type.downcase}-color)" %>

<div class="layout--page layout--container layout--container-md">
  <div class="layout--surface">
    <div class="layout--flex layout--justify-between layout--surface-header">
      <%= back_link_to home_path, class: "button--tertiary button--sm" do %>
        <%= icon_tag("arrow-left", style: "color: var(--color-text-base);", class: "button--icon") %>
        Back
      <% end %>

      <div class="layout--flex layout--gapped">

        <% if @bullet.pinned? %>
          <%= button_to pin_path,
                method: :delete,
                params: { bullet_ids: @bullet.id },
                class: "button--secondary button--sm",
                aria: { label: "Unpin #{@bullet.name}" } do %>
            <%= icon_tag("pin", style: "color: var(--color-text-base);", class: "button--icon") %>
          <% end %>

        <% else %>
          <%= button_to pin_path,
                method: :post,
                params: { bullet_ids: @bullet.id },
                class: "button--secondary button--sm",
                aria: { label: "Pin #{@bullet.name}" } do %>
            <%= icon_tag("pin", style: "color: var(--color-text-base);", class: "button--icon") %>
            Pin
          <% end %>
        <% end %>

        <button type="button" class="button--secondary button--sm" aria-label="Actions" aria-haspopup="menu" popovertarget="<%= dom_id(@bullet, :actions) %>">
          <%= icon_tag("dots", style: "color: var(--color-text-base);", class: "button--icon") %>
          Actions
        </button>
        <div id="<%= dom_id(@bullet, :actions) %>"
             class="dropdown dropdown--element dropdown--element-bottom animations--side-in"
             style="position-anchor: <%= dom_id(@bullet, :actions) %>"
             popover
             data-controller="grid-navigation"
             data-grid-navigation-columns-value="1"
             data-action="keydown->grid-navigation#navigate">
          <div class="dropdown--element-body">
            <nav class="dropdown--menu" aria-label="Actions">
              <% unless @bullet.bulletable_type == "Voice" %>
                <%= link_to edit_bullet_path(@bullet),
                      class: "dropdown-item",
                      data: {
                        turbo_frame: "_top",
                        grid_navigation_target: "item",
                        action: "focus->grid-navigation#syncPosition"
                      } do %>
                  <%= icon_tag("pencil") %>
                  Edit
                <% end %>
              <% end %>
              <% if @bullet.published? %>
                <%= button_to publish_path,
                      method: :delete,
                      params: { bullet_ids: @bullet.id },
                      class: "dropdown-item",
                      form_class: "dropdown--menu-form",
                      data: {
                        grid_navigation_target: "item",
                        action: "focus->grid-navigation#syncPosition"
                      },
                      aria: { label: "Unpublish #{@bullet.name}" } do %>
                  <%= icon_tag("link") %>
                  Unpublish
                <% end %>
              <% else %>
                <%= button_to publish_path,
                      method: :post,
                      params: { bullet_ids: @bullet.id },
                      class: "dropdown-item",
                      form_class: "dropdown--menu-form",
                      data: {
                        grid_navigation_target: "item",
                        action: "focus->grid-navigation#syncPosition"
                      },
                      aria: { label: "Publish #{@bullet.name}" } do %>
                  <%= icon_tag("link") %>
                  Publish
                <% end %>
              <% end %>

              <% if @bullet.archived? %>
                <%= button_to archive_path,
                      method: :delete,
                      params: { bullet_ids: @bullet.id },
                      class: "dropdown-item",
                      form_class: "dropdown--menu-form",
                      data: {
                        grid_navigation_target: "item",
                        action: "focus->grid-navigation#syncPosition"
                      },
                      aria: { label: "Unarchive #{@bullet.name}" } do %>
                  <%= icon_tag("archive") %>
                  Unarchive
                <% end %>
              <% else %>
                <%= button_to archive_path,
                      method: :post,
                      params: { bullet_ids: @bullet.id },
                      class: "dropdown-item",
                      form_class: "dropdown--menu-form",
                      form: { data: { turbo_confirm: "Are you sure?" } },
                      data: {
                        grid_navigation_target: "item",
                        action: "focus->grid-navigation#syncPosition"
                      },
                      aria: { label: "Archive #{@bullet.name}" } do %>
                  <%= icon_tag("archive") %>
                  Archive
                <% end %>
              <% end %>
            </nav>
          </div>
        </div>
      </div>
    </div>

    <div class="layout--padded bullet--show-body">
      <% if @bullet.published? %>
        <input <%# herb:disable html-input-require-autocomplete %>
          type="text"
          class="bullet--published-link"
          value="<%= published_url(@bullet.public_code) %>"
          readonly
          onclick="this.select()"
        >
      <% end %>

      <% if @bullet.bulletable_type == "Voice" && @bullet.bulletable.recording.attached? %>
        <%= @bullet.body %>
        <%= render "voices/playback",
              recording: @bullet.voice.recording,
              recording_duration: @bullet.voice.duration_seconds %>
      <% else %>
      <div class="layout--surface layout--padded">
        <%= @bullet.body %>
      </div>
      <% end %>
    </div>
  </div>
</div>

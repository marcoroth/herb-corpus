<% content_for(:title) { @bullet.name } %>

<% bullet_colour = colour(@bullet.colour) || "var(--#{@bullet.bulletable_type.downcase}-color)" %>

<div class="layout--container" data-size="md">
  <div class="layout--surface" data-elevation="1" data-padding="true">

    <div class="layout--flex" data-align="center" data-justify="between">
      <div class="layout--flex" data-align="center">
      <%= back_link_to home_path, class: "button", data: { intent: "secondary", radius: "full", size: "sm", content: "icon" } do %>
        <%= icon_tag("arrow-left", style: "color: var(--color-invert-2);") %>
        <% end %>
      </div>

      <div class="layout--flex" data-align="center">
        <% if @bullet.pinned? %>
          <%= button_to pin_path,
                method: :delete,
                params: { bullet_ids: @bullet.id },
                class: "button", data: { intent: "secondary", radius: "full", size: "sm", content: "icon" },
                aria: { label: "Unpin #{@bullet.name}" } do %>
            <%= icon_tag("pin", style: "color: var(--color-invert-2);") %>
          <% end %>

        <% else %>
          <%= button_to pin_path,
                method: :post,
                params: { bullet_ids: @bullet.id },
                class: "button", data: { intent: "secondary", radius: "full", size: "sm", content: "icon" },
                aria: { label: "Pin #{@bullet.name}" } do %>
            <%= icon_tag("pin", style: "color: var(--color-invert-2);") %>
          <% end %>
        <% end %>

        <button type="button" class="button" data-intent="secondary" data-radius="full" data-size="sm" data-content="icon" aria-label="Actions" aria-haspopup="menu" popovertarget="<%= dom_id(@bullet, :actions) %>">
          <%= icon_tag("dots", style: "color: var(--color-invert-2);") %>
        </button>
        <div id="<%= dom_id(@bullet, :actions) %>"
             class="dropdown dropdown--element dropdown--element-bottom animations--side-in"
             style="position-anchor: <%= dom_id(@bullet, :actions) %>"
             popover
             data-controller="grid-navigation"
             data-grid-navigation-columns-value="1"
             data-action="keydown->grid-navigation#navigate">
          <div class="dropdown--element-body">
            <nav class="dropdown--menu" aria-label="Actions">
              <% unless @bullet.bulletable_type == "Voice" %>
                <%= link_to edit_bullet_path(@bullet),
                      class: "dropdown-item picker--item",
                      data: {
                        turbo_frame: "_top",
                        grid_navigation_target: "item",
                        action: "focus->grid-navigation#syncPosition"
                      } do %>
                  <%= icon_tag("pencil") %>
                  Edit
                <% end %>
              <% end %>
              <% if @bullet.published? %>
                <%= button_to publish_path,
                      method: :delete,
                      params: { bullet_ids: @bullet.id },
                      class: "dropdown-item picker--item",
                      form_class: "dropdown--menu-form",
                      data: {
                        grid_navigation_target: "item",
                        action: "focus->grid-navigation#syncPosition"
                      },
                      aria: { label: "Unpublish #{@bullet.name}" } do %>
                  <%= icon_tag("link") %>
                  Unpublish
                <% end %>
              <% else %>
                <%= button_to publish_path,
                      method: :post,
                      params: { bullet_ids: @bullet.id },
                      class: "dropdown-item picker--item",
                      form_class: "dropdown--menu-form",
                      data: {
                        grid_navigation_target: "item",
                        action: "focus->grid-navigation#syncPosition"
                      },
                      aria: { label: "Publish #{@bullet.name}" } do %>
                  <%= icon_tag("link") %>
                  Publish
                <% end %>
              <% end %>

              <% if @bullet.archived? %>
                <%= button_to archive_path,
                      method: :delete,
                      params: { bullet_ids: @bullet.id },
                      class: "dropdown-item picker--item",
                      form_class: "dropdown--menu-form",
                      data: {
                        grid_navigation_target: "item",
                        action: "focus->grid-navigation#syncPosition"
                      },
                      aria: { label: "Unarchive #{@bullet.name}" } do %>
                  <%= icon_tag("archive") %>
                  Unarchive
                <% end %>
              <% else %>
                <%= button_to archive_path,
                      method: :post,
                      params: { bullet_ids: @bullet.id },
                      class: "dropdown-item picker--item",
                      form_class: "dropdown--menu-form",
                      form: { data: { turbo_confirm: "Are you sure?" } },
                      data: {
                        grid_navigation_target: "item",
                        action: "focus->grid-navigation#syncPosition"
                      },
                      aria: { label: "Archive #{@bullet.name}" } do %>
                  <%= icon_tag("archive") %>
                  Archive
                <% end %>
              <% end %>
            </nav>
          </div>
        </div>
      </div>
    </div>

    <div class="layout--flex" data-direction="column" data-align="center" data-padding="true">
      <br>
      <div class="layout--container" data-size="sm">
      <% if @bullet.published? %>
        <input <%# herb:disable html-input-require-autocomplete %>
          type="text"
          value="<%= published_url(@bullet.public_code) %>"
          readonly
          onclick="this.select()"
          class="layout--surface" data-elevation="1"
          data-padding="true"
        >
        <% end %>
      </div>

      <% if @bullet.bulletable_type == "Voice" && @bullet.bulletable.recording.attached? %>
        <div class="layout--surface" data-padding="true">
          <%= @bullet.body %>
        </div>
        <%= render "voices/playback",
              recording_source: url_for(@bullet.voice.recording),
              recording_duration: @bullet.voice.duration_seconds %>
      <% else %>
      <div class="layout--surface" data-padding="true">
        <%= @bullet.body %>
      </div>
      <% end %>
    </div>
  </div>
</div>

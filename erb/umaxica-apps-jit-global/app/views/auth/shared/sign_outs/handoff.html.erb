<!doctype html>
<% content_for :page_title, t("sign.shared.sign_out.title") %>
<meta charset="utf-8">
<meta name="robots" content="noindex,nofollow">
<form id="sign-out-handoff-form"
      method="post"
      action="<%= @sign_out_handoff_url || sign_out_confirmation_form_path %>"
      data-turbo="false">
  <%= hidden_field_tag :logout_challenge, @logout_transaction.logout_challenge if @logout_transaction.present? %>
  <%= hidden_field_tag :ri, params[:ri] if params[:ri].present? %>
</form>
<script nonce="<%= content_security_policy_nonce %>">
  (function () {
    const form = document.getElementById("sign-out-handoff-form");
    if (form.requestSubmit) {
      form.requestSubmit();
    } else {
      form.submit();
    }
  })();
</script>
<noscript>
  <button form="sign-out-handoff-form" type="submit">
    <%= t("sign.shared.sign_out.handoff_button") %>
  </button>
</noscript>

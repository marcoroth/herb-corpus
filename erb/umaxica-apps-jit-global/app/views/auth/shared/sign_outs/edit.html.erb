<% content_for :page_title, t("sign.shared.sign_out.title") %>

<div>
  <h1><%= title t("sign.shared.sign_out.title") %></h1>

  <% if sign_out_active_context_present? %>
    <p><%= t("sign.shared.sign_out.confirm_description") %></p>
    <%= form_with url: sign_out_post_path, method: :post, data: { turbo: false } do %>
      <%= hidden_field_tag :logout_challenge, params[:logout_challenge] if params[:logout_challenge].present? %>
      <%= submit_tag t("sign.shared.sign_out.button") %>
      <noscript><p><%= t("sign.shared.sign_out.confirm_description") %></p></noscript>
    <% end %>
    <%= button_to t("actions.cancel"),
                  sign_out_post_path,
                  method: :delete,
                  form: { data: { turbo: false } } %>
  <% else %>
    <p><%= t("sign.shared.sign_out.already_signed_out") %></p>
  <% end %>

  <p><%= link_to t("sign.shared.sign_out.home_link"), sign_out_home_path %></p>
</div>

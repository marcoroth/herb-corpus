<% content_for :page_title, I18n.t("auth.step_up.completed") %>

<%= form_with url: completion_url, method: :post, local: true, authenticity_token: false, data: { turbo: false }, html: { id: "step-up-completion-form" } do %>
  <%= hidden_field_tag :authenticity_token, csrf_token if csrf_token.present? %>
  <%= hidden_field_tag :step_up_ceremony_result, result_token %>
  <%= hidden_field_tag :ri, ri if ri.present? %>
  <noscript>
    <%= submit_tag I18n.t("auth.step_up.completed") %>
  </noscript>
<% end %>

<script nonce="<%= content_security_policy_nonce %>">
  document.getElementById("step-up-completion-form").submit();
</script>

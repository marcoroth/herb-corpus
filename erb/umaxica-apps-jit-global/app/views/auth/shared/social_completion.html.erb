<% content_for :page_title, I18n.t("sign.app.social.sessions.continue") %>

<%= form_with url: completion_url, method: :post, local: true, authenticity_token: false, data: { turbo: false }, html: { id: "social-completion-form" } do %>
  <%= hidden_field_tag :social_ceremony_result, result_token %>
  <%= hidden_field_tag :ri, ri if ri.present? %>
  <noscript>
    <%= submit_tag I18n.t("sign.app.social.sessions.continue") %>
  </noscript>
<% end %>

<script nonce="<%= content_security_policy_nonce %>">
  document.getElementById("social-completion-form").submit();
</script>

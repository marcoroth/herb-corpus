<% content_for :page_title, I18n.t("auth.step_up.canceled") %>

<%= form_with url: cancellation_url, method: :post, local: true, authenticity_token: false, data: { turbo: false }, html: { id: "step-up-cancellation-form" } do %>
  <%= hidden_field_tag :authenticity_token, csrf_token if csrf_token.present? %>
  <%= hidden_field_tag :ri, ri if ri.present? %>
  <%= hidden_field_tag :scope, scope if scope.present? %>
  <%= hidden_field_tag :return_to, return_to if return_to.present? %>
  <noscript>
    <%= submit_tag I18n.t("auth.step_up.canceled") %>
  </noscript>
<% end %>

<script nonce="<%= content_security_policy_nonce %>">
  document.getElementById("step-up-cancellation-form").submit();
</script>

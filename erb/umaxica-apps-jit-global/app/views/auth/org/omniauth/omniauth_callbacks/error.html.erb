<% content_for :page_title, t("sign.org.authentication.entra.new.page_title") %>

<div class="animate-fade-in-up">
  <div>
    <h1><%= t("sign.org.authentication.entra.new.page_title") %></h1>
  </div>

  <div role="alert">
    <%# @error_reason is always one of the allowlisted symbols in entra_failure_reason, so every
        value has its own translation and a fallback would only mask a missing one. %>
    <p><%= t("sign.org.authentication.entra.errors.#{@error_reason}") %></p>
  </div>
</div>

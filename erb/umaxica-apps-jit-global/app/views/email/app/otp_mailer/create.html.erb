<h2><%= t("mail.email.app.otp_mailer.create.title") %></h2>

<p><%= t("mail.common.greeting") %></p>

<p><%= t("mail.email.app.otp_mailer.create.instruction") %></p>

<div class="otp-code">
  <%= @pass_code %>
</div>

<% if @verification_url.present? %>
  <p>
    <%= link_to t("mail.email.app.otp_mailer.create.verify_link"), @verification_url, target: "_blank", rel: "noopener noreferrer" %>
  </p>
<% end %>

<p>
  <small><%= t("mail.email.app.otp_mailer.create.expiration_note") %></small>
</p>

<p>
  <%= t("mail.email.app.otp_mailer.create.ignore_instruction") %>
</p>

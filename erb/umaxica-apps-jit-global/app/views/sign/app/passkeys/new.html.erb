<% title "Manage Passkey" %>

<%# Colours come from the shared tokens rather than palette steps, so this page follows the theme
    the visitor chose. It previously paired `bg-white` with `dark:bg-zinc-900`, which resolved
    against the operating system and ignored an explicit light or dark choice. %>
<div class="flex min-h-[60vh] flex-col items-center justify-center">
  <div class="w-full max-w-md rounded-xl border border-line bg-surface p-8 shadow-sm">
    <h1 class="mb-2 text-2xl font-bold text-fg">Passkey Settings</h1>
    <p class="mb-6 text-sm text-fg-muted">Domain: <code class="rounded bg-surface-muted px-2 py-1"><%= @current_host %></code></p>

    <div id="passkey-status" class="mb-6 flex flex-col gap-2">
      <% if @passkey_exists %>
        <%# The tick is decorative; "registered" is carried by the sentence, not by the glyph or
            by colour alone. %>
        <p class="text-sm text-fg"><span aria-hidden="true">✅</span> Passkey is registered.</p>
        <button id="register-btn" data-update="true" class="w-full rounded-md bg-accent px-6 py-3 font-medium text-accent-fg transition-colors hover:bg-accent-hover">
          Update Passkey (Replace)
        </button>
        <button id="delete-btn" class="w-full rounded-md bg-danger px-6 py-3 font-medium text-danger-fg transition-colors hover:bg-danger-hover">
          Remove Passkey
        </button>
      <% else %>
        <p class="text-sm text-fg-muted">No passkey registered.</p>
        <button id="register-btn" data-update="false" class="w-full rounded-md bg-accent px-6 py-3 font-medium text-accent-fg transition-colors hover:bg-accent-hover">
          Register Passkey
        </button>
      <% end %>
    </div>

    <%# The `hidden` attribute, not the `hidden` utility: the script clears it by setting the
        property, and a class would keep `display:none` applied after that. `role="status"`
        means the outcome is announced rather than only shown. %>
    <div id="message" hidden role="status" class="mt-4 font-mono text-sm"></div>
  </div>
</div>

<script>
  function showMessage(text, isError = false) {
    const msg = document.getElementById('message');
    if (msg) {
      msg.textContent = text;
      // Tokens rather than palette steps, and `hidden` rather than an inline style, so the
      // message follows the chosen theme and the policy never sees a style attribute.
      msg.className = `mt-4 font-mono text-sm ${isError ? 'text-danger' : 'text-fg-muted'}`;
      msg.hidden = false;
    }
  }

  function bufferDecode(value) {
    return Uint8Array.from(atob(value.replace(/-/g, "+").replace(/_/g, "/")), c => c.charCodeAt(0));
  }

  function bufferEncode(value) {
    return btoa(String.fromCharCode(...new Uint8Array(value)))
      .replace(/\+/g, "-").replace(/\//g, "_").replace(/=/g, "");
  }

  const registerBtn = document.getElementById('register-btn');
  if (registerBtn) {
    registerBtn.addEventListener('click', async () => {
      try {
        showMessage("Getting options...");
        const optionsRes = await fetch('/sign/passkey/options', { method: 'POST' });
        if (!optionsRes.ok) throw new Error('Failed to get options');
        const options = await optionsRes.json();

        options.challenge = bufferDecode(options.challenge);
        options.user.id = bufferDecode(options.user.id);
        if (options.excludeCredentials) {
          options.excludeCredentials.forEach(cred => {
            cred.id = bufferDecode(cred.id);
          });
        }

        showMessage("Waiting for user interaction...");
        const credential = await navigator.credentials.create({ publicKey: options });

        showMessage("Verifying...");
        const body = {
          id: credential.id,
          rawId: bufferEncode(credential.rawId),
          type: credential.type,
          response: {
            attestationObject: bufferEncode(credential.response.attestationObject),
            clientDataJSON: bufferEncode(credential.response.clientDataJSON),
          }
        };

        const isUpdate = registerBtn.dataset.update === 'true';
        const method = isUpdate ? 'PATCH' : 'POST';
        const url = '/sign/passkey';

        const verifyRes = await fetch(url, {
          method: method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });

        if (verifyRes.ok) {
          showMessage("Success! Reloading...");
          setTimeout(() => window.location.reload(), 1000);
        } else {
          const err = await verifyRes.json();
          throw new Error(err.error || 'Verification failed');
        }
      } catch (e) {
        showMessage(e.message, true);
        console.error(e);
      }
    });
  }

  const deleteBtn = document.getElementById('delete-btn');
  if (deleteBtn) {
    deleteBtn.addEventListener('click', async () => {
      if (!confirm("Are you sure?")) return;
      try {
        const res = await fetch('/sign/passkey', { method: 'DELETE' });
        if (res.ok) {
          window.location.reload();
        } else {
          const err = await res.json();
          showMessage(err.error || "Failed to delete", true);
        }
      } catch (e) {
        showMessage(e.message, true);
      }
    });
  }
</script>

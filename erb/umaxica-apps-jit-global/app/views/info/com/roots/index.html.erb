<!doctype html>
<%# A standalone document: it bypasses the surface layouts, so it links its own stylesheet and
    renders the theme attribute itself. Both were missing before, which is why the embedded CSS
    this replaced was refused by the style-src-elem policy and never applied. %>
<html lang="<%= I18n.locale %>"
      data-theme="<%= theme_cookie_value %>"
      data-edition="com">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= display_meta_tags site: "#{ENV.fetch("BRAND_NAME").upcase} (COM)", separator: "—", reverse: true %>
    <%= vite_stylesheet_tag "~/styles/surfaces/info_com.css", nonce: true %>
  </head>
  <body>
    <main class="grid min-h-screen place-items-center p-8">
      <section aria-labelledby="info-com-title" class="w-full max-w-2xl">
        <h1 id="info-com-title" class="mb-3 text-4xl leading-none font-bold text-fg sm:text-5xl">Info Com</h1>
        <p class="text-base text-fg-muted"><%= t("info.com.roots.message") %></p>
      </section>
    </main>
  </body>
</html>

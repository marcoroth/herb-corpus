<!DOCTYPE html>
<html lang="<%= get_language %>" data-theme="<%= theme_cookie_value %>" class="<%= theme_html_class %>">
<head>
  <meta charset="utf-8">
  <%# The document title stays a server responsibility: it is rendered into the initial HTML from
      the page's own `title` prop, so it is correct before React boots and for clients that never
      run it. Inertia's <Head> is deliberately not used, which keeps one source of truth. %>
  <%= display_meta_tags site: "#{ENV.fetch("BRAND_NAME").upcase} (ORG)",
                        title: page_title(inertia_page&.dig(:props, :title)),
                        separator: "—",
                        reverse: true %>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%# Inertia injects its progress bar as a <style> element built at runtime, and the Vite dev
      client injects its own. Both read the nonce from this tag, which is how they satisfy
      style-src-elem without the policy having to allow unsafe-inline. %>
  <meta property="csp-nonce" nonce="<%= content_security_policy_nonce %>">
  <%= vite_client_tag nonce: true %>
  <%= vite_react_refresh_tag nonce: true %>
  <%= vite_stylesheet_tag "~/styles/surfaces/auth_org.css", nonce: true %>
  <%= vite_typescript_tag "entrypoints/inertia/auth_org.tsx", nonce: content_security_policy_nonce %>
  <%# Turnstile renders explicitly from React, so the API script has to be in the document before
      the widget mounts. %>
  <%= render "layouts/shared/cloudflare_turnstile_api" %>
  <%= inertia_ssr_head %>
</head>
<body>
  <%# Header, footer and preference controls are the React surface layout's responsibility
      (src/layouts/SurfaceLayout.tsx); this shell owns the document only. %>
  <%= inertia_root %>
</body>
</html>

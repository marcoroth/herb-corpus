<!DOCTYPE html>
<html lang="<%= get_language %>" data-theme="<%= theme_cookie_value %>" class="<%= theme_html_class %>">
<head>
  <meta charset="utf-8">
  <%= display_meta_tags site: "#{ENV.fetch("BRAND_NAME").upcase} (APP)",
                        title: page_title,
                        separator: "—",
                        reverse: true %>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <meta property="csp-nonce" nonce="<%= content_security_policy_nonce %>">
  <%= stylesheet_link_tag "application", nonce: true %>
  <%= javascript_importmap_tags %>
  <%= render "layouts/shared/cloudflare_turnstile_api" %>
</head>
<body>
  <header>
    <%= render "layouts/shared/flash_messages" %>
    <%= render "layouts/shared/current_banner", tld: :app, domain: :sign, region: :global %>
    <% unless @hide_auth_navigation %>
      <nav aria-label="Primary">
        <ul>
          <% if logged_in? %>
            <li><%= link_to t("sign.app.layout.nav.logout"), new_auth_app_sign_out_path %></li>
          <% else %>
            <li><%= link_to t("sign.app.layout.nav.sign_up"), auth_app_sign_up_path %></li>
            <li><%= link_to t("sign.app.layout.nav.log_in"), auth_app_sign_in_path %></li>
          <% end %>
        </ul>
      </nav>
    <% end %>
    <p><strong><%= link_to ENV.fetch("BRAND_NAME"), auth_app_root_path %></strong> (app)</p>
  </header>

  <main id="main">
    <%= yield %>
  </main>

  <footer>
    <nav aria-label="Footer">
      <ul>
        <% if logged_in? %>
          <li><%= link_to t("sign.app.preferences.footer.dashboard"), base_app_dashboard_url(ri: current_region_identifier, host: base_authority_host) %></li>
        <% else %>
          <li><%= link_to t("sign.app.preferences.footer.home"), auth_app_root_path %></li>
        <% end %>
        <li><%= link_to t("sign.app.preferences.footer.preference"), base_app_preference_url(ri: current_region_identifier, host: base_authority_host) %></li>
        <li><%= link_to t("sign.app.preferences.footer.settings"), base_app_identity_url(ri: current_region_identifier, host: base_authority_host) %></li>
      </ul>
    </nav>
    <aside aria-label="Preferences">
      <%= render "layouts/shared/footer_cookie_controls", scope: :app, base_host: base_authority_host %>
      <%= render "layouts/shared/footer_theme_controls", scope: :app %>
    </aside>
    <div>
      <%= render "layouts/shared/copyright" %>
    </div>
  </footer>
</body>
</html>

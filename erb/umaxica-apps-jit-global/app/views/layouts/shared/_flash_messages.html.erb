<output>
<% flash.each do |key, message| %>
  <% Array(message).each do |text| %>
    <div class="border border-black p-1 mb-1 font-bold flex gap-2 text-xs">
      <span class="bg-black text-white px-1">[<%= key.upcase %>]</span>
      <span><%= text %></span>
    </div>
  <% end %>
<% end %>
</output>

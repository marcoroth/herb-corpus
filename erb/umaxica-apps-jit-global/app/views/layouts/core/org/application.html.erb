<!DOCTYPE html>
<html lang="<%= get_language %>" data-theme="<%= theme_cookie_value %>" class="<%= theme_html_class %>">
<head>
  <meta charset="utf-8">
  <%= display_meta_tags site: "#{ENV.fetch("BRAND_NAME").upcase} (ORG)",
                        title: page_title,
                        separator: "—",
                        reverse: true %>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= vite_stylesheet_tag "~/styles/surfaces/core_org.css", nonce: true %>
</head>
<body>
  <header>
    <p><strong><%= link_to ENV.fetch("BRAND_NAME"), core_org_root_path %></strong> (org)</p>
  </header>

  <main id="main">
    <%= yield %>
  </main>
</body>
</html>

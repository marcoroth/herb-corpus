<% site_key = Rails.app.creds.option(:CLOUDFLARE_TURNSTILE_SITE_STEALTH_KEY) %>
<% raise KeyError, "CLOUDFLARE_TURNSTILE_SITE_STEALTH_KEY is required" if site_key.blank? %>
<% widget_id = "cf-turnstile-stealth-#{SecureRandom.hex(8)}" %>
<% response_id = "#{widget_id}-response" %>

<div data-controller="turnstile" data-turnstile-mode-value="execute">
  <div id="<%= widget_id %>" class="cf-turnstile" data-sitekey="<%= site_key %>" data-turnstile-target="container"></div>
  <input id="<%= response_id %>" type="hidden" name="cf-turnstile-response" autocomplete="off" data-turnstile-target="response" />
</div>

<% site_key = Rails.app.creds.option(:CLOUDFLARE_TURNSTILE_VISIBLE_SITE_KEY) %>
<% raise KeyError, "CLOUDFLARE_TURNSTILE_VISIBLE_SITE_KEY is required" if site_key.blank? %>
<% widget_id = "cf-turnstile-visible-#{SecureRandom.hex(8)}" %>
<% response_id = "#{widget_id}-response" %>
<% turnstile_action = local_assigns[:turnstile_action].presence %>
<% turnstile_cdata = local_assigns[:turnstile_cdata].presence %>
<% turnstile_data = {
     controller: "turnstile",
     turnstile_mode_value: "render",
     turnstile_action_value: turnstile_action,
     turnstile_cdata_value: turnstile_cdata,
   }.compact %>

<%= tag.div(data: turnstile_data) do %>
  <%= tag.div(
        id: widget_id,
        class: "cf-turnstile",
        data: {
          sitekey: site_key,
          action: turnstile_action,
          cdata: turnstile_cdata,
          turnstile_target: "container",
        }.compact,
      ) %>
  <input id="<%= response_id %>" type="hidden" name="cf-turnstile-response" autocomplete="off" data-turnstile-target="response" />
<% end %>

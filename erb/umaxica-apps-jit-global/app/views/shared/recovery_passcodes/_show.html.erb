<h1><%= t("sign.recovery_passcodes.show.title") %></h1>

<% if @recovery_passcodes.present? %>
  <p><%= t("sign.recovery_passcodes.show.description") %></p>
  <p><%= t("sign.recovery_passcodes.show.one_time_notice") %></p>
  <p><%= t("sign.recovery_passcodes.show.inventory_notice") %></p>
  <ul>
    <% @recovery_passcodes.each do |recovery_passcode| %>
      <li><code><%= recovery_passcode %></code></li>
    <% end %>
  </ul>
<% else %>
  <p><%= t("sign.recovery_passcodes.show.missing") %></p>
<% end %>

<%= link_to t("sign.recovery_passcodes.show.back_to_settings"), @back_to_settings_url %>

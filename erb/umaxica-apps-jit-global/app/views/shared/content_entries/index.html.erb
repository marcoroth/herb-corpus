<% page_title controller.send(:content_namespace).titleize %>

<main>
  <h1><%= controller.send(:content_namespace).titleize %></h1>
  <% if @content_entries.any? %>
    <ul>
        <% @content_entries.each do |entry| %>
          <li>
            <%= link_to entry.title,
                        url_for(
                          controller: params[:controller].to_s.sub(/roots\z/, "entries"),
                          action: :show,
                          id: entry.slug,
                          locale: entry.locale,
                        ) %>
          <% if entry.summary.present? %>
            <p><%= entry.summary %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No published content is available.</p>
  <% end %>
</main>

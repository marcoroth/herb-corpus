<% snapshot = @health_snapshot.as_public_json(namespace: @health_namespace) %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= display_meta_tags site: "#{ENV.fetch("BRAND_NAME").upcase} (#{brand_tld})", title: "Health", separator: "—", reverse: true %>
    <style nonce="<%= content_security_policy_nonce %>">
      body { color: #202124; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; line-height: 1.5; margin: 2rem; }
      main { max-width: 48rem; }
      dl { display: grid; grid-template-columns: max-content 1fr; gap: .5rem 1rem; }
      dt { font-weight: 700; }
      .checks { border-collapse: collapse; margin-top: 1rem; width: 100%; }
      .checks th, .checks td { border-bottom: 1px solid #d0d7de; padding: .5rem; text-align: left; }
    </style>
  </head>
  <body>
    <main>
      <h1>Health Snapshot</h1>
      <p>This page is a point-in-time health snapshot.</p>

      <dl>
        <dt>Status</dt>
        <dd><%= snapshot[:status] %></dd>
        <dt>Namespace</dt>
        <dd><%= snapshot[:namespace] %></dd>
        <dt>Generated at</dt>
        <dd><time datetime="<%= snapshot.dig(:details, :generated_at) %>"><%= snapshot.dig(:details, :generated_at) %></time></dd>
        <% if snapshot.dig(:details, :revision).present? %>
          <dt>Revision</dt>
          <dd><%= snapshot.dig(:details, :revision) %></dd>
        <% end %>
      </dl>

      <table class="checks">
        <thead>
          <tr>
            <th scope="col">Check</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          <% snapshot[:dependencies].each do |name, result| %>
            <tr>
              <td><%= name %></td>
              <td><%= result[:status] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </main>
  </body>
</html>

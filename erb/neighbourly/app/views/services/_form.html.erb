<%= form_with(model: @service, class: "admin-form space-y-6") do |form| %>
  <%= render "admin/form_errors", record: @service, noun: "service" %>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div class="min-w-0 space-y-2">
      <%= form.label :name, "Service name", class: "admin-label" %>
      <%= form.text_field :name, placeholder: "e.g. Community lunch", autofocus: true, class: "admin-input" %>
    </div>
    <div class="min-w-0 space-y-2">
      <% if current_user.admin? %>
        <%= form.label :organization_id, "Offered by", class: "admin-label" %>
        <%= form.collection_select :organization_id, Organization.alphabetical, :id, :name,
            { include_blank: "No organization" }, class: "admin-input" %>
      <% else %>
        <p class="admin-label">Offered by</p>
        <p class="flex min-h-11 items-center text-sm text-stone-900"><%= current_user.organization.name %></p>
      <% end %>
    </div>
  </div>

  <div class="space-y-2">
    <%= form.label :description, "What the service offers", class: "admin-label" %>
    <%= form.text_area :description, rows: 4, class: "admin-input" %>
  </div>

  <%= render "addresses/fields", form: form, record: @service %>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div class="min-w-0 space-y-2">
      <%= form.label :phone, "Phone", class: "admin-label" %>
      <%= form.telephone_field :phone, placeholder: "e.g. 250-555-0100", class: "admin-input" %>
    </div>
    <div class="min-w-0 space-y-2">
      <%= form.label :email, "Email", class: "admin-label" %>
      <%= form.email_field :email, placeholder: "e.g. info@example.org", class: "admin-input" %>
    </div>
    <div class="min-w-0 space-y-2">
      <%= form.label :website, "Website", class: "admin-label" %>
      <%= form.url_field :website, placeholder: "https://example.org", class: "admin-input" %>
    </div>
  </div>

  <div class="space-y-2">
    <%= form.label :hours, "Hours of operation", class: "admin-label" %>
    <%= form.text_field :hours, placeholder: "e.g. Mon-Fri 9am-5pm", class: "admin-input" %>
  </div>

  <fieldset class="min-w-0 space-y-3">
    <legend class="admin-label">Categories</legend>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      <%= form.collection_check_boxes :category_ids, Category.order(:name), :id, :name do |option| %>
        <%= option.label class: "flex min-h-11 cursor-pointer items-center gap-3 rounded-xl border border-stone-200 bg-white px-4 py-3 transition-colors hover:bg-stone-50 has-[:checked]:border-sage-600 has-[:checked]:bg-sage-50" do %>
          <%= option.check_box class: "admin-checkbox" %>
          <span class="min-w-0 break-words text-sm font-medium text-stone-800"><%= option.text %></span>
        <% end %>
      <% end %>
    </div>
  </fieldset>

  <%= form.label :closed, class: "flex min-h-11 cursor-pointer items-center gap-3" do %>
    <%= form.check_box :closed, class: "admin-checkbox" %>
    <span class="text-sm font-medium text-stone-800">This service is closed</span>
  <% end %>

  <div class="flex flex-wrap items-center gap-3 border-t border-stone-100 pt-6">
    <%= form.submit button_text, class: "admin-button-primary" %>
    <%= link_to "Cancel", cancel_path, class: "admin-button-secondary" %>
  </div>
<% end %>

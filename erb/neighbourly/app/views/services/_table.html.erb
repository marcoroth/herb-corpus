<%# Services as a table, so admins and members can scan and compare them. Headers
    sort the table when sortable is true. %>
<% sortable = local_assigns.fetch(:sortable, false) %>
<div class="admin-table-container" role="region" aria-label="Services" tabindex="0">
  <table class="admin-table">
    <caption class="sr-only">Services<%= ", sorted by #{sort_label(@sort)} #{@direction == "desc" ? "descending" : "ascending"}" if sortable %></caption>
    <thead>
      <tr>
        <% columns = [["Name", "name"], (["Offered by", "organization"] if show_organization), ["City", "city"], ["Phone", nil], ["Categories", nil], ["Confirmed", "confirmed"], ["Updated", "updated"]].compact %>
        <% columns.each do |label, column| %>
          <% if sortable && column %>
            <th scope="col" aria-sort="<%= service_sort_state(column) %>"><%= service_sort_link(label, column) %></th>
          <% else %>
            <th scope="col"><%= label %></th>
          <% end %>
        <% end %>
        <th scope="col"><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% services.each do |service| %>
        <tr>
          <td class="min-w-48">
            <%= link_to service.name, service, class: "admin-link font-medium" %>
            <% if service.closed? %>
              <span class="admin-badge ml-1 bg-stone-100 text-stone-600">CLOSED</span>
            <% end %>
          </td>
          <% if show_organization %>
            <td><%= service.organization&.name || "None" %></td>
          <% end %>
          <td><%= service.address&.city.presence || "—" %></td>
          <td class="whitespace-nowrap"><%= service.phone.presence || "—" %></td>
          <td><%= service.category_names.join(", ").presence || "—" %></td>
          <td class="whitespace-nowrap">
            <% if service.confirmed_at %>
              <time datetime="<%= service.confirmed_at.iso8601 %>"><%= service.confirmed_at.strftime("%b %d, %Y") %></time>
            <% else %>
              Never
            <% end %>
          </td>
          <td class="whitespace-nowrap"><time datetime="<%= service.updated_at.iso8601 %>"><%= service.updated_at.strftime("%b %d, %Y") %></time></td>
          <td class="text-right"><%= link_to "Edit", edit_service_path(service), class: "admin-button-secondary", aria: { label: "Edit #{service.name}" } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% content_for :title, "Services" %>
<% content_for :admin_actions do %>
  <%= link_to "Add service", new_service_path, class: "admin-button-primary" %>
<% end %>

<%= render "admin/page_header", title: "Services", description: "The services people can go to, and the organizations that offer them." %>

<% if @services.any? %>
  <%= render "table", services: @services, show_organization: current_user.admin?, sortable: true %>
<% else %>
  <p class="admin-empty-state">No services have been added yet.</p>
<% end %>

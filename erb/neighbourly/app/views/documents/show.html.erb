<% content_for :title, @document.title || "Resource" %>

<div class="md:w-2/3 w-full">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl"><%= @document.title %></h1>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_document_path(@document), class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
      <%= button_to "Delete", document_path(@document), method: :delete, class: "rounded-md px-3.5 py-2.5 bg-red-600 hover:bg-red-500 text-white inline-block font-medium cursor-pointer", data: { turbo_confirm: "Delete this resource?" } %>
    </div>
  </div>

  <div class="mt-6 bg-white shadow-sm rounded-lg border border-gray-200 divide-y divide-gray-200">
    <% if @document.metadata["description"].present? %>
      <div class="px-6 py-4">
        <dt class="text-sm font-medium text-gray-500">Description</dt>
        <dd class="mt-1 text-gray-900"><%= @document.metadata["description"] %></dd>
      </div>
    <% end %>

    <% if @document.metadata["city"].present? || @document.metadata["address"].present? %>
      <div class="px-6 py-4">
        <dt class="text-sm font-medium text-gray-500">Location</dt>
        <dd class="mt-1 text-gray-900">
          <%= @document.metadata["address"] %>
          <% if @document.metadata["address"].present? && @document.metadata["city"].present? %>, <% end %>
          <%= @document.metadata["city"] %>
        </dd>
      </div>
    <% end %>

    <% if @document.metadata["phone"].present? %>
      <div class="px-6 py-4">
        <dt class="text-sm font-medium text-gray-500">Phone</dt>
        <dd class="mt-1 text-gray-900"><%= Array(@document.metadata["phone"]).join(", ") %></dd>
      </div>
    <% end %>

    <% if @document.metadata["email"].present? %>
      <div class="px-6 py-4">
        <dt class="text-sm font-medium text-gray-500">Email</dt>
        <dd class="mt-1 text-gray-900"><%= @document.metadata["email"] %></dd>
      </div>
    <% end %>

    <% if @document.metadata["website"].present? %>
      <div class="px-6 py-4">
        <dt class="text-sm font-medium text-gray-500">Website</dt>
        <dd class="mt-1 text-gray-900"><%= link_to @document.metadata["website"], @document.metadata["website"], target: "_blank", class: "text-blue-600 hover:text-blue-500" %></dd>
      </div>
    <% end %>

    <% if @document.metadata["hours"].present? %>
      <div class="px-6 py-4">
        <dt class="text-sm font-medium text-gray-500">Hours of operation</dt>
        <dd class="mt-1 text-gray-900"><%= @document.metadata["hours"] %></dd>
      </div>
    <% end %>

    <% if @document.metadata["categories"].present? %>
      <div class="px-6 py-4">
        <dt class="text-sm font-medium text-gray-500">Categories</dt>
        <dd class="mt-1 text-gray-900"><%= Array(@document.metadata["categories"]).join(", ") %></dd>
      </div>
    <% end %>

    <% if @document.metadata["age_range"].present? %>
      <div class="px-6 py-4">
        <dt class="text-sm font-medium text-gray-500">Age range</dt>
        <dd class="mt-1 text-gray-900">
          <% ar = @document.metadata["age_range"] %>
          <% if ar["min"] && ar["max"] %>
            <%= ar["min"] %> - <%= ar["max"] %>
          <% elsif ar["min"] %>
            <%= ar["min"] %>+
          <% end %>
        </dd>
      </div>
    <% end %>

    <% if @document.metadata["gender"].present? %>
      <div class="px-6 py-4">
        <dt class="text-sm font-medium text-gray-500">Gender</dt>
        <dd class="mt-1 text-gray-900"><%= Array(@document.metadata["gender"]).join(", ") %></dd>
      </div>
    <% end %>

    <% if @document.metadata["notes"].present? %>
      <div class="px-6 py-4">
        <dt class="text-sm font-medium text-gray-500">Notes</dt>
        <dd class="mt-1 text-gray-900"><%= @document.metadata["notes"] %></dd>
      </div>
    <% end %>
  </div>

  <div class="mt-4">
    <%= link_to "Back to sources", sources_path, class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  </div>
</div>

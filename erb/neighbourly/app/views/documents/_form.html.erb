<%= form_with(model: @document, url: url, class: "contents",
    data: { controller: "submit-spinner", action: "submit->submit-spinner#submit" }) do |form| %>
  <% if @document.errors.any? %>
    <div class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(@document.errors.count, "error") %> prohibited this resource from being saved:</h2>
      <ul class="list-disc ml-6">
        <% @document.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :title, "Resource name" %>
    <%= form.text_field :title, value: @document.title || params.dig(:document, :title),
        placeholder: "e.g. Harbour Street Society", autofocus: true,
        class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :description, "Description of services" %>
    <%= form.text_area :description, value: @document.metadata&.dig("description") || params.dig(:document, :description),
        placeholder: "Describe the services offered by this resource...", rows: 4,
        class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-5">
    <div>
      <%= form.label :city, "City" %>
      <%= form.text_field :city, value: @document.metadata&.dig("city") || params.dig(:document, :city),
          placeholder: "e.g. Victoria",
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>
    <div>
      <%= form.label :address, "Street address" %>
      <%= form.text_field :address, value: @document.metadata&.dig("address") || params.dig(:document, :address),
          placeholder: "e.g. 100 Harbour St",
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-5">
    <div>
      <%= form.label :phone, "Phone number(s)" %>
      <span class="text-sm text-gray-500">Comma-separated if multiple</span>
      <%= form.text_field :phone, value: Array(@document.metadata&.dig("phone")).join(", "),
          placeholder: "e.g. 250-555-0100",
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>
    <div>
      <%= form.label :email, "Email" %>
      <%= form.email_field :email, value: @document.metadata&.dig("email") || params.dig(:document, :email),
          placeholder: "e.g. info@example.org",
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>
    <div>
      <%= form.label :website, "Website" %>
      <%= form.url_field :website, value: @document.metadata&.dig("website") || params.dig(:document, :website),
          placeholder: "e.g. https://example.org",
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>
  </div>

  <div class="my-5">
    <%= form.label :hours, "Hours of operation" %>
    <%= form.text_field :hours, value: @document.metadata&.dig("hours") || params.dig(:document, :hours),
        placeholder: "e.g. Mon-Fri 9am-5pm, Sat 10am-2pm",
        class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :categories, "Categories" %>
    <span class="text-sm text-gray-500">Comma-separated, e.g. shelter, food, counselling</span>
    <%= form.text_field :categories, value: Array(@document.metadata&.dig("categories")).join(", "),
        placeholder: "e.g. shelter, meals, clothing",
        class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-5">
    <div>
      <%= form.label :age_min, "Minimum age" %>
      <%= form.number_field :age_min, value: @document.metadata&.dig("age_range", "min") || params.dig(:document, :age_min),
          placeholder: "e.g. 19", min: 0,
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>
    <div>
      <%= form.label :age_max, "Maximum age" %>
      <%= form.number_field :age_max, value: @document.metadata&.dig("age_range", "max") || params.dig(:document, :age_max),
          placeholder: "e.g. 65", min: 0,
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>
    <div>
      <%= form.label :gender, "Gender" %>
      <span class="text-sm text-gray-500">Comma-separated if multiple</span>
      <%= form.text_field :gender, value: Array(@document.metadata&.dig("gender")).join(", "),
          placeholder: "e.g. all, male, female",
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>
  </div>

  <div class="my-5">
    <%= form.label :notes, "Additional notes" %>
    <%= form.text_area :notes, value: @document.metadata&.dig("notes") || params.dig(:document, :notes),
        placeholder: "Any other relevant information...", rows: 3,
        class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="inline flex items-center gap-3">
    <%= form.submit button_text,
        data: { submit_spinner_target: "button" },
        class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
    <span data-submit-spinner-target="spinner" class="hidden items-center gap-2 text-sm text-gray-600">
      <svg class="animate-spin h-5 w-5 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
      </svg>
      Processing, this may take a moment...
    </span>
  </div>
<% end %>

<% content_for :title, "Users" %>

<div class="space-y-6">
  <!-- Header -->
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold text-stone-900">Users</h1>
      <p class="mt-1 text-sm text-stone-600">Manage user accounts</p>
    </div>
  </div>

  <!-- Users List -->
  <div class="bg-white shadow-sm rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-stone-200">
      <thead class="bg-stone-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-stone-700 uppercase tracking-wider">
            Email
          </th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-stone-700 uppercase tracking-wider">
            Role
          </th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-stone-700 uppercase tracking-wider">
            Chats
          </th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-stone-700 uppercase tracking-wider">
            Joined
          </th>
          <th scope="col" class="relative px-6 py-3">
            <span class="sr-only">Actions</span>
          </th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-stone-200">
        <% @users.each do |user| %>
          <tr class="hover:bg-stone-50 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div class="text-sm font-medium text-stone-900">
                  <%= user.email %>
                  <% if user == current_user %>
                    <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                      You
                    </span>
                  <% end %>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% if user.admin? %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-sage-100 text-sage-800">
                  Admin
                </span>
              <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-stone-100 text-stone-800">
                  User
                </span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-stone-600">
              <%= user.chats.count %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-stone-600">
              <%= user.created_at.strftime("%b %d, %Y") %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <%= link_to "View", user, class: "text-sage-600 hover:text-sage-900 mr-4" %>
              <%= link_to "Edit", edit_user_path(user), class: "text-stone-600 hover:text-stone-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% content_for :title, "Edit User" %>

<div class="space-y-6">
  <!-- Header -->
  <div>
    <h1 class="text-3xl font-bold text-stone-900">Edit User</h1>
    <p class="mt-1 text-sm text-stone-600">Update user account settings</p>
  </div>

  <!-- Form -->
  <div class="bg-white shadow-sm rounded-lg p-6">
    <%= form_with(model: @user, class: "space-y-6") do |form| %>
      <% if @user.errors.any? %>
        <div class="rounded-md bg-red-50 border border-red-200 p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-red-600" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-red-800">
                <%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:
              </h3>
              <div class="mt-2 text-sm text-red-700">
                <ul class="list-disc pl-5 space-y-1">
                  <% @user.errors.each do |error| %>
                    <li><%= error.full_message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <div>
        <%= form.label :email, "Email", class: "block text-sm font-medium text-stone-900 mb-2" %>
        <%= form.email_field :email, class: "block w-full rounded-md border-stone-300 shadow-sm focus:border-sage-500 focus:ring-sage-500 text-stone-900 placeholder-stone-400 bg-white sm:text-sm px-4 py-3", placeholder: "user@example.com" %>
      </div>

      <div class="flex items-start">
        <div class="flex items-center h-5">
          <%= form.check_box :admin, class: "h-4 w-4 text-sage-600 focus:ring-sage-500 border-stone-300 rounded" %>
        </div>
        <div class="ml-3 text-sm">
          <%= form.label :admin, class: "font-medium text-stone-900" %>
          <p class="text-stone-500">Grant this user administrator privileges</p>
        </div>
      </div>

      <div class="flex justify-end space-x-3 pt-4 border-t border-stone-200">
        <%= link_to "Cancel", @user, class: "inline-flex items-center px-4 py-2 border border-stone-300 text-sm font-medium rounded-md text-stone-700 bg-white hover:bg-stone-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sage-500 transition-colors" %>
        <%= form.submit "Update User", class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-sage-600 hover:bg-sage-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sage-500 transition-colors" %>
      </div>
    <% end %>
  </div>
</div>

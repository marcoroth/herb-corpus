<% content_for :title, "Organizations" %>
<% if policy(Organization).create? %>
  <% content_for :admin_actions do %>
    <%= link_to "Add organization", new_organization_path, class: "admin-button-primary" %>
  <% end %>
<% end %>

<%= render "admin/page_header", title: "Organizations", description: "The groups that offer services, and what each one runs." %>

<% if @organizations.any? %>
  <div class="space-y-4">
    <% @organizations.each do |organization| %>
      <article class="admin-panel flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
        <div class="min-w-0 space-y-2">
          <%= link_to organization.name, organization, class: "admin-link text-base" %>
          <p class="text-sm text-stone-500"><%= pluralize(@service_counts.fetch(organization.id, 0), "service") %></p>
        </div>
        <div class="flex shrink-0 flex-wrap items-center gap-2">
          <%= link_to "Edit", edit_organization_path(organization), class: "admin-button-secondary" %>
        </div>
      </article>
    <% end %>
  </div>
<% else %>
  <p class="admin-empty-state">No organizations have been added yet.</p>
<% end %>

<% content_for :title, "Upload Source" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Upload Source</h1>

  <%= form_with(model: @source, url: sources_path, class: "contents", multipart: true,
      data: { controller: "submit-spinner", action: "submit->submit-spinner#submit" }) do |form| %>
    <% if @source.errors.any? %>
      <div class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
        <h2><%= pluralize(@source.errors.count, "error") %> prohibited this source from being saved:</h2>
        <ul class="list-disc ml-6">
          <% @source.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="my-5">
      <%= form.label :name, "Source name" %>
      <%= form.text_field :name, placeholder: "e.g. BC 211 Shelters", autofocus: true,
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :url, "Origin URL", class: "block font-medium" %>
      <span class="text-sm text-gray-500">A reference URL for this data source (used for deduplication)</span>
      <%= form.text_field :url, placeholder: "https://example.com/data",
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :source_type, "Data type" %>
      <%= form.select :source_type,
          options_for_select([["JSON (structured API data)", "api"], ["HTML (web page)", "html"]]),
          {},
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :css_selector, "CSS selector (HTML only)" %>
      <span class="text-sm text-gray-500">Optional. Targets specific content on the page, e.g. <code>main.content</code></span>
      <%= form.text_field :css_selector, placeholder: "e.g. .main-content, article",
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :file, "Upload file" %>
      <span class="text-sm text-gray-500">Upload a .json or .html file to ingest</span>
      <%= form.file_field :file, accept: ".json,.html,.htm",
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="inline flex items-center gap-3">
      <%= form.submit "Upload and ingest",
          data: { submit_spinner_target: "button" },
          class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
      <span data-submit-spinner-target="spinner" class="hidden items-center gap-2 text-sm text-gray-600">
        <svg class="animate-spin h-5 w-5 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
        Processing, this may take a moment...
      </span>
    </div>
  <% end %>

  <%= link_to "Back to sources", sources_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>

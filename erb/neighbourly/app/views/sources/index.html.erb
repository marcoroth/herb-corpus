<% content_for :title, "Sources" %>

<div class="w-full">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Sources</h1>
    <div class="flex gap-2">
      <%= link_to "Add resource", new_document_path, class: "rounded-md px-3.5 py-2.5 bg-sage-600 hover:bg-sage-700 text-white block font-medium" %>
      <%= link_to "Upload source", new_source_path, class: "rounded-md px-3.5 py-2.5 bg-sage-600 hover:bg-sage-700 text-white block font-medium" %>
    </div>
  </div>

  <div class="min-w-full divide-y divide-gray-200 mt-5">
    <% if @sources.any? || @documents.any? %>
      <% @sources.each do |source| %>
        <div class="flex flex-col sm:flex-row justify-between items-center py-4">
          <div class="w-full sm:w-auto space-y-1">
            <div>
              <%= link_to source.name, source, class: "font-medium text-blue-600 hover:text-blue-500" %>
              <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                <%= source.source_type.upcase %>
              </span>
            </div>
            <% if source.url.present? %>
              <div class="text-sm text-gray-500"><%= source.url %></div>
            <% end %>
            <div class="text-sm text-gray-500">
              <%= pluralize(source.documents.count, "document") %>
              <% if source.last_fetched_at %>
                &middot; Last ingested <%= time_ago_in_words(source.last_fetched_at) %> ago
              <% end %>
            </div>
          </div>
          <div class="w-full sm:w-auto mt-2 sm:mt-0">
            <%= button_to "Delete", source_path(source), method: :delete, class: "rounded-md px-3.5 py-2.5 bg-red-600 hover:bg-red-500 text-white inline-block font-medium cursor-pointer", data: { turbo_confirm: "Delete source '#{source.name}' and all its documents?" } %>
          </div>
        </div>
      <% end %>

      <% @documents.each do |document| %>
        <div class="flex flex-col sm:flex-row justify-between items-center py-4">
          <div class="w-full sm:w-auto space-y-1">
            <div>
              <%= link_to document.title || "Untitled", document, class: "font-medium text-blue-600 hover:text-blue-500" %>
              <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                FORM
              </span>
            </div>
            <div class="text-sm text-gray-500">
              <% if document.metadata["city"].present? %>
                <%= document.metadata["city"] %>
              <% end %>
              <% if document.metadata["categories"].present? %>
                <% if document.metadata["city"].present? %>&middot;<% end %>
                <%= Array(document.metadata["categories"]).join(", ") %>
              <% end %>
            </div>
            <div class="text-sm text-gray-500">
              Added <%= time_ago_in_words(document.created_at) %> ago
            </div>
          </div>
          <div class="w-full sm:w-auto mt-2 sm:mt-0 flex gap-2">
            <%= link_to "Edit", edit_document_path(document), class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
            <%= button_to "Delete", document_path(document), method: :delete, class: "rounded-md px-3.5 py-2.5 bg-red-600 hover:bg-red-500 text-white inline-block font-medium cursor-pointer", data: { turbo_confirm: "Delete resource '#{document.title}'?" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10 text-gray-500">No sources have been added yet.</p>
    <% end %>
  </div>
</div>

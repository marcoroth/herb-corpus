<% content_for :title, "Moderation" %>

<div class="w-full">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="font-bold text-4xl">Moderation</h1>
      <p class="mt-1 text-sm text-stone-600">Review document reports from users</p>
    </div>
  </div>

  <div class="bg-white shadow-sm rounded-lg overflow-hidden mt-5">
    <% if @reports.any? %>
      <table class="min-w-full divide-y divide-stone-200">
        <thead class="bg-stone-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-stone-700 uppercase tracking-wider">Document</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-stone-700 uppercase tracking-wider">Reporter</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-stone-700 uppercase tracking-wider">Reason</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-stone-700 uppercase tracking-wider">Details</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-stone-700 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-stone-700 uppercase tracking-wider">Date</th>
            <th class="relative px-6 py-3"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-stone-200">
          <% @reports.each do |report| %>
            <tr class="hover:bg-stone-50 transition-colors">
              <td class="px-6 py-4 text-sm">
                <div class="text-stone-900 font-medium"><%= report.document.title || "Untitled" %></div>
                <%= link_to report.document.source.name, source_path(report.document.source), class: "text-xs text-blue-600 hover:text-blue-800" %>
              </td>
              <td class="px-6 py-4 text-sm text-stone-600">
                <%= report.user&.email || "Anonymous" %>
              </td>
              <td class="px-6 py-4 text-sm text-stone-600">
                <%= report.reason.capitalize %>
              </td>
              <td class="px-6 py-4 text-sm text-stone-600 max-w-xs truncate">
                <%= report.details.presence || "—" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% case report.status %>
                <% when "pending" %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Pending</span>
                <% when "valid" %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Removed</span>
                <% when "dismissed" %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-stone-100 text-stone-800">Dismissed</span>
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm text-stone-600 whitespace-nowrap">
                <%= report.created_at.strftime("%b %d, %Y") %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <% if report.pending? %>
                  <div class="flex gap-2 justify-end">
                    <%= button_to "Accept removal",
                          validate_report_path(report),
                          method: :patch,
                          class: "rounded-md px-3 py-1.5 bg-red-600 hover:bg-red-500 text-white text-xs font-medium cursor-pointer",
                          data: { turbo_confirm: "This will remove '#{report.document.title}' from search results. Continue?" } %>
                    <%= button_to "Dismiss",
                          dismiss_report_path(report),
                          method: :patch,
                          class: "rounded-md px-3 py-1.5 bg-stone-100 hover:bg-stone-50 text-stone-700 text-xs font-medium cursor-pointer",
                          data: { turbo_confirm: "Dismiss this report?" } %>
                  </div>
                <% end %>
              </td>
            </tr>
            <tr class="bg-stone-50/50">
              <td colspan="7" class="px-6 py-3">
                <details>
                  <summary class="text-xs font-medium text-stone-500 cursor-pointer hover:text-stone-700">Flagged content</summary>
                  <div class="mt-2 p-3 bg-white border border-stone-200 rounded text-sm text-stone-700 whitespace-pre-line max-h-48 overflow-y-auto"><%= report.document.content %></div>
                </details>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-center my-10 text-gray-500">No reports have been submitted.</p>
    <% end %>
  </div>
</div>

<%# Location fields for a record with one address, as nested address attributes. %>
<fieldset class="min-w-0 space-y-4">
  <legend class="admin-label">Location</legend>
  <%= form.fields_for :address, record.address || record.build_address do |address| %>
    <div class="space-y-2">
      <%= address.label :street_address, "Street address", class: "admin-label" %>
      <%= address.text_field :street_address, placeholder: "e.g. 100 Harbour St", class: "admin-input" %>
    </div>
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-4">
      <div class="min-w-0 space-y-2">
        <%= address.label :city, "City", class: "admin-label" %>
        <%= address.text_field :city, placeholder: "e.g. Victoria", class: "admin-input" %>
      </div>
      <div class="min-w-0 space-y-2">
        <%= address.label :province, "Province or state", class: "admin-label" %>
        <%= address.text_field :province, placeholder: "e.g. BC", class: "admin-input" %>
      </div>
      <div class="min-w-0 space-y-2">
        <%= address.label :postal_code, "Postal code", class: "admin-label" %>
        <%= address.text_field :postal_code, placeholder: "e.g. V8W 1A1", class: "admin-input" %>
      </div>
      <div class="min-w-0 space-y-2">
        <%= address.label :country, "Country", class: "admin-label" %>
        <%= address.text_field :country, placeholder: "e.g. Canada", class: "admin-input" %>
      </div>
    </div>
  <% end %>
</fieldset>

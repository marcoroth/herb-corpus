<% content_for :title, "Make a printable flyer" %>

<div class="w-full max-w-3xl mx-auto">
  <h1 class="font-bold text-4xl text-stone-900">Make a printable flyer</h1>
  <p class="mt-2 text-stone-600">
    Choose the kinds of help you want listed, and we'll put together a flyer you can print and hand out.
  </p>

  <%= form_with model: @flyer, url: flyers_path, scope: :flyer, class: "mt-8",
        data: { turbo: false, controller: "submit-spinner", action: "submit->submit-spinner#submit" } do |form| %>
    <% if @flyer.errors.any? %>
      <div id="error_explanation" class="bg-red-50 text-red-600 px-3 py-2 font-medium rounded-md mb-5">
        <ul class="list-disc ml-6">
          <% @flyer.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <fieldset>
      <legend class="text-base font-semibold text-stone-900">What should the flyer include?</legend>
      <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
        <%= form.collection_check_boxes :categories, Flyer.available_categories, :first, :last do |option| %>
          <%= option.label class: "flex items-center gap-3 rounded-lg border border-stone-300 bg-white px-4 py-3 cursor-pointer hover:bg-stone-50 has-[:checked]:border-sage-600 has-[:checked]:bg-sage-50 transition-colors" do %>
            <%= option.check_box class: "h-4 w-4 rounded border-stone-400 text-sage-600 focus:ring-sage-500" %>
            <span class="text-sm font-medium text-stone-800"><%= option.text %></span>
          <% end %>
        <% end %>
      </div>
    </fieldset>

    <div class="mt-8 flex items-center gap-3">
      <%= form.submit "Generate flyer",
          data: { submit_spinner_target: "button" },
          class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-sage-600 hover:bg-sage-700 text-white inline-block font-medium cursor-pointer" %>
      <span data-submit-spinner-target="spinner" class="hidden items-center gap-2 text-sm text-gray-600">
        <svg class="animate-spin h-5 w-5 text-sage-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
        Making your flyer...
      </span>
    </div>
  <% end %>
</div>

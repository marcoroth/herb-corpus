<% content_for :title, "Neighbourly Resources" %>

<div class="flex flex-col items-center justify-center py-16 sm:py-24">
  <div class="text-center max-w-2xl mx-auto">
    <h1 class="text-4xl sm:text-5xl font-bold text-stone-900 tracking-tight">
      Neighbourly Resources
    </h1>
    <p class="mt-6 text-lg text-stone-600 leading-relaxed">
      An AI-powered assistant that helps you find community resources like shelters, meal programs, and support services in your area.
    </p>
    <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
      <% if user_signed_in? %>
        <%= link_to "What do you need, neighbour?", new_chat_path, class: "inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-sage-600 hover:bg-sage-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sage-500 transition-colors" %>
      <% else %>
        <%= link_to "Get started", new_user_registration_path, class: "inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-sage-600 hover:bg-sage-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sage-500 transition-colors" %>
        <%= link_to "Sign in", new_user_session_path, class: "inline-flex items-center justify-center px-6 py-3 border border-stone-300 text-base font-medium rounded-md text-stone-700 bg-white hover:bg-stone-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sage-500 transition-colors" %>
      <% end %>
    </div>
  </div>

  <div class="mt-20 grid grid-cols-1 sm:grid-cols-3 gap-8 max-w-4xl mx-auto">
    <div class="text-center px-4">
      <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-sage-100 text-sage-700">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 0 1-.825-.242m9.345-8.334a2.126 2.126 0 0 0-.476-.095 48.64 48.64 0 0 0-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0 0 11.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" />
        </svg>
      </div>
      <h3 class="mt-4 text-base font-semibold text-stone-900">Ask in plain language</h3>
      <p class="mt-2 text-sm text-stone-600">Describe what you need and get relevant results from verified community resources.</p>
    </div>

    <div class="text-center px-4">
      <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-sage-100 text-sage-700">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0 0 12 9.75c-2.551 0-5.056.2-7.5.582V21" />
        </svg>
      </div>
      <h3 class="mt-4 text-base font-semibold text-stone-900">Local organizations</h3>
      <p class="mt-2 text-sm text-stone-600">Information sourced from shelters, food banks, health centres, and other community services.</p>
    </div>

    <div class="text-center px-4">
      <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-sage-100 text-sage-700">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
        </svg>
      </div>
      <h3 class="mt-4 text-base font-semibold text-stone-900">Community moderated</h3>
      <p class="mt-2 text-sm text-stone-600">Users can flag outdated or incorrect information to keep results accurate and trustworthy.</p>
    </div>
  </div>
</div>

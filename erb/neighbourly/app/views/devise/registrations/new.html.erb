<div class="flex items-center justify-center py-8">
  <div class="max-w-md w-full space-y-6">
    <div>
      <h2 class="text-center text-3xl font-bold text-stone-900">
        Create your account
      </h2>
      <p class="mt-2 text-center text-sm text-stone-600">
        Join Neighbourly Resources today
      </p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "mt-6 space-y-6" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="rounded-md shadow-sm space-y-4">
        <div>
          <%= f.label :email, "Email address", class: "block text-sm font-medium text-stone-900 mb-2" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "appearance-none relative block w-full px-4 py-3 border border-stone-300 placeholder-stone-400 text-stone-900 rounded-md focus:outline-none focus:ring-sage-500 focus:border-sage-500 focus:z-10 sm:text-sm bg-white", placeholder: "you@example.com" %>
        </div>

        <div>
          <%= f.label :password, "Password", class: "block text-sm font-medium text-stone-900 mb-2" %>
          <% if @minimum_password_length %>
            <p class="text-xs text-stone-500 mb-2"><%= @minimum_password_length %> characters minimum</p>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password", class: "appearance-none relative block w-full px-4 py-3 border border-stone-300 placeholder-stone-400 text-stone-900 rounded-md focus:outline-none focus:ring-sage-500 focus:border-sage-500 focus:z-10 sm:text-sm bg-white", placeholder: "Create a password" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-stone-900 mb-2" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "appearance-none relative block w-full px-4 py-3 border border-stone-300 placeholder-stone-400 text-stone-900 rounded-md focus:outline-none focus:ring-sage-500 focus:border-sage-500 focus:z-10 sm:text-sm bg-white", placeholder: "Confirm your password" %>
        </div>
      </div>

      <div>
        <%= f.submit "Sign up", class: "group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-sage-600 hover:bg-sage-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sage-500 transition-colors" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>

<div class="flex items-center justify-center py-8">
  <div class="max-w-md w-full space-y-6">
    <div>
      <h2 class="text-center text-3xl font-bold text-stone-900">
        Sign in to your account
      </h2>
      <p class="mt-2 text-center text-sm text-stone-600">
        Welcome back to Neighbourly Resources
      </p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-6 space-y-6" }) do |f| %>
      <div class="rounded-md shadow-sm space-y-4">
        <div>
          <%= f.label :email, "Email address", class: "block text-sm font-medium text-stone-900 mb-2" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "appearance-none relative block w-full px-4 py-3 border border-stone-300 placeholder-stone-400 text-stone-900 rounded-md focus:outline-none focus:ring-sage-500 focus:border-sage-500 focus:z-10 sm:text-sm bg-white", placeholder: "you@example.com" %>
        </div>

        <div>
          <%= f.label :password, "Password", class: "block text-sm font-medium text-stone-900 mb-2" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "appearance-none relative block w-full px-4 py-3 border border-stone-300 placeholder-stone-400 text-stone-900 rounded-md focus:outline-none focus:ring-sage-500 focus:border-sage-500 focus:z-10 sm:text-sm bg-white", placeholder: "Enter your password" %>
        </div>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center">
          <%= f.check_box :remember_me, class: "h-4 w-4 text-sage-600 focus:ring-sage-500 border-stone-300 rounded" %>
          <%= f.label :remember_me, class: "ml-2 block text-sm text-stone-700" %>
        </div>
      <% end %>

      <div>
        <%= f.submit "Sign in", class: "group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-sage-600 hover:bg-sage-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sage-500 transition-colors" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>

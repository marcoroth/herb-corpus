<div id="message_<%= message.id %>_rag_context">
  <% if message.rag_documents.any? %>
    <details class="mt-2 rounded border border-gray-200 bg-white">
      <summary class="cursor-pointer px-3 py-1.5 text-xs font-medium text-gray-500 hover:text-gray-700">
        Sources (<%= message.rag_documents.size %>)
      </summary>
      <div class="divide-y divide-gray-100 px-3 pb-2">
        <% message.rag_documents.includes(:source).each do |doc| %>
          <div class="py-2" data-controller="dialog">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <p class="text-xs font-medium text-gray-700"><%= doc.title %></p>
                <p class="text-xs text-gray-500">Source: <%= doc.source.name %></p>
                <p class="text-xs text-gray-400"><%= doc.source.url %></p>
              </div>
              <% if local_assigns.fetch(:show_report_button, false) %>
                <button type="button"
                        data-action="dialog#open"
                        class="ml-2 text-xs text-stone-400 hover:text-red-600 transition-colors cursor-pointer"
                        title="Report this document">
                  Report
                </button>
              <% end %>
            </div>
            <p class="mt-1 text-xs text-gray-600 whitespace-pre-wrap"><%= doc.content %></p>

            <% if local_assigns.fetch(:show_report_button, false) %>
              <dialog data-dialog-target="dialog"
                      data-action="click->dialog#clickOutside"
                      class="rounded-lg shadow-xl border border-stone-200 p-0 backdrop:bg-black/50 w-full max-w-md">
                <div class="p-6">
                  <h3 class="text-lg font-semibold text-stone-900 mb-1">Report Document</h3>
                  <p class="text-sm text-stone-500 mb-4">
                    Reporting: <span class="font-medium"><%= doc.title %></span>
                  </p>

                  <%= form_with url: reports_path, scope: :report, method: :post, class: "space-y-4" do |f| %>
                    <%= f.hidden_field :document_id, value: doc.id %>

                    <fieldset>
                      <legend class="text-sm font-medium text-stone-700 mb-2">Reason for reporting</legend>
                      <div class="space-y-2">
                        <% Report::REASONS.each do |reason| %>
                          <label class="flex items-center space-x-2 cursor-pointer">
                            <input type="radio" name="report[reason]" value="<%= reason %>"
                                   class="text-sage-600 focus:ring-sage-500" required>
                            <span class="text-sm text-stone-700"><%= reason.capitalize %></span>
                          </label>
                        <% end %>
                      </div>
                    </fieldset>

                    <div>
                      <%= f.label :details, "Additional details (optional)", class: "block text-sm font-medium text-stone-700 mb-1" %>
                      <%= f.text_area :details, rows: 3,
                          class: "w-full rounded-md border border-stone-300 shadow-sm focus:outline-sage-500 text-sm px-3 py-2",
                          placeholder: "Provide any additional context..." %>
                    </div>

                    <div class="flex justify-end space-x-3 pt-2">
                      <button type="button"
                              data-action="dialog#close"
                              class="px-4 py-2 text-sm font-medium text-stone-700 bg-white border border-stone-300 rounded-md hover:bg-stone-50 transition-colors cursor-pointer">
                        Cancel
                      </button>
                      <button type="submit"
                              class="px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-md hover:bg-red-500 transition-colors cursor-pointer">
                        Submit Report
                      </button>
                    </div>
                  <% end %>
                </div>
              </dialog>
            <% end %>
          </div>
        <% end %>
      </div>
    </details>
  <% end %>
</div>

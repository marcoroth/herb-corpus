<div class="relative inline-flex" data-controller="ui--dropdown">
  <%= tag.button(**button_attributes) do %>
    <span class="sr-only">Open <%= @name %> menu</span>
    <%= button_content %>

    <span class="twdropdown-chevron inline-block transition-transform duration-200">
      <%= render UI::IconChevron::Component.new(direction: :down) %>
    </span>
  <% end %>

  <%#
    The menu is absolute inside a wrapper only as wide as the button, so without
    w-max it shrink-to-fits to that and long entries wrap. 75vw so a long one
    can't run off the screen instead.
  %>

  <div
    class="
      absolute top-0 left-0 hidden w-max max-w-[75vw]
      min-w-44 rounded-lg border border-gray-200 bg-white
      shadow-lg dark:border-gray-700 dark:bg-gray-800
    "
    data-ui--dropdown-target="menu"
  >
    <ul role="menu" class="twdropdown" aria-labelledby="<%= button_id %>">
      <% entries.each do |entry| %>
        <%= entry %>
      <% end %>
    </ul>
  </div>
</div>

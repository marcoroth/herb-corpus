<%= tag.div(class: [("hidden!" unless @field_name), "border-b border-gray-100 bg-gray-50 px-5 py-5 dark:border-gray-700 dark:bg-gray-800"],
  data: panel_data) do %>
  <div class="mb-5 flex flex-wrap items-baseline gap-x-3 gap-y-2">
    <%= render(UI::Header::Component.new(text: @field_name ? "Included columns" : "Visible columns",
      tag: :h3, html_class: "uncap mb-0! pr-1")) %>

    <%= render(UI::Button::Component.new(text: "all", color: :link, data: {action: "ui--table-column-settings#selectAll"})) %>
    <%= render(UI::Button::Component.new(text: "none", color: :link, data: {action: "ui--table-column-settings#selectNone"})) %>
    <%= render(UI::Button::Component.new(text: "default", color: :link, data: {action: "ui--table-column-settings#selectDefault"})) %>
  </div>

  <% column_groups.each do |heading, columns| %>
    <% if heading %>
      <%= render(UI::Header::Component.new(text: heading, tag: :h3, html_class: "uncap mt-7 mb-5!")) %>
    <% end %>

    <div
      class="grid grid-cols-2 gap-x-7 gap-y-2.5 md:grid-flow-col md:grid-cols-3"
      style="grid-template-rows: repeat(<%= column_rows(columns) %>, auto)"
    >
      <% columns.each do |key, label| %>
        <%# Unchecked columns read quieter than the ones showing %>
        <%= render(UI::Forms::Checkbox::Component.new(name: @field_name || key, value: key,
          checked: @always_visible.include?(key) || @checked.include?(key), label: checkbox_label(key, label),
          class_name: "mb-0! leading-[1.25]! text-gray-400 has-checked:text-gray-900 dark:has-checked:text-gray-100",
          html_options: checkbox_html_options(key))) %>
      <% end %>
    </div>
  <% end %>

  <% if @orderable %>
    <%# Shown by a ui--table-column-order while either button applies %>
    <div
      class="flex hidden! items-baseline gap-x-2 pt-5"
      data-ui--table-column-order-target="actions"
    >
      <%= render(UI::Button::Component.new(text: "Return to default column order", color: :link, html_class: "-mb-2",
          data: {action: "ui--table-column-order#reset", "ui--table-column-order-target": "reset"})) %>

      <% if @copy_order_from %>
        <span
          class="text-gray-400"
          aria-hidden="true"
          data-ui--table-column-order-target="separator"
        >
          ·
        </span>
        <%= render(UI::Button::Component.new(text: @copy_order_from[:label], color: :link, html_class: "-mb-2",
            data: {action: "ui--table-column-order#copy", "ui--table-column-order-target": "copy",
                   storage_key: self.class.order_storage_key(@copy_order_from[:storage_key])})) %>
      <% end %>
    </div>
  <% end %>
<% end %>

<div data-controller="ui--collapse" data-ui--collapse-param-value="details">
  <%= render UI::Collapse::Component.new(text: "Toggle details", chevron: true, color: :link) %>

  <div data-ui--collapse-target="content" class="mt-2 hidden">
    <div
      class="
        flex h-64 flex-col items-center justify-between
        rounded-lg bg-gray-100 p-4 text-center
        dark:bg-gray-800
      "
    >
      <p class="mb-0">
        Persisted panel body — open state lives in the
        <%= render(UI::Code::Inline::Component.new(text: "?details=1")) %> URL
        param. Lookbook frames this page, so the param lands on the frame's own
        URL: open the preview in its own window to watch the address bar.
      </p>

      <label class="mb-0 flex items-center gap-2">
        <%= check_box_tag :panel_checkbox, "1", false %> Panel checkbox
      </label>
    </div>
  </div>

  <%# Tall enough that the opening panel reaches over it - what the spec's clipping check reads %>
  <div
    id="below"
    class="
      mt-2 flex h-96 items-center justify-center
      rounded-lg border border-dashed border-gray-300
      text-gray-500 dark:border-gray-700
    "
  >
    Content the panel pushes down as it opens
  </div>
</div>

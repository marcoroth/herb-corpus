<div
  data-controller="sortable"
  class="max-w-md divide-y divide-gray-200 rounded border border-gray-200"
>
  <% ["First item", "Second item", "Third item"].each do |label| %>
    <div data-sortable-target="item" class="flex items-center gap-3 p-3">
      <%= render UI::DragHandle::Component.new(controller: "sortable", label:) %>
      <span><%= label %></span>
    </div>
  <% end %>
</div>

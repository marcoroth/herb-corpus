<% @items.each_with_index do |(question, answer), index| %>
  <div
    class="border-b border-gray-200 py-4 dark:border-gray-700"
    data-controller="ui--collapse"
  >
    <%= render(UI::Collapse::Component.new(chevron: true, color: :link,
      html_class: "w-full gap-2 text-[17.5px] font-bold twtext-color")) do %>
      <span class="flex-1 text-left"><%= question %></span>
    <% end %>

    <div
      data-ui--collapse-target="content"
      class="<%= "hidden" unless index.zero? %>"
    >
      <p class="m-0 mt-2.5 pr-11 text-base leading-relaxed">
        <%= answer %>
      </p>
    </div>
  </div>
<% end %>

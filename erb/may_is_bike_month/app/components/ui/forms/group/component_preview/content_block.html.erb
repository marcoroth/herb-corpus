<%# A content block renders in place of the input -- here an email field. %>
<%= form_with(scope: :user, url: "#", builder: MayIsBikeMonthFormBuilder) do |f| %>
  <%= render(UI::Forms::Group::Component.new(form_builder: f, attribute: :email)) do %>
    <%= render(UI::Forms::Email::Component.new(form_builder: f)) %>
  <% end %>
<% end %>

<% if @term == :left_align %>
  <% if @multi_columns %>
    <div class="@container w-full">
      <dl class="@container gap-x-4 break-words @md:grid @md:grid-cols-2">
        <%= content %>
      </dl>
    </div>
  <% else %>
    <dl class="@container break-words"><%= content %></dl>
  <% end %>
<% else %>
  <dl class="<%= dl_classes %>"><%= content %></dl>
<% end %>

<div
  class="flow-root rounded-sm border p-4 transition-all duration-300 <%= @margin_classes %> <%= color_classes %>"
  role="alert"
  data-controller="ui--alert"
>
  <div class="float-left mr-2 flex w-4 items-center <%= icon_classes %>">
    <% if @icon.present? %>
      <%= @icon %>
    <% else %>
      <%= helpers.inline_svg_tag(default_icon, class: "h-4 w-4", aria_hidden: true) %>
    <% end %>

    <span class="sr-only"><%= announcement %></span>
  </div>

  <% if @dismissable %>
    <button
      type="button"
      class="float-right -my-1.5 -mr-1.5 ml-4 inline-flex h-8 w-8 items-center justify-center rounded-sm p-1.5 focus:ring-2 <%= dismissable_color_classes %>"
      aria-label="Close"
      data-action="click->ui--alert#close"
    >
      <span class="sr-only">Close</span>

      <%= helpers.inline_svg_tag("icons/x.svg", class: "h-3 w-3", aria_hidden: true) %>
    </button>
  <% end %>

  <% if @header.present? %>
    <h4 class="mb-2 font-sans text-lg normal-case <%= header_color_classes %>">
      <%= @header %>
    </h4>
  <% end %>

  <div class="twalert-body">
    <%= @text %>
    <%= content %>
  </div>
</div>

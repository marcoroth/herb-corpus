<div
  id="flash-messages"
  class="
    pointer-events-none fixed right-0 bottom-8 left-0 z-50
    mx-auto max-w-screen-xl px-[5px] md:bottom-12 md:px-4
  "
>
  <div
    class="
      pointer-events-auto flex w-full flex-col gap-2
      md:w-auto md:max-w-xs md:min-w-140
    "
  >
    <% messages.each do |msg| %>
      <%= render UI::Alerts::Base::Component.new(text: msg[:text], kind: msg[:kind], dismissable: true, margin_classes: "mb-0") %>
    <% end %>
  </div>
</div>

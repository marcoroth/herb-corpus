<details data-controller="ui--details" class="max-w-md">
  <summary
    data-action="click->ui--details#toggle"
    class="
      flex cursor-pointer list-none items-center
      justify-between gap-3 rounded-sm border border-gray-200
      p-3 [&::-webkit-details-marker]:hidden
    "
  >
    <span class="font-semibold">Full spec sheet</span>
    <%= render UI::IconChevron::Component.new(html_class: "transition-transform [details[open]_&]:rotate-90") %>
  </summary>

  <div data-ui--details-target="content" class="hidden! pt-3">
    <p class="mb-0">
      Native &lt;details&gt; body, animated open/closed by the details
      controller.
    </p>
  </div>
</details>

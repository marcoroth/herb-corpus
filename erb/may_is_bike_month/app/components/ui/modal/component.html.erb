<dialog
  id="<%= @id %>"
  data-controller="ui--modal"
  data-ui--modal-open-on-connect-value="<%= @open %>"
  data-action="click->ui--modal#backdropClick close->ui--modal#closed command->ui--modal#invoked submit->ui--modal#submitted pointerdown->ui--modal#pressed popstate@window->ui--modal#popped"
  class="
    m-auto max-h-dvh w-full max-w-lg overflow-y-auto
    overscroll-contain bg-transparent px-4 backdrop:bg-black/50
    backdrop:backdrop-blur-sm
  "
>
  <%#
    The dialog is the scroller, so the rounded ends stay off-screen until you
    reach them. clip rather than hidden: hidden would make this the scrollport
    and strand the sticky title bar
  %>

  <div class="my-4 w-full overflow-clip rounded-xl bg-white shadow-xl dark:bg-gray-800">
    <% if @title %>
      <div
        class="
          sticky top-0 flex items-center justify-between
          border-b border-gray-200 bg-white px-5 py-4
          dark:border-gray-700 dark:bg-gray-800
        "
      >
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
          <%= @title %>
        </h3>

        <button
          type="button"
          commandfor="<%= @id %>"
          command="close"
          aria-label="Close"
          class="p-1 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300"
        >
          <%= helpers.inline_svg_tag("icons/x.svg", class: "h-3 w-3", aria_hidden: true) %>
        </button>
      </div>
    <% end %>

    <div class="px-5 py-4 twtext-color">
      <%= body %>
    </div>
  </div>
</dialog>

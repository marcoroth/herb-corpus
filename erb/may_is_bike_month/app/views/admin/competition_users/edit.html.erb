<h1 class="mb-4">Edit User</h1>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-8">
  <%= render(UI::DefinitionList::Container::Component.new) do %>
    <%= render(UI::DefinitionList::Row::Component.new(label: "Competition")) do %>
      <%= link_to @competition_user.competition.display_name.presence || @competition_user.competition.slug, admin_competition_users_path(search_competition_id: @competition_user.competition_id), class: "twlink" %>
    <% end %>

    <%= render(UI::DefinitionList::Row::Component.new(label: "Created", value: @competition_user.created_at)) %>

    <%= render(UI::DefinitionList::Row::Component.new(label: "Updated", value: @competition_user.updated_at)) %>

    <%= render(UI::DefinitionList::Row::Component.new(label: "Activities")) do %>
      <%= number_display(@competition_user.competition_activities.count) %>
    <% end %>

    <%= render(UI::DefinitionList::Row::Component.new(label: "Activities in competition")) do %>
      <%= number_display(@competition_user.competition_activities.included_in_competition.count) %>
    <% end %>
  <% end %>

  <% user = @competition_user.user %>

  <%= render(UI::DefinitionList::Container::Component.new) do %>
    <%= render(UI::DefinitionList::Row::Component.new(label: "User", value: user.display_name)) %>

    <%= render(UI::DefinitionList::Row::Component.new(label: "Strava", value: strava_link(user))) %>

    <%= render(UI::DefinitionList::Row::Component.new(label: "Role", value: user.role)) %>

    <%= render(UI::DefinitionList::Row::Component.new(label: "Joined", value: user.created_at)) %>

    <%= render(UI::DefinitionList::Row::Component.new(label: "Last sign-in", value: user.last_sign_in_at, render_with_no_value: true, no_value_text: "never")) %>

    <%= render(UI::DefinitionList::Row::Component.new(label: "Sign-in count", value: user.sign_in_count)) %>

    <% other_competition_users = user.competition_users.where.not(id: @competition_user.id).includes(:competition).start_ordered_desc %>

    <% if other_competition_users.any? %>
      <%= render(UI::DefinitionList::Row::Component.new(label: "Other competitions")) do %>
        <ul>
          <% other_competition_users.each do |cu| %>
            <li>
              <%= link_to cu.competition.display_name.presence || cu.competition.slug, edit_admin_competition_user_path(cu), class: "twlink" %>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  <% end %>
</div>

<%= form_with(model: @competition_user, url: admin_competition_user_path(@competition_user), method: :patch, builder: MayIsBikeMonthFormBuilder, class: "pb-2") do |f| %>
  <%= render partial: "/shared/errors", locals: {obj: @competition_user, name: "User"} %>

  <div class="row sm:grid-cols-2">
    <div class="col">
      <%= render UI::Forms::Group::Component.new(form_builder: f, attribute: :display_name, html_options: {required: true}) %>
    </div>

    <div class="col">
      <div class="mb-3">
        <%= f.label :included_in_competition, class: "form-control-check" do %>
          <%= f.check_box :included_in_competition %> Included in competition?
        <% end %>
      </div>
    </div>
  </div>

  <div class="form-row-btn">
    <%= f.submit "save", class: "btn" %>
  </div>
<% end %>

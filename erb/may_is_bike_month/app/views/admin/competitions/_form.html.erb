<%= form_with model: @competition, url: admin_competitions_path, local: true, builder: MayIsBikeMonthFormBuilder, class: "space-y-2" do |form| %>
  <% if @competition.errors.any? %>
    <%= render partial: "shared/errors", locals: {obj: @competition} %>
  <% end %>

  <%= render(UI::Forms::Group::Component.new(form_builder: form, attribute: :display_name, html_options: {placeholder: "MIBM #{Time.current.year} (defaulted from start date)"})) %>

  <%= render(UI::Forms::Group::Component.new(form_builder: form, attribute: :start_date, required: true)) do %>
    <%= form.date_field :start_date, required: true, class: "twinput" %>
  <% end %>

  <%= render(UI::Forms::Checkbox::Component.new(form_builder: form, attribute: :current, label: "Current Competition")) %>

  <div class="pt-4">
    <%= form.submit class: "w-full btn" %>
  </div>
<% end %>

<div class="flex min-h-[calc(100vh-4rem)] items-center justify-center px-4 py-8">
  <div class="card w-full max-w-sm bg-base-100 shadow-xl">
    <div class="card-body">
      <h1 class="card-title justify-center text-2xl text-primary"><%= t('.login') %></h1>

      <% if @user_session.errors.any? %>
        <div class="alert alert-error">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          <div>
            <h3 class="font-bold"><%= t('.the_following_errors___no_login') %></h3>
            <ul class="list-disc list-inside text-sm">
              <% @user_session.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <%= form_for(@user_session) do |f| %>
        <fieldset class="fieldset">
          <legend class="fieldset-legend"><%= t('.username') %></legend>
          <%= f.text_field :username, class: 'input w-full', autofocus: true, placeholder: t('.username') %>
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend"><%= t('.password') %></legend>
          <%= f.password_field :password, class: 'input w-full', placeholder: t('.password') %>
        </fieldset>
        <div class="mt-6">
          <%= f.submit t('.login_button'), class: 'btn btn-primary w-full' %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <title>N&oslash;skvabbel</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbo-track': 'reload' %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-base-200">
    <div class="navbar bg-base-100 shadow-sm sticky top-0 z-30">
      <div class="navbar-start">
        <% if current_user %>
          <div class="dropdown lg:hidden">
            <div tabindex="0" role="button" class="btn btn-ghost" aria-label="<%= t('.menu') %>">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" /></svg>
            </div>
            <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-100 rounded-box w-52">
              <li><%= link_to t('.account'), account_path %></li>
              <li><%= link_to t('.logout'), logout_path %></li>
            </ul>
          </div>
        <% end %>
        <%= link_to 'Nøskvabbel', '/', class: 'btn btn-ghost text-xl font-bold text-primary' %>
      </div>
      <div class="navbar-center hidden lg:flex">
        <% if current_user %>
          <span class="text-sm">
            <%= t('.hi') %> <span class="font-semibold <%= gender_text_class(current_user) %>"><%= current_user.username %></span>!
            <% if current_user.couple %>
              <%= t('.in_couple_with') %>
              <span class="font-semibold <%= gender_text_class(other_mate_in_couple_with(current_user)) %>"><%= other_mate_in_couple_with(current_user).username %></span>.
            <% else %>
              <%= t('.not_in_couple_yet') %>
            <% end %>
          </span>
        <% else %>
          <span class="text-sm text-base-content/70"><%= t('.tagline') %></span>
        <% end %>
      </div>
      <div class="navbar-end">
        <% if current_user %>
          <%= link_to t('.account'), account_path, class: 'btn btn-ghost btn-sm hidden lg:inline-flex' %>
          <%= link_to t('.logout'), logout_path, class: 'btn btn-ghost btn-sm hidden lg:inline-flex' %>
        <% end %>
      </div>
    </div>

    <main class="container mx-auto px-4 py-6">
      <%= render partial: 'shared/flash' %>
      <%= yield %>
    </main>
  </body>
</html>

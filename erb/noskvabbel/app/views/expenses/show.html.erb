<div class="card bg-base-100 shadow-xl max-w-lg mx-auto">
  <div class="card-body">
    <h1 class="card-title text-2xl">Details for the selected expense</h1>
    <table class="table table-zebra">
      <tr>
        <td>Label</td>
        <td><%= @expense.label %></td>
      </tr>
      <tr>
        <td>Amount</td>
        <td><%= number_to_currency(@expense.amount, unit: '€ ', separator: ',', delimiter: ' ') %></td>
      </tr>
      <tr>
        <td>Who</td>
        <td><%= @expense.user.username %></td>
      </tr>
      <tr>
        <td>When</td>
        <td><%= @expense.spent_on %></td>
      </tr>
      <tr>
        <td>Recorded by</td>
        <td><%= @expense.created_by.username %></td>
      </tr>
    </table>
    <%= link_to 'Go back to the list of expenses', expenses_path, class: 'btn btn-ghost mt-4' %>
  </div>
</div>

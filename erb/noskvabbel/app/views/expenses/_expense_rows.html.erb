<% expenses.each do |exp| %>
  <tr id="expense_<%= exp.id %>" class="<%= gender(exp.user) %>">
    <td><%= exp.spent_on %></td>
    <td><%= exp.label %></td>
    <td class="text-right"><%= number_to_currency(exp.amount, unit: '€ ', separator: ',', delimiter: ' ') %></td>
    <td><span class="badge badge-soft <%= gender_badge_class(exp.user) %>"><%= exp.user.username %></span></td>
    <td class="whitespace-nowrap">
      <%= link_to t('expenses.index.details'), expense_path(exp), class: 'btn btn-ghost btn-xs' %>
      <%= link_to t('expenses.index.edit'), edit_expense_path(exp), class: 'btn btn-ghost btn-xs' %>
      <%= link_to t('expenses.index.delete'), exp, class: 'btn btn-ghost btn-xs text-error',
                  data: { turbo_method: :delete, turbo_confirm: t('expenses.index.confirm_delete') } %>
    </td>
  </tr>
<% end %>

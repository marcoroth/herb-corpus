<% unless @all_expenses_loaded %>
<div id="load_more_buttons" class="flex flex-wrap justify-center gap-2 mt-4">
  <%= link_to t('expenses.index.load_30_more_days'), load_more_expenses_path(mode: '30_days', before: @oldest_theoretical_date, oldest: @oldest_expense_date, year: @next_year_to_load), class: 'btn btn-outline btn-sm', data: { turbo_stream: true } %>
  <%= link_to t('expenses.index.load_rest_of_year', year: @next_year_to_load), load_more_expenses_path(mode: 'rest_of_year', before: @oldest_expense_date, oldest: @oldest_expense_date, year: @next_year_to_load), class: 'btn btn-outline btn-sm', data: { turbo_stream: true } %>
  <%= link_to t('expenses.index.load_all_remaining'), load_more_expenses_path(mode: 'all_remaining', before: @oldest_expense_date, oldest: @oldest_expense_date, year: @next_year_to_load), class: 'btn btn-outline btn-sm', data: { turbo_stream: true } %>
</div>
<% end %>

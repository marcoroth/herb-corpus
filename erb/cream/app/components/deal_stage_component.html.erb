<% badge_markup = helpers.badge(deal.stage_label, color: deal.stage_color) %>
<% content = capture do %>
  <% if editable? %>
    <div class="relative inline-block" data-controller="dropdown">
      <button type="button"
              class="inline-flex items-center gap-0.5 rounded-full cursor-pointer hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-label="<%= t("deals.stage_dropdown.change_aria") %>"
              data-dropdown-target="trigger"
              data-action="click->dropdown#toggle">
        <%= badge_markup %>
        <%= helpers.icon :chevron_down, classes: "size-3 text-ink-faint shrink-0" %>
      </button>
      <ul role="menu"
          hidden
          data-dropdown-target="menu"
          class="record-menu-items left-0 right-auto min-w-[12rem] max-h-56 overflow-y-auto">
        <% stage_options.each do |option| %>
          <li role="none">
            <% if option.current %>
              <span role="menuitem"
                    aria-current="true"
                    class="flex w-full items-center gap-2 rounded-lg px-2 py-1.5 text-xs font-medium text-ink-faint bg-canvas-sunken cursor-default">
                <%= helpers.badge(option.stage.name, color: option.stage.color) %>
              </span>
            <% elsif option.blocked %>
              <button type="button"
                      role="menuitem"
                      disabled
                      aria-disabled="true"
                      title="<%= option.blocked_title %>"
                      class="flex w-full items-center gap-2 rounded-lg px-2 py-1.5 text-xs font-medium text-ink-faint opacity-50 cursor-not-allowed">
                <%= helpers.badge(option.stage.name, color: option.stage.color) %>
              </button>
            <% else %>
              <%= button_to move_url(option.stage),
                    method: :patch,
                    role: "menuitem",
                    class: "flex w-full items-center gap-2 rounded-lg px-2 py-1.5 text-xs font-medium text-ink hover:bg-canvas-sunken cursor-pointer",
                    form: { class: "block w-full", data: { turbo: true } } do %>
                <%= helpers.badge(option.stage.name, color: option.stage.color) %>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% else %>
    <%= badge_markup %>
  <% end %>
<% end %>
<% if wrapper_id.present? %>
  <div id="<%= wrapper_id %>"><%= content %></div>
<% else %>
  <%= content %>
<% end %>

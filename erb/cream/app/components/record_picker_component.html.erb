<div class="relative"
     data-controller="record-picker"
     data-record-picker-search-url-value="<%= search_url %>"
     data-record-picker-no-results-value="<%= t("shared.record_picker.no_results") %>"
     data-record-picker-create-label-value="<%= t("shared.record_picker.create", name: "%{name}") %>"
     data-record-picker-create-failed-value="<%= t("shared.record_picker.create_failed") %>"
     data-record-picker-network-error-value="<%= t("shared.record_picker.network_error") %>"
     <% if create_param.present? %>
     data-record-picker-create-url-value="<%= create_url %>"
     data-record-picker-create-param-value="<%= create_param %>"
     <% end %>
     <% if inline_records %>
     data-record-picker-records-value="<%= inline_records_json %>"
     <% end %>>
  <%= form.label attribute, label, class: "label" %>
  <input type="text"
         autocomplete="off"
         class="input"
         value="<%= selected_name %>"
         placeholder="<%= t("shared.record_picker.search_placeholder") %>"
         <%= "required" if required %>
         <%= "disabled" if disabled %>
         data-record-picker-target="input"
         data-product-edition-picker-target="picker"
         data-action="input->record-picker#query keydown->record-picker#keydown blur->record-picker#hide focus->record-picker#focus" />
  <%= form.hidden_field attribute, data: { record_picker_target: "hidden" }.merge(hidden_data) %>
  <ul data-record-picker-target="menu"
      role="listbox"
      class="hidden max-h-56 overflow-y-auto rounded-md border border-line bg-canvas shadow-sm"></ul>
  <p data-record-picker-target="error" class="hidden mt-1 text-xs text-danger"></p>
</div>

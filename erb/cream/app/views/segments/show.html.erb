<% page_title @segment.name %>
<% actions = capture do %>
  <%= link_to t("marketing.shared.edit"), edit_segment_path(@segment), class: "btn-secondary" %>
  <%= button_to t("marketing.shared.delete"), segment_path(@segment), method: :delete, class: "btn-danger",
        form: { data: { turbo_confirm: t("marketing.segments.show.delete_confirm", name: @segment.name) } } %>
<% end %>
<%= render "shared/page_header", title: @segment.name, icon_name: :users, count: @count, actions: actions %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5 space-y-4">
  <div class="card p-4 space-y-2">
    <p class="text-sm"><%= t("marketing.segments.show.match_count_html", count: tag.strong(@count)) %></p>
    <p class="text-sm text-ink-faint"><%= describe_segment_filters(@segment.filters) %></p>
    <% if @segment.description.present? %>
      <p class="text-sm text-ink-soft"><%= @segment.description %></p>
    <% end %>
  </div>

  <% if @members.any? %>
    <div class="overflow-x-auto">
      <table class="table-base">
        <thead>
          <tr>
            <% if @segment.record_type == "Person" %>
              <th><%= t("marketing.segments.show.col_name") %></th>
              <th><%= t("marketing.shared.email") %></th>
              <th><%= t("marketing.shared.company") %></th>
              <th><%= t("marketing.shared.lifecycle") %></th>
            <% else %>
              <th><%= t("marketing.segments.show.col_name") %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @members.each do |member| %>
            <tr>
              <td>
                <%= link_to member.display_name, record_path_for(member), class: "font-medium text-accent hover:underline" %>
              </td>
              <% if @segment.record_type == "Person" %>
                <td class="text-sm text-ink-soft"><%= member.email %></td>
                <td class="text-sm text-ink-soft"><%= member.company&.name %></td>
                <td class="text-sm text-ink-soft"><%= member.lifecycle_stage&.humanize %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if defined?(@pagy) && @pagy %>
      <%= render "shared/pagination", pagy: @pagy %>
    <% end %>
  <% else %>
    <%= render "shared/empty_state", icon_name: :users, title: t("marketing.segments.show.empty_title"),
          subtitle: t("marketing.segments.show.empty_subtitle") %>
  <% end %>
</div>

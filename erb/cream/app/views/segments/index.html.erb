<% page_title t("marketing.segments.index.page_title") %>
<% actions = capture do %>
  <%= link_to new_segment_path, class: "btn-primary" do %>
    <%= icon :plus, classes: "size-3.5" %> <%= t("marketing.segments.index.new") %>
  <% end %>
<% end %>
<%= render "shared/page_header", title: t("marketing.segments.index.page_title"), icon_name: :users, count: @segments.size, actions: actions %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5 space-y-3">
  <% if @segments.empty? %>
    <%= render "shared/empty_state", icon_name: :users, title: t("marketing.segments.index.empty_title"),
          subtitle: t("marketing.segments.index.empty_subtitle") %>
  <% else %>
    <% @segments.each do |segment| %>
      <article class="card p-4">
        <div class="flex items-center gap-2 flex-wrap">
          <h2 class="font-semibold text-base">
            <%= link_to segment.name, segment, class: "hover:underline" %>
          </h2>
          <%= badge segment.record_type, color: "hoki" %>
          <div class="ml-auto flex gap-2">
            <%= link_to t("marketing.shared.edit"), edit_segment_path(segment), class: "btn-secondary" %>
            <%= button_to t("marketing.shared.delete"), segment_path(segment), method: :delete, class: "btn-danger",
                  form: { data: { turbo_confirm: t("marketing.segments.index.delete_confirm", name: segment.name) } } %>
          </div>
        </div>
        <p class="text-sm text-ink-faint mt-1"><%= describe_segment_filters(segment.filters) %></p>
      </article>
    <% end %>
  <% end %>
</div>

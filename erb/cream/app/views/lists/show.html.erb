<% page_title @list.name %>
<% list_type_key = @list.record_type.downcase %>
<% actions = capture do %>
  <%= link_to edit_list_path(@list), class: "btn-secondary" do %>
    <%= icon :pencil, classes: "size-3.5" %> <%= t("integrations.lists.show.edit") %>
  <% end %>
  <%= button_to list_path(@list), method: :delete, form: { data: { turbo_confirm: t("integrations.lists.show.delete_confirm", name: @list.name) } }, class: "btn-danger" do %>
    <%= icon :trash, classes: "size-3.5" %> <%= t("integrations.lists.show.delete") %>
  <% end %>
<% end %>
<%= render "shared/page_header", title: @list.name, icon_name: :list, count: @entries.size, actions: actions %>

<div class="flex flex-wrap items-center gap-2 border-b border-line px-5 py-2 shrink-0">
  <%= form_with url: list_entries_path(@list), method: :post, class: "flex flex-wrap items-center gap-2" do %>
    <%= select_tag :record_id,
          options_from_collection_for_select(@candidates, :id, :display_name),
          include_blank: t("integrations.lists.show.add_blank", type: t("integrations.lists.record_types.#{list_type_key}")),
          class: "input w-64 max-w-full" %>
    <%= submit_tag t("integrations.lists.show.add"), class: "btn-secondary" %>
  <% end %>
</div>

<div class="flex-1 overflow-auto scrollbar-subtle">
  <% if @entries.any? %>
    <table class="table-base">
      <thead>
        <tr>
          <th><%= t("integrations.lists.show.columns.name") %></th>
          <% if @list.record_type == "Deal" %>
            <th><%= t("integrations.lists.show.columns.stage") %></th>
            <th><%= t("integrations.lists.show.columns.value") %></th>
          <% elsif @list.record_type == "Person" %>
            <th><%= t("integrations.lists.show.columns.email") %></th>
            <th><%= t("integrations.lists.show.columns.company") %></th>
          <% else %>
            <th><%= t("integrations.lists.show.columns.domain") %></th>
            <th><%= t("integrations.lists.show.columns.industry") %></th>
          <% end %>
          <th><%= t("integrations.lists.show.columns.added") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @entries.each do |entry| %>
          <% record = entry.record %>
          <tr>
            <td>
              <%= link_to record_path_for(record), class: "flex items-center gap-2 font-medium hover:text-accent" do %>
                <%= avatar record %>
                <%= record.display_name %>
              <% end %>
            </td>
            <% if @list.record_type == "Deal" %>
              <td><%= render DealStageComponent.new(deal: record) %></td>
              <td class="text-ink-soft tabular-nums"><%= money(record.value, record.currency) %></td>
            <% elsif @list.record_type == "Person" %>
              <td class="text-ink-soft"><%= record.email %></td>
              <td class="text-ink-soft"><%= record.company&.name %></td>
            <% else %>
              <td class="text-ink-soft"><%= record.domain %></td>
              <td class="text-ink-soft"><%= record.industry %></td>
            <% end %>
            <td class="text-ink-faint text-sm"><%= l entry.created_at, format: :short %></td>
            <td class="text-right">
              <%= button_to list_entry_path(@list, entry), method: :delete,
                    class: "text-ink-faint hover:text-danger p-1 rounded cursor-pointer", title: t("integrations.lists.show.remove_from_list") do %>
                <%= icon :x, classes: "size-3.5" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <%= render "shared/empty_state", icon_name: :list, title: t("integrations.lists.show.empty_title"),
          subtitle: t("integrations.lists.show.empty_subtitle", types: t("integrations.lists.show.record_types_plural.#{list_type_key}")), action: nil %>
  <% end %>
</div>

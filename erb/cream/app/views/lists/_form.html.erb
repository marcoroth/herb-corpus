<%= form_with model: list, class: "space-y-4" do |f| %>
  <% if list.errors.any? %>
    <div class="rounded-lg bg-danger-soft ring-1 ring-danger-line px-3 py-2 text-sm text-danger-strong">
      <ul class="list-disc list-inside">
        <% list.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "label" %>
    <%= f.text_field :name, class: "input", autofocus: true, placeholder: t("integrations.lists.form.name_placeholder") %>
  </div>

  <div>
    <%= f.label :record_type, t("integrations.lists.form.record_type"), class: "label" %>
    <%= f.select :record_type, List::RECORD_TYPES.map { |type| [ t("integrations.lists.record_type_options.#{type}"), type ] }, {},
          class: "input", disabled: list.persisted? %>
    <% if list.persisted? %>
      <p class="text-xs text-ink-faint mt-1"><%= t("integrations.lists.form.record_type_locked") %></p>
    <% end %>
  </div>

  <div>
    <%= f.label :color, class: "label" %>
    <div class="flex gap-2">
      <% List::COLORS.each do |color| %>
        <label class="cursor-pointer">
          <%= f.radio_button :color, color, class: "peer sr-only" %>
          <span class="block size-6 rounded-full bg-<%= color %>-500 ring-offset-2 ring-offset-canvas-raised peer-checked:ring-2 peer-checked:ring-ink"></span>
        </label>
      <% end %>
    </div>
  </div>

  <div class="flex items-center gap-2 pt-2">
    <%= f.submit list.persisted? ? t("integrations.lists.form.save") : t("integrations.lists.form.create"), class: "btn-primary" %>
    <%= link_to t("shared.form.cancel"), list.persisted? ? list_path(list) : lists_path, class: "btn-secondary" %>
  </div>
<% end %>

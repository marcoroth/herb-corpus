<div class="record-information-grid">
  <section class="record-card">
    <div class="record-card-heading"><h2 class="record-section-title"><%= t("companies.show.details") %></h2><%= link_to t("records.edit"), edit_company_path(@company, section: "profile"), class: "btn-ghost", aria: { label: t("companies.show.edit_details") } %></div>
    <div class="divide-y divide-line/60">
      <%= render "shared/attribute", label: t("records.fields.domain"), icon_name: :external, value: @company.domain.present? ? link_to(@company.domain, "https://#{@company.domain}", target: "_blank", rel: "noopener", class: "text-accent hover:underline") : nil %>
      <%= render "shared/attribute", label: t("records.fields.industry"), icon_name: :briefcase, value: @company.industry %>
      <%= render "shared/attribute", label: t("records.fields.employees"), icon_name: :users, value: @company.employee_range %>
      <%= render "shared/attribute", label: t("records.fields.location"), icon_name: :map_pin, value: @company.location %>
      <%= render "shared/attribute", label: t("records.fields.revenue"), icon_name: :banknote, value: @company.annual_revenue.present? ? money(@company.annual_revenue) : nil %>
      <%= render "shared/attribute", label: t("records.fields.linkedin"), icon_name: :external, value: @company.linkedin_url.present? ? safe_http_url_link(@company.linkedin_url, t("records.profile_link")) : nil %>
      <%= render "shared/attribute", label: t("records.fields.twitter"), icon_name: :external, value: @company.twitter_url.present? ? safe_http_url_link(@company.twitter_url, t("records.profile_link")) : nil %>
    </div>
  </section>
  <section class="record-card">
    <div class="record-card-heading"><h2 class="record-section-title"><%= t("companies.show.about") %></h2><%= link_to t("records.edit"), edit_company_path(@company, section: "about"), class: "btn-ghost", aria: { label: t("companies.show.edit_about") } %></div>
    <% if @company.description.present? %>
      <p class="text-sm text-ink-soft whitespace-pre-wrap break-words"><%= @company.description %></p>
    <% else %>
      <p class="text-sm text-ink-soft"><%= t("companies.show.no_description") %></p>
    <% end %>
  </section>
  <section class="record-card">
    <div class="record-card-heading"><h2 class="record-section-title"><%= t("companies.show.fiscal") %></h2><%= link_to t("records.edit"), edit_company_path(@company, section: "fiscal"), class: "btn-ghost", aria: { label: t("companies.show.edit_fiscal") } %></div>
    <% if @company.fiscal_information.present? %>
      <p class="text-sm text-ink-soft whitespace-pre-wrap break-words"><%= @company.fiscal_information %></p>
    <% else %>
      <p class="text-sm text-ink-soft"><%= t("companies.show.no_fiscal") %></p>
    <% end %>
  </section>
  <section class="record-card">
    <div class="record-card-heading"><h2 class="record-section-title"><%= t("records.fields.management") %></h2><%= link_to t("records.edit"), edit_company_path(@company, section: "management"), class: "btn-ghost", aria: { label: t("companies.show.edit_management") } %></div>
    <%= render "shared/attribute", label: t("records.fields.owner"), icon_name: :users, value: @company.owner&.name %>
    <%= render "shared/attribute", label: t("records.fields.created"), icon_name: :clock, value: l(@company.created_at, format: :short) %>
    <% if @company.lists.any? %>
      <h3 class="text-sm font-medium mt-4 mb-2"><%= t("records.fields.lists") %></h3>
      <div class="flex flex-wrap gap-2"><% @company.lists.each do |list| %><%= link_to list.name, list_path(list), class: "record-count hover:text-accent" %><% end %></div>
    <% end %>
  </section>
  <% if @company.custom_field_definitions.any? %>
    <section class="record-card">
      <div class="record-card-heading"><h2 class="record-section-title"><%= t("records.fields.custom_fields") %></h2><%= link_to t("records.edit"), edit_company_path(@company, section: "custom"), class: "btn-ghost", aria: { label: t("companies.show.edit_custom") } %></div>
      <%= render "shared/custom_attributes", record: @company %>
    </section>
  <% end %>
</div>

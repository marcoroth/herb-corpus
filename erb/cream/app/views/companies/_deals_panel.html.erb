<section class="record-card">
  <div class="record-card-heading">
    <h2 class="record-section-title"><%= t("records.tabs.deals") %> <span class="record-count"><%= @deals.size %></span></h2>
    <%= link_to new_deal_path(company_id: @company.id), class: "btn-ghost" do %><%= icon :plus, classes: "size-4" %> <%= t("records.add_deal") %><% end %>
  </div>
  <% if @deals.any? %>
    <ul class="space-y-1">
      <% @deals.each do |deal| %>
        <li class="rounded-md px-2 py-1.5 hover:bg-canvas-sunken">
          <div class="flex items-center justify-between gap-2">
            <%= link_to deal.name, deal_path(deal), class: "truncate font-medium text-base hover:underline" %>
            <%= render DealStageComponent.new(deal: deal) %>
          </div>
          <p class="text-xs text-ink-faint mt-0.5 truncate">
            <%= l(deal.created_at, format: :short) %>
            <% if deal.products.any? %>
              · <%= deal.products.map(&:name).join(", ") %>
            <% end %>
          </p>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-ink-faint px-2"><%= t("companies.show.deals_empty") %></p>
  <% end %>
</section>

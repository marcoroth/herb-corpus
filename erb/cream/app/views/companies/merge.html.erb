<% page_title t("companies.merge.title") %>
<%= render "shared/page_header", title: t("companies.merge.title"), icon_name: :building, count: nil, actions: nil %>

<div class="flex-1 overflow-y-auto p-5">
  <div class="max-w-2xl space-y-6">
    <section class="card p-4">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-ink-faint mb-3"><%= t("companies.merge.company_to_keep") %></h2>
      <div class="flex items-center gap-3">
        <%= avatar @company, size: "size-12", text: "text-base" %>
        <div>
          <p class="font-semibold text-lg"><%= @company.name %></p>
          <p class="text-sm text-ink-faint"><%= @company.domain.presence || t("companies.merge.no_domain") %></p>
        </div>
      </div>
    </section>

    <%= form_with url: merge_company_path(@company), method: :post, class: "space-y-4",
          data: { turbo_confirm: t("companies.merge.confirm", name: @company.name) } do %>
      <section class="card p-4">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-ink-faint mb-1"><%= t("companies.merge.companies_to_merge") %></h2>
        <p class="text-sm text-ink-faint mb-4">
          <%= t("companies.merge.subtitle") %>
        </p>

        <% if @merge_candidates.any? %>
          <div class="space-y-2">
            <% @merge_candidates.each do |candidate| %>
              <label class="flex items-start gap-3 rounded-lg border border-line px-3 py-2.5 hover:bg-canvas-sunken cursor-pointer">
                <%= check_box_tag "secondary_ids[]", candidate.id, @selected_secondary_ids.include?(candidate.id),
                      class: "mt-1 rounded border-line text-accent focus:ring-accent" %>
                <span class="min-w-0">
                  <span class="font-medium block"><%= candidate.name %></span>
                  <span class="text-sm text-ink-faint block">
                    <%= [
                      candidate.domain,
                      candidate.industry,
                      t("companies.merge.people_count", count: candidate.people.size),
                      t("deals.index.count", count: candidate.deals.size)
                    ].compact_blank.join(" · ") %>
                  </span>
                </span>
              </label>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-ink-faint"><%= t("companies.merge.no_suggestions_named", name: @company.name) %></p>
        <% end %>
      </section>

      <div class="flex items-center gap-2">
        <%= submit_tag t("companies.merge.merge"), class: "btn-primary", disabled: @merge_candidates.empty? %>
        <%= link_to t("companies.merge.cancel"), @company, class: "btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>

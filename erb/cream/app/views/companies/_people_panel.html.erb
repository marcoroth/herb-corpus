<section class="record-card">
  <div class="record-card-heading">
    <h2 class="record-section-title"><%= t("records.tabs.people") %> <span class="record-count"><%= @people.size %></span></h2>
    <%= link_to new_person_path(company_id: @company.id), class: "btn-ghost" do %><%= icon :plus, classes: "size-4" %> <%= t("records.add_person") %><% end %>
  </div>
  <% if @people.any? %>
    <ul class="space-y-1">
      <% @people.each do |person| %>
        <li>
          <%= link_to person_path(person), class: "flex items-center gap-3 rounded-md px-2 py-2 hover:bg-canvas-sunken text-base" do %>
            <%= avatar person, size: "size-8", text: "text-xs" %>
            <span class="min-w-0 flex-1">
              <span class="block font-medium truncate"><%= person.display_name %></span>
              <% if person.job_title.present? %><span class="block text-sm text-ink-faint truncate"><%= person.job_title %></span><% end %>
            </span>
            <% if person.email.present? %><span class="text-sm text-ink-soft truncate hidden sm:block"><%= person.email %></span><% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-ink-soft"><%= t("companies.show.people_empty") %></p>
  <% end %>
</section>

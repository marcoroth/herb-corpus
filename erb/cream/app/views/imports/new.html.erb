<% import_type = t("imports.record_types_plural.#{@record_type}") %>
<% page_title t("imports.page_title", type: import_type) %>
<%= render "shared/page_header", title: t("imports.title", type: import_type), icon_name: :upload %>

<div class="p-5 max-w-lg">
  <div class="card p-4">
    <%= form_with url: import_path, multipart: true do |f| %>
      <%= hidden_field_tag :record_type, @record_type %>
      <p class="text-base text-ink-soft mb-3"><%= t("imports.intro", type: import_type) %></p>
      <%= file_field_tag :file, accept: ".csv", required: true, class: "mb-3 block max-w-full" %>
      <%= f.submit t("imports.submit"), class: "btn-primary" %>
    <% end %>
  </div>
</div>

<%= form_with model: product, class: "space-y-4" do |f| %>
  <% if product.errors.any? %>
    <div class="rounded-lg bg-danger-soft ring-1 ring-danger-line px-3 py-2 text-sm text-danger-strong">
      <ul class="list-disc list-inside">
        <% product.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
    <div>
      <%= f.label :name, class: "label" %>
      <%= f.text_field :name, class: "input", autofocus: true, placeholder: t("products.form.name_placeholder") %>
    </div>
    <div>
      <%= f.label :price, t("products.form.price"), class: "label" %>
      <%= f.number_field :price, class: "input", min: 0, step: 0.01 %>
    </div>
    <div>
      <%= f.label :segment, class: "label" %>
      <%= f.select :segment,
            options_for_select([["—", ""]] + Product.segment_options_for_select, product.segment),
            {},
            class: "input" %>
    </div>
  </div>

  <div>
    <%= f.label :description, class: "label" %>
    <%= f.text_area :description, rows: 3, class: "input" %>
  </div>

  <div class="flex items-center gap-2 pt-2">
    <%= f.submit product.persisted? ? t("products.form.save") : t("products.form.create"), class: "btn-primary" %>
    <%= link_to t("shared.form.cancel"), products_path, class: "btn-secondary" %>
  </div>
<% end %>

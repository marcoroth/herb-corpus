<% page_title t("products.edit.page_title", name: @product.name) %>
<% actions = capture do %>
  <%= link_to deals_path(product_id: @product.id, closed: 1), class: "btn-secondary" do %>
    <%= icon :banknote, classes: "size-3.5" %> <%= t("products.edit.view_deals") %>
  <% end %>
<% end %>
<%= render "shared/page_header", title: t("products.edit.title", name: @product.name), icon_name: :briefcase, count: nil, actions: actions %>
<div class="flex-1 overflow-y-auto p-5">
  <div class="max-w-xl">
    <%= render "form", product: @product %>
  </div>
  <%= render "editions_section", product: @product, editions: @editions %>
</div>

<% page_title t("auth.invitation.accept_title") %>
<div class="w-full max-w-sm text-center">
  <div class="card p-6 shadow-sm">
    <h1 class="text-xl font-semibold mb-2"><%= t("auth.invitation.expired_title") %></h1>
    <p class="text-base text-ink-soft mb-4">
      <%= t("auth.invitation.expired_body", workspace: @invitation.workspace.name) %>
    </p>
    <%= link_to t("auth.invitation.sign_in"), new_session_path, class: "btn-primary inline-flex" %>
  </div>
</div>

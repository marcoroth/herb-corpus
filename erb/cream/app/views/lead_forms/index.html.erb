<% page_title t("marketing.lead_forms.index.page_title") %>
<% actions = capture do %>
  <% if current_membership&.admin? %>
    <%= link_to lead_form_templates_path, class: "btn-secondary" do %>
      <%= t("marketing.lead_forms.index.templates") %>
    <% end %>
  <% end %>
  <%= link_to new_lead_form_path, class: "btn-primary" do %>
    <%= icon :plus, classes: "size-3.5" %> <%= t("marketing.lead_forms.index.new") %>
  <% end %>
<% end %>
<%= render "shared/page_header", title: t("marketing.lead_forms.index.page_title"), icon_name: :globe, count: @lead_forms.size, actions: actions %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5 space-y-3">
  <% if @lead_forms.empty? %>
    <p class="text-ink-faint"><%= t("marketing.lead_forms.index.empty") %></p>
  <% end %>

  <% @lead_forms.each do |form| %>
    <article class="card p-4 space-y-3">
      <div class="flex items-center gap-2">
        <h2 class="font-semibold text-base"><%= form.name %></h2>
        <%= badge form.active? ? t("marketing.shared.active") : t("marketing.shared.inactive"), color: form.active? ? "green" : "chicago" %>
        <%= badge form.destination == "mql" ? t("marketing.shared.mql_badge") : t("marketing.shared.deal_badge"), color: form.destination == "mql" ? "hoki" : "chicago" %>
        <% if form.collects_company? %>
          <%= badge t("marketing.shared.with_company"), color: "hoki" %>
        <% end %>
        <div class="ml-auto flex gap-2">
          <%= link_to t("marketing.shared.view"), lead_form_path(form), class: "btn-secondary" %>
          <%= link_to t("marketing.shared.edit"), edit_lead_form_path(form), class: "btn-secondary" %>
          <%= button_to t("marketing.shared.delete"), lead_form_path(form), method: :delete, class: "btn-danger" %>
        </div>
      </div>

      <dl class="grid gap-2 text-sm sm:grid-cols-2">
        <div><dt class="text-ink-faint"><%= t("marketing.lead_forms.index.template") %></dt><dd><%= form.template_key %></dd></div>
        <div><dt class="text-ink-faint"><%= t("marketing.lead_forms.index.pipeline") %></dt><dd><%= form.pipeline&.name || t("marketing.shared.em_dash") %></dd></div>
        <div><dt class="text-ink-faint"><%= t("marketing.lead_forms.index.responsible") %></dt><dd><%= form.responsible.name %></dd></div>
        <div><dt class="text-ink-faint"><%= t("marketing.lead_forms.index.email_to_lead") %></dt><dd><% if form.email_template %><%= link_to form.email_template.name, edit_email_template_path(form.email_template), class: "text-accent hover:underline" %><% else %><span class="text-ink-faint"><%= t("marketing.shared.no_email") %></span><% end %></dd></div>
      </dl>

      <div>
        <p class="label"><%= t("marketing.lead_forms.index.public_url") %></p>
        <%= link_to public_lead_form_url(form.slug), public_lead_form_url(form.slug),
            class: "block rounded-md border border-line bg-canvas-sunken px-3 py-2 text-sm break-all text-accent hover:underline",
            target: "_blank", rel: "noopener noreferrer" %>
      </div>

      <div data-controller="clipboard">
        <p class="label"><%= t("marketing.lead_forms.index.iframe_code") %></p>
        <div class="relative">
          <textarea readonly tabindex="-1" rows="3"
                class="input w-full resize-y font-mono text-sm cursor-default bg-canvas-sunken pr-28"
                aria-readonly="true"
                data-clipboard-target="source"><%= form.iframe_snippet %></textarea>
          <div class="absolute top-2 right-2 flex items-center gap-1.5">
            <span data-clipboard-target="feedback"
                  class="hidden rounded-md bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700 dark:bg-green-950 dark:text-green-300"
                  role="status"
                  aria-live="polite">
              <%= t("marketing.shared.copied") %>
            </span>
            <button type="button"
                  class="rounded-md p-1.5 text-ink-faint hover:text-ink hover:bg-canvas-raised"
                  title="<%= t("marketing.shared.copy_clipboard") %>"
                  aria-label="<%= t("marketing.shared.copy_clipboard") %>"
                  data-action="clipboard#copy"
                  data-clipboard-target="button">
              <span data-clipboard-target="copyIcon"><%= icon :copy, classes: "size-4" %></span>
              <span data-clipboard-target="copiedIcon" class="hidden"><%= icon :check, classes: "size-4" %></span>
            </button>
          </div>
        </div>
      </div>
    </article>
  <% end %>
</div>

<% version_time = l(@version.created_at, format: :short) %>
<% page_title t("deal_versions.show_page_title", deal: @deal.name, time: version_time) %>
<% actions = capture do %>
  <%= link_to deal_versions_path(@deal), class: "btn-secondary" do %>
    <%= icon :arrow_left, classes: "size-3.5" %> <%= t("deal_versions.all_versions") %>
  <% end %>
  <%= link_to deal_path(@deal), class: "btn-secondary" do %>
    <%= icon :banknote, classes: "size-3.5" %> <%= t("deal_versions.current_deal") %>
  <% end %>
<% end %>
<%= render "shared/page_header",
      title: t("deal_versions.show_title", deal: @deal.name, time: version_time),
      icon_name: :activity,
      count: nil,
      actions: actions %>

<div class="flex-1 flex min-h-0 overflow-x-auto snap-x snap-mandatory md:overflow-x-visible md:snap-none">
  <aside class="w-80 shrink-0 snap-start border-r border-line overflow-y-auto scrollbar-subtle p-4">
    <div class="mb-4">
      <p class="text-sm font-semibold uppercase tracking-wider text-ink-faint mb-1"><%= t("deal_versions.snapshot") %></p>
      <p class="text-2xl font-semibold tracking-tight tabular-nums"><%= money(@snapshot.value, @snapshot.currency) %></p>
      <div class="mt-2"><%= stage_badge @snapshot %></div>
    </div>

    <div class="divide-y divide-line/60">
      <%= render "shared/attribute", label: Deal.human_attribute_name(:name), icon_name: :banknote, value: @snapshot.name %>
      <%= render "shared/attribute", label: Deal.human_attribute_name(:probability), icon_name: :activity,
            value: @snapshot.probability.present? ? "#{@snapshot.probability}%" : nil %>
      <%= render "shared/attribute", label: Deal.human_attribute_name(:expected_close_date), icon_name: :calendar,
            value: @snapshot.expected_close_date && l(@snapshot.expected_close_date, format: :short) %>
      <%= render "shared/attribute", label: Deal.human_attribute_name(:execution_duration_days), icon_name: :clock,
            value: format_execution_duration(@snapshot.execution_duration_days) %>
      <%= render "shared/attribute", label: Deal.human_attribute_name(:execution_starts_on), icon_name: :calendar,
            value: @snapshot.execution_starts_on && l(@snapshot.execution_starts_on, format: :short) %>
      <%= render "shared/attribute", label: Deal.human_attribute_name(:execution_ends_on), icon_name: :calendar,
            value: @snapshot.execution_ends_on && l(@snapshot.execution_ends_on, format: :short) %>
      <%= render "shared/attribute", label: Deal.human_attribute_name(:payment_method), icon_name: :credit_card,
            value: format_deal_payment_method(@snapshot.payment_method) %>
      <%= render "shared/attribute", label: Deal.human_attribute_name(:payment_on), icon_name: :calendar,
            value: @snapshot.payment_on && l(@snapshot.payment_on, format: :short) %>
      <%= render "shared/attribute", label: Deal.human_attribute_name(:currency), icon_name: :banknote, value: @snapshot.currency %>
      <%= render "shared/attribute", label: Deal.human_attribute_name(:owner_id), icon_name: :users, value: @snapshot.owner&.name %>
    </div>
  </aside>

  <div class="w-full shrink-0 snap-start md:flex-1 md:w-auto overflow-y-auto scrollbar-subtle p-5 space-y-6 bg-canvas-soft/50 md:max-w-3xl">
    <section>
      <h3 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-ink-faint mb-3">
        <%= icon :activity, classes: "size-3.5" %> <%= t("deal_versions.change") %>
      </h3>
      <p class="text-base text-ink-soft mb-3"><%= version_sentence(@version) %></p>
      <% if @version.event == "update" && @version.changeset.present? %>
        <ul class="space-y-1">
          <% @version.changeset.each do |field, (from, to)| %>
            <li class="text-sm text-ink-faint">
              <span class="font-medium text-ink-soft"><%= field.humanize %>:</span>
              <span class="line-through"><%= from.presence || "—" %></span> → <%= to.presence || "—" %>
            </li>
          <% end %>
        </ul>
      <% elsif @version.event == "create" %>
        <p class="text-base text-ink-faint"><%= t("deal_versions.initial_version") %></p>
      <% end %>
    </section>
  </div>
</div>

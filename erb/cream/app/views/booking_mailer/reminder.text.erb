<%= t("booking.mailer.reminder.greeting", name: @booking.first_name) %>

<%= t("booking.mailer.reminder.intro", event_name: @event_type.localized_name) %>

<%= t("booking.mailer.datetime") %>: <%= @starts_at_display %>
<%= t("booking.mailer.reminder.duration") %>: <%= t("booking.mailer.reminder.duration_minutes", count: @event_type.duration_minutes) %>
<%= t("booking.mailer.reminder.location") %>: <%= BookingEventType.location_type_label(@event_type.location_type) %>
<% if @event_type.location_address.present? -%>
<%= t("booking.mailer.reminder.address") %>: <%= @event_type.location_address %>
<% end -%>
<% if @booking.meet_link.present? -%>
<%= t("booking.mailer.reminder.join_meet") %>: <%= @booking.meet_link %>
<% end -%>

<%= t("booking.mailer.reminder.footer", host_name: @booking_page.name) %>

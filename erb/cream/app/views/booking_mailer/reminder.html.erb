<p><%= t("booking.mailer.reminder.greeting", name: @booking.first_name) %></p>

<p><%= t("booking.mailer.reminder.intro", event_name: @event_type.localized_name) %></p>

<ul>
  <li><strong><%= t("booking.mailer.datetime") %>:</strong> <%= @starts_at_display %></li>
  <li><strong><%= t("booking.mailer.reminder.duration") %>:</strong> <%= t("booking.mailer.reminder.duration_minutes", count: @event_type.duration_minutes) %></li>
  <li><strong><%= t("booking.mailer.reminder.location") %>:</strong> <%= BookingEventType.location_type_label(@event_type.location_type) %></li>
  <% if @event_type.location_address.present? %>
    <li><strong><%= t("booking.mailer.reminder.address") %>:</strong> <%= @event_type.location_address %></li>
  <% end %>
</ul>

<% if @booking.meet_link.present? %>
  <p>
    <%= link_to t("booking.mailer.reminder.join_meet"), @booking.meet_link %>
  </p>
<% end %>

<p><%= t("booking.mailer.reminder.footer", host_name: @booking_page.name) %></p>

<p><%= t("booking.mailer.host_notification.greeting", name: @host.name) %></p>
<p>
  <%= t("booking.mailer.host_notification.body_html",
        event_name: @event_type.localized_name,
        guest_name: @booking.display_name,
        guest_email: @booking.email,
        workspace_name: @booking_page.workspace.name) %>
</p>
<ul>
  <li><strong><%= t("booking.mailer.host_notification.date_time") %>:</strong> <%= @starts_at_display %></li>
</ul>
<% if @deal_url %>
  <p>
    <%= link_to t("booking.mailer.host_notification.view_deal"), @deal_url %>
  </p>
<% end %>
<% if @person_url %>
  <p>
    <%= link_to t("booking.mailer.host_notification.view_person"), @person_url %>
  </p>
<% end %>
<p style="color:#999;font-size:12px;margin-top:16px;">
  <%= t("booking.mailer.host_notification.footer") %>
</p>

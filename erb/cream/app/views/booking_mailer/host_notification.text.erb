<%= t("booking.mailer.host_notification.greeting", name: @host.name) %>

<%= t("booking.mailer.host_notification.body_text",
      event_name: @event_type.localized_name,
      guest_name: @booking.display_name,
      guest_email: @booking.email,
      workspace_name: @booking_page.workspace.name) %>

<%= t("booking.mailer.host_notification.date_time") %>: <%= @starts_at_display %>

<% if @deal_url -%>
<%= t("booking.mailer.host_notification.view_deal") %>: <%= @deal_url %>
<% end -%>

<% if @person_url -%>
<%= t("booking.mailer.host_notification.view_person") %>: <%= @person_url %>
<% end -%>

<%= t("booking.mailer.host_notification.footer") %>

<% page_title t("doorkeeper.authorizations.error.title") %>
<% error_response = local_assigns[:error_response] ? error_response : @pre_auth.error_response %>
<div class="w-full max-w-sm">
  <div class="text-center mb-6">
    <%= image_tag "/icon.svg", alt: "cream", class: "inline-block size-10 mb-3" %>
    <h1 class="text-xl font-semibold"><%= t("doorkeeper.authorizations.error.title") %></h1>
  </div>

  <div class="card p-6 shadow-sm">
    <div class="rounded-lg bg-danger-soft ring-1 ring-danger-line px-3 py-2 text-sm text-danger-strong">
      <%= error_response.body[:error_description] %>
    </div>
  </div>
</div>

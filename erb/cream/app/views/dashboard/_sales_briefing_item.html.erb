<% record = briefing.record_for(item) %>
<% owner = briefing.owner_for(item) || (record.respond_to?(:owner) ? record.owner : nil) %>
<% mine = highlight_mine && owner&.id == current_user.id %>
<li class="rounded-lg px-3 py-2 ring-1 ring-inset ring-line bg-canvas-raised <%= mine ? "ring-hoki-300 dark:ring-hoki-700 bg-hoki-50/60 dark:bg-hoki-950/60" : "" %>">
  <p class="text-base text-ink"><%= item["text"] %></p>
  <div class="flex items-center gap-2 mt-1.5 flex-wrap">
    <% if record.is_a?(Task) %>
      <% task_path = record.taskable ? record_path_for(record.taskable) : tasks_path %>
      <%= link_to record.title, task_path,
            class: "text-xs font-medium text-accent hover:underline truncate max-w-48" %>
    <% elsif record %>
      <%= link_to record.display_name, record_path_for(record),
            class: "text-xs font-medium text-accent hover:underline truncate max-w-48" %>
    <% end %>
    <% if owner %>
      <span class="inline-flex items-center gap-1 text-xs text-ink-faint">
        <%= avatar owner, size: "size-4", text: "text-2xs" %>
        <%= owner.name %>
        <% if mine %>
          <span class="text-hoki-700 font-medium"><%= t("dashboard.briefing.you") %></span>
        <% end %>
      </span>
    <% end %>
  </div>
</li>

<% page_title t("marketing.campaigns.index.page_title") %>
<% actions = capture do %>
  <%= link_to new_campaign_path, class: "btn-primary" do %>
    <%= icon :plus, classes: "size-3.5" %> <%= t("marketing.campaigns.index.new") %>
  <% end %>
<% end %>
<%= render "shared/page_header", title: t("marketing.campaigns.index.page_title"), icon_name: :mail, count: @campaigns.size, actions: actions %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5 space-y-3">
  <% if @campaigns.empty? %>
    <%= render "shared/empty_state", icon_name: :mail, title: t("marketing.campaigns.index.empty_title"),
          subtitle: t("marketing.campaigns.index.empty_subtitle") %>
  <% else %>
    <% @campaigns.each do |campaign| %>
      <article class="card p-4">
        <div class="flex items-center gap-2 flex-wrap">
          <h2 class="font-semibold text-base">
            <%= link_to campaign.name, campaign, class: "hover:underline" %>
          </h2>
          <%= campaign_status_badge(campaign.status) %>
          <div class="ml-auto flex gap-2">
            <%= link_to t("marketing.shared.edit"), edit_campaign_path(campaign), class: "btn-secondary" %>
            <%= button_to t("marketing.shared.delete"), campaign_path(campaign), method: :delete,
                  class: "btn-danger",
                  form: { data: { turbo_confirm: t("marketing.campaigns.index.delete_confirm", name: campaign.name) } } %>
          </div>
        </div>
        <% if campaign.utm_campaign.present? || campaign.goal.present? %>
          <p class="text-sm text-ink-faint mt-1">
            <% if campaign.utm_campaign.present? %>
              <%= t("marketing.shared.utm_prefix") %> <%= campaign.utm_campaign %>
            <% end %>
            <% if campaign.goal.present? %>
              <%= " · " if campaign.utm_campaign.present? %><%= truncate(campaign.goal, length: 120) %>
            <% end %>
          </p>
        <% end %>
      </article>
    <% end %>
  <% end %>
</div>

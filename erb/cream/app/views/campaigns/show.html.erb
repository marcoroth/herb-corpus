<% page_title @campaign.name %>
<% actions = capture do %>
  <%= link_to t("marketing.shared.edit"), edit_campaign_path(@campaign), class: "btn-secondary" %>
  <%= button_to t("marketing.shared.delete"), campaign_path(@campaign), method: :delete, class: "btn-danger",
        form: { data: { turbo_confirm: t("marketing.campaigns.show.delete_confirm", name: @campaign.name) } } %>
<% end %>
<%= render "shared/page_header", title: @campaign.name, icon_name: :mail, actions: actions %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5 space-y-6">
  <section class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    <div class="card p-4">
      <p class="text-sm text-ink-faint"><%= t("marketing.campaigns.show.stat_sent") %></p>
      <p class="text-2xl font-semibold tabular-nums"><%= @stats[:sent] %></p>
    </div>
    <div class="card p-4">
      <p class="text-sm text-ink-faint"><%= t("marketing.campaigns.show.stat_opened") %></p>
      <p class="text-2xl font-semibold tabular-nums"><%= @stats[:opened] %></p>
    </div>
    <div class="card p-4">
      <p class="text-sm text-ink-faint"><%= t("marketing.campaigns.show.stat_clicks") %></p>
      <p class="text-2xl font-semibold tabular-nums"><%= @stats[:clicked] %></p>
    </div>
  </section>

  <section class="card p-4 space-y-3">
    <div class="flex items-center justify-between gap-2 flex-wrap">
      <h2 class="font-semibold"><%= t("marketing.campaigns.show.email_content_heading") %></h2>
      <%= link_to t("marketing.campaigns.show.edit_content"), edit_campaign_path(@campaign), class: "btn-secondary text-sm" %>
    </div>
    <% if @campaign.email_content_present? %>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm">
        <div>
          <dt class="text-ink-faint"><%= t("marketing.campaigns.show.subject") %></dt>
          <dd><%= @campaign.email_subject.presence || @campaign.email_template&.subject || t("marketing.shared.em_dash") %></dd>
        </div>
        <div>
          <dt class="text-ink-faint"><%= t("marketing.campaigns.show.layout") %></dt>
          <dd><%= @campaign.email_layout&.name || @campaign.email_template&.email_layout&.name || t("marketing.campaigns.show.no_layout") %></dd>
        </div>
        <% if @campaign.email_template.present? %>
          <div class="sm:col-span-2">
            <dt class="text-ink-faint"><%= t("marketing.campaigns.show.based_on_template") %></dt>
            <dd><%= @campaign.email_template.name %></dd>
          </div>
        <% end %>
      </dl>
    <% else %>
      <p class="text-sm text-ink-faint"><%= t("marketing.campaigns.show.no_email_content_html", link: link_to(t("marketing.campaigns.show.edit_campaign_link"), edit_campaign_path(@campaign), class: "text-accent hover:underline")).html_safe %></p>
    <% end %>
  </section>

  <section class="card p-4 space-y-4">
    <div class="flex items-center gap-2 flex-wrap">
      <h2 class="font-semibold"><%= t("marketing.campaigns.show.send_heading") %></h2>
      <%= campaign_status_badge(@campaign.status) %>
    </div>

    <div data-controller="segment-preview campaign-send"
         data-segment-preview-url-value="<%= recipient_count_campaign_path(@campaign) %>"
         data-campaign-send-email-content-present-value="<%= @campaign.email_content_present? %>">
      <%= form_with url: send_campaign_campaign_path(@campaign), method: :post, class: "space-y-3 max-w-2xl" do %>
        <div>
          <label class="label"><%= t("marketing.campaigns.show.delivery_mode") %></label>
          <%= select_tag :delivery_mode,
                options_for_select(CampaignSend::DELIVERY_MODES.map { |mode| [delivery_mode_label(mode), mode] }, "email"),
                class: "input w-full",
                data: {
                  "campaign-send-target" => "deliveryMode",
                  action: "change->campaign-send#modeChanged"
                } %>
          <p class="text-sm text-ink-faint mt-1"><%= t("marketing.campaigns.show.delivery_mode_hint") %></p>
        </div>

        <div>
          <label class="label"><%= t("marketing.campaigns.show.person_segment") %></label>
          <%= select_tag :segment_id,
                options_from_collection_for_select(@person_segments, :id, :name),
                include_blank: t("marketing.campaigns.show.select_segment"),
                class: "input w-full",
                required: true,
                data: {
                  "segment-preview-target" => "segmentId",
                  action: "change->segment-preview#segmentChanged"
                } %>
          <p class="text-sm text-ink-faint mt-1">
            <span data-segment-preview-target="count">…</span> <%= t("marketing.campaigns.show.recipients_match") %>
          </p>
        </div>

        <div data-campaign-send-target="journeyField" hidden>
          <label class="label"><%= t("marketing.campaigns.show.journey") %></label>
          <%= select_tag :journey_id,
                options_from_collection_for_select(@journeys, :id, :name),
                include_blank: t("marketing.campaigns.show.select_journey"),
                class: "input w-full",
                data: {
                  "campaign-send-target" => "journeySelect",
                  action: "change->campaign-send#journeyChanged"
                } %>
          <p class="text-sm text-ink-faint mt-1"><%= t("marketing.campaigns.show.journey_hint") %></p>
        </div>

        <p class="text-sm text-danger-strong" data-campaign-send-target="emailWarning" hidden>
          <%= t("marketing.campaigns.show.email_content_warning") %>
        </p>

        <div data-campaign-send-target="emailFields">
          <div>
            <label class="label"><%= t("marketing.campaigns.show.subscription_type") %></label>
            <%= select_tag :subscription_type_id,
                  options_from_collection_for_select(@subscription_types, :id, :name),
                  class: "input w-full" %>
            <p class="text-sm text-ink-faint mt-1"><%= t("marketing.campaigns.show.subscription_hint") %></p>
          </div>

          <fieldset class="space-y-3 border border-line rounded-lg p-3 mt-3">
            <legend class="text-sm font-semibold px-1"><%= t("marketing.campaigns.show.ab_legend") %></legend>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              <div>
                <label class="label"><%= t("marketing.campaigns.show.variant_a_subject") %></label>
                <%= text_field_tag :variant_a_subject, nil, class: "input w-full" %>
              </div>
              <div>
                <label class="label"><%= t("marketing.campaigns.show.variant_a_weight") %></label>
                <%= number_field_tag :variant_a_weight, 50, min: 1, max: 100, class: "input w-full" %>
              </div>
              <div class="md:col-span-2">
                <label class="label"><%= t("marketing.campaigns.show.variant_a_body") %></label>
                <%= text_area_tag :variant_a_body, nil, rows: 3, class: "input w-full resize-y" %>
              </div>
              <div>
                <label class="label"><%= t("marketing.campaigns.show.variant_b_subject") %></label>
                <%= text_field_tag :variant_b_subject, nil, class: "input w-full" %>
              </div>
              <div>
                <label class="label"><%= t("marketing.campaigns.show.variant_b_weight") %></label>
                <%= number_field_tag :variant_b_weight, 50, min: 1, max: 100, class: "input w-full" %>
              </div>
              <div class="md:col-span-2">
                <label class="label"><%= t("marketing.campaigns.show.variant_b_body") %></label>
                <%= text_area_tag :variant_b_body, nil, rows: 3, class: "input w-full resize-y" %>
              </div>
            </div>
            <p class="text-xs text-ink-faint"><%= t("marketing.campaigns.show.ab_override_hint") %></p>
          </fieldset>
        </div>

        <div>
          <label class="label"><%= t("marketing.campaigns.show.schedule_optional") %></label>
          <%= datetime_local_field_tag :scheduled_at, nil, class: "input w-full" %>
          <p class="text-sm text-ink-faint mt-1"><%= t("marketing.campaigns.show.schedule_hint") %></p>
        </div>

        <%= submit_tag t("marketing.campaigns.show.queue_send"), class: "btn-primary",
              data: { "campaign-send-target" => "submit" },
              disabled: !@campaign.email_content_present? %>
      <% end %>
    </div>

    <%= form_with url: send_test_campaign_path(@campaign), method: :post, class: "border-t border-line pt-4 space-y-3 max-w-2xl" do %>
      <h3 class="text-sm font-semibold"><%= t("marketing.campaigns.show.test_heading") %></h3>
      <p class="text-sm text-ink-faint"><%= t("marketing.campaigns.show.test_description") %></p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div>
          <label class="label"><%= t("marketing.campaigns.show.test_subject_optional") %></label>
          <%= text_field_tag :variant_a_subject, nil, class: "input w-full", placeholder: t("marketing.campaigns.show.test_subject_placeholder") %>
        </div>
        <div class="md:col-span-2">
          <label class="label"><%= t("marketing.campaigns.show.test_body_optional") %></label>
          <%= text_area_tag :variant_a_body, nil, rows: 2, class: "input w-full resize-y" %>
        </div>
      </div>
      <%= submit_tag t("marketing.campaigns.show.send_test"), class: "btn-secondary", disabled: !@campaign.email_content_present? %>
    <% end %>
  </section>

  <section class="card p-4">
    <h2 class="font-semibold mb-3"><%= t("marketing.campaigns.show.send_history") %></h2>
    <% if @sends.empty? %>
      <p class="text-sm text-ink-faint"><%= t("marketing.campaigns.show.send_history_empty") %></p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="table-base">
          <thead>
            <tr>
              <th><%= t("marketing.campaigns.show.col_date") %></th>
              <th><%= t("marketing.campaigns.show.col_delivery") %></th>
              <th><%= t("marketing.campaigns.show.col_segment") %></th>
              <th><%= t("marketing.campaigns.show.col_status") %></th>
              <th><%= t("marketing.campaigns.show.col_result") %></th>
              <th><%= t("marketing.campaigns.show.col_variants") %></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @sends.each do |send_record| %>
              <% stats = send_record.stats.to_h.stringify_keys %>
              <tr>
                <td class="text-sm whitespace-nowrap"><%= l send_record.created_at, format: :short %></td>
                <td class="text-sm">
                  <div><%= delivery_mode_label(send_record.delivery_mode) %></div>
                  <% if send_record.journey.present? %>
                    <div class="text-ink-faint"><%= send_record.journey.name %></div>
                  <% end %>
                </td>
                <td class="text-sm"><%= send_record.segment.name %></td>
                <td><%= send_status_badge(send_record.status) %></td>
                <td class="text-sm text-ink-soft">
                  <%= describe_campaign_send_stats(stats, delivery_mode: send_record.delivery_mode) %>
                </td>
                <td class="text-sm">
                  <% if send_record.campaign_variants.any? %>
                    <ul class="space-y-1">
                      <% send_record.campaign_variants.each do |variant| %>
                        <li class="flex flex-wrap items-center gap-1">
                          <strong><%= variant.name %></strong>
                          <% if variant.winner? %><%= badge t("marketing.campaigns.show.winner_badge"), color: "green" %><% end %>
                          <span class="text-ink-faint"><%= truncate(variant.subject, length: 40) %> (<%= variant.weight %>%)</span>
                          <% if send_record.status == "sent" && send_record.campaign_variants.size > 1 && !variant.winner? %>
                            <%= button_to t("marketing.campaigns.show.mark_winner"), mark_winner_campaign_path(@campaign, send_id: send_record.id, variant_id: variant.id),
                                  method: :post, class: "btn-ghost text-xs py-0.5" %>
                          <% end %>
                        </li>
                      <% end %>
                    </ul>
                  <% else %>
                    <span class="text-ink-faint"><%= t("marketing.shared.em_dash") %></span>
                  <% end %>
                </td>
                <td class="text-right whitespace-nowrap">
                  <% if send_record.status.in?(%w[pending scheduled]) %>
                    <%= button_to t("marketing.campaigns.show.cancel_send"), cancel_send_campaign_path(@campaign, send_id: send_record.id),
                          method: :post, class: "btn-ghost text-danger text-sm",
                          form: { data: { turbo_confirm: t("marketing.campaigns.show.cancel_send_confirm") } } %>
                  <% end %>
                  <% if send_record.status == "sent" && send_record.campaign_variants.any?(&:winner?) %>
                    <%= button_to t("marketing.campaigns.show.send_winner_rest"), send_winner_rest_campaign_path(@campaign, send_id: send_record.id),
                          method: :post, class: "btn-secondary text-sm",
                          form: { data: { turbo_confirm: t("marketing.campaigns.show.send_winner_confirm") } } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>

  <% if feature_enabled?(:marketing_attribution) %>
    <%= link_to t("marketing.campaigns.show.view_attribution"), marketing_attribution_path, class: "btn-ghost" %>
  <% end %>
</div>

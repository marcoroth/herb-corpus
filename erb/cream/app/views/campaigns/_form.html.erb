<% form_id = dom_id(campaign, :form) %>
<%= form_with model: campaign, html: { id: form_id }, class: "card p-4 space-y-4 max-w-4xl" do |f| %>
  <% if campaign.errors.any? %>
    <div class="rounded-lg bg-danger-soft text-danger-strong ring-1 ring-danger-line px-3 py-2 text-sm">
      <%= campaign.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, t("marketing.campaigns.form.name"), class: "label" %>
    <%= f.text_field :name, class: "input w-full", placeholder: t("marketing.campaigns.form.name_placeholder") %>
  </div>

  <div>
    <%= f.label :goal, t("marketing.campaigns.form.goal"), class: "label" %>
    <%= f.text_area :goal, class: "input w-full resize-y", rows: 3, placeholder: t("marketing.campaigns.form.goal_placeholder") %>
    <p class="text-sm text-ink-faint mt-1"><%= t("marketing.campaigns.form.goal_hint") %></p>
  </div>

  <div>
    <%= f.label :starts_on, t("marketing.campaigns.form.starts_on"), class: "label" %>
    <%= f.date_field :starts_on, class: "input w-full" %>
  </div>

  <% if campaign.persisted? %>
    <div>
      <%= f.label :status, t("marketing.campaigns.form.status"), class: "label" %>
      <%= f.select :status,
            Campaign::STATUSES.map { |s| [t("marketing.campaign_statuses.#{s}", default: s), s] },
            {}, class: "input w-full" %>
    </div>
  <% end %>

  <fieldset class="space-y-3 border border-line rounded-lg p-3">
    <legend class="text-sm font-semibold px-1"><%= t("marketing.campaigns.form.email_content_legend") %></legend>
    <p class="text-sm text-ink-faint"><%= t("marketing.campaigns.form.email_content_hint") %></p>
    <%= render "shared/email_composer",
          composer_id: dom_id(campaign, :composer),
          source_form_id: form_id,
          email_templates: @email_templates,
          email_layouts: @email_layouts,
          subject_name: "campaign[email_subject]",
          body_name: "campaign[email_body]",
          body_editor_name: "campaign[email_body_editor]",
          email_layout_id_name: "campaign[email_layout_id]",
          email_template_id_name: "campaign[email_template_id]",
          subject: campaign.email_subject,
          body: campaign.email_body,
          body_editor: campaign.effective_email_body_editor,
          email_layout_id: campaign.email_layout_id,
          email_template_id: campaign.email_template_id %>
  </fieldset>

  <fieldset class="space-y-3 border border-line rounded-lg p-3">
    <legend class="text-sm font-semibold px-1"><%= t("marketing.campaigns.form.utm_legend") %></legend>
    <p class="text-sm text-ink-faint"><%= t("marketing.campaigns.form.utm_hint") %></p>
    <div>
      <%= f.label :utm_source, t("marketing.campaigns.form.utm_source"), class: "label" %>
      <%= f.text_field :utm_source, class: "input w-full", placeholder: "newsletter" %>
    </div>
    <div>
      <%= f.label :utm_medium, t("marketing.campaigns.form.utm_medium"), class: "label" %>
      <%= f.text_field :utm_medium, class: "input w-full", placeholder: "email" %>
    </div>
    <div>
      <%= f.label :utm_campaign, t("marketing.campaigns.form.utm_campaign"), class: "label" %>
      <%= f.text_field :utm_campaign, class: "input w-full", placeholder: "marzo-2026" %>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      <div>
        <%= f.label :utm_term, t("marketing.campaigns.form.utm_term"), class: "label" %>
        <%= f.text_field :utm_term, class: "input w-full" %>
      </div>
      <div>
        <%= f.label :utm_content, t("marketing.campaigns.form.utm_content"), class: "label" %>
        <%= f.text_field :utm_content, class: "input w-full" %>
      </div>
    </div>
  </fieldset>

  <%= f.submit campaign.persisted? ? t("marketing.shared.save") : t("marketing.campaigns.form.create"), class: "btn-primary" %>
  <%= link_to t("marketing.shared.cancel"), campaign.persisted? ? campaign_path(campaign) : campaigns_path, class: "btn-secondary ml-2" %>
<% end %>

<%# locals: (payment:, input_class: "input h-7 text-sm w-44") %>
<%= form_with url: match_stripe_payment_path(payment, status: params[:status], q: params[:q].presence),
      method: :post, class: "relative flex items-center gap-1",
      data: { controller: "deal-search", deal_search_url_value: picker_deals_path, deal_search_empty_value: t("integrations.stripe.payments.no_deals") } do %>
  <input type="text" placeholder="<%= t("integrations.stripe.payments.link_deal_placeholder") %>" autocomplete="off"
         class="<%= local_assigns.fetch(:input_class, "input h-7 text-sm w-44") %>"
         data-deal-search-target="input"
         data-action="input->deal-search#query keydown->deal-search#keydown blur->deal-search#hide" />
  <%= hidden_field_tag :deal_id, nil, data: { deal_search_target: "hidden" }, id: nil %>
  <ul data-deal-search-target="menu"
      class="hidden absolute left-0 right-14 top-full z-50 mt-1 max-h-56 overflow-y-auto rounded-md border border-line bg-canvas shadow-sm"></ul>
  <%= submit_tag t("integrations.stripe.payments.link"), class: "btn-secondary", disabled: true, data: { deal_search_target: "submit" } %>
<% end %>

<% page_title t("integrations.stripe.payments.page_title") %>
<% actions = capture do %>
  <%= link_to stripe_connection_path, class: "btn-secondary" do %>
    <%= icon :settings, classes: "size-3.5" %> <%= t("integrations.stripe.payments.settings") %>
  <% end %>
<% end %>
<%= render "shared/page_header", title: t("integrations.stripe.payments.title"), icon_name: :credit_card,
      count: @counts.values.sum, actions: actions %>

<div class="flex-1 flex flex-col min-h-0">
  <div class="flex flex-wrap items-center gap-3 border-b border-line px-5 py-2">
    <nav class="flex gap-1 text-base">
      <% %w[pending_review matched ignored].each do |status| %>
        <%= link_to stripe_payments_path(status: status, q: params[:q].presence),
              class: "px-2.5 py-1 rounded-md #{@status == status ? 'bg-canvas-sunken font-medium text-ink' : 'text-ink-soft hover:bg-canvas-soft'}" do %>
          <%= t("integrations.stripe.payments.status.#{status}") %>
          <span class="text-ink-faint tabular-nums"><%= @counts.fetch(status, 0) %></span>
        <% end %>
      <% end %>
    </nav>
    <%= form_with url: stripe_payments_path, method: :get, class: "md:ml-auto flex items-center gap-2 w-full md:w-auto" do %>
      <%= hidden_field_tag :status, @status %>
      <%= search_field_tag :q, params[:q], placeholder: t("integrations.stripe.payments.search_placeholder"), class: "input h-8 w-full md:w-64" %>
    <% end %>
  </div>

  <div class="flex-1 overflow-auto scrollbar-subtle">
    <% if @connection.nil? %>
      <div class="p-8 text-center text-base text-ink-faint">
        <%= t("integrations.stripe.payments.not_connected") %>
        <%= link_to t("integrations.stripe.payments.connect_link"), stripe_connection_path, class: "text-accent underline" %> <%= t("integrations.stripe.payments.not_connected_hint") %>
      </div>
    <% elsif @payments.empty? %>
      <div class="p-8 text-center text-base text-ink-faint"><%= t("integrations.stripe.payments.empty") %></div>
    <% else %>
      <table class="table-base">
        <thead>
          <tr>
            <th><%= t("integrations.stripe.payments.date") %></th>
            <th class="text-right"><%= t("integrations.stripe.payments.amount") %></th>
            <th><%= t("integrations.stripe.payments.customer") %></th>
            <th><%= t("integrations.stripe.payments.description") %></th>
            <th><%= t("integrations.stripe.payments.deal") %></th>
            <th class="text-right"><%= t("integrations.stripe.payments.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <%= render partial: "payment_row", collection: @payments, as: :payment %>
        </tbody>
      </table>
    <% end %>
  </div>
  <%= render "shared/pagination", pagy: @pagy if @pagy %>
</div>

<%= form_with model: integration, url: integration.persisted? ? slack_integration_path(integration) : slack_integrations_path, class: "card p-4 space-y-3" do |f| %>
  <div>
    <%= f.label :webhook_url, class: "label" %>
    <%= f.url_field :webhook_url, class: "input w-full" %>
  </div>
  <div>
    <span class="label"><%= t("integrations.slack.notify_on") %></span>
    <% SlackIntegration::NOTIFY_EVENTS.each do |event| %>
      <label class="flex items-center gap-2 text-base">
        <%= check_box_tag "slack_integration[notify_events][]", event, integration.notify_events.include?(event) %> <%= event %>
      </label>
    <% end %>
  </div>
  <label class="flex items-center gap-2 text-base"><%= f.check_box :active %> <%= t("integrations.slack.form.active") %></label>
  <%= f.submit class: "btn-primary" %>
<% end %>

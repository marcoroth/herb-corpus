<% page_title t("integrations.slack.page_title") %>
<% actions = capture do %>
  <%= link_to new_slack_integration_path, class: "btn-primary" do %>
    <%= icon :plus, classes: "size-3.5" %> <%= t("integrations.slack.new") %>
  <% end %>
<% end %>
<%= render "shared/page_header", title: t("integrations.slack.title"), icon_name: :message, count: @integrations.size, actions: actions %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5 space-y-3">
  <% @integrations.each do |integration| %>
    <article class="card p-4">
      <div class="flex items-center gap-2">
        <p class="text-base truncate"><%= integration.webhook_url %></p>
        <div class="ml-auto flex gap-2">
          <%= link_to t("integrations.slack.edit"), edit_slack_integration_path(integration), class: "btn-secondary" %>
          <%= button_to slack_integration_path(integration), method: :delete, class: "btn-danger" %>
        </div>
      </div>
      <p class="text-sm text-ink-faint mt-1"><%= integration.notify_events.join(", ") %></p>
    </article>
  <% end %>
</div>

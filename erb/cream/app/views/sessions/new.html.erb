<% page_title t("auth.sign_in.submit") %>
<div class="w-full max-w-sm">
  <div class="text-center mb-6">
    <%= image_tag "/icon.svg", alt: "cream", class: "inline-block size-10 mb-3" %>
    <h1 class="text-xl font-semibold"><%= t("auth.sign_in.title") %><span class="tracking-widest"><span class="text-hoki-500">.</span><span class="text-copperfield-400">.</span><span class="text-golden-300">.</span></span></h1>
    <p class="text-base text-ink-faint mt-1"><%= t("auth.sign_in.subtitle") %></p>
  </div>

  <div class="card p-6 shadow-sm">
    <%= render "shared/google_sign_in" %>

    <div class="relative my-5">
      <div class="absolute inset-0 flex items-center" aria-hidden="true">
        <div class="w-full border-t border-line"></div>
      </div>
      <div class="relative flex justify-center text-sm">
        <span class="bg-canvas-raised px-2 text-ink-faint"><%= t("auth.sign_in.or") %></span>
      </div>
    </div>

    <%= form_with url: session_path, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :email_address, t("auth.sign_in.email"), class: "label" %>
        <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
              placeholder: "you@company.com", value: params[:email_address], class: "input" %>
      </div>
      <div>
        <%= f.label :password, t("auth.sign_in.password"), class: "label" %>
        <%= f.password_field :password, required: true, autocomplete: "current-password",
              placeholder: "••••••••", maxlength: 72, class: "input" %>
      </div>
      <%= f.submit t("auth.sign_in.submit"), class: "btn-primary w-full justify-center" %>
    <% end %>

    <div class="flex items-center justify-between mt-4 text-sm">
      <%= link_to t("auth.sign_in.forgot_password"), new_password_path, class: "text-ink-faint hover:text-ink" %>
      <% if User.public_signup_enabled? %>
        <%= link_to t("auth.sign_in.create_account"), new_registration_path, class: "font-medium text-accent hover:underline" %>
      <% end %>
    </div>
    <p class="mt-3 text-center text-sm">
      <%= link_to t("auth.sign_in.resend_verification"), new_email_verification_path, class: "text-ink-faint hover:text-ink" %>
    </p>
  </div>
</div>

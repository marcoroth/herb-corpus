<% content_for :title, t("client_portal.sessions.title") %>
<div class="mx-auto max-w-lg">
  <div class="card p-6 sm:p-8 space-y-6 shadow-sm">
    <header class="space-y-1 text-center sm:text-left">
      <p class="text-sm font-medium text-accent"><%= @workspace.name %></p>
      <h1 class="text-2xl font-display font-semibold"><%= t("client_portal.sessions.title") %></h1>
      <p class="text-sm text-ink-faint"><%= t("client_portal.sessions.intro") %></p>
    </header>

    <%= form_with url: client_portal_access_request_path(workspace_slug: @workspace.slug), method: :post, class: "space-y-4" do %>
      <div>
        <%= label_tag :email, t("client_portal.sessions.email"), class: "label" %>
        <%= email_field_tag :email, params[:email], required: true, autocomplete: "email", class: "input w-full" %>
      </div>
      <%= submit_tag t("client_portal.sessions.send_link"), class: "btn-primary w-full sm:w-auto" %>
    <% end %>
  </div>
</div>

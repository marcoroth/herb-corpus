<% content_for :title, t("public.email_unsubscribe_confirm.page_title") %>
<% content_for :head do %>
  <meta name="robots" content="noindex, nofollow">
<% end %>

<div class="mx-auto max-w-xl card p-6 space-y-4">
  <p class="text-sm font-medium text-accent"><%= @workspace.name %></p>
  <h1 class="text-2xl font-display font-semibold"><%= t("public.email_unsubscribe_confirm.title") %></h1>
  <p class="text-sm">
    <%= @unsubscribe_params[:all] ? t("public.email_unsubscribe_confirm.body_all", workspace: @workspace.name) : t("public.email_unsubscribe_confirm.body", workspace: @workspace.name) %>
  </p>
  <div class="flex flex-wrap items-center gap-3">
    <%= button_to t("public.email_unsubscribe_confirm.submit"),
          public_email_unsubscribe_path(token: params[:token], **@unsubscribe_params),
          method: :post,
          class: "btn-primary" %>
    <%= link_to t("public.email_unsubscribe_confirm.manage"), public_email_preferences_path(token: params[:token]), class: "text-sm text-accent hover:underline" %>
  </div>
</div>

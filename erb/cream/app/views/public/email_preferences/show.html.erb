<div class="mx-auto max-w-lg">
  <div class="card p-6 sm:p-8 space-y-6 shadow-sm">
    <header class="space-y-1 text-center sm:text-left">
      <p class="text-sm font-medium text-accent"><%= @workspace.name %></p>
      <h1 class="text-2xl font-display font-semibold"><%= t("public.email_preferences.title") %></h1>
      <p class="text-sm text-ink-faint">
        <%= t("public.email_preferences.greeting_html", name: h(@person.display_name), workspace: h(@workspace.name)).html_safe %>
      </p>
    </header>

    <%= form_with url: public_email_preferences_path(token: params[:token]), method: :patch, class: "space-y-4" do %>
      <% @subscription_types.each do |type| %>
        <% subscribed = @subscriptions[type.id]&.subscribed? %>
        <label class="flex items-start gap-3 rounded-lg border border-line p-3 cursor-pointer hover:bg-canvas-sunken/50 has-[:checked]:ring-2 has-[:checked]:ring-accent/30">
          <%= check_box_tag "subscription_type_ids[]", type.id, subscribed, class: "mt-1" %>
          <span>
            <strong class="block text-base"><%= type.name %></strong>
            <% if type.description.present? %>
              <span class="text-sm text-ink-faint"><%= type.description %></span>
            <% end %>
          </span>
        </label>
      <% end %>
      <%= submit_tag t("public.email_preferences.save"), class: "btn-primary w-full sm:w-auto" %>
    <% end %>

    <div class="border-t border-line pt-4">
      <%= button_to t("public.email_preferences.unsubscribe_all"),
            public_email_unsubscribe_path(token: params[:token], all: 1),
            method: :post,
            class: "btn-secondary w-full sm:w-auto",
            form: { data: { turbo_confirm: t("public.email_preferences.unsubscribe_all_confirm", workspace: @workspace.name) } } %>
    </div>
  </div>
</div>

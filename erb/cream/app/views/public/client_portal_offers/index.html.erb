<% content_for :title, t("client_portal.offers.title") %>
<div class="mx-auto max-w-3xl space-y-6">
  <header class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <p class="text-sm font-medium text-accent"><%= @workspace.name %></p>
      <h1 class="text-2xl font-display font-semibold"><%= t("client_portal.offers.title") %></h1>
      <p class="text-sm text-ink-faint"><%= t("client_portal.offers.signed_in_as", email: client_portal_email) %></p>
    </div>
    <%= button_to t("client_portal.sessions.sign_out"),
          client_portal_session_path(workspace_slug: @workspace.slug),
          method: :delete,
          class: "btn-secondary" %>
  </header>

  <% if @offers_by_deal.any? %>
    <% @offers_by_deal.each do |deal, offers| %>
      <section class="card">
        <div class="px-4 py-3 border-b border-line">
          <h2 class="font-semibold"><%= deal.name %></h2>
          <% if deal.company %>
            <p class="text-sm text-ink-faint"><%= deal.company.name %></p>
          <% end %>
        </div>
        <ul class="divide-y divide-line">
          <% offers.each do |offer| %>
            <% current = offer.client_version %>
            <li class="px-4 py-3 flex flex-wrap items-center gap-3">
              <div class="min-w-0 flex-1">
                <p class="font-medium truncate"><%= offer.name %></p>
                <% if current %>
                  <p class="text-xs text-ink-faint">
                    <%= t("offers.version_label", number: current.number) %>
                    · <%= l(current.created_at.to_date, format: :short) %>
                  </p>
                <% end %>
              </div>
              <%= link_to t("client_portal.offers.view"),
                    client_portal_offer_path(workspace_slug: @workspace.slug, id: offer.id),
                    class: "btn-primary",
                    target: "_blank",
                    rel: "noopener" %>
              <%= link_to t("client_portal.offers.share"),
                    share_client_portal_offer_path(workspace_slug: @workspace.slug, id: offer.id),
                    class: "btn-secondary" %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% else %>
    <p class="text-ink-faint"><%= t("client_portal.offers.empty") %></p>
  <% end %>
</div>

<% content_for :title, t("client_portal.deal_invites.title") %>
<div class="mx-auto max-w-lg">
  <div class="card p-6 sm:p-8 space-y-6 shadow-sm">
    <header class="space-y-1 text-center sm:text-left">
      <p class="text-sm font-medium text-accent"><%= @workspace.name %></p>
      <h1 class="text-2xl font-display font-semibold"><%= t("client_portal.deal_invites.title") %></h1>
      <p class="text-sm text-ink-faint"><%= t("client_portal.deal_invites.confirm_intro", deal: @deal.name) %></p>
    </header>

    <%= form_with url: client_portal_deal_portal_invite_access_path(workspace_slug: @workspace.slug, token: @invite_link.token, grant_token: params[:grant_token]),
          method: :post, class: "space-y-6" do %>
      <%= render "shared/client_portal_consent_fields", types: @consent_types, workspace: @workspace %>
      <%= submit_tag t("client_portal.deal_invites.join"), class: "btn-primary w-full sm:w-auto" %>
    <% end %>
  </div>
</div>

<% content_for :title, t("booking.manage.cancel_title") %>
<div class="public-booking mx-auto w-full max-w-lg py-12 px-4">
  <h1 class="public-booking-heading"><%= t("booking.manage.cancel_title") %></h1>
  <div class="public-booking-summary-card mt-6 space-y-2">
    <p class="public-booking-summary-name"><%= @booking.booking_event_type.localized_name(@locale) %></p>
    <p class="public-booking-summary-meta"><%= @booking.localized_starts_at_with_zone(locale: @locale) %></p>
    <p class="text-sm text-ink-soft"><%= @booking.display_name %> · <%= @booking.email %></p>
  </div>
  <% if @cancel_error.present? %>
    <p class="public-booking-alert mt-4"><%= @cancel_error %></p>
  <% end %>
  <p class="mt-6 text-ink-soft"><%= t("booking.manage.cancel_confirm_prompt") %></p>
  <%= form_with url: public_booking_cancel_path(@booking_page.slug, params[:token]), method: :post, class: "mt-6 flex flex-wrap gap-3" do %>
    <%= button_tag t("booking.manage.cancel_confirm"), class: "btn-primary", data: { turbo: false } %>
    <%= link_to t("booking.manage.keep_booking"), public_booking_event_type_path(@booking_page.slug, @booking.booking_event_type.slug), class: "btn-secondary" %>
  <% end %>
</div>

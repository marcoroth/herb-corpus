<% content_for :title, t("client_portal.offer_shares.title") %>
<div class="mx-auto max-w-lg">
  <div class="card p-6 sm:p-8 space-y-6 shadow-sm">
    <header class="space-y-1 text-center sm:text-left">
      <p class="text-sm font-medium text-accent"><%= @share_link.workspace.name %></p>
      <h1 class="text-2xl font-display font-semibold"><%= @share_link.offer.name %></h1>
      <p class="text-sm text-ink-faint"><%= t("client_portal.offer_shares.confirm_intro") %></p>
    </header>

    <%= form_with url: public_offer_share_access_path(token: @share_link.token, grant_token: params[:grant_token]),
          method: :post, class: "space-y-6", data: { turbo: false } do %>
      <%= render "shared/client_portal_consent_fields", types: @consent_types, workspace: @share_link.workspace %>
      <%= submit_tag t("client_portal.offer_shares.open_offer"), class: "btn-primary w-full sm:w-auto" %>
    <% end %>
  </div>
</div>

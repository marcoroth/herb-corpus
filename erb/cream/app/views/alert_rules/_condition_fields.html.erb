<div class="rounded-lg ring-1 ring-line p-3 space-y-3"
     data-nested-form-target="row"
     data-controller="stage-condition-form">
  <%= f.hidden_field :_destroy %>
  <div>
    <%= f.label :field, t("alert_rules.form.condition_field"), class: "label" %>
    <%= f.select :field,
          grouped_options_for_select(AlertCondition.field_options(current_workspace), f.object.field),
          { prompt: t("alert_rules.form.condition_field_prompt") }, class: "input w-full" %>
  </div>
  <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
    <div>
      <%= f.label :operator, t("alert_rules.form.condition_operator"), class: "label" %>
      <%= f.select :operator, FieldCondition.operator_options, {},
            class: "input w-full",
            data: { "stage-condition-form-target" => "operator", action: "stage-condition-form#refresh" } %>
    </div>
    <div data-stage-condition-form-target="compareValue">
      <%= f.label :compare_value, t("alert_rules.form.compare_value"), class: "label" %>
      <%= f.text_field :compare_value, class: "input w-full",
            placeholder: t("alert_rules.form.compare_value_placeholder") %>
    </div>
  </div>
  <div class="flex items-center justify-between gap-2">
    <label class="flex items-center gap-2 text-base"><%= f.check_box :active %> <%= t("alert_rules.form.condition_active") %></label>
    <button type="button" data-action="nested-form#remove" class="btn-ghost text-danger">
      <%= icon :trash, classes: "size-3.5" %> <%= t("alert_rules.form.condition_remove") %>
    </button>
  </div>
</div>

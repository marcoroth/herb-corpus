<% page_title t("alert_rules.index.page_title") %>
<% actions = capture do %>
  <%= link_to new_alert_rule_path, class: "btn-primary" do %>
    <%= icon :plus, classes: "size-3.5" %> <%= t("alert_rules.index.new") %>
  <% end %>
<% end %>
<%= render "shared/page_header", title: t("alert_rules.index.title"), icon_name: :bell, count: @alert_rules.size, actions: actions %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5 space-y-3">
  <% if @alert_rules.empty? %>
    <%= render "shared/empty_state", icon_name: :bell,
          title: t("alert_rules.index.empty_title"),
          subtitle: t("alert_rules.index.empty_subtitle") %>
  <% else %>
    <% @alert_rules.each do |alert_rule| %>
      <article class="card p-4">
        <div class="flex items-center gap-2">
          <h2 class="font-semibold text-base"><%= alert_rule.name %></h2>
          <%= badge alert_rule.active? ? t("alert_rules.index.active") : t("alert_rules.index.inactive"),
                color: alert_rule.active? ? "green" : "chicago" %>
          <div class="ml-auto flex gap-2">
            <%= link_to t("alert_rules.index.edit"), edit_alert_rule_path(alert_rule), class: "btn-secondary" %>
            <%= button_to t("alert_rules.index.destroy"), alert_rule_path(alert_rule), method: :delete, class: "btn-danger" %>
          </div>
        </div>
        <p class="text-sm text-ink-faint mt-1">
          <%= t("alert_rules.index.summary_html",
                trigger: h(alert_rule.trigger_field_label),
                offset: h(alert_rule.offset_summary),
                conditions: h(alert_rule.active_conditions_summary),
                recipient: h(alert_rule.recipient_label)).html_safe %>
        </p>
      </article>
    <% end %>
  <% end %>
</div>

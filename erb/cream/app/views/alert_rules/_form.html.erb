<% page_title alert_rule.persisted? ? t("alert_rules.form.title_edit") : t("alert_rules.form.title_new") %>
<%= render "shared/page_header",
      title: alert_rule.persisted? ? t("alert_rules.form.title_edit") : t("alert_rules.form.title_new"),
      icon_name: :bell, actions: nil %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5">
  <div class="max-w-2xl">
    <%= form_with model: alert_rule, class: "card p-4 space-y-4" do |f| %>
      <% if alert_rule.errors.any? %>
        <div class="text-sm text-red-600">
          <%= alert_rule.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div>
        <%= f.label :name, t("alert_rules.form.name"), class: "label" %>
        <%= f.text_field :name, class: "input w-full", placeholder: t("alert_rules.form.name_placeholder") %>
      </div>

      <div>
        <%= f.label :trigger_field, t("alert_rules.form.date_field"), class: "label" %>
        <%= f.select :trigger_field, AlertRule.trigger_field_options, {}, class: "input w-full" %>
        <p class="text-sm text-ink-faint mt-1"><%= t("alert_rules.form.date_field_hint") %></p>
      </div>

      <div>
        <%= f.label :offset_days, t("alert_rules.form.offset_days"), class: "label" %>
        <%= f.number_field :offset_days, class: "input w-full" %>
        <p class="text-sm text-ink-faint mt-1"><%= t("alert_rules.form.offset_days_hint") %></p>
      </div>

      <div data-controller="nested-form">
        <div class="flex items-center justify-between gap-2 mb-2">
          <div>
            <p class="label"><%= t("alert_rules.form.additional_conditions") %></p>
            <p class="text-sm text-ink-faint"><%= t("alert_rules.form.additional_conditions_hint") %></p>
          </div>
          <button type="button" data-action="nested-form#add" class="btn-secondary shrink-0">
            <%= icon :plus, classes: "size-3.5" %> <%= t("alert_rules.form.add_condition") %>
          </button>
        </div>

        <div data-nested-form-target="list" class="space-y-3">
          <%= f.fields_for :alert_conditions do |cf| %>
            <%= render "condition_fields", f: cf %>
          <% end %>
        </div>

        <template data-nested-form-target="template">
          <%= f.fields_for :alert_conditions, AlertCondition.new(active: true, operator: "eq"),
                child_index: "NEW_RECORD" do |cf| %>
            <%= render "condition_fields", f: cf %>
          <% end %>
        </template>
      </div>

      <div>
        <%= f.label :recipient, t("alert_rules.form.recipient"), class: "label" %>
        <%= f.select :recipient, AlertRule.recipient_options, {}, class: "input w-full" %>
      </div>

      <label class="flex items-center gap-2 text-base"><%= f.check_box :active %> <%= t("alert_rules.form.active") %></label>
      <%= f.submit alert_rule.persisted? ? t("alert_rules.form.submit_update") : t("alert_rules.form.submit_create"),
            class: "btn-primary" %>
      <%= link_to t("alert_rules.form.cancel"), alert_rules_path, class: "btn-secondary ml-2" %>
    <% end %>
  </div>
</div>

<% period = if @config[:date_range] == "all"
  t("report_mailer.scheduled_report.period_all")
else
  t("report_mailer.scheduled_report.period_this.#{@config[:date_range]}")
end %>
<h2><%= @report.name %></h2>
<p style="color:#666;">
  <%= t("report_mailer.scheduled_report.subtitle",
        metric: @result.metric_label,
        group: Report.group_by_label(@config[:group_by]),
        period: period) %>
</p>

<% if @result.rows.empty? %>
  <p><%= t("report_mailer.scheduled_report.empty") %></p>
<% else %>
  <table cellpadding="6" cellspacing="0" style="border-collapse:collapse;">
    <thead>
      <tr>
        <th align="left" style="border-bottom:1px solid #ddd;"><%= Report.group_by_label(@config[:group_by]) %></th>
        <th align="right" style="border-bottom:1px solid #ddd;"><%= @result.metric_label %></th>
      </tr>
    </thead>
    <tbody>
      <% @result.rows.each do |row| %>
        <tr>
          <td><%= row.label %></td>
          <td align="right"><%= @result.metric == "count" ? row.value.to_i : format("%.2f €", row.value) %></td>
        </tr>
      <% end %>
      <tr>
        <td style="border-top:1px solid #ddd;"><strong><%= t("report_mailer.scheduled_report.total") %></strong></td>
        <td align="right" style="border-top:1px solid #ddd;"><strong><%= @result.metric == "count" ? @result.total.to_i : format("%.2f €", @result.total) %></strong></td>
      </tr>
    </tbody>
  </table>
<% end %>

<p style="color:#999;font-size:12px;margin-top:16px;">
  <%= t("report_mailer.scheduled_report.footer", schedule: t("reports.schedules_saved.#{@report.schedule}").downcase) %>
</p>

<%= form_with model: subscription_type, class: "card p-4 space-y-4 max-w-xl" do |f| %>
  <% if subscription_type.errors.any? %>
    <div class="rounded-lg bg-danger-soft text-danger-strong ring-1 ring-danger-line px-3 py-2 text-sm">
      <%= subscription_type.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, t("marketing.shared.name"), class: "label" %>
    <%= f.text_field :name, class: "input w-full", placeholder: "Newsletter" %>
  </div>

  <div>
    <%= f.label :slug, t("marketing.subscription_types.form.slug"), class: "label" %>
    <%= f.text_field :slug, class: "input w-full font-mono", placeholder: "newsletter" %>
    <p class="text-sm text-ink-faint mt-1"><%= t("marketing.subscription_types.form.slug_hint") %></p>
  </div>

  <div>
    <%= f.label :description, t("marketing.shared.description"), class: "label" %>
    <%= f.text_area :description, class: "input w-full resize-y", rows: 3,
          placeholder: t("marketing.subscription_types.form.description_placeholder") %>
    <p class="text-sm text-ink-faint mt-1"><%= t("marketing.subscription_types.form.description_hint") %></p>
  </div>

  <div>
    <%= f.label :description_en, t("marketing.subscription_types.form.description_en"), class: "label" %>
    <%= f.text_area :description_en, class: "input w-full resize-y", rows: 2,
          placeholder: t("marketing.subscription_types.form.description_en_placeholder") %>
    <p class="text-sm text-ink-faint mt-1"><%= t("marketing.subscription_types.form.english_fallback_hint") %></p>
  </div>

  <div>
    <%= f.label :position, t("marketing.subscription_types.form.position"), class: "label" %>
    <%= f.number_field :position, class: "input w-full", min: 0 %>
  </div>

  <div>
    <%= f.label :consent_field_key, t("marketing.subscription_types.form.consent_field_key"), class: "label" %>
    <%= f.text_field :consent_field_key, class: "input w-full font-mono",
          placeholder: "newsletter_opt_in",
          pattern: LeadForm::FIELD_KEY_FORMAT.source,
          title: t("marketing.subscription_types.form.consent_field_title") %>
    <p class="text-sm text-ink-faint mt-1"><%= t("marketing.subscription_types.form.consent_field_hint_html").html_safe %></p>
  </div>

  <div>
    <%= f.label :default_consent_label, t("marketing.subscription_types.form.default_consent_label"), class: "label" %>
    <%= f.text_area :default_consent_label, class: "input w-full resize-y", rows: 2,
          placeholder: t("marketing.subscription_types.form.default_consent_label_placeholder") %>
    <p class="text-sm text-ink-faint mt-1"><%= t("marketing.subscription_types.form.default_consent_label_hint") %></p>
  </div>

  <div>
    <%= f.label :default_consent_label_en, t("marketing.subscription_types.form.default_consent_label_en"), class: "label" %>
    <%= f.text_area :default_consent_label_en, class: "input w-full resize-y", rows: 2,
          placeholder: t("marketing.subscription_types.form.default_consent_label_en_placeholder") %>
    <p class="text-sm text-ink-faint mt-1"><%= t("marketing.subscription_types.form.default_consent_label_en_hint") %></p>
  </div>

  <label class="flex items-center gap-2 text-base">
    <%= f.check_box :active %> <%= t("marketing.shared.active") %>
  </label>

  <label class="flex items-center gap-2 text-base">
    <%= f.check_box :excluded_from_subscribe_all %> <%= t("marketing.subscription_types.form.exclude_subscribe_all") %>
  </label>
  <p class="text-sm text-ink-faint -mt-2"><%= t("marketing.subscription_types.form.exclude_subscribe_all_hint_html").html_safe %></p>

  <% if CreamFeatures.enabled?(:client_portal) %>
    <div>
      <%= f.label :client_portal_consent, t("marketing.subscription_types.form.client_portal_consent"), class: "label" %>
      <%= f.select :client_portal_consent,
            SubscriptionType::CLIENT_PORTAL_CONSENT_OPTIONS.map { |option| [ t("marketing.subscription_types.form.client_portal_consent_options.#{option}"), option ] },
            {}, class: "input w-full" %>
      <p class="text-sm text-ink-faint mt-1"><%= t("marketing.subscription_types.form.client_portal_consent_hint") %></p>
    </div>
  <% end %>

  <%= f.submit subscription_type.persisted? ? t("marketing.shared.save") : t("marketing.subscription_types.form.create"), class: "btn-primary" %>
  <%= link_to t("marketing.shared.cancel"), subscription_types_path, class: "btn-secondary ml-2" %>
<% end %>

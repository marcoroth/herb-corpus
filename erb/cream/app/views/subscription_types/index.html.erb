<% page_title t("marketing.subscription_types.index.page_title") %>
<% actions = capture do %>
  <%= link_to new_subscription_type_path, class: "btn-primary" do %>
    <%= icon :plus, classes: "size-3.5" %> <%= t("marketing.subscription_types.index.new") %>
  <% end %>
<% end %>
<%= render "shared/page_header", title: t("marketing.subscription_types.index.page_title"), icon_name: :mail, count: @subscription_types.size, actions: actions %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5 space-y-3">
  <% if @subscription_types.empty? %>
    <%= render "shared/empty_state", icon_name: :mail, title: t("marketing.subscription_types.index.empty_title"),
          subtitle: t("marketing.subscription_types.index.empty_subtitle") %>
  <% else %>
    <% @subscription_types.each do |type| %>
      <article class="card p-4">
        <div class="flex items-center gap-2 flex-wrap">
          <h2 class="font-semibold text-base"><%= type.name %></h2>
          <%= badge type.active? ? t("marketing.shared.active") : t("marketing.shared.inactive"), color: type.active? ? "green" : "chicago" %>
          <span class="text-sm text-ink-faint font-mono"><%= type.slug %></span>
          <div class="ml-auto flex gap-2">
            <%= link_to t("marketing.shared.edit"), edit_subscription_type_path(type), class: "btn-secondary" %>
            <%= button_to t("marketing.shared.delete"), subscription_type_path(type), method: :delete, class: "btn-danger",
                  form: { data: { turbo_confirm: t("marketing.subscription_types.index.delete_confirm", name: type.name) } } %>
          </div>
        </div>
        <% if type.description.present? %>
          <p class="text-sm text-ink-faint mt-1"><%= type.description %></p>
        <% end %>
      </article>
    <% end %>
  <% end %>
</div>

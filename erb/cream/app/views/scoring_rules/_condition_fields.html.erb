<div class="grid grid-cols-1 md:grid-cols-3 gap-2" data-nested-form-target="row">
  <%= text_field_tag "scoring_rule[conditions][][field]", condition["field"],
        placeholder: "person.lead_score", class: "input w-full" %>
  <%= select_tag "scoring_rule[conditions][][operator]",
        options_for_select(Marketing::ConditionEvaluator.operator_options_for_select, condition["operator"]),
        class: "input w-full" %>
  <%= text_field_tag "scoring_rule[conditions][][compare_value]", condition["compare_value"], class: "input w-full" %>
  <div class="md:col-span-3 text-right">
    <button type="button" data-action="nested-form#remove" class="btn-ghost text-danger text-sm">
      <%= icon :trash, classes: "size-3.5" %> <%= t("marketing.shared.delete_condition") %>
    </button>
  </div>
</div>

<% page_title t("marketing.scoring_rules.index.page_title") %>
<% actions = capture do %>
  <%= button_to t("marketing.scoring_rules.index.recalculate"), recalculate_scoring_rules_path, method: :post, class: "btn-secondary",
        form: { data: { turbo_confirm: t("marketing.scoring_rules.index.recalculate_confirm") } } %>
  <%= link_to new_scoring_rule_path, class: "btn-primary" do %>
    <%= icon :plus, classes: "size-3.5" %> <%= t("marketing.scoring_rules.index.new") %>
  <% end %>
<% end %>
<%= render "shared/page_header", title: t("marketing.scoring_rules.index.page_title"), icon_name: :bar_chart, count: @scoring_rules.size, actions: actions %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5 space-y-3">
  <% if @scoring_rules.empty? %>
    <%= render "shared/empty_state", icon_name: :bar_chart, title: t("marketing.scoring_rules.index.empty_title"),
          subtitle: t("marketing.scoring_rules.index.empty_subtitle") %>
  <% else %>
    <% @scoring_rules.each do |rule| %>
      <article class="card p-4">
        <div class="flex items-center gap-2 flex-wrap">
          <h2 class="font-semibold text-base"><%= rule.name %></h2>
          <%= badge rule.active? ? t("marketing.scoring_rules.index.active") : t("marketing.scoring_rules.index.inactive"), color: rule.active? ? "green" : "chicago" %>
          <div class="ml-auto flex gap-2">
            <%= link_to t("marketing.shared.edit"), edit_scoring_rule_path(rule), class: "btn-secondary" %>
            <%= button_to t("marketing.shared.delete"), scoring_rule_path(rule), method: :delete, class: "btn-danger",
                  form: { data: { turbo_confirm: t("marketing.scoring_rules.index.delete_confirm", name: rule.name) } } %>
          </div>
        </div>
        <p class="text-sm text-ink-faint mt-1">
          <% if rule.event_type.present? %>
            <%= scoring_event_label(rule.event_type) %>
          <% else %>
            <%= t("marketing.shared.any_event") %>
          <% end %>
          · <strong><%= rule.points >= 0 ? "+" : "" %><%= rule.points %></strong> <%= t("marketing.shared.pts") %>
          <% if rule.decay_days.present? && rule.decay_days.positive? %>
            · <%= t("marketing.shared.decay_in_days", count: rule.decay_days) %>
          <% end %>
        </p>
      </article>
    <% end %>
  <% end %>
</div>

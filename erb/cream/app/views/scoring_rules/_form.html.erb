<%= form_with model: scoring_rule, class: "card p-4 space-y-4 max-w-2xl" do |f| %>
  <% if scoring_rule.errors.any? %>
    <div class="rounded-lg bg-danger-soft text-danger-strong ring-1 ring-danger-line px-3 py-2 text-sm">
      <%= scoring_rule.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, t("marketing.shared.name"), class: "label" %>
    <%= f.text_field :name, class: "input w-full", placeholder: t("marketing.scoring_rules.form.name_placeholder") %>
  </div>

  <div>
    <%= f.label :event_type, t("marketing.scoring_rules.form.event_type"), class: "label" %>
    <%= f.select :event_type,
          ScoringRule::EVENT_TYPES.map { |e| [ scoring_event_label(e), e ] },
          { include_blank: t("marketing.shared.any_event") }, class: "input w-full" %>
    <p class="text-sm text-ink-faint mt-1"><%= t("marketing.scoring_rules.form.event_type_hint") %></p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <div>
      <%= f.label :points, t("marketing.scoring_rules.form.points"), class: "label" %>
      <%= f.number_field :points, class: "input w-full" %>
    </div>
    <div>
      <%= f.label :decay_days, t("marketing.scoring_rules.form.decay_days"), class: "label" %>
      <%= f.number_field :decay_days, class: "input w-full", min: 0 %>
      <p class="text-sm text-ink-faint mt-1"><%= t("marketing.scoring_rules.form.decay_hint") %></p>
    </div>
  </div>

  <label class="flex items-center gap-2 text-base"><%= f.check_box :active %> <%= t("marketing.scoring_rules.index.active") %></label>

  <div data-controller="nested-form">
    <div class="flex items-center justify-between gap-2 mb-2">
      <div>
        <p class="label"><%= t("marketing.scoring_rules.form.conditions_heading") %></p>
        <p class="text-sm text-ink-faint"><%= t("marketing.scoring_rules.form.conditions_hint") %></p>
      </div>
      <button type="button" data-action="nested-form#add" class="btn-secondary shrink-0">
        <%= icon :plus, classes: "size-3.5" %> <%= t("marketing.shared.add_condition") %>
      </button>
    </div>

    <div data-nested-form-target="list" class="space-y-3">
      <% Array(scoring_rule.conditions).each do |condition| %>
        <%= render "condition_fields", condition: condition.to_h.stringify_keys %>
      <% end %>
    </div>

    <template data-nested-form-target="template">
      <%= render "condition_fields", condition: {} %>
    </template>
  </div>

  <%= f.submit scoring_rule.persisted? ? t("marketing.shared.save") : t("marketing.scoring_rules.form.create"), class: "btn-primary" %>
  <%= link_to t("marketing.shared.cancel"), scoring_rules_path, class: "btn-secondary ml-2" %>
<% end %>

<%= form_with model: stage_condition,
      url: stage_condition.persisted? ? stage_condition_path(stage_condition) : pipeline_stage_stage_conditions_path(stage),
      html: { data: { controller: "stage-condition-form" } }, class: "card p-4 space-y-4" do |f| %>
  <% if stage_condition.errors.any? %>
    <div class="rounded-lg bg-danger-soft text-danger-strong ring-1 ring-danger-line px-3 py-2 text-sm">
      <%= stage_condition.errors.full_messages.join(". ") %>
    </div>
  <% end %>

  <div>
    <%= f.label :field, t("stage_conditions.form.field"), class: "label" %>
    <%= f.select :field, grouped_options_for_select(StageCondition.field_options(current_workspace), stage_condition.field),
          {}, class: "input w-full" %>
  </div>

  <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
    <div>
      <%= f.label :operator, t("stage_conditions.form.operator"), class: "label" %>
      <%= f.select :operator, FieldCondition.operator_options, {},
            class: "input w-full",
            data: { "stage-condition-form-target" => "operator", action: "stage-condition-form#refresh" } %>
    </div>
    <div data-stage-condition-form-target="compareValue">
      <%= f.label :compare_value, t("stage_conditions.form.compare_value"), class: "label" %>
      <%= f.text_field :compare_value, class: "input w-full",
            placeholder: t("stage_conditions.form.compare_value_placeholder") %>
    </div>
  </div>

  <label class="flex items-center gap-2 text-base"><%= f.check_box :active %> <%= t("stage_conditions.form.active") %></label>
  <%= f.submit stage_condition.persisted? ? t("stage_conditions.form.submit_update") : t("stage_conditions.form.submit_create"),
        class: "btn-primary" %>
<% end %>

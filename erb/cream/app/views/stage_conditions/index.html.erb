<% page_title t("stage_conditions.index.page_title", stage: @stage.name) %>
<% actions = capture do %>
  <%= link_to edit_pipeline_path(@stage.pipeline), class: "btn-secondary" do %>
    <%= icon :arrow_left, classes: "size-3.5" %> <%= t("stage_conditions.index.back_pipeline") %>
  <% end %>
  <%= link_to new_pipeline_stage_stage_condition_path(@stage), class: "btn-primary" do %>
    <%= icon :plus, classes: "size-3.5" %> <%= t("stage_conditions.index.new") %>
  <% end %>
<% end %>
<%= render "shared/page_header",
      title: t("stage_conditions.index.title", stage: @stage.name, pipeline: @stage.pipeline.name),
      icon_name: :lock, count: @stage_conditions.size, actions: actions %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5 space-y-3">
  <p class="text-sm text-ink-faint">
    <%= t("stage_conditions.index.intro_html", stage: h(@stage.name)).html_safe %>
  </p>
  <% if @stage_conditions.empty? %>
    <p class="text-base text-ink-soft"><%= t("stage_conditions.index.empty") %></p>
  <% end %>
  <% @stage_conditions.each do |condition| %>
    <article class="card p-4">
      <div class="flex items-center gap-2">
        <h2 class="font-semibold text-base"><%= condition.field_label %></h2>
        <%= badge condition.active? ? t("stage_conditions.index.active") : t("stage_conditions.index.inactive"),
              color: condition.active? ? "green" : "chicago" %>
        <div class="ml-auto flex gap-2">
          <%= link_to t("stage_conditions.index.edit"), edit_stage_condition_path(condition), class: "btn-secondary" %>
          <%= button_to t("stage_conditions.index.destroy"), stage_condition_path(condition), method: :delete, class: "btn-danger",
                data: { turbo_confirm: t("stage_conditions.index.destroy_confirm") } %>
        </div>
      </div>
      <p class="text-sm text-ink-faint mt-1"><%= condition.describe %></p>
    </article>
  <% end %>
</div>

<div class="mx-auto md:w-2/3 w-full">
  <% if alert = flash[:alert] %>
    <p class="py-2 px-3 bg-danger-soft mb-5 text-danger font-medium rounded-lg inline-block" id="alert"><%= alert %></p>
  <% end %>

  <h1 class="font-bold text-4xl"><%= t("auth.password_reset.title") %></h1>

  <%= form_with url: passwords_path, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: t("auth.password_reset.email_placeholder"), value: params[:email_address], class: "input" %>
    </div>

    <div class="inline">
      <%= form.submit t("auth.password_reset.submit"), class: "btn-primary w-full sm:w-auto justify-center" %>
    </div>
  <% end %>
</div>

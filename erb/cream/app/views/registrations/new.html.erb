<% page_title t("auth.registration.submit") %>
<div class="w-full max-w-sm">
  <div class="text-center mb-6">
    <%= image_tag "/icon.svg", alt: "cream", class: "inline-block size-10 mb-3" %>
    <h1 class="text-xl font-semibold"><%= t("auth.registration.title") %><span class="tracking-widest"><span class="text-hoki-500">.</span><span class="text-copperfield-400">.</span><span class="text-golden-300">.</span></span></h1>
    <p class="text-base text-ink-faint mt-1"><%= t("auth.registration.subtitle") %></p>
  </div>

  <div class="card p-6 shadow-sm">
    <%= render "shared/google_sign_in" %>

    <div class="relative my-5">
      <div class="absolute inset-0 flex items-center" aria-hidden="true">
        <div class="w-full border-t border-line"></div>
      </div>
      <div class="relative flex justify-center text-sm">
        <span class="bg-canvas-raised px-2 text-ink-faint"><%= t("auth.sign_in.or") %></span>
      </div>
    </div>

    <% if @user.errors.any? %>
      <div class="mb-4 rounded-lg bg-danger-soft ring-1 ring-danger-line px-3 py-2 text-sm text-danger-strong">
        <ul class="list-disc list-inside">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: registration_path, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :name, t("auth.registration.name"), class: "label" %>
        <%= f.text_field :name, required: true, autofocus: true, placeholder: t("auth.registration.name_placeholder"), class: "input" %>
      </div>
      <div>
        <%= label_tag :workspace_name, t("auth.registration.workspace_name"), class: "label" %>
        <%= text_field_tag :workspace_name, params[:workspace_name], placeholder: t("auth.registration.workspace_name_placeholder"), class: "input" %>
      </div>
      <div>
        <%= f.label :email_address, t("auth.sign_in.email"), class: "label" %>
        <%= f.email_field :email_address, required: true, autocomplete: "username", placeholder: t("auth.registration.email_placeholder"), class: "input" %>
      </div>
      <div>
        <%= f.label :password, t("auth.sign_in.password"), class: "label" %>
        <%= f.password_field :password, required: true, autocomplete: "new-password", placeholder: t("auth.registration.password_placeholder"), maxlength: 72, class: "input" %>
      </div>
      <div>
        <%= f.label :password_confirmation, t("auth.registration.password_confirmation"), class: "label" %>
        <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
      </div>
      <%= f.submit t("auth.registration.submit"), class: "btn-primary w-full justify-center" %>
    <% end %>

    <p class="mt-4 text-center text-sm text-ink-faint">
      <%= t("auth.registration.already_have_account") %> <%= link_to t("auth.registration.sign_in"), new_session_path, class: "font-medium text-accent hover:underline" %>
    </p>
  </div>
</div>

<% sections = [
  ["overview", t("deals.form.overview.title"), t("deals.form.overview.description")],
  ["relationships", t("deals.form.relationships.title"), t("deals.form.relationships.description")],
  ["management", t("deals.form.management.title"), t("deals.form.management.description")]
] %>
<% sections << ["custom", t("deals.form.custom.title"), t("deals.form.custom.description")] if deal.custom_field_definitions.any? %>
<% sections.select! { |key, _, _| key == @edit_section } if @edit_section %>
<% workspace_actions = "input->record-workspace#markDirty change->record-workspace#markDirty nested-form:changed->record-workspace#markDirty submit->record-workspace#submit turbo:submit-end->record-workspace#submitted turbo:before-visit@document->record-workspace#beforeVisit beforeunload@window->record-workspace#beforeUnload" %>
<% form_data = { controller: "record-workspace", action: workspace_actions, record_workspace_copy: I18n.t("records.record_workspace") } %>
<% if deal.persisted? %>
  <% form_data[:controller] = "deal-stage-celebration record-workspace" %>
  <% form_data[:deal_stage_celebration_initial_stage_id_value] = deal.pipeline_stage_id %>
  <% form_data[:action] = "turbo:submit-end->deal-stage-celebration#onSubmitEnd turbo:before-visit@document->deal-stage-celebration#onBeforeVisit #{workspace_actions}" %>
<% end %>
<%= form_with model: deal, class: "space-y-5", data: form_data do |f| %>
  <%= hidden_field_tag :section, @edit_section if @edit_section %>
  <%= hidden_field_tag :stripe_payment_id, @stripe_payment.id if @stripe_payment %>
  <% if deal.errors.any? %>
    <div role="alert" class="rounded-lg bg-danger-soft ring-1 ring-danger-line px-4 py-3 text-sm text-danger-strong">
      <p class="font-semibold mb-1"><%= t("shared.form.check_errors") %></p>
      <ul class="list-disc list-inside"><% deal.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
    </div>
  <% end %>
  <% sections.each do |key, title, description| %>
    <section class="record-card" aria-labelledby="record-edit-<%= key %>">
      <h2 id="record-edit-<%= key %>" class="record-section-title"><%= title %></h2>
      <p class="text-sm text-ink-soft mt-1 mb-5"><%= description %></p>
      <div class="space-y-4"><%= render "form_#{key}", f: f, deal: deal %></div>
    </section>
  <% end %>

  <% if deal.new_record? && !@edit_section %>
    <div data-controller="nested-form" class="record-card">
      <div class="flex items-center justify-between mb-2">
        <h2 class="record-section-title"><%= t("deals.form.products.title") %></h2>
        <% if current_workspace.products.any? %>
          <button type="button" data-action="nested-form#add" class="btn-secondary"><%= icon :plus, classes: "size-3.5" %> <%= t("deals.show.add_product") %></button>
        <% end %>
      </div>
      <% if current_workspace.products.any? %>
        <div data-nested-form-target="list" class="space-y-2">
          <%= f.fields_for :deal_products do |pf| %><%= render "product_fields", f: pf %><% end %>
        </div>
        <template data-nested-form-target="template">
          <%= f.fields_for :deal_products, DealProduct.new, child_index: "NEW_RECORD" do |pf| %><%= render "product_fields", f: pf %><% end %>
        </template>
      <% else %>
        <p class="text-base text-ink-faint"><%= t("deals.form.products.empty_html", link: link_to(t("deals.form.products.create_one"), new_product_path, class: "text-accent hover:underline")).html_safe %></p>
      <% end %>
    </div>

    <div class="record-card">
      <h2 class="record-section-title mb-4"><%= t("deals.form.next_action.title") %></h2>
      <%= f.fields_for :tasks, (deal.tasks.first || deal.tasks.build) do |tf| %>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-[1fr_12rem]">
          <div>
            <%= tf.label :title, t("deals.form.next_action.task"), class: "label" %>
            <%= mention_text_field tf, :title, wrapper_class: "", class: "input", placeholder: t("people.quick_deal.task_placeholder") %>
          </div>
          <div>
            <%= tf.label :due_on, t("activerecord.attributes.task.due_on"), class: "label" %>
            <%= tf.date_field :due_on, class: "input", min: Date.current %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="sticky bottom-0 flex items-center justify-end gap-2 border-t border-line bg-canvas-raised px-4 py-4 rounded-xl">
    <%= link_to t("shared.form.cancel"), deal.persisted? ? deal_path(deal, tab: "information") : board_deals_path, class: "btn-secondary" %>
    <%= f.submit deal.persisted? ? t("shared.form.save_changes") : t("shared.form.create_deal"), class: "btn-primary" %>
  </div>
<% end %>

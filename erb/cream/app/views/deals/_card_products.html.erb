<%# locals: deal: — product lines on the kanban card %>
<ul class="mt-1.5 space-y-0.5">
  <% deal.deal_products.each do |line| %>
    <li class="text-xs text-ink-faint truncate">
      <span class="text-ink-soft"><%= line.product.name %></span>
      <% if line.edition %>
        <span class="text-ink-faint"> · <%= line.edition.name %></span>
      <% end %>
      <% if line.quantity > 1 %>
        <span class="text-ink-faint tabular-nums"> ×<%= line.quantity %></span>
      <% end %>
    </li>
  <% end %>
</ul>

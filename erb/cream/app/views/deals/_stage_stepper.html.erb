<div id="deal_stage_stepper"
     data-controller="deal-stage-celebration"
     data-action="turbo:submit-end->deal-stage-celebration#onSubmitEnd">
  <h3 class="text-sm font-semibold uppercase tracking-wider text-ink-faint mb-2">
    <%= t("deals.show.move_to_stage") %> <span class="font-normal normal-case">· <%= deal.pipeline.name %></span>
  </h3>
  <div class="flex flex-wrap gap-1.5">
    <% deal.pipeline.pipeline_stages.ordered.each do |stage| %>
      <% if stage.id == deal.pipeline_stage_id %>
        <%= badge stage.name, color: stage.color %>
      <% else %>
        <%= button_to move_deal_path(deal, pipeline_stage_id: stage.id, source: "show"), method: :patch,
              class: "inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset ring-line-strong text-ink-faint bg-canvas-raised hover:bg-canvas-sunken hover:text-ink cursor-pointer",
              form: { data: { stage_won: stage.won?, stage_closed: stage.closed? } } do %>
          <%= stage.name %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>

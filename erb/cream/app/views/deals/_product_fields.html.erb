<div class="grid grid-cols-[1fr_minmax(10rem,1fr)_5rem_auto] gap-2 items-end rounded-lg ring-1 ring-transparent hover:ring-line p-1"
     data-nested-form-target="row"
     data-controller="product-edition-picker"
     data-product-edition-picker-search-url-template-value="<%= picker_product_editions_path(product_id: "__PRODUCT_ID__", format: :json) %>"
     data-product-edition-picker-create-url-template-value="<%= product_editions_path(product_id: "__PRODUCT_ID__", format: :json) %>">
  <%= f.collection_select :product_id, current_workspace.products.ordered, :id, :name,
        { prompt: t("deals.show.select_product") }, class: "input",
        data: {
          product_edition_picker_target: "productSelect",
          action: "change->product-edition-picker#productChanged"
        } %>
  <%= render "edition_picker", form: f, compact: true, managed: true %>
  <%= f.number_field :quantity, value: f.object.quantity || 1, min: 1, step: 1, class: "input" %>
  <%= f.hidden_field :_destroy %>
  <button type="button" data-action="nested-form#remove" class="text-ink-faint hover:text-danger p-1.5 mb-0.5" title="<%= t("deals.form.products.remove_title") %>">
    <%= icon :trash, classes: "size-3.5" %>
  </button>
</div>

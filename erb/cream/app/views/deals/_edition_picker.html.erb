<%# locals: form, product: nil, compact: false, managed: false %>
<% product ||= form.object.product if form.object.respond_to?(:product) && form.object.product&.persisted? %>
<% search_url = product ? picker_product_editions_path(product, format: :json) : "" %>
<% create_url = product ? product_editions_path(product, format: :json) : "" %>
<% selected = form.object.respond_to?(:edition) ? form.object.edition&.name : nil %>
<% dynamic = product.nil? %>
<div class="<%= "min-w-36 [&_.label]:hidden" if local_assigns[:compact] %>"
     <% if dynamic && !local_assigns[:managed] %>
     data-controller="product-edition-picker"
     data-product-edition-picker-search-url-template-value="<%= picker_product_editions_path(product_id: "__PRODUCT_ID__", format: :json) %>"
     data-product-edition-picker-create-url-template-value="<%= product_editions_path(product_id: "__PRODUCT_ID__", format: :json) %>"
     <% end %>>
  <%= render RecordPickerComponent.new(
        form: form,
        attribute: :edition_id,
        label: t("deals.show.edition"),
        scope: product ? product.editions.ordered : Edition.none,
        search_url: search_url,
        create_url: create_url,
        create_param: "edition",
        selected_name: selected,
        hint_method: :date_range_label,
        disabled: dynamic
      ) %>
</div>

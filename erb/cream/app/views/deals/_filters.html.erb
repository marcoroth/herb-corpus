<% if local_assigns.fetch(:show_stage, true) %>
  <%= select_tag :stage,
        grouped_options_for_select(stage_filter_options(@pipelines, include_closed: show_closed?), filter_value(:stage)&.to_i),
        include_blank: t("shared.lists.all_stages"), class: "input w-44",
        data: { controller: "submit-on-change", action: "change->submit-on-change#submit" } %>
<% end %>
<%= select_tag :owner_id,
      options_for_select([ [ t("shared.lists.unassigned"), ListFilters::NONE ] ] + @owners.map { |owner| [ owner.name, owner.id ] }, filter_value(:owner_id)),
      include_blank: t("shared.lists.all_owners"), class: "input w-44",
      data: { controller: "submit-on-change", action: "change->submit-on-change#submit" } %>
<%= select_tag :product_id,
      options_from_collection_for_select(@products, :id, :name, filter_value(:product_id)),
      include_blank: t("shared.lists.all_products"), class: "input w-44",
      data: { controller: "submit-on-change", action: "change->submit-on-change#submit" } %>
<%= select_tag :edition_id,
      grouped_options_for_select(@edition_groups, filter_value(:edition_id)),
      include_blank: t("shared.lists.all_editions"), class: "input w-44",
      data: { controller: "submit-on-change", action: "change->submit-on-change#submit" } %>
<%= render "shared/date_range_filter", label: t("shared.lists.first_contact"), from: :first_contact_from, to: :first_contact_to %>
<%= render "shared/date_range_filter", label: t("shared.lists.created"), from: :created_from, to: :created_to %>

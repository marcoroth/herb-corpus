<% page_title t("deals.new.title") %>
<%= render "shared/page_header", title: t("deals.new.title"), icon_name: :banknote, count: nil, actions: nil %>
<div class="flex-1 overflow-y-auto bg-canvas-soft/50 p-4 sm:p-6">
  <div class="max-w-2xl mx-auto space-y-3">
    <%= link_to t("deals.new.back"), board_deals_path, class: "inline-block text-sm text-ink-soft hover:text-accent mb-5" %>
    <% if @stripe_payment %>
      <div class="record-card text-sm text-ink-soft">
        <%= t("deals.form.stripe_payment_html",
              amount: number_to_currency(@stripe_payment.amount_decimal,
                unit: @stripe_payment.currency.casecmp?("eur") ? "€" : @stripe_payment.currency.upcase,
                precision: 2),
              customer: @stripe_payment.customer_email || @stripe_payment.customer_name) %>
      </div>
    <% end %>
    <%= render "form", deal: @deal %>
  </div>
</div>

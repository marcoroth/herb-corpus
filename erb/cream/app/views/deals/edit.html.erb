<% page_title t("deals.edit.title", name: @deal.name) %>
<%= render "shared/page_header", title: t("deals.edit.title", name: @deal.name), icon_name: :banknote, count: nil, actions: nil %>
<div class="flex-1 overflow-y-auto bg-canvas-soft/50 p-4 sm:p-6">
  <div class="max-w-2xl mx-auto">
    <%= link_to t("deals.edit.back"), deal_path(@deal, tab: "information"), class: "inline-block text-sm text-ink-soft hover:text-accent mb-5" %>
    <%= render "form", deal: @deal %>
  </div>
</div>

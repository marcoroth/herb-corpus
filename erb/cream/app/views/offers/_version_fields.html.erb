<%# locals: (f:) %>
<div>
  <%= f.label :file, t("offers.form.file"), class: "label" %>
  <%= f.file_field :file, accept: "application/pdf,text/html,application/zip,.pdf,.html,.htm,.zip", class: "file-input w-full" %>
  <p class="mt-1 text-xs text-ink-faint"><%= t("offers.form.file_hint") %></p>
</div>

<p class="text-xs uppercase tracking-wider text-ink-faint text-center"><%= t("offers.form.or") %></p>

<div>
  <%= f.label :html_body, t("offers.form.html_body"), class: "label" %>
  <%= f.text_area :html_body, rows: 16, class: "input w-full font-mono text-xs", spellcheck: false,
        placeholder: t("offers.form.html_body_placeholder") %>
  <p class="mt-1 text-xs text-ink-faint"><%= t("offers.form.html_body_hint") %></p>
</div>

<div>
  <%= f.label :comment, t("offers.form.comment"), class: "label" %>
  <%= f.text_field :comment, class: "input w-full", placeholder: t("offers.form.comment_placeholder") %>
</div>

<% page_title t("offers.new.title") %>
<%= render "shared/page_header", title: t("offers.new.title"), icon_name: :banknote, count: nil, actions: nil %>
<div class="flex-1 overflow-y-auto bg-canvas-soft/50 p-4 sm:p-6">
  <div class="max-w-3xl mx-auto space-y-3">
    <%= link_to t("offers.new.back", deal: @deal.name), deal_path(@deal, tab: "offers"), class: "inline-block text-sm text-ink-soft hover:text-accent mb-5" %>

    <%= form_with model: @offer, url: deal_offers_path(@deal), class: "card p-4 space-y-4", multipart: true do |f| %>
      <% errors = (@offer.errors.full_messages + @version.errors.full_messages).uniq %>
      <% if errors.any? %>
        <div class="rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800">
          <%= errors.to_sentence %>
        </div>
      <% end %>

      <div>
        <%= f.label :name, t("offers.form.name"), class: "label" %>
        <%= f.text_field :name, class: "input w-full", placeholder: t("offers.form.name_placeholder") %>
        <p class="mt-1 text-xs text-ink-faint"><%= t("offers.form.name_hint") %></p>
      </div>

      <%= fields_for :offer_version, @version do |vf| %>
        <%= render "offers/version_fields", f: vf %>
      <% end %>

      <p class="text-sm text-ink-soft"><%= t("offers.form.draft_hint") %></p>

      <div class="flex gap-2">
        <%= f.submit t("offers.form.submit"), class: "btn-primary" %>
        <%= link_to t("shared.form.cancel"), deal_path(@deal, tab: "offers"), class: "btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>

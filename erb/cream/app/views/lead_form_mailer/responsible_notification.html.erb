<p><%= t("lead_form_mailer.responsible_notification.greeting", name: @responsible.name) %></p>

<p><%= t("lead_form_mailer.responsible_notification.intro_html", form_name: @lead_form.name) %></p>

<h2><%= t("lead_form_mailer.responsible_notification.form_data_heading") %></h2>
<ul>
  <% @data.each do |key, value| %>
    <li><strong><%= key.humanize %>:</strong> <%= value %></li>
  <% end %>
</ul>

<% if @metadata.present? %>
  <h2><%= t("lead_form_mailer.responsible_notification.metadata_heading") %></h2>
  <ul>
    <% @metadata.each do |key, value| %>
      <li><strong><%= key.humanize %>:</strong> <%= value %></li>
    <% end %>
  </ul>
<% end %>

<p>
  <%= link_to t("lead_form_mailer.responsible_notification.footer_deal_link"), deal_url(@deal) %>
</p>

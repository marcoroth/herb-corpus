<%= t("lead_form_mailer.responsible_notification.greeting", name: @responsible.name) %>

<%= t("lead_form_mailer.responsible_notification.intro_text", form_name: @lead_form.name) %>

<%= t("lead_form_mailer.responsible_notification.form_data_heading") %>:
<% @data.each do |key, value| %>
- <%= key.humanize %>: <%= value %>
<% end %>

<% if @metadata.present? %>
<%= t("lead_form_mailer.responsible_notification.metadata_heading") %>:
<% @metadata.each do |key, value| %>
- <%= key.humanize %>: <%= value %>
<% end %>
<% end %>

<%= t("lead_form_mailer.responsible_notification.footer_deal_link") %>: <%= deal_url(@deal) %>

<div class="record-information-grid">
  <section class="record-card">
    <div class="record-card-heading"><h2 class="record-section-title"><%= t("people.show.details") %></h2><%= link_to t("records.edit"), edit_person_path(@person, section: "contact"), class: "btn-ghost", aria: { label: t("people.show.edit_details") } %></div>
    <div class="divide-y divide-line/60">
      <%= render "emails_section", person: @person %>
      <%= render "shared/attribute", label: t("records.fields.phone"), icon_name: :phone, value: @person.phone %>
      <%= render "shared/attribute", label: t("records.fields.location"), icon_name: :map_pin, value: @person.location %>
    </div>
  </section>
  <section class="record-card">
    <div class="record-card-heading"><h2 class="record-section-title"><%= t("people.show.professional") %></h2><%= link_to t("records.edit"), edit_person_path(@person, section: "profile"), class: "btn-ghost", aria: { label: t("people.show.edit_profile") } %></div>
    <div class="divide-y divide-line/60">
      <%= render "shared/attribute", label: t("records.fields.job_title"), icon_name: :users, value: @person.job_title %>
      <%= render "shared/attribute", label: t("records.fields.company"), icon_name: :building, value: @person.company ? link_to(@person.company.name, company_path(@person.company), class: "text-accent hover:underline") : nil %>
      <%= render "shared/attribute", label: t("records.fields.linkedin"), icon_name: :external, value: @person.linkedin_url.present? ? safe_http_url_link(@person.linkedin_url, t("records.profile_link")) : nil %>
      <%= render "shared/attribute", label: t("records.fields.twitter"), icon_name: :external, value: @person.twitter_url.present? ? safe_http_url_link(@person.twitter_url, t("records.profile_link")) : nil %>
    </div>
    <% if @person.description.present? %><p class="mt-4 text-sm text-ink-soft whitespace-pre-wrap break-words"><%= @person.description %></p><% end %>
  </section>
  <section class="record-card">
    <div class="record-card-heading"><h2 class="record-section-title"><%= t("people.show.notes") %></h2><%= link_to t("records.edit"), edit_person_path(@person, section: "internal_notes"), class: "btn-ghost", aria: { label: t("people.show.edit_notes") } %></div>
    <% if @person.internal_notes.present? %>
      <p class="text-sm text-ink-soft whitespace-pre-wrap break-words"><%= @person.internal_notes %></p>
    <% else %>
      <p class="text-sm text-ink-soft"><%= t("people.show.no_notes") %></p>
    <% end %>
  </section>
  <section class="record-card">
    <div class="record-card-heading"><h2 class="record-section-title"><%= t("people.show.contact_management") %></h2><%= link_to t("records.edit"), edit_person_path(@person, section: "management"), class: "btn-ghost", aria: { label: t("people.show.edit_management") } %></div>
    <%= render "shared/attribute", label: t("records.fields.owner"), icon_name: :users, value: @person.owner&.name %>
    <%= render "shared/attribute", label: t("records.fields.created"), icon_name: :clock, value: l(@person.created_at, format: :short) %>
    <% if @person.lists.any? %>
      <h3 class="text-sm font-medium mt-4 mb-2"><%= t("records.fields.lists") %></h3>
      <div class="flex flex-wrap gap-2"><% @person.lists.each do |list| %><%= link_to list.name, list_path(list), class: "record-count hover:text-accent" %><% end %></div>
    <% end %>
  </section>
  <section class="record-card"><%= render "relationships_section", person: @person %></section>
  <% if @person.custom_field_definitions.any? %>
    <section class="record-card">
      <div class="record-card-heading"><h2 class="record-section-title"><%= t("records.fields.custom_fields") %></h2><%= link_to t("records.edit"), edit_person_path(@person, section: "custom"), class: "btn-ghost", aria: { label: t("people.show.edit_custom") } %></div>
      <%= render "shared/custom_attributes", record: @person %>
    </section>
  <% end %>
  <% if feature_enabled?(:marketing_consent) %><section class="record-card"><h2 class="record-section-title mb-4"><%= t("people.show.email_preferences") %></h2><%= render "subscriptions_section", person: @person %></section><% end %>
  <% if feature_enabled?(:lead_forms) && @person.lead_submissions.any? %>
    <section class="record-card"><%= render "lead_submissions_section", person: @person %></section>
  <% end %>
</div>

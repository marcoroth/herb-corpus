<% page_title t("people.duplicates.title") %>
<% actions = capture do %>
  <%= link_to people_path, class: "btn-secondary" do %>
    <%= icon :users, classes: "size-3.5" %> <%= t("people.duplicates.all_people") %>
  <% end %>
<% end %>
<%= render "shared/page_header", title: t("people.duplicates.title"), icon_name: :users, count: @groups.size, actions: actions %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5">
  <% if @groups.any? %>
    <div class="space-y-4 max-w-4xl">
      <% @groups.each do |group| %>
        <% primary = group.people.first %>
        <section class="card p-4">
          <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
            <div>
              <h2 class="text-base font-semibold"><%= group.email %></h2>
              <p class="text-sm text-ink-faint"><%= group.company_label %></p>
            </div>
            <%= link_to merge_person_path(primary, secondary_ids: group.people.drop(1).map(&:id)),
                  class: "btn-primary" do %>
              <%= icon :users, classes: "size-3.5" %> <%= t("people.duplicates.review_merge") %>
            <% end %>
          </div>

          <ul class="divide-y divide-line/60">
            <% group.people.each do |person| %>
              <li class="flex items-center justify-between gap-3 py-2.5">
                <div class="flex items-center gap-3 min-w-0">
                  <%= avatar person %>
                  <div class="min-w-0">
                    <p class="font-medium truncate">
                      <%= link_to person.display_name, person_path(person), class: "hover:text-accent" %>
                    </p>
                    <p class="text-sm text-ink-faint truncate">
                      <%= [ person.job_title, person.phone ].compact_blank.join(" · ") %>
                    </p>
                  </div>
                </div>
                <div class="text-sm text-ink-faint shrink-0">
                  <% if person == primary %>
                    <span class="badge"><%= t("people.duplicates.keep_by_default") %></span>
                  <% end %>
                  <%= t("deals.index.count", count: person.deals.size) %>
                </div>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/empty_state", icon_name: :users, title: t("people.duplicates.empty_title"),
          subtitle: t("people.duplicates.empty_subtitle") %>
  <% end %>
</div>

<% page_title t("people.interest_conversion.title") %>
<%= render "shared/page_header", title: t("people.interest_conversion.title"), subtitle: @person.display_name, icon_name: :zap %>

<div class="card p-6 max-w-xl space-y-4">
  <div class="rounded-lg border border-line bg-canvas-sunken/40 p-3 text-sm">
    <p><strong><%= t("people.interest_conversion.product") %>:</strong> <%= @interest.product.name %></p>
    <p><strong><%= t("people.interest_conversion.signal") %>:</strong> <%= @interest.description %></p>
    <p><strong><%= t("records.fields.created") %>:</strong> <%= l(@interest.occurred_at, format: :short) %></p>
  </div>

  <%= form_with url: person_product_interest_conversion_path(@person, @interest), class: "space-y-4" do |f| %>
    <div>
      <%= label_tag "conversion[pipeline_id]", t("records.fields.pipeline"), class: "label" %>
      <%= select_tag "conversion[pipeline_id]",
            options_from_collection_for_select(@pipelines, :id, :name, @default_pipeline&.id),
            required: true, class: "input w-full" %>
    </div>
    <div>
      <%= label_tag "conversion[name]", t("people.interest_conversion.deal_name"), class: "label" %>
      <%= text_field_tag "conversion[name]", "#{@person.company.name} — #{@interest.product.name}", class: "input w-full" %>
    </div>
    <div>
      <%= label_tag "conversion[task_title]", t("people.interest_conversion.next_action"), class: "label" %>
      <%= text_field_tag "conversion[task_title]", t("people.interest_conversion.task_title_default", product: @interest.product.name), required: true, class: "input w-full" %>
    </div>
    <div>
      <%= label_tag "conversion[task_due_on]", t("people.interest_conversion.task_due"), class: "label" %>
      <%= date_field_tag "conversion[task_due_on]", Date.current + 3.days, min: Date.current, required: true, class: "input w-full" %>
    </div>
    <div class="flex gap-2 justify-end">
      <%= link_to t("people.interest_conversion.cancel"), @person, class: "btn-secondary" %>
      <%= submit_tag t("people.interest_conversion.create"), class: "btn-primary" %>
    </div>
  <% end %>
</div>

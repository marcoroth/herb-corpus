<%# locals: (person:, deal: nil) %>
<% default_pipeline = current_pipeline || Pipeline.default_for(current_workspace) %>
<% deal ||= current_workspace.deals.new.tap { |d|
  d.pipeline = default_pipeline
  d.pipeline_stage = default_pipeline&.first_stage
  d.deal_products.build(quantity: 1)
  d.tasks.build(due_on: Task.default_due_on)
} %>
<div data-controller="task-edit">
  <button type="button" class="btn-secondary" data-action="task-edit#open">
    <%= icon :plus, classes: "size-3.5" %> <%= t("records.add_deal") %>
  </button>

  <dialog data-task-edit-target="dialog" class="modal-dialog max-w-md rounded-xl border border-line shadow-lg backdrop:bg-chicago-950/40">
    <%= render "people/quick_deal_form", person: person, deal: deal %>
  </dialog>
</div>

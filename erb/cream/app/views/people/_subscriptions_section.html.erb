<% if feature_enabled?(:marketing_consent) && person.email.present? %>
  <% token = Marketing::PreferenceToken.generate(person: person) %>
  <% prefs_url = public_email_preferences_url(token: token) %>
  <% subscriptions_by_type = person.email_subscriptions.includes(:subscription_type).index_by(&:subscription_type_id) %>
  <% SubscriptionType.ensure_defaults!(current_workspace) %>

  <div class="px-1 py-1.5">
    <div class="flex items-center gap-2 w-32 shrink-0 text-sm text-ink-faint mb-2">
      <%= icon :mail, classes: "size-3.5" %>
      <%= t("people.show.subscriptions") %>
    </div>

    <div class="space-y-2 pl-0">
      <% current_workspace.subscription_types.active.ordered.each do |type| %>
        <% subscription = subscriptions_by_type[type.id] %>
        <% status = subscription&.status || "missing" %>
        <% evidence = subscription&.consent_evidence || {} %>
        <div class="flex flex-wrap items-center gap-2 py-1">
          <span class="text-base text-ink min-w-[8rem]"><%= type.name %></span>
          <%= subscription_status_badge(status) %>
          <%= button_to toggle_subscription_person_path(person, subscription_type_id: type.id),
                method: :patch,
                class: "btn-ghost text-xs py-0.5",
                form: { data: { turbo_confirm: status == "subscribed" ? t("people.show.unsubscribe_confirm", name: person.display_name, type: type.name) : t("people.show.subscribe_confirm", name: person.display_name, type: type.name) } } do %>
            <%= status == "subscribed" ? t("people.show.unsubscribe") : t("people.show.subscribe") %>
          <% end %>
        </div>
        <% if evidence["marketing_consent_text"].present? %>
          <details class="text-sm pl-1 pb-1">
            <summary class="cursor-pointer text-accent"><%= t("people.show.view_consent") %></summary>
            <div class="mt-2 space-y-1 rounded-lg border border-line bg-canvas-sunken/40 p-3">
              <p><span class="text-ink-faint"><%= t("people.show.consent_text") %></span> <%= evidence["marketing_consent_text"] %></p>
              <p><span class="text-ink-faint"><%= t("people.show.consent_source") %></span> <%= evidence["consent_source"] %></p>
              <% consented_at = evidence["consent_obtained_at"].presence || subscription.opted_in_at&.iso8601 %>
              <% if consented_at.present? %>
                <p><span class="text-ink-faint"><%= t("people.show.consent_date") %></span> <%= (l(Time.zone.parse(consented_at), format: :long) rescue consented_at) %></p>
              <% end %>
              <% if evidence["consent_ip"].present? %>
                <p><span class="text-ink-faint"><%= t("people.show.consent_ip") %></span> <%= evidence["consent_ip"] %></p>
              <% end %>
              <% if evidence["recorded_by"].present? %>
                <p><span class="text-ink-faint"><%= t("people.show.consent_recorded_by") %></span> <%= evidence["recorded_by"] %> (<%= subscription.source %>)</p>
              <% end %>
            </div>
          </details>
        <% end %>
      <% end %>
    </div>

    <div class="mt-3 pt-2 border-t border-line/60" data-controller="clipboard">
      <p class="text-sm text-ink-faint mb-1"><%= t("people.show.preferences_center") %></p>
      <div class="relative">
        <input type="text" readonly value="<%= prefs_url %>"
              class="input w-full text-xs font-mono bg-canvas-sunken pr-24 cursor-default"
              data-clipboard-target="source" tabindex="-1" aria-readonly="true" />
        <div class="absolute top-1.5 right-1.5 flex items-center gap-1">
          <span data-clipboard-target="feedback"
                class="hidden rounded-md bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700 dark:bg-green-950 dark:text-green-300"
                role="status" aria-live="polite"><%= t("people.show.copied") %></span>
          <button type="button" class="rounded-md p-1.5 text-ink-faint hover:text-ink hover:bg-canvas-raised"
                title="<%= t("people.show.copy_url") %>" aria-label="<%= t("people.show.copy_url") %>"
                data-action="clipboard#copy" data-clipboard-target="button">
            <span data-clipboard-target="copyIcon"><%= icon :copy, classes: "size-4" %></span>
            <span data-clipboard-target="copiedIcon" class="hidden"><%= icon :check, classes: "size-4" %></span>
          </button>
        </div>
      </div>
    </div>
  </div>
<% end %>

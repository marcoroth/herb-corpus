<%# locals: (message:, expanded: false) %>
<% campaign = message.campaign %>
<li class="<%= expanded ? "rounded-md border border-line px-3 py-2" : "" %>">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="font-medium break-words">
        <% if campaign %>
          <% if policy(campaign).show? %>
            <%= link_to campaign.name, campaign_path(campaign), class: "hover:text-accent hover:underline" %>
          <% else %>
            <%= campaign.name %>
          <% end %>
        <% else %>
          <%= message.subject %>
        <% end %>
      </p>
      <% if campaign && message.subject.present? && message.subject != campaign.name %>
        <p class="text-sm text-ink-soft break-words"><%= message.subject %></p>
      <% end %>
      <p class="text-xs text-ink-faint mt-1"><%= l(message.created_at, format: :short) %></p>
    </div>
    <div class="shrink-0"><%= campaign_engagement_badge(message) %></div>
  </div>
  <% if expanded %>
    <% events = message.email_events.sort_by { |event| [ event.occurred_at, event.id ] } %>
    <% if events.any? %>
      <ul class="mt-2 space-y-1 text-xs text-ink-soft">
        <% events.each do |event| %>
          <li><%= l(event.occurred_at, format: :short) %> · <%= email_event_label(event.event_type) %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-2 text-xs text-ink-faint"><%= t("people.show.no_delivery_events") %></p>
    <% end %>
  <% end %>
</li>

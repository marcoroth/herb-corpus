<label class="flex items-start gap-3 rounded-lg border border-line px-3 py-2.5 hover:bg-canvas-sunken cursor-pointer"
      data-merge-person-search-target="row"
      data-person-id="<%= candidate.id %>">
  <%= check_box_tag "secondary_ids[]", candidate.id, selected,
        class: "mt-1 rounded border-line text-accent focus:ring-accent",
        data: { action: "change->merge-person-search#updateSubmitState" } %>
  <span class="min-w-0">
    <span class="font-medium block"><%= candidate.display_name %></span>
    <span class="text-sm text-ink-faint block">
      <%= [ candidate.company.name, candidate.email, candidate.job_title, t("deals.index.count", count: candidate.deals.size) ].compact_blank.join(" · ") %>
    </span>
  </span>
</label>

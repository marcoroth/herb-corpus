<%# locals: (person:) %>
<div class="flex items-start gap-2 px-1 py-1.5">
  <span class="flex items-center gap-2 w-32 shrink-0 text-sm text-ink-faint pt-px">
    <%= icon :mail, classes: "size-3.5" %>
    <%= t("records.fields.email") %>
  </span>
  <div class="min-w-0 flex-1 text-base text-ink break-words">
    <% if person.person_emails.any? %>
      <ul class="space-y-1">
        <% person.person_emails.ordered.each do |email_record| %>
          <li class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
            <%= mail_to email_record.address, email_record.address, class: "text-accent hover:underline break-all" %>
            <% if email_record.primary? %>
              <span class="inline-flex items-center rounded-full bg-accent-soft px-1.5 py-0.5 text-2xs font-semibold text-accent-dark"><%= t("people.show.primary_email") %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <span class="text-ink-faint">—</span>
    <% end %>
  </div>
</div>

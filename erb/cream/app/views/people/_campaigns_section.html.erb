<%# locals: (messages:) %>
<% preview_limit = EmailMessage::CAMPAIGN_HISTORY_PREVIEW %>
<% preview = messages.first(preview_limit) %>
<section class="record-card" data-controller="task-edit">
  <h2 class="record-section-title mb-4"><%= t("people.show.campaigns") %> <span class="record-count"><%= messages.size %></span></h2>
  <% if preview.any? %>
    <ul class="space-y-4" data-person-campaigns="preview">
      <%= render partial: "people/campaign_message_row", collection: preview, as: :message, locals: { expanded: false } %>
    </ul>
    <button type="button" class="btn-ghost mt-4 -ml-2" data-action="task-edit#open">
      <%= messages.size > preview_limit ? t("people.show.view_more_count", count: messages.size) : t("people.show.view_more") %> <%= icon :chevron_right, classes: "size-3.5" %>
    </button>
  <% else %>
    <p class="text-sm text-ink-soft"><%= t("people.show.campaigns_empty") %></p>
  <% end %>

  <dialog data-task-edit-target="dialog" class="modal-dialog max-w-lg rounded-xl border border-line bg-canvas-raised shadow-lg backdrop:bg-chicago-950/40" aria-labelledby="person-campaigns-dialog-title">
    <div class="p-5">
      <div class="flex items-start justify-between gap-3 mb-4">
        <h3 id="person-campaigns-dialog-title" class="text-lg font-semibold"><%= t("people.show.campaigns") %></h3>
        <button type="button" class="btn-ghost" data-action="task-edit#close" aria-label="<%= t("records.close") %>">×</button>
      </div>
      <% if messages.any? %>
        <ul class="space-y-3" data-person-campaigns="full">
          <%= render partial: "people/campaign_message_row", collection: messages, as: :message, locals: { expanded: true } %>
        </ul>
        <% if messages.size >= EmailMessage::CAMPAIGN_HISTORY_LIMIT %>
          <p class="mt-3 text-xs text-ink-faint"><%= t("people.show.campaigns_limit", count: EmailMessage::CAMPAIGN_HISTORY_LIMIT) %></p>
        <% end %>
      <% else %>
        <p class="text-sm text-ink-soft"><%= t("people.show.campaigns_empty") %></p>
      <% end %>
    </div>
  </dialog>
</section>

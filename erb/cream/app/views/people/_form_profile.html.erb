<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
  <div><%= f.label :job_title, class: "label" %><%= f.text_field :job_title, class: "input", autocomplete: "organization-title" %></div>
  <%= render "shared/company_select", form: f %>
</div>
<div>
  <div class="flex items-center justify-between gap-2 mb-1">
    <%= f.label :linkedin_url, t("activerecord.attributes.person.linkedin_url"), class: "label mb-0" %>
    <% if person.persisted? %>
      <%= link_to t("people.form.profile.search_linkedin"), "https://www.linkedin.com/search/results/people/?keywords=#{ERB::Util.url_encode([person.display_name, person.company&.name].compact.join(' '))}", target: "_blank", rel: "noopener", class: "btn-ghost text-sm" %>
    <% else %><button type="button" class="btn-ghost text-sm" data-action="linkedin-suggest#search"><%= t("people.form.profile.search_linkedin") %></button><% end %>
  </div>
  <%= f.url_field :linkedin_url, class: "input", placeholder: t("people.form.profile.linkedin_placeholder") %>
</div>
<div><%= f.label :twitter_url, t("activerecord.attributes.person.twitter_url"), class: "label" %><%= f.url_field :twitter_url, class: "input" %></div>
<div><%= f.label :description, t("activerecord.attributes.person.description"), class: "label" %><%= f.text_area :description, rows: 4, class: "input" %></div>

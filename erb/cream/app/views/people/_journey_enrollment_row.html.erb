<%# locals: (enrollment:, expanded: false) %>
<% journey = enrollment.journey %>
<li class="<%= expanded ? "rounded-md border border-line px-3 py-2" : "" %>">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="font-medium break-words">
        <% if journey %>
          <% if policy(journey).show? %>
            <%= link_to journey.name, journey_path(journey), class: "hover:text-accent hover:underline" %>
          <% else %>
            <%= journey.name %>
          <% end %>
        <% else %>
          <%= t("people.show.journey_missing") %>
        <% end %>
      </p>
      <% if enrollment.current_step %>
        <p class="text-sm text-ink-soft break-words"><%= journey_step_label(enrollment.current_step, workspace: current_workspace) %></p>
      <% elsif expanded %>
        <p class="text-sm text-ink-faint"><%= t("people.show.journey_no_step") %></p>
      <% end %>
      <p class="text-xs text-ink-faint mt-1"><%= l(enrollment.enrolled_at, format: :short) %></p>
    </div>
    <div class="shrink-0"><%= enrollment_state_badge(enrollment.state) %></div>
  </div>
  <% if expanded && enrollment.next_run_at.present? %>
    <p class="mt-2 text-xs text-ink-soft"><%= t("people.show.journey_next_run") %>: <%= l(enrollment.next_run_at, format: :default) %></p>
  <% end %>
</li>

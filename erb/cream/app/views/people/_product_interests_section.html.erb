<%# locals: (person:) %>
<div class="mt-4">
  <div class="flex items-center justify-between gap-2 mb-1.5">
    <h3 class="text-sm font-semibold uppercase tracking-wider text-ink-faint"><%= t("people.show.product_interests") %></h3>
  </div>
  <% interests = person.product_interests.includes(:product).ordered %>
  <% if interests.any? %>
    <ul class="space-y-2">
      <% interests.each do |interest| %>
        <li class="rounded-md border border-line px-3 py-2 text-sm">
          <div class="flex items-start justify-between gap-2">
            <div>
              <p class="font-medium"><%= interest.product.name %></p>
              <p class="text-ink-soft"><%= interest.description %></p>
              <p class="text-xs text-ink-faint mt-1"><%= l(interest.occurred_at, format: :short) %> · <%= t("people.interest_status.#{interest.status}", default: interest.status) %></p>
            </div>
            <% if interest.pending? %>
              <%= link_to t("people.show.convert_to_sql"), new_person_product_interest_conversion_path(person, interest), class: "btn-secondary text-xs shrink-0" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-ink-faint px-2"><%= t("people.show.no_interests") %></p>
  <% end %>

  <details class="record-disclosure">
    <summary><%= t("people.show.register_interest") %></summary>
  <%= form_with url: person_product_interests_path(person), class: "mt-3 space-y-2" do %>
    <div>
      <%= label_tag "product_interest[product_id]", t("people.show.product"), class: "label" %>
      <%= select_tag "product_interest[product_id]",
            options_from_collection_for_select(current_workspace.products.ordered, :id, :name),
            include_blank: t("people.show.select_product"), required: true, class: "input w-full" %>
    </div>
    <div>
      <%= label_tag "product_interest[description]", t("people.show.signal"), class: "label" %>
      <%= text_field_tag "product_interest[description]", nil, required: true, placeholder: t("people.show.signal_placeholder"), class: "input w-full" %>
    </div>
    <%= submit_tag t("people.show.register_interest"), class: "btn-secondary" %>
  <% end %>
  </details>
</div>

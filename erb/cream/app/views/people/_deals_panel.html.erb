    <div class="record-card">
      <div class="flex items-center justify-between gap-2 mb-1.5">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-ink-faint"><%= t("records.tabs.deals") %></h3>
        <% if @deal_product_options.many? %>
          <%= form_with url: person_path(@person), method: :get, class: "shrink-0" do %>
            <%= hidden_field_tag :tab, "deals" %>
            <%= select_tag :product_id,
                  options_from_collection_for_select(@deal_product_options, :id, :name, @deal_product_id),
                  include_blank: t("people.show.all_products"), class: "input text-xs py-1 w-36",
                  data: { controller: "submit-on-change", action: "change->submit-on-change#submit" } %>
          <% end %>
        <% end %>
      </div>
      <% if @deals.any? %>
        <ul class="space-y-1">
          <% @deals.each do |deal| %>
            <li class="rounded-md px-2 py-1.5 hover:bg-canvas-sunken">
              <div class="flex items-center justify-between gap-2">
                <%= link_to deal.name, deal_path(deal), class: "truncate font-medium text-base hover:underline" %>
                <%= render DealStageComponent.new(deal: deal) %>
              </div>
              <p class="text-xs text-ink-faint mt-0.5 truncate">
                <%= l(deal.created_at, format: :short) %>
                <% if deal.products.any? %>
                  · <%= deal.products.map(&:name).join(", ") %>
                <% end %>
              </p>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-ink-faint px-2"><%= t("people.show.deals_empty") %></p>
      <% end %>
    </div>

<section class="record-card" aria-labelledby="record-overview-deals">
  <div class="flex items-center justify-between gap-3 mb-4">
    <h2 id="record-overview-deals" class="record-section-title"><%= t("records.tabs.deals") %> <span class="record-count"><%= @deals.size %></span></h2>
    <% if @deals.size > 5 %>
      <button type="button" class="btn-ghost" data-action="record-workspace#selectTab" data-tab="deals"><%= t("records.view_deals", count: @deals.size) %> <%= icon :chevron_right, classes: "size-3.5" %></button>
    <% end %>
  </div>
  <% if @deals.any? %>
    <ul class="space-y-1">
      <% @deals.first(5).each do |deal| %>
        <li class="rounded-md px-2 py-1.5 hover:bg-canvas-sunken">
          <div class="flex items-center justify-between gap-2">
            <%= link_to deal.name, deal_path(deal), class: "truncate font-medium text-base hover:underline" %>
            <%= render DealStageComponent.new(deal: deal) %>
          </div>
          <p class="text-xs text-ink-faint mt-0.5 truncate">
            <%= l(deal.created_at, format: :short) %>
            <% if deal.products.any? %>
              · <%= deal.products.map(&:name).join(", ") %>
            <% end %>
          </p>
        </li>
      <% end %>
    </ul>
    <% if @deals.size > 5 %>
      <details class="record-disclosure mt-3">
        <summary><%= t("records.show_more_deals", count: @deals.size - 5) %></summary>
        <ul class="space-y-1 mt-3">
          <% @deals.drop(5).each do |deal| %>
            <li class="rounded-md px-2 py-1.5 hover:bg-canvas-sunken">
              <div class="flex items-center justify-between gap-2">
                <%= link_to deal.name, deal_path(deal), class: "truncate font-medium text-base hover:underline" %>
                <%= render DealStageComponent.new(deal: deal) %>
              </div>
              <p class="text-xs text-ink-faint mt-0.5 truncate">
                <%= l(deal.created_at, format: :short) %>
                <% if deal.products.any? %>
                  · <%= deal.products.map(&:name).join(", ") %>
                <% end %>
              </p>
            </li>
          <% end %>
        </ul>
      </details>
    <% end %>
  <% else %>
    <p class="text-sm text-ink-soft"><%= t("people.show.deals_empty") %></p>
  <% end %>
</section>

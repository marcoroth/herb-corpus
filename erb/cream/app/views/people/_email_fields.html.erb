<%# locals: (form:) %>
<div class="flex items-end gap-2 rounded-lg ring-1 ring-transparent hover:ring-line p-1"
     data-nested-form-target="row">
  <%= form.label :address, t("activerecord.attributes.person_email.address"), class: "sr-only" %>
  <%= form.email_field :address, class: "input flex-1 min-w-0", placeholder: "name@company.com", autocomplete: "email",
        data: { action: "paste->contact-email-paste#paste blur->contact-email-paste#blurEmail" } %>
  <label class="flex items-center gap-1.5 text-sm text-ink-soft shrink-0 pb-2">
    <%= form.check_box :primary, class: "rounded border-line text-accent focus:ring-accent" %>
    <%= t("people.show.primary_email") %>
  </label>
  <%= form.hidden_field :_destroy %>
  <button type="button" data-action="nested-form#remove" class="text-ink-faint hover:text-danger p-1.5 mb-0.5 shrink-0" title="<%= t("people.form.contact.remove_email") %>">
    <%= icon :trash, classes: "size-3.5" %>
  </button>
</div>

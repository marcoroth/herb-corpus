<%# locals: (enrollments:) %>
<% preview_limit = JourneyEnrollment::HISTORY_PREVIEW %>
<% preview = enrollments.first(preview_limit) %>
<section class="record-card" data-controller="task-edit">
  <h2 class="record-section-title mb-4"><%= t("people.show.journeys") %> <span class="record-count"><%= enrollments.size %></span></h2>
  <% if preview.any? %>
    <ul class="space-y-4" data-person-journeys="preview">
      <%= render partial: "people/journey_enrollment_row", collection: preview, as: :enrollment, locals: { expanded: false } %>
    </ul>
    <button type="button" class="btn-ghost mt-4 -ml-2" data-action="task-edit#open">
      <%= enrollments.size > preview_limit ? t("people.show.view_more_count", count: enrollments.size) : t("people.show.view_more") %> <%= icon :chevron_right, classes: "size-3.5" %>
    </button>
  <% else %>
    <p class="text-sm text-ink-soft"><%= t("people.show.journeys_empty") %></p>
  <% end %>

  <dialog data-task-edit-target="dialog" class="modal-dialog max-w-lg rounded-xl border border-line bg-canvas-raised shadow-lg backdrop:bg-chicago-950/40" aria-labelledby="person-journeys-dialog-title">
    <div class="p-5">
      <div class="flex items-start justify-between gap-3 mb-4">
        <h3 id="person-journeys-dialog-title" class="text-lg font-semibold"><%= t("people.show.journeys") %></h3>
        <button type="button" class="btn-ghost" data-action="task-edit#close" aria-label="<%= t("records.close") %>">×</button>
      </div>
      <% if enrollments.any? %>
        <ul class="space-y-3" data-person-journeys="full">
          <%= render partial: "people/journey_enrollment_row", collection: enrollments, as: :enrollment, locals: { expanded: true } %>
        </ul>
        <% if enrollments.size >= JourneyEnrollment::HISTORY_LIMIT %>
          <p class="mt-3 text-xs text-ink-faint"><%= t("people.show.journeys_limit", count: JourneyEnrollment::HISTORY_LIMIT) %></p>
        <% end %>
      <% else %>
        <p class="text-sm text-ink-soft"><%= t("people.show.journeys_empty") %></p>
      <% end %>
    </div>
  </dialog>
</section>

<% content_for :title, @preview_subject.presence || t("email_templates.preview.document_title") %>

<div class="mx-auto max-w-4xl space-y-4">
  <div class="rounded-md border border-line bg-canvas px-4 py-3">
    <p class="text-xs font-semibold uppercase tracking-wider text-ink-faint"><%= t("email_templates.preview_page.subject_heading") %></p>
    <p class="text-base font-medium text-ink mt-1"><%= @preview_subject.presence || t("email_templates.preview_page.no_subject") %></p>
  </div>

  <div class="rounded-md border border-line bg-white shadow-sm overflow-hidden">
    <div class="p-4">
      <%= render "shared/email_body", body: @preview_body %>
    </div>
  </div>
</div>

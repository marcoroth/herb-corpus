<!DOCTYPE html>
<html class="h-full" lang="<%= @locale %>">
  <head>
    <title><%= @booking_page.name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;500;600;700&family=Lato:wght@400;700&display=swap">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="public-booking-page min-h-full">
    <%= public_booking_page_body do %>
      <main class="public-booking-main">
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>

<% portal_workspace = @workspace || @share_link&.workspace %>
<!DOCTYPE html>
<html class="h-full" lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || portal_workspace&.name || "Cream" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;500;600;700&family=Lato:wght@400;700&display=swap">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="public-booking-page min-h-full">
    <%= client_portal_page_body(portal_workspace) do %>
      <main class="min-h-full px-4 py-10 sm:py-14">
        <% if client_portal_preview? %>
          <div class="mx-auto max-w-3xl mb-6 rounded-lg border border-line bg-surface px-4 py-3 text-sm text-ink-soft" role="status">
            <%= t("client_portal.preview.banner", email: client_portal_preview_email) %>
          </div>
        <% end %>
        <%= render "shared/flash" %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>

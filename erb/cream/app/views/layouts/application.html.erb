<!DOCTYPE html>
<html class="h-full overflow-hidden" lang="<%= I18n.locale %>" data-theme="<%= authenticated? ? current_user.theme : "system" %>">
  <head>
    <title><%= content_for(:title) || "Cream" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Cream">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;500;600;700&family=Lato:wght@400;700&display=swap">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "quill.snow", "quill_overrides", "codemirror_overrides", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% use_app_shell = authenticated? && !controller.class.name.start_with?("Doorkeeper::") %>
  <body class="h-full bg-canvas overflow-hidden" <% if authenticated? %>data-controller="hotkeys" data-hotkeys-search-url-value="<%= search_path %>"<% end %>>
    <% if use_app_shell %>
      <div class="flex h-full min-h-0 overflow-hidden" data-controller="mobile-nav">
        <div data-mobile-nav-target="backdrop"
             data-action="click->mobile-nav#close"
             class="fixed inset-0 z-40 bg-chicago-950/60 hidden md:hidden"
             aria-hidden="true"></div>
        <%= render "shared/sidebar" %>
        <main class="flex-1 min-w-0 min-h-0 flex flex-col overflow-hidden">
          <%= turbo_stream_from current_user, :ui %>
          <div id="toasts" class="fixed top-4 left-1/2 -translate-x-1/2 z-50 flex flex-col items-center gap-2 pointer-events-none"></div>
          <%= render "shared/flash" %>
          <%= render "shared/next_task_prompt" %>
          <%= yield %>
          <%= render "shared/okm_chat" if okm_chat_enabled? %>
        </main>
      </div>
    <% else %>
      <main class="relative min-h-full flex flex-col items-center justify-center bg-canvas-soft px-4">
        <div class="absolute top-4 right-4">
          <%= render "shared/locale_switcher" %>
        </div>
        <%= render "shared/flash" %>
        <%= render "shared/next_task_prompt" %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>

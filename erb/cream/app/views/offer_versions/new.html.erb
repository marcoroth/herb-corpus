<% page_title t("offers.new_version.title", name: @offer.name) %>
<%= render "shared/page_header", title: t("offers.new_version.title", name: @offer.name), icon_name: :banknote, count: nil, actions: nil %>
<div class="flex-1 overflow-y-auto bg-canvas-soft/50 p-4 sm:p-6">
  <div class="max-w-3xl mx-auto space-y-3">
    <%= link_to t("offers.new.back", deal: @deal.name), deal_path(@deal, tab: "offers"), class: "inline-block text-sm text-ink-soft hover:text-accent mb-5" %>

    <%= form_with model: @version, scope: :offer_version, url: deal_offer_versions_path(@deal, @offer), class: "card p-4 space-y-4", multipart: true do |f| %>
      <% if @version.errors.any? %>
        <div class="rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800">
          <%= @version.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <p class="text-sm text-ink-soft"><%= t("offers.new_version.hint", number: (@offer.current_version&.number || 0) + 1) %></p>

      <%= render "offers/version_fields", f: f %>

      <div class="flex gap-2">
        <%= f.submit t("offers.new_version.submit"), class: "btn-primary" %>
        <%= link_to t("shared.form.cancel"), deal_path(@deal, tab: "offers"), class: "btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>

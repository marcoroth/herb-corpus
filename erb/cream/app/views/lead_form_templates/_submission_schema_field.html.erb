<div class="rounded-lg border border-line px-3 py-2.5 <%= local_assigns[:muted] ? 'bg-canvas-sunken/60' : 'bg-canvas-raised' %>">
  <div class="flex flex-wrap items-start justify-between gap-2">
    <code class="font-mono text-sm text-ink">lead[<%= field["name"] %>]</code>
    <div class="flex flex-wrap gap-1.5">
      <%= badge submission_schema_field_type_label(field["input_type"]),
            color: submission_schema_field_type_color(field["input_type"]) %>
      <% if field["required"] %>
        <%= badge t("marketing.lead_form_templates.schema_field.required"), color: "golden" %>
      <% else %>
        <%= badge t("marketing.lead_form_templates.schema_field.optional"), color: "chicago" %>
      <% end %>
    </div>
  </div>

  <% conditions = submission_schema_conditions(field) %>
  <% if conditions.any? %>
    <div class="mt-2 flex flex-wrap gap-1.5">
      <% conditions.each do |condition| %>
        <span class="inline-flex items-center rounded-md bg-canvas-sunken px-2 py-0.5 text-2xs text-ink-soft ring-1 ring-line">
          <%= condition %>
        </span>
      <% end %>
    </div>
  <% end %>

  <p class="mt-2 text-xs text-ink-faint">
    <span class="font-medium text-ink-soft"><%= t("marketing.lead_form_templates.schema_field.values_label") %></span>
    <%= submission_schema_allowed_values_summary(field) %>
  </p>
</div>

<section class="card overflow-hidden">
  <div class="border-b border-line bg-canvas-sunken px-4 py-3">
    <h2 class="font-display text-base font-semibold text-ink"><%= t("marketing.lead_form_templates.submission_schema.heading") %></h2>
    <p class="mt-1 text-xs text-ink-faint">
      <%= t("marketing.lead_form_templates.submission_schema.intro") %>
    </p>
  </div>

  <div class="p-4">
    <% if template.partial? %>
      <p class="text-sm text-ink-soft">
        <%= t("marketing.lead_form_templates.submission_schema.partial_note") %>
      </p>
    <% elsif submission_schema_fields(template).empty? %>
      <p class="text-sm text-ink-soft">
        <%= t("marketing.lead_form_templates.submission_schema.empty_note") %>
      </p>
    <% else %>
      <% user_fields = submission_schema_user_fields(template) %>
      <% system_fields = submission_schema_system_fields(template) %>

      <div class="mb-3 flex flex-wrap items-center gap-2 text-xs text-ink-faint">
        <%= badge t("marketing.lead_form_templates.submission_schema.fields_badge", count: user_fields.size), color: "green" %>
        <% if system_fields.any? %>
          <%= badge t("marketing.lead_form_templates.submission_schema.metadata_badge", count: system_fields.size), color: "chicago" %>
        <% end %>
      </div>

      <div class="space-y-2">
        <% user_fields.each do |field| %>
          <%= render "lead_form_templates/submission_schema_field", field: field %>
        <% end %>
      </div>

      <% if system_fields.any? %>
        <details class="mt-4 group">
          <summary class="cursor-pointer text-xs font-medium text-ink-faint hover:text-ink">
            <%= t("marketing.lead_form_templates.submission_schema.system_fields_summary", count: system_fields.size) %>
          </summary>
          <div class="mt-2 space-y-2 border-t border-line pt-3">
            <% system_fields.each do |field| %>
              <%= render "lead_form_templates/submission_schema_field", field: field, muted: true %>
            <% end %>
          </div>
        </details>
      <% end %>
    <% end %>
  </div>
</section>

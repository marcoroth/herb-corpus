<% content_for :title, t("marketing.lead_form_templates.preview.title", name: @template.display_name) %>

<% if @template.layout? %>
  <% content_for :full_width do %>true<% end %>

  <%= @lead_form_page_html %>

  <div class="pointer-events-none fixed inset-x-0 bottom-0 z-[100] p-4 sm:inset-x-auto sm:right-4 sm:bottom-4 sm:left-auto sm:p-0">
    <%= render "preview_notice", floating: true %>
  </div>
<% else %>
  <div class="mx-auto max-w-xl space-y-4">
    <%= render "preview_notice" %>
    <%= @lead_form_page_html %>
  </div>
<% end %>

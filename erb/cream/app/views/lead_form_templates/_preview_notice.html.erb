<% floating = local_assigns.fetch(:floating, false) %>
<% wrapper_class = if floating
     "pointer-events-auto fixed bottom-4 right-4 z-[100] max-h-[min(70vh,28rem)] w-[min(100vw-2rem,22rem)] overflow-y-auto rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900 shadow-lg dark:border-amber-900 dark:bg-amber-950 dark:text-amber-100"
   else
     "rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-100 space-y-3"
   end %>
<div class="<%= wrapper_class %> space-y-3">
  <div>
    <p class="font-medium"><%= t("marketing.lead_form_templates.preview.heading") %></p>
    <p class="mt-1">
      <%= t("marketing.lead_form_templates.preview.intro_html", name: h(@template.display_name)).html_safe %>
      <% if @preview_draft %>
        <%= t("marketing.lead_form_templates.preview.draft_note") %>
      <% end %>
      <% unless @template.layout? %>
        <%= t("marketing.lead_form_templates.preview.no_submit") %>
      <% end %>
    </p>
    <%= link_to t("marketing.lead_form_templates.preview.back_to_editor"), edit_lead_form_template_path(@template), class: "mt-2 inline-block text-accent hover:underline" %>
  </div>

  <% if @preview_draft %>
    <% if @preview_product %>
      <p class="text-xs"><%= t("marketing.lead_form_templates.preview.product_label") %> <strong><%= @preview_product.name %></strong></p>
    <% end %>
  <% elsif @preview_products.any? && !@template.layout? %>
    <%= render "preview_product_field",
          products: @preview_products,
          selected_id: @preview_product&.id,
          auto_submit: true,
          form_url: preview_lead_form_template_path(@template),
          form_method: :get %>
  <% end %>
</div>

<%# locals: (products:, selected_id: nil, auto_submit: false, form_url: nil, form_method: :get, form_id: nil) %>
<% if products.any? %>
  <% select_html = { class: "input w-full" } %>
  <% select_html[:form] = form_id if form_id.present? %>
  <% select_options = options_for_select(
       [ [ t("marketing.lead_form_templates.preview_product.auto_option"), "" ] ] + products.map { |product| [ product.name, product.id ] },
       selected_id
     ) %>
  <% if auto_submit && form_url.present? %>
    <%= form_with url: form_url, method: form_method, class: "space-y-1" do %>
      <%= label_tag :preview_product_id, t("marketing.lead_form_templates.preview_product.label"), class: "label" %>
      <%= select_tag :preview_product_id, select_options, select_html.merge(data: { controller: "submit-on-change", action: "change->submit-on-change#submit" }) %>
    <% end %>
  <% else %>
    <div>
      <%= label_tag :preview_product_id, t("marketing.lead_form_templates.preview_product.label"), class: "label" %>
      <%= select_tag :preview_product_id, select_options, select_html %>
      <p class="mt-1 text-xs text-ink-faint"><%= t("marketing.lead_form_templates.preview_product.hint") %></p>
    </div>
  <% end %>
<% end %>

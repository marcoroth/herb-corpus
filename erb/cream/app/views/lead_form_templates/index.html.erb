<% page_title t("marketing.lead_form_templates.index.page_title") %>
<% actions = capture do %>
  <%= link_to lead_forms_path, class: "btn-secondary" do %>
    <%= t("marketing.lead_form_templates.index.back_to_forms") %>
  <% end %>
  <%= link_to new_lead_form_template_path, class: "btn-primary" do %>
    <%= icon :plus, classes: "size-3.5" %> <%= t("marketing.lead_form_templates.index.new_template") %>
  <% end %>
<% end %>

<div class="flex flex-col flex-1 min-h-0 overflow-hidden">
  <%= render "shared/page_header", title: t("marketing.lead_form_templates.index.page_title"), icon_name: :globe, count: @templates.size, actions: actions %>

  <div class="flex items-center gap-1 border-b border-line px-5 py-2 shrink-0">
    <% {
      "all" => t("marketing.lead_form_templates.index.filter_all"),
      "view" => t("marketing.lead_form_templates.index.filter_view"),
      "booking" => t("marketing.lead_form_templates.index.filter_booking"),
      "layout" => t("marketing.lead_form_templates.index.filter_layout"),
      "partial" => t("marketing.lead_form_templates.index.filter_partial")
    }.each do |key, label| %>
      <%= link_to label, lead_form_templates_path(kind: key == "all" ? nil : key),
            class: [ "rounded-md px-2.5 py-1 text-sm font-medium",
                     @kind == key ? "bg-canvas-sunken text-ink" : "text-ink-faint hover:text-ink" ] %>
    <% end %>
  </div>

  <div class="flex-1 min-h-0 overflow-y-auto scrollbar-subtle p-5 space-y-3">
  <% if @templates.empty? %>
    <% if @kind == "all" %>
      <p class="text-ink-faint"><%= t("marketing.lead_form_templates.index.empty_all") %></p>
    <% else %>
      <p class="text-ink-faint"><%= t("marketing.lead_form_templates.index.empty_kind") %></p>
    <% end %>
  <% end %>

  <% @templates.each do |template| %>
    <article class="card p-4">
      <div class="flex items-center gap-2 mb-2">
        <h2 class="font-semibold text-base font-mono"><%= template.display_name %></h2>
        <% badge_label, badge_color = if template.partial?
             [t("marketing.lead_form_templates.index.badge_partial"), "hoki"]
           elsif template.booking?
             [t("marketing.lead_form_templates.index.badge_booking"), "copperfield"]
           elsif template.layout?
             [t("marketing.lead_form_templates.index.badge_layout"), "hoki"]
           elsif template.page?
             [t("marketing.lead_form_templates.index.badge_landing"), "golden"]
           else
             [t("marketing.lead_form_templates.index.badge_form"), "green"]
           end %>
        <%= badge badge_label, color: badge_color %>
        <div class="ml-auto flex gap-2">
          <% if template.previewable? %>
            <%= link_to t("marketing.lead_form_templates.index.preview"), preview_lead_form_template_path(template),
                  class: "btn-secondary", target: "_blank", rel: "noopener noreferrer" %>
          <% end %>
          <%= link_to t("marketing.shared.edit"), edit_lead_form_template_path(template), class: "btn-secondary" %>
          <%= button_to t("marketing.shared.delete"), lead_form_template_path(template), method: :delete, class: "btn-danger",
                data: { turbo_confirm: t("marketing.lead_form_templates.index.delete_confirm", name: template.display_name) } %>
        </div>
      </div>
      <div class="mt-2">
        <%= render "shared/liquid_preview", body: template.body %>
      </div>
    </article>
  <% end %>
  </div>
</div>

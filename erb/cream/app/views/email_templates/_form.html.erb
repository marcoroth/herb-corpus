<% form_id = dom_id(template, :form) %>
<%= form_with model: template, html: { id: form_id }, class: "card p-4 space-y-3", multipart: true do |f| %>
  <% if template.errors.any? %>
    <div class="rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800">
      <%= template.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "label" %>
    <%= f.text_field :name, class: "input w-full" %>
  </div>
  <div>
    <%= f.label :subject, class: "label" %>
    <%= f.text_field :subject, class: "input w-full" %>
  </div>
  <div>
    <%= f.label :email_layout_id, t("email_templates.form.layout"), class: "label" %>
    <%= f.collection_select :email_layout_id,
          current_workspace.email_layouts.ordered,
          :id, :name,
          { include_blank: t("email_templates.form.no_layout") },
          class: "input w-full" %>
    <p class="mt-1 text-xs text-ink-faint"><%= t("email_templates.form.layout_hint").html_safe %></p>
  </div>
  <div>
    <%= f.label :body, class: "label" %>
    <%= render "body_editor", form: f, template: template %>
  </div>
  <% if template.attachments.attached? %>
    <div>
      <p class="label"><%= t("email_templates.form.current_attachments") %></p>
      <ul class="space-y-1">
        <% template.attachments.each do |file| %>
          <li class="flex items-center gap-2 text-sm">
            <label class="flex items-center gap-2 cursor-pointer">
              <%= check_box_tag "purge_attachment_ids[]", file.id, false, class: "rounded border-line" %>
              <%= icon :paperclip, classes: "size-3.5 text-ink-faint" %>
              <span class="text-ink-soft"><%= file.filename %></span>
              <span class="text-xs text-ink-faint"><%= number_to_human_size(file.byte_size) %></span>
            </label>
          </li>
        <% end %>
      </ul>
      <p class="text-xs text-ink-faint mt-1"><%= t("email_templates.form.attachments_purge_hint") %></p>
    </div>
  <% end %>
  <div>
    <%= f.label :attachments, t("email_templates.form.add_attachments"), class: "label" %>
    <%= f.file_field :attachments, multiple: true, class: "file-input" %>
  </div>
  <label class="flex items-center gap-2 text-base">
    <%= f.check_box :shared %> <%= t("email_templates.form.share_workspace") %>
  </label>

  <%= render "shared/email_preview_panel",
        preview_url: preview_email_templates_path,
        source_form_id: form_id,
        tokens: @preview_tokens || EmailTemplatePreview::STANDARD_TOKENS %>

  <div class="flex gap-2">
    <%= f.submit class: "btn-primary" %>
    <%= link_to t("shared.form.cancel"), email_templates_path, class: "btn-secondary" %>
  </div>
<% end %>

<% page_title t("settings.connected_apps.title") %>
<%= render "shared/page_header", title: t("settings.connected_apps.title"), icon_name: :globe, actions: nil %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5">
  <div class="max-w-2xl space-y-4">
    <p class="text-base text-ink-soft"><%= t("settings.connected_apps.intro") %></p>

    <% if @connected_apps.empty? %>
      <p class="text-sm text-ink-faint"><%= t("settings.connected_apps.empty") %></p>
    <% else %>
      <ul class="divide-y divide-line rounded-lg border border-line bg-surface">
        <% @connected_apps.each do |application, tokens| %>
          <li class="flex items-center justify-between gap-4 px-4 py-3">
            <div>
              <p class="font-medium text-ink"><%= application.name %></p>
              <p class="text-sm text-ink-faint"><%= l(tokens.first.created_at, format: :short) %> · <%= tokens.flat_map { |token| token.scopes.to_a }.uniq.join(" ") %></p>
            </div>
            <%= button_to t("settings.connected_apps.revoke"), settings_connected_app_path(application), method: :delete, class: "btn btn-secondary btn-sm" %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>

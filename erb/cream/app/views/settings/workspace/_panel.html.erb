<%# locals: (title:, open: false, status: nil) %>
<details class="settings-panel group" name="workspace-settings"<% if open %> open<% end %>>
  <summary class="settings-panel-summary">
    <span class="settings-panel-title"><%= title %></span>
    <% if status.present? %>
      <span class="settings-panel-status"><%= status %></span>
    <% end %>
    <%= icon :chevron_down, classes: "size-4 shrink-0 text-ink-faint transition-transform duration-200 group-open:rotate-180" %>
  </summary>
  <div class="settings-panel-body">
    <%= yield %>
  </div>
</details>

<% page_title t("integrations.custom_fields.page_title") %>
<% actions = capture do %>
  <% if @admin %>
    <%= link_to new_settings_custom_field_path, class: "btn-primary" do %>
      <%= icon :plus, classes: "size-3.5" %> <%= t("integrations.custom_fields.new") %>
    <% end %>
  <% end %>
<% end %>
<%= render "shared/page_header", title: t("integrations.custom_fields.title"), icon_name: :columns, count: nil, actions: actions %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5">
  <div class="max-w-2xl space-y-6">
    <p class="text-base text-ink-soft">
      <%= t("integrations.custom_fields.intro_html", workspace: current_workspace.name) %>
      <% unless @admin %>
        <%= t("integrations.custom_fields.admin_only") %>
      <% end %>
    </p>

    <% CustomField::RECORD_TYPES.each do |record_type| %>
      <% fields = @fields_by_type[record_type] || [] %>
      <section class="space-y-2">
        <h2 class="text-base font-semibold text-ink px-1"><%= t("integrations.custom_fields.record_types.#{record_type}") %></h2>
        <% if fields.any? %>
          <ul class="space-y-2">
            <% fields.each do |field| %>
              <li class="card flex items-center gap-3 px-4 py-3">
                <div class="min-w-0 flex-1">
                  <p class="text-base font-medium truncate"><%= field.name %></p>
                  <p class="text-xs text-ink-faint mt-0.5">
                    <%= field.field_type_label %>
                    <% if field.required? %> · <%= t("integrations.custom_fields.required_badge") %><% end %>
                    · <code class="text-2xs"><%= field.key %></code>
                  </p>
                </div>
                <% if @admin %>
                  <%= link_to edit_settings_custom_field_path(field), class: "btn-ghost text-sm" do %>
                    <%= icon :pencil, classes: "size-3.5" %> <%= t("integrations.custom_fields.edit") %>
                  <% end %>
                  <%= button_to settings_custom_field_path(field), method: :delete,
                        class: "text-ink-faint hover:text-danger p-1.5 rounded-md hover:bg-danger-soft",
                        form: { data: { turbo_confirm: t("integrations.custom_fields.delete_confirm", name: field.name) } },
                        title: t("integrations.custom_fields.delete_title") do %>
                    <%= icon :trash, classes: "size-4" %>
                  <% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm text-ink-faint px-1"><%= t("integrations.custom_fields.no_fields") %></p>
        <% end %>
        <% if @admin %>
          <% type_label = t("integrations.lists.record_types.#{record_type.downcase}") %>
          <%= link_to new_settings_custom_field_path(record_type: record_type), class: "inline-flex items-center gap-1.5 text-sm text-accent hover:underline px-1" do %>
            <%= icon :plus, classes: "size-3.5" %> <%= t("integrations.custom_fields.add_field", type: type_label) %>
          <% end %>
        <% end %>
      </section>
    <% end %>
  </div>
</div>

<%= form_with model: custom_field, url: custom_field.persisted? ? settings_custom_field_path(custom_field) : settings_custom_fields_path,
      class: "space-y-4 card p-4" do |f| %>
  <% if custom_field.errors.any? %>
    <div class="rounded-lg bg-danger-soft ring-1 ring-danger-line px-3 py-2 text-sm text-danger-strong">
      <ul class="list-disc list-inside">
        <% custom_field.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "label" %>
    <%= f.text_field :name, class: "input", autofocus: true, placeholder: t("integrations.custom_fields.name_placeholder") %>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div>
      <%= f.label :record_type, t("integrations.custom_fields.object"), class: "label" %>
      <% if custom_field.persisted? %>
        <%= f.hidden_field :record_type %>
        <p class="input bg-canvas-sunken text-ink-soft"><%= custom_field.record_type_label %></p>
      <% else %>
        <%= f.select :record_type, CustomField::RECORD_TYPES.map { |rt| [t("integrations.custom_fields.record_types.#{rt}"), rt] }, {}, class: "input" %>
      <% end %>
    </div>
    <div>
      <%= f.label :field_type, t("integrations.custom_fields.type"), class: "label" %>
      <% field_types = CustomField::FIELD_TYPES %>
      <% field_types = field_types - [ "formula" ] unless feature_enabled?(:formula_fields) %>
      <%= f.select :field_type, field_types.map { |ft| [CustomField.new(field_type: ft).field_type_label, ft] }, {},
            class: "input",
            data: { controller: "custom-field-type", action: "change->custom-field-type#toggle" } %>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :required, class: "rounded border-line" %>
    <%= f.label :required, t("integrations.custom_fields.required"), class: "text-base text-ink-soft" %>
  </div>

  <div id="custom-field-formula-panel" class="<%= custom_field.formula? ? '' : 'hidden' %>">
    <% if feature_enabled?(:formula_fields) %>
      <%= f.label :formula_expression, t("integrations.custom_fields.formula_expression"), class: "label" %>
      <%= f.text_field :formula_expression, class: "input", placeholder: t("integrations.custom_fields.formula_placeholder") %>
      <p class="mt-1 text-xs text-ink-faint"><%= t("integrations.custom_fields.formula_hint") %></p>
    <% end %>
  </div>

  <div id="custom-field-reference-panel" class="<%= custom_field.reference? ? '' : 'hidden' %>">
    <%= f.label :reference_type, t("integrations.custom_fields.reference_type"), class: "label" %>
    <%= f.select :reference_type, CustomField::RECORD_TYPES.map { |rt| [t("integrations.custom_fields.record_types.#{rt}"), rt] },
          { include_blank: t("integrations.custom_fields.reference_type_prompt") }, class: "input" %>
    <p class="mt-1 text-xs text-ink-faint"><%= t("integrations.custom_fields.reference_hint") %></p>
  </div>

  <div id="custom-field-options-panel" class="<%= custom_field.select? ? '' : 'hidden' %>">
    <%= label_tag :custom_field_options_text, t("integrations.custom_fields.options_label"), class: "label" %>
    <%= text_area_tag "custom_field[options_text]",
          custom_field.options&.join("\n"),
          rows: 4, class: "input font-mono text-sm" %>
    <p class="mt-1 text-xs text-ink-faint"><%= t("integrations.custom_fields.options_hint") %></p>
  </div>

  <div class="flex items-center gap-2 pt-2">
    <%= f.submit custom_field.persisted? ? t("integrations.custom_fields.save") : t("integrations.custom_fields.create"), class: "btn-primary" %>
    <%= link_to t("integrations.custom_fields.cancel"), settings_custom_fields_path, class: "btn-secondary" %>
  </div>
<% end %>

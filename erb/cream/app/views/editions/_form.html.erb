<%= form_with model: [ product, edition ], class: "space-y-4" do |f| %>
  <% if edition.errors.any? %>
    <div class="rounded-lg bg-danger-soft ring-1 ring-danger-line px-3 py-2 text-sm text-danger-strong">
      <ul class="list-disc list-inside">
        <% edition.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "label" %>
    <%= f.text_field :name, class: "input", autofocus: true, placeholder: t("products.editions.form.name_placeholder") %>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div>
      <%= f.label :starts_on, t("products.editions.form.start_date"), class: "label" %>
      <%= f.date_field :starts_on, class: "input" %>
    </div>
    <div>
      <%= f.label :ends_on, t("products.editions.form.end_date"), class: "label" %>
      <%= f.date_field :ends_on, class: "input" %>
    </div>
  </div>

  <div class="flex items-center gap-2 pt-2">
    <%= f.submit edition.persisted? ? t("products.editions.form.save") : t("products.editions.create"), class: "btn-primary" %>
    <%= link_to t("shared.form.cancel"), edit_product_path(product), class: "btn-secondary" %>
  </div>
<% end %>

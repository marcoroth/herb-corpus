<% content_for :title, t("public.email_tracking_leaving.page_title") %>
<% content_for :head do %>
  <meta name="robots" content="noindex, nofollow">
<% end %>

<div class="mx-auto max-w-xl card p-6 space-y-4">
  <h1 class="text-2xl font-display font-semibold"><%= t("public.email_tracking_leaving.title") %></h1>
  <p class="text-sm"><%= t("public.email_tracking_leaving.body", host: @destination_host) %></p>
  <p class="text-sm font-mono break-all text-ink-faint"><%= @destination %></p>
  <%= link_to t("public.email_tracking_leaving.continue"), @destination, class: "btn-primary inline-flex", rel: "noopener noreferrer nofollow" %>
</div>

<% page_title t("marketing.automations.index.page_title") %>
<% actions = capture do %>
  <%= link_to new_automation_path, class: "btn-primary" do %>
    <%= icon :plus, classes: "size-3.5" %> <%= t("marketing.automations.index.new") %>
  <% end %>
<% end %>
<%= render "shared/page_header", title: t("marketing.automations.index.page_title"), icon_name: :zap, count: @automations.size, actions: actions %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5 space-y-3">
  <% @automations.each do |automation| %>
    <article class="card p-4">
      <div class="flex items-center gap-2">
        <h2 class="font-semibold text-base"><%= automation.name %></h2>
        <%= badge automation.active? ? t("marketing.automations.index.active") : t("marketing.automations.index.inactive"), color: automation.active? ? "green" : "chicago" %>
        <div class="ml-auto flex gap-2">
          <%= link_to t("marketing.shared.edit"), edit_automation_path(automation), class: "btn-secondary" %>
          <%= button_to t("marketing.shared.delete"), automation_path(automation), method: :delete, class: "btn-danger" %>
        </div>
      </div>
      <p class="text-sm text-ink-faint mt-1">
        <%= t("marketing.automations.index.when_html", trigger: h(automation.trigger_event)).html_safe %><% if automation.trigger_conditions.present? %><%= t("marketing.automations.index.if_conditions", conditions: automation.trigger_conditions.map { |k, v| "#{k} = #{v}" }.join(", ")) %><% end %><%= t("marketing.automations.index.then_html", action: h(automation.action_type.humanize.downcase)).html_safe %>
      </p>
    </article>
  <% end %>
</div>

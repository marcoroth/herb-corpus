<%= form_with model: automation, html: { data: { controller: "automation-form" } }, class: "card p-4 space-y-4" do |f| %>
  <div>
    <%= f.label :name, t("marketing.shared.name"), class: "label" %>
    <%= f.text_field :name, class: "input w-full" %>
  </div>

  <div>
    <%= f.label :trigger_event, t("marketing.automations.form.trigger_label"), class: "label" %>
    <%= f.select :trigger_event, Automation::TRIGGER_EVENTS, {},
          class: "input w-full",
          data: { "automation-form-target" => "trigger", action: "automation-form#refresh" } %>
    <p class="text-sm text-ink-faint mt-1" data-automation-form-target="hint" data-trigger="deal.stage_changed">
      <%= t("marketing.automations.form.hint_deal_stage_changed").html_safe %>
    </p>
    <p class="text-sm text-ink-faint mt-1" data-automation-form-target="hint" data-trigger="record.created" hidden>
      <%= t("marketing.automations.form.hint_record_created") %>
    </p>
    <p class="text-sm text-ink-faint mt-1" data-automation-form-target="hint" data-trigger="task.completed" hidden>
      <%= t("marketing.automations.form.hint_task_completed").html_safe %>
    </p>
  </div>

  <div data-controller="nested-form">
    <span class="label"><%= t("marketing.automations.form.conditions_label") %></span>
    <p class="text-sm text-ink-faint mb-2"><%= t("marketing.automations.form.conditions_hint") %></p>
    <div class="space-y-2" data-nested-form-target="list">
      <% automation.trigger_conditions.each do |key, value| %>
        <div class="flex gap-2" data-nested-form-target="row">
          <%= text_field_tag "automation[condition_keys][]", key, class: "input flex-1", placeholder: t("marketing.automations.form.condition_field_placeholder") %>
          <%= text_field_tag "automation[condition_values][]", value, class: "input flex-1", placeholder: t("marketing.automations.form.condition_value_placeholder") %>
          <button type="button" class="btn-ghost" data-action="nested-form#remove" aria-label="<%= t("marketing.automations.form.remove_condition") %>">✕</button>
        </div>
      <% end %>
    </div>
    <template data-nested-form-target="template">
      <div class="flex gap-2" data-nested-form-target="row">
        <%= text_field_tag "automation[condition_keys][]", nil, class: "input flex-1", placeholder: t("marketing.automations.form.condition_field_placeholder") %>
        <%= text_field_tag "automation[condition_values][]", nil, class: "input flex-1", placeholder: t("marketing.automations.form.condition_value_placeholder") %>
        <button type="button" class="btn-ghost" data-action="nested-form#remove" aria-label="<%= t("marketing.automations.form.remove_condition") %>">✕</button>
      </div>
    </template>
    <button type="button" class="btn-secondary mt-2" data-action="nested-form#add">
      <%= icon :plus, classes: "size-3.5" %> <%= t("marketing.automations.form.add_condition") %>
    </button>
  </div>

  <div>
    <%= f.label :action_type, t("marketing.automations.form.action_label"), class: "label" %>
    <%= f.select :action_type, Automation::ACTION_TYPES, {},
          class: "input w-full",
          data: { "automation-form-target" => "actionType", action: "automation-form#refresh" } %>
  </div>

  <div data-automation-form-target="actionFields" data-action-type="create_task" class="space-y-2">
    <div>
      <label class="label"><%= t("marketing.automations.form.task_title") %></label>
      <%= text_field_tag "automation[action_params][title]", automation.action_params["title"], class: "input w-full", placeholder: t("marketing.automations.form.task_title_placeholder") %>
    </div>
    <div>
      <label class="label"><%= t("marketing.automations.form.due_date") %></label>
      <%= date_field_tag "automation[action_params][due_on]", automation.action_params["due_on"], class: "input w-full" %>
      <p class="text-sm text-ink-faint mt-1"><%= t("marketing.automations.form.due_date_hint") %></p>
    </div>
  </div>

  <div data-automation-form-target="actionFields" data-action-type="send_email" class="space-y-2" hidden>
    <div>
      <label class="label"><%= t("marketing.automations.form.email_subject") %></label>
      <%= text_field_tag "automation[action_params][subject]", automation.action_params["subject"], class: "input w-full", placeholder: t("marketing.automations.form.task_title_placeholder") %>
    </div>
    <div>
      <label class="label"><%= t("marketing.automations.form.email_body") %></label>
      <%= text_area_tag "automation[action_params][body]", automation.action_params["body"], rows: 4, class: "input w-full resize-y", placeholder: t("marketing.automations.form.email_body_placeholder") %>
    </div>
    <p class="text-sm text-ink-faint"><%= t("marketing.automations.form.email_hint") %></p>
  </div>

  <div data-automation-form-target="actionFields" data-action-type="notify_slack" class="space-y-2" hidden>
    <p class="text-sm text-ink-faint"><%= t("marketing.automations.form.slack_hint_html").html_safe %></p>
  </div>

  <label class="flex items-center gap-2 text-base"><%= f.check_box :active %> <%= t("marketing.automations.index.active") %></label>
  <%= f.submit class: "btn-primary" %>
<% end %>

<%# locals: (composer_id:, source_form_id:, email_templates:, email_layouts:, subject_name:, body_name:, body_editor_name:, email_layout_id_name:, email_template_id_name:, subject: nil, body: nil, body_editor: "quill", email_layout_id: nil, email_template_id: nil, show_template_picker: true, show_preview: true) %>
<div class="space-y-3 border border-line rounded-lg p-3"
     data-controller="email-composer"
     data-email-composer-template-url-value="<%= email_templates_path %>"
     data-email-composer-copy-value="<%= json_escape(I18n.t("email_templates.composer.client")) %>">
  <% if show_template_picker %>
    <div>
      <label class="label" for="<%= composer_id %>_template"><%= t("email_templates.composer.base_template") %></label>
      <%= select_tag email_template_id_name,
            options_from_collection_for_select(email_templates, :id, :name, email_template_id),
            include_blank: t("email_templates.composer.blank_template"),
            class: "input w-full",
            id: "#{composer_id}_template",
            data: {
              email_composer_target: "templateSelect",
              action: "change->email-composer#templateSelected"
            } %>
      <p class="text-xs text-ink-faint mt-1"><%= t("email_templates.composer.base_template_hint") %></p>
    </div>
  <% end %>

  <div>
    <label class="label" for="<%= composer_id %>_layout"><%= t("email_templates.composer.layout") %></label>
    <%= select_tag email_layout_id_name,
          options_from_collection_for_select(email_layouts, :id, :name, email_layout_id),
          include_blank: t("email_templates.composer.no_layout"),
          class: "input w-full",
          id: "#{composer_id}_layout",
          data: { email_composer_target: "layoutSelect" } %>
    <p class="mt-1 text-xs text-ink-faint"><%= t("email_templates.composer.layout_hint").html_safe %></p>
  </div>

  <div>
    <label class="label" for="<%= composer_id %>_subject"><%= t("email_templates.composer.subject") %></label>
    <%= text_field_tag subject_name, subject,
          class: "input w-full",
          id: "#{composer_id}_subject",
          data: { email_composer_target: "subjectInput" } %>
  </div>

  <div>
    <label class="label"><%= t("email_templates.composer.body") %></label>
    <%= render "shared/email_body_editor",
          body_name: body_name,
          body_editor_name: body_editor_name,
          body: body.to_s,
          body_editor: body_editor.presence || "quill",
          editor_id: composer_id %>
  </div>

  <% if show_preview %>
    <%= render "shared/email_preview_panel",
          preview_url: preview_email_templates_path,
          source_form_id: source_form_id,
          tokens: EmailTemplatePreview::STANDARD_TOKENS %>
  <% end %>
</div>

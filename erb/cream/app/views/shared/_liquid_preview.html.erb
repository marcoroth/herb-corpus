<%# locals: (body:) %>
<div class="liquid-editor liquid-preview border border-line rounded-md overflow-hidden bg-canvas"
     data-controller="liquid-preview">
  <textarea class="sr-only" readonly data-liquid-preview-target="source" aria-hidden="true"><%= body %></textarea>
  <div data-liquid-preview-target="editor" class="liquid-editor__surface"></div>
</div>

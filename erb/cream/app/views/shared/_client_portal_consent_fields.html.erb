<%# locals: (types:, workspace:) %>
<% if types.any? %>
  <fieldset class="space-y-3 border-t border-line pt-4">
    <legend class="text-sm font-medium"><%= t("client_portal.consent.legend") %></legend>
    <% types.each do |type| %>
      <label class="flex items-start gap-2.5 text-sm text-ink-soft cursor-pointer">
        <%= check_box_tag "consent_type_ids[]", type.id, false, id: "consent_type_#{type.id}",
              required: type.client_portal_required?, class: "mt-0.5 rounded border-line" %>
        <span>
          <%= type.consent_label %>
          <% if type.client_portal_required? %>
            <span class="text-red-600 dark:text-red-400" aria-hidden="true">*</span>
            <span class="sr-only"><%= t("client_portal.consent.required") %></span>
          <% end %>
          <% if type.localized_description.present? %>
            <span class="block text-xs text-ink-faint"><%= type.localized_description %></span>
          <% end %>
        </span>
      </label>
    <% end %>
    <p class="text-xs text-ink-faint">
      <%= t(types.any?(&:client_portal_required?) ? "client_portal.consent.mixed" : "client_portal.consent.optional") %>
      <% if ClientPortal::PrivacyPolicy.html(workspace).present? %>
        <%= link_to t("client_portal.consent.privacy_policy"), client_portal_privacy_path(workspace_slug: workspace.slug),
              target: "_blank", rel: "noopener", class: "text-accent hover:underline" %>
      <% end %>
    </p>
  </fieldset>
<% end %>

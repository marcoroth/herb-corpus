<%# locals: (record:) %>
<% fields = record.custom_field_definitions %>
<% if fields.any? %>
  <% values = record.custom_fields_hash %>
  <% fields.each do |field| %>
    <%= render "shared/attribute",
          label: field.name,
          icon_name: :note,
          value: custom_field_value_display(field, values[field.key]) %>
  <% end %>
<% end %>

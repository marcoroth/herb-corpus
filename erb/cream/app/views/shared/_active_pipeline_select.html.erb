<%# locals: (pipelines:, selected_pipeline: nil, include_all: false, return_to: request.fullpath, select_class: "input w-44") %>
<%= form_with url: active_pipeline_path, method: :patch, data: { turbo: false } do %>
  <%= hidden_field_tag :return_to, return_to %>
  <%= select_tag :pipeline_id,
        options_for_select(pipelines.map { |p| [ p.name, p.id ] }, selected_pipeline&.id),
        **(include_all ? { include_blank: t("shared.lists.all_pipelines") } : {}),
        class: select_class,
        data: { controller: "submit-on-change", action: "change->submit-on-change#submit" } %>
<% end %>

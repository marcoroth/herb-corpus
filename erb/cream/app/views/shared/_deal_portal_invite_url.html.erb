<%# locals: (deal:, can_manage:) %>
<% return unless CreamFeatures.enabled?(:client_portal) %>
<% invite = deal.portal_invite_link %>

<div class="space-y-2">
  <p class="text-sm font-medium text-ink"><%= t("deals.portal_invite.title") %></p>
  <p class="text-sm text-ink-faint"><%= t("deals.portal_invite.intro") %></p>

  <% if invite&.active? %>
    <div class="space-y-2" data-controller="clipboard">
      <div class="flex flex-wrap items-center gap-2">
        <input type="text" readonly class="input flex-1 min-w-0 font-mono text-xs"
              value="<%= client_portal_deal_portal_invite_url(workspace_slug: deal.workspace.slug, token: invite.token) %>"
              data-clipboard-target="source" tabindex="-1" aria-readonly="true"
              aria-label="<%= t("deals.portal_invite.url_aria") %>">
        <button type="button" class="btn-secondary inline-flex items-center gap-1.5"
              data-action="clipboard#copy" data-clipboard-target="button">
          <span data-clipboard-target="copyIcon"><%= icon :copy, classes: "size-4" %></span>
          <span data-clipboard-target="copiedIcon" class="hidden"><%= icon :check, classes: "size-4" %></span>
          <%= t("deals.portal_invite.copy_url") %>
        </button>
      </div>
      <% if can_manage %>
        <%= button_to t("deals.portal_invite.revoke"),
              deal_portal_invite_link_path(deal),
              method: :delete,
              class: "btn-ghost text-sm",
              form: { data: { turbo_confirm: t("deals.portal_invite.revoke_confirm") } } %>
      <% end %>
    </div>
  <% elsif can_manage %>
    <%= button_to t("deals.portal_invite.generate"),
          deal_portal_invite_link_path(deal),
          method: :post,
          class: "btn-secondary" %>
  <% else %>
    <p class="text-sm text-ink-faint"><%= t("deals.portal_invite.not_available") %></p>
  <% end %>
</div>

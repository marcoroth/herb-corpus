<%# locals: (label:, icon_name:, value: nil) %>
<div class="flex items-start gap-2 px-1 py-1.5">
  <span class="flex items-center gap-2 w-32 shrink-0 text-sm text-ink-faint pt-px">
    <%= icon icon_name, classes: "size-3.5" %>
    <%= label %>
  </span>
  <span class="min-w-0 text-base text-ink break-words">
    <% if value.present? %>
      <%= value %>
    <% else %>
      <span class="text-ink-faint">—</span>
    <% end %>
  </span>
</div>

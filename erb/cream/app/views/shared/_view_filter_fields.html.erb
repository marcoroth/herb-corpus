<%# locals: () %>
<% if filter_value(:q).present? %>
  <%= hidden_field_tag :q, filter_value(:q) %>
<% end %>
<% native_key = @native_filter_key %>
<% if filter_value(native_key.to_sym).present? %>
  <%= hidden_field_tag native_key, filter_value(native_key.to_sym) %>
<% end %>
<% cf = filter_value(:cf) %>
<% if cf.present? %>
  <% cf_hash = cf.respond_to?(:to_unsafe_h) ? cf.to_unsafe_h : cf.to_h %>
  <% cf_hash.each do |key, value| %>
    <%= hidden_field_tag "cf[#{key}]", value %>
  <% end %>
<% end %>
<% if filter_value(:sort).present? %>
  <%= hidden_field_tag :sort, filter_value(:sort) %>
<% end %>
<% if filter_value(:dir).present? %>
  <%= hidden_field_tag :dir, filter_value(:dir) %>
<% end %>
<% (@extra_filter_keys || []).each do |key| %>
  <% if filter_value(key.to_sym).present? %>
    <%= hidden_field_tag key, filter_value(key.to_sym) %>
  <% end %>
<% end %>
<% if @active_view %>
  <%= hidden_field_tag :view, @active_view.id %>
<% end %>

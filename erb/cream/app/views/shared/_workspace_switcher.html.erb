<% workspaces = switchable_workspaces.to_a %>

<% if workspaces.size > 1 %>
  <details class="group relative border-b border-line">
    <summary class="flex items-center gap-2 px-3 h-13 cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-accent-soft/50 transition-colors">
      <span class="size-6 rounded-md bg-accent text-on-dark inline-flex items-center justify-center text-xs font-bold font-display shrink-0">
        <%= current_workspace.name.first.upcase %>
      </span>
      <span class="font-semibold text-base truncate font-display min-w-0"><%= current_workspace.name %></span>
      <%= icon :chevron_down, classes: "size-3.5 text-ink-faint ml-auto shrink-0 transition-transform group-open:rotate-180" %>
    </summary>
    <div class="absolute left-2 right-2 top-[calc(100%-1px)] z-20 rounded-lg border border-line bg-canvas-raised py-1 shadow-sm">
      <% workspaces.each do |workspace| %>
        <% if workspace == current_workspace %>
          <div class="flex items-center gap-2 px-2.5 py-1.5 text-base font-medium text-ink bg-canvas-tint">
            <%= icon :check_circle, classes: "size-3.5 text-accent shrink-0" %>
            <span class="truncate"><%= workspace.name %></span>
          </div>
        <% else %>
          <%= button_to switch_workspace_path,
                method: :patch,
                params: { workspace_id: workspace.id },
                class: "flex w-full items-center gap-2 px-2.5 py-1.5 text-base font-medium text-ink-soft hover:bg-accent-soft/70 hover:text-ink text-left" do %>
            <span class="size-3.5 shrink-0"></span>
            <span class="truncate"><%= workspace.name %></span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </details>
<% else %>
  <div class="flex items-center gap-2 px-3 h-13 border-b border-line">
    <span class="size-6 rounded-md bg-accent text-on-dark inline-flex items-center justify-center text-xs font-bold font-display">
      <%= current_workspace&.name&.first&.upcase || "C" %>
    </span>
    <span class="font-semibold text-base truncate font-display"><%= current_workspace&.name || "Cream" %></span>
  </div>
<% end %>

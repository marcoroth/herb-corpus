<%# locals: (record:, task:) %>
<section>
  <h3 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-ink-faint mb-2">
    <%= icon :check_circle, classes: "size-3.5" %> <%= t("shared.tasks.title") %>
    <span class="text-ink-faint font-normal normal-case tracking-normal"><%= t("shared.tasks.open_count", count: record.tasks.pending.count) %></span>
  </h3>

  <%= form_with model: task, url: tasks_path, class: "relative z-0 flex items-center gap-2 mb-3 overflow-visible" do |f| %>
    <%= hidden_field_tag :taskable_type, record.class.name %>
    <%= hidden_field_tag :taskable_id, record.id %>
    <%= mention_text_field f, :title, placeholder: t("shared.tasks.placeholder"), class: "input flex-1" %>
    <%= f.date_field :due_on, class: "input w-36" %>
    <%= f.submit t("shared.tasks.add"), class: "btn-secondary" %>
  <% end %>

  <ul class="space-y-1">
    <% record.tasks.due_order_desc.each do |task_item| %>
      <%= render "shared/task_row", task: task_item %>
    <% end %>
  </ul>
</section>

<%# locals: (record:) %>
<% route_type = Ai::RecordResolver.route_for(record) %>
<section
  class="card p-4"
  data-controller="ai-assistant"
  data-ai-assistant-record-type-value="<%= route_type %>"
  data-ai-assistant-record-id-value="<%= record.id %>"
  data-ai-assistant-summary-url-value="<%= record_ai_summary_path(record_type: route_type, record_id: record.id) %>"
  data-ai-assistant-next-steps-url-value="<%= record_ai_next_steps_path(record_type: route_type, record_id: record.id) %>"
  data-ai-assistant-draft-email-url-value="<%= record_ai_draft_email_path(record_type: route_type, record_id: record.id) %>"
  data-ai-assistant-create-task-url-value="<%= record_ai_create_task_path(record_type: route_type, record_id: record.id) %>"
  data-ai-assistant-enrich-url-value="<%= record_ai_enrich_path(record_type: route_type, record_id: record.id) %>"
  data-ai-assistant-enrichment-enabled-value="<%= feature_enabled?(:ai_enrichment) %>"
  data-ai-assistant-copy-value="<%= json_escape(I18n.t("records.ai.client")) %>">
  <div class="flex items-start justify-between gap-3 flex-wrap mb-3">
    <div>
      <h3 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-ink-faint">
        <%= icon :zap, classes: "size-3.5" %> <%= t("records.ai_assistant") %>
      </h3>
      <p class="text-sm text-ink-faint mt-1"><%= t("records.ai.intro") %></p>
    </div>
    <div class="flex gap-2 flex-wrap">
      <button type="button" class="btn-secondary text-sm" data-action="ai-assistant#summarize"><%= t("records.ai.summarize") %></button>
      <button type="button" class="btn-secondary text-sm" data-action="ai-assistant#suggestNextSteps"><%= t("records.ai.next_steps") %></button>
      <% if feature_enabled?(:record_email) %>
        <button type="button" class="btn-secondary text-sm" data-action="ai-assistant#draftEmail"><%= t("records.ai.draft_email") %></button>
      <% end %>
      <% if feature_enabled?(:ai_enrichment) %>
        <button type="button" class="btn-secondary text-sm" data-action="ai-assistant#enrich"><%= t("records.ai.suggest_fields") %></button>
      <% end %>
    </div>
  </div>

  <% if feature_enabled?(:record_email) %>
    <label class="block text-sm text-ink-faint mb-3">
      <%= t("records.ai.email_goal") %>
      <input type="text" class="input w-full mt-1" placeholder="<%= t("records.ai.email_goal_placeholder") %>" data-ai-assistant-target="goal">
    </label>
  <% end %>

  <p class="text-sm mb-3" data-ai-assistant-target="status"></p>

  <div hidden data-ai-assistant-target="summaryPanel" class="space-y-3 mb-4">
    <div>
      <h4 class="text-sm font-semibold text-ink mb-1"><%= t("records.ai.summary") %></h4>
      <p class="text-base text-ink-soft" data-ai-assistant-target="summaryText"></p>
    </div>
    <div class="grid gap-3 md:grid-cols-3">
      <div>
        <h4 class="text-sm font-semibold text-ink mb-1"><%= t("records.ai.risks") %></h4>
        <ul class="list-disc pl-4 text-sm text-ink-soft space-y-1" data-ai-assistant-target="risksList"></ul>
      </div>
      <div>
        <h4 class="text-sm font-semibold text-ink mb-1"><%= t("records.ai.suggested_next_steps") %></h4>
        <ul class="list-disc pl-4 text-sm text-ink-soft space-y-1" data-ai-assistant-target="nextStepsList"></ul>
      </div>
      <div>
        <h4 class="text-sm font-semibold text-ink mb-1"><%= t("records.ai.missing_data") %></h4>
        <ul class="list-disc pl-4 text-sm text-ink-soft space-y-1" data-ai-assistant-target="missingList"></ul>
      </div>
    </div>
  </div>

  <div hidden data-ai-assistant-target="suggestionsPanel" class="space-y-3">
    <div class="flex items-center gap-2">
      <h4 class="text-sm font-semibold text-ink"><%= t("records.ai.actionable") %></h4>
      <span class="text-xs rounded-full bg-canvas-sunken px-2 py-0.5 text-ink-faint" hidden data-ai-assistant-target="riskBadge"></span>
    </div>
    <div class="space-y-2" data-ai-assistant-target="suggestionsList"></div>
  </div>
</section>

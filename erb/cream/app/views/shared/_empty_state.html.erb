<%# locals: (icon_name:, title:, subtitle: nil, action: nil) %>
<div class="flex flex-col items-center justify-center py-16 text-center">
  <div class="size-10 rounded-xl bg-canvas-sunken flex items-center justify-center mb-3">
    <%= icon icon_name, classes: "size-5 text-ink-faint" %>
  </div>
  <p class="text-base font-medium text-ink"><%= title %></p>
  <% if subtitle %>
    <p class="text-base text-ink-faint mt-1 max-w-sm"><%= subtitle %></p>
  <% end %>
  <% if action %>
    <div class="mt-4"><%= action %></div>
  <% end %>
</div>

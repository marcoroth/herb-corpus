<%# locals: (record:, comment:) %>
<section>
  <h3 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-ink-faint mb-2">
    <%= icon :message, classes: "size-3.5" %> <%= t("shared.comments.title") %>
    <span class="text-ink-faint font-normal normal-case tracking-normal">(<%= record.comments.count %>)</span>
  </h3>

  <%= form_with model: comment, url: comments_path, class: "card p-3 mb-3" do |f| %>
    <%= hidden_field_tag :commentable_type, record.class.name %>
    <%= hidden_field_tag :commentable_id, record.id %>
    <%= f.text_area :body, rows: 2, placeholder: t("shared.comments.placeholder"), class: "w-full text-base placeholder:text-ink-faint focus:outline-none resize-y" %>
    <div class="flex justify-end mt-2">
      <%= f.submit t("shared.comments.add"), class: "btn-primary" %>
    </div>
  <% end %>

  <div class="space-y-2">
    <% record.comments.includes(:user).top_level.recent_first.each do |c| %>
      <article class="card p-3">
        <div class="flex items-center gap-2 mb-1">
          <%= avatar c.user, size: "size-5", text: "text-2xs" %>
          <span class="text-sm font-medium"><%= c.user.name %></span>
          <span class="text-xs text-ink-faint"><%= l c.created_at, format: :short %></span>
          <%= button_to comment_path(c), method: :delete, form: { data: { turbo_confirm: t("shared.comments.delete_confirm") } },
                class: "ml-auto text-ink-faint hover:text-danger p-1 rounded cursor-pointer", title: t("shared.comments.delete") do %>
            <%= icon :trash, classes: "size-3.5" %>
          <% end %>
        </div>
        <p class="text-base text-ink-soft whitespace-pre-wrap"><%= mention_html(c.body) %></p>
      </article>
    <% end %>
  </div>
</section>

<%# locals: (workspace:, show_title: true) %>
<% return unless CreamFeatures.enabled?(:client_portal) %>

<div class="space-y-2" data-controller="clipboard">
  <% if local_assigns.fetch(:show_title, true) %>
    <p class="text-sm font-medium text-ink"><%= t("integrations.workspace.client_portal.title") %></p>
  <% end %>
  <p class="text-sm text-ink-faint"><%= t("integrations.workspace.client_portal.intro") %></p>
  <div class="flex flex-wrap items-center gap-2">
    <input type="text" readonly class="input flex-1 min-w-0 font-mono text-xs"
          value="<%= client_portal_root_url(workspace_slug: workspace.slug) %>"
          data-clipboard-target="source" tabindex="-1" aria-readonly="true"
          aria-label="<%= t("integrations.workspace.client_portal.url_aria") %>">
    <button type="button" class="btn-secondary inline-flex items-center gap-1.5"
          data-action="clipboard#copy" data-clipboard-target="button"
          aria-label="<%= t("integrations.workspace.client_portal.copy_url") %>">
      <span data-clipboard-target="copyIcon"><%= icon :copy, classes: "size-4" %></span>
      <span data-clipboard-target="copiedIcon" class="hidden"><%= icon :check, classes: "size-4" %></span>
      <%= t("integrations.workspace.client_portal.copy_url") %>
    </button>
    <span data-clipboard-target="feedback"
          class="hidden text-sm text-ink-soft"
          role="status" aria-live="polite"><%= t("integrations.workspace.client_portal.copied_clipboard") %></span>
  </div>
</div>

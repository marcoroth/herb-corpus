<%# locals: (record:, note:) %>
<section>
  <h3 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-ink-faint mb-2">
    <%= icon :note, classes: "size-3.5" %> <%= t("shared.notes.title") %>
    <span class="text-ink-faint font-normal normal-case tracking-normal">(<%= record.notes.count %>)</span>
  </h3>

  <%= form_with model: note, url: notes_path, class: "card p-3 mb-3" do |f| %>
    <%= hidden_field_tag :notable_type, record.class.name %>
    <%= hidden_field_tag :notable_id, record.id %>
    <%= f.text_field :title, placeholder: t("shared.notes.title_placeholder"), class: "w-full text-base font-medium placeholder:text-ink-faint focus:outline-none mb-1.5" %>
    <%= f.text_area :body, rows: 2, placeholder: t("shared.notes.body_placeholder"), class: "w-full text-base placeholder:text-ink-faint focus:outline-none resize-y" %>
    <div class="flex justify-end">
      <%= f.submit t("shared.notes.add"), class: "btn-primary" %>
    </div>
  <% end %>

  <div class="space-y-2">
    <% record.notes.includes(:user).order(created_at: :desc).each do |n| %>
      <article class="card p-3">
        <div class="flex items-center gap-2 mb-1">
          <%= avatar n.user, size: "size-5", text: "text-2xs" %>
          <span class="text-sm font-medium"><%= n.user.name %></span>
          <span class="text-xs text-ink-faint"><%= l n.created_at, format: :short %></span>
          <%= button_to note_path(n), method: :delete, form: { data: { turbo_confirm: t("shared.notes.delete_confirm") } },
                class: "ml-auto text-ink-faint hover:text-danger p-1 rounded cursor-pointer", title: t("shared.notes.delete") do %>
            <%= icon :trash, classes: "size-3.5" %>
          <% end %>
        </div>
        <% if n.title.present? %>
          <p class="text-base font-semibold mb-0.5"><%= n.title %></p>
        <% end %>
        <p class="text-base text-ink-soft whitespace-pre-wrap"><%= auto_link_html(n.body) %></p>
      </article>
    <% end %>
  </div>
</section>

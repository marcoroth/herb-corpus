<%# locals: (preview_url:, source_form_id:, tokens: EmailTemplatePreview::STANDARD_TOKENS, prefilled: {}, sample_content: nil, show_layout_sample: false) %>
<% prefilled = prefilled.stringify_keys %>
<div class="card p-4 space-y-3"
     data-controller="email-preview"
     data-email-preview-preview-url-value="<%= preview_url %>"
     data-email-preview-source-form-id-value="<%= source_form_id %>"
     data-email-preview-prefilled-value="<%= prefilled.to_json %>"
     data-email-preview-popups-blocked-value="<%= t("email_templates.preview.popups_blocked") %>"
     data-email-preview-preview-failed-value="<%= t("email_templates.preview.failed") %>">
  <div>
    <h3 class="text-sm font-semibold text-ink"><%= t("email_templates.preview.title") %></h3>
    <p class="text-xs text-ink-faint mt-1"><%= t("email_templates.preview.hint") %></p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2" data-email-preview-target="tokenFields">
    <% tokens.each do |token| %>
      <div>
        <label class="label text-xs" for="preview_token_<%= token %>_<%= source_form_id %>">{<%= token %>}</label>
        <input type="text"
               id="preview_token_<%= token %>_<%= source_form_id %>"
               value="<%= prefilled[token] %>"
               placeholder="<%= EmailTemplatePreview::SAMPLE_DEFAULTS[token] %>"
               class="input w-full py-1 text-sm"
               data-email-preview-target="tokenInput"
               data-token-name="<%= token %>">
      </div>
    <% end %>
  </div>

  <% if show_layout_sample %>
    <div>
      <label class="label text-xs" for="preview_sample_content_<%= source_form_id %>"><%= t("email_templates.preview.sample_content") %></label>
      <textarea id="preview_sample_content_<%= source_form_id %>"
                rows="4"
                class="input w-full text-sm font-mono"
                data-email-preview-target="sampleContent"><%= sample_content || EmailTemplatePreview::SAMPLE_CONTENT %></textarea>
      <p class="text-xs text-ink-faint mt-1"><%= t("email_templates.preview.sample_content_hint").html_safe %></p>
    </div>
  <% end %>

  <button type="button"
          class="btn-secondary"
          data-action="email-preview#open">
    <%= t("email_templates.preview.button") %>
  </button>
</div>

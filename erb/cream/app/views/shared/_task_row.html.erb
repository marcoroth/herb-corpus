<%# locals: (task:, show_taskable: false) %>
<% can_edit = policy(task).update? %>
<li class="flex items-center gap-2.5 card px-3 py-2 <%= "opacity-60" if task.completed? %>" data-controller="task-edit">
  <% if can_edit %>
    <%= button_to toggle_task_path(task), method: :patch,
          class: [ "size-4 rounded-full border flex items-center justify-center cursor-pointer transition-colors shrink-0",
                   task.completed? ? "bg-green-500 border-green-500 text-white" : "border-line-strong hover:border-green-500" ] do %>
      <%= icon(:check, classes: "size-2.5") if task.completed? %>
    <% end %>
    <button type="button"
            class="text-base flex-1 min-w-0 truncate text-left cursor-pointer hover:text-accent <%= "line-through text-ink-faint" if task.completed? %>"
            data-action="task-edit#open"
            title="<%= t("shared.tasks.edit") %>">
      <%= mention_html(task.title) %>
    </button>
  <% else %>
    <span class="size-4 rounded-full border flex items-center justify-center shrink-0 <%= task.completed? ? "bg-green-500 border-green-500 text-white" : "border-line-strong" %>">
      <%= icon(:check, classes: "size-2.5") if task.completed? %>
    </span>
    <span class="text-base flex-1 min-w-0 truncate <%= "line-through text-ink-faint" if task.completed? %>"><%= mention_html(task.title) %></span>
  <% end %>
  <% if show_taskable && task.taskable %>
    <%= link_to record_path_for(task.taskable), class: "flex items-center gap-1 text-xs text-ink-faint hover:text-ink shrink-0" do %>
      <%= icon record_icon_for(task.taskable_type), classes: "size-3" %>
      <span class="truncate max-w-36"><%= task.taskable.display_name %></span>
    <% end %>
  <% end %>
  <% if task.due_on %>
    <span class="text-xs flex items-center gap-1 shrink-0 <%= task.overdue? ? "text-danger" : "text-ink-faint" %>">
      <%= icon :calendar, classes: "size-3" %><%= l task.due_on, format: :short %>
    </span>
  <% end %>
  <% if task.assignee %>
    <%= avatar task.assignee, size: "size-5", text: "text-2xs" %>
  <% end %>
  <% if can_edit %>
  <button type="button"
          class="text-ink-faint hover:text-ink p-0.5 rounded cursor-pointer"
          title="<%= t("shared.tasks.edit") %>"
          data-action="task-edit#open">
    <%= icon :pencil, classes: "size-3.5" %>
  </button>
  <% if policy(task).destroy? %>
  <%= button_to task_path(task), method: :delete, form: { data: { turbo_confirm: t("shared.tasks.delete_confirm") } },
        class: "text-ink-faint hover:text-danger p-0.5 rounded cursor-pointer", title: t("shared.tasks.delete") do %>
    <%= icon :trash, classes: "size-3.5" %>
  <% end %>
  <% end %>

  <dialog data-task-edit-target="dialog" class="modal-dialog max-w-md rounded-xl border border-line shadow-lg backdrop:bg-chicago-950/40">
    <div class="p-4 space-y-3">
      <h3 class="text-base font-semibold"><%= t("shared.tasks.edit_title") %></h3>
      <%= form_with model: task, url: task_path(task), method: :patch, class: "space-y-3" do |f| %>
        <div>
          <label class="label"><%= t("shared.tasks.title_label") %></label>
          <%= mention_text_field f, :title, class: "input w-full", wrapper_class: "w-full" %>
        </div>
        <div>
          <label class="label"><%= t("shared.tasks.due_date") %></label>
          <%= f.date_field :due_on, class: "input w-full" %>
        </div>
        <div>
          <label class="label"><%= t("shared.tasks.assignee") %></label>
          <%= f.collection_select :assignee_id, current_workspace.users.order(:name), :id, :name,
                { include_blank: t("shared.tasks.unassigned") }, class: "input w-full" %>
        </div>
        <div class="flex justify-end gap-2 pt-1">
          <button type="button" class="btn-secondary" data-action="task-edit#close"><%= t("shared.tasks.cancel") %></button>
          <%= f.submit t("shared.tasks.save"), class: "btn-primary" %>
        </div>
      <% end %>
    </div>
  </dialog>
  <% end %>
</li>

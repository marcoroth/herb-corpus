<%# locals: (pagy:) %>
<% if pagy.pages > 1 %>
  <nav class="flex items-center justify-between gap-3 border-t border-line px-5 py-2.5 text-sm text-ink-soft"
       aria-label="<%= t("shared.pagination.aria_label") %>">
    <span class="tabular-nums">
      <%= t("shared.pagination.range_html", from: pagy.from, to: pagy.to, count: pagy.count).html_safe %>
    </span>
    <div class="flex items-center gap-2">
      <% if pagy.previous %>
        <%= link_to url_for(index_query_params(page: pagy.previous)), class: "btn-secondary", rel: "prev" do %>
          <%= icon :chevron_left, classes: "size-3.5" %> <%= t("shared.pagination.previous") %>
        <% end %>
      <% else %>
        <span class="btn-secondary opacity-40 pointer-events-none"><%= icon :chevron_left, classes: "size-3.5" %> <%= t("shared.pagination.previous") %></span>
      <% end %>
      <span class="tabular-nums px-1"><%= t("shared.pagination.page_of", page: pagy.page, pages: pagy.pages) %></span>
      <% if pagy.next %>
        <%= link_to url_for(index_query_params(page: pagy.next)), class: "btn-secondary", rel: "next" do %>
          <%= t("shared.pagination.next") %> <%= icon :chevron_right, classes: "size-3.5" %>
        <% end %>
      <% else %>
        <span class="btn-secondary opacity-40 pointer-events-none"><%= t("shared.pagination.next") %> <%= icon :chevron_right, classes: "size-3.5" %></span>
      <% end %>
    </div>
  </nav>
<% end %>

<% pipelines = current_workspace.pipelines.ordered %>
<% if pipelines.any? %>
  <details class="group relative border-b border-line">
    <summary class="flex items-center gap-2 px-3 py-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-accent-soft/50 transition-colors">
      <%= icon :columns, classes: "size-3.5 text-ink-faint shrink-0" %>
      <span class="text-sm text-ink-faint shrink-0"><%= t("records.fields.pipeline") %></span>
      <span class="text-base font-medium truncate min-w-0">
        <%= current_pipeline&.name || t("shared.lists.all_pipelines") %>
      </span>
      <%= icon :chevron_down, classes: "size-3.5 text-ink-faint ml-auto shrink-0 transition-transform group-open:rotate-180" %>
    </summary>
    <div class="absolute left-2 right-2 top-[calc(100%-1px)] z-20 rounded-lg border border-line bg-canvas-raised py-1 shadow-sm">
      <% if current_pipeline.nil? %>
        <div class="flex items-center gap-2 px-2.5 py-1.5 text-base font-medium text-ink bg-canvas-tint">
          <%= icon :check_circle, classes: "size-3.5 text-accent shrink-0" %>
          <span class="truncate"><%= t("shared.lists.all_pipelines") %></span>
        </div>
      <% else %>
        <%= button_to active_pipeline_path,
              method: :patch,
              params: { pipeline_id: "all" },
              class: "flex w-full items-center gap-2 px-2.5 py-1.5 text-base font-medium text-ink-soft hover:bg-accent-soft/70 hover:text-ink text-left" do %>
          <span class="size-3.5 shrink-0"></span>
          <span class="truncate"><%= t("shared.lists.all_pipelines") %></span>
        <% end %>
      <% end %>
      <% pipelines.each do |pipeline| %>
        <% if pipeline == current_pipeline %>
          <div class="flex items-center gap-2 px-2.5 py-1.5 text-base font-medium text-ink bg-canvas-tint">
            <%= icon :check_circle, classes: "size-3.5 text-accent shrink-0" %>
            <span class="truncate"><%= pipeline.name %></span>
          </div>
        <% else %>
          <%= button_to active_pipeline_path,
                method: :patch,
                params: { pipeline_id: pipeline.id },
                class: "flex w-full items-center gap-2 px-2.5 py-1.5 text-base font-medium text-ink-soft hover:bg-accent-soft/70 hover:text-ink text-left" do %>
            <span class="size-3.5 shrink-0"></span>
            <span class="truncate"><%= pipeline.name %></span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </details>
<% end %>

<%# locals: (title:, icon_name: nil, count: nil, actions: nil) %>
<header class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1.5 border-b border-line px-5 min-h-13 py-1.5 md:py-0 shrink-0">
  <div class="flex items-center gap-2 min-w-0">
    <button type="button"
            class="md:hidden shrink-0 text-ink-soft hover:text-ink p-1.5 -ml-1.5 rounded-md hover:bg-canvas-sunken transition-colors"
            aria-label="<%= t("records.open_menu") %>"
            data-action="mobile-nav#open">
      <%= icon :menu, classes: "size-5" %>
    </button>
    <% if icon_name %>
      <%= icon icon_name, classes: "size-4 text-ink-faint shrink-0" %>
    <% end %>
    <h1 class="text-base font-semibold truncate"><%= title %></h1>
    <% if count %>
      <span class="text-sm text-ink-faint bg-canvas-sunken rounded-full px-2 py-0.5"><%= count %></span>
    <% end %>
  </div>
  <div class="flex flex-wrap items-center justify-end gap-2">
    <%= actions %>
  </div>
</header>

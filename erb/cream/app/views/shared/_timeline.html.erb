<%# locals: (activities:) %>
<section>
  <h3 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-ink-faint mb-3">
    <%= icon :activity, classes: "size-3.5" %> <%= t("shared.timeline.title") %>
  </h3>
  <% if activities.any? %>
    <ol class="relative space-y-4 before:absolute before:left-[9px] before:top-1 before:bottom-1 before:w-px before:bg-line">
      <% activities.each do |activity| %>
        <li class="relative flex gap-3 pl-0">
          <span class="relative z-10 mt-0.5 size-[19px] rounded-full bg-canvas-raised ring-1 ring-line flex items-center justify-center shrink-0">
            <span class="size-1.5 rounded-full <%= activity.action == "created" ? "bg-green-500" : "bg-accent" %>"></span>
          </span>
          <div class="min-w-0">
            <p class="text-base text-ink-soft"><%= activity_sentence(activity) %></p>
            <% if activity.action == "updated" && activity.metadata["changes"].present? %>
              <ul class="mt-1 space-y-0.5">
                <% activity.metadata["changes"].first(4).each do |field, (from, to)| %>
                  <li class="text-sm text-ink-faint">
                    <span class="font-medium text-ink-soft"><%= field.humanize %>:</span>
                    <span class="line-through"><%= from.presence || t("shared.empty_value") %></span> → <%= to.presence || t("shared.empty_value") %>
                  </li>
                <% end %>
              </ul>
            <% end %>
            <p class="text-xs text-ink-faint mt-0.5" title="<%= l activity.created_at, format: :long %>">
              <%= t("shared.timeline.ago", time: time_ago_in_words(activity.created_at)) %>
            </p>
          </div>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="text-base text-ink-faint"><%= t("shared.timeline.empty") %></p>
  <% end %>
</section>

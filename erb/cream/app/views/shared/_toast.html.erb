<%# locals: message:, kind: ("info" | "success" | "warning") %>
<% styles = {
     "success" => { box: "bg-canvas-raised text-ink ring-line-strong", icon: :check, icon_class: "text-green-600 dark:text-green-400" },
     "warning" => { box: "bg-orange-50 text-orange-900 ring-orange-200 dark:bg-orange-950 dark:text-orange-200 dark:ring-orange-800", icon: :bell, icon_class: "text-orange-500 dark:text-orange-400" },
     "alert" => { box: "bg-danger-soft text-danger-strong ring-danger-line", icon: :x, icon_class: "text-danger" },
     "info" => { box: "bg-canvas-raised text-ink ring-line-strong", icon: :zap, icon_class: "text-accent" }
   }
   style = styles.fetch(kind.to_s) { styles["info"] } %>
<div data-controller="flash" data-flash-target="message"
     class="pointer-events-auto flex items-center gap-2 rounded-lg px-4 py-2 text-base shadow-lg ring-1 <%= style[:box] %>">
  <%= icon(style[:icon], classes: "size-4 shrink-0 #{style[:icon_class]}") %>
  <%= message %>
</div>

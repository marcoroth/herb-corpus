<%# locals: (label:, from:, to:) %>
<div class="flex items-center gap-1 shrink-0">
  <span class="text-xs text-ink-soft whitespace-nowrap"><%= label %></span>
  <%= date_field_tag from, filter_value(from.to_sym),
        class: "input w-32", title: t("shared.filters.range_from", label: label),
        data: { controller: "submit-on-change", action: "change->submit-on-change#submit" } %>
  <span class="text-xs text-ink-faint">–</span>
  <%= date_field_tag to, filter_value(to.to_sym),
        class: "input w-32", title: t("shared.filters.range_to", label: label),
        data: { controller: "submit-on-change", action: "change->submit-on-change#submit" } %>
</div>

<% flash.each do |type, message| %>
  <% next if type == "next_task_prompt" %>
  <div data-controller="flash" data-flash-target="message"
       class="fixed top-4 left-1/2 -translate-x-1/2 z-50 flex items-center gap-2 rounded-lg px-4 py-2 text-base shadow-lg ring-1
              <%= type == "alert" ? "bg-danger-soft text-danger-strong ring-danger-line" : "bg-canvas-raised text-ink ring-line-strong" %>">
    <%= icon(type == "alert" ? :x : :check, classes: "size-4 #{type == 'alert' ? 'text-danger' : 'text-green-600 dark:text-green-400'}") %>
    <%= message %>
  </div>
<% end %>

<%# locals: (record:) %>
<section>
  <h3 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-ink-faint mb-2">
    <%= icon :paperclip, classes: "size-3.5" %> <%= t("shared.attachments.title") %>
    <span class="text-ink-faint font-normal normal-case tracking-normal">(<%= record.record_attachments.count %>)</span>
  </h3>

  <%= form_with url: record_attachments_path, class: "card p-3 mb-3", multipart: true do |f| %>
    <%= hidden_field_tag :attachable_type, record.class.name %>
    <%= hidden_field_tag :attachable_id, record.id %>
    <div class="flex items-center gap-2">
      <%= file_field_tag "record_attachment[file]", class: "file-input flex-1" %>
      <%= submit_tag t("shared.attachments.upload"), class: "btn-primary" %>
    </div>
  <% end %>

  <% if record.record_attachments.any? %>
    <ul class="space-y-1">
      <% record.record_attachments.includes(:user, file_attachment: :blob).each do |attachment| %>
        <li class="flex items-center gap-2 rounded-md px-2 py-1.5 hover:bg-canvas-sunken text-base">
          <%= icon :paperclip, classes: "size-3.5 text-ink-faint" %>
          <%= link_to attachment.display_name, rails_blob_path(attachment.file, disposition: "attachment"), class: "text-accent hover:underline truncate" %>
          <span class="text-xs text-ink-faint ml-auto"><%= number_to_human_size(attachment.file.byte_size) %></span>
          <%= button_to record_attachment_path(attachment), method: :delete, form: { data: { turbo_confirm: t("shared.attachments.remove_confirm") } },
                class: "text-ink-faint hover:text-danger p-1" do %>
            <%= icon :trash, classes: "size-3" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

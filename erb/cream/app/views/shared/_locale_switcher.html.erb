<%# locals: (compact: false) %>
<div class="<%= compact ? "public-booking-locale shrink-0" : "flex items-center gap-0.5 rounded-md border border-line p-0.5" %>"
     role="group"
     aria-label="<%= t("nav.language") %>"
     data-controller="locale"
     data-locale-url-value="<%= locale_preference_path %>"
     data-locale-locale-value="<%= I18n.locale %>">
  <button type="button"
          data-locale-target="es"
          data-action="locale#setLocale"
          data-locale="es"
          class="<%= compact ? "public-booking-locale-btn" : "locale-btn" %>">ES</button>
  <button type="button"
          data-locale-target="en"
          data-action="locale#setLocale"
          data-locale="en"
          class="<%= compact ? "public-booking-locale-btn" : "locale-btn" %>">EN</button>
</div>

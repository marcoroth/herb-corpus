<%# Company picker with inline search and on-the-fly creation. Local: form, select_data: {} %>
<%= render RecordPickerComponent.new(
      form: form,
      attribute: :company_id,
      label: t("records.fields.company"),
      scope: current_workspace.companies.order(:name),
      search_url: picker_companies_path(format: :json),
      create_url: companies_path(format: :json),
      create_param: "company",
      selected_name: form.object.company&.name,
      required: true,
      hidden_data: local_assigns[:select_data] || {},
      hint_method: :domain
    ) %>

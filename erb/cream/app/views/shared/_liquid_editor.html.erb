<%# locals: (form:, field:, rows: 24, required: false, input_data: {}, preview_form_id: nil) %>
<% input_options = { rows: rows, spellcheck: false, class: "sr-only", data: { liquid_editor_target: "input" }.merge(input_data[:data] || {}) } %>
<% input_options[:required] = true if required %>
<div class="liquid-editor border border-line rounded-md overflow-hidden bg-canvas"
     data-controller="liquid-editor"
     <%= "data-liquid-editor-preview-form-id=\"#{preview_form_id}\"" if preview_form_id.present? %>>
  <%= form.text_area field, **input_options %>
  <div data-liquid-editor-target="editor" class="liquid-editor__surface" style="min-height: <%= rows * 1.4 %>rem;"></div>
</div>

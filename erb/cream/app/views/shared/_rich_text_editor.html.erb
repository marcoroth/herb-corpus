<%# locals: (form: nil, field:, value: nil, placeholder: nil, compact: false, input_data: {}) %>
<% value = value || (form&.object&.public_send(field) if form&.object) %>
<% input_options = { value: value, placeholder: placeholder, data: { rich_text_editor_target: "input" }.merge(input_data[:data] || {}) } %>
<div class="rich-text-editor border border-line rounded-md overflow-hidden bg-canvas <%= "rich-text-editor--compact" if compact %>" data-controller="rich-text-editor">
  <% if form %>
    <%= form.hidden_field field, **input_options.except(:value) %>
  <% else %>
    <%= hidden_field_tag field, value, **input_options %>
  <% end %>
  <div data-rich-text-editor-target="editor"></div>
</div>

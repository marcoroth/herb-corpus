<%# locals: (fields:, cf: nil) %>
<% cf_values = cf || params[:cf] %>
<% fields.select(&:select?).each do |field| %>
  <%= select_tag "cf[#{field.key}]",
        options_for_select(field.options, cf_values.is_a?(Hash) ? cf_values[field.key] : cf_values&.dig(field.key)),
        include_blank: t("shared.filters.all_name", name: field.name.downcase), class: "input w-44",
        data: { controller: "submit-on-change", action: "change->submit-on-change#submit" } %>
<% end %>
<% fields.select(&:boolean?).each do |field| %>
  <%= select_tag "cf[#{field.key}]",
        options_for_select([ [ t("shared.filters.yes"), "true" ], [ t("shared.filters.no"), "false" ] ], cf_values.is_a?(Hash) ? cf_values[field.key] : cf_values&.dig(field.key)),
        include_blank: field.name, class: "input w-32",
        data: { controller: "submit-on-change", action: "change->submit-on-change#submit" } %>
<% end %>
<% fields.select(&:reference?).each do |field| %>
  <%= select_tag "cf[#{field.key}]",
        options_from_collection_for_select(field.reference_scope(current_workspace), :id, field.reference_label_method,
          cf_values.is_a?(Hash) ? cf_values[field.key] : cf_values&.dig(field.key)),
        include_blank: t("shared.filters.all_name", name: field.name.downcase), class: "input w-44",
        data: { controller: "submit-on-change", action: "change->submit-on-change#submit" } %>
<% end %>

<%# locals: (body:) %>
<% srcdoc = email_body_srcdoc(body) %>
<% if srcdoc.present? %>
  <div data-controller="email-frame">
    <iframe title="<%= t("records.email_message.body_frame") %>"
            class="email-body-frame w-full border-0 bg-white rounded-md"
            sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox"
            srcdoc="<%= h(srcdoc) %>"
            data-email-frame-target="frame"
            data-action="load->email-frame#resize"></iframe>
  </div>
<% else %>
  <div class="email-body text-sm text-ink break-words"><%= email_body_html(body) %></div>
<% end %>

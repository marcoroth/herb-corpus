<div class="mx-auto w-full max-w-2xl">
  <header class="mb-8 text-center">
    <%= link_to root_path, class: "inline-flex items-center gap-2 text-ink-faint hover:text-ink transition-colors" do %>
      <%= image_tag "/icon.svg", alt: "cream", class: "inline-block size-9" %>
      <span class="font-display font-semibold text-lg">CR<span class="text-copperfield-400">ea</span>M<span class="tracking-widest"><span class="text-hoki-500">.</span><span class="text-copperfield-400">.</span><span class="text-golden-300">.</span></span></span>
    <% end %>
    <h1 class="mt-4 text-2xl font-semibold"><%= title %></h1>
    <% if local_assigns[:subtitle].present? %>
      <p class="mt-2 text-base text-ink-faint"><%= subtitle %></p>
    <% end %>
  </header>

  <article class="card p-6 sm:p-8 shadow-sm space-y-4 text-base text-ink-soft leading-relaxed">
    <%= yield %>
  </article>

  <%= render "legal_pages/footer_nav" %>
</div>

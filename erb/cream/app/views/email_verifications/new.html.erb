<% page_title t("auth.email_verification.title") %>
<div class="w-full max-w-sm">
  <div class="text-center mb-6">
    <%= image_tag "/icon.svg", alt: "cream", class: "inline-block size-10 mb-3" %>
    <h1 class="text-xl font-semibold"><%= t("auth.email_verification.title") %></h1>
    <p class="text-base text-ink-faint mt-1"><%= t("auth.email_verification.subtitle") %></p>
  </div>

  <div class="card p-6 shadow-sm">
    <%= form_with url: email_verifications_path, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :email_address, t("auth.sign_in.email"), class: "label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
              placeholder: t("auth.email_verification.email_placeholder"), value: params[:email_address], class: "input" %>
      </div>
      <%= form.submit t("auth.email_verification.submit"), class: "btn-primary w-full justify-center" %>
    <% end %>

    <p class="mt-4 text-center text-sm text-ink-faint">
      <%= link_to t("auth.registration.sign_in"), new_session_path, class: "font-medium text-accent hover:underline" %>
    </p>
  </div>
</div>

<div class="grid min-w-[42rem] grid-cols-[1.75rem_minmax(8rem,1fr)_8rem_6rem_3.5rem_3.5rem_8.75rem] gap-2 items-center rounded-lg ring-1 ring-transparent hover:ring-line"
     data-nested-form-target="row">
  <span role="button" tabindex="-1"
        data-sortable-list-target="handle"
        class="cursor-grab active:cursor-grabbing text-ink-faint hover:text-ink-soft p-1.5 touch-none select-none"
        title="<%= t("pipelines.stage_row.drag_reorder") %>" aria-label="<%= t("pipelines.stage_row.drag_reorder") %>"
        data-action="pointerdown->sortable-list#pointerDown">
    <%= icon :grip, classes: "size-3.5 pointer-events-none" %>
  </span>
  <%= f.hidden_field :position %>
  <%= f.text_field :name, class: "input", placeholder: t("pipelines.form.stage_name_placeholder") %>
  <div class="flex items-center gap-1">
    <% PipelineStage::COLORS.each do |color| %>
      <label class="cursor-pointer" title="<%= color %>">
        <%= f.radio_button :color, color, class: "peer sr-only" %>
        <span class="block size-4 rounded-full bg-<%= color %>-500 ring-offset-1 ring-offset-canvas-raised peer-checked:ring-2 peer-checked:ring-ink"></span>
      </label>
    <% end %>
  </div>
  <%= f.number_field :probability, class: "input", min: 0, max: 100, step: 5 %>
  <label class="flex items-center justify-center gap-1 text-sm" title="<%= t("pipelines.form.won") %>">
    <%= f.check_box :won, class: "rounded border-line-strong" %>
  </label>
  <label class="flex items-center justify-center gap-1 text-sm" title="<%= t("pipelines.form.closed") %>">
    <%= f.check_box :closed, class: "rounded border-line-strong" %>
  </label>
  <%= f.hidden_field :_destroy %>
  <div class="flex items-center">
  <% if feature_enabled?(:stage_triggers) && f.object.persisted? %>
    <%= link_to pipeline_stage_stage_triggers_path(f.object),
          class: "flex w-9 items-center gap-0.5 text-ink-faint hover:text-accent p-1.5 text-sm",
          title: t("pipelines.stage_row.stage_triggers") do %>
      <%= icon :zap, classes: "size-3.5" %><% if (count = f.object.stage_triggers.size).positive? %><%= count %><% end %>
    <% end %>
  <% else %>
    <span class="w-9"></span>
  <% end %>
  <% if feature_enabled?(:stage_field_formats) && f.object.persisted? %>
    <%= link_to pipeline_stage_stage_field_formats_path(f.object),
          class: "flex w-9 items-center gap-0.5 text-ink-faint hover:text-accent p-1.5 text-sm",
          title: t("pipelines.stage_row.field_formats") do %>
      <%= icon :eye, classes: "size-3.5" %><% if (count = f.object.stage_field_formats.size).positive? %><%= count %><% end %>
    <% end %>
  <% else %>
    <span class="w-9"></span>
  <% end %>
  <% if feature_enabled?(:stage_conditions) && f.object.persisted? %>
    <%= link_to pipeline_stage_stage_conditions_path(f.object),
          class: "flex w-9 items-center gap-0.5 text-ink-faint hover:text-accent p-1.5 text-sm",
          title: t("pipelines.stage_row.entry_conditions") do %>
      <%= icon :lock, classes: "size-3.5" %><% if (count = f.object.stage_conditions.size).positive? %><%= count %><% end %>
    <% end %>
  <% else %>
    <span class="w-9"></span>
  <% end %>
  <button type="button" data-action="nested-form#remove" class="text-ink-faint hover:text-danger p-1.5"
        title="<%= t("pipelines.stage_row.remove_stage") %>">
    <%= icon :trash, classes: "size-3.5" %>
  </button>
  </div>
</div>

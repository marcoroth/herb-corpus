<h2><%= @rule.name %></h2>
<p><%= t("alert_mailer.alert_email.greeting", name: @user.name) %></p>
<p>
  <%= t("alert_mailer.alert_email.body_html",
        deal_name: @deal.name,
        company_name: @deal.company.name,
        workspace_name: @rule.workspace.name) %>
</p>
<p>
  <%= link_to t("alert_mailer.alert_email.view_deal"), @deal_url %>
</p>
<p style="color:#999;font-size:12px;margin-top:16px;">
  <%= t("alert_mailer.alert_email.footer") %>
</p>

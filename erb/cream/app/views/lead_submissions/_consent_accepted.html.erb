<%# locals: (submission:) %>
<% if submission.metadata["gdpr_consent_at"].present? || submission.privacy_policy_version.present? %>
  <div class="rounded-lg border border-line bg-canvas-sunken/40 p-4 space-y-3">
    <h3 class="text-sm font-semibold uppercase tracking-wider text-ink-faint"><%= t("deals.consent.title") %></h3>
    <% if submission.metadata["gdpr_consent_at"].present? %>
      <p class="text-sm"><span class="text-ink-faint"><%= t("deals.consent.date") %></span> <%= l(Time.zone.parse(submission.metadata["gdpr_consent_at"]), format: :long) rescue submission.metadata["gdpr_consent_at"] %></p>
    <% end %>
    <% if submission.metadata["privacy_policy_url"].present? %>
      <p class="text-sm"><span class="text-ink-faint"><%= t("deals.consent.policy") %></span> <%= link_to submission.metadata["privacy_policy_url"], submission.metadata["privacy_policy_url"], class: "text-accent hover:underline break-all", target: "_blank", rel: "noopener" %></p>
    <% end %>
    <% hash = submission.privacy_policy_version&.content_hash || submission.metadata["privacy_policy_hash"] %>
    <% if hash.present? %>
      <p class="text-sm font-mono text-xs break-all"><span class="text-ink-faint font-sans"><%= t("deals.consent.hash") %></span> <%= hash %></p>
    <% end %>
    <% if submission.metadata["privacy_policy_hash_unverified"] %>
      <p class="text-sm text-danger-strong"><%= t("deals.consent.unverified") %></p>
    <% end %>
    <% if submission.privacy_policy_version %>
      <details class="text-sm">
        <summary class="cursor-pointer text-accent"><%= t("deals.consent.view_policy") %></summary>
        <div class="mt-2 prose prose-sm max-w-none"><%= sanitize_accepted_policy_html submission.privacy_policy_version.policy_content %></div>
      </details>
      <details class="text-sm">
        <summary class="cursor-pointer text-accent"><%= t("deals.consent.view_statement") %></summary>
        <div class="mt-2 text-ink-soft"><%= sanitize_accepted_policy_html submission.privacy_policy_version.statement_content %></div>
      </details>
    <% end %>
  </div>
<% end %>

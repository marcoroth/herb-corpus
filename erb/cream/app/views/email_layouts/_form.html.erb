<% form_id = dom_id(layout, :form) %>
<%= form_with model: layout, html: { id: form_id }, class: "card p-4 space-y-3" do |f| %>
  <% if layout.errors.any? %>
    <div class="rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800">
      <%= layout.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "label" %>
    <%= f.text_field :name, class: "input w-full", required: true %>
  </div>
  <div>
    <%= f.label :body, t("email_templates.layouts.form.body_label"), class: "label" %>
    <%= render "shared/liquid_editor", form: f, field: :body, rows: 24, required: true %>
    <p class="mt-1 text-xs text-ink-faint"><%= t("email_templates.layouts.form.body_hint").html_safe %></p>
  </div>

  <%= render "shared/email_preview_panel",
        preview_url: preview_email_layouts_path,
        source_form_id: form_id,
        tokens: @preview_tokens || EmailTemplatePreview::STANDARD_TOKENS,
        show_layout_sample: true %>

  <div class="flex gap-2">
    <%= f.submit class: "btn-primary" %>
    <%= link_to t("shared.form.cancel"), email_templates_path, class: "btn-secondary" %>
  </div>
<% end %>

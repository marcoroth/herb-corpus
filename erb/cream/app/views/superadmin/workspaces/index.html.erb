<% page_title t("superadmin.workspaces.page_title") %>
<%= render "shared/page_header",
      title: t("superadmin.workspaces.title"),
      icon_name: :building,
      count: @workspaces.size,
      actions: link_to(t("superadmin.workspaces.new"), new_superadmin_workspace_path, class: "btn-primary") %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5">
  <div class="max-w-4xl space-y-4">
    <p class="text-base text-ink-soft"><%= t("superadmin.workspaces.intro") %></p>

    <% if @workspaces.any? %>
      <div class="card overflow-hidden">
        <table class="w-full text-base">
          <thead class="bg-canvas-tint border-b border-line text-left text-sm text-ink-faint">
            <tr>
              <th class="px-4 py-2 font-medium"><%= t("superadmin.workspaces.table.name") %></th>
              <th class="px-4 py-2 font-medium"><%= t("superadmin.workspaces.table.slug") %></th>
              <th class="px-4 py-2 font-medium"><%= t("superadmin.workspaces.table.domain") %></th>
              <th class="px-4 py-2 font-medium"><%= t("superadmin.workspaces.table.members") %></th>
              <th class="px-4 py-2 font-medium text-right"><%= t("superadmin.workspaces.table.actions") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            <% @workspaces.each do |workspace| %>
              <tr class="hover:bg-accent-soft/30">
                <td class="px-4 py-3 font-medium text-ink">
                  <%= link_to workspace.name, superadmin_workspace_path(workspace), class: "hover:text-accent" %>
                </td>
                <td class="px-4 py-3 font-mono text-sm text-ink-soft"><%= workspace.slug %></td>
                <td class="px-4 py-3 text-ink-soft"><%= workspace.email_domain.presence || "—" %></td>
                <td class="px-4 py-3 text-ink-soft"><%= workspace.memberships.real_team.count %></td>
                <td class="px-4 py-3 text-right space-x-2">
                  <%= button_to t("superadmin.workspaces.enter"), enter_superadmin_workspace_path(workspace), method: :post, class: "btn-secondary text-sm" %>
                  <%= link_to t("superadmin.workspaces.edit"), edit_superadmin_workspace_path(workspace), class: "btn-ghost text-sm" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-ink-faint"><%= t("superadmin.workspaces.empty") %></p>
    <% end %>
  </div>
</div>

<% page_title t("superadmin.workspaces.edit_page_title", name: @workspace.name) %>
<%= render "shared/page_header",
      title: t("superadmin.workspaces.edit_title", name: @workspace.name),
      icon_name: :pencil,
      actions: link_to(t("superadmin.workspaces.back"), superadmin_workspace_path(@workspace), class: "btn-ghost") %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5">
  <div class="max-w-xl space-y-6">
    <%= render "edit_form", workspace: @workspace %>
  </div>
</div>

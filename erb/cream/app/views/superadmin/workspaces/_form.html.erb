<%= form_with model: workspace, url: superadmin_workspaces_path, class: "card p-4 space-y-4" do |f| %>
  <% if workspace.errors.any? %>
    <div class="text-sm text-red-600"><%= workspace.errors.full_messages.to_sentence %></div>
  <% end %>

  <div>
    <%= f.label :name, t("integrations.workspace.general.name"), class: "label" %>
    <%= f.text_field :name, required: true, class: "input mt-1 w-full" %>
  </div>

  <div>
    <%= f.label :slug, t("superadmin.workspaces.form.slug"), class: "label" %>
    <%= f.text_field :slug, class: "input mt-1 w-full font-mono", placeholder: t("superadmin.workspaces.form.slug_placeholder") %>
    <p class="mt-1 text-sm text-ink-faint"><%= t("superadmin.workspaces.form.slug_hint") %></p>
  </div>

  <div>
    <%= f.label :email_domain, t("superadmin.workspaces.form.email_domain"), class: "label" %>
    <%= f.text_field :email_domain, class: "input mt-1 w-full", placeholder: "example.com" %>
    <p class="mt-1 text-sm text-ink-faint"><%= t("superadmin.workspaces.form.email_domain_hint") %></p>
  </div>

  <div>
    <%= f.label :time_zone, t("workspace_settings.time_zone"), class: "label" %>
    <%= f.select :time_zone, time_zone_options(selected: workspace.time_zone), {}, class: "input mt-1 w-full" %>
  </div>

  <hr class="border-line">

  <h3 class="text-base font-semibold text-ink"><%= t("superadmin.workspaces.form.initial_admin") %></h3>

  <div>
    <%= label_tag "workspace_initial_admin_email", t("integrations.team.invite_email"), class: "label" %>
    <%= email_field_tag "workspace[initial_admin_email]", params.dig(:workspace, :initial_admin_email), id: "workspace_initial_admin_email", class: "input mt-1 w-full" %>
  </div>

  <div>
    <%= label_tag "workspace_initial_admin_role", t("integrations.team.invite_section.role"), class: "label" %>
    <%= select_tag "workspace[initial_admin_role]",
          options_for_select(Membership.role_options, "admin"),
          id: "workspace_initial_admin_role",
          class: "input mt-1 w-full" %>
  </div>

  <%= f.submit submit_label, class: "btn-primary" %>
<% end %>

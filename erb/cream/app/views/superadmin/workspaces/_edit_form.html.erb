<%= form_with model: workspace, url: superadmin_workspace_path(workspace), method: :patch, class: "card p-4 space-y-4" do |f| %>
  <% if workspace.errors.any? %>
    <div class="text-sm text-red-600"><%= workspace.errors.full_messages.to_sentence %></div>
  <% end %>

  <div>
    <%= f.label :name, t("integrations.workspace.general.name"), class: "label" %>
    <%= f.text_field :name, required: true, class: "input mt-1 w-full" %>
  </div>

  <div>
    <%= f.label :email_domain, t("superadmin.workspaces.form.email_domain"), class: "label" %>
    <%= f.text_field :email_domain, class: "input mt-1 w-full" %>
    <p class="mt-1 text-sm text-ink-faint"><%= t("superadmin.workspaces.form.email_domain_hint") %></p>
  </div>

  <div>
    <%= f.label :time_zone, t("workspace_settings.time_zone"), class: "label" %>
    <%= f.select :time_zone, time_zone_options(selected: workspace.time_zone), {}, class: "input mt-1 w-full" %>
  </div>

  <hr class="border-line">
  <h3 class="text-base font-semibold text-ink"><%= t("integrations.workspace.features.title") %></h3>

  <label class="flex items-center gap-2 text-base">
    <%= f.check_box :salespeople_can_view_all_deals %>
    <%= t("integrations.workspace.general.salespeople_view") %>
  </label>
  <label class="flex items-center gap-2 text-base">
    <%= f.check_box :salespeople_can_edit_all_deals %>
    <%= t("integrations.workspace.general.salespeople_edit") %>
  </label>
  <label class="flex items-center gap-2 text-base">
    <%= f.check_box :sales_director_enabled %>
    <%= t("integrations.workspace.general.sales_director") %>
  </label>
  <label class="flex items-center gap-2 text-base">
    <%= f.check_box :okm_chat_enabled %>
    <%= t("integrations.workspace.okm.enable") %>
  </label>
  <label class="flex items-center gap-2 text-base">
    <%= f.check_box :reports_enabled %>
    <%= t("integrations.workspace.features.reports") %>
  </label>
  <label class="flex items-center gap-2 text-base">
    <%= f.check_box :marketing_attribution_enabled %>
    <%= t("integrations.workspace.features.attribution") %>
  </label>
  <label class="flex items-center gap-2 text-base">
    <%= f.check_box :lead_scoring_enabled %>
    <%= t("integrations.workspace.features.lead_scoring") %>
  </label>
  <label class="flex items-center gap-2 text-base">
    <%= f.check_box :webhooks_enabled %>
    <%= t("integrations.workspace.features.webhooks") %>
  </label>
  <label class="flex items-center gap-2 text-base">
    <%= f.check_box :custom_fields_enabled %>
    <%= t("integrations.workspace.features.custom_fields") %>
  </label>

  <%= f.submit t("integrations.workspace.general.save"), class: "btn-primary" %>
<% end %>

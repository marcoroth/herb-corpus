<%= form_with model: webhook, class: "card p-4 space-y-3" do |f| %>
  <div>
    <%= f.label :url, class: "label" %>
    <%= f.url_field :url, class: "input w-full" %>
  </div>
  <div>
    <%= f.label :secret, class: "label" %>
    <%= f.text_field :secret, class: "input w-full" %>
  </div>
  <div>
    <span class="label"><%= t("integrations.webhooks.events") %></span>
    <% Webhook::EVENTS.each do |event| %>
      <label class="flex items-center gap-2 text-base">
        <%= check_box_tag "webhook[events][]", event, webhook.events.include?(event) %> <%= event %>
      </label>
    <% end %>
  </div>
  <label class="flex items-center gap-2 text-base"><%= f.check_box :active %> <%= t("integrations.webhooks.form.active") %></label>
  <%= f.submit class: "btn-primary" %>
<% end %>

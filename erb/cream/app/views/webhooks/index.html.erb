<% page_title t("integrations.webhooks.page_title") %>
<% actions = capture do %>
  <%= link_to new_webhook_path, class: "btn-primary" do %>
    <%= icon :plus, classes: "size-3.5" %> <%= t("integrations.webhooks.new") %>
  <% end %>
<% end %>
<%= render "shared/page_header", title: t("integrations.webhooks.title"), icon_name: :globe, count: @webhooks.size, actions: actions %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5 space-y-3">
  <% @webhooks.each do |webhook| %>
    <article class="card p-4">
      <div class="flex items-center gap-2">
        <h2 class="font-semibold text-base truncate"><%= webhook.url %></h2>
        <%= badge webhook.active? ? t("integrations.webhooks.active") : t("integrations.webhooks.inactive"), color: webhook.active? ? "green" : "chicago" %>
        <div class="ml-auto flex gap-2">
          <%= link_to t("integrations.webhooks.edit"), edit_webhook_path(webhook), class: "btn-secondary" %>
          <%= button_to webhook_path(webhook), method: :delete, class: "btn-danger" %>
        </div>
      </div>
      <p class="text-sm text-ink-faint mt-1"><%= webhook.events.join(", ") %></p>
    </article>
  <% end %>
</div>

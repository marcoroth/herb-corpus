<% page_title t("stage_field_formats.index.page_title", stage: @stage.name) %>
<% actions = capture do %>
  <%= link_to edit_pipeline_path(@stage.pipeline), class: "btn-secondary" do %>
    <%= icon :arrow_left, classes: "size-3.5" %> <%= t("stage_field_formats.index.back_pipeline") %>
  <% end %>
  <%= link_to new_pipeline_stage_stage_field_format_path(@stage), class: "btn-primary" do %>
    <%= icon :plus, classes: "size-3.5" %> <%= t("stage_field_formats.index.new") %>
  <% end %>
<% end %>
<%= render "shared/page_header",
      title: t("stage_field_formats.index.title", stage: @stage.name, pipeline: @stage.pipeline.name),
      icon_name: :eye, count: @stage_field_formats.size, actions: actions %>

<div class="flex-1 overflow-y-auto scrollbar-subtle p-5 space-y-3">
  <p class="text-sm text-ink-faint">
    <%= t("stage_field_formats.index.intro_html", stage: h(@stage.name)).html_safe %>
  </p>
  <% if @stage_field_formats.empty? %>
    <p class="text-base text-ink-soft"><%= t("stage_field_formats.index.empty") %></p>
  <% end %>
  <% @stage_field_formats.each do |format| %>
    <article class="card p-4">
      <div class="flex items-center gap-2">
        <h2 class="font-semibold text-base"><%= StageFieldFormat.field_label(format.field) %></h2>
        <%= badge format.active? ? t("stage_field_formats.index.active") : t("stage_field_formats.index.inactive"),
              color: format.active? ? "green" : "chicago" %>
        <div class="ml-auto flex gap-2">
          <%= link_to t("stage_field_formats.index.edit"), edit_stage_field_format_path(format), class: "btn-secondary" %>
          <%= button_to t("stage_field_formats.index.destroy"), stage_field_format_path(format), method: :delete, class: "btn-danger",
                data: { turbo_confirm: t("stage_field_formats.index.destroy_confirm") } %>
        </div>
      </div>
      <p class="text-sm text-ink-faint mt-1">
        <%= t("stage_field_formats.index.rule_html",
              field: h(StageFieldFormat.field_label(format.field).downcase),
              operator_phrase: h(format.operator_phrase),
              display_text: h(format.display_text)).html_safe %>
      </p>
    </article>
  <% end %>
</div>

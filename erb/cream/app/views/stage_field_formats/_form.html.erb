<%= form_with model: stage_field_format,
      url: stage_field_format.persisted? ? stage_field_format_path(stage_field_format) : pipeline_stage_stage_field_formats_path(stage),
      html: { data: { controller: "stage-field-format-form" } }, class: "card p-4 space-y-4" do |f| %>
  <% if stage_field_format.errors.any? %>
    <div class="rounded-lg bg-danger-soft text-danger-strong ring-1 ring-danger-line px-3 py-2 text-sm">
      <%= stage_field_format.errors.full_messages.join(". ") %>
    </div>
  <% end %>

  <div>
    <%= f.label :field, t("stage_field_formats.form.field"), class: "label" %>
    <%= f.select :field, StageFieldFormat.field_options, {}, class: "input w-full" %>
  </div>

  <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
    <div>
      <%= f.label :operator, t("stage_field_formats.form.operator"), class: "label" %>
      <%= f.select :operator, StageFieldFormat.operator_options, {},
            class: "input w-full",
            data: { "stage-field-format-form-target" => "operator", action: "stage-field-format-form#refresh" } %>
    </div>
    <div data-stage-field-format-form-target="compareValue">
      <%= f.label :compare_value, t("stage_field_formats.form.compare_value"), class: "label" %>
      <%= f.text_field :compare_value, class: "input w-full",
            placeholder: t("stage_field_formats.form.compare_value_placeholder") %>
    </div>
  </div>

  <div>
    <%= f.label :display_text, t("stage_field_formats.form.display_text"), class: "label" %>
    <%= f.text_field :display_text, class: "input w-full",
          placeholder: t("stage_field_formats.form.display_text_placeholder") %>
    <p class="text-sm text-ink-faint mt-1"><%= t("stage_field_formats.form.display_text_hint") %></p>
  </div>

  <label class="flex items-center gap-2 text-base"><%= f.check_box :active %> <%= t("stage_field_formats.form.active") %></label>
  <%= f.submit stage_field_format.persisted? ? t("stage_field_formats.form.submit_update") : t("stage_field_formats.form.submit_create"),
        class: "btn-primary" %>
<% end %>

<% content_for :title, t(".title") %>

<div class="card card-border max-w-md">
  <div class="card-body">
    <h1 class="card-title"><%= t(".title") %></h1>
    <p><%= t(".intro") %></p>

    <%= form_with model: @signup, url: signup_path do |form| %>
      <%= render FormField::Component.new(form:, attribute: :email_address, as: :email_field) %>

      <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <% end %>

    <%= link_to t(".sign_in"), new_session_path, class: "link" %>
  </div>
</div>

<% content_for :title, t(".title") %>

<h1><%= t(".title") %></h1>

<%= form_with model: @form, url: accounts_path do |form| %>
  <% if @form.person_name_needed? %>
    <%= render FormField::Component.new(form:, attribute: :person_name) %>
  <% end %>
  <%= render FormField::Component.new(form:, attribute: :name) %>

  <%= form.submit t(".submit"), class: "btn btn-primary" %>
<% end %>

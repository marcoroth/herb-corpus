<% content_for :title, @business.name %>

<article class="card card-border">
  <div class="card-body">
    <h1 class="card-title"><%= @business.name %></h1>
    <%= simple_format @business.description %>

    <div class="card-actions">
      <%= link_to t(".edit"), edit_business_path(@business), class: "btn" %>
      <%= button_to t(".destroy"), @business, method: :delete, class: "btn btn-error",
            form: {data: {turbo_confirm: t(".confirm_destroy")}} %>
      <%= link_to t(".back"), businesses_path, class: "btn btn-ghost" %>
    </div>
  </div>
</article>

<% content_for :title, t(".title") %>

<h1><%= t(".title") %></h1>

<%= link_to t(".new"), new_business_path, class: "btn btn-primary" %>

<div class="overflow-x-auto">
  <table class="table">
    <thead>
      <tr>
        <th><%= Business.human_attribute_name(:name) %></th>
      </tr>
    </thead>
    <tbody>
      <% @businesses.each do |business| %>
        <tr>
          <td><%= link_to business.name, business %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

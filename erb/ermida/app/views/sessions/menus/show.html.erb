<% content_for :title, t(".title") %>

<h1><%= t(".title") %></h1>

<% if @accounts.any? %>
  <ul class="list">
    <% @accounts.each do |account| %>
      <li class="list-row"><%= link_to account.name, root_path(script_name: account_script_name(account)), class: "link" %></li>
    <% end %>
  </ul>
<% else %>
  <p><%= t(".empty") %></p>
  <%= link_to t(".new"), new_account_path, class: "btn btn-primary" %>
<% end %>

<%= button_to t(".sign_out"), session_path, method: :delete, class: "btn btn-ghost" %>

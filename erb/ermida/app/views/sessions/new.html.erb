<% content_for :title, t(".title") %>

<div class="card card-border max-w-md">
  <div class="card-body">
    <h1 class="card-title"><%= t(".title") %></h1>

    <%= form_with model: @sign_in, url: session_path do |form| %>
      <%= form.label :email_address, t(".email_address"), class: "label" %>
      <%= form.email_field :email_address, class: "input", required: true, autofocus: true, autocomplete: "username" %>

      <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <% end %>

    <%= link_to t(".sign_up"), new_signup_path, class: "link" %>
  </div>
</div>

<% content_for :title, t(".title") %>

<div class="card card-border max-w-md">
  <div class="card-body">
    <h1 class="card-title"><%= t(".title") %></h1>
    <p><%= t(".sent_to", email_address: @email_address) %></p>

    <% if flash[:magic_link_code] %>
      <p class="badge badge-warning"><%= t(".development_code", code: flash[:magic_link_code]) %></p>
    <% end %>

    <%= form_with url: session_magic_link_path do |form| %>
      <%= form.label :code, t(".code"), class: "label" %>
      <%= form.text_field :code, class: "input", required: true, autofocus: true, autocomplete: "one-time-code",
            maxlength: 16, inputmode: "text", spellcheck: false %>

      <%= form.submit t(".submit"), class: "btn btn-primary" %>
    <% end %>

    <%= link_to t(".start_over"), new_session_path, class: "link" %>
  </div>
</div>

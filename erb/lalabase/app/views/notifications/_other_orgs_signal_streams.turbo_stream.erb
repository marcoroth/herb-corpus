<%# The org switcher signal for ONE organisation's page: the dot, the count of
    every other organisation in the menu (so a count that dropped to zero is
    cleared too) and the count beyond the menu on "Alle Organisationen".
    Broadcast by Notifications::UnreadSignals.call to that organisation's
    badge stream (Notifications::Streams). %>
<%= turbo_stream.replace 'other_orgs_signal',
                         partial: 'notifications/other_orgs_dot',
                         locals: { counts: counts } %>
<% organisation_ids.each do |organisation_id| %>
  <%= turbo_stream.replace "org_attention_count_#{organisation_id}",
                           partial: 'notifications/org_attention_count',
                           locals: { target_id: "org_attention_count_#{organisation_id}", count: counts[organisation_id].to_i } %>
<% end %>
<%= turbo_stream.replace 'org_attention_count_overflow',
                         partial: 'notifications/org_attention_count',
                         locals: { target_id: 'org_attention_count_overflow', count: overflow_count } %>

<%# Partial for notification list updates via Turbo Frame %>
<%= turbo_frame_tag "notification_list" do %>
  <div class="notification-list" id="notifications">
    <% if @notifications&.any? %>
      <%= render partial: 'notifications/notification', collection: @notifications %>
    <% else %>
      <div class="notification-empty">
        <div class="notification-empty-icon">
          <i class="bi bi-bell-slash"></i>
        </div>
        <div class="notification-empty-text">No notifications yet</div>
        <div class="notification-empty-subtext">We'll notify you when something happens</div>
      </div>
    <% end %>
  </div>
<% end %>
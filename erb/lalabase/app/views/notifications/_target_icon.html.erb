<%# Icon for the notification target %>
<% case notifiable %>
<% when Ticket %>
  <i class="bi bi-ticket-detailed text-blue-600"></i>
<% when Project %>
  <i class="bi bi-folder text-purple-600"></i>
<% when Document %>
  <i class="bi bi-file-earmark-text text-green-600"></i>
<% when Note %>
  <i class="bi bi-journal-text text-yellow-600"></i>
<% else %>
  <i class="bi bi-circle text-gray-400"></i>
<% end %>
<%# The permanent Turbo frame that carries the unread label of the sidebar's
    Inbox item. Its root IS the frame: this is the partial every writer of
    nav_notifications_count renders (all of them through
    notifications/_unread_count_streams.turbo_stream.erb), because a
    replace swaps the frame for the root of whatever is rendered. Rendering
    notifications/_nav_link there instead nested a second item (second bell,
    second link) inside the first one on every update (seen 08.09.2026).
    Guard: spec/requests/inbox_nav_count_stream_spec.rb.
    The count also arrives as a Stimulus value, so notification-count-listener
    starts from the fresh number after each replace; between replaces it
    follows the notifications:count-updated event from notification_count_data. %>
<%= turbo_frame_tag "nav_notifications_count",
      class: "contents",
      data: {
        controller: 'notification-count-listener',
        turbo_permanent: true,
        notification_count_listener_zero_label_value: t('navigation.notifications_label.zero'),
        notification_count_listener_one_label_value: t('navigation.notifications_label.one'),
        notification_count_listener_other_label_value: t('navigation.notifications_label.other'),
        notification_count_listener_include_count_value: false,
        notification_count_listener_count_value: unread_count.to_i
      } do %>
  <%= navigation_notifications_label_tag(unread_count) %>
<% end %>

<%# Partial to display individual activities within a grouped notification %>
<div class="group-activities">
  <% if activities.any? %>
    <div class="space-y-2">
      <% activities.each_with_index do |activity, index| %>
        <div class="activity-item flex items-center py-1 <%= 'border-t pt-2' if index > 0 %>">
          <div class="activity-content flex-1">
            <strong class="text-sm"><%= activity[:actor_name] %></strong>
            <span class="text-sm text-gray-600"><%= activity[:action] %></span>
          </div>
          
          <div class="activity-time">
            <span class="text-xs text-gray-400"><%= activity[:time_ago] %></span>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-sm text-gray-500 italic py-2">
      No detailed activities available.
    </div>
  <% end %>
</div>

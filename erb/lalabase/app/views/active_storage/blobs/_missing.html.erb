<%# Rendered for an <action-text-attachment> whose blob no longer exists (purged by the %>
<%# deletion deadline, removed by hand, upload never completed: the system cannot tell %>
<%# which, so the text names no cause). Wired by %>
<%# config/initializers/active_storage_missing_attachable_partial.rb. %>
<span class="attachment attachment--missing" role="img" aria-label="<%= t('views.action_text.missing_image') %>">
  <%= t('views.action_text.missing_image') %>
</span>

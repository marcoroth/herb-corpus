<% content_for :title, t('views.billing_accounts.index.title') %>

<%# The account summary (K2, doc/konto_ebene_plan.md). Only reached with MORE THAN ONE
    visible account or with none at all: the controller forwards straight to the single
    account when there is exactly one, because a list of one is a click that answers
    nothing.

    Full i18n keys, not lazy `t('.x')`: lazy lookup would search `billing_accounts.index.*`,
    and the keys live under `views.billing_accounts.*` (CLAUDE.md key convention). %>
<div class="container mx-auto px-4 py-10 max-w-4xl">
  <div class="mb-8">
    <%= link_to select_organisation_path,
                class: 'text-sm font-bold text-cream-500 hover:text-cream-900 inline-flex items-center gap-1.5' do %>
      <i class="bi bi-arrow-left" aria-hidden="true"></i>
      <%= t('views.billing_accounts.index.back') %>
    <% end %>
    <h1 class="text-2xl font-black text-cream-900 mt-3"><%= t('views.billing_accounts.index.title') %></h1>
    <p class="text-sm text-cream-600 mt-1"><%= t('views.billing_accounts.index.intro') %></p>
  </div>

  <% if @rows.any? %>
    <div class="border border-ink rounded-lg bg-surface-raised shadow-[2px_2px_0_0_#14110c] overflow-hidden">
      <% @rows.each do |row| %>
        <%= render 'billing_accounts/summary_row', row: row %>
      <% end %>
    </div>
  <% else %>
    <%# Reachable: a user who is a member of organisations but neither owns an account nor
        holds account_admin anywhere. Says what is true rather than what went wrong. %>
    <p class="text-sm text-cream-700 border border-cream-300 rounded-lg bg-surface-raised p-5">
      <%= t('views.billing_accounts.index.empty') %>
    </p>
  <% end %>
</div>

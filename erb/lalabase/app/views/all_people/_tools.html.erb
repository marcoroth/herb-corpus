<%# locals: (people:) %>
<%# What stands in the bar beside the search and carries the search in its
    address: the number of people and the organisation select. The search form
    reloads only the list frame, so this is drawn again from inside its answer
    (_results, a stream in the frame). display: contents keeps each part a flex
    item of the bar. The select lists the organisations that contribute
    (People::AcrossOrganisations#organisations): one without the people right is
    not named here either. Choosing one keeps the card open now (data-lane-keep:
    layout-toggle adds it to the form as it leaves); the card does not depend on
    the list's filter. %>
<div id="all_people_tools" class="contents">
  <p class="all-people-count" data-all-people-count><%= t('views.all_people.count', count: people.total) %></p>
  <div class="list-tab-bar__tools">
    <%= form_with url: all_people_path, method: :get,
                  data: { turbo_frame: '_top', controller: 'auto-submit', all_people_tool: 'organisation', lane_keep: true,
                          action: 'submit->all-people-filter#carrySearch' } do %>
      <%= hidden_field_tag :q, all_people_list_state[:q], id: nil %>
      <% chosen = Lalabase::Uuid.dashed(all_people_list_state[:org].to_s) %>
      <label>
        <span class="sr-only"><%= t('views.all_people.filter.organisation_label') %></span>
        <%= select_tag :org,
                       options_for_select([[t('views.all_people.filter.all_organisations'), '']] +
                                          people.organisations.map { |organisation| [organisation[:name], organisation[:id]] }, chosen),
                       id: 'all-people-organisation',
                       class: "list-tab-bar__select #{'list-tab-bar__select--active' if chosen}" %>
      </label>
    <% end %>
  </div>
</div>

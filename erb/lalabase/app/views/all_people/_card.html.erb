<%# locals: (card:, editing: false, mode: :contact) %>
<%# The card of one person (People::MergedCard::Card), in two modes (D10).

    Kontakt (mode :contact, the default): every value of every field, the
    lead's first (Card#lead), without its organisation and without a word about
    a value an organisation lacks. Two different values stand one below the
    other. The line under the name says where the person is entered: the kind
    the lead source gives the person and the lead's chip, the way into that
    organisation (out of the frame), and for
    several sources "+N", the summary of a <details> that opens to the chip of
    every source, the lead first, then the order of the list, each a link into
    its organisation. No script, and the open state is not remembered. It
    replaces the blocks per source ("In … öffnen") of the card before.

    Herkunft (mode :sources, or "Bearbeiten"), for several sources only: a
    value all sources share says so quietly ("in beiden", "in allen N"), any
    other value names the sources that hold it as chips, the lead first. The
    name is a field where the organisations wrote it differently. Below the
    notes, "Was steht wo" (Card#holdings) says per group of sources what they
    hold: what an organisation lacks shows there, per organisation. Its line
    under the name counts the organisations, with the kind where all of them
    give the person the same one (a merge often joins a member and a contact).

    "Bearbeiten" is Herkunft with the pencils: in the chips at the values (none
    at the name and email of a member: ValueSource#edit) and in the chips of
    "Was steht wo" (Source#edit; "Nur lesen" where the reader may not write).
    A pencil is a visit of that organisation's people page with the form open;
    that is also how a missing value is entered.

    A person of one organisation reads like the card on that organisation's
    people page: no chip at a value, no switch, no "Was steht wo".

    The notes stand under the last contact, per source, folded and read only.
    Nothing here is a form of a person, and every value is plain: this view
    runs without a tenant and loads nothing. %>
<% several = card.sources.many? %>
<% origin = several && (editing || mode == :sources) %>
<% sources = card.sources.index_by(&:organisation_id) %>
<% kinds = card.sources.map(&:kind).uniq %>
<div class="people-detail" data-card-mode="<%= origin ? 'sources' : 'contact' %>">
  <%= render 'all_people/card_head', card: card, editing: editing, mode: mode %>

  <div class="people-detail__body width-text">
    <% if origin %>
      <% count = if kinds.one?
                   t('views.all_people.card.line_count', kind: t("views.organisations.people.show.kind.#{kinds.first}"), count: card.sources.size)
                 else
                   t('views.all_people.card.line_count_mixed', count: card.sources.size)
                 end %>
      <% where = tag.p(count, class: 'people-identity__line', data: { card_where: true }) %>
    <% else %>
      <% lead = sources.fetch(card.lead) %>
      <% others = card.sources.reject { |source| source.equal?(lead) } %>
      <% where = capture do %>
        <div class="people-identity__line all-people-card__where" data-card-where>
          <span><%= t('views.all_people.card.line', kind: t("views.organisations.people.show.kind.#{lead.kind}")) %></span>
          <%= all_people_source_chip(lead) %>
          <% if others.any? %>
            <% names = all_people_organisation_names(others) %>
            <details class="all-people-card__more" data-card-more>
              <summary class="all-people-more all-people-card__more-toggle" title="<%= names %>">
                <span aria-hidden="true"><%= t('views.all_people.more.count', count: others.size) %></span>
                <span class="sr-only"><%= t('views.all_people.more.names', count: others.size, names: names) %></span>
                <i class="bi bi-chevron-down all-people-card__more-chevron" aria-hidden="true"></i>
              </summary>
              <span class="all-people-card__chips all-people-card__more-chips">
                <% [lead, *others].each do |source| %>
                  <%= all_people_source_chip(source) %>
                <% end %>
              </span>
            </details>
          <% end %>
        </div>
      <% end %>
    <% end %>
    <%= render 'organisations/people/identity', name: card.name, user: card.avatar_user, below: where %>

    <dl class="people-fields all-people-card__fields">
      <% card.fields.each do |field| %>
        <%# The name stands above; in Herkunft it is a line where the organisations wrote it differently. %>
        <% next if field.key == :name && !(origin && field.differs) %>
        <div class="people-fields__row all-people-card__field" data-card-field="<%= field.key %>">
          <dt><%= all_people_field_label(field) %></dt>
          <dd>
            <% field.values.each do |value| %>
              <div class="all-people-card__value" data-card-value>
                <span class="all-people-card__text" data-card-text><%= all_people_card_value(field, value) %></span>
                <% if origin && value.sources.size == card.sources.size %>
                  <span class="all-people-card__shared" data-card-shared><%= all_people_shared_text(card.sources.size) %></span>
                <% elsif origin %>
                  <span class="all-people-card__chips">
                    <% value.sources.each do |source| %>
                      <% organisation = sources.fetch(source.organisation_id).organisation_name %>
                      <%= render 'shared/organisation_chip',
                                 name: organisation,
                                 color: current_user.org_colors.effective_color(source.organisation_id),
                                 action: (if editing && source.edit
                                            { url: all_people_edit_path(source.organisation_id, source.edit),
                                              label: t('views.all_people.card.edit_in', organisation: organisation),
                                              data: { card_pencil: true } }
                                          end) %>
                    <% end %>
                  </span>
                <% end %>
              </div>
            <% end %>
          </dd>
        </div>
      <% end %>
    </dl>

    <% last = all_people_card_last_contact(card) %>
    <% if last %>
      <p class="people-history__line" data-card-last-contact title="<%= last[:date] %>">
        <%= t('views.all_people.card.last_contact', age: last[:age], organisation: last[:organisation]) %>
      </p>
    <% end %>

    <% card.sources.select(&:notes).each do |source| %>
      <details class="people-history" data-card-notes>
        <summary class="people-history__line">
          <%= t('views.all_people.card.notes_from', organisation: source.organisation_name) %>
          <i class="bi bi-chevron-down people-history__chevron" aria-hidden="true"></i>
        </summary>
        <p class="people-note all-people-card__note"><%= source.notes %></p>
      </details>
    <% end %>

    <% if origin %>
      <section class="all-people-card__holdings" aria-labelledby="all-people-card-holdings" data-card-holdings>
        <h3 id="all-people-card-holdings" class="section-label text-muted"><%= t('views.all_people.card.holdings.label') %></h3>
        <ul class="all-people-card__holding-list">
          <% card.holdings.each do |holding| %>
            <li class="all-people-card__holding" data-card-holding>
              <span class="all-people-card__chips">
                <% holding.organisation_ids.each do |organisation_id| %>
                  <%= all_people_source_chip(sources.fetch(organisation_id), editing: editing) %>
                <% end %>
              </span>
              <span class="all-people-card__holding-fields" data-card-holding-fields><%= all_people_holding_text(card, holding) %></span>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
</div>

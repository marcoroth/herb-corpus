<%# Demo mode (Lalabase::Demo): the published login, and a button that puts it
    into the fields below. The normal sign-in does the rest. Inside the form, so
    the button finds its fields without an id. %>
<div class="lp-auth-notice" data-testid="demo-login"
     data-controller="demo-login"
     data-demo-login-email-value="<%= Lalabase::Demo.login_email %>"
     data-demo-login-password-value="<%= Lalabase::Demo::PASSWORD %>">
  <p class="lp-auth-notice-lead"><%= t('views.demo.sign_in.lead', name: Lalabase::Demo.login_name) %></p>
  <dl class="lp-demo-login">
    <dt><%= t('views.demo.sign_in.email') %></dt>
    <dd><%= Lalabase::Demo.login_email %></dd>
    <dt><%= t('views.demo.sign_in.password') %></dt>
    <dd><%= Lalabase::Demo::PASSWORD %></dd>
  </dl>
  <button type="button" class="lp-btn lp-btn--ghost" data-action="demo-login#fill">
    <%= t('views.demo.sign_in.fill') %>
  </button>
</div>

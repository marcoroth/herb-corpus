<% content_for :title, [t('views.devise.registrations.disabled.title'), Lalabase::PRODUCT_NAME].join(' | ') %>

<%# =========================================================================
     REGISTRATION DISABLED: "Werkstatt" look (like handoff 3b) · Aug 2026

     Skeleton: layout application_auth. On the left the status plus the ways
     forward, on the right the options. The panel names real ways here and is
     therefore NOT decorative. %>

<% content_for :auth_cross do %>
  <p class="lp-auth-cross">
    <%= t('devise.registrations.new.already_registered') %>
    <%= link_to t('devise.shared.links.log_in'), new_user_session_path, class: 'lp-auth-cross-link' %>
  </p>
<% end %>

<div class="lp-eyebrow"><%= t('views.devise.registrations.disabled.temporarily_disabled') %></div>
<h1 class="lp-auth-h1 lp-auth-h1--signup"><%= t('views.devise.registrations.disabled.title') %></h1>

<div class="lp-auth-notice">
  <p class="lp-auth-notice-lead"><%= @registration_disabled_message %></p>
  <p class="lp-auth-notice-text"><%= t('views.devise.registrations.disabled.existing_account_hint') %></p>
</div>

<div class="lp-auth-form">
  <%= link_to t('views.devise.registrations.disabled.go_to_login'), new_user_session_path,
              class: 'lp-btn lp-btn--primary lp-btn--block' %>
  <%= link_to t('views.devise.registrations.disabled.go_to_home'), root_path,
              class: 'lp-btn lp-btn--ghost lp-btn--block' %>
</div>

<% content_for :auth_panel do %>
  <div class="lp-auth-panel-kicker">// <%= t('views.devise.registrations.disabled.currently_closed') %></div>
  <h2 class="lp-auth-panel-h2"><%= t('views.devise.registrations.disabled.what_you_can_do') %></h2>

  <div class="lp-auth-steps">
    <% [t('views.devise.registrations.disabled.login_existing'),
        t('views.devise.registrations.disabled.use_invitation'),
        t('views.devise.registrations.disabled.contact_admin')].each_with_index do |option, index| %>
      <div class="lp-auth-step">
        <span class="lp-auth-step-no">0<%= index + 1 %></span>
        <span class="lp-auth-step-title lp-auth-step-title--normal"><%= option %></span>
      </div>
    <% end %>
  </div>

  <%= render 'devise/shared/trust_pills' %>
<% end %>

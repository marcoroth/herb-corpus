<% content_for :title, [t('.title'), Lalabase::PRODUCT_NAME].join(' | ') %>

<%# =========================================================================
     SET NEW PASSWORD: "Werkstatt" look · Sep 2026

     Skeleton: layout application_auth. Reachable only through the link in the
     mail (reset_password_token). Both fields use the shared
     password field; the strength meter only runs on the first, the second is
     a repetition. %>

<% content_for :auth_cross do %>
  <p class="lp-auth-cross">
    <%= t('.cross') %>
    <%= link_to t('devise.shared.links.log_in'), new_session_path(resource_name), class: 'lp-auth-cross-link' %>
  </p>
<% end %>

<div class="lp-eyebrow"><%= t('.eyebrow') %></div>
<h1 class="lp-auth-h1"><%= t('.title') %></h1>
<p class="lp-auth-sub"><%= t('.subtitle') %></p>

<%= form_for(resource, as: resource_name, url: password_path(resource_name),
             html: { method: :put, class: 'lp-auth-form', novalidate: true }) do |f| %>
  <%= f.hidden_field :reset_password_token %>

  <%= render 'devise/shared/password_field',
             f: f, label: t('.new_password_label'), autocomplete: 'new-password', meter: true %>

  <%= render 'devise/shared/password_field',
             f: f, attribute: :password_confirmation,
             label: t('.confirm_password_label'), autocomplete: 'new-password' %>

  <%= f.submit t('.submit'),
        data: { turbo_submits_with: t('.submitting') },
        class: 'lp-btn lp-btn--primary lp-btn--block' %>
<% end %>

<% content_for :auth_panel do %>
  <div class="lp-auth-panel-kicker">// <%= t('.panel_label') %></div>
  <h2 class="lp-auth-panel-h2"><%= t('.panel_title') %></h2>

  <div class="lp-auth-callout">
    <span class="lp-auth-callout-line">
      <%= t('.minimum_length', count: @minimum_password_length || Devise.password_length.min) %>
    </span>
    <p class="lp-auth-callout-text"><%= t('.signed_in_after') %></p>
  </div>
<% end %>

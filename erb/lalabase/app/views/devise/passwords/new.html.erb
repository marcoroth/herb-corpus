<% content_for :title, [t('.title'), Lalabase::PRODUCT_NAME].join(' | ') %>

<%# =========================================================================
     FORGOT PASSWORD: "Werkstatt" look · Sep 2026

     Skeleton: layout application_auth. The panel states how long the link
     is valid, which is a fact of this page, and so it is NOT decorative.
     The number of hours comes from Devise.reset_password_within, it is not
     typed in by hand. %>

<% content_for :auth_cross do %>
  <p class="lp-auth-cross">
    <%= t('.cross') %>
    <%= link_to t('devise.shared.links.log_in'), new_session_path(resource_name), class: 'lp-auth-cross-link' %>
  </p>
<% end %>

<div class="lp-eyebrow"><%= t('.eyebrow') %></div>
<h1 class="lp-auth-h1"><%= t('.title') %></h1>
<p class="lp-auth-sub"><%= t('.subtitle') %></p>

<%= form_for(resource, as: resource_name, url: password_path(resource_name),
             html: { method: :post, class: 'lp-auth-form', novalidate: true }) do |f| %>
  <div class="lp-field">
    <%= f.label :email, t('.email_label'), class: 'lp-field-label' %>
    <%= f.email_field :email, autofocus: true, autocomplete: 'email', required: true,
          class: "lp-input #{'lp-input--error' if resource.errors[:email].any?}" %>
    <% if resource.errors[:email].any? %>
      <p class="lp-field-error" role="alert"><%= resource.errors[:email].first %></p>
    <% end %>
  </div>

  <%= f.submit t('.submit'),
        data: { turbo_submits_with: t('.submitting') },
        class: 'lp-btn lp-btn--primary lp-btn--block' %>
<% end %>

<% content_for :auth_panel do %>
  <div class="lp-auth-panel-kicker">// <%= t('.panel_label') %></div>
  <h2 class="lp-auth-panel-h2"><%= t('.panel_title') %></h2>

  <div class="lp-auth-steps">
    <% [t('.step_mail'), t('.step_link'), t('.step_new_password')].each_with_index do |step, index| %>
      <div class="lp-auth-step">
        <span class="lp-auth-step-no">0<%= index + 1 %></span>
        <span class="lp-auth-step-title lp-auth-step-title--normal"><%= step %></span>
      </div>
    <% end %>
  </div>

  <%# This sits in the box and not as a third step: on the phone,
      auth.css hides the last step, and this deadline is the one number
      that someone here really needs. %>
  <div class="lp-auth-callout">
    <span class="lp-auth-callout-line">
      <%= t('.link_validity', count: Devise.reset_password_within.in_hours.round) %>
    </span>
    <p class="lp-auth-callout-text"><%= t('.link_expired_hint') %></p>
  </div>
<% end %>

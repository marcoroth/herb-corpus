<%# Was untranslated Devise scaffold — dead until :confirmable went live.
    Devise reuses this ONE template for two very different situations, so the
    body has to branch: a new signup is on a countdown, an e-mail change is not
    (that account keeps working under its old address). @email is Devise's
    recipient and is the UNCONFIRMED address in the change case. %>
<p><%= t('.greeting', email: @email) %></p>

<p><%= t('.instruction') %></p>

<p><%= link_to t('.confirm_link'), confirmation_url(@resource, confirmation_token: @token) %></p>

<% if @resource.pending_reconfirmation? %>
  <p><%= t('.reconfirmation_hint', old_email: @resource.email) %></p>
<% else %>
  <p><%= t('.grace_hint', count: User.allow_unconfirmed_access_for.in_days.to_i) %></p>
<% end %>

<p><%= t('.ignore_if_not_requested') %></p>

<%# One password input with the show/hide toggle, optionally with the strength
    meter. Rendered by sign-in, sign-up and "set a new password": before
    20.09.2026 each of them carried its own copy of this markup and its own
    copy of the two toggle labels.

    Locals
      f             the form builder
      attribute     :password (default) or :password_confirmation
      label         the field label
      autocomplete  'current-password' or 'new-password'
      meter         true adds the strength meter (a NEW password only)
      aside         markup next to the label, right aligned (the sign-in page
                    puts its "forgot password?" link there)

    @minimum_password_length is nil on some render paths (a re-render after a
    validation error), so the rule falls back to the model's own length. %>
<% attribute = local_assigns.fetch(:attribute, :password) %>
<% meter = local_assigns.fetch(:meter, false) %>
<% aside = local_assigns[:aside] %>
<% errors = f.object.errors[attribute] %>
<% min_length = @minimum_password_length || Devise.password_length.min %>
<% data = { controller: 'auth-password',
            'auth-password-show-label-value' => t('views.devise.shared.password_field.show'),
            'auth-password-hide-label-value' => t('views.devise.shared.password_field.hide') } %>
<% if meter %>
  <% data['auth-password-min-length-value'] = min_length %>
  <% data['auth-password-strength-labels-value'] = t('views.devise.shared.password_field.strength_labels').to_json %>
  <% data['auth-password-rule-value'] = t('views.devise.shared.password_field.strength_rule', count: min_length) %>
<% end %>

<%= tag.div class: 'lp-field', data: data do %>
  <% if aside %>
    <div class="lp-field-row">
      <%= f.label attribute, label, class: 'lp-field-label' %>
      <%= aside %>
    </div>
  <% else %>
    <%= f.label attribute, label, class: 'lp-field-label' %>
  <% end %>

  <div class="lp-input-wrap">
    <%= f.password_field attribute,
          autocomplete: local_assigns.fetch(:autocomplete),
          required: true,
          data: (meter ? { 'auth-password-target': 'input', action: 'input->auth-password#rate' } : { 'auth-password-target': 'input' }),
          class: "lp-input lp-input--toggle #{'lp-input--error' if errors.any?}" %>
    <button type="button" class="lp-input-toggle" aria-pressed="false"
            data-auth-password-target="toggle"
            data-action="auth-password#toggle"><%= t('views.devise.shared.password_field.show') %></button>
  </div>

  <% if errors.any? %>
    <p class="lp-field-error" role="alert"><%= errors.first %></p>
  <% end %>

  <% if meter %>
    <%# Strength meter: appears with the first character, purely informative. %>
    <div class="lp-strength" hidden data-auth-password-target="meter">
      <span class="lp-strength-bar">
        <% 4.times do %>
          <span class="lp-strength-seg" data-auth-password-target="segment"></span>
        <% end %>
      </span>
      <span class="lp-strength-label" data-auth-password-target="label"></span>
    </div>
  <% end %>
<% end %>

<% content_for :title, t('cancel_account_deletion.title') %>

<div class="container mx-auto px-4 py-8">
  <div class="max-w-md mx-auto bg-surface-raised rounded-lg shadow-md p-6">
    <h1 class="text-2xl font-bold text-green-600 mb-6 text-center">
      <%= icon('arrow-counterclockwise', class: 'inline mr-2') %>
      <%= t('cancel_account_deletion.title') %>
    </h1>

    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
      <p class="text-blue-800">
        <strong><%= t('cancel_account_deletion.info_title') %>:</strong> <%= t('cancel_account_deletion.scheduled_info', date: l(@scheduled_date, format: :long)) %>
      </p>
      <p class="text-blue-700 mt-2">
        <%= t('cancel_account_deletion.time_remaining', days: @days_remaining, days_text: t('time.days', count: @days_remaining)) %>
      </p>
    </div>

    <div class="mb-6">
      <p class="text-gray-700 mb-4">
        <%= t('cancel_account_deletion.if_cancelled') %>
      </p>
      <ul class="list-disc list-inside text-gray-600 space-y-2">
        <li><%= t('cancel_account_deletion.account_preserved') %></li>
        <li><%= t('cancel_account_deletion.data_unchanged') %></li>
        <li><%= t('cancel_account_deletion.normal_usage') %></li>
        <li><%= t('cancel_account_deletion.can_reapply') %></li>
      </ul>
    </div>

    <%= form_with url: cancel_account_deletion_path, method: :post, local: true, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :reason, t('cancel_account_deletion.reason_label'), class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_area :reason, 
            placeholder: t('cancel_account_deletion.reason_placeholder'), 
            class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500",
            rows: 4,
            maxlength: 500 %>
        <p class="text-sm text-gray-500 mt-1"><%= t('common.max_characters', count: 500) %></p>
      </div>

      <div class="flex space-x-4">
        <%= form.submit t('cancel_account_deletion.submit_button'), 
            class: "flex-1 bg-green-600 text-on-fill py-2 px-4 rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition-colors",
            data: {
              turbo_confirm: t('cancel_account_deletion.confirm_message')
            } %>
        
        <%= link_to t('common.back'), 
            root_path, 
            class: "flex-1 bg-gray-300 text-gray-700 py-2 px-4 rounded-md hover:bg-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 transition-colors text-center" %>
      </div>
    <% end %>
  </div>
</div>
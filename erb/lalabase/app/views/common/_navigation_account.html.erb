<div class="w-full px-4 pt-6">
  <div class="mb-2">
    <div class="flex items-start justify-between px-2 mb-3">
      <h3 class="text-xs font-bold uppercase text-cream-600">
        <%= t('navigation.account_section') %>
      </h3>
    </div>

    <ul class="flex flex-col gap-2">
      <%# "Alle Organisationen" (not "wechseln"): from the account section you are not in an
          org context, so the label matches the org switcher menu's cockpit link. %>
      <%= render 'common/navigation_item',
        name: t('navigation.all_organisations'),
        path: select_organisation_path,
        icon: 'bi bi-building',
        hover_color: '#f5f1ea',
        active: request.path == select_organisation_path %>

      <%= render 'common/navigation_item',
        name: t('navigation.profile'),
        path: edit_user_registration_path,
        icon: 'bi bi-person-fill',
        hover_color: '#f5f1ea',
        active: request.path == edit_user_registration_path %>

      <%# Billing accounts (K1 revised): the area hangs on the account, not on an
          organisation, and this navigation is the only one that renders without a tenant
          (see layouts/application.html.erb). That way an account owner WITHOUT any
          membership anywhere reaches it too -- that is N1, and the reason the area was
          pulled out of the organisation at all.

          Always visible, not only for people with an account: checking visibility would
          cost one round of Subscriptions::VisibleAccounts on EVERY page of this area
          (one role query per organisation of the user). Whoever has none sees the
          honest empty state, just like with the data export. %>
      <%= render 'common/navigation_item',
        name: t('navigation.billing_accounts'),
        path: billing_accounts_path,
        icon: 'bi bi-receipt',
        hover_color: '#f5f1ea',
        active: request.path.start_with?('/billing') %>

      <%= render 'common/navigation_item',
        name: t('navigation.data_export'),
        path: user_data_export_path,
        icon: 'bi bi-download',
        hover_color: '#f5f1ea',
        active: request.path.start_with?('/user_data_export') %>

      <li>
        <details class="group" <%= 'open' if request.path.include?('/user_preferences') || request.path.start_with?('/users/personal_access_tokens') %>>
          <summary class="flex items-center gap-2 text-sm px-4 py-2 cursor-pointer rounded border border-transparent hover:border-cream-300 hover:bg-cream-100 transition-all list-none"
                   style="--hover-bg: #f5f1ea"
                   onmouseover="this.style.backgroundColor='#f5f1ea'"
                   onmouseout="if(!this.parentElement.open) this.style.backgroundColor=''">
            <p class="bi bi-person-gear"> <%= t('navigation.preferences') %></p>
            <i class="bi bi-chevron-right group-open:rotate-90 transition-transform text-xs ml-auto"></i>
          </summary>
          <ul class="flex flex-col gap-1 mt-1 ml-6">
            <%= render 'common/account_nav_subitem', path: general_user_preferences_path,
                                                     label: t('navigation.settings_general') %>
            <%= render 'common/account_nav_subitem', path: display_user_preferences_path,
                                                     label: t('navigation.settings_display') %>
            <%= render 'common/account_nav_subitem', path: tickets_user_preferences_path,
                                                     label: t('navigation.settings_tickets') %>
            <%= render 'common/account_nav_subitem', path: meetings_user_preferences_path,
                                                     label: t('navigation.settings_meetings') %>
            <%= render 'common/account_nav_subitem', path: datetime_user_preferences_path,
                                                     label: t('navigation.settings_datetime') %>
            <%= render 'common/account_nav_subitem', path: language_user_preferences_path,
                                                     label: t('navigation.settings_language') %>
            <%= render 'common/account_nav_subitem', path: session_user_preferences_path,
                                                     label: t('navigation.settings_session') %>
            <%= render 'common/account_nav_subitem', path: users_personal_access_tokens_path,
                                                     label: t('navigation.settings_api_tokens'),
                                                     active: request.path.start_with?('/users/personal_access_tokens') %>
          </ul>
        </details>
      </li>

    </ul>

    <% if session[:current_organisation_id].present? %>
      <div class="mt-6 mb-2">
        <div class="px-2 mb-3">
          <h3 class="text-xs font-bold uppercase text-cream-600">
            <%= t('navigation.organisation') %>
          </h3>
        </div>
        <ul class="flex flex-col gap-2">
          <% org = Organisation.find_by(id: session[:current_organisation_id]) %>
          <% if org %>
            <%= render 'common/navigation_item',
              name: t('navigation.back_to_organisation'),
              path: organisation_projects_path(organisation_id: org.id),
              icon: 'bi bi-arrow-left',
              hover_color: '#f5f1ea' %>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
</div>

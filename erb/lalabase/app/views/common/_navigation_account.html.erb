<%# The sidebar's middle on an account page (Belegungstabelle F44, navigation plan PR 3): a
    section of its own, in the form of the management area. "Zurück" leads to the page the
    reader came from (AccountReturn, NavigationHelper#account_return_path), then the label
    MEIN KONTO and the pages (common/_account_nav_list, shared with the account layer). %>
<div class="w-full px-4 pt-6" data-account-sidebar>
  <ul class="mb-3 flex flex-col gap-1">
    <%= render 'common/navigation_item', name: t('navigation.account_back'), path: account_return_path,
                                         icon: 'bi bi-arrow-left' %>
  </ul>
  <%= render 'common/account_nav_list' %>
</div>

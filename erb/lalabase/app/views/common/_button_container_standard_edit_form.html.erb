<!-- Button Container -->
<div class="flex justify-between items-center mt-4">
  <div>
    <% if defined?(delete_path) && delete_path && (defined?(@project) && policy(@project).area_access?(controller_name.to_sym, :write)) %>
    <!-- Delete Button -->
    <%= link_to delete_path, 
        data: { turbo_method: :delete, turbo_confirm: t('views.confirm.are_you_sure') },
        class: 'inline-flex items-center px-4 py-2 border border-stroke rounded-md shadow-sm text-sm font-medium text-cream-900 bg-red-200 hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[2px_2px_0_0_#000000] focus:-translate-x-0.5 focus:-translate-y-0.5 focus:shadow-[2px_2px_0_0_#000000]' do %>
      <i class="bi bi-trash-fill mr-2"></i>
        <%= t('views.common.button_container.delete') %>
      <% end %>
    <% end %>
  </div>

  <div class="flex gap-2">
    <!-- Cancel Button -->
    <%= link_to cancel_path, 
        data: { 
          turbo: true,
          turbo_method: :get,
          turbo_frame: local_assigns[:turbo_frame_id] || (params[:frame] == 'content' ? 'document_display_frame' : 'document-show')
        },
        class: 'inline-flex items-center px-4 py-2 border border-stroke rounded-md shadow-sm text-sm font-medium text-cream-900 bg-surface-raised hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[2px_2px_0_0_#000000] focus:-translate-x-0.5 focus:-translate-y-0.5 focus:shadow-[2px_2px_0_0_#000000]' do %>
      <%= t('views.common.button_container.cancel') %>
    <% end %>

    <!-- Update Button -->
    <%= form.submit t('views.common.button_container.update'),
        class: "py-2 px-3 relative inline-flex items-center justify-center rounded text-sm font-medium border border-stroke bg-lime-200 hover:bg-lime-300 text-cream-900 hover:shadow-[2px_2px_0_0_#000000]" %>
  </div>
</div>
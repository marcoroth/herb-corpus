<%# Sub-item of the account sidebar "Einstellungen" group. Extracted from six
    copy-pasted <li> blocks (user-data-export PR, review D6). `active` defaults
    to an exact path match — pass an explicit value for prefix matching. %>
<% is_active = local_assigns.fetch(:active) { request.path == path } %>
<li>
  <%= link_to path,
      class: sidebar_row_classes(active: is_active, spacing: 'px-3 py-1.5') do %>
    <span><%= label %></span>
  <% end %>
</li>

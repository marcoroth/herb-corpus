<%# Shared global-search form.
    Single source for the org-wide search input — rendered by the search overlay (on-demand,
    Stage 1) and the pinned inline bar (Stage 2b). No clone of the search input anywhere else.

    Submits as a full navigation (turbo: false) to PowerSearch#execute, which renders the
    results page — identical backend flow as before the overlay redesign. %>
<%= form_with url: organisation_power_search_path(organisation_id: @current_organisation.id),
              data: { turbo: false }, class: "space-y-2" do |form| %>
  <%
    available_projects = selectable_projects.order(:name)
    selected_project_id = params[:project_id]
    selected_project_id = current_project.id if selected_project_id.blank? && current_project.present?
  %>
  <%= form.select :project_id,
      options_from_collection_for_select(available_projects, :id, :name, selected_project_id),
      { prompt: t('navigation.all_projects') },
      { class: "w-full h-9 text-sm px-2 border border-gray-300 rounded bg-surface-raised hover:bg-lime-50 focus:outline-none focus:border-stroke focus:shadow-[2px_2px_0_0_#000000] transition-all" } %>
  <div class="flex gap-1">
    <%= form.text_field :power_search_query,
        value: params[:power_search_query] || "",
        placeholder: t('navigation.global_search'),
        autocomplete: "off",
        class: "flex-1 min-w-0 h-9 text-sm px-2 border border-gray-300 rounded bg-surface-raised hover:bg-lime-50 focus:outline-none focus:border-stroke focus:shadow-[2px_2px_0_0_#000000] transition-all" %>
    <button type="submit"
            aria-label="<%= t('navigation.search') %>"
            class="h-9 w-9 shrink-0 flex items-center justify-center border border-gray-300 bg-lime-200 hover:bg-lime-300 rounded hover:shadow-[2px_2px_0_0_#000000] transition-all">
      <i class="bi bi-search text-sm"></i>
    </button>
  </div>
<% end %>

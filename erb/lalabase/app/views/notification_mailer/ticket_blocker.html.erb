<% if @actor %>
  <div class="actor-info">
    <span class="actor-name"><%= @actor.full_name %></span> marked ticket
    <strong><%= @ticket&.title || 'a ticket' %></strong> as blocked
  </div>
<% end %>

<% if @ticket %>
  <p>
    <strong>Ticket:</strong> #<%= @ticket.number if @ticket.respond_to?(:number) %> <%= @ticket.title %><br>
    <% if @ticket.respond_to?(:project) && @ticket.project %>
      <strong>Project:</strong> <%= @ticket.project.name %><br>
    <% end %>
    <% if @ticket.respond_to?(:ticket_status) && @ticket.ticket_status %>
      <strong>Status:</strong> <%= @ticket.ticket_status.name %><br>
    <% end %>
    <% if @ticket.respond_to?(:priority) && @ticket.priority %>
      <strong>Priority:</strong> <%= @ticket.priority.humanize %>
    <% end %>
  </p>
<% end %>

<% if @notification.payload['blocker_reason'].present? %>
  <div style="margin: 16px 0; padding: 16px; background-color: #fef2f2; border-radius: 6px; border-left: 3px solid #dc2626;">
    <strong>Reason:</strong><br>
    <%= simple_format(@notification.payload['blocker_reason']) %>
  </div>
<% end %>

<a href="<%= @action_url %>" class="action-button" style="background-color: #dc2626;">View Ticket</a>
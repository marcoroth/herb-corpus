<div class="actor-info">
  <span class="actor-name"><%= @notification.actor&.display_name || t("#{@bulk_scope}.someone") %></span>
  <%= t("#{@bulk_scope}.did", count: @run_parameters['count'].to_i) %>
</div>

<div style="margin: 16px 0; padding: 16px; background-color: #f9fafb; border-radius: 6px; border-left: 3px solid #6b7280;">
  <%= t("#{@bulk_scope}.body", actor: @notification.actor&.display_name || t("#{@bulk_scope}.someone"), count: @run_parameters['count'].to_i, changes: @run_parameters['changes']) %>
  <% if @run_parameters['ticket_numbers'].present? %>
    <br><%= t("#{@bulk_scope}.tickets") %>
    <%= Array(@run_parameters['ticket_numbers']).map { |n| "##{n}" }.join(', ') %><%= @run_parameters['count'].to_i > Array(@run_parameters['ticket_numbers']).size ? " #{t("#{@bulk_scope}.and_more", count: @run_parameters['count'].to_i - Array(@run_parameters['ticket_numbers']).size)}" : '' %>
  <% end %>
</div>

<% if @action_url %>
  <a href="<%= @action_url %>" class="action-button" style="background-color: #6b7280;"><%= t("#{@bulk_scope}.link") %></a>
<% end %>

<%= t("#{@bulk_scope}.heading", count: @run_parameters['count'].to_i) %>
<%= '=' * t("#{@bulk_scope}.heading", count: @run_parameters['count'].to_i).length %>

<%= t("#{@bulk_scope}.body", actor: @notification.actor&.display_name || t("#{@bulk_scope}.someone"), count: @run_parameters['count'].to_i, changes: @run_parameters['changes']) %>
<% if @run_parameters['ticket_numbers'].present? %>
<%= t("#{@bulk_scope}.tickets") %> <%= Array(@run_parameters['ticket_numbers']).map { |n| "##{n}" }.join(', ') %><%= @run_parameters['count'].to_i > Array(@run_parameters['ticket_numbers']).size ? " #{t("#{@bulk_scope}.and_more", count: @run_parameters['count'].to_i - Array(@run_parameters['ticket_numbers']).size)}" : '' %>
<% end %>

<% if @action_url.present? %>
<%= t("#{@bulk_scope}.link") %>: <%= @action_url %>
<% end %>

---

<%= t("#{@bulk_scope}.footer", email: @recipient_email) %>
<%= t("#{@bulk_scope}.preferences") %>: <%= @preferences_url %>
<%= t("#{@bulk_scope}.unsubscribe") %>: <%= @unsubscribe_url %>

<% if @actor %>
  <div class="actor-info">
    <span class="actor-name"><%= @actor.full_name %></span> assigned 
    <strong><%= @assignee %></strong> to ticket
    <strong><%= @ticket&.title || 'a ticket' %></strong>
  </div>
<% end %>

<% if @ticket %>
  <p>
    <strong>Ticket:</strong> #<%= @ticket.number if @ticket.respond_to?(:number) %> <%= @ticket.title %><br>
    <% if @ticket.respond_to?(:project) && @ticket.project %>
      <strong>Project:</strong> <%= @ticket.project.name %><br>
    <% end %>
    <% if @ticket.respond_to?(:ticket_status) && @ticket.ticket_status %>
      <strong>Status:</strong> <%= @ticket.ticket_status.name %><br>
    <% end %>
    <% if @ticket.respond_to?(:priority) && @ticket.priority %>
      <strong>Priority:</strong> <%= @ticket.priority.humanize %>
    <% end %>
  </p>
<% end %>

<% if @ticket&.respond_to?(:description) && @ticket.description.present? %>
  <div style="margin: 16px 0; padding: 16px; background-color: #f8fafc; border-radius: 6px;">
    <strong>Description:</strong><br>
    <%= simple_format(@ticket.description.to_plain_text.truncate(200)) %>
  </div>
<% end %>

<a href="<%= @action_url %>" class="action-button">View Ticket</a>
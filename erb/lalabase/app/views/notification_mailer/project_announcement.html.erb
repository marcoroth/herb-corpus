<% if @actor %>
  <div class="actor-info">
    <span class="actor-name"><%= @actor.full_name %></span> made an announcement in project
    <strong><%= @project&.name || 'a project' %></strong>
  </div>
<% end %>

<% if @project %>
  <p>
    <strong>Project:</strong> <%= @project.name %>
  </p>
<% end %>

<% if @notification.payload['title'].present? %>
  <h2 style="margin: 16px 0; font-size: 18px; font-weight: 600;">
    <%= @notification.payload['title'] %>
  </h2>
<% end %>

<% if @notification.payload['content'].present? %>
  <div style="margin: 16px 0; padding: 16px; background-color: #f8fafc; border-radius: 6px; border-left: 3px solid #7c3aed;">
    <%= simple_format(@notification.payload['content'].truncate(400)) %>
  </div>
<% end %>

<a href="<%= @action_url %>" class="action-button" style="background-color: #7c3aed;">View Project</a>
<div class="actor-info">
  <span class="actor-name"><%= t('notification_mailer.index_completed.heading') %></span>
</div>

<h2 style="margin: 16px 0; font-size: 18px; font-weight: 600;">
  <%= @notification.payload['full_name'] %>
</h2>

<p style="margin: 16px 0;"><%= t('notification_mailer.index_completed.body') %></p>

<% if @action_url %>
  <a href="<%= @action_url %>" class="action-button"><%= t('notification_mailer.index_completed.cta') %></a>
<% end %>

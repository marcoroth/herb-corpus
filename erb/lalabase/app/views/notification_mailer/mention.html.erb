<% if @actor %>
  <div class="actor-info">
    <span class="actor-name"><%= @actor.full_name %></span> mentioned you
    <% if @notification.payload['context'].present? %>
      in <%= @notification.payload['context'] %>
    <% end %>
  </div>
<% end %>

<% if @notification.payload['mentioned_in'].present? %>
  <p>
    <strong>Context:</strong> <%= @notification.payload['mentioned_in'] %>
  </p>
<% end %>

<% if @notification.payload['content'].present? %>
  <div style="margin: 16px 0; padding: 16px; background-color: #fff7ed; border-radius: 6px; border-left: 3px solid #ea580c;">
    <%= simple_format(@notification.payload['content'].truncate(300)) %>
  </div>
<% elsif @notification.payload['excerpt'].present? %>
  <div style="margin: 16px 0; padding: 16px; background-color: #fff7ed; border-radius: 6px; border-left: 3px solid #ea580c;">
    <%= simple_format(@notification.payload['excerpt']) %>
  </div>
<% end %>

<a href="<%= @action_url %>" class="action-button" style="background-color: #ea580c;">View Mention</a>
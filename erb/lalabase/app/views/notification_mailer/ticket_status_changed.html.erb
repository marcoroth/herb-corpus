<% if @actor %>
  <div class="actor-info">
    <span class="actor-name"><%= @actor.full_name %></span> changed the status of ticket
    <strong><% if @ticket.respond_to?(:title) %><%= @ticket.title %><% else %><%= @ticket&.name || 'an item' %><% end %></strong>
  </div>
<% end %>

<% if @ticket %>
  <p>
    <strong>Ticket:</strong> #<%= @ticket.number if @ticket.respond_to?(:number) %> <%= @ticket.title %><br>
    <% if @ticket.respond_to?(:project) && @ticket.project %>
      <strong>Project:</strong> <%= @ticket.project.name %><br>
    <% end %>
    <% if @notification.payload['old_status'].present? && @notification.payload['new_status'].present? %>
      <strong>Status changed:</strong> <%= @notification.payload['old_status'] %> → <%= @notification.payload['new_status'] %><br>
    <% end %>
    <% if @ticket.respond_to?(:priority) && @ticket.priority %>
      <strong>Priority:</strong> <%= @ticket.priority.humanize %>
    <% end %>
  </p>
<% end %>

<% if @notification.payload['comment'].present? %>
  <div style="margin: 16px 0; padding: 16px; background-color: #f8fafc; border-radius: 6px; border-left: 3px solid #10b981;">
    <strong>Comment:</strong><br>
    <%= simple_format(@notification.payload['comment'].truncate(200)) %>
  </div>
<% end %>

<a href="<%= @action_url %>" class="action-button">View Ticket</a>
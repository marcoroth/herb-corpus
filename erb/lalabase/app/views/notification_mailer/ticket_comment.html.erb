<% if @actor %>
  <div class="actor-info">
    <span class="actor-name"><%= @actor.full_name %></span> commented on ticket
    <strong><%= @ticket&.title || 'a ticket' %></strong>
  </div>
<% end %>

<% if @previous_comment&.respond_to?(:content) && @previous_comment.content.present? %>
  <div style="margin: 16px 0 8px 0; padding: 12px; background-color: #f1f5f9; border-radius: 6px; border-left: 3px solid #94a3b8;">
    <div style="font-size: 12px; color: #64748b; margin-bottom: 8px;">
      <strong>Previous comment</strong> by <%= @previous_comment.user&.full_name || 'Unknown' %>
      on <%= l(@previous_comment.created_at, format: :short) %>
    </div>
    <div style="color: #475569; font-size: 14px;">
      <%= simple_format(@previous_comment.content.to_plain_text.truncate(200)) %>
    </div>
  </div>
<% end %>

<% if @comment&.respond_to?(:content) && @comment.content.present? %>
  <div style="margin: 16px 0; padding: 16px; background-color: #f8fafc; border-radius: 6px; border-left: 3px solid #3b82f6;">
    <%= simple_format(@comment.content.to_plain_text.truncate(300)) %>
  </div>
<% elsif @notification.payload['post_excerpt'].present? %>
  <div style="margin: 16px 0; padding: 16px; background-color: #f8fafc; border-radius: 6px; border-left: 3px solid #3b82f6;">
    <%= simple_format(@notification.payload['post_excerpt']) %>
  </div>
<% end %>

<% if @ticket %>
  <p>
    <strong>Ticket:</strong> #<%= @ticket.number if @ticket.respond_to?(:number) %> <%= @ticket.title %><br>
    <% if @ticket.respond_to?(:project) && @ticket.project %>
      <strong>Project:</strong> <%= @ticket.project.name %>
    <% end %>
  </p>
<% end %>

<a href="<%= @action_url %>" class="action-button">View Ticket</a>

<p style="margin-top: 24px; color: #6b7280; font-size: 14px;">
  <% if @notification.group_count > 1 %>
    This notification includes <%= pluralize(@notification.group_count, 'activity') %> on this ticket.
  <% end %>
</p>
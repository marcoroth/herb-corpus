<div class="actor-info">
  <span class="actor-name">System</span> 
  <%= @notification.payload['action']&.humanize || 'sent you a message' %>
</div>

<% if @notification.payload['title'].present? %>
  <h2 style="margin: 16px 0; font-size: 18px; font-weight: 600;">
    <%= @notification.payload['title'] %>
  </h2>
<% end %>

<% if @notification.payload['message'].present? %>
  <div style="margin: 16px 0; padding: 16px; background-color: #f9fafb; border-radius: 6px; border-left: 3px solid #6b7280;">
    <%= simple_format(@notification.payload['message']) %>
  </div>
<% end %>

<% if @notification.payload.present? %>
  <div style="margin: 16px 0; padding: 16px; background-color: #f9fafb; border-radius: 6px;">
    <% @notification.payload.each do |key, value| %>
      <% next if %w[action title message].include?(key.to_s) %>
      <strong><%= key.humanize %>:</strong> <%= value %><br>
    <% end %>
  </div>
<% end %>

<% if @action_url %>
  <a href="<%= @action_url %>" class="action-button" style="background-color: #6b7280;">View Details</a>
<% end %>
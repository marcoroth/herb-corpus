TICKET STATUS CHANGED
====================

<% if @actor %>
<%= @actor.full_name %> changed the status of <% if @ticket.respond_to?(:title) %>ticket "<%= @ticket.title %>"<% else %>item "<%= @ticket&.name || 'an item' %>"<% end %>
<% end %>

<% if @old_status && @new_status %>
Status Change:
- From: <%= @old_status %>
- To: <%= @new_status %>

<% end %>
<% if @ticket %>
Details:
<% if @ticket.respond_to?(:title) %>
- Number: #<%= @ticket.number if @ticket.respond_to?(:number) %>
- Title: <%= @ticket.title %>
<% if @ticket.respond_to?(:project) && @ticket.project %>
- Project: <%= @ticket.project.name %>
<% end %>
<% else %>
- Name: <%= @ticket.name %>
<% end %>

<% end %>
View Ticket: <%= @action_url %>

<% if @notification.group_count > 1 %>
This notification includes <%= pluralize(@notification.group_count, 'activity') %> on this ticket.
<% end %>

--
This notification was sent because you have notifications enabled for this activity.
Manage preferences: <%= @preferences_url %>
Unsubscribe: <%= @unsubscribe_url %>
<div class="actor-info">
  <span class="actor-name"><%= t('notification_mailer.index_failed.heading') %></span>
</div>

<h2 style="margin: 16px 0; font-size: 18px; font-weight: 600;">
  <%= @notification.payload['full_name'] %>
</h2>

<p style="margin: 16px 0;"><%= t('notification_mailer.index_failed.body') %></p>

<% if @error_message.present? %>
  <div style="margin: 16px 0; padding: 16px; background-color: #fef2f2; border-radius: 6px; border-left: 3px solid #dc2626;">
    <strong><%= t('notification_mailer.index_failed.error_label') %>:</strong>
    <%= @error_message %>
  </div>
<% end %>

<% if @action_url %>
  <a href="<%= @action_url %>" class="action-button" style="background-color: #dc2626;"><%= t('notification_mailer.index_failed.cta') %></a>
<% end %>

<% if @actor %>
  <div class="actor-info">
    <span class="actor-name"><%= @actor.full_name %></span> changed the priority of ticket
    <strong><% if @ticket.respond_to?(:title) %><%= @ticket.title %><% else %><%= @ticket&.name || 'an item' %><% end %></strong>
  </div>
<% end %>

<% if @ticket %>
  <p>
    <% if @ticket.respond_to?(:title) %>
      <strong>Ticket:</strong> #<%= @ticket.number if @ticket.respond_to?(:number) %> <%= @ticket.title %><br>
      <% if @ticket.respond_to?(:project) && @ticket.project %>
        <strong>Project:</strong> <%= @ticket.project.name %><br>
      <% end %>
    <% else %>
      <strong>Project:</strong> <%= @ticket.name %><br>
    <% end %>
    <% if @old_priority.present? && @new_priority.present? %>
      <strong>Priority changed:</strong> <%= @old_priority %> → <%= @new_priority %><br>
    <% end %>
  </p>
<% end %>

<% if @notification.payload['comment'].present? %>
  <div class="notification-content">
    <%= simple_format(@notification.payload['comment']) %>
  </div>
<% end %>

<div class="action-button">
  <a href="<%= @action_url %>" class="action-button">View Ticket</a>
</div>
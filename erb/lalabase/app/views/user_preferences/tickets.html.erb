<div class="pt-6">
  <%= render NeoTitleBoxComponent.new(
    title: t('user_preferences.edit.title'),
    subtitle: current_user.display_name,
    variant: :project
  ) %>

  <%# S0/H1: single-group settings form → no card; fields on a warm surface. %>
  <div class="mt-8 max-w-2xl">
    <%# These are GLOBAL ticket-view preferences (per user, all projects).
        Per-project column/field settings live in the ticket's "Detail-Ansicht
        anpassen" modal — the intro points users there to avoid confusion. %>
    <p class="text-sm text-cream-700 mb-6"><%= t('user_preferences.edit.tickets.intro') %></p>

    <div>
      <%= form_with url: user_preferences_path, method: :patch, local: true, data: { turbo: false }, class: "space-y-6" do |form| %>
        <%= hidden_field_tag 'current_section', 'tickets' %>

        <!-- Timeline Direction -->
        <div>
          <%= label_tag "preferences_post_direction", t('user_preferences.edit.tickets.timeline_order.label'), class: "block text-sm font-bold mb-2 text-cream-900" %>
          <%= select_tag "preferences[post_direction]",
              options_for_select([
                [t('user_preferences.edit.tickets.timeline_order.chronological'), 'chronological'],
                [t('user_preferences.edit.tickets.timeline_order.reverse'), 'reverse']
              ], @user.preference_store.post_direction_preference),
              class: "w-full h-10 px-4 rounded border border-cream-300 focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all bg-surface-raised" %>
          <p class="text-xs text-cream-600 mt-2"><%= t('user_preferences.edit.tickets.timeline_order.description') %></p>
        </div>

        <!-- Description collapse on known tickets -->
        <div>
          <%= label_tag "preferences_description_collapse", t('user_preferences.edit.tickets.description_collapse.label'), class: "block text-sm font-bold mb-2 text-cream-900" %>
          <%= select_tag "preferences[description_collapse]",
              options_for_select([
                [t('user_preferences.edit.tickets.description_collapse.auto'), 'auto'],
                [t('user_preferences.edit.tickets.description_collapse.always_full'), 'always_full']
              ], @user.preference_store.description_collapse_preference),
              class: "w-full h-10 px-4 rounded border border-cream-300 focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all bg-surface-raised" %>
          <p class="text-xs text-cream-600 mt-2"><%= t('user_preferences.edit.tickets.description_collapse.description') %></p>
        </div>

        <!-- Actions -->
        <div class="flex justify-end gap-3 pt-4">
          <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, size: :large, type: "submit") do %>
            <%= t('user_preferences.edit.actions.save') %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

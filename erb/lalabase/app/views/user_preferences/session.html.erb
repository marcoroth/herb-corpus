<div class="pt-6" data-controller="user-preferences">
  <%= render NeoTitleBoxComponent.new(
    title: t('user_preferences.edit.title'),
    subtitle: current_user.display_name,
    variant: :project
  ) %>

  <%# S0/H1: single-group settings form → no card; fields on a warm surface. %>
  <div class="mt-8 max-w-2xl">
    <p class="text-sm text-cream-600">
      <%= t('views.user_preferences.session.subtitle') %>
    </p>

    <div class="mt-6">
      <%# P9/AP4: no dirty-disabling → formChanged actions removed. %>
      <%= form_with url: user_preferences_path, method: :patch, local: true, data: { turbo: false }, class: "space-y-6" do |form| %>
        <%= hidden_field_tag 'current_section', 'session' %>

        <div>
          <label for="user_session_timeout_minutes" class="block text-sm font-bold mb-3 text-cream-900">
            <%= t('views.user_preferences.session.label') %>
          </label>

          <%= select_tag 'user[session_timeout_minutes]',
                options_for_select(
                  User::ALLOWED_SESSION_TIMEOUTS.map { |m| [t("views.user_preferences.session.options.#{m}"), m] },
                  current_user.session_timeout_minutes
                ),
                id: 'user_session_timeout_minutes',
                class: 'w-full max-w-xs h-10 px-4 border border-cream-300 rounded bg-surface-raised focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all' %>

          <p class="mt-3 text-xs text-cream-600">
            <i class="bi bi-info-circle mr-1"></i>
            <%= t('views.user_preferences.session.hint') %>
          </p>
        </div>

        <%# P7/G6: single primary action on the right. P3/AP2: no decorative icon. P4/AP5: component. B5: submit = :large. %>
        <div class="flex justify-end gap-3 pt-4">
          <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, size: :large, type: "submit") do %>
            <%= t('views.user_preferences.session.save') %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

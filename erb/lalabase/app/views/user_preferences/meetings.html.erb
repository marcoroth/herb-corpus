<div class="pt-6">
  <%= render NeoTitleBoxComponent.new(
    title: t('user_preferences.edit.title'),
    subtitle: current_user.display_name,
    variant: :project
  ) %>

  <%# Detection mode for meeting transcripts (Gespräche Slice 5, plan decision
      12). User-global setting; the org-level AI gate ALWAYS outranks it at
      runtime — the AI option is only selectable when at least one of the
      user's organisations has AI available (opt-in AND configured). %>
  <div class="mt-8 max-w-2xl">
    <p class="text-sm text-cream-700 mb-6"><%= t('user_preferences.edit.meetings.intro') %></p>

    <div>
      <%= form_with url: user_preferences_path, method: :patch, local: true, data: { turbo: false }, class: "space-y-6" do |form| %>
        <%= hidden_field_tag 'current_section', 'meetings' %>

        <!-- Participant detection mode -->
        <div>
          <%# R2: :meeting_participant_detection — the setting's own comment already
              named the reason: it drives exactly ONE path, the LLM leg of the
              participant detection. It must therefore ask the SAME key as
              meetings/_form_fields, whose detect button this setting turns on;
              any other key would reproduce "the same gate, two answers" — the
              defect S1c removed here — in feature form. Was ai_available_for_chat?,
              before that ai_available?('openai'). %>
          <% ai_selectable = current_user.organisations.any? { |org| org.ai_available_for?(:meeting_participant_detection).available? } %>
          <%# Edge case: 'ai' stored but currently not selectable (no org has AI) —
              show 'offline' as the selection so the 'ai' option is never rendered
              selected AND disabled at once. The stored value stays 'ai' (unless the
              user actively saves); the org gate outranks the setting at runtime and
              'ai' re-applies once an org enables AI. %>
          <% stored_mode = @user.preference_store.meeting_detection_mode_preference %>
          <% selected_mode = ai_selectable ? stored_mode : 'offline' %>
          <%= label_tag "preferences_meeting_detection_mode", t('user_preferences.edit.meetings.detection_mode.label'), class: "block text-sm font-bold mb-2 text-cream-900" %>
          <%= select_tag "preferences[meeting_detection_mode]",
              options_for_select([
                [t('user_preferences.edit.meetings.detection_mode.offline'), 'offline'],
                [t('user_preferences.edit.meetings.detection_mode.ai'), 'ai', { disabled: !ai_selectable }]
              ], selected_mode),
              class: "w-full h-10 px-4 rounded border border-cream-300 focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all bg-surface-raised" %>
          <p class="text-xs text-cream-600 mt-2"><%= t('user_preferences.edit.meetings.detection_mode.description') %></p>
          <% unless ai_selectable %>
            <p class="text-xs text-amber-700 mt-2"><%= t('user_preferences.edit.meetings.detection_mode.ai_unavailable_hint') %></p>
          <% end %>
        </div>

        <!-- Actions -->
        <div class="flex justify-end gap-3 pt-4">
          <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, size: :large, type: "submit") do %>
            <%= t('user_preferences.edit.actions.save') %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

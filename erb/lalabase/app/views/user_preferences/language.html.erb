<div class="pt-6" data-controller="user-preferences">
  <%= render NeoTitleBoxComponent.new(
    title: t('user_preferences.edit.title'),
    subtitle: current_user.display_name,
    variant: :project
  ) %>

  <%# S0/H1: single-group settings form → no card; fields on a warm surface. %>
  <div class="mt-8 max-w-2xl">
    <div>
      <%# P9/AP4: no dirty-disabling → formChanged actions removed. %>
      <%= form_with url: user_preferences_path, method: :patch, local: true, data: { turbo: false }, class: "space-y-6" do |form| %>
        <%= hidden_field_tag 'current_section', 'language' %>

        <!-- Language Selection -->
        <div>
          <span class="block text-sm font-bold mb-3 text-cream-900"><%= t('user_preferences.language.interface_language') %></span>
          <p class="text-xs text-cream-600 mb-4"><%= t('user_preferences.language.interface_description') %></p>

          <%# D4 selection cards: selected = warmly highlighted (cream-200 + border-ink, no lime/shadow). %>
          <div class="flex flex-col sm:flex-row gap-3">
            <% [['de', '🇩🇪', 'Deutsch'], ['en', '🇺🇸', 'English']].each do |value, flag, name| %>
              <label class="cursor-pointer">
                <input type="radio"
                       name="user[language_preference]"
                       value="<%= value %>"
                       <%= 'checked' if current_user.language_preference == value %>
                       class="sr-only peer">
                <div class="flex items-center gap-3 p-4 border border-cream-300 rounded-lg bg-surface-raised
                            hover:bg-cream-100
                            peer-checked:bg-cream-200 peer-checked:border-ink
                            peer-focus-visible:ring-1 peer-focus-visible:ring-ink
                            transition-all">
                  <span class="text-xl"><%= flag %></span>
                  <span class="font-medium text-cream-900"><%= name %></span>
                </div>
              </label>
            <% end %>
          </div>
        </div>

        <!-- Language Info -->
        <%# S5 note panel: calm (cream-100), no decorative color. %>
        <div class="bg-cream-100 border border-cream-300 rounded-lg p-4">
          <p class="text-sm text-cream-800">
            <i class="bi bi-info-circle mr-2"></i>
            <%= t('user_preferences.language.note') %>
          </p>
        </div>

        <!-- Actions -->
        <%# P7/G6: single primary action on the right. P3/AP2: no decorative icon. P4/AP5: component. B5: submit = :large. %>
        <div class="flex justify-end gap-3 pt-4">
          <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, size: :large, type: "submit") do %>
            <%= t('user_preferences.edit.actions.save') %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

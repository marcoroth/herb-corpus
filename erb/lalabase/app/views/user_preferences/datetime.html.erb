<div class="pt-6" data-controller="user-preferences">
  <%= render NeoTitleBoxComponent.new(
    title: t('user_preferences.edit.title'),
    subtitle: current_user.display_name,
    variant: :project
  ) %>

  <%# S0/H1: single-group settings form → no card; fields on a warm surface. %>
  <div class="mt-8 max-w-2xl">
    <div>
      <%# P9/AP4: no dirty-disabling → formChanged actions removed; controller stays (toggle logic uses it). %>
      <%= form_with url: user_preferences_path, method: :patch, local: true, data: { turbo: false }, class: "space-y-6" do |form| %>
        <%= hidden_field_tag 'current_section', 'datetime' %>

        <!-- Global Format -->
        <div>
          <%= label_tag "preferences_date_display_global_format", t('user_preferences.edit.datetime.global_format.label'), class: "block text-sm font-bold mb-2 text-cream-900" %>
          <%= select_tag "preferences[date_display][global_format]",
              options_for_select([
                [t('user_preferences.edit.datetime.formats.relative'), 'relative'],
                [t('user_preferences.edit.datetime.formats.german'), 'german'],
                [t('user_preferences.edit.datetime.formats.international'), 'international'],
                [t('user_preferences.edit.datetime.formats.custom'), 'custom']
              ], @user.preferences.dig('date_display', 'global_format') || 'relative'),
              class: "w-full h-10 px-4 rounded border border-cream-300 focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all bg-surface-raised",
              data: {
                user_preferences_target: "globalFormat",
                action: "change->user-preferences#toggleCustomFormat"
              } %>
        </div>

        <!-- Custom Format Input -->
        <div data-user-preferences-target="customFormatRow" style="display: none;">
          <%= label_tag "preferences_date_display_custom_format", t('user_preferences.edit.datetime.custom_format_label'), class: "block text-sm font-bold mb-2 text-cream-900" %>
          <%= text_field_tag "preferences[date_display][custom_format]",
              @user.preferences.dig('date_display', 'custom_format') || '%d.%m.%Y %H:%M',
              class: "w-full h-10 px-4 rounded border border-cream-300 focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all bg-surface-raised",
              placeholder: "%d.%m.%Y %H:%M",
              data: {
                action: "input->user-preferences#validateGlobalFormat blur->user-preferences#validateGlobalFormat"
              } %>
          <p class="text-xs text-cream-600 mt-2">
            <%= t('user_preferences.edit.datetime.format_codes_hint') %>
          </p>
        </div>

        <!-- Use for all areas checkbox -->
        <div class="bg-cream-100 border border-cream-300 rounded p-4">
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox"
                   id="use_global_for_all"
                   name="preferences[date_display][use_global_for_all]"
                   value="1"
                   <%= 'checked' if @user.preference_store.using_global_date_format_for_all? %>
                   class="w-5 h-5 border border-cream-300 rounded"
                   data-user-preferences-target="useGlobalCheckbox"
                   data-action="change->user-preferences#toggleAreaSettings">
            <div>
              <span class="font-medium text-cream-900"><%= t('user_preferences.edit.datetime.use_global.label') %></span>
              <p class="text-xs text-cream-600 mt-1"><%= t('user_preferences.edit.datetime.use_global.description') %></p>
            </div>
          </label>
        </div>

        <!-- Individual Area Settings -->
        <div data-user-preferences-target="areaSettings">
          <h4 class="block text-sm font-bold mb-3 text-cream-900"><%= t('user_preferences.edit.datetime.individual_areas.title') %></h4>

          <div class="space-y-4">
            <% areas = {
              'posts' => t('user_preferences.datetime.areas.posts'),
              'ticket_header' => t('user_preferences.datetime.areas.ticket_header'),
              'ticket_list_large' => t('user_preferences.datetime.areas.ticket_list_large'),
              'ticket_list_compact' => t('user_preferences.datetime.areas.ticket_list_compact'),
              'activity_logs' => t('user_preferences.datetime.areas.activity_logs')
            } %>

            <% areas.each do |key, label| %>
              <div>
                <%= label_tag "preferences_date_display_areas_#{key}", label, class: "block text-sm font-bold mb-2 text-cream-900" %>
                <%= select_tag "preferences[date_display][areas][#{key}]",
                    options_for_select([
                      [t('user_preferences.edit.datetime.area_formats.inherit'), 'inherit'],
                      [t('user_preferences.edit.datetime.formats.relative'), 'relative'],
                      [t('user_preferences.edit.datetime.formats.german'), 'german'],
                      [t('user_preferences.edit.datetime.formats.international'), 'international'],
                      [t('user_preferences.edit.datetime.formats.custom'), 'custom']
                    ], @user.preferences.dig('date_display', 'areas', key) || 'inherit'),
                    class: "w-full h-10 px-4 rounded border border-cream-300 focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all bg-surface-raised area-format-select",
                    data: {
                      area: key,
                      user_preferences_target: "areaFormatSelect",
                      action: "change->user-preferences#toggleAreaCustomFormat"
                    } %>

                <!-- Custom Format Input for this area -->
                <div class="area-custom-format-row mt-2" data-area="<%= key %>" style="display: none;">
                  <%= label_tag "preferences_date_display_areas_custom_#{key}", t('user_preferences.edit.datetime.custom_format_label'), class: "block text-xs text-cream-600 mb-1" %>
                  <%= text_field_tag "preferences[date_display][areas_custom][#{key}]",
                      @user.preferences.dig('date_display', 'areas_custom', key) || '%d.%m.%Y %H:%M',
                      class: "w-full h-10 px-4 text-sm rounded border border-cream-300 focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all bg-surface-raised",
                      placeholder: "%d.%m.%Y %H:%M",
                      data: {
                        action: "input->user-preferences#validateAreaFormat blur->user-preferences#validateAreaFormat",
                        area: key
                      } %>
                  <p class="text-xs text-cream-600 mt-1">
                    <%= t('user_preferences.edit.datetime.format_codes_hint') %>
                  </p>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Actions -->
        <%# Footer scheme (D1/P7): reset on the left (secondary + ↺ icon, consequential → icon ok, decision 9),
            submit on the right (primary, no decorative icon P3/AP2). Both size :large (B5). P9/AP4: no dirty-disabling.
            P4/AP5: component instead of hand-built. %>
        <div class="flex justify-end gap-3 pt-4">
          <%= render Neo::Buttons::ButtonComponent.new(
                variant: :secondary,
                size: :large,
                icon: "arrow-counterclockwise",
                data: { action: "click->user-preferences#resetDefaults" }
              ) do %>
            <%= t('user_preferences.edit.actions.reset_defaults') %>
          <% end %>

          <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, size: :large, type: "submit") do %>
            <%= t('user_preferences.edit.actions.save') %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

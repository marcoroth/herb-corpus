<div class="pt-6">
  <%= render NeoTitleBoxComponent.new(
    title: t('user_preferences.edit.title'),
    subtitle: current_user.display_name,
    variant: :project
  ) %>

  <%# S0/H1: single-group settings form → no card; fields on a warm surface. %>
  <div class="mt-8 max-w-2xl">
    <div>
      <%# P9/AP4: no more dirty-disabling → Stimulus dirty-tracking removed (submit always active). %>
      <%= form_with url: user_preferences_path, method: :patch, local: true, data: { turbo: false }, class: "space-y-6" do |form| %>
        <%= hidden_field_tag 'current_section', 'general' %>

        <!-- Items per Page -->
        <div>
          <%= label_tag "preferences_items_per_page", t('user_preferences.edit.general.items_per_page.label'), class: "block text-sm font-bold mb-2 text-cream-900" %>
          <%= select_tag "preferences[items_per_page]",
              options_for_select([
                [t('user_preferences.edit.general.items_per_page.options.10'), 10],
                [t('user_preferences.edit.general.items_per_page.options.20'), 20],
                [t('user_preferences.edit.general.items_per_page.options.50'), 50],
                [t('user_preferences.edit.general.items_per_page.options.100'), 100]
              ], @user.items_per_page_preference),
              class: "w-full h-10 px-4 rounded border border-cream-300 focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all bg-surface-raised" %>
          <p class="text-xs text-cream-600 mt-2"><%= t('user_preferences.edit.general.items_per_page.description') %></p>
        </div>

        <!-- Actions -->
        <%# P7/G6: single primary action on the right. P3/AP2: no decorative icon. P4/AP5: component instead of hand-built.
            B5: primary form submit = size :large (prominence). %>
        <div class="flex justify-end gap-3 pt-4">
          <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, size: :large, type: "submit") do %>
            <%= t('user_preferences.edit.actions.save') %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%# D4 empty state: shown only when the resolved + permission-filtered overview renders zero widgets
    (possible now that the no-time-access redirect is gone). A warm message + the inbox as a way
    forward, never a blank page. %>
<div class="bg-cream-50 border border-cream-300 rounded-lg px-6 py-12 text-center">
  <p class="text-sm font-bold uppercase tracking-tight text-cream-900 mb-1">
    <%= t('dashboard.briefing.empty_overview.title') %>
  </p>
  <p class="text-sm text-cream-600 mb-4"><%= t('dashboard.briefing.empty_overview.body') %></p>
  <%= link_to t('dashboard.briefing.footer.all_notifications'),
      organisation_notifications_path(organisation_id: @current_organisation.id),
      class: "font-mono text-xs uppercase tracking-wider text-cobalt-600 hover:text-cobalt-700 underline decoration-2 underline-offset-4" %>
</div>

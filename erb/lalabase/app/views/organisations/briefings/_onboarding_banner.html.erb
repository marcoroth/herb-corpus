<%# Onboarding banner (Kettenglied 0, doc/onboarding_plan.md D4): fixed chrome
     ABOVE the configurable widget grid — deliberately NOT a widget (no registry
     entry, no layout mutation). Explains the organisation concept in one
     sentence (debriefing calibration Q2) and points at the seeded tutorial
     project. Disappears on its own once all tutorial tickets are done; the X
     dismisses it per user + organisation (User::PreferenceStore). %>
<div class="mb-6 p-5 bg-lime-100 dark:bg-neutral-800 border-2 border-black rounded shadow-[4px_4px_0_0_#000000] flex flex-col sm:flex-row sm:items-center gap-4"
     data-testid="onboarding-banner">
  <div class="flex-1 min-w-0">
    <p class="font-bold text-xl text-black dark:text-white leading-snug">
      <%= t('views.organisations.briefings.onboarding_banner.title') %>
    </p>
    <p class="mt-1 text-sm text-gray-700 dark:text-gray-300">
      <%= t('views.organisations.briefings.onboarding_banner.body', project_name: project.name) %>
    </p>
  </div>

  <div class="flex items-center gap-2 shrink-0">
    <%= render Neo::Buttons::ButtonComponent.new(
          variant: :primary,
          size: :medium,
          icon: 'rocket-takeoff',
          url: organisation_project_path(@current_organisation, project)
        ) do %>
      <%= t('views.organisations.briefings.onboarding_banner.cta') %>
    <% end %>

    <%= button_to organisation_onboarding_banner_path(@current_organisation),
          method: :delete,
          class: 'p-2 border-2 border-black rounded bg-white dark:bg-neutral-700 hover:shadow-[2px_2px_0_0_#000000] transition-all',
          title: t('views.organisations.briefings.onboarding_banner.dismiss'),
          'aria-label': t('views.organisations.briefings.onboarding_banner.dismiss') do %>
      <i class="bi bi-x-lg"></i>
    <% end %>
  </div>
</div>

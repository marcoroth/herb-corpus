<!-- app/views/organisations/accept_invitations/show.html.erb -->

<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4">
  <div class="w-full max-w-md border border-slate-200 rounded-lg shadow-md bg-surface-raised p-8">
    <h1 class="text-2xl font-bold mb-6"><%= t('views.organisations.accept_invitations.show.title') %></h1>

    <% if @acceptance_mode == :wrong_account %>
      <p class="text-sm text-gray-700"><%= t('views.organisations.accept_invitations.show.wrong_account_hint', email: current_user.email) %></p>
    <% else %>
      <%= form_for @invitation, url: organisation_accept_invitation_path(organisation_id: params[:organisation_id], token: @invitation.token), method: :patch do |f| %>
        <%= f.hidden_field :token, value: @invitation.token %>
        <% if @invitation.errors.any? %>
          <div class="bg-red-100 border-2 border-red-400 text-red-700 px-4 py-3 rounded mb-4">
            <h4 class="font-semibold mb-1"><%= t('views.organisations.accept_invitations.show.errors_heading') %></h4>
            <ul class="list-disc pl-5 space-y-1 text-sm">
              <% @invitation.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="mb-4">
          <%= f.label :email, t('views.organisations.accept_invitations.show.email_label'), class: 'block text-sm font-medium text-gray-700 mb-2' %>
          <%= f.email_field :email, value: @invitation.email, disabled: true, class: 'w-full px-3 py-2 border border-slate-200 rounded text-sm bg-gray-100 cursor-not-allowed' %>
        </div>

        <% if @acceptance_mode == :create_account %>
          <div class="mb-4">
            <%= f.label :password, t('views.organisations.accept_invitations.show.password_label'), class: 'block text-sm font-medium text-gray-700 mb-2' %>
            <%= f.password_field :password, class: 'w-full px-3 py-2 border border-slate-200 rounded text-sm focus:outline-none focus:shadow-sm focus:-translate-x-0.5 focus:-translate-y-0.5 transition-all', required: true, autocomplete: "new-password" %>
          </div>

          <div class="mb-4">
            <%= f.label :password_confirmation, t('views.organisations.accept_invitations.show.password_confirmation_label'), class: 'block text-sm font-medium text-gray-700 mb-2' %>
            <%= f.password_field :password_confirmation, class: 'w-full px-3 py-2 border border-slate-200 rounded text-sm focus:outline-none focus:shadow-sm focus:-translate-x-0.5 focus:-translate-y-0.5 transition-all', required: true, autocomplete: "new-password" %>
          </div>
        <% else %>
          <p class="mb-4 text-sm text-gray-700"><%= t('views.organisations.accept_invitations.show.signed_in_hint') %></p>
        <% end %>

        <div class="mb-6 flex items-start gap-2">
          <%= f.check_box :terms_accepted, class: 'mt-0.5 w-4 h-4 shrink-0 border border-slate-200 rounded focus:ring-2 focus:ring-black', value: 'true' %>
          <%= f.label :terms_accepted,
                t('views.shared.consent.accept_terms_html',
                  terms_link: legal_page_link(:terms,
                    label: t('views.shared.consent.terms_link_text'), fallback_to_label: true,
                    target: '_blank', rel: 'noopener', class: 'font-medium text-cobalt-700 underline hover:text-cobalt-800'),
                  privacy_link: legal_page_link(:privacy,
                    label: t('views.shared.consent.privacy_link_text'), fallback_to_label: true,
                    target: '_blank', rel: 'noopener', class: 'font-medium text-cobalt-700 underline hover:text-cobalt-800')),
                class: 'text-sm text-gray-700' %>
        </div>

        <%= render(Neo::Buttons::ButtonComponent.new(variant: :primary, size: :large, type: :submit)) { t('views.organisations.accept_invitations.show.submit') } %>
      <% end %>
    <% end %>
  </div>
</div>

<div class="pt-6">
  <%= render NeoTitleBoxComponent.new(
    title: t('views.organisations.prompt_personas.edit.title', key: @prompt_persona.key),
    variant: :organisation
  ) do |component| %>
    <% component.with_right_content do %>
      <%= render Neo::Buttons::HeaderButtonComponent.new(
        variant: :secondary,
        icon: "arrow-left",
        label: t('views.organisations.prompt_personas.shared.back'),
        url: organisation_prompt_personas_path(@current_organisation)
      ) %>
    <% end %>
  <% end %>

  <div class="max-w-2xl mx-auto mt-6">
    <%= render 'form', prompt_persona: @prompt_persona %>
  </div>
</div>

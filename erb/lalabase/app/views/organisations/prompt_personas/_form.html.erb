<%# locals: (prompt_persona:) -%>
<% input_class = "w-full px-3 py-2 bg-surface-raised border border-cream-300 rounded text-sm focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all" %>
<% submit_label = prompt_persona.persisted? ? t('views.organisations.prompt_personas.form.submit_save') : t('views.organisations.prompt_personas.form.submit_create') %>

<%= form_with model: [@current_organisation, prompt_persona], local: true do |form| %>
  <% if prompt_persona.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4" role="alert">
      <h2 class="font-bold"><%= t('views.organisations.prompt_personas.form.errors_title', count: prompt_persona.errors.count) %></h2>
      <ul class="list-disc list-inside">
        <% prompt_persona.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-cream-50 border border-cream-300 rounded-lg p-6 mb-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :key, t('views.organisations.prompt_personas.form.label_key'), class: 'block text-sm font-medium text-cream-800 mb-2' %>
        <%= form.text_field :key, class: input_class %>
        <p class="mt-1 text-xs text-cream-600"><%= t('views.organisations.prompt_personas.form.key_hint') %></p>
      </div>
      <div>
        <%= form.label :position, t('views.organisations.prompt_personas.form.label_position'), class: 'block text-sm font-medium text-cream-800 mb-2' %>
        <%= form.number_field :position, class: input_class %>
      </div>
    </div>

    <div class="mt-6">
      <%= render 'prompt_personas/locale_fields',
                 persona: prompt_persona,
                 input_class: input_class,
                 label_class: 'block text-sm font-medium text-cream-800 mb-2',
                 hint_class: 'mt-1 text-xs text-cream-600' %>
    </div>
  </div>

  <div class="flex items-center justify-end gap-4">
    <%= render Neo::Buttons::ButtonComponent.new(variant: :secondary,
          url: organisation_prompt_personas_path(@current_organisation)) do %>
      <%= t('views.organisations.prompt_personas.form.cancel') %>
    <% end %>

    <%= render Neo::Buttons::ButtonComponent.new(
      variant: :primary,
      icon: "check-lg",
      tag: :button,
      type: 'submit'
    ) do %>
      <%= submit_label %>
    <% end %>
  </div>
<% end %>

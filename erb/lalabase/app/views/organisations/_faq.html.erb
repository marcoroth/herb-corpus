<%# Collapsed FAQ instead of an always-expanded info wall: a permanent block
    gets ignored (banner blindness), so orientation lives here on demand while
    the decision-critical "orgs can't be merged" warning moved into the create
    modal (point of action). Reuses the generic landing-faq toggle controller. %>
<div class="mt-14" data-controller="landing-faq">
  <h3 class="font-black uppercase text-xs tracking-tight mb-3 flex items-center gap-2 text-cream-500">
    <i class="bi bi-info-circle"></i>
    <%= t('views.organisations.select.faq_heading') %>
  </h3>
  <div class="space-y-2">
    <% [
         ['faq_q_org', 'info_org_html'],
         ['faq_q_project', 'info_projects_html'],
         ['faq_q_when', 'faq_a_when_html'],
         ['faq_q_membership', 'info_membership_html']
       ].each do |q_key, a_key| %>
      <div class="border border-cream-200 rounded-lg bg-cream-100 overflow-hidden">
        <button type="button"
                class="w-full text-left px-4 py-3 flex items-center justify-between gap-3 hover:bg-cream-200/50 transition-colors"
                data-action="click->landing-faq#toggle"
                data-landing-faq-target="item"
                aria-expanded="false">
          <span class="font-bold text-sm text-cream-900"><%= t("views.organisations.select.#{q_key}") %></span>
          <i class="bi bi-plus-lg text-cream-500 transition-transform duration-200 flex-shrink-0" data-landing-faq-target="icon"></i>
        </button>
        <div class="hidden px-4 pb-4 border-t border-cream-200" data-landing-faq-target="panel">
          <p class="pt-3 text-sm text-cream-700"><%= t("views.organisations.select.#{a_key}") %></p>
        </div>
      </div>
    <% end %>
  </div>
</div>

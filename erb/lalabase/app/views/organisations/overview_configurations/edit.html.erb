<%# Organisation-overview binding of the shared inline editor (shared/dashboards/_editor) — the
    org-scoped sibling of dashboard_configurations/edit.html.erb. Everything surface-specific is
    computed HERE and handed down as locals: the turbo-frame id (must match the read frame in
    briefings/show), the org-scoped editor routes, the title box, the Overview widget registry, the
    overview's 2-scope save partial + its settings partial, and the org save-scope bindings for the
    shared JS. The body itself is identical to the project dashboard's (DRY: one editor, two bindings).

    smart_folders: [] — the overview has no smart folders. projects: the org's accessible projects,
    for the projects_table widget's "selected projects" picker. stats_widget_keys names the picker-grid
    widgets (org_stats_cards + billing_overview) so the shared JS blocks saving either with zero
    cards/stages checked. %>
<%= render 'shared/dashboards/editor',
      frame_id: 'overview',
      title: @current_organisation.name,
      subtitle: t('overview.configuration.title'),
      title_variant: :organisation,
      preview_url: widget_preview_organisation_overview_configuration_path(@current_organisation),
      update_url: organisation_overview_configuration_path(@current_organisation),
      done_url: organisation_root_path(@current_organisation),
      reset_url: reset_organisation_overview_configuration_path(@current_organisation),
      registry: Overview::WidgetRegistry::WIDGETS,
      base_params: { organisation: @current_organisation, user: current_user, briefing: @briefing },
      save_scopes_partial: 'organisations/overview_configurations/save_scopes',
      widget_settings_partial: 'organisations/overview_configurations/widget_settings',
      default_scope: 'personal',
      confirm_scopes: %w[default],
      confirm_message: t('overview.configuration.confirm_org_default'),
      stats_widget_keys: %w[org_stats_cards billing_overview],
      configuration: @configuration,
      available_widgets: @available_widgets,
      smart_folders: [],
      projects: selectable_projects.active.order(:name) %>

<div class="container mx-auto px-4 py-8 max-w-4xl">
  <div class="neo-brutalist-container">
    <div class="mb-6">
      <%= link_to organisation_project_project_permissions_path(@organisation, @project), class: "neo-link mb-4 inline-block" do %>
        <i class="bi bi-arrow-left"></i> <%= t('views.organisations.project_permissions.info.back_to_permissions') %>
      <% end %>

      <h1 class="text-3xl font-bold mb-2"><%= t('views.organisations.project_permissions.info.title') %></h1>
      <p class="text-gray-600"><%= t('views.organisations.project_permissions.info.subtitle') %></p>
    </div>

    <!-- Table of contents -->
    <div class="border border-slate-200 rounded-lg p-6 mb-8 bg-yellow-50">
      <h2 class="text-xl font-bold mb-4"><%= t('views.organisations.project_permissions.info.toc_title') %></h2>
      <ul class="space-y-2">
        <li><a href="#overview" class="text-cobalt-600 hover:text-cobalt-800"><%= t('views.organisations.project_permissions.info.toc_overview') %></a></li>
        <li><a href="#access-levels" class="text-cobalt-600 hover:text-cobalt-800"><%= t('views.organisations.project_permissions.info.toc_access_levels') %></a></li>
        <li><a href="#areas" class="text-cobalt-600 hover:text-cobalt-800"><%= t('views.organisations.project_permissions.info.toc_areas') %></a></li>
        <li><a href="#time-sessions" class="text-cobalt-600 hover:text-cobalt-800"><%= t('views.organisations.project_permissions.info.toc_time_sessions') %></a></li>
        <li><a href="#removing" class="text-cobalt-600 hover:text-cobalt-800"><%= t('views.organisations.project_permissions.info.toc_removing') %></a></li>
        <li><a href="#who-can-change" class="text-cobalt-600 hover:text-cobalt-800"><%= t('views.organisations.project_permissions.info.toc_who_can_change') %></a></li>
        <li><a href="#faq" class="text-cobalt-600 hover:text-cobalt-800"><%= t('views.organisations.project_permissions.info.toc_faq') %></a></li>
      </ul>
    </div>

    <!-- Overview -->
    <section id="overview" class="mb-12">
      <h2 class="text-2xl font-bold mb-4"><%= t('views.organisations.project_permissions.info.overview_title') %></h2>
      <div class="prose max-w-none">
        <p class="mb-4"><%= t('views.organisations.project_permissions.info.overview_intro') %></p>

        <div class="grid gap-4 md:grid-cols-3">
          <div class="border border-slate-200 rounded-lg p-4 bg-cobalt-50">
            <h3 class="font-bold mb-2"><%= t('views.organisations.project_permissions.info.level_admin_title') %></h3>
            <p class="text-sm"><%= t('views.organisations.project_permissions.info.level_admin_description') %></p>
          </div>

          <div class="border border-slate-200 rounded-lg p-4 bg-green-50">
            <h3 class="font-bold mb-2"><%= t('views.organisations.project_permissions.info.level_role_title') %></h3>
            <p class="text-sm"><%= t('views.organisations.project_permissions.info.level_role_description') %></p>
          </div>

          <div class="border border-slate-200 rounded-lg p-4 bg-purple-50">
            <h3 class="font-bold mb-2"><%= t('views.organisations.project_permissions.info.level_project_title') %></h3>
            <p class="text-sm"><%= t('views.organisations.project_permissions.info.level_project_description') %></p>
          </div>
        </div>

        <div class="mt-4 p-4 bg-gray-100 border-l-4 border-gray-600">
          <p class="font-medium"><%= t('views.organisations.project_permissions.info.override_notice') %></p>
        </div>
      </div>
    </section>

    <!-- Removing a member -->
    <section id="removing" class="mb-12">
      <h2 class="text-2xl font-bold mb-4"><%= t('views.organisations.project_permissions.info.removing_title') %></h2>
      <div class="prose max-w-none">
        <p class="mb-4"><%= t('views.organisations.project_permissions.info.removing_intro') %></p>

        <div class="grid gap-4 md:grid-cols-2">
          <div class="border border-slate-200 rounded-lg p-4 bg-green-50">
            <h3 class="font-bold mb-2"><%= t('views.organisations.project_permissions.info.removing_plain_title') %></h3>
            <p class="text-sm"><%= t('views.organisations.project_permissions.info.removing_plain_description') %></p>
          </div>

          <div class="border border-slate-200 rounded-lg p-4 bg-red-50">
            <h3 class="font-bold mb-2"><%= t('views.organisations.project_permissions.info.removing_blocked_title') %></h3>
            <p class="text-sm"><%= t('views.organisations.project_permissions.info.removing_blocked_description') %></p>
          </div>
        </div>

        <div class="mt-4 p-4 bg-gray-100 border-l-4 border-gray-600">
          <p class="font-medium"><%= t('views.organisations.project_permissions.info.removing_admin_notice') %></p>
        </div>
      </div>
    </section>

    <!-- Access levels -->
    <section id="access-levels" class="mb-12">
      <h2 class="text-2xl font-bold mb-4"><%= t('views.organisations.project_permissions.info.access_levels_title') %></h2>

      <div class="space-y-4">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-10 h-10 bg-red-500 rounded flex items-center justify-center">
            <i class="bi bi-x-lg text-on-fill"></i>
          </div>
          <div>
            <h3 class="font-bold"><%= t('views.organisations.project_permissions.info.no_access_title') %></h3>
            <p class="text-gray-600"><%= t('views.organisations.project_permissions.info.no_access_description') %></p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-10 h-10 bg-yellow-500 rounded flex items-center justify-center">
            <i class="bi bi-eye text-on-fill"></i>
          </div>
          <div>
            <h3 class="font-bold"><%= t('views.organisations.project_permissions.info.read_only_title') %></h3>
            <p class="text-gray-600"><%= t('views.organisations.project_permissions.info.read_only_description') %></p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-10 h-10 bg-green-500 rounded flex items-center justify-center">
            <i class="bi bi-pencil text-on-fill"></i>
          </div>
          <div>
            <h3 class="font-bold"><%= t('views.organisations.project_permissions.info.read_write_title') %></h3>
            <p class="text-gray-600"><%= t('views.organisations.project_permissions.info.read_write_description') %></p>
          </div>
        </div>
      </div>
    </section>

    <!-- Areas -->
    <section id="areas" class="mb-12">
      <h2 class="text-2xl font-bold mb-4"><%= t('views.organisations.project_permissions.info.areas_title') %></h2>

      <div class="grid gap-4 md:grid-cols-2">
        <div class="border border-slate-200 rounded-lg p-4">
          <h3 class="font-bold mb-2"><i class="bi bi-robot"></i> <%= t('views.organisations.project_permissions.info.area_chats_label') %></h3>
          <p class="text-sm text-gray-600"><%= t('views.organisations.project_permissions.info.area_chats_description') %></p>
        </div>

        <div class="border border-slate-200 rounded-lg p-4">
          <h3 class="font-bold mb-2"><i class="bi bi-list-task"></i> <%= t('views.organisations.project_permissions.info.area_tasks_label') %></h3>
          <p class="text-sm text-gray-600"><%= t('views.organisations.project_permissions.info.area_tasks_description') %></p>
        </div>

        <div class="border border-slate-200 rounded-lg p-4">
          <h3 class="font-bold mb-2"><i class="bi bi-journal-text"></i> <%= t('views.organisations.project_permissions.info.area_notes_label') %></h3>
          <p class="text-sm text-gray-600"><%= t('views.organisations.project_permissions.info.area_notes_description') %></p>
        </div>

        <div class="border border-slate-200 rounded-lg p-4">
          <h3 class="font-bold mb-2"><i class="bi bi-file-earmark"></i> <%= t('views.organisations.project_permissions.info.area_files_label') %></h3>
          <p class="text-sm text-gray-600"><%= t('views.organisations.project_permissions.info.area_files_description') %></p>
        </div>

        <div class="border border-slate-200 rounded-lg p-4">
          <h3 class="font-bold mb-2"><i class="bi bi-clock-history"></i> <%= t('views.organisations.project_permissions.info.area_time_label') %></h3>
          <p class="text-sm text-gray-600"><%= t('views.organisations.project_permissions.info.area_time_description') %></p>
        </div>

        <div class="border border-slate-200 rounded-lg p-4">
          <h3 class="font-bold mb-2"><i class="bi bi-people"></i> <%= t('views.organisations.project_permissions.info.area_team_label') %></h3>
          <p class="text-sm text-gray-600"><%= t('views.organisations.project_permissions.info.area_team_description') %></p>
        </div>
      </div>
    </section>

    <!-- TimeSession special -->
    <section id="time-sessions" class="mb-12">
      <h2 class="text-2xl font-bold mb-4"><%= t('views.organisations.project_permissions.info.time_sessions_title') %></h2>

      <div class="border border-slate-200 rounded-lg p-6 bg-cobalt-50">
        <p class="mb-4"><%= t('views.organisations.project_permissions.info.time_sessions_intro') %></p>

        <div class="grid gap-4 md:grid-cols-2">
          <div>
            <h3 class="font-bold mb-2"><%= t('views.organisations.project_permissions.info.own_time_sessions') %></h3>
            <ul class="space-y-1 text-sm">
              <li><%= t('views.organisations.project_permissions.info.own_create') %></li>
              <li><%= t('views.organisations.project_permissions.info.own_view') %></li>
              <li><%= t('views.organisations.project_permissions.info.own_edit') %></li>
              <li><%= t('views.organisations.project_permissions.info.own_delete') %></li>
            </ul>
          </div>

          <div>
            <h3 class="font-bold mb-2"><%= t('views.organisations.project_permissions.info.all_time_sessions') %></h3>
            <ul class="space-y-1 text-sm">
              <li><%= t('views.organisations.project_permissions.info.all_view') %></li>
              <li><%= t('views.organisations.project_permissions.info.all_edit') %></li>
              <li><%= t('views.organisations.project_permissions.info.all_delete') %></li>
            </ul>
          </div>
        </div>

        <p class="mt-4 text-sm font-medium">
          <i class="bi bi-info-circle"></i> <%= t('views.organisations.project_permissions.info.time_sessions_override_notice') %>
        </p>
      </div>
    </section>

    <!-- Who can change -->
    <section id="who-can-change" class="mb-12">
      <h2 class="text-2xl font-bold mb-4"><%= t('views.organisations.project_permissions.info.who_can_change_title') %></h2>

      <div class="space-y-4">
        <div class="border border-slate-200 rounded-lg p-4">
          <h3 class="font-bold mb-2"><%= t('views.organisations.project_permissions.info.general_permissions_title') %></h3>
          <ul class="space-y-2 text-sm">
            <li><%= t('views.organisations.project_permissions.info.general_admin_can') %></li>
            <li><%= t('views.organisations.project_permissions.info.general_team_write_can') %></li>
            <li><%= t('views.organisations.project_permissions.info.general_self_cannot') %></li>
          </ul>
        </div>

        <div class="border border-slate-200 rounded-lg p-4">
          <h3 class="font-bold mb-2"><%= t('views.organisations.project_permissions.info.time_permissions_title') %></h3>
          <ul class="space-y-2 text-sm">
            <li><%= t('views.organisations.project_permissions.info.time_admin_can') %></li>
            <li><%= t('views.organisations.project_permissions.info.time_team_write_can') %></li>
            <li><%= t('views.organisations.project_permissions.info.time_self_cannot') %></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="mb-12">
      <h2 class="text-2xl font-bold mb-4"><%= t('views.organisations.project_permissions.info.faq_title') %></h2>

      <div class="space-y-6">
        <div>
          <h3 class="font-bold mb-2"><%= t('views.organisations.project_permissions.info.faq_q1') %></h3>
          <p class="text-gray-600"><%= t('views.organisations.project_permissions.info.faq_a1') %></p>
        </div>

        <div>
          <h3 class="font-bold mb-2"><%= t('views.organisations.project_permissions.info.faq_q2') %></h3>
          <p class="text-gray-600"><%= t('views.organisations.project_permissions.info.faq_a2') %></p>
        </div>

        <div>
          <h3 class="font-bold mb-2"><%= t('views.organisations.project_permissions.info.faq_q3') %></h3>
          <p class="text-gray-600"><%= t('views.organisations.project_permissions.info.faq_a3') %></p>
        </div>

        <div>
          <h3 class="font-bold mb-2"><%= t('views.organisations.project_permissions.info.faq_q4') %></h3>
          <p class="text-gray-600"><%= t('views.organisations.project_permissions.info.faq_a4') %></p>
        </div>

        <div>
          <h3 class="font-bold mb-2"><%= t('views.organisations.project_permissions.info.faq_q5') %></h3>
          <p class="text-gray-600"><%= t('views.organisations.project_permissions.info.faq_a5') %></p>
        </div>

        <div>
          <h3 class="font-bold mb-2"><%= t('views.organisations.project_permissions.info.faq_q6') %></h3>
          <p class="text-gray-600"><%= t('views.organisations.project_permissions.info.faq_a6') %></p>
        </div>

        <div>
          <h3 class="font-bold mb-2"><%= t('views.organisations.project_permissions.info.faq_q7') %></h3>
          <p class="text-gray-600"><%= t('views.organisations.project_permissions.info.faq_a7') %></p>
        </div>

        <div>
          <h3 class="font-bold mb-2"><%= t('views.organisations.project_permissions.info.faq_q8') %></h3>
          <p class="text-gray-600"><%= t('views.organisations.project_permissions.info.faq_a8') %></p>
        </div>

        <div>
          <h3 class="font-bold mb-2"><%= t('views.organisations.project_permissions.info.faq_q9') %></h3>
          <p class="text-gray-600"><%= t('views.organisations.project_permissions.info.faq_a9') %></p>
        </div>
      </div>
    </section>

    <!-- Back link -->
    <div class="mt-12 pt-8 border-t-2 border-gray-300 text-center">
      <%= link_to organisation_project_project_permissions_path(@organisation, @project),
                  class: "inline-flex items-center gap-2 px-6 py-3 bg-cobalt-600 text-on-fill rounded-lg hover:bg-cobalt-700 font-medium" do %>
        <i class="bi bi-arrow-left"></i>
        <%= t('views.organisations.project_permissions.info.back_to_permissions') %>
      <% end %>
    </div>
  </div>
</div>
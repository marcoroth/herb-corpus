<div class="container mx-auto px-4 py-8">
  <div class="neo-brutalist-container max-w-4xl mx-auto">
    <div class="mb-6">
      <%= link_to organisation_project_project_permissions_path(@organisation, @project), class: "neo-link mb-4 inline-block" do %>
        <i class="bi bi-arrow-left"></i> <%= t('views.organisations.project_permissions.time_sessions_settings.back_to_permissions') %>
      <% end %>
      
      <h1 class="neo-h1 mb-2"><%= t('views.organisations.project_permissions.time_sessions_settings.title') %></h1>
      <p class="neo-subheading"><%= t('views.organisations.project_permissions.time_sessions_settings.subtitle', user: viewer_display_name(@user), project: @project.name) %></p>
    </div>
    
    <%= form_with model: @time_permission, 
                  url: update_time_sessions_settings_organisation_project_project_permission_path(@organisation, @project, @project_permission), 
                  method: :patch, 
                  local: true,
                  class: "neo-form" do |form| %>
      
      <div class="space-y-6">
        <!-- Eigene TimeSessions -->
        <div class="border-2 border-gray-900 p-6 bg-surface-raised">
          <h3 class="text-lg font-bold mb-4"><%= t('views.organisations.project_permissions.time_sessions_settings.own_title') %></h3>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <label class="flex items-center space-x-3">
              <%= form.check_box :can_create_own, class: "neo-checkbox" %>
              <span><%= t('views.organisations.project_permissions.time_sessions_settings.can_create_own') %></span>
            </label>
            
            <label class="flex items-center space-x-3">
              <%= form.check_box :can_view_own, class: "neo-checkbox" %>
              <span><%= t('views.organisations.project_permissions.time_sessions_settings.can_view_own') %></span>
            </label>
            
            <label class="flex items-center space-x-3">
              <%= form.check_box :can_edit_own, class: "neo-checkbox" %>
              <span><%= t('views.organisations.project_permissions.time_sessions_settings.can_edit_own') %></span>
            </label>
            
            <label class="flex items-center space-x-3">
              <%= form.check_box :can_delete_own, class: "neo-checkbox" %>
              <span><%= t('views.organisations.project_permissions.time_sessions_settings.can_delete_own') %></span>
            </label>
          </div>
        </div>
        
        <!-- Alle TimeSessions -->
        <div class="border-2 border-gray-900 p-6 bg-gray-100">
          <h3 class="text-lg font-bold mb-4"><%= t('views.organisations.project_permissions.time_sessions_settings.all_title') %></h3>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <label class="flex items-center space-x-3">
              <%= form.check_box :can_view_all, class: "neo-checkbox" %>
              <span><%= t('views.organisations.project_permissions.time_sessions_settings.can_view_all') %></span>
            </label>
            
            <label class="flex items-center space-x-3">
              <%= form.check_box :can_edit_all, class: "neo-checkbox" %>
              <span><%= t('views.organisations.project_permissions.time_sessions_settings.can_edit_all') %></span>
            </label>
            
            <label class="flex items-center space-x-3">
              <%= form.check_box :can_delete_all, class: "neo-checkbox" %>
              <span><%= t('views.organisations.project_permissions.time_sessions_settings.can_delete_all') %></span>
            </label>
          </div>
        </div>
        
        <!-- Aktuelle Berechtigung -->
        <div class="border-2 border-gray-900 p-4 bg-yellow-50">
          <h4 class="font-bold mb-2"><%= t('views.organisations.project_permissions.time_sessions_settings.current_permission') %></h4>
          <p class="text-sm"><%= @time_permission.permission_summary %></p>
        </div>
      </div>
      
      <div class="mt-6 flex gap-4">
        <%= render Neo::Buttons::ButtonComponent.new(
          variant: :primary, 
          type: :submit
        ) do %>
          <i class="bi bi-check-lg"></i> <%= t('views.organisations.project_permissions.time_sessions_settings.save_permissions') %>
        <% end %>
        
        <%= link_to organisation_project_project_permissions_path(@organisation, @project), 
                    class: "neo-button neo-button-secondary" do %>
          <%= t('views.organisations.project_permissions.time_sessions_settings.cancel') %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

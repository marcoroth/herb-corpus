<%# S3c T3: the `report` panel (plan §8.1) -- the rows behind a time answer.

    The lane is for content WITHOUT a page of its own. A time report is exactly
    that: the chat says "37 hours are not invoiced yet", and this shows which
    bookings the sentence is made of. Its address is the one the answer already
    carries (a time_report citation = project plus frozen filters), so nothing had
    to be persisted for the panel to be reopenable.

    ⚠️ The frame's ESCAPE is not set here. Two kinds of link end up in this panel:
    the billing badge of a row (TimeSessionBillingStatusComponent links to its
    billing group) and the way out into the time list below. Both need
    target="_top", or they load a whole page INTO the frame, find no matching
    frame in the response and render "Content missing" -- the same trap the
    citation list documents. But the owner of that attribute is the SHELL's frame
    in layouts/_assistant_panel: Turbo keeps the element that is already in the
    document and swaps only its children, so target and class sent on THIS frame
    never arrive. They are repeated below for the case where somebody opens this
    address directly and gets the bare frame; do not read them as the guard. %>
<%= turbo_frame_tag 'assistant_panel_artefact', target: '_top', class: 'assistant-lane-artefact min-h-0' do %>
  <div class="flex flex-col h-full min-h-0">
    <div class="flex items-start justify-between gap-2 px-4 py-3 border-b-2 border-cream-300 shrink-0">
      <div class="min-w-0">
        <h3 class="text-sm font-bold text-cream-900 flex items-center gap-2">
          <i class="bi bi-stopwatch shrink-0" aria-hidden="true"></i>
          <span class="truncate"><%= t('views.organisations.assistant_artefacts.report.title', project: @panel.project.name) %></span>
        </h3>
        <p class="mt-1 text-xs text-cream-600">
          <%= assistant_report_filter_summary(@panel) %>
        </p>
        <%# The tier is stated, never implied: a total over the reader's own hours
            and one over everybody's look exactly alike. %>
        <% if @panel.tier == :own %>
          <p class="mt-1 text-xs text-cream-600"><%= t('views.organisations.assistant_artefacts.report.own_only') %></p>
        <% end %>
      </div>
      <button type="button"
              data-action="assistant-panel#closeArtefact"
              title="<%= t('views.organisations.assistant_artefacts.shell.close') %>"
              aria-label="<%= t('views.organisations.assistant_artefacts.shell.close') %>"
              class="w-7 h-7 shrink-0 flex items-center justify-center text-cream-500 hover:text-cream-900 hover:bg-cream-200 rounded transition-all">
        <i class="bi bi-x-lg text-sm"></i>
      </button>
    </div>

    <%# The sums cover the WHOLE filtered set, also when the row list below is
        capped. That is the honest split: a number you can rely on, and a list that
        says how much of itself it is showing. %>
    <dl class="grid grid-cols-2 gap-x-4 gap-y-2 px-4 py-3 border-b border-cream-300 text-sm shrink-0">
      <% TimeSession::BILLING_STATUS_FILTERS.each do |bucket| %>
        <div class="flex items-baseline justify-between gap-2">
          <dt class="text-cream-600"><%= time_billing_state_label(bucket) %></dt>
          <dd class="font-mono font-semibold text-cream-900"><%= TimeSession.format_duration(@panel.totals[bucket][:minutes]) %></dd>
        </div>
      <% end %>
      <div class="flex items-baseline justify-between gap-2">
        <dt class="font-semibold text-cream-900"><%= t('views.organisations.assistant_artefacts.report.total') %></dt>
        <dd class="font-mono font-bold text-cream-900"><%= TimeSession.format_duration(@panel.totals.values.sum { |t| t[:minutes] }) %></dd>
      </div>
    </dl>

    <div class="flex-1 min-h-0 overflow-y-auto p-4 space-y-3">
      <% if @panel.rows.empty? %>
        <p class="text-sm text-cream-600"><%= t('views.organisations.assistant_artefacts.report.empty') %></p>
      <% else %>
        <% @panel.rows.each do |session| %>
          <%= render NeoTimeSessionComponent.new(time_session: session,
                                                 current_user: current_user,
                                                 show_actions: false,
                                                 project: @panel.project) %>
        <% end %>
        <% if @panel.truncated? %>
          <p class="text-xs text-cream-600">
            <%= t('views.organisations.assistant_artefacts.report.truncated',
                  shown: @panel.rows.size, total: @panel.row_count) %>
          </p>
        <% end %>
      <% end %>
    </div>

    <div class="px-4 py-3 border-t border-cream-300 shrink-0">
      <%= link_to t('views.organisations.assistant_artefacts.report.open_in_list'),
                  assistant_report_list_path(current_organisation, @panel.project, @panel.filters),
                  class: 'text-sm font-medium underline decoration-dotted underline-offset-2 text-cream-700 hover:text-cobalt-700' %>
    </div>
  </div>
<% end %>

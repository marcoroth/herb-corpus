<%# One picker entry. mention = a policy-scoped Note | Document. %>
<%# Per Lexxy's contract (docs/prompts/inline-attachments): the sgid is an ATTRIBUTE on %>
<%# <lexxy-prompt-item> (minted server-side here, never client-supplied), the prompt's %>
<%# name="mention" sets the attachment content-type, and the editor template renders the %>
<%# SAME partial as the stored attachment (to_attachable_partial_path) for editor↔view parity. %>
<lexxy-prompt-item search="<%= mention.title %>" sgid="<%= mention.attachable_sgid %>">
  <template type="menu"><%= mention.title.presence || t("views.wiki.mentions.untitled") %> · <%= mention.model_name.human %></template>
  <template type="editor"><%= render "wiki/mentions/mention", mentionable: mention %></template>
</lexxy-prompt-item>

<%# S3a T4: the first message of a new thread was submitted from inside the
    companion panel. `update` (not `replace`) on purpose: it exchanges the
    frame's CHILDREN and leaves the frame element -- and with it the src the
    panel controller armed -- in place, so the panel can still reload itself
    afterwards. %>
<%= turbo_stream.update 'assistant_panel_body' do %>
  <%= render 'organisations/assistant_panels/content', chat: @chat %>
<% end %>

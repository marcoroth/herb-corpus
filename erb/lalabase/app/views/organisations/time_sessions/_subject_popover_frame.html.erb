<%# The frame answer for the header chip's lazy popover load. target="_top",
    because the one real link inside (open in the times overview) navigates the
    page; the capture form answers with turbo streams regardless of the target. %>
<%= turbo_frame_tag "subject_time_popover_#{@popover_subject.id}", target: '_top' do %>
  <%= render 'organisations/time_sessions/subject_popover' %>
<% end %>

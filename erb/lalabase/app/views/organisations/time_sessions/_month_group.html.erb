<%# locals: (month:, can_bulk_assign_others: false, show_creator: false, expand_all: false, master_checkbox: false) %>
<%# One month of the time list: its sum, the billing every row under it shares
    (blank when they disagree), and the rows themselves. The month comes from the
    database in the application's zone, so a booking made at 00:30 in Berlin is
    filed where the period filter would file it. %>
<div class="mb-6">
  <%# The header carries the SAME columns as _aggregate_row, spacer for spacer,
      including the ones it leaves empty. It read as restless while it did not
      (user, 30.08.2026): without the select and handle columns the month sum sat
      30px left of the durations under it and the month name 44px left of the
      titles, so two lines that mean "the same column" started in three places.
      A spacer here is not decoration; it is what makes the sum a total. %>
  <div class="flex items-baseline gap-3.5 px-2 pb-1.5">
    <%# self-center, not the row's baseline: a checkbox has no text baseline, so
        on one it hangs below the line it belongs to.
        ⚠️ It sat on a labelled row of its own above the table for one commit
        (Handout §4). The user put it back here: flush in the column it commands,
        which is the whole point of it, and without a visible word, because a
        checkbox above a column of checkboxes needs none. The name travels for
        screen readers only. %>
    <span class="w-4 shrink-0 self-center">
      <% if master_checkbox %>
        <input type="checkbox"
               class="<%= TimeSessionsHelper::TIME_LIST_CHECKBOX_CLASSES %>"
               aria-label="<%= t('views.organisations.time_sessions.index_table.select_all') %>"
               title="<%= t('views.organisations.time_sessions.index_table.select_all') %>"
               data-time-session-bulk-target="masterCheckbox"
               data-action="change->time-session-bulk#toggleMaster">
      <% end %>
    </span>
    <span class="w-[62px] shrink-0 text-right font-mono text-sm font-semibold text-cream-900">
      <%= TimeSession.format_duration(month[:sum_minutes]) %>
    </span>
    <span class="w-7 shrink-0"></span>
    <%# Nested with gap-2, like the row: the handle and the title are one block
        there, and copying the widths without the nesting misses by 6px. %>
    <span class="flex min-w-0 flex-1 items-baseline gap-2">
      <span class="w-9 shrink-0"></span>
      <%# One step ABOVE the row titles (15px), not below them: it heads a
          section, and at text-xs it read as a caption for the sum beside it. %>
      <span class="min-w-0 flex-1 text-base font-bold text-cream-900"><%= month[:label] %></span>
    </span>
    <%# Same order as the row: owner, state, project, then the chevron outside. %>
    <% if show_creator %><span class="w-[108px] shrink-0"></span><% end %>
    <span class="w-[104px] shrink-0"></span>
    <span class="w-[110px] shrink-0"></span>
    <span class="w-6 shrink-0"></span>
  </div>
  <div class="h-px bg-cream-400"></div>

  <% month[:rows].each do |row| %>
    <%= render 'organisations/time_sessions/aggregate_row',
               row: row, can_bulk_assign_others: can_bulk_assign_others,
               show_creator: show_creator, expand_all: expand_all %>
  <% end %>
</div>

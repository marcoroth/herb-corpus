<%# TimeSession item for ticket timeline - styled like activity log %>
<div class="time-session-card bg-lime-50 py-4 px-6 mb-4 rounded-lg border border-stroke hover:shadow-sm hover:-translate-x-0.5 hover:-translate-y-0.5 duration-300 ease-in-out relative group"
     id="<%= dom_id(time_session) %>">

  <!-- Edit/Delete buttons for owner (only when not billed) -->
  <% if policy(time_session).update? && !time_session.billed? %>
    <div class="absolute top-4 right-4 flex items-center gap-2">
      <!-- Edit Button -->
      <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-200">
        <%= render Neo::Buttons::IconButtonComponent.new(
          variant: :edit,
          size: :small,
          tag: :button,
          icon: "pencil",
          title: t('views.organisations.time_sessions.time_session.edit_tooltip'),
          data: {
            controller: "time-session-actions",
            action: "click->time-session-actions#editTimeSession",
            time_session_id: time_session.id,
            context: defined?(@ticket) && @ticket.present? ? 'ticket' : 'index_page',
            ticket_id: @ticket&.id || time_session.ticket_id,
            project_id: @project&.id || time_session.project_id
          }
        ) %>
      </div>

      <!-- Delete Button -->
      <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-200">
        <%= render Neo::Buttons::IconButtonComponent.new(
          variant: :danger,
          size: :small,
          tag: :button,
          icon: "trash",
          title: t('views.organisations.time_sessions.time_session.delete_tooltip'),
          data: {
            controller: "time-session-actions",
            action: "click->time-session-actions#deleteTimeSession",
            time_session_id: time_session.id,
            project_id: @project&.id || time_session.project_id
          }
        ) %>
      </div>
    </div>
  <% end %>

  <div class="flex items-start gap-3">
    <!-- Icon -->
    <div class="flex-shrink-0 mt-0.5">
      <div class="w-8 h-8 rounded-full bg-lime-600 flex items-center justify-center">
        <i class="bi bi-clock text-on-fill text-sm"></i>
      </div>
    </div>

    <!-- Content -->
    <div class="flex-grow">
      <!-- Main message -->
      <p class="text-sm font-medium text-gray-700">
        <strong class="text-lime-700"><%= time_session.duration_string %></strong>
        <%= t('views.organisations.time_sessions.time_session.recorded_by', name: viewer_display_name(time_session.creator)) %>
      </p>

      <!-- Description if any -->
      <% if time_session.description.present? %>
        <p class="mt-1 text-sm text-gray-600 italic">
          "<%= time_session.description %>"
        </p>
      <% end %>

      <!-- Date and Billing Status -->
      <div class="mt-1 flex items-center gap-3">
        <span class="text-xs text-gray-500">
          <%= l time_session.occurred_on.to_date, format: :long %>
        </span>

        <!-- Billing Status Badge -->
        <%= render TimeSessionBillingStatusComponent.new(
          time_session: time_session,
          show_link: true,
          size: :small
        ) %>
      </div>
    </div>
  </div>
</div>
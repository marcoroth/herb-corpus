<%# locals: (total_minutes:, scope:, shares:, mode: 'verbose') %>
<%# The value of the header hours chip: clock reading, viewing-scope word and
    share bar. ONE partial for SubjectTimeSummaryComponent and for
    create.turbo_stream.erb (context=subject_popover), which updates only this
    span after a capture — replacing the whole chip would tear down the open
    popover beside it. The clock reading is a value (mono), the scope word is
    language (not mono). %>
<span class="font-mono"><%= time_clock_label(total_minutes) %> h</span>
<% unless mode == 'compact' %>
  <% scope_word = scope.present? ? t("components.subject_time_summary.scope.#{scope}", default: '') : '' %>
  <% if scope_word.present? %>
    <span><%= scope_word %></span>
  <% end %>
  <%= render(NeoTimeShareBarComponent.new(shares: shares || {}, size: :thin)) %>
<% end %>

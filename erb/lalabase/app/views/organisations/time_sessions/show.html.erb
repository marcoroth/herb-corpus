<div class="space-y-4 p-1">
  <!-- Time and date in a 2-column layout like in the form -->
  <div class="grid grid-cols-2 gap-4">
    <div class="text-left">
      <label class="block text-sm font-medium text-gray-700 text-left mb-1"><%= t('views.organisations.time_sessions.show.duration_label') %></label>
      <p class="text-lg font-bold text-cream-900">
        <%= @time_session.duration_string %>
      </p>
    </div>

    <div class="text-left">
      <label class="block text-sm font-medium text-gray-700 text-left mb-1"><%= t('views.organisations.time_sessions.show.date_label') %></label>
      <p class="text-lg font-bold text-cream-900">
        <%= l(@time_session.occurred_on.to_date, format: :default) %>
      </p>
    </div>
  </div>

  <!-- Description -->
  <div class="text-left">
    <label class="block text-sm font-medium text-gray-700 text-left mb-1"><%= t('views.organisations.time_sessions.show.description_label') %></label>
    <p class="text-base font-semibold text-cream-900 whitespace-pre-wrap">
      <%= @time_session.description.presence || "-" %>
    </p>
  </div>

  <!-- Ticket -->
  <% if @time_session.ticket %>
    <div class="text-left">
      <label class="block text-sm font-medium text-gray-700 text-left mb-1"><%= t('views.organisations.time_sessions.show.ticket_label') %></label>
      <p class="text-base font-semibold">
        <%= link_to @time_session.ticket.title,
                    ticket_turbo_frame_path(@current_organisation, @project, @time_session.ticket),
                    class: "text-cream-900 hover:underline",
                    target: "_blank" %>
      </p>
    </div>
  <% end %>

  <!-- Group -->
  <% if @time_session.time_session_group.present? %>
    <div class="text-left">
      <label class="block text-sm font-medium text-gray-700 text-left mb-1"><%= t('views.organisations.time_sessions.show.group_label') %></label>
      <p class="text-base font-semibold">
        <span class="inline-flex items-center px-2 py-0.5 rounded text-sm font-medium <%= @time_session.time_session_group.billed? ? 'bg-lime-300' : 'bg-yellow-300' %> text-cream-900 border border-stroke">
          <%= @time_session.time_session_group.name %>
        </span>
      </p>
    </div>
  <% end %>

  <!-- Tags -->
  <div class="text-left">
    <label class="block text-sm font-medium text-gray-700 text-left mb-1"><%= t('views.organisations.time_sessions.show.tags_label') %></label>
    <% if @time_session.tag_list.any? %>
      <div class="flex flex-wrap gap-2 mt-1">
        <% @time_session.tag_list.each do |tag| %>
          <span class="inline-flex items-center px-2 py-1 rounded-lg text-sm font-medium text-cream-900 bg-yellow-300 border border-stroke">
            <%= tag %>
          </span>
        <% end %>
      </div>
    <% else %>
      <p class="text-base font-semibold text-cream-900">-</p>
    <% end %>
  </div>

  <!-- Additional information -->
  <div class="mt-6 pt-4 border-t border-gray-200 space-y-3">
    <div class="grid grid-cols-2 gap-4 text-sm">
      <div>
        <span class="text-gray-600"><%= t('views.organisations.time_sessions.show.created_by') %></span>
        <span class="font-medium text-cream-900"><%= viewer_display_name(@time_session.creator) %></span>
      </div>
      <div>
        <span class="text-gray-600"><%= t('views.organisations.time_sessions.show.created_at') %></span>
        <span class="font-medium text-cream-900"><%= l(@time_session.created_at, format: :short) %></span>
      </div>
    </div>

    <% if @time_session.billed_at %>
      <div class="rounded-lg bg-lime-50 border border-lime-300 p-3">
        <p class="text-sm">
          <span class="font-medium"><%= t('views.organisations.time_sessions.show.billed_at') %></span> <%= l(@time_session.billed_at, format: :long) %>
          <% if @time_session.invoice_number %>
            <br><span class="font-medium"><%= t('views.organisations.time_sessions.show.invoice_number') %></span> <%= @time_session.invoice_number %>
          <% end %>
        </p>
      </div>
    <% end %>
  </div>
</div>
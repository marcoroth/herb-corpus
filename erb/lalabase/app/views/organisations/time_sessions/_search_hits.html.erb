<%# locals: () %>
<%# "n Treffer" beside the search field, once something is typed.

    ⚠️ Its own id and always rendered, even empty. It reports the SAME number the
    result row does, from the same source, and the search that produces it aims
    at time_sessions_list_frame -- so it has to be able to arrive with that
    answer. Rendered only when a term was present at page load, the element would
    not exist for the stream to replace, and the figure would never appear at
    all. One of TimeSessionsHelper::FRAME_DEPENDENT_REGIONS. %>
<%# Same rule as its neighbours: no figure, no region. create.turbo_stream
    renders this table with no filtered totals at all. %>
<% return if @total_filtered_count.nil? %>
<span id="time_search_hits" class="text-xs text-cream-600"
      <%= "data-search-hits=#{@total_filtered_count.to_i}" if params[:search].present? %>>
  <% if params[:search].present? %>
    <%= t('views.organisations.time_sessions.index.search_hits', count: @total_filtered_count.to_i) %>
  <% end %>
</span>

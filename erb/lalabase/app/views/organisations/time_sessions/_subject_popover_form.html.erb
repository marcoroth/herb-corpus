<%# The capture half of the popover. Three fields open (duration, date,
    description), tags one click deeper — the subject and the project ride as
    hidden fields, because the click location already answered both (handoff
    §9). Posts to the org-level create with context=subject_popover.

    Edit mode (persisted record, loaded via ?edit=<id>): heading names the
    original booking, the form PATCHes the member route, "Abbrechen" returns to
    the new-entry form instead of closing, and the creator gets "Löschen". %>
<% scope_key = 'views.organisations.time_sessions.subject_popover' %>
<% time_session = @popover_time_session %>
<% editing = time_session.persisted? %>
<%# No width here — every field names its own (w-20 for the duration, flex-1
    for the date, w-full for the full rows). %>
<% field_classes = 'block rounded-lg border border-stroke px-2.5 py-1.5 text-sm focus:border-stroke focus:ring-0' %>

<div class="flex items-baseline gap-2">
  <h3 class="text-[13px] font-semibold text-cream-900">
    <%= editing ? t("#{scope_key}.heading_edit") : t("#{scope_key}.heading") %>
  </h3>
  <% if editing %>
    <%# The booking's identity as stored, not the dirty form values. %>
    <span class="font-mono text-xs text-cream-500">
      <%= time_clock_label(time_session.duration_in_database) %> h · <%= l(time_session.occurred_on_in_database.to_date, format: :default) %>
    </span>
  <% elsif @popover_subject.is_a?(Ticket) %>
    <span class="font-mono text-xs text-cream-500">#<%= @popover_subject.number %></span>
  <% end %>
</div>

<%= form_with model: time_session,
              url: editing ? organisation_time_session_path(current_organisation, time_session) : organisation_time_sessions_path(current_organisation),
              method: editing ? :patch : :post,
              data: { controller: 'time-session-form' } do |f| %>
  <%= hidden_field_tag :context, 'subject_popover' %>
  <%= f.hidden_field :project_id, value: @popover_subject.project_id %>
  <% if @popover_subject.is_a?(Ticket) %>
    <%= f.hidden_field :ticket_id, value: @popover_subject.id %>
  <% else %>
    <%= f.hidden_field :meeting_id, value: @popover_subject.id %>
  <% end %>

  <% if time_session.errors.any? %>
    <div class="mt-2 rounded-lg border border-red-200 bg-red-50 p-2 text-xs text-red-700">
      <ul class="list-disc space-y-0.5 pl-4">
        <% time_session.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mt-2 flex items-center gap-2">
    <%= f.text_field :duration_string,
                     value: (time_clock_label(time_session.duration) if time_session.duration.to_i.positive?),
                     autofocus: true,
                     class: "#{field_classes} w-[76px] shrink-0 font-mono",
                     placeholder: t("#{scope_key}.duration_placeholder"),
                     aria: { label: t('views.organisations.time_sessions.show.duration_label') },
                     data: { time_session_form_target: 'durationInput', action: 'blur->time-session-form#formatDuration' } %>
    <span class="shrink-0 text-sm text-cream-600">h</span>
    <%= f.date_field :occurred_on,
                     value: time_session.occurred_on&.to_date || Date.current,
                     class: "#{field_classes} min-w-0 flex-1 cursor-pointer font-mono",
                     aria: { label: t('views.organisations.time_sessions.show.date_label') },
                     data: { action: 'click->time-session-form#openDatePicker' } %>
  </div>

  <div class="mt-2">
    <%= f.text_field :description,
                     class: "#{field_classes} w-full",
                     placeholder: t('views.organisations.time_sessions.show.description_label'),
                     aria: { label: t('views.organisations.time_sessions.show.description_label') } %>
  </div>

  <details class="group mt-2">
    <summary class="inline-flex cursor-pointer list-none items-center gap-1 text-[13px] text-cream-600 hover:text-cream-900">
      <span class="group-open:hidden"><%= t("#{scope_key}.more_fields") %></span>
      <span class="hidden group-open:inline"><%= t("#{scope_key}.hide_more_fields") %></span>
      <i class="bi bi-chevron-down text-[8px] transition-transform group-open:rotate-180"></i>
    </summary>
    <div class="mt-2">
      <%= f.label :tag_list, t('views.organisations.time_sessions.show.tags_label'),
                  class: 'block text-xs text-cream-600' %>
      <%= f.text_field :tag_list,
                       value: time_session.tag_list.join(', '),
                       class: "#{field_classes} mt-1 w-full",
                       placeholder: t("#{scope_key}.tags_placeholder") %>
    </div>
  </details>

  <div class="mt-3 flex h-8 items-center gap-3">
    <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, tag: :button, type: 'submit') do %>
      <%= editing ? t("#{scope_key}.submit_update") : t("#{scope_key}.submit") %>
    <% end %>
    <% if editing %>
      <%# Back to the new-entry form, not out of the popover. %>
      <%= link_to t("#{scope_key}.cancel"), subject_popover_path_for(@popover_subject),
                  class: 'text-[13px] text-cream-600 hover:text-cream-900',
                  data: { turbo_frame: "subject_time_popover_#{@popover_subject.id}" } %>
      <% if time_session.creator_id == current_user.id %>
        <%# Sits IN the row (ml-auto, right edge) but submits its own hidden
            form below via the form attribute — a nested form would be invalid
            HTML, and pulling a second form up over the row made the labels
            overlap. Destroy allows only the creator — mirrored here. %>
        <button type="submit"
                form="subject_time_delete_form"
                class="ml-auto shrink-0 text-[12px] text-red-700 hover:text-red-800"
                data-turbo-confirm="<%= t('views.confirm.delete_time_session') %>">
          <%= t("#{scope_key}.delete") %>
        </button>
      <% end %>
    <% else %>
      <button type="button"
              class="text-[13px] text-cream-600 hover:text-cream-900"
              data-action="click->neo-inline-popover#close">
        <%= t("#{scope_key}.cancel") %>
      </button>
    <% end %>
  </div>
<% end %>

<% if editing && time_session.creator_id == current_user.id %>
  <%# The delete button's form (see the form attribute above). Hidden: it holds
      only the method and the context. %>
  <%= form_with url: organisation_time_session_path(current_organisation, time_session),
                method: :delete, id: 'subject_time_delete_form', class: 'hidden' do %>
    <%= hidden_field_tag :context, 'subject_popover', id: 'subject_time_delete_context' %>
  <% end %>
<% end %>

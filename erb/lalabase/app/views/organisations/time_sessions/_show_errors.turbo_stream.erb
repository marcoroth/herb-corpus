<%= turbo_stream.update "time_session_errors" do %>
  <div class="rounded-lg bg-red-50 border border-stroke p-4">
    <div class="flex">
      <div class="ml-3">
        <h3 class="text-sm font-medium text-red-800">
          <span id="error_count"><%= t('views.organisations.time_sessions.show_errors.errors_count', count: time_session.errors.count) %></span> <%= t('views.organisations.time_sessions.show_errors.found_suffix') %>
        </h3>
        <div class="mt-2 text-sm text-red-700">
          <ul id="error_list" class="list-disc pl-5 space-y-1">
            <% time_session.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
<% end %>

<%= turbo_stream.remove_css_class "#time_session_errors", "hidden" %>
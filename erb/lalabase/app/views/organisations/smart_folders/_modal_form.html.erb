<%# app/views/smart_folders/_modal_form.html.erb %>
<div class="fixed inset-0 z-modal flex items-center justify-center bg-ink bg-opacity-60 hidden"
     data-modal-target="modal"
     data-action="click->modal#clickOutside">
  <div class="bg-surface-raised border border-cream-300 rounded-lg shadow-[4px_4px_0_0_#14110c] overflow-hidden w-11/12 md:w-3/4 lg:w-2/3 xl:w-1/2 max-h-[90vh] flex flex-col">
    <div class="px-4 py-3 flex justify-between items-center border-b border-cream-200">
      <h3 class="text-lg font-semibold text-cream-900">
        <%= smart_folder.persisted? ? t('smart_folders.edit') : t('smart_folders.new') %>
      </h3>
      <button type="button" class="text-cream-500 hover:text-cream-900 focus:outline-none"
              data-action="modal#close">
        <span class="sr-only">Schließen</span>
        <i class="bi bi-x-lg text-xl"></i>
      </button>
    </div>

    <div class="overflow-y-auto p-6 flex-grow">
      <div id="smart_folder_form_container">
        <%= render 'form', smart_folder: smart_folder %>
      </div>
    </div>
  </div>
</div>

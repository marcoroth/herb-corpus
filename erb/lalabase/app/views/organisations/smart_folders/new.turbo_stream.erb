<%# app/views/smart_folders/new.turbo_stream.erb %>
<%= turbo_stream.update "main" do %>
  <div class="container mx-auto px-4 py-6">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-semibold text-gray-900"><%= t('views.organisations.smart_folders.new.title') %></h1>
    </div>

    <%= render 'form', smart_folder: @smart_folder %>
  </div>
<% end %>

<%= turbo_stream.update "flash" do %>
  <%= render partial: "layouts/flash" %>
<% end %>
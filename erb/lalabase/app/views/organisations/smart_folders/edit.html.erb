<%# app/views/smart_folders/edit.html.erb %>
<% if params[:modal] %>
  <turbo-frame id="modal">
    <div class="fixed inset-0 z-modal flex items-center justify-center bg-ink bg-opacity-60"
         data-controller="smart-folder-modal"
         data-action="click->smart-folder-modal#closeBackground">
      <div class="bg-surface-raised border border-cream-300 rounded-lg shadow-[4px_4px_0_0_#14110c] overflow-hidden w-11/12 md:w-3/4 lg:w-2/3 xl:w-1/2 max-h-[90vh] flex flex-col">
        <div class="px-4 py-3 flex justify-between items-center border-b border-cream-200">
          <h3 class="text-lg font-semibold text-cream-900">
            <%= smart_folder_form_title(:edit, @smart_folder.target_object_type) %>
          </h3>
          <button type="button"
                  class="text-cream-500 hover:text-cream-900 focus:outline-none"
                  data-action="click->smart-folder-modal#close"
                  data-smart-folder-modal-target="closeButton">
            <span class="sr-only">Schließen</span>
            <i class="bi bi-x-lg text-xl"></i>
          </button>
        </div>

        <div class="overflow-y-auto p-6 flex-grow">
          <%= render 'form', smart_folder: @smart_folder %>
        </div>
      </div>
    </div>
  </turbo-frame>
<% else %>
  <div class="flex justify-between items-center mb-4">
    <h1 class="page-title">
      <%= smart_folder_form_title(:edit, @smart_folder.target_object_type) %>
    </h1>
  </div>

  <%= render 'form', smart_folder: @smart_folder %>

  <div class="mt-4">
    <%= render(Neo::Buttons::ButtonComponent.new(variant: :secondary, url: organisation_smart_folder_path(@current_organisation, @smart_folder))) { t('generic.back_to_details', default: 'Zurück zu Details') } %>
  </div>
<% end %>

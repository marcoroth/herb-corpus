<%# Quick-add: text-only (leicht anlegen). Priority is set per-row, not here. The
    input carries autofocus so Turbo focuses it when the drawer frame loads. %>
<%= form_with model: new_task,
              url: organisation_personal_tasks_path(current_organisation),
              class: "flex items-start gap-2" do |f| %>
  <div class="flex-1 min-w-0">
    <%= f.label :title, t('navigation.notizblock.add_label'), class: "sr-only" %>
    <%= f.text_field :title,
                     autofocus: true,
                     autocomplete: "off",
                     placeholder: t('navigation.notizblock.add_placeholder'),
                     "aria-label": t('navigation.notizblock.add_label'),
                     class: "w-full text-sm bg-white border border-cream-300 rounded px-3 py-2 text-cream-900 placeholder-cream-400 focus:outline-none focus:ring-2 focus:ring-lime-300 focus:border-ink" %>
    <% if new_task.errors[:title].present? %>
      <p class="mt-1 text-xs text-red-600"><%= new_task.errors[:title].first %></p>
    <% end %>
  </div>

  <%# Add = primary action -> lime (lime is for actions, never status). %>
  <%= button_tag type: "submit",
                 "aria-label": t('navigation.notizblock.add_submit'),
                 class: "shrink-0 w-9 h-9 flex items-center justify-center bg-lime-300 border border-ink rounded text-ink hover:shadow-[2px_2px_0_0_#14110c] transition-all" do %>
    <i class="bi bi-plus-lg"></i>
  <% end %>
<% end %>

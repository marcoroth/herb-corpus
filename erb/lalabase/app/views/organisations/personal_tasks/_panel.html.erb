<%# Inner content of the personal_tasks_panel frame. Re-rendered whole on every
    mutation (small single-user list) so the open/done split + empty state stay
    correct. @open_tasks / @done_tasks / @new_task come from the controller. %>
<div class="flex flex-col">
  <div class="p-3 border-b border-cream-200">
    <%= render "form", new_task: @new_task %>
  </div>

  <% if @open_tasks.empty? && @done_tasks.empty? %>
    <%= render "empty" %>
  <% else %>
    <%# The "Offen" heading only earns its place when there is ALSO a done section
        to distinguish it from — otherwise it would float above nothing. %>
    <% if @open_tasks.any? && @done_tasks.any? %>
      <p class="px-4 pt-3 pb-1 text-xs font-mono uppercase tracking-wider text-cream-500">
        <%= t('navigation.notizblock.open_heading') %>
      </p>
    <% end %>

    <% if @open_tasks.any? %>
      <ul class="divide-y divide-cream-200">
        <%= render partial: "personal_task", collection: @open_tasks, as: :task %>
      </ul>
    <% end %>

    <% if @done_tasks.any? %>
      <p class="px-4 pt-4 pb-1 text-xs font-mono uppercase tracking-wider text-cream-500">
        <%= t('navigation.notizblock.done_heading') %>
      </p>
      <ul class="divide-y divide-cream-200">
        <%= render partial: "personal_task", collection: @done_tasks, as: :task %>
      </ul>
    <% end %>
  <% end %>
</div>

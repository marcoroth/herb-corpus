<%# Drawer-scale empty state (§16): reuses the _empty_content vocabulary (cream
    icon-circle + title + subtitle) at drawer padding, not the page-scale partial. %>
<div class="px-6 py-10 text-center">
  <div class="w-12 h-12 mx-auto mb-3 bg-cream-100 border border-cream-300 rounded-full flex items-center justify-center">
    <i class="bi bi-journal-text text-xl text-cream-500"></i>
  </div>
  <p class="text-sm font-medium text-cream-700 mb-1"><%= t('navigation.notizblock.empty_title') %></p>
  <p class="text-xs text-cream-500 leading-relaxed max-w-[16rem] mx-auto">
    <%= t('navigation.notizblock.empty_subtitle') %>
  </p>
</div>

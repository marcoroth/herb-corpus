<%# One to-do row: toggle | title | priority flag (click cycles) | delete.
    Done rows are struck through + muted; the checkbox uses a NEUTRAL tick (lime
    is reserved for actions, not the done status). The three icon buttons share
    their geometry via personal_task_row_button_class — only the colour differs. %>
<li id="<%= dom_id(task) %>" class="flex items-center gap-1 px-3 py-1.5">
  <%= button_to organisation_personal_task_path(current_organisation, task),
                method: :patch, params: { toggle_completed: 1 }, form_class: "shrink-0",
                class: personal_task_row_button_class("text-cream-600 hover:text-ink hover:bg-cream-200"),
                "aria-label": task.completed? ? t('navigation.notizblock.reopen') : t('navigation.notizblock.complete') do %>
    <i class="bi <%= task.completed? ? 'bi-check-square text-cream-700' : 'bi-square' %> text-base"></i>
  <% end %>

  <span class="flex-1 min-w-0 text-sm truncate <%= 'line-through text-cream-400' if task.completed? %>">
    <%= task.title %>
  </span>

  <%= button_to organisation_personal_task_path(current_organisation, task),
                method: :patch, params: { personal_task: { priority: personal_task_next_priority(task) } },
                form_class: "shrink-0",
                class: personal_task_row_button_class("hover:bg-cream-200 #{personal_task_priority_classes(task)}"),
                "aria-label": t('navigation.notizblock.cycle_priority') do %>
    <i class="bi bi-flag<%= '-fill' if personal_task_priority_filled?(task) %> text-sm"></i>
  <% end %>

  <%= button_to organisation_personal_task_path(current_organisation, task),
                method: :delete, form_class: "shrink-0",
                class: personal_task_row_button_class("text-cream-400 hover:text-red-600 hover:bg-cream-200"),
                "aria-label": t('navigation.notizblock.delete') do %>
    <i class="bi bi-trash text-sm"></i>
  <% end %>
</li>

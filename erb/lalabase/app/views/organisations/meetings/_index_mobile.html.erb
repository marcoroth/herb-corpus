<%# locals: (list:, lane_form: nil) %>
<div class="meeting-mobile-grid list" data-column-picker-target="grid">
<%# Mobile: list OR full-screen detail with a back button (Tickets pattern).
    Frame ids identical to desktop so the search frame reload works on mobile.
    Shared by the project page and "Alle Meetings": list is the page's own head
    and results, and the way back leads to this page's list (MeetingList).
    lane_form: as in _index_desktop. %>
<% back_query = request.query_parameters.except('meeting_id', 'new', 'frame', 'frame_id', 'format') %>
<%= render NeoMobileTicketViewComponent.new(
  selected_item: @selected_meeting || lane_form.presence,
  show_detail: @selected_meeting.present? || lane_form.present?,
  back_url: meeting_list_index_path(back_query),
  back_label: t('views.organisations.meetings.index.mobile_list_view')
) do |mobile| %>
  <% mobile.with_list do %>
    <%= list %>
  <% end %>

  <% mobile.with_detail do %>
    <turbo-frame id="meeting_display_frame">
      <% if lane_form.present? %>
        <%= lane_form %>
      <% else %>
        <%= render 'organisations/meetings/display_meeting', selected_meeting: @selected_meeting %>
      <% end %>
    </turbo-frame>
  <% end %>
<% end %>

<%= render 'organisations/meetings/column_picker' %>
</div>

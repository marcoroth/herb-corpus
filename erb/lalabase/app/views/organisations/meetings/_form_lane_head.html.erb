<%# locals: (new_form:, project: @project) %>
<%# project: the project whose meetings index the lane belongs to
    (data-lane-index-url, lib/lane/filter_context). nil for the project select
    of "Alle Meetings": no project is chosen yet, and the form below it names
    its own (meetings/_meeting_new_for_frame). %>
<% icon_button = 'inline-flex h-8 w-8 items-center justify-center rounded-md text-cream-500 transition-colors hover:bg-cream-200 hover:text-cream-900 focus-visible:bg-cream-200 focus-visible:text-cream-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2' %>
<% close_url = meeting_list_index_path(meeting_list_state) %>
<div class="flex items-center gap-4 mb-2" data-lane-head<% if project %> data-lane-index-url="<%= organisation_project_meetings_path(@current_organisation, project) %>"<% end %>>
  <span class="hidden lg:inline font-mono text-[13px] tracking-wide text-cream-500">
    <%= t('views.organisations.meetings.show.type_label') %>
  </span>
  <% unless @viewport_mode == 'mobile' %>
    <% if new_form %>
      <a href="<%= close_url %>"
         class="inline-flex lg:hidden h-8 items-center gap-1 rounded-lg px-2 -ml-2 text-[13px] font-normal text-cream-600 transition-colors hover:bg-cream-100 hover:text-cream-900 focus-visible:bg-cream-100 focus-visible:text-cream-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink"
         data-form-lane-back
         data-turbo-frame="_top">
        <span aria-hidden="true">&lsaquo;</span>
        <%= t('views.organisations.meetings.index.mobile_list_view') %>
      </a>
    <% else %>
      <button type="button"
              class="inline-flex lg:hidden h-8 items-center gap-1 rounded-lg px-2 -ml-2 text-[13px] font-normal text-cream-600 transition-colors hover:bg-cream-100 hover:text-cream-900 focus-visible:bg-cream-100 focus-visible:text-cream-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink"
              data-action="click->layout-toggle#closeContent">
        <span aria-hidden="true">&lsaquo;</span>
        <%= t('views.organisations.meetings.index.mobile_list_view') %>
      </button>
    <% end %>
  <% end %>
  <div class="ml-auto">
    <% if new_form %>
      <a href="<%= close_url %>"
         class="<%= icon_button %> hidden lg:inline-flex"
         title="<%= t('views.organisations.meetings.show.close') %>"
         data-lane-close
         data-turbo-frame="_top">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </a>
    <% else %>
      <button type="button"
              class="<%= icon_button %> hidden lg:inline-flex"
              title="<%= t('views.organisations.meetings.show.close') %>"
              data-lane-close
              data-action="click->layout-toggle#closeContent">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </button>
    <% end %>
  </div>
</div>

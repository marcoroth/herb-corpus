<%# Live claim hints (Nachtrag: Teilnehmer-Claim). Local: matches — an array of
    Meetings::ParticipantClaimMatches::Match (may be nil/blank → renders nothing).
    Each group is an external participant name that equals an org member's, offered
    with Verknuepfen / Nicht verknuepfen. Both post to the org-level claims
    controller; the redirect back re-renders the (recomputed) hint. Sits OUTSIDE the
    results turbo-frame so a filter GET never wipes it.
    NB: do NOT start this comment with "locals:" — Rails would read it as the strict
    locals signature and choke on the prose. %>
<% if matches.present? %>
  <div class="mb-4 rounded-lg border border-cream-300 bg-cream-50 p-4">
    <div class="mb-2 flex items-center gap-2">
      <i class="bi bi-people text-cream-700"></i>
      <h2 class="text-sm font-bold text-cream-900"><%= t('views.organisations.meetings.claim.heading') %></h2>
    </div>
    <ul class="flex flex-col gap-2">
      <% matches.each do |match| %>
        <% claim_params = { user_id: match.user.id, normalized_name: match.normalized_name } %>
        <% link_form = { action: link_organisation_meeting_participant_claims_path(@current_organisation), method: :post, params: claim_params } %>
        <% reject_form = { action: reject_organisation_meeting_participant_claims_path(@current_organisation), method: :post, params: claim_params } %>
        <li class="flex flex-wrap items-center justify-between gap-2 text-sm">
          <span class="text-cream-800">
            <%= t('views.organisations.meetings.claim.suggestion_html', name: tag.strong(match.display_name), count: match.meeting_count) %>
          </span>
          <div class="flex shrink-0 items-center gap-2">
            <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, size: :small, form: link_form) do %>
              <%= t('views.organisations.meetings.claim.link') %>
            <% end %>
            <%= render Neo::Buttons::ButtonComponent.new(variant: :secondary, size: :small, form: reject_form) do %>
              <%= t('views.organisations.meetings.claim.dismiss') %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

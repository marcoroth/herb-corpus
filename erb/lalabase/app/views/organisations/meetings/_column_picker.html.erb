<%# locals: () %>
<%# The column picker panel of both meetings lists: the project page (@project)
    and "Alle Meetings" (@project nil), which offers the column "Projekt" too
    (ViewConfiguration.available_columns_for). %>
<%= render Neo::ColumnPickerComponent.new(
  available: @view_configuration.available_columns,
  chosen: @columns,
  editable: @active_smart_folder.nil? || policy(@active_smart_folder).update?,
  view_name: @active_smart_folder&.name || t('smart_folders.all_meetings'),
  fit: initial_column_fit(@columns.reject { |column| column[:required] }, content_open: @selected_meeting.present? || @new_meeting.present?),
  pinned_keys: @active_smart_folder&.pinned_column_keys || @view_configuration.pinned_column_keys,
  apply_all_url: meeting_columns_apply_all_url(organisation: @current_organisation, project: @project)
) %>

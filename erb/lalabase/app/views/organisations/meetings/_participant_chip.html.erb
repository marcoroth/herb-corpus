<%# One participant chip (Slice 1b). Single optik source (Design D6): confirmed
    chips rendered server-side AND the JS clone template both render THIS partial
    via NeoTagComponent — there is no second chip look to drift.

    locals: display_name, user_id (nil for external), participant_type
    (:project_member | :org_member | :external — Nachtrag: Teilnehmer-Kennzeichnung;
    drives variant/icon/tooltip via the shared style map). The chips-controller
    manages add/remove and, for parser suggestions, the dashed "unconfirmed" state.
    Hidden inputs post meeting[participants][][display_name] + [user_id] (unindexed
    array; Rails groups each display_name/user_id pair into one hash). %>
<% display_name = local_assigns[:display_name].to_s %>
<% user_id = local_assigns[:user_id] %>
<% chip_style = meeting_participant_chip_style(local_assigns.fetch(:participant_type, :external)) %>
<%= render NeoTagComponent.new(
      variant: chip_style[:variant],
      icon: chip_style[:icon],
      size: :medium,
      removable: true,
      title: chip_style[:title],
      class: 'meeting-participant-chip',
      data: {
        meeting_participants_target: 'chip',
        action: 'click->meeting-participants#confirmChip'
      }
    ) do %>
  <span data-chip-name><%= display_name %></span>
  <input type="hidden" name="meeting[participants][][display_name]"
         value="<%= display_name %>" data-chip-field="display_name">
  <input type="hidden" name="meeting[participants][][user_id]"
         value="<%= user_id %>" data-chip-field="user_id">
<% end %>

<%# locals: (meeting:, analyses:, can_write:, can_rerun: false, show_empty: true, **) %>
<%# show_empty: false when the caller already explains why the list is empty and cannot
    fill yet (creation off). "Nothing saved yet, assistant answers appear here" next to
    "the assistant is not available" would be two contradicting instructions. The wrapper
    div renders either way: it is the completion broadcast's target. %>
<div id="<%= meeting_analyses_list_id(meeting) %>">
  <% if analyses.any? %>
    <ul class="divide-y divide-cream-200 border-t border-cream-200 mb-4">
      <% analyses.each do |analysis| %>
        <%= render 'organisations/meetings/analysis', analysis: analysis, meeting: meeting, can_write: can_write, can_rerun: can_rerun %>
      <% end %>
    </ul>
  <% elsif show_empty %>
    <p class="border-t border-cream-200 pt-2 text-sm italic text-cream-500 mb-4">
      <%= t('views.organisations.meetings.analyses.empty_saved') %>
    </p>
  <% end %>
</div>

<%# locals: () %>
<%# The column picker's trigger in the filter bar's view tools, on both meetings
    lists (the project page and "Alle Meetings"). It opens the panel the page
    renders beside the list (meetings/_column_picker). %>
<button type="button"
        class="column-picker-trigger grid place-items-center h-7 w-7 rounded-md text-muted hover:text-heading hover:bg-cream-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-ink"
        data-column-picker-trigger
        data-action="click->column-picker#toggle"
        aria-expanded="false"
        aria-controls="<%= Neo::ColumnPickerComponent::ELEMENT_ID %>"
        title="<%= t('components.column_picker.trigger_title') %>">
  <i class="bi bi-sliders2 text-sm" aria-hidden="true"></i>
</button>

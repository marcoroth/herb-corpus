<div id="new_organisation_form">
  <%= form_with model: organisation, url: create_organisation_path, id: "new_organisation_form_inner" do |f| %>
    <div class="mb-4">
      <%= f.label :name, t('views.organisations.new_organisation_form.name_label'), class: "block text-sm font-bold uppercase tracking-tight mb-2" %>
      <%= f.text_field :name,
            class: "w-full px-4 py-3 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-lime-400 focus:border-stroke #{organisation.errors[:name].any? ? 'border-red-500 bg-red-50' : ''}",
            placeholder: t('views.organisations.new_organisation_form.name_placeholder'),
            autofocus: true,
            required: true %>
      <% if organisation.errors[:name].any? %>
        <div class="mt-2 text-sm text-red-600 font-medium new-organisation-error-container">
          <% organisation.errors[:name].each do |message| %>
            <p><%= message %></p>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="bg-lime-50 border-2 border-lime-300 rounded-lg p-4 text-sm text-lime-800 mb-4">
      <div class="flex items-start gap-2">
        <i class="bi bi-info-circle mt-0.5"></i>
        <p><%= t('views.organisations.new_organisation_form.admin_hint') %></p>
      </div>
    </div>

    <%# Decision guardrail at the point of action: orgs can't be merged later.
        Sits right above submit so it's the last thing read before "Anlegen" —
        far more effective here than as a permanent banner on the picker page. %>
    <div class="bg-amber-50 border-2 border-amber-300 rounded-lg p-4 text-sm text-amber-800 mb-4">
      <div class="flex items-start gap-2">
        <i class="bi bi-exclamation-triangle-fill mt-0.5"></i>
        <p><%= t('views.organisations.new_organisation_form.merge_warning_html') %></p>
      </div>
    </div>

    <%# D1: Abbrechen secondary, Anlegen primary — beide ButtonComponent (P4), size :large. %>
    <div class="flex justify-end gap-3">
      <%= render Neo::Buttons::ButtonComponent.new(variant: :secondary, size: :large,
            tag: :button, type: "button", data: { action: "click->new-organisation-modal#close" }) do %>
        <%= t('views.organisations.new_organisation_form.cancel') %>
      <% end %>
      <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, size: :large, tag: :button, type: "submit") do %>
        <%= t('views.organisations.new_organisation_form.submit') %>
      <% end %>
    </div>
  <% end %>
</div>

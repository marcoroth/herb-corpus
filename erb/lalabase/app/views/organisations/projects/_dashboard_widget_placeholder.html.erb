<%# Neutral live-view placeholder for a widget the viewer currently lacks rights to. Holds the
    slot (own config only) without naming the widget type — no structure leak. The edit-mode
    variant that names the type + offers removal is added with the editor (PR 2). %>
<%= render NeoCardComponent.new(variant: :surface, shadow: :none, padding: :small) do %>
  <div class="flex flex-col items-center justify-center text-center h-full py-8 text-cobalt-400">
    <i class="bi bi-lock text-2xl mb-2" aria-hidden="true"></i>
    <p class="text-sm font-medium"><%= t('dashboard.placeholder.unavailable') %></p>
  </div>
<% end %>

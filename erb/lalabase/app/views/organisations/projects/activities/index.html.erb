
<%# Turbo Frame for modal contents %>
<turbo-frame id="modal"></turbo-frame>

<div class="labor-layout-view <%= 'show-content' if @selected_detail_url %> hide-panel"
     data-controller="layout-toggle hover-arrows index-page"
     data-hover-arrows-layout-toggle-outlet=".labor-layout-view"
     data-layout-toggle-list-frame-ids-value='<%= ['activities-list'].to_json %>'
     data-layout-toggle-detail-frame-id-value="ticket_display_frame"
     data-layout-toggle-content-selector-value=".ticket-content, .note-content, .document-content, .meeting-content, #time-session-display"
     data-layout-toggle-selected-row-selector-value=".selected-row[data-activity-target-id]"
     data-layout-toggle-selection-params-value='<%= ['activity_id'].to_json %>'
     data-index-page-param-name-value="activity_id"
     data-index-page-frame-id-value="ticket_display_frame"
     data-index-page-content-selector-value=".ticket-content, .note-content, .document-content, .meeting-content, #time-session-display"
     data-index-page-placeholder-id-value="activity-display"
     data-index-page-placeholder-class-value="ticket-placeholder px-4"
     data-index-page-placeholder-title-value="<%= t('.placeholder_title') %>"
     data-index-page-placeholder-body-value="<%= t('.placeholder_body') %>"
     data-index-page-selected-row-selector-value=".selected-row[data-activity-target-id]"
     data-index-page-skip-if-content-visible-value="true"
     data-index-url="<%= organisation_project_activities_path(@current_organisation, @project) %>">
  <%= render NeoTwoColumnGridComponent.new(
    selected_item: @selected_activity,
    context_type: :activities,
    css_classes: "#{@selected_detail_url ? 'show-content' : 'hide-content'} hide-panel",
    additional_targets: { 'index-page-target' => 'layout' },
    chrome_height: NeoTwoColumnGridComponent::LANE_CHROME_HEIGHT_PX,
    lane: true
  ) do |grid| %>
    <% grid.with_list do %>
      <%= render NeoTitleBoxComponent.new(
        title: t('.title'),
        subtitle: @project.name,
        variant: :project
      ) %>

      <turbo-frame id="activity-filters">
        <%= render 'filter_section' %>
      </turbo-frame>

      <turbo-frame id="activities-list">
        <%= render 'activities_list' %>
      </turbo-frame>
    <% end %>

    <% grid.with_main_content do %>
      <%= render 'activity_lane' %>
    <% end %>
  <% end %>
</div>

<div class="mb-5 mt-6">
  <%= render NeoActivityFilterComponent.new(
    current_filters: {
      view: params[:view],
      area: params[:area],
      action_type: params[:action_type],
      actor_id: params[:actor_id],
      period: params[:period],
      date_from: params[:date_from],
      date_to: params[:date_to],
      q: params[:q]
    },
    filter_url: organisation_project_activities_path(@current_organisation, @project),
    result_count: @pagy&.count || @activities.size,
    project: @project
  ) %>
</div>

<%# Capped at the wide value while the lane is shut (layout.css, "Page widths"):
    glyph, sentence and clock time are one thing with one value, and the clock
    column ends on the cap. With the lane open the split replaces the cap. %>
<div class="width-capped--wide">
  <%= render NeoActivityTimelineComponent.new(activities: @activities, project: @project) %>

  <!-- Pagination -->
  <% if @pagy && @pagy.pages > 1 %>
    <div class="mt-6 pt-4 border-t border-cream-200">
      <%= render 'shared/pagination_nav', pagy: @pagy %>
    </div>
  <% end %>

  <!-- Empty State -->
  <% if @activities.empty? %>
    <div class="py-12 text-center">
      <div class="text-cream-500 mb-4">
        <i class="bi bi-activity text-4xl"></i>
      </div>
      <h3 class="text-lg font-bold text-cream-900 mb-2"><%= t('views.organisations.activities.shared.empty_title') %></h3>
      <p class="text-cream-600">
        <% filtered_params = params.except(:controller, :action, :organisation_id, :project_id) %>
        <% if filtered_params.keys.any? %>
          <%= t('views.organisations.activities.shared.empty_filtered') %>
          <%= link_to t('views.organisations.activities.shared.reset_filter'), organisation_project_activities_path(@current_organisation, @project),
                      class: "text-cream-800 hover:text-cream-900 underline" %>
        <% else %>
          <%= t('views.organisations.activities.shared.empty_none') %>
        <% end %>
      </p>
    </div>
  <% end %>
</div>

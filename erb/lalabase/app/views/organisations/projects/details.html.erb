<div class="labor-layout-view">
  <%# Hub-and-spoke: this subpage carries the name + description form; the
      settings page (edit) is a pure hub of cards. The header back button names
      its target (the settings hub) instead of a generic "back". %>
  <%= render NeoTitleBoxComponent.new(
    title: t('views.organisations.projects.details.title'),
    subtitle: @project.name,
    variant: :project
  ) do |c| %>
    <% c.with_right_content do %>
      <%= render Neo::Buttons::HeaderButtonComponent.new(
        variant: :secondary,
        icon: "arrow-left",
        label: t('views.organisations.projects.details.back_to_settings'),
        url: edit_organisation_project_path(@current_organisation, @project)
      ) %>
    <% end %>
  <% end %>

  <div class="mt-6">
    <%= render 'form', project: @project %>
  </div>
</div>

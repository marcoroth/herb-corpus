<div class="pt-6">
  <%= render NeoTitleBoxComponent.new(
    title: t('views.organisations.projects.new.title'),
    variant: :organisation
  ) do |c| %>
    <% c.with_right_content do %>
      <%= render Neo::Buttons::HeaderButtonComponent.new(
        variant: :secondary,
        icon: "arrow-left",
        label: t('views.organisations.projects.new.back'),
        url: organisation_projects_path(@current_organisation)
      ) %>
    <% end %>
  <% end %>

  <div class="mt-8">
    <%= render 'form', project: @project %>
  </div>
</div>

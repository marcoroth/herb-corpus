<div class="container mx-auto px-4 py-8 max-w-4xl">
  <div class="mb-6">
    <%= link_to organisation_project_project_repositories_path(@current_organisation, @project),
                class: "text-sm text-gray-600 hover:text-cream-900 inline-flex items-center gap-1" do %>
      <i class="bi bi-arrow-left"></i> <%= t('views.organisations.indexing.runs.back') %>
    <% end %>
    <h1 class="text-2xl font-bold mt-2"><%= t('views.organisations.indexing.runs.title') %></h1>
    <p class="text-sm text-gray-500 font-mono"><%= @repository.full_name %></p>
  </div>

  <% if @runs.any? %>
    <div class="bg-surface-raised border-2 border-stroke rounded-lg overflow-hidden shadow-[2px_2px_0_0_#000000]">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-100 border-b-2 border-stroke">
            <tr>
              <% %w[time trigger result duration scope commit].each do |col| %>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">
                  <%= t("views.organisations.indexing.runs.columns.#{col}") %>
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @runs.each do |run| %>
              <tr class="hover:bg-gray-50">
                <td class="px-3 py-2 whitespace-nowrap tabular-nums">
                  <%= run.finished_at.strftime('%d.%m.%Y %H:%M') %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap">
                  <%= t("views.organisations.indexing.runs.trigger.#{run.trigger}") %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap">
                  <% if run.failed? %>
                    <span class="inline-flex px-2 py-0.5 rounded text-xs font-bold bg-red-100 text-red-800 border border-red-300">
                      <%= t('views.organisations.indexing.runs.status.failed') %>
                    </span>
                  <% else %>
                    <span class="inline-flex px-2 py-0.5 rounded text-xs font-bold bg-green-100 text-green-800 border border-green-300">
                      <%= t('views.organisations.indexing.runs.status.ready') %>
                    </span>
                  <% end %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap tabular-nums text-gray-600">
                  <%= t('views.organisations.indexing.runs.duration', seconds: run.duration_seconds) if run.duration_seconds %>
                </td>
                <td class="px-3 py-2 text-gray-700">
                  <% if run.failed? %>
                    <span class="text-xs text-red-700"><%= run.error_message&.truncate(120) %></span>
                  <% elsif run.incremental? %>
                    <%= t('views.organisations.indexing.runs.scope.incremental',
                          files: run.files_count, added: run.symbols_added, removed: run.symbols_removed) %>
                  <% else %>
                    <%= t('views.organisations.indexing.runs.scope.full',
                          files: run.files_count, symbols: run.symbols_added) %>
                  <% end %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap font-mono text-xs text-gray-600">
                  <%= run.commit_sha&.first(8) || '—' %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="bg-surface-raised border-2 border-stroke rounded-lg p-8 text-center text-gray-500">
      <%= t('views.organisations.indexing.runs.empty') %>
    </div>
  <% end %>
</div>


<div class="labor-layout-view">
  <%= render NeoTitleBoxComponent.new(
    title: t('views.organisations.project_repositories.new.title'),
    subtitle: @project.name,
    variant: :project
  ) %>

  <div class="mt-6 max-w-3xl">
    <%= render Neo::Repository::ConnectComponent.new(
      project: @project,
      repositories: @project.project_repositories.order(:created_at),
      new_repository: @repository,
      current_organisation: @current_organisation,
      origin: @origin
    ) %>
  </div>
</div>

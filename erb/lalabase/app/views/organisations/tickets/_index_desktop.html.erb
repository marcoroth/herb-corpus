<%# The two views of the ticket page, the table and the board, on ONE grid:
    NeoTwoColumnGridComponent with the lane (doc/kanban_ticket_als_bahn_plan.md,
    rules 1 and 3). The list slot holds the head and the frame the filter bar
    reloads, the content slot the lane (_ticket_lane). One owner of the lane,
    the split, the close and the placeholder; the board used to be a
    hand-written twin grid with a slide-over of its own.
    kanban-layout stays as a marker on the board's grid for the two rules that
    are the board's own (the view switch stays while the lane is open; no
    column picker); every rule that kept the board OUT of the grid system is
    gone. %>
<% lane_state = @open_content || @selected_ticket ? 'show-content' : 'hide-content' %>
<div>
  <% if @view_mode == 'kanban' && @kanban_columns %>
    <%= render NeoTwoColumnGridComponent.new(
      selected_item: @selected_ticket,
      context_type: :tickets,
      css_classes: "kanban-layout #{lane_state} hide-panel",
      panel_close_title: t('views.organisations.tickets.meeting_panel.close'),
      additional_targets: { "index-page-target" => "layout" },
      chrome_height: NeoTwoColumnGridComponent::LANE_CHROME_HEIGHT_PX,
      lane: true
    ) do |grid| %>
      <% grid.with_list do %>
        <%= render 'organisations/tickets/list_head' %>
        <%# Board sits inside the tickets_list_frame so the filter bar can reload it
            (search / ad-hoc filters / search depth). See _kanban_list_frame. %>
        <%= render 'kanban_list_frame' %>
      <% end %>

      <% grid.with_main_content do %>
        <%= render 'organisations/tickets/ticket_lane' %>
      <% end %>

      <%# The meeting beside the ticket (doc/ticket_meeting_panel_plan.md): empty until a
          meeting of the open ticket is loaded into it; layout_toggle opens the lane on
          that load and empties it again on close. %>
      <% grid.with_panel do %>
        <%= turbo_frame_tag Organisations::TicketMeetingPanelsController::FRAME_ID %>
      <% end %>
    <% end %>
  <% else %>
    <%# Table/List-Layout: ohne Sidebar (Filter Bar ersetzt SmartFolder-Sidebar) %>
    <%= render NeoTwoColumnGridComponent.new(
      selected_item: @selected_ticket,
      context_type: :tickets,
      css_classes: "#{lane_state} hide-panel",
      panel_close_title: t('views.organisations.tickets.meeting_panel.close'),
      additional_targets: { "index-page-target" => "layout", "column-picker-target" => "grid" },
      chrome_height: NeoTwoColumnGridComponent::LANE_CHROME_HEIGHT_PX,
      lane: true
    ) do |grid| %>
      <% grid.with_list do %>
        <%# The selection (doc/ticket_bulk_edit_plan.md, slice 1) is mounted
            AROUND the head and the frame: the state must survive every reload
            of the list frame, and the selection row lives in the head's filter
            bar while the boxes live in the frame. Its state is never in the DOM;
            lib/ticket_selection.js holds it and the controller re-renders it
            after each turbo:frame-load. %>
        <% count_texts = I18n.t('views.organisations.tickets.selection.count') %>
        <% count_all_texts = I18n.t('views.organisations.tickets.selection.count_all') %>
        <div data-controller="ticket-selection"
             data-ticket-selection-frame-value="tickets_list_frame"
             data-ticket-selection-count-one-value="<%= count_texts[:one] %>"
             data-ticket-selection-count-other-value="<%= count_texts[:other] %>"
             data-ticket-selection-count-all-one-value="<%= count_all_texts[:one] %>"
             data-ticket-selection-count-all-other-value="<%= count_all_texts[:other] %>"
             data-ticket-selection-select-all-label-value="<%= t('views.organisations.tickets.selection.select_all', count: '%{count}') %>"
             data-ticket-selection-too-many-value="<%= t('views.organisations.tickets.selection.too_many', max: '%{max}') %>"
             data-ticket-selection-max-value="<%= Tickets::BulkSelection::MAX_TICKETS %>"
             data-ticket-selection-panel-url-value="<%= bulk_edit_organisation_project_tickets_path(@current_organisation, @project) %>"
             data-ticket-selection-display-frame-value="ticket_display_frame"
             data-action="ticket-bulk-panel:ready@window->ticket-selection#announce ticket-bulk-panel:close@window->ticket-selection#closePanel ticket-bulk-panel:draft@window->ticket-selection#storeDraft ticket-bulk-panel:done@window->ticket-selection#afterRun">
        <%# The head belongs to the list, so it lives in the list column: it
            ends at that column's right edge, and the lane beside it starts at
            the top of the content area instead of below a page-wide toolbar.
            Outside the frame it reloads, or a filter change would replace the
            control that triggered it. %>
        <%= render 'organisations/tickets/list_head' %>
        <turbo-frame id="tickets_list_frame">
          <%= render 'tickets_results',
                     tickets: @tickets,
                     pagy: @pagy,
                     sortable_header: true,
                     selected_ticket: @selected_ticket,
                     organisation: @current_organisation,
                     project: @project,
                     columns: @columns %>
        </turbo-frame>
        </div>
      <% end %>

      <%# The column picker (doc/spaltenwahl_plan.md S2), outside the list frame so it
          survives every reload; the trigger sits in the filter bar. %>
      <% grid.with_side_panel do %>
        <%= render Neo::ColumnPickerComponent.new(
              available: @view_configuration.available_columns,
              chosen: @columns,
              editable: @active_smart_folder.nil? || policy(@active_smart_folder).update?,
              view_name: @active_smart_folder&.name || t('smart_folders.all_tickets', default: 'Alle Tickets'),
              fit: initial_column_fit(@columns.reject { |c| c[:required] }, content_open: @open_content || @selected_ticket.present?),
              # Read from the same place Tickets::ResolveColumns reads it, so an
              # unticked column's pin is on screen and survives the next save.
              pinned_keys: @active_smart_folder&.pinned_column_keys || @view_configuration.pinned_column_keys,
              apply_all_url: apply_columns_to_all_organisation_project_view_configuration_path(@current_organisation, @project)) %>
      <% end %>

      <% grid.with_main_content do %>
        <%= render 'organisations/tickets/ticket_lane' %>
      <% end %>

      <%# The meeting beside the ticket (doc/ticket_meeting_panel_plan.md): empty until a
          meeting of the open ticket is loaded into it; layout_toggle opens the lane on
          that load and empties it again on close. %>
      <% grid.with_panel do %>
        <%= turbo_frame_tag Organisations::TicketMeetingPanelsController::FRAME_ID %>
      <% end %>

    <% end %>
  <% end %>
</div>

<%# The wrapper carries the ticket id and always renders: a reaction replaces it
    (PostReactionsController) once the ticket's notifications are read. %>
<span data-ticket-unread-for="<%= ticket.id %>"><%= render Neo::UnreadMarkerComponent.new(count: unread ? 1 : 0, variant: :dot, class: 'align-middle ml-0.5', label: t('tickets.has_unread_notifications')) %></span>

<%# The page that sent the request: its own counts and the ticket's dot in any list beside it. %>
<%= render 'notifications/unread_count_streams', unread_count: @unread_count.to_i %>
<%= turbo_stream.replace_all "[data-ticket-unread-for='#{@ticket.id}']",
                             partial: 'organisations/tickets/unread_indicator',
                             locals: { ticket: @ticket, unread: false } %>

<%# Wrapper partial for ticket_row_dynamic, used by the posts controller's streams.
    The columns come from the caller (TicketListColumns#ticket_list_columns); a caller
    without them gets the reader's saved list. %>
<% organisation = defined?(@current_organisation) ? @current_organisation : current_organisation %>
<% project = defined?(project) ? project : ticket.project %>
<% columns = local_assigns[:columns].presence ||
             Tickets::ResolveColumns.call(view_configuration: ViewConfiguration.for_user_project(current_user, project, 'tickets')) %>

<%= render "organisations/tickets/ticket_row_dynamic",
          ticket: ticket,
          selected_ticket: defined?(selected_ticket) ? selected_ticket : nil,
          smart_folder_id: defined?(smart_folder_id) ? smart_folder_id : nil,
          organisation: organisation,
          project: project,
          columns: columns %>

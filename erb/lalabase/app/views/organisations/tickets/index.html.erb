<%# Turbo-Cache-Control: completely disable cache for this page %>
<% content_for :head do %>
  <%# Completely disable Turbo cache for the tickets page %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<%# Turbo Frame for modal contents %>
<turbo-frame id="modal"></turbo-frame>

<div class="labor-layout-view <%= 'show-content' if @open_content %> hide-panel"
     <% if @viewport_mode == 'mobile' %>
       data-controller="viewport"
     <% else %>
       data-controller="layout-toggle hover-arrows index-page keyboard-navigation ticket-direct-navigation viewport column-picker"
     <% end %>
     data-viewport-breakpoint-value="1024"
     data-column-picker-frame-value="tickets_list_frame"
     data-column-picker-fixed-width-value="<%= ticket_list_fixed_width_px(@project) %>"
     data-column-picker-save-url-value="<%= @active_smart_folder ? columns_organisation_smart_folder_path(@current_organisation, @active_smart_folder) : columns_organisation_project_view_configuration_path(@current_organisation, @project) %>"
     data-column-picker-project-id-value="<%= @project.id %>"
     data-column-picker-editable-value="<%= @active_smart_folder.nil? || policy(@active_smart_folder).update? %>"
     data-column-picker-error-label-value="<%= t('components.column_picker.save_failed') %>"
     data-column-picker-moved-template-value="<%= t('components.column_picker.moved', name: '%{name}', position: '%{position}') %>"
     <%# The pin's caption in both states. The controller swaps them when the
         sign is pressed, so name and title never describe the state the column
         has just left. %>
     data-column-picker-pin-label-on-value="<%= t('components.column_picker.pin_label_on', name: '%{name}') %>"
     data-column-picker-pin-label-off-value="<%= t('components.column_picker.pin_label_off', name: '%{name}') %>"
     data-column-picker-pin-title-on-value="<%= t('components.column_picker.pinned') %>"
     data-column-picker-pin-title-off-value="<%= t('components.column_picker.pin') %>"
     data-hover-arrows-layout-toggle-outlet=".labor-layout-view"
     data-layout-toggle-list-frame-ids-value="<%= ['tickets_list_frame'].to_json %>"
     data-layout-toggle-selected-row-selector-value=".selected-row[data-ticket-id]"
     data-layout-toggle-selection-params-value="<%= ['ticket_id'].to_json %>"
     data-index-page-param-name-value="ticket_id"
     data-index-page-frame-id-value="ticket_display_frame"
     data-index-page-content-selector-value=".ticket-content"
     data-index-page-placeholder-id-value="ticket-display"
     data-index-page-placeholder-class-value="ticket-placeholder"
     data-index-page-placeholder-title-value="<%= t('views.organisations.tickets.index.placeholder_title') %>"
     data-index-page-placeholder-body-value="<%= t('views.organisations.tickets.index.placeholder_body') %>"
     data-index-page-skip-params-value="from_notification"
     data-index-page-skip-param-equals-value="source:email"
     data-index-page-selected-row-selector-value=".selected-row[data-ticket-id]"
     data-index-page-skip-if-content-visible-value="true"
     data-viewport-current-mode-value="<%= @viewport_mode %>"
     data-project-id="<%= @project.id %>"
     <%# The ONE index address of this page, read by ticket-row (row and card
         alike, with closest) to build the canonical address of an open ticket,
         and by index-page to normalise a deep link (doc/kanban_ticket_als_bahn_plan.md,
         section 4.2, D7). %>
     data-index-url="<%= organisation_project_tickets_path(@current_organisation, @project) %>"
     data-lane-params="<%= lane_params_json(selection: %w[ticket_id]) %>"
     id="ticket-index-container">
  <% if @viewport_mode == 'mobile' %>
    <%= render 'organisations/tickets/index_mobile' %>
  <% else %>
    <%= render 'organisations/tickets/index_desktop' %>
  <% end %>
</div>

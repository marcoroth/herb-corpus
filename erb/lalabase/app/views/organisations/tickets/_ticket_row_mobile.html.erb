<li class="mobile-ticket-row" data-ticket-id="<%= ticket.id %>">
  <% if ticket_list_selectable?(project) %>
    <label class="mobile-ticket-check">
      <input type="checkbox" value="<%= ticket.id %>" data-ticket-selection-target="box" data-action="click->ticket-selection#toggle" aria-label="<%= t('views.organisations.tickets.selection.box_label', number: ticket.number) %>">
    </label>
  <% end %>
  <div class="mobile-ticket-content">
    <%= link_to ticket.title, mobile_ticket_link(ticket), class: 'mobile-ticket-title', data: { turbo_frame: '_top', action: 'click->mobile-ticket-list#openTicket' } %>
    <div class="mobile-ticket-meta">
      <span class="font-mono">#<%= ticket.number %></span>
      <%= ticket_waiting_mark(ticket) %>
      <span class="mobile-ticket-status"><% status = ticket.get_custom_attribute('status') %><i class="<%= resolve_status_dot_color(ticket, status.to_s) %>" aria-hidden="true"></i><%= status.present? ? custom_attribute_text(ticket, 'status', status) : t('mobile.no_status') %></span>
      <% people = viewer_ordered_users(ticket.assignees) %>
      <% if people.many? %>
        <details class="mobile-ticket-people"><summary><%= viewer_display_name(people.first) %> +<%= people.size - 1 %></summary><%= people.map { |person| viewer_display_name(person) }.join(', ') %></details>
      <% else %>
        <span><%= people.first ? viewer_display_name(people.first) : t('mobile.unassigned') %></span>
      <% end %>
      <% if mobile_time_visible?(project) %><span class="mobile-ticket-time font-mono"><%= TimeSession.format_duration(ticket_time_totals(ticket)[:minutes]) %></span><% end %>
    </div>
  </div>
</li>

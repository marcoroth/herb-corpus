<%# One sub-task row. Shared by the section's list AND the quick-add Turbo Stream (append) so the
    appended row is byte-identical to a page-rendered one. Locals: child, project, org, status_def. %>
<li class="flex items-center gap-3 px-3 py-2">
  <span class="font-mono text-xs text-cream-500 tabular-nums">#<%= child.number %></span>
  <%= link_to child.title,
              organisation_project_tickets_path(org, project, ticket_id: child.id),
              class: "flex-1 truncate text-sm text-cream-900 hover:underline" %>
  <% status_value = child.get_custom_attribute('status') %>
  <% if status_value.present? %>
    <span class="h-6 shrink-0 rounded-full border border-cream-300 px-2 text-xs leading-6 text-cream-700">
      <%= status_def&.display_value(status_value) || status_value %>
    </span>
  <% end %>
</li>

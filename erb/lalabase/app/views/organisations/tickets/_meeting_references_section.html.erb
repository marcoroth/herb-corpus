<%# locals: (ticket:) %>
<%# "Gespräche" backlinks on the ticket detail
    (Gespräche Slice 3): meetings that link TO this ticket. Sits between the
    sub-tasks section and the comment timeline, styled after _subtasks_section.

    GATE (here, per meeting, Tickets::LinkedMeetings): a meeting shows only to
    people who may read meetings in the MEETING's project, and its link names that
    project.
    A ticket moved to another project keeps its meeting links, so the ticket's
    project answers neither question. Somebody who may read none of the meetings
    does not learn that links exist: the section renders nothing without an entry,
    so it never appears empty.

    No tombstones on this side: a meeting owns its outgoing link (dependent:
    :destroy), so a backlink's source meeting always exists. %>
<% meetings = Tickets::LinkedMeetings.call(ticket: ticket, user: current_user).to_a %>
<% if meetings.any? %>
  <section id="meeting-references-<%= ticket.id %>" class="meeting-references-section mb-6">
    <ul class="divide-y divide-cream-200 overflow-hidden rounded-lg bg-cream-50">
      <% meetings.each do |meeting| %>
        <li class="flex items-center gap-3 px-3 py-2">
          <i class="bi bi-chat-quote shrink-0 text-xs text-cream-500" aria-hidden="true"></i>
          <%# How an entry opens depends on the page around the ticket, and only the
              owner of turbo-frame#ticket_display_frame knows that page: it names it in
              data-meeting-links (panel: the list and the board, the meeting opens beside
              the ticket; text: the inbox pane, no link; page: the phone, the meetings
              page). Eight writers re-render this frame, several of them without knowing
              which page asked, so every entry carries the three forms and
              components/ticket_meeting_panel.css shows the one the frame names. Without
              a name it is page, the form that works everywhere.
              _top on the page link: this section renders inside ticket_display_frame,
              and the meetings page has no frame with that id. %>
          <% meeting_page = organisation_project_meetings_path(@current_organisation, meeting.project, meeting_id: meeting.id) %>
          <%= link_to meeting.title,
                      organisation_project_ticket_meeting_panel_path(@current_organisation, ticket.project, ticket, meeting_id: meeting.id),
                      class: 'meeting-reference meeting-reference--panel flex-1 truncate text-sm text-cream-900 hover:underline',
                      data: { turbo_frame: Organisations::TicketMeetingPanelsController::FRAME_ID } %>
          <span class="meeting-reference meeting-reference--text flex-1 truncate text-sm text-cream-900"><%= meeting.title %></span>
          <%= link_to meeting.title, meeting_page,
                      class: 'meeting-reference meeting-reference--page flex-1 truncate text-sm text-cream-900 hover:underline',
                      data: { turbo_frame: '_top' } %>
          <span class="shrink-0 font-mono text-xs tabular-nums text-cream-500">
            <%= l(meeting.occurred_at.to_date, format: :default) %>
          </span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

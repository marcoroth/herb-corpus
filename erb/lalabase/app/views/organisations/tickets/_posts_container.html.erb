<%# Container for the ticket timeline. Since T4 this partial no longer keeps
    its own copy of the item loop: posts#create replaces this container as a
    whole, and that copy used to wipe the chip row and the sub-tasks section
    living inside the frame. Both writers now render the SAME
    _timeline_frame_content (the lazy load goes through timeline.html.erb).
    Locals: ticket, timeline_items, project, current_organisation %>
<div class="posts-container mb-4" id="posts-container-<%= ticket.id %>">
  <%= turbo_frame_tag "ticket-timeline-#{ticket.id}" do %>
    <%= render 'organisations/tickets/timeline_frame_content',
               timeline_items: timeline_items,
               ticket: ticket,
               project: project || @project,
               current_organisation: current_organisation || @current_organisation,
               current_user: current_user %>
  <% end %>
</div>

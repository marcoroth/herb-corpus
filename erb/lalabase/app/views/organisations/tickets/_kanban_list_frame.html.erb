<%# Kanban board wrapped in the shared tickets_list_frame.
    The filter bar (search, ad-hoc filters, search depth) navigates by reloading
    this frame (NeoFilterBarComponent frame_id: 'tickets_list_frame'). Without the
    frame the board would never reload on those interactions — search appeared
    broken in board mode. display:contents (.kanban-frame) keeps the frame
    layout-transparent so the board's height/scroll behaviour is unchanged. %>
<turbo-frame id="tickets_list_frame" class="kanban-frame">
  <%= render 'kanban_board' %>
</turbo-frame>

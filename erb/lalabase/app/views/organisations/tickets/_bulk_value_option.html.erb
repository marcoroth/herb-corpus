<%# locals: (value:, label:) %>
<%# One value of a multi row's layer, with its three-state box and the number
    of selected tickets that carry it. Also the prototype the panel clones
    for a tag the last run created (ticket_bulk_panel_controller#offerCreatedValues). %>
<button type="button" role="option" class="tbp-option"
        data-action="click->ticket-bulk-panel#cycleValue"
        data-value="<%= value %>"
        data-label="<%= label %>"
        data-search="<%= label.to_s.downcase %>">
  <span class="tbp-tri" data-tri aria-hidden="true"></span>
  <span class="min-w-0 flex-1 truncate" data-option-label><%= label %></span>
  <span class="text-xs text-muted" data-count></span>
</button>

<%# The save was refused (a cycle, an existing relation, no ticket picked, ...): the modal
    again, with the message and what was sent, in place of the instance that sent it. A modal
    closed meanwhile has no such element and stays closed (review of #944).
    Without a usable token there is no instance to fill, and filling the frame would open a
    modal the user may have closed: the reason goes out as a flash (a request in flight
    during a deploy, or a tampered token). %>
<% if @modal_token %>
  <%= turbo_stream.replace ticket_relation_modal_instance_id(@ticket, @modal_token) do %>
    <%= render 'organisations/tickets/relations/modal',
               ticket: @ticket, token: @modal_token, kind: @kind, delay_days: @delay_days,
               other_ticket: @other_ticket, errors: @errors %>
  <% end %>
<% else %>
  <%= turbo_stream.prepend 'flash', partial: 'layouts/flash', locals: { flash: { alert: @errors.to_sentence } } %>
<% end %>

<%# The lane's frame, the ONE owner of what the frame holds on a page load
    (doc/kanban_ticket_als_bahn_plan.md, section 4.1): the ticket in place, or
    the placeholder. Rendered by both branches of _index_desktop, the table and
    the board, and alone (layout: false) for a Turbo-Frame request of
    ticket_display_frame, the fast path a row or card click takes. %>
<turbo-frame id="ticket_display_frame">
  <% if @selected_ticket %>
    <%= render 'organisations/tickets/ticket_display',
               ticket: @selected_ticket,
               post: @post || Post.new(ticket: @selected_ticket, user: current_user),
               project: @project,
               current_organisation: @current_organisation %>
  <% else %>
    <%# ⚠️ Keys fully qualified. Lazy t('.') in THIS partial resolves to
        organisations.tickets.ticket_lane.*, which does not exist, so the page
        would show "Select Task Title" - the humanised key name. It went
        unnoticed for as long as it did because a shut lane was display:none;
        since the lane stays in the layout to slide, the placeholder can be
        seen. (The P3 lesson again: a lazy lookup in a partial answers to the
        PARTIAL's name.) %>
    <div id="ticket-display" class="ticket-placeholder px-4">
      <h1><%= t('organisations.tickets.index.select_task_title') %></h1>
      <p><%= t('organisations.tickets.index.select_task_description') %></p>
    </div>
  <% end %>
</turbo-frame>

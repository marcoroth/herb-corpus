<%# locals: (ticket_label:, meeting_label:) %>
<%# The narrow stage (doc/ticket_meeting_panel_plan.md, S2): ticket and meeting as two tabs
    in one column, the way back to the ticket in both answers of the panel (the meeting,
    and "not available"). Hidden at the other stages (components/ticket_meeting_panel.css).
    Two buttons that say which one is in front (aria-pressed), not an ARIA tab widget:
    the two columns are not tab panels of this bar, and a half-built tablist promises
    arrow keys it does not have. ticket_meeting_panel_controller keeps the state. %>
<div class="ticket-meeting-panel__stage-tabs" role="group"
     aria-label="<%= t('views.organisations.tickets.meeting_panel.stage_tabs_label') %>">
  <button type="button" class="ticket-meeting-panel__stage-tab" aria-pressed="false"
          data-ticket-meeting-panel-target="ticketTab" data-action="ticket-meeting-panel#showTicket">
    <%= ticket_label %>
  </button>
  <button type="button" class="ticket-meeting-panel__stage-tab" aria-pressed="true"
          data-ticket-meeting-panel-target="meetingTab" data-action="ticket-meeting-panel#showMeeting">
    <%= meeting_label %>
  </button>
</div>

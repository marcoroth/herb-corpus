<%# Modal for moving a ticket %>
<% current_organisation = @current_organisation || ticket.project.organisation %>
<% project = @project || ticket.project %>

<turbo-frame id="move-ticket-modal-frame">
  <div class="p-5">
    <h3 class="text-lg font-bold mb-4 text-cream-900"><%= t('.title') %></h3>

    <% if target_projects.empty? %>
      <p class="text-cream-600 text-sm"><%= t('.no_target_projects') %></p>
      <div class="flex justify-end mt-4">
        <button type="button"
                class="h-9 px-4 text-sm bg-cream-100 hover:bg-cream-200 border border-cream-300 rounded font-medium text-cream-800"
                data-action="click->move-ticket-modal#close">
          <%= t('.cancel') %>
        </button>
      </div>
    <% else %>
      <%# Project selection %>
      <div class="mb-4">
        <label for="target_project_id" class="block text-sm font-medium text-cream-800 mb-1">
          <%= t('.select_project') %>
        </label>
        <select id="target_project_id"
                name="target_project_id"
                class="w-full bg-surface-raised border border-cream-300 rounded px-3 py-2 text-sm focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink"
                data-move-ticket-modal-target="projectSelect"
                data-action="change->move-ticket-modal#projectChanged">
          <option value=""><%= t('.select_project_placeholder') %></option>
          <% target_projects.each do |tp| %>
            <option value="<%= tp.id %>"><%= tp.name %></option>
          <% end %>
        </select>
      </div>

      <%# Impact area (loaded via Turbo Frame) %>
      <turbo-frame id="move-ticket-impact"
                   data-move-ticket-modal-target="impactFrame"
                   class="block min-h-[40px]">
      </turbo-frame>

      <%# Buttons %>
      <div class="flex justify-end gap-2 mt-4 pt-3 border-t border-cream-200">
        <button type="button"
                class="h-9 px-4 text-sm bg-cream-100 hover:bg-cream-200 border border-cream-300 rounded font-medium text-cream-800"
                data-action="click->move-ticket-modal#close">
          <%= t('.cancel') %>
        </button>

        <%= form_with url: move_organisation_project_ticket_path(current_organisation, project, ticket),
                      method: :post,
                      class: "inline",
                      data: { turbo_frame: "_top" } do |f| %>
          <input type="hidden" name="target_project_id" id="move_target_project_id" value=""
                 data-move-ticket-modal-target="hiddenProjectId">
          <button type="submit"
                  class="h-9 px-4 text-sm bg-lime-300 text-ink hover:bg-lime-400 border border-ink rounded font-bold disabled:opacity-50 disabled:cursor-not-allowed"
                  data-move-ticket-modal-target="submitButton"
                  disabled>
            <i class="bi bi-arrow-right-square mr-1"></i>
            <%= t('.confirm') %>
          </button>
        <% end %>
      </div>
    <% end %>
  </div>
</turbo-frame>

<turbo-frame id="move-ticket-impact">
  <% if error.present? %>
    <div class="rounded border-2 border-red-300 bg-red-50 p-3 text-sm text-red-700">
      <i class="bi bi-exclamation-triangle mr-1"></i>
      <%= error %>
    </div>
  <% elsif impact.present? %>
    <div class="space-y-2 text-sm">
      <%# Neue Ticketnummer %>
      <div class="rounded border border-cream-300 bg-cream-50 p-3">
        <i class="bi bi-hash mr-1 text-cream-600"></i>
        <%= t('.new_number', number: impact[:new_number]) %>
      </div>

      <%# Entfernte Assignments %>
      <% if impact[:lost_assignments].any? %>
        <div class="rounded border-2 border-amber-300 bg-amber-50 p-3">
          <p class="font-medium text-amber-800 mb-1">
            <i class="bi bi-person-dash mr-1"></i>
            <%= t('.lost_assignments_warning') %>
          </p>
          <ul class="list-disc list-inside text-amber-700 ml-1">
            <% impact[:lost_assignments].each do |assignment| %>
              <li><%= assignment[:user_name] %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# Entfernte Subscriptions %>
      <% if impact[:lost_subscriptions].any? %>
        <div class="rounded border-2 border-amber-300 bg-amber-50 p-3">
          <p class="font-medium text-amber-800 mb-1">
            <i class="bi bi-bell-slash mr-1"></i>
            <%= t('.lost_subscriptions_warning') %>
          </p>
          <ul class="list-disc list-inside text-amber-700 ml-1">
            <% impact[:lost_subscriptions].each do |subscription| %>
              <li><%= subscription[:user_name] %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# TimeSessions Info %>
      <% if impact[:time_sessions_count] > 0 %>
        <div class="rounded border border-cream-300 bg-cream-50 p-3">
          <i class="bi bi-clock mr-1 text-cream-600"></i>
          <%= t('.time_sessions_info', count: impact[:time_sessions_count]) %>
        </div>
      <% end %>

      <%# Keine Auswirkungen %>
      <% if impact[:lost_assignments].empty? && impact[:lost_subscriptions].empty? %>
        <div class="rounded border border-green-300 bg-green-50 p-3 text-green-700">
          <i class="bi bi-check-circle mr-1"></i>
          <%= t('.no_impact') %>
        </div>
      <% end %>
    </div>
  <% end %>
</turbo-frame>

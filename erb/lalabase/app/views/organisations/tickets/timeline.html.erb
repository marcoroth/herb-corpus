<%= turbo_frame_tag "ticket-timeline-#{@ticket.id}" do %>
  <%# The frame's whole inner body lives in ONE shared partial since T4:
      posts#create replaces the surrounding container, and a second copy of
      this loop there used to wipe the chip row and the sub-tasks section on
      every saved comment. %>
  <%= render 'organisations/tickets/timeline_frame_content',
             timeline_items: @timeline_items,
             ticket: @ticket,
             project: @project,
             current_organisation: @current_organisation,
             current_user: current_user %>
<% end %>

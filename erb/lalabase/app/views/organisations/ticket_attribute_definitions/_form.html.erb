<%= form_with model: [@current_organisation, @project, attribute],
              local: true,
              data: { controller: "attribute-form" } do |form| %>

  <% if attribute.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded p-4 mb-6">
      <h3 class="font-semibold text-red-800 mb-2">
        <%= t('views.organisations.ticket_attribute_definitions.form.errors_prevent_save', count: attribute.errors.count) %>
      </h3>
      <ul class="list-disc list-inside text-red-700">
        <% attribute.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% has_options = %w[select multiselect].include?(attribute.field_type) %>

  <div class="flex gap-6">
    <%# Left column: settings %>
    <div class="<%= has_options ? 'w-1/2' : 'flex-1' %> min-w-0 space-y-6">
      <!-- Base information -->
      <div class="space-y-4">
        <!-- Field Type -->
        <div>
          <%= form.label :field_type, t('views.organisations.ticket_attribute_definitions.form.field_type_label'), class: "block text-sm font-medium text-cream-800 mb-2" %>
          <%= form.select :field_type,
              options_for_select(TicketAttributeDefinition::FIELD_TYPES.map { |type|
                [t("attribute_types.#{type}", default: type.humanize), type]
              }, attribute.field_type),
              { prompt: t('views.organisations.ticket_attribute_definitions.form.field_type_prompt') },
              class: "w-full px-4 py-2 bg-surface-raised border border-cream-300 rounded-lg focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink",
              data: { action: "change->attribute-form#updateFieldOptions" } %>
        </div>
      </div>

      <!-- Label (Mehrsprachig) -->
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= form.label :label_de, t('views.organisations.ticket_attribute_definitions.form.label_de'), class: "block text-sm font-medium text-cream-800 mb-2" %>
          <%= text_field_tag "ticket_attribute_definition[labels][de]",
              attribute.labels&.dig("de"),
              class: "w-full px-4 py-2 bg-surface-raised border border-cream-300 rounded-lg focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink",
              placeholder: t('views.organisations.ticket_attribute_definitions.form.label_de_placeholder') %>
        </div>

        <div>
          <%= form.label :label_en, t('views.organisations.ticket_attribute_definitions.form.label_en'), class: "block text-sm font-medium text-cream-800 mb-2" %>
          <%= text_field_tag "ticket_attribute_definition[labels][en]",
              attribute.labels&.dig("en"),
              class: "w-full px-4 py-2 bg-surface-raised border border-cream-300 rounded-lg focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink",
              placeholder: t('views.organisations.ticket_attribute_definitions.form.label_en_placeholder') %>
        </div>
      </div>

      <!-- Validations -->
      <div class="border-t border-cream-200 pt-6">
        <h3 class="text-lg font-bold text-cream-900 mb-4"><%= t('views.organisations.ticket_attribute_definitions.form.validations_heading') %></h3>

        <!-- Required -->
        <div class="flex items-center mb-4">
          <%= check_box_tag "ticket_attribute_definition[validation_rules][required]",
              "true",
              attribute.validation_rules&.dig("required") == "true",
              class: "w-4 h-4 text-lime-600 border border-cream-300 rounded focus:ring-ink" %>
          <%= label_tag "ticket_attribute_definition[validation_rules][required]", t('views.organisations.ticket_attribute_definitions.form.required_label'), class: "ml-2 text-sm font-medium text-cream-800" %>
        </div>

        <!-- Deadline marker (date fields only): marks this date as the project's "due date" -->
        <div data-attribute-form-target="deadlineSection"
             class="flex items-center mb-4 <%= 'hidden' unless attribute.field_type == 'date' %>">
          <%# hidden 0 so unchecking actually clears the marker (check_box_tag sends nothing when off) %>
          <%= hidden_field_tag "ticket_attribute_definition[deadline]", "0" %>
          <%= check_box_tag "ticket_attribute_definition[deadline]", "1",
              attribute.respond_to?(:deadline?) && attribute.deadline?,
              class: "w-4 h-4 text-lime-600 border border-cream-300 rounded focus:ring-ink" %>
          <%= label_tag "ticket_attribute_definition[deadline]", t('views.organisations.ticket_attribute_definitions.form.deadline_label'), class: "ml-2 text-sm font-medium text-cream-800" %>
        </div>

        <!-- Min/Max Length (for text) -->
        <div data-attribute-form-target="lengthValidation"
             class="grid grid-cols-2 gap-4 <%= 'hidden' unless attribute.field_type == 'text' %>">
          <div>
            <%= label_tag "ticket_attribute_definition[validation_rules][min_length]", t('views.organisations.ticket_attribute_definitions.form.min_length_label'), class: "block text-sm font-medium text-cream-800 mb-2" %>
            <%= number_field_tag "ticket_attribute_definition[validation_rules][min_length]",
                attribute.validation_rules&.dig("min_length"),
                class: "w-full px-4 py-2 bg-surface-raised border border-cream-300 rounded-lg focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink",
                min: 0 %>
          </div>
          <div>
            <%= label_tag "ticket_attribute_definition[validation_rules][max_length]", t('views.organisations.ticket_attribute_definitions.form.max_length_label'), class: "block text-sm font-medium text-cream-800 mb-2" %>
            <%= number_field_tag "ticket_attribute_definition[validation_rules][max_length]",
                attribute.validation_rules&.dig("max_length"),
                class: "w-full px-4 py-2 bg-surface-raised border border-cream-300 rounded-lg focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink",
                min: 1 %>
          </div>
        </div>

      </div>

      <!-- Display Settings -->
      <div class="border-t border-cream-200 pt-6">
        <h3 class="text-lg font-bold text-cream-900 mb-4"><%= t('views.organisations.ticket_attribute_definitions.form.more_settings_heading') %></h3>

        <div class="grid grid-cols-2 gap-4 mb-4">
          <!-- Section -->
          <div>
            <%= form.label :section, t('views.organisations.ticket_attribute_definitions.form.section_label'), class: "block text-sm font-medium text-cream-800 mb-2" %>
            <%= form.text_field :section,
                class: "w-full px-4 py-2 bg-surface-raised border border-cream-300 rounded-lg focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink",
                placeholder: t('views.organisations.ticket_attribute_definitions.form.section_placeholder') %>
            <p class="mt-1 text-sm text-cream-600">
              <%= t('views.organisations.ticket_attribute_definitions.form.section_hint') %>
            </p>
          </div>

          <!-- Width -->
          <div>
            <%= form.label :width, t('views.organisations.ticket_attribute_definitions.form.width_label'), class: "block text-sm font-medium text-cream-800 mb-2" %>
            <%= form.select :width,
                options_for_select([
                  [t('views.organisations.ticket_attribute_definitions.form.width_full'), "full"],
                  [t('views.organisations.ticket_attribute_definitions.form.width_half'), "half"],
                  [t('views.organisations.ticket_attribute_definitions.form.width_third'), "third"]
                ], attribute.width),
                {},
                class: "w-full px-4 py-2 bg-surface-raised border border-cream-300 rounded-lg focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink" %>
          </div>
        </div>

        <!-- Active -->
        <div class="flex items-center">
          <%= form.check_box :active,
              checked: attribute.new_record? ? true : attribute.active,
              class: "w-4 h-4 text-lime-600 border border-cream-300 rounded focus:ring-ink" %>
          <%= form.label :active, t('views.organisations.ticket_attribute_definitions.form.active_label'), class: "ml-2 text-sm font-medium text-cream-800" %>
        </div>
      </div>
    </div>

    <%# Right column: options (only for select, multiselect) %>
    <div data-attribute-form-target="optionsContainer"
         class="w-1/2 min-w-0 <%= 'hidden' unless has_options %>">
      <div class="flex items-center gap-2 mb-4">
        <h3 class="text-lg font-bold text-cream-900"><%= t('views.organisations.ticket_attribute_definitions.form.options_heading') %></h3>
        <button type="button"
                data-action="click->attribute-form#toggleSystemFunctions"
                data-attribute-form-target="systemFunctionsToggle"
                class="inline-flex items-center gap-1 px-2 py-0.5 text-xs text-cream-500 hover:text-cream-900 rounded hover:bg-cream-100 transition-colors"
                title="System-Funktionen ein-/ausblenden">
          <i class="bi bi-gear"></i>
        </button>
      </div>
      <div data-attribute-form-target="optionsList" class="space-y-3">
        <%
          # Extract options, colors and system_functions from existing data
          options_data = if attribute.options.is_a?(Hash) && attribute.options['allowed_values']
            attribute.options['allowed_values'].map do |v|
              {
                value: v['value'] || v['labels']&.dig('de'),
                color: TicketAttributeDefinition.safe_option_color(v['color'], TicketAttributeDefinition::OPTION_COLOR_FALLBACK),
                system_functions: v['system_functions'] || []
              }
            end
          else
            (attribute.options || []).map { |opt| { value: opt, color: TicketAttributeDefinition::OPTION_COLOR_FALLBACK, system_functions: [] } }
          end
        %>

        <% options_data.each_with_index do |option_data, index| %>
          <div class="option-item" data-option-index="<%= index %>">
            <%# Row 1: core elements %>
            <div class="flex gap-2 items-center">
              <span class="drag-handle cursor-grab text-cream-500 hover:text-cream-700 px-1"><i class="bi bi-grip-vertical text-lg"></i></span>

              <input type="text"
                     name="ticket_attribute_definition[options][]"
                     value="<%= option_data[:value] %>"
                     class="flex-1 px-4 py-2 bg-surface-raised border border-cream-300 rounded-lg focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink"
                     placeholder="Option <%= index + 1 %>">

              <input type="color"
                     name="ticket_attribute_definition[option_colors][]"
                     value="<%= option_data[:color] %>"
                     class="w-12 h-10 border border-cream-300 rounded cursor-pointer"
                     title="Farbe wählen">

              <%= render Neo::Buttons::IconButtonComponent.new(variant: :danger, size: :small, icon: "trash",
                    tag: :button, type: "button", title: t('views.common.remove'),
                    data: { action: "click->attribute-form#removeOption" }) %>
            </div>

            <%# Row 2: meta info (only when data is present) %>
            <%
              has_usage = defined?(@option_usage_counts) && @option_usage_counts
              usage_count = has_usage ? (@option_usage_counts[option_data[:value]] || 0) : 0
              sf_names = option_data[:system_functions].filter_map { |f| SystemFunctions::Registry.label_for(f, :de) }
              has_meta = (has_usage && usage_count > 0) || sf_names.any? || (has_usage && options_data.length > 1)
            %>
            <% if has_meta %>
              <div class="ml-8 mt-0.5 flex items-center gap-1.5 text-[11px] text-cream-500 sf-meta-line">
                <% if has_usage %>
                  <span class="<%= usage_count > 0 ? 'text-cream-600' : '' %>">
                    <%= t('views.organisations.ticket_attribute_definitions.form.usage_tickets', count: usage_count) %>
                  </span>
                <% end %>

                <% if sf_names.any? %>
                  <% if has_usage %><span class="text-cream-400">&middot;</span><% end %>
                  <span class="sf-meta-functions text-violet-400">
                    <i class="bi bi-gear text-[9px]"></i>
                    <%= sf_names.join(', ') %>
                  </span>
                <% end %>

                <% if has_usage && options_data.length > 1 %>
                  <span class="text-cream-400">&middot;</span>
                  <%= link_to merge_option_organisation_project_ticket_attribute_definition_path(@current_organisation, @project, attribute, source_value: option_data[:value]),
                      class: "text-amber-500 hover:text-amber-700 hover:underline",
                      data: { turbo_frame: "_top" } do %>
                    <%= t('views.organisations.ticket_attribute_definitions.form.merge_option_link') %>
                  <% end %>
                <% end %>
              </div>
            <% end %>

            <%# System-functions checkboxes (toggled globally) %>
            <div class="system-functions-panel hidden ml-8 mt-1 mb-1">
              <div class="p-2 bg-cream-100 border border-cream-200 rounded-lg">
                <% SystemFunctions::Registry::FUNCTION_CATEGORIES.each do |cat_key, category| %>
                  <div class="mb-1 last:mb-0">
                    <span class="text-[10px] font-bold text-cream-500 uppercase tracking-wider"><%= category[:label_de] %></span>
                    <div class="flex flex-wrap gap-x-3 gap-y-0.5">
                      <% category[:functions].each do |func| %>
                        <label class="inline-flex items-center gap-1 text-xs text-cream-700 cursor-pointer">
                          <input type="checkbox"
                                 name="ticket_attribute_definition[option_system_functions][<%= index %>][]"
                                 value="<%= func[:key] %>"
                                 <%= 'checked' if option_data[:system_functions].include?(func[:key]) %>
                                 class="w-3 h-3 text-lime-600 border-cream-300 rounded focus:ring-ink sf-checkbox"
                                 data-action="change->attribute-form#updateIndicator">
                          <i class="bi bi-<%= func[:icon] %> text-[10px]"></i>
                          <%= func[:label_de] %>
                        </label>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <% if options_data.empty? %>
          <div class="option-item" data-option-index="0">
            <div class="flex gap-2 items-center">
              <span class="drag-handle cursor-grab text-cream-500 hover:text-cream-700 px-1"><i class="bi bi-grip-vertical text-lg"></i></span>

              <input type="text"
                     name="ticket_attribute_definition[options][]"
                     value=""
                     class="flex-1 px-4 py-2 bg-surface-raised border border-cream-300 rounded-lg focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink"
                     placeholder="Option 1">

              <input type="color"
                     name="ticket_attribute_definition[option_colors][]"
                     value="#000000"
                     class="w-12 h-10 border border-cream-300 rounded cursor-pointer"
                     title="Farbe wählen">

              <%= render Neo::Buttons::IconButtonComponent.new(variant: :danger, size: :small, icon: "trash",
                    tag: :button, type: "button", title: t('views.common.remove'),
                    data: { action: "click->attribute-form#removeOption" }) %>
            </div>

            <div class="system-functions-panel hidden ml-8 mt-1 mb-1">
              <div class="p-2 bg-cream-100 border border-cream-200 rounded-lg">
                <% SystemFunctions::Registry::FUNCTION_CATEGORIES.each do |cat_key, category| %>
                  <div class="mb-1 last:mb-0">
                    <span class="text-[10px] font-bold text-cream-500 uppercase tracking-wider"><%= category[:label_de] %></span>
                    <div class="flex flex-wrap gap-x-3 gap-y-0.5">
                      <% category[:functions].each do |func| %>
                        <label class="inline-flex items-center gap-1 text-xs text-cream-700 cursor-pointer">
                          <input type="checkbox"
                                 name="ticket_attribute_definition[option_system_functions][0][]"
                                 value="<%= func[:key] %>"
                                 class="w-3 h-3 text-lime-600 border-cream-300 rounded focus:ring-ink sf-checkbox"
                                 data-action="change->attribute-form#updateIndicator">
                          <i class="bi bi-<%= func[:icon] %> text-[10px]"></i>
                          <%= func[:label_de] %>
                        </label>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      <button type="button"
              data-action="click->attribute-form#addOption"
              class="mt-3 w-full py-2 inline-flex items-center justify-center gap-1.5 rounded-lg text-sm text-cream-600 hover:text-cream-900 border border-dashed border-cream-300 hover:border-ink hover:bg-cream-100 transition-colors">
        <i class="bi bi-plus-lg text-xs"></i>
        <span><%= t('views.organisations.ticket_attribute_definitions.form.add_option') %></span>
      </button>

      <%# Hidden template for system-functions in dynamically added options %>
      <template data-attribute-form-target="systemFunctionsTemplate">
        <div class="system-functions-panel hidden ml-8 mt-1 mb-1">
          <div class="p-2 bg-cream-100 border border-cream-200 rounded-lg">
            <% SystemFunctions::Registry::FUNCTION_CATEGORIES.each do |cat_key, category| %>
              <div class="mb-1 last:mb-0">
                <span class="text-[10px] font-bold text-cream-500 uppercase tracking-wider"><%= category[:label_de] %></span>
                <div class="flex flex-wrap gap-x-3 gap-y-0.5">
                  <% category[:functions].each do |func| %>
                    <label class="inline-flex items-center gap-1 text-xs text-cream-700 cursor-pointer">
                      <input type="checkbox"
                             name="ticket_attribute_definition[option_system_functions][__INDEX__][]"
                             value="<%= func[:key] %>"
                             class="w-3 h-3 text-lime-600 border-cream-300 rounded focus:ring-ink sf-checkbox"
                             data-action="change->attribute-form#updateIndicator">
                      <i class="bi bi-<%= func[:icon] %> text-[10px]"></i>
                      <%= func[:label_de] %>
                    </label>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </template>
    </div>
  </div>

  <%# Spacer so that the sticky footer does not cover the content %>
  <div class="h-20"></div>

  <%# Sticky action bar at the bottom edge of the screen %>
  <div class="sticky bottom-0 z-10 -mx-6 bg-cream-50 border-t border-cream-200 py-3 px-6 flex justify-between items-center">
    <%# D1: Cancel secondary, Submit primary — both ButtonComponent (P4), size :large. %>
    <%= render Neo::Buttons::ButtonComponent.new(
          variant: :secondary, size: :large,
          url: organisation_project_ticket_attribute_definitions_path(@current_organisation, @project),
          data: { turbo_frame: "_top" }
        ) do %>
      <%= t('views.organisations.ticket_attribute_definitions.form.cancel') %>
    <% end %>

    <% if attribute.new_record? %>
      <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, size: :large, tag: :button, type: 'submit') do %>
        <%= t('views.organisations.ticket_attribute_definitions.form.create') %>
      <% end %>
    <% else %>
      <%# Submit stays dirty-gated (attribute_form#setSubmitEnabled controls disabled); P4-conformant look. %>
      <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, size: :large, tag: :button, type: 'submit',
            disabled: true, data: { attribute_form_target: "submitButton" }) do %>
        <%= t('views.organisations.ticket_attribute_definitions.form.update') %>
      <% end %>
    <% end %>
  </div>
<% end %>

<turbo-frame id="post_<%= @post.id %>">
  <div class="post-edit-form bg-surface-raised py-6 px-4 md:px-5 lg:px-8 mb-4 rounded-lg border border-cream-300 shadow-sm relative w-full overflow-hidden">

    <%= form_with(model: [@ticket.project.organisation, @ticket.project, @ticket, @post], local: true, html: { multipart: true }) do |form| %>

    <div class="mb-6">
      <%= form.lexxy_rich_text_area :content,
        **lexxy_embed_editor_options(attachment_field: "post[post_document_files][]"),
        placeholder: t('views.organisations.posts.edit.content_placeholder'),
        class: "lexxy-content w-full px-3 py-2 mt-1 bg-surface-raised border border-cream-300 rounded-md focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink min-h-[200px] text-sm" %>
    </div>
  

  
    <div class="mb-3">
    <% if @post.post_documents.present? %>
      <div class="mb-3">

      <div class="grid grid-cols-3 gap-4">
      <%= form.fields_for :post_documents do |pd_form| %>
        <% pd_file = pd_form.object.post_document_file %>
        <% if pd_file.present? %>
          
          <div class="relative p-4 border rounded-lg bg-surface-raised h-[200px] flex flex-col">
            <div class="flex-grow flex items-center justify-center">
              <% if pd_file.variable? %>
                <%= link_to image_tag(pd_file.variant(resize_to_fit: [150, 150]), class: "max-w-full max-h-[120px] object-contain"), rails_blob_path(pd_file, disposition: :attachment) %>
              <% elsif pd_file.previewable? %>
                <%= link_to image_tag(pd_file.preview(resize_to_limit: [100, 100]), class: "w-full h-auto object-cover"), rails_blob_path(pd_file, disposition: :attachment) %>
              <% elsif pd_file.image? %>
                <%= link_to image_tag(pd_file, width: 100, class: "w-full h-auto object-cover"), document %>
              <% else %>
                <%= link_to pd_file.filename, rails_blob_path(pd_file, disposition: :attachment), class: "block text-center" %>
              <% end %>
            </div>

            <div class="flex items-center justify-center mt-auto">
              <%= pd_form.check_box :_destroy, class: "remove_attachment mr-2" %>
              <%= pd_form.label :_destroy, t('views.organisations.posts.edit.remove_attachment'), class: "text-sm" %>
            </div>
          </div>

        <% end %>
      <% end %>
      </div>



      </div>
    

    <div class="mb-6">
      <label class="block text-sm font-medium text-cream-700 mb-2">
        <i class="bi bi-paperclip mr-1"></i>
        <%= t('views.organisations.posts.edit.attach_files') %>
      </label>
      <%= form.file_field :post_document_files,
        multiple: true,
        direct_upload: true,
        class: "w-full text-sm border border-cream-300 rounded-md p-2 bg-surface-raised" %>
    </div>
  <% end %>
  
    <!-- Button Container -->
    <div class="flex justify-between gap-2 mt-4">
      <div>
        <% if @post.persisted? && PostPolicy.new(current_user, @post).destroy? %>
          <%= render(Neo::Buttons::ButtonComponent.new(
            variant: :danger,
            icon: "trash",
            url: organisation_project_ticket_post_path(@ticket.project.organisation, @ticket.project, @ticket, @post),
            data: { turbo_method: :delete, turbo_confirm: t('views.confirm.delete_post') }
          )) { t('views.organisations.posts.edit.delete') } %>
        <% end %>
      </div>

      <div class="flex gap-2">
        <%= render(Neo::Buttons::ButtonComponent.new(
          variant: :edit,
          url: organisation_project_ticket_post_path(@ticket.project.organisation, @ticket.project, @ticket, @post)
        )) { t('views.organisations.posts.edit.cancel') } %>

        <%= render(Neo::Buttons::ButtonComponent.new(
          variant: :primary,
          type: "submit"
        )) { t('views.organisations.posts.edit.update') } %>
      </div>
    </div>

  <% end %>
  </div>
</turbo-frame>

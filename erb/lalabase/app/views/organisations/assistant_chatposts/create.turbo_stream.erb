<%= turbo_stream.append @chat.chatposts_dom_id do %>
  <%= render Neo::Chat::MessageComponent.new(
    chatpost: @chatpost,
    current_user: current_user,
    current_organisation: @current_organisation,
    show_delete: true
  ) %>
<% end %>

<%= turbo_stream.replace @chat.chatpost_form_dom_id do %>
  <%= render Neo::Chat::ComposerComponent.new(
    chat: @chat,
    chatpost: Chatpost.new,
    current_organisation: @current_organisation
  ) %>
<% end %>

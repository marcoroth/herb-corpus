<%# app/views/smart_folder_rules/_rule_fields.html.erb %>
<%# Called by _rule_group_fields.html.erb %>
<%# The 'form' variable here is the FormBuilder for the rule %>

<div class="flex items-center gap-2 mb-2 smart-folder-rule" id="<%= dom_id(form.object) %>"
     data-value-type="<%= form.object.field_config[:value_type] %>"
     data-reference-model="<%= form.object.field_config[:reference_model] %>"
     data-value-required="<%= form.object.field_config[:value_required] %>">

  <%# "AND" logic, except for the first rule %>
  <% unless form.object.position == 1 || form.object.new_record? && form.options[:child_index].to_i == 0 %>
     <span class="text-xs px-2 py-1 border border-stroke rounded bg-gray-200 font-medium"><%= t('smart_folders.and') %></span>
  <% end %>

  <%# Select field %>
  <div class="flex-grow">
      <%= form.label :field, class: 'sr-only' %>
      <%= form.select :field,
                      options_for_select(available_field_options.map { |opt| [opt[:label], opt[:value]] }, form.object.field),
                      { include_blank: t('helpers.select.prompt') },
                      { class: 'block w-full px-2 py-1 text-sm border border-slate-200 rounded bg-surface-raised focus:outline-none focus:shadow-sm focus:-translate-x-0.5 focus:-translate-y-0.5 transition-all', required: true,
                        data: { action: 'change->smart-folder-form#fieldChanged', smart_folder_form_target: 'field' } } %>
  </div>

  <%# Select operator %>
  <div class="flex-grow">
      <%= form.label :operator, class: 'sr-only' %>
      <%# Options are loaded via JS %>
      <%= form.select :operator,
                      options_for_select(available_operator_options(form.object.field).map { |opt| [opt[:label], opt[:value]] }, form.object.operator),
                      { include_blank: t('helpers.select.prompt') },
                      { class: 'block w-full px-2 py-1 text-sm border border-slate-200 rounded bg-surface-raised focus:outline-none focus:shadow-sm focus:-translate-x-0.5 focus:-translate-y-0.5 transition-all', required: true,
                        data: { action: 'change->smart-folder-form#operatorChanged', smart_folder_form_target: 'operator', selected_operator: form.object.operator } } %>
  </div>

  <%# Enter value (shown dynamically) %>
  <div class="flex-grow value-container hidden" data-smart-folder-form-target="valueContainer">
      <%= form.label :value, class: 'sr-only' %>
      <%# Wrapper for different input types %>
      <div class="value-input-wrapper value-text-wrapper hidden" data-smart-folder-form-target="valueText">
         <%= form.text_field :value, class: 'block w-full px-2 py-1 text-sm border border-slate-200 rounded focus:outline-none focus:shadow-sm focus:-translate-x-0.5 focus:-translate-y-0.5 transition-all' %>
      </div>
      <div class="value-input-wrapper value-number-wrapper hidden" data-smart-folder-form-target="valueNumber">
          <%= form.text_field :value, class: 'block w-full px-2 py-1 text-sm border border-slate-200 rounded focus:outline-none focus:shadow-sm focus:-translate-x-0.5 focus:-translate-y-0.5 transition-all', type: 'text' %>
      </div>
       <div class="value-input-wrapper value-date-wrapper hidden" data-smart-folder-form-target="valueDate">
          <%= form.text_field :value, class: 'block w-full px-2 py-1 text-sm border border-slate-200 rounded focus:outline-none focus:shadow-sm focus:-translate-x-0.5 focus:-translate-y-0.5 transition-all', type: 'date' %>
       </div>
       <div class="value-input-wrapper value-boolean-wrapper hidden" data-smart-folder-form-target="valueBoolean">
           <%= form.select :value, options_for_select([['Ja', 'true'], ['Nein', 'false']], form.object.value.to_s), {}, { class: 'block w-full px-2 py-1 text-sm border border-slate-200 rounded bg-surface-raised focus:outline-none focus:shadow-sm focus:-translate-x-0.5 focus:-translate-y-0.5 transition-all' } %>
       </div>
       <div class="value-input-wrapper value-reference-wrapper hidden" data-smart-folder-form-target="valueReference">
           <%# Options are loaded via JS %>
           <%= form.select :value, [], { include_blank: t('helpers.select.prompt') },
                          { class: 'block w-full px-2 py-1 text-sm border border-slate-200 rounded bg-surface-raised focus:outline-none focus:shadow-sm focus:-translate-x-0.5 focus:-translate-y-0.5 transition-all', data: { selected_value: form.object.value } } %>
       </div>
  </div>

  <%# Actions for the rule %>
  <div class="flex gap-1">
      <%# Remove button %>
      <%= render Neo::Buttons::ButtonComponent.new(variant: :danger, size: :small, icon: "x-lg", data: { action: "click->smart-folder-form#removeRule" }) %>
  </div>

  <%# Hidden fields %>
  <%= form.hidden_field :_destroy %>
  <%= form.hidden_field :position %>
</div>

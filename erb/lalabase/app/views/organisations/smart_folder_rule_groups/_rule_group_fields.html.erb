<!-- app/views/smart_folder_rule_groups/_rule_group_fields.html.erb -->
<!-- Called by _form.html.erb -->
<!-- The 'form' variable here is the FormBuilder for the rule group -->

<!-- Unique ID and data for Stimulus -->
<div class="smart-folder-rule-group" 
     id="<%= dom_id(form.object) %>" 
     data-group-index="<%= form.options[:child_index] %>">
     
  <div class="flex justify-end mb-2 items-center">
    
    <div class="flex space-x-2">
      <!-- Button to remove the group - only shown when more than one group exists -->
      <%= button_tag type: 'button', 
                    class: 'py-1 px-2 text-xs relative inline-flex flex-row items-center justify-center gap-x-1 rounded text-sm tracking-[.00714em] font-medium border border-stroke bg-red-100 hover:bg-red-200 focus:bg-red-200 text-cream-900 hover:shadow-sm focus:shadow-sm', 
                    title: t('smart_folders.remove_group', default: 'Regelgruppe entfernen'),
                    data: { 
                      action: "click->smart-folder-form#removeRuleGroup",
                      smart_folder_form_target: "removeGroupBtn"
                    } do %>
        <i class="bi bi-trash"></i> <%= t('views.organisations.smart_folder_rule_groups.rule_group_fields.delete_group') %>
      <% end %>
      
      <!-- Hidden field for _destroy -->
      <%= form.hidden_field :_destroy %>
      <!-- Position (hidden if applicable) -->
      <%= form.hidden_field :position %>
    </div>
  </div>

  <div>
    <!-- Container for the rules within this group -->
    <div class="space-y-3 rules-container mb-8" data-controller="nested-form" data-nested-form-wrapper-selector-value=".smart-folder-rule">
      <!-- Render existing rules -->
      <% if form.object.smart_folder_rules.reject(&:marked_for_destruction?).any? %>
        <%= form.fields_for :smart_folder_rules do |rule_form| %>
          <% unless rule_form.object.marked_for_destruction? %>
            <%= render 'organisations/smart_folder_rules/rule_fields', form: rule_form %>
          <% end %>
        <% end %>
      <% else %>
        <div class="text-center py-3 border border-dashed border-slate-400 rounded-lg bg-gray-50">
          <p class="text-sm text-gray-500">
            <%= t('smart_folders.no_rules_in_group', default: 'Keine Regeln in dieser Gruppe. Fügen Sie mindestens eine Regel hinzu.') %>
          </p>
        </div>
      <% end %>
    </div>

    <!-- No longer show an AND connector -->
  </div>
</div>
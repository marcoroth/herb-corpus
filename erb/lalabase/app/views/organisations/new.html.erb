<div class="container mx-auto px-4 py-6 max-w-lg">
  <div class="text-center mb-8">
    <h2 class="text-2xl md:text-3xl font-semibold"><%= t('views.organisations.new.title') %></h2>
    <p class="text-gray-600 mt-2"><%= t('views.organisations.new.subtitle') %></p>
  </div>

  <%= render "organisations/new_organisation_form", organisation: @organisation %>

  <div class="mt-6 text-center">
    <%= link_to select_organisation_path, class: "text-lime-700 hover:text-lime-900 hover:underline" do %>
      <i class="bi bi-arrow-left me-1"></i> <%= t('views.organisations.new.back_to_selection') %>
    <% end %>
  </div>
</div>

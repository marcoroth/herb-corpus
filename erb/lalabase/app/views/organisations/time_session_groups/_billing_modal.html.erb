<%# The one modal shell for the billing forms (D4 of
    doc/abrechnung_detail_angleichung_plan.md): edit and billing status both
    load into this frame - a trigger passes its URL via the billing-modal#open
    action param. Overlay classes follow the TimeSession reference modal.
    Must sit INSIDE the page's data-controller="billing-modal" scope. %>
<div class="fixed z-modal inset-0 overflow-y-auto hidden"
     data-billing-modal-target="modal"
     data-action="click->billing-modal#closeOnBackdrop keydown@window->billing-modal#closeOnEscape">
  <div class="fixed inset-0 bg-gray-500 bg-opacity-60 backdrop-blur-sm" aria-hidden="true"
       data-action="click->billing-modal#close"></div>

  <div class="flex min-h-screen items-center justify-center p-4">
    <div class="relative w-full max-w-md rounded-lg bg-surface-raised shadow-xl">
      <div class="flex items-center justify-end px-4 pt-3">
        <button type="button"
                class="p-1 text-cream-900 opacity-50 hover:opacity-75"
                data-action="click->billing-modal#close"
                aria-label="<%= t('views.organisations.time_session_groups.billing_status.close') %>">
          <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
      </div>
      <div class="px-6 pb-6">
        <%= turbo_frame_tag 'billing_modal_frame', data: { billing_modal_target: 'frame' } %>
      </div>
    </div>
  </div>
</div>

<%# Area header on the page edge, form body under it - the header must not sit
    in the form's own narrow, centred container, or the area title lands
    somewhere else than on every other billings page. %>
<%= render 'organisations/shared/times_subnav',
      active: :billings,
      title: t('organisations.time_session_groups.index.title') %>
<div class="max-w-2xl">
  <%# The frame is what the billing modal extracts; a direct visit still gets
      this page as the no-JS fallback (D4). %>
  <%= turbo_frame_tag 'billing_modal_frame' do %>
    <h1 class="mb-6 text-xl font-bold text-cream-900"><%= t('views.organisations.time_session_groups.edit.title') %></h1>
    <%= render 'form', time_session_group: @time_session_group %>
  <% end %>
</div>

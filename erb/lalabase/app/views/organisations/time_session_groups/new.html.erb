<div>
  <%# Title box AND tab bar from one partial, on one left edge. %>
  <% right_content = capture do %>
    <%= render Neo::Buttons::HeaderButtonComponent.new(
      variant: :secondary,
      icon: "arrow-left",
      label: t('views.organisations.time_session_groups.new.back_button'),
      url: organisation_time_session_groups_path(@current_organisation)
    ) %>
  <% end %>
  <%= render 'organisations/shared/times_subnav',
        active: :billings,
        title: t('views.organisations.time_session_groups.new.title'),
        right_content: right_content %>

  <div class="max-w-2xl mt-6">
    <%= render 'form', time_session_group: @time_session_group %>
  </div>
</div>

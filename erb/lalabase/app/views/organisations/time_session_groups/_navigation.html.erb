<%#
  Navigation between the detail views of a billing (D2 of
  doc/abrechnung_detail_angleichung_plan.md): quiet underline text tabs, the
  subnav's look one size smaller - the boxed pill toggle was the strongest
  chrome on the page for a control that only switches the view.

  aria-current="page" marks the active view; it is the stable hook the specs
  assert on (styling tokens alone would couple them to the design system).
  Keys fully qualified - lazy t('.') resolves without the views prefix here
  (the P3 lesson).
  @param current_view [Symbol] :chronological, :aggregated or :customer_export
%>
<% nav = 'views.organisations.time_session_groups.navigation' %>
<% views = [
     { key: :chronological,
       path: chronological_organisation_time_session_group_path(@current_organisation, @time_session_group),
       label: t("#{nav}.view_chronological") },
     { key: :aggregated,
       path: aggregated_organisation_time_session_group_path(@current_organisation, @time_session_group),
       label: t("#{nav}.view_by_subject") },
     { key: :customer_export,
       path: customer_export_organisation_time_session_group_path(@current_organisation, @time_session_group),
       label: t("#{nav}.view_customer_export") }
   ] %>

<div class="mb-4 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
  <h2 class="text-base font-bold text-cream-900"><%= t("#{nav}.sessions_in_group") %></h2>

  <div class="flex flex-wrap items-baseline gap-5">
    <% views.each do |view| %>
      <% is_active = (current_view == view[:key]) %>
      <%= link_to view[:path],
                  "aria-current": (is_active ? 'page' : nil),
                  class: "border-b-2 pb-1 text-sm whitespace-nowrap transition-colors #{is_active ? 'border-ink font-bold text-cream-900' : 'border-transparent font-medium text-cream-600 hover:border-cream-400 hover:text-cream-900'}" do %>
        <%= view[:label] %>
      <% end %>
    <% end %>
  </div>
</div>

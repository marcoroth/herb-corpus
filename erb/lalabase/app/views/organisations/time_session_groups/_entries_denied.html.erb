<%# locals: (group:) %>
<%# The panel offers every open billing as a target, but looking INSIDE one needs
    rights, so a refusal here is a normal outcome and not an error. It answers in
    the frame the panel opened: redirected out of it, the reader would sit in
    front of "Wird geladen ..." for ever with nothing to read. %>
<turbo-frame id="billing_entries_<%= group.id %>">
  <p class="py-1 text-xs italic leading-6 text-cream-500">
    <%= t('views.organisations.time_sessions.index_table.billing_entries_denied') %>
  </p>
</turbo-frame>

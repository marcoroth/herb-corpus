<%# The billing's OWN fields, name and description (D4 split, user decision
    02.09.): the billing STATUS has its own modal and endpoint
    (billing_status), so this form no longer carries the billed checkbox and
    the invoice fields. Serves the new page, the edit fallback page and the
    edit modal - the billing_edit_form id is what closes the modal on
    success (billing_modal_controller). %>
<%= form_with(model: [@current_organisation, time_session_group], class: "space-y-6", id: "billing_edit_form") do |f| %>
  <% if time_session_group.errors.any? %>
    <div class="bg-red-100 border-2 border-red-400 text-red-700 px-4 py-3 rounded mb-4" role="alert">
      <h2 class="font-bold"><%= t('.validation_errors', count: time_session_group.errors.count) %></h2>
      <ul class="list-disc list-inside">
        <% time_session_group.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-cream-50 border border-cream-300 rounded-lg p-6">
    <div class="space-y-4">
      <div>
        <%= f.label :name, t('.name_label'), class: "block text-sm font-medium text-cream-700 mb-1" %>
        <%= f.text_field :name,
                        class: "w-full px-3 py-2 bg-surface-raised border border-cream-300 rounded text-sm focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all",
                        placeholder: t('.name_placeholder'),
                        required: true %>
        <p class="mt-1 text-xs text-cream-600"><%= t('.name_help') %></p>
      </div>

      <div>
        <%= f.label :description, t('.description_label'), class: "block text-sm font-medium text-cream-700 mb-1" %>
        <%= f.text_area :description,
                       rows: 3,
                       class: "w-full px-3 py-2 bg-surface-raised border border-cream-300 rounded text-sm focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all",
                       placeholder: t('.description_placeholder') %>
      </div>

      <% if time_session_group.persisted? && time_session_group.billed? %>
        <%# Icon as its own flex item, the sentence as NORMAL flow: with
            flex on the <p> itself, the strong and the text nodes became
            separate flex items - stacked oddly, and the whitespace between
            them collapsed ("berechnet:Änderungen"). %>
        <div class="bg-orange-50 border-2 border-orange-300 rounded p-4">
          <div class="flex items-start gap-2 text-sm text-orange-800">
            <i class="bi bi-exclamation-triangle mt-0.5 shrink-0" aria-hidden="true"></i>
            <p><%= t('.billing_warning_html') %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Modal button rule (24.08.2026): actions in their own full-width footer
      row, separated by a line; confirm sits right. %>
  <div class="flex items-center justify-end gap-4 border-t-2 border-ink pt-4">
    <%# In the modal, cancel must CLOSE (billing-modal#cancel prevents the
        navigation); on the fallback pages the controller is absent, the
        action is inert and the href navigates - _top, so the link never
        swaps the form frame for the list's empty shell. %>
    <%= render Neo::Buttons::ButtonComponent.new(
          variant: :secondary, size: :large,
          url: organisation_time_session_groups_path(@current_organisation),
          data: { action: 'click->billing-modal#cancel', turbo_frame: '_top' }
        ) do %>
      <%= t('.cancel') %>
    <% end %>

    <%= render Neo::Buttons::ButtonComponent.new(
          variant: :primary, size: :large, tag: :button, type: "submit"
        ) do %>
      <%= time_session_group.new_record? ? t('.create') : t('.save') %>
    <% end %>
  </div>
<% end %>

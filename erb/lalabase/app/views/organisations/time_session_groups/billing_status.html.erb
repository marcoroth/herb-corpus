<%# The billing-status form (D4 of doc/abrechnung_detail_angleichung_plan.md):
    one template, both directions of the transition. Rendered without layout -
    the modal frame extracts its matching turbo-frame; a direct visit gets the
    bare form as the no-JS fallback. Keys fully qualified (P3 lesson). %>
<% bs = 'views.organisations.time_session_groups.billing_status' %>
<%= turbo_frame_tag 'billing_modal_frame' do %>
  <h3 class="mb-4 text-lg font-bold text-cream-900">
    <%= @time_session_group.billed? ? t("#{bs}.heading_unbill") : t("#{bs}.heading_bill") %>
  </h3>

  <% if @time_session_group.errors.any? %>
    <div class="mb-4 rounded border-2 border-red-400 bg-red-100 px-4 py-3 text-sm text-red-700" role="alert">
      <ul class="list-inside list-disc">
        <% @time_session_group.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @time_session_group.billed? %>
    <p class="mb-2 text-sm text-cream-800">
      <%= t("#{bs}.billed_line",
            number: @time_session_group.invoice_number,
            date: @time_session_group.billed_at&.strftime('%d.%m.%Y')) %>
    </p>
    <p class="mb-4 text-sm text-cream-600"><%= t("#{bs}.unbill_warning") %></p>

    <%= form_with model: @time_session_group,
                  url: billing_status_organisation_time_session_group_path(@current_organisation, @time_session_group),
                  method: :patch, id: 'billing_status_form',
                  data: { turbo_confirm: t("#{bs}.unbill_confirm") } do |f| %>
      <%= f.hidden_field :billed, value: '0' %>
      <%# Modal button rule (24.08.2026): actions in their own full-width
          footer row, separated by a line. %>
      <div class="mt-6 flex items-center justify-end gap-4 border-t-2 border-ink pt-4">
        <%= render Neo::Buttons::ButtonComponent.new(variant: :danger, size: :medium, tag: :button, type: 'submit') do %>
          <%= t("#{bs}.submit_unbill") %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <%= form_with model: @time_session_group,
                  url: billing_status_organisation_time_session_group_path(@current_organisation, @time_session_group),
                  method: :patch, id: 'billing_status_form' do |f| %>
      <%= f.hidden_field :billed, value: '1' %>
      <div class="space-y-4">
        <div>
          <%= f.label :invoice_number, t("#{bs}.invoice_label"), class: "block text-sm font-medium text-cream-700 mb-1" %>
          <%= f.text_field :invoice_number,
                           required: true,
                           class: "w-full px-3 py-2 bg-surface-raised border border-cream-300 rounded text-sm focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all" %>
        </div>
        <div>
          <%= f.label :billed_at, t("#{bs}.date_label"), class: "block text-sm font-medium text-cream-700 mb-1" %>
          <%= f.date_field :billed_at,
                           value: (@time_session_group.billed_at&.to_date || Date.current),
                           class: "w-full px-3 py-2 bg-surface-raised border border-cream-300 rounded text-sm focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all" %>
        </div>
      </div>
      <div class="mt-6 flex items-center justify-end gap-4 border-t-2 border-ink pt-4">
        <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, size: :medium, tag: :button, type: 'submit') do %>
          <%= t("#{bs}.submit_bill") %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>

<%# locals: (f:) %>
<%# The filter LINE of the billings list (P2 of
    doc/abrechnungen_filterzeile_und_tabelle_plan.md), in the time list's
    language: a label column on the left, the choice pills and the search on
    the right, every choice one shared/filter_pill. The row labels are the time
    list's own keys on purpose - one vocabulary for "Filter" and "Suche" on the
    two sibling tabs.

    Every project option carries its count as option[:sub] (decision D-C),
    and the status row carries the count beside each box - all counted by the
    controller UNDER THE OTHER FILTERS (F4 rule) and through the policy
    scope, so the number a control advertises is the number choosing it
    answers.

    The period is the time list's TABLE vocabulary (TimeSessions::ListPeriod,
    default 'all') and filters the billing's own created_at (decision D-B);
    hand-typed bounds live in the period menu and win over a preset. %>
<%
  owns_for = ->(changes) { time_filter_owns_pairs(changes) }
  url_for_changes = ->(changes) { billing_list_filter_url(changes) }

  option_for = lambda do |value, label, changes, sub, selected|
    { value: value, label: label, sub: sub, url: url_for_changes.call(changes),
      owns: owns_for.call(changes), selected: selected }
  end

  # --- Period. The eight presets plus "Eigener Zeitraum"; one change hash per
  # option, read once as an address and once as a declaration.
  custom_key = TimeSessions::ListPeriod::CUSTOM
  period_options = TimeSessions::ListPeriod.options.map do |key, label|
    option_for.call(key, label, billing_period_change(key), nil, @effective_date_range == key)
  end
  period_options << option_for.call(custom_key, TimeSessions::ListPeriod.label(custom_key),
                                    { 'date_range' => custom_key }, nil,
                                    @effective_date_range == custom_key)
  period_state = { date_range: @effective_date_range,
                   start_date: @effective_start_date, end_date: @effective_end_date }

  # --- Project.
  project_removal = TimeSessionGroupsHelper::BILLING_FILTER_REMOVALS.fetch(:project)
  chosen_project = @accessible_projects.find { |project| project.id == params[:project_id] }
  project_options = [
    option_for.call('', t('views.organisations.time_session_groups.index.filter_all_projects'), project_removal,
                    @billing_projects_total.to_s, chosen_project.blank?)
  ]
  project_options += @accessible_projects.map do |project|
    option_for.call(project.id, project.name, { 'project_id' => project.id },
                    @billing_project_counts.fetch(project.id, 0).to_s,
                    chosen_project&.id == project.id)
  end

  with_value = ->(name, value) { t('views.organisations.time_sessions.empty_reason.with_value', name: name, value: value) }
%>

<%# minmax(0, 1fr), not 1fr: the same trap as the time list's panel
    (time_sessions/_filter_line, where the reason is written out). The 420px
    search field held the track that wide and the page scrolled sideways on a
    phone (spec/system/mobile_shell_regressions_spec.rb). %>
<div class="grid grid-cols-[74px_minmax(0,1fr)] items-center gap-x-3.5 gap-y-2">

  <span class="text-xs text-cream-600"><%= t('views.organisations.time_sessions.index.filter_row_choose') %></span>
  <div class="flex items-center gap-2 flex-wrap">
    <%# The custom bounds live in the period menu, exactly as on the time list:
        two fields excluded from auto-submit (a range is ONE decision made of
        two controls) and an apply button that is a whole-page visit, because
        this pill sits outside time_session_groups_list_frame. %>
    <% custom_bounds = capture do %>
      <% span_days = (@effective_start_date && @effective_end_date) ? (@effective_end_date.to_date - @effective_start_date.to_date).to_i + 1 : nil %>
      <div class="border-t border-cream-300 mt-1 pt-2 px-3 pb-1"
           data-controller="custom-period"
           data-action="input->custom-period#refresh change->custom-period#refresh">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-8 text-xs text-cream-600"><%= t('views.organisations.time_sessions.index.filter_range_from') %></span>
          <%= f.date_field :start_date, value: @effective_start_date,
                           class: 'flex-1 border border-stroke rounded text-xs px-2 py-1 font-mono',
                           data: { auto_submit_skip: '', custom_period_target: 'start' } %>
        </div>
        <div class="flex items-center gap-2 mb-2">
          <span class="w-8 text-xs text-cream-600"><%= t('views.organisations.time_sessions.index.filter_range_to') %></span>
          <%= f.date_field :end_date, value: @effective_end_date,
                           class: 'flex-1 border border-stroke rounded text-xs px-2 py-1 font-mono',
                           data: { auto_submit_skip: '', custom_period_target: 'end' } %>
        </div>
        <div class="flex items-center justify-between gap-3">
          <span class="text-xs text-cream-600 tabular-nums"
                data-custom-period-target="days"
                data-template="<%= t('views.organisations.time_sessions.index.filter_range_days', count: '%{count}') %>">
            <%= span_days ? t('views.organisations.time_sessions.index.filter_range_days', count: span_days) : '' %>
          </span>
          <%= f.submit t('views.organisations.time_sessions.index.filter_range_apply'),
                       name: nil,
                       class: 'px-3 py-1.5 text-xs font-semibold rounded border border-ink bg-btn-primary text-cream-900 cursor-pointer disabled:opacity-50 disabled:cursor-default',
                       data: { custom_period_target: 'apply', turbo_frame: '_top',
                               action: 'click->details-autoclose#close' } %>
        </div>
      </div>
    <% end %>

    <% custom_chosen = @effective_date_range == custom_key %>
    <% span_settled = @effective_start_date.present? && @effective_end_date.present? %>
    <%= render 'shared/filter_pill',
               key: :period, clearable: false,
               label: time_filter_line_period(period_state),
               set: true, options: period_options,
               open: (custom_chosen && !span_settled),
               footer: (custom_chosen ? custom_bounds : nil) %>

    <%= render 'shared/filter_pill',
               key: :project,
               label: (chosen_project ? with_value.call(t('views.organisations.time_session_groups.index.filter_project'), chosen_project.name) : project_options.first[:label]),
               set: chosen_project.present?, options: project_options,
               clear_url: billing_filter_removal_url(:project), clear_owns: owns_for.call(project_removal) %>
  </div>

  <%# --- Row 2: the status toggles, labelled like the time list's (user,
      02.09.: a status ROW instead of a dropdown pill). An own frame-dependent
      region, so its counts arrive with every frame answer. %>
  <span class="text-xs text-cream-600"><%= t('views.organisations.time_sessions.index.filter_row_status') %></span>
  <%= render 'organisations/time_session_groups/status_row' %>

  <span class="text-xs text-cream-600"><%= t('views.organisations.time_sessions.index.filter_row_search') %></span>
  <div class="flex items-end justify-between gap-4 flex-wrap">
    <%# No fill of its own: the zone around it is already white (the filter
        stripe), so a white field would simply disappear. The ring carries the
        field. %>
    <div class="flex items-center gap-2.5 w-[420px] max-w-full px-[11px] py-[7px] rounded-lg
                shadow-[inset_0_0_0_1px_theme(colors.cream.400)]
                focus-within:shadow-[inset_0_0_0_1.5px_theme(colors.cream.700)] transition-shadow">
      <i class="bi bi-search text-xs text-cream-700 flex-shrink-0" aria-hidden="true"></i>
      <%= f.search_field :search, value: params[:search],
                         placeholder: t('views.organisations.time_session_groups.index.filter_search_placeholder'),
                         autocomplete: 'off',
                         class: 'flex-1 min-w-0 bg-transparent border-0 p-0 text-[13px] text-cream-900 placeholder:text-cream-500 focus:outline-none focus:ring-0' %>
      <%# Emptying the field is a filter change like any other: a LINK to the
          address without it, working with no JavaScript. %>
      <% if params[:search].present? %>
        <%= link_to billing_filter_removal_url(:search),
                    data: time_filter_owns(owns_for.call(TimeSessionGroupsHelper::BILLING_FILTER_REMOVALS.fetch(:search)))
                            .merge(search_clear: true),
                    class: 'flex-shrink-0 text-cream-600 hover:text-cream-900',
                    aria: { label: t('views.organisations.time_sessions.index.search_clear') } do %>
          <i class="bi bi-x-lg text-[11px]" aria-hidden="true"></i>
        <% end %>
      <% end %>
    </div>
    <%= render 'organisations/time_session_groups/filter_reset' %>
  </div>
</div>

<%# --- Hidden fields that carry the pill-set filters across a search submit.
    The pills are LINKS, not fields of this form, so a submit of the search
    would drop them without these. start_date/end_date ARE fields (the custom
    bounds above), so the period travels as date_range only while no custom
    bounds apply. %>
<%# The status boxes are LINKS; their set travels as hidden fields so a search
    submit keeps it. The legacy billing_status is not re-emitted: once this
    form submits, the set is the one owner. %>
<% Array(@effective_billing_states).each do |state| %>
  <%= hidden_field_tag 'billing_states[]', state %>
<% end %>
<% if params[:project_id].present? %>
  <%= f.hidden_field :project_id, value: params[:project_id] %>
<% end %>
<% if @effective_date_range.present? && @effective_date_range != custom_key %>
  <%= f.hidden_field :date_range, value: @effective_date_range %>
<% end %>

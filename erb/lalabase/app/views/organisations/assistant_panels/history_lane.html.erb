<%# S3c T2: earlier conversations as a STANDING LANE beside the chat in the full
    view (plan §7.6, §4). Same component as history.html.erb, different frame and
    no way back -- the list does not go anywhere here, it stays next to the
    conversation. %>
<%= turbo_frame_tag 'assistant_panel_history', class: 'assistant-lane-history min-h-0' do %>
  <%= render Neo::Chat::HistoryListComponent.new(
    threads: @threads,
    current_chat: @current_chat,
    current_organisation: current_organisation,
    variant: :lane
  ) %>
<% end %>

<%# Unified diff of a note version vs. its predecessor, in the Knowledge display frame. %>
<%# Locals: note, detail_frame_id. @version, @previous, @diff (Wiki::VersionDiff::Line[]). %>
<div id="note-version-diff" class="relative">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h2 class="text-lg font-bold text-ink"><%= t("views.organisations.note_versions.show.title") %></h2>
      <p class="text-sm text-cream-700">
        <%= l(@version.created_at, format: :short) %> ·
        <%= @version.author ? viewer_display_name(@version.author) : t("views.organisations.note_versions.shared.system_author") %>
        <% unless @previous %> · <%= t("views.organisations.note_versions.show.initial") %><% end %>
      </p>
    </div>
    <%= link_to t("views.organisations.note_versions.shared.back_to_history"),
                organisation_project_note_versions_path(@current_organisation, @project, note, frame_id: detail_frame_id),
                data: { turbo_frame: detail_frame_id },
                class: "text-sm underline text-cream-700 hover:text-ink" %>
  </div>

  <% if @diff.empty? %>
    <p class="text-sm text-cream-700"><%= t("views.organisations.note_versions.show.no_changes") %></p>
  <% else %>
    <div class="wiki-diff">
      <% @diff.each do |line| %>
        <div class="wiki-diff__line wiki-diff__line--<%= line.type %>"><%= line.text %></div>
      <% end %>
    </div>
  <% end %>
</div>

<% if @pages.empty? %>
  <%= render 'empty', can_manage_sets: @can_manage, can_connect_repo: @can_connect_repo,
                      project_has_repository: @project_has_repository, variant: @empty_variant %>
<% else %>
  <div class="flex gap-6">
    <aside class="w-72 shrink-0 border-r border-cream-300 pr-4">
      <%= render 'search_box' %>
      <%= render 'tree', nodes: @navigation %>
    </aside>
    <main class="min-w-0 flex-1">
      <%= render 'page', page: @selected_page %>
    </main>
  </div>
<% end %>

<%# locals: page — the selected DocumentationPage (or nil).
    The search term is highlighted client-side (frame-search#highlightContent over
    the .doc-prose container), so the body is rendered plain here. %>
<% if page %>
  <article class="doc-prose max-w-3xl">
    <%# rendered_html was sanitized at sync; re-sanitize on output as defense in depth. %>
    <%= sanitize page.rendered_html,
          tags: Documentation::MarkdownRenderer::ALLOWED_TAGS,
          attributes: Documentation::MarkdownRenderer::ALLOWED_ATTRIBUTES %>
  </article>
<% else %>
  <p class="text-sm text-muted"><%= t('views.organisations.documentation.index.select_page') %></p>
<% end %>

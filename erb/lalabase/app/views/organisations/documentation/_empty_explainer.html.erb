<%# Plain-language "what documentation is / is not" panel, shown beside the connect
    box in the :no_set empty state (see _empty.html.erb). Written for non-technical
    readers: docs are maintained in the project's source by the developers (optionally
    with an AI tool), mirrored read-only into Lalabase, kept current, and fed into
    search + chat — NOT authored inside Lalabase. Keep every string in t() (DE + EN).
    The long-form version lives in the Hilfe page guides/documentation/write-and-sync. %>
<aside class="flex h-full flex-col gap-4 rounded-lg border border-cream-300 bg-surface-raised p-6 text-left">
  <h3 class="text-base font-semibold text-heading">
    <%= t('views.organisations.documentation.empty.explainer.title') %>
  </h3>

  <ul class="flex flex-col gap-3 text-sm text-muted">
    <% %i[source sync ai search_chat].each do |point| %>
      <li class="flex items-start gap-2.5">
        <i class="bi bi-<%= { source: 'code-slash', sync: 'arrow-repeat', ai: 'robot', search_chat: 'search' }[point] %> mt-0.5 shrink-0 text-heading" aria-hidden="true"></i>
        <span><%= t("views.organisations.documentation.empty.explainer.point_#{point}") %></span>
      </li>
    <% end %>
  </ul>

  <div class="mt-auto rounded-md border border-cream-300 bg-cream-100 px-3 py-2.5">
    <p class="text-xs font-semibold text-heading">
      <%= t('views.organisations.documentation.empty.explainer.not_title') %>
    </p>
    <p class="mt-0.5 text-xs text-muted">
      <%= t('views.organisations.documentation.empty.explainer.not_body') %>
    </p>
  </div>
</aside>

<%# Mobile (DT7): show the tree OR one page with a back arrow — same viewport
    pattern as Wissen, never both at once. %>
<% if params[:page].present? && @selected_page %>
  <div class="flex flex-col gap-3">
    <%= link_to organisation_project_documentation_index_path(@current_organisation, @project, set_id: @documentation_set.id),
          class: "inline-flex items-center gap-1 text-sm text-muted" do %>
      <i class="bi bi-arrow-left"></i>
      <%= t('views.organisations.documentation.index.back_to_tree') %>
    <% end %>
    <%= render 'page', page: @selected_page %>
  </div>
<% elsif @pages.empty? %>
  <%= render 'empty', can_manage_sets: @can_manage, can_connect_repo: @can_connect_repo,
                      project_has_repository: @project_has_repository, variant: @empty_variant %>
<% else %>
  <%= render 'search_box' %>
  <%= render 'tree', nodes: @navigation %>
<% end %>

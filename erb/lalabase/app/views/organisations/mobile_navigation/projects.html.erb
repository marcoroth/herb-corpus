<div class="mobile-destination width-capped" data-controller="mobile-project-search">
  <h1 class="desktop-mobile-title"><%= t('mobile.projects') %></h1>
  <label class="mobile-search-field">
    <i class="bi bi-search" aria-hidden="true"></i>
    <input type="search" autocomplete="off" aria-label="<%= t('mobile.search_projects') %>" placeholder="<%= t('mobile.search_projects') %>" data-action="input->mobile-project-search#filter">
  </label>
  <%= render 'layouts/mobile_project_list', switcher: false %>
  <% if policy(Project).create? %>
    <%= link_to t('navigation.new_project'), new_organisation_project_path(current_organisation), class: 'mobile-text-action' %>
  <% end %>
</div>

<div class="mobile-destination width-capped">
  <h1 class="desktop-mobile-title"><%= t('mobile.more') %></h1>
  <div class="mobile-person">
    <%= render Neo::Users::AvatarComponent.new(user: current_user) %>
    <div><strong><%= viewer_display_name(current_user) %></strong><p><%= current_organisation.name %></p></div>
    <%= link_to t('mobile.switch'), select_organisation_path, class: 'mobile-text-action' %>
  </div>
  <% show_meetings = AccessCheck::ProjectAccessService.accessible_project_ids(current_user, current_organisation, action: :read, area: :meetings).any? %>
  <% show_billings = policy(TimeSessionGroup).index? %>
  <% show_management = can_manage_organisation?(current_organisation) %>
  <% if show_meetings || show_billings || show_management %>
  <h2 class="mobile-section-label"><%= t('mobile.organisation') %></h2>
  <ul class="mobile-menu-list">
    <% if show_meetings %>
      <li><%= link_to safe_join([content_tag(:i, '', class: 'bi bi-chat-left', aria: { hidden: true }), content_tag(:span, t('navigation.all_meetings'))]), organisation_meetings_path(current_organisation) %></li>
    <% end %>
    <% if show_billings %>
      <li><%= link_to safe_join([content_tag(:i, '', class: 'bi bi-coin', aria: { hidden: true }), content_tag(:span, t('mobile.billings'))]), organisation_time_session_groups_path(current_organisation) %></li>
    <% end %>
    <% if show_management %>
      <li><%= link_to safe_join([content_tag(:i, '', class: 'bi bi-gear', aria: { hidden: true }), content_tag(:span, t('navigation.management'))]), organisation_settings_path(current_organisation) %></li>
    <% end %>
  </ul>
  <% end %>
  <h2 class="mobile-section-label"><%= t('mobile.me') %></h2>
  <ul class="mobile-menu-list">
    <li><%= link_to safe_join([content_tag(:i, '', class: 'bi bi-person', aria: { hidden: true }), content_tag(:span, t('navigation.profile'))]), edit_user_registration_path %></li>
    <% if policy(TimeSession).index? %>
      <li><%= link_to safe_join([content_tag(:i, '', class: 'bi bi-clock', aria: { hidden: true }), content_tag(:span, t('mobile.my_times'))]), organisation_time_sessions_path(current_organisation, creator_id: current_user.id) %></li>
    <% end %>
    <li><%= link_to safe_join([content_tag(:i, '', class: 'bi bi-person-gear', aria: { hidden: true }), content_tag(:span, t('navigation.preferences'))]), general_user_preferences_path %></li>
    <li><%= link_to safe_join([content_tag(:i, '', class: 'bi bi-download', aria: { hidden: true }), content_tag(:span, t('navigation.data_export'))]), user_data_export_path %></li>
    <li><%= link_to safe_join([content_tag(:i, '', class: 'bi bi-megaphone', aria: { hidden: true }), content_tag(:span, changelog_nav_label(changelog_has_unread?(current_user)))]), organisation_changelog_path(current_organisation) %></li>
    <li>
      <fieldset class="py-4 border-b border-cream-300">
        <legend><%= t('navigation.theme.label') %></legend>
        <div class="flex flex-wrap gap-2">
          <% %w[light dark pop].each do |mode| %>
            <button type="button" data-theme-set="<%= mode %>" aria-pressed="false"><%= t("navigation.theme.#{mode}") %></button>
          <% end %>
        </div>
      </fieldset>
    </li>
    <li><button type="button" data-action="personal-tasks-drawer#open"><i class="bi bi-check2-square" aria-hidden="true"></i><span><%= t('navigation.notizblock.title') %></span></button></li>
    <li><%= link_to safe_join([content_tag(:i, '', class: 'bi bi-question-circle', aria: { hidden: true }), content_tag(:span, t('mobile.help'))]), help_home_url %></li>
    <li><%= link_to safe_join([content_tag(:i, '', class: 'bi bi-box-arrow-right', aria: { hidden: true }), content_tag(:span, t('navigation.logout'))]), destroy_user_session_path, data: { turbo_method: :delete } %></li>
  </ul>
</div>

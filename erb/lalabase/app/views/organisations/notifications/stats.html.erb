<% content_for :title, t('views.organisations.notifications.stats.title') %>

<div class="notification-stats">
  <div class="page-header">
    <h1 class="page-title">
      <i class="bi bi-graph-up me-2"></i>
      <%= t('views.organisations.notifications.stats.title') %>
    </h1>
    <p class="page-description"><%= t('views.organisations.notifications.stats.description') %></p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-6 my-8">
    <div class="bg-surface-raised border border-slate-200 rounded-lg shadow-sm p-6 flex items-center gap-4 hover:-translate-y-0.5 hover:shadow-md transition-all">
      <div class="text-3xl opacity-80">
        <i class="bi bi-bell-fill text-blue-500"></i>
      </div>
      <div>
        <div class="text-3xl font-bold text-gray-900 leading-none"><%= @stats[:total_count] %></div>
        <div class="text-sm text-gray-500 mt-1"><%= t('views.organisations.notifications.stats.total_notifications') %></div>
      </div>
    </div>

    <div class="bg-surface-raised border border-slate-200 rounded-lg shadow-sm p-6 flex items-center gap-4 hover:-translate-y-0.5 hover:shadow-md transition-all">
      <div class="text-3xl opacity-80">
        <i class="bi bi-bell text-yellow-500"></i>
      </div>
      <div>
        <div class="text-3xl font-bold text-gray-900 leading-none"><%= @stats[:unread_count] %></div>
        <div class="text-sm text-gray-500 mt-1"><%= t('views.organisations.notifications.stats.unread') %></div>
      </div>
    </div>

    <div class="bg-surface-raised border border-slate-200 rounded-lg shadow-sm p-6 flex items-center gap-4 hover:-translate-y-0.5 hover:shadow-md transition-all">
      <div class="text-3xl opacity-80">
        <i class="bi bi-check-circle-fill text-green-500"></i>
      </div>
      <div>
        <div class="text-3xl font-bold text-gray-900 leading-none"><%= @stats[:read_count] %></div>
        <div class="text-sm text-gray-500 mt-1"><%= t('views.organisations.notifications.stats.read') %></div>
      </div>
    </div>

    <div class="bg-surface-raised border border-slate-200 rounded-lg shadow-sm p-6 flex items-center gap-4 hover:-translate-y-0.5 hover:shadow-md transition-all">
      <div class="text-3xl opacity-80">
        <i class="bi bi-archive-fill text-gray-400"></i>
      </div>
      <div>
        <div class="text-3xl font-bold text-gray-900 leading-none"><%= @stats[:archived_count] %></div>
        <div class="text-sm text-gray-500 mt-1"><%= t('views.organisations.notifications.stats.archived') %></div>
      </div>
    </div>

    <div class="bg-surface-raised border border-slate-200 rounded-lg shadow-sm p-6 flex items-center gap-4 hover:-translate-y-0.5 hover:shadow-md transition-all">
      <div class="text-3xl opacity-80">
        <i class="bi bi-clock-fill text-cyan-500"></i>
      </div>
      <div>
        <div class="text-3xl font-bold text-gray-900 leading-none"><%= @stats[:recent_count] %></div>
        <div class="text-sm text-gray-500 mt-1"><%= t('views.organisations.notifications.stats.last_7_days') %></div>
      </div>
    </div>
  </div>

  <div class="mt-12 text-center">
    <%= render(Neo::Buttons::ButtonComponent.new(variant: :primary, icon: "arrow-left", url: organisation_notifications_path(current_organisation))) { t('views.organisations.notifications.stats.back_to_notifications') } %>
  </div>
</div>

<%# Inbox pane empty state.
    Shown when no notification is selected (default state of the inbox
    page) or when the selected entry has no meaningful pane rendering
    (see doc/inbox_feature_spec.md chapter 4.9). %>
<%= turbo_frame_tag 'ticket_pane', class: 'block h-full' do %>
  <div class="h-full flex items-center justify-center p-8">
    <div class="text-center max-w-sm">
      <div class="w-16 h-16 mx-auto mb-4 bg-cream-100 border border-cream-300 rounded-full flex items-center justify-center">
        <i class="bi bi-arrow-left text-2xl text-cream-500"></i>
      </div>
      <h3 class="text-lg font-medium text-cream-700 mb-2">
        <%= t('views.organisations.notifications.pane.empty_title') %>
      </h3>
      <p class="text-sm text-cream-600">
        <%= t('views.organisations.notifications.pane.empty_subtitle') %>
      </p>
    </div>
  </div>
<% end %>

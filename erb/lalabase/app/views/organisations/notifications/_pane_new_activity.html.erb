<%# "Was war neu" block (Linear style): compact list of the unread
    activities of this ticket, newest on top. Gives back the context that
    the bundling in the master list takes away. Snapshot on opening:
    stays visible even after the 5s cascade marks everything as read.
    Locals: new_activities (Array<Notification>). %>
<% if new_activities.present? %>
  <ul class="mb-4 border border-gray-200 rounded-lg bg-lime-50 overflow-hidden divide-y divide-gray-200">
    <% new_activities.each do |activity| %>
      <% line = Inbox::ActivityLine.new(activity) %>
      <li class="flex items-baseline gap-2 px-4 py-2 text-sm">
        <i class="bi bi-<%= line.icon %> text-xs text-slate-500 pt-0.5" aria-hidden="true"></i>
        <span class="font-bold text-gray-900"><%= line.actor_name %></span>
        <span class="text-gray-600 flex-1 min-w-0 truncate"><%= line.label %></span>
        <span class="text-xs text-slate-400 flex-shrink-0"><%= line.time_ago %></span>
      </li>
    <% end %>
  </ul>
<% end %>

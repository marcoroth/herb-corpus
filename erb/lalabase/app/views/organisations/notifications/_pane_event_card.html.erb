<%# locals: (notification:, kind:) %>
<%# The body of the lane for an event without a display of its own (a new member, a changed
    right, a deleted meeting), for an event whose object the lane cannot show yet, and for
    one whose object is gone (organisations/notifications/_pane draws the chrome around it).
    The form of the lane's notice (_pane_notice): a title, one line, one link. The line says
    who did what, names the object from the payload and says when; the link leads to where
    it lives (Inbox::LaneKind#card_link). Nothing of an object is read here: the card shows
    what the row of the list shows. kind.card is one of a closed list of keys. %>
<% line = Inbox::ActivityLine.new(notification) %>
<% link_name, link_address = kind.card_link %>
<div class="inbox-lane-notice" data-inbox-event-card="<%= kind.card %>">
  <h2 class="inbox-lane-notice__title"><%= t("views.organisations.notifications.pane.event_card.#{kind.card}.title", project: kind.project.name) %></h2>
  <p class="inbox-lane-notice__body"><%= [line.who_did_what, line.object_name, line.time_ago].compact_blank.join(' · ') %></p>
  <%= link_to t("views.organisations.notifications.pane.event_card.links.#{link_name}"), link_address,
              target: '_top', class: 'inbox-lane-notice__link' %>
</div>

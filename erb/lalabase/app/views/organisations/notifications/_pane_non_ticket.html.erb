<%# V1: only tickets get the pane pattern. Other notifiables
    (documents, posts, mentions without a ticket) need a
    hint + an "Im Ticket öffnen" link that navigates to the classic
    full view. See spec 4.6. %>
<%= turbo_frame_tag 'ticket_pane', class: 'block h-full' do %>
  <div class="h-full flex items-center justify-center p-8">
    <div class="text-center max-w-sm">
      <div class="w-16 h-16 mx-auto mb-4 bg-amber-50 border-2 border-amber-400 rounded-full flex items-center justify-center">
        <i class="bi bi-arrow-up-right text-2xl text-amber-600"></i>
      </div>
      <h3 class="text-lg font-bold text-gray-800 mb-2">
        <%= t('views.organisations.notifications.pane.non_ticket_title',
              default: 'Öffne diese Benachrichtigung in der Vollansicht') %>
      </h3>
      <p class="text-sm text-gray-600 mb-4">
        <%= t('views.organisations.notifications.pane.non_ticket_subtitle',
              default: 'Diese Art von Benachrichtigung wird (noch) nicht im Pane angezeigt.') %>
      </p>
      <% if @selected_notification %>
        <%= link_to notification_deeplink_path(@selected_notification, source: 'inbox'),
                    target: '_top',
                    class: 'inline-flex items-center gap-1.5 px-3 py-1.5 bg-amber-100 border-2 border-stroke rounded font-bold text-xs hover:bg-amber-200 transition-colors' do %>
          <i class="bi bi-box-arrow-up-right"></i>
          <%= t('views.organisations.notifications.pane.open_full_view') %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

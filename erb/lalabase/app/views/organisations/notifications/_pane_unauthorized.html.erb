<%= turbo_frame_tag 'ticket_pane', class: 'block h-full' do %>
  <div class="h-full flex items-center justify-center p-8">
    <div class="text-center max-w-sm">
      <div class="w-16 h-16 mx-auto mb-4 bg-red-50 border-2 border-red-400 rounded-full flex items-center justify-center">
        <i class="bi bi-shield-lock text-2xl text-red-500"></i>
      </div>
      <h3 class="text-lg font-bold text-gray-800 mb-2">
        <%= t('views.organisations.notifications.pane.unauthorized_title') %>
      </h3>
      <p class="text-sm text-gray-600">
        <%= t('views.organisations.notifications.pane.unauthorized_subtitle') %>
      </p>
    </div>
  </div>
<% end %>

<div id="notifications" class="space-y-2">
  <% if notifications.any? %>
    <% notifications.each do |notification| %>
      <div id="<%= dom_id(notification) %>" class="notification-item">
        <%= render partial: 'notifications/notification', locals: { notification: notification } %>
      </div>
    <% end %>
  <% else %>
    <div class="empty-state text-center py-12">
      <div class="text-gray-400 mb-4">
        <i class="bi bi-bell-slash w-12 h-12 mx-auto text-4xl"></i>
      </div>
      <h3 class="text-lg font-semibold text-gray-700 mb-2"><%= t('views.organisations.notifications.list.no_notifications') %></h3>
      <p class="text-gray-500"><%= t('views.organisations.notifications.list.all_caught_up') %></p>
    </div>
  <% end %>
</div>
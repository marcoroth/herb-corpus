<%= form_with model: [@current_organisation, membership], data: { action: 'change->membership-workspace#changeRole', turbo_frame: (membership.user_id == current_user.id ? '_top' : 'members_workspace') } do |form| %>
  <% membership_list_params.each do |key, value| %><%= hidden_field_tag key, value %><% end %>
  <%= form.select :role_id, options_for_select([[t('member_management.no_role'), '']] + @roles.map { |role| [membership_role_name(role), role.id] } + [[t('member_management.manage_roles'), '__manage__']], membership.role_id), {},
        id: "membership_#{membership.id}_role_#{location}", class: 'members-role-select', 'aria-label': t('member_management.role_for', name: viewer_display_name(membership.user)),
        data: { roles_url: organisation_roles_path(@current_organisation), previous_value: membership.role_id.to_s } %>
  <noscript><button type="submit"><%= t('member_management.apply') %></button></noscript>
<% end %>

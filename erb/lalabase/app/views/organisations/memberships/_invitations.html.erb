<section id="pending-invitations" class="mt-8" aria-labelledby="invitations-heading">
  <h3 id="invitations-heading" class="mb-3 text-sm font-semibold text-heading"><%= t('member_management.pending') %></h3>
  <ul><% @invitations.each do |invitation| %>
    <li class="members-invitation-row">
      <span class="min-w-0 flex-1 truncate text-sm text-heading"><%= invitation.email %></span>
      <span class="text-xs text-muted"><%= t('member_management.sent') %> <time class="font-mono"><%= invitation.sent_at ? l(invitation.sent_at.to_date, format: :default) : '–' %></time></span>
      <details class="more-menu" data-action="keydown.esc->membership-workspace#closeMenu">
        <summary class="more-menu__trigger" title="<%= t('member_management.actions_for', name: invitation.email) %>" aria-label="<%= t('member_management.actions_for', name: invitation.email) %>"><i class="bi bi-three-dots" aria-hidden="true"></i></summary>
        <div class="more-menu__items">
          <button type="button" data-action="membership-workspace#copyLink" data-url="<%= copy_link_organisation_invitation_path(@current_organisation, invitation) %>" data-copied="<%= t('member_management.copied') %>" data-error="<%= t('member_management.copy_failed') %>" aria-live="polite"><%= t('member_management.copy_link') %></button>
          <%= button_to t('member_management.resend'), resend_organisation_invitation_path(@current_organisation, invitation), form: { data: { turbo_confirm: t('member_management.confirm_resend', email: invitation.email) } } %>
          <%= button_to t('member_management.withdraw'), organisation_invitation_path(@current_organisation, invitation), method: :delete, class: 'more-menu__danger', form: { data: { turbo_confirm: t('member_management.confirm_withdraw', email: invitation.email) } } %>
        </div>
      </details>
    </li>
  <% end %></ul>
</section>

<div class="container mx-auto px-4 py-8">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-bold">New Tag</h1>
    <%= render(Neo::Buttons::ButtonComponent.new(variant: :secondary, url: organisation_tags_path(@current_organisation))) { "Back to Tags" } %>
  </div>

  <div class="rounded-lg border border-slate-200 shadow-sm bg-surface-raised p-6">
    <%= render 'form', tag: @tag %>
  </div>
</div>

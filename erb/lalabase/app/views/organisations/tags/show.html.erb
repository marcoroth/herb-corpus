<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold">Tag: <%= @tag.name %></h1>
      <div class="flex space-x-2">
        <%= render(Neo::Buttons::ButtonComponent.new(variant: :secondary, url: organisation_tags_path(@current_organisation))) { "Back to Tags" } %>
        <%= render(Neo::Buttons::ButtonComponent.new(variant: :primary, url: edit_organisation_tag_path(@current_organisation, @tag))) { "Edit Tag" } %>
      </div>
    </div>

    <div class="mt-4 border border-slate-200 rounded-lg shadow-sm bg-surface-raised p-4">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div>
          <p class="text-sm text-gray-500">Created at:</p>
          <p><%= @tag.created_at.strftime("%Y-%m-%d %H:%M") %></p>
        </div>
        <div>
          <p class="text-sm text-gray-500">Updated at:</p>
          <p><%= @tag.updated_at.strftime("%Y-%m-%d %H:%M") %></p>
        </div>
        <div>
          <p class="text-sm text-gray-500">Organisation:</p>
          <p><%= @tag.organisation&.name || "—" %></p>
        </div>
        <div>
          <p class="text-sm text-gray-500">Usage count:</p>
          <p><%= @tag.taggings.count %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-8">
    <h2 class="mb-4 text-xl font-semibold">Tagged Items</h2>

    <% if @taggables.empty? %>
      <div class="border border-slate-200 rounded-lg shadow-sm bg-surface-raised p-4 text-center">
        <p class="text-gray-500">No items are tagged with this tag.</p>
      </div>
    <% else %>
      <div class="overflow-hidden bg-surface-raised border border-slate-200 rounded-lg shadow-sm">
        <ul class="divide-y divide-gray-200">
          <% @taggables.each do |item| %>
            <li>
              <div class="block hover:bg-gray-50">
                <div class="px-4 py-4 sm:px-6">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                      <% case item.class.name %>
                      <% when "Note" %>
                        <%= render NeoTagComponent.new(text: "Note", variant: :warning, size: :small) %>
                        <%= link_to item.title, organisation_project_note_path(@current_organisation, item.project, item), class: "truncate text-sm font-medium text-cream-900 hover:underline" %>
                      <% when "Document" %>
                        <%= render NeoTagComponent.new(text: "Document", variant: :warning, size: :small) %>
                        <%= link_to item.title, organisation_project_document_path(@current_organisation, item.project, item), class: "truncate text-sm font-medium text-cream-900 hover:underline" %>
                      <% when "Ticket" %>
                        <%= render NeoTagComponent.new(text: "Ticket", variant: :warning, size: :small) %>
                        <%= link_to item.title, organisation_project_ticket_path(@current_organisation, item.project, item), class: "truncate text-sm font-medium text-cream-900 hover:underline" %>
                      <% end %>
                    </div>
                    <div class="flex flex-shrink-0 space-x-4">
                      <div class="flex-shrink-0 text-sm text-gray-500">
                        <%= item.project.name %>
                      </div>
                      <div class="flex-shrink-0 text-sm text-gray-500">
                        <%= item.updated_at.strftime("%Y-%m-%d %H:%M") %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      </div>

      <div class="mt-4">
        <%== pagy_nav(@pagy) if @pagy %>
      </div>
    <% end %>
  </div>
</div>

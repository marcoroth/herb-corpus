<div class="mb-4" style="padding-left: 2px;">
  <% # Only tags from projects accessible to the user (no org-wide tag leak) %>
  <% existing_tags = accessible_tag_names %>
  
  <%# Add both a visible field for tag-input and a regular form input for form submission %>
  <%# Use a regular text_field instead of hidden_field to ensure it's submitted and recognized %>
  <div style="padding: 1px;">
    <%= form.text_field :tag_list,
        id: "tag_input_visible",
        class: "tag-input",
        placeholder: t('views.organisations.tags.tag_form.placeholder'),
        value: taggable.tag_list.join(', '),
        data: {
          controller: "tag-input",
          tag_input_existing_tags_value: existing_tags.to_json
        }
    %>
  </div>
  <p class="mt-1 text-xs text-gray-500"><%= t('views.organisations.tags.tag_form.hint') %></p>
  
  <script>
    // Additional debugging for form submission
    document.addEventListener('DOMContentLoaded', function() {
      const tagInput = document.getElementById('tag_input_visible');
      const form = tagInput?.closest('form');
      
      if (form) {
        form.addEventListener('submit', function(e) {
          // Don't prevent default - just log what's being submitted
          console.log('Form submitting with tag value:', tagInput.value);
          console.log('Form data:', new FormData(form));
        });
      }
    });
  </script>
</div>
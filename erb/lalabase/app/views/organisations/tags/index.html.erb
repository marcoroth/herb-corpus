<div class="container mx-auto px-4 py-8">
  <div class="mb-6 flex flex-wrap items-center justify-between">
    <h1 class="text-2xl font-bold">Tags</h1>
    <div class="flex space-x-2">
      <%= form_with url: organisation_tags_path(@current_organisation), method: :get, class: "flex" do |f| %>
        <div class="mr-2">
          <%= f.text_field :search,
            placeholder: "Search tags...",
            value: params[:search],
            class: "w-full px-3 py-2 border border-slate-200 rounded text-sm focus:outline-none focus:shadow-sm focus:-translate-x-0.5 focus:-translate-y-0.5 transition-all" %>
        </div>
        <%= render(Neo::Buttons::ButtonComponent.new(variant: :primary, type: :submit)) { "Search" } %>
      <% end %>
      <%= render(Neo::Buttons::ButtonComponent.new(variant: :primary, url: new_organisation_tag_path(@current_organisation), class: "ml-4")) { "New Tag" } %>
    </div>
  </div>

  <div class="overflow-hidden bg-surface-raised border border-slate-200 rounded-lg shadow-sm">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-100 border-b border-slate-200">
        <tr>
          <%= render 'shared/sortable_header', title: "Name", column: "name" %>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">
            Usage Count
          </th>
          <%= render 'shared/sortable_header', title: "Created At", column: "created_at" %>
          <%= render 'shared/sortable_header', title: "Updated At", column: "updated_at" %>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">
            Actions
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 bg-surface-raised">
        <% @tags.each do |tag| %>
          <tr class="hover:bg-gray-50">
            <td class="whitespace-nowrap px-6 py-4">
              <%= link_to tag.name, organisation_tag_path(@current_organisation, tag), class: "text-cream-900 font-medium hover:underline" %>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
              <%= tag.taggings.count %>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
              <%= tag.created_at.strftime("%Y-%m-%d %H:%M") %>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
              <%= tag.updated_at.strftime("%Y-%m-%d %H:%M") %>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
              <div class="flex space-x-2">
                <%= link_to "Edit", edit_organisation_tag_path(@current_organisation, tag), class: "text-cream-900 font-medium hover:underline" %>
                <%= button_to "Delete", organisation_tag_path(@current_organisation, tag), method: :delete, data: { turbo_confirm: t('views.confirm.delete_tag') }, class: "text-red-600 hover:text-red-900 bg-transparent border-none p-0 cursor-pointer" %>
              </div>
            </td>
          </tr>
        <% end %>

        <% if @tags.empty? %>
          <tr>
            <td colspan="5" class="px-6 py-4 text-center text-sm text-gray-500">No tags found.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-4">
    <%== pagy_nav(@pagy) %>
  </div>
</div>

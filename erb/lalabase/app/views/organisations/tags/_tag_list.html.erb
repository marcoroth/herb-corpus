<div class="mb-4">
  <label class="block text-sm font-medium text-gray-700"><%= t('views.organisations.tags.tag_list.label') %></label>
  <div class="mt-1">
    <% if taggable.tags.any? %>
      <div class="flex flex-wrap gap-2">
        <% taggable.tags.each do |tag| %>
          <%= render NeoTagComponent.new(text: tag.name, variant: :warning, size: :small) %>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">No tags yet</p>
    <% end %>
  </div>
</div>
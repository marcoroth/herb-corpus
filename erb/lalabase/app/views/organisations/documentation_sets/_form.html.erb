<%# locals: documentation_set, repositories %>
<%= form_with model: documentation_set,
      url: (documentation_set.persisted? ?
             organisation_project_documentation_set_path(@current_organisation, @project, documentation_set) :
             organisation_project_documentation_sets_path(@current_organisation, @project)),
      method: (documentation_set.persisted? ? :patch : :post),
      class: "flex max-w-lg flex-col gap-4" do |f| %>

  <% if documentation_set.errors.any? %>
    <div class="rounded-md border border-red-900 bg-red-100 px-3 py-2 text-sm text-red-900">
      <%= documentation_set.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <label class="flex flex-col gap-1 text-sm">
    <span class="font-medium text-heading"><%= t('views.organisations.documentation.form.name') %></span>
    <%= f.text_field :name, class: "rounded-md border border-stroke px-3 py-1.5" %>
  </label>

  <label class="flex flex-col gap-1 text-sm">
    <span class="font-medium text-heading"><%= t('views.organisations.documentation.form.repository') %></span>
    <%= f.collection_select :project_repository_id, repositories, :id, :full_name,
          { prompt: t('views.organisations.documentation.form.repository_prompt') },
          { class: "rounded-md border border-stroke px-3 py-1.5" } %>
  </label>

  <label class="flex flex-col gap-1 text-sm">
    <span class="font-medium text-heading"><%= t('views.organisations.documentation.form.path_prefix') %></span>
    <%= f.text_field :path_prefix, class: "rounded-md border border-stroke px-3 py-1.5" %>
    <span class="text-xs text-muted"><%= t('views.organisations.documentation.form.path_prefix_hint') %></span>
  </label>

  <div class="flex items-center gap-2">
    <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, type: :submit) do %>
      <%= t('views.organisations.documentation.form.save') %>
    <% end %>
    <%= render(Neo::Buttons::ButtonComponent.new(
          variant: :secondary,
          url: organisation_project_documentation_index_path(@current_organisation, @project)
        )) { t('views.organisations.documentation.form.cancel') } %>
  </div>
<% end %>

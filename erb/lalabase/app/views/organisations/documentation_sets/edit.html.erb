<div class="flex flex-col gap-4">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-heading"><%= t('views.organisations.documentation.edit.title') %></h1>
    <%= render(Neo::Buttons::ButtonComponent.new(
          variant: :danger, icon: 'trash',
          confirm: t('views.organisations.documentation.edit.disconnect_confirm'),
          form: { action: organisation_project_documentation_set_path(@current_organisation, @project, @documentation_set), method: :delete }
        )) { t('views.organisations.documentation.edit.disconnect') } %>
  </div>

  <%= render 'form', documentation_set: @documentation_set, repositories: @repositories %>
</div>

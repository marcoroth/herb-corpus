<% content_for(:page_title, t('views.organisations.documentation.history.title')) %>

<div class="flex flex-col gap-6">
  <header class="flex flex-col gap-1">
    <%= link_to organisation_project_documentation_index_path(@current_organisation, @project, set_id: @documentation_set.id),
          class: "inline-flex items-center gap-1 text-sm text-muted" do %>
      <i class="bi bi-arrow-left"></i>
      <%= t('views.organisations.documentation.history.back') %>
    <% end %>
    <h1 class="text-2xl font-bold text-heading">
      <%= t('views.organisations.documentation.history.title') %>
    </h1>
    <p class="text-sm text-muted"><%= @documentation_set.name %></p>
  </header>

  <section class="flex flex-col gap-2">
    <h2 class="text-lg font-semibold text-heading">
      <%= t('views.organisations.documentation.history.commits_heading') %>
    </h2>

    <% if @commits.empty? %>
      <p class="text-sm text-muted"><%= t('views.organisations.documentation.history.commits_empty') %></p>
    <% else %>
      <ul class="flex flex-col divide-y divide-cream-300">
        <% @commits.each do |commit| %>
          <li class="flex flex-col gap-0.5 py-2.5">
            <span class="text-sm font-medium text-heading"><%= commit.message %></span>
            <span class="text-xs text-muted">
              <%= commit.author_name %>
              &middot; <%= l(commit.committed_at, format: :short) %>
              &middot; <code class="text-[11px]"><%= commit.short_sha %></code>
            </span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section class="flex flex-col gap-2">
    <h2 class="text-lg font-semibold text-heading">
      <%= t('views.organisations.documentation.history.runs_heading') %>
    </h2>

    <% if @sync_runs.empty? %>
      <p class="text-sm text-muted"><%= t('views.organisations.documentation.history.runs_empty') %></p>
    <% else %>
      <ul class="flex flex-col divide-y divide-cream-300">
        <% @sync_runs.each do |run| %>
          <li class="flex flex-wrap items-center gap-x-3 gap-y-1 py-2.5">
            <%= render Documentation::SyncStatusPillComponent.new(status: run.status) %>
            <span class="text-xs text-muted">
              <%= t("views.organisations.documentation.history.trigger.#{run.trigger}") %>
              <% if run.finished_at %>
                &middot; <%= l(run.finished_at, format: :short) %>
              <% end %>
              <% if run.duration_seconds %>
                &middot; <%= t('views.organisations.documentation.history.run_duration', seconds: run.duration_seconds) %>
              <% end %>
              <% if run.assets_synced.positive? %>
                &middot; <%= t('views.organisations.documentation.history.run_assets', count: run.assets_synced) %>
              <% end %>
              <% if run.assets_skipped.positive? %>
                &middot; <%= t('views.organisations.documentation.history.run_assets_skipped', count: run.assets_skipped) %>
              <% end %>
            </span>
            <% if run.failed? %>
              <span class="basis-full text-xs text-red-900">
                <%= documentation_sync_error_message(run.error_class) %>
              </span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</div>

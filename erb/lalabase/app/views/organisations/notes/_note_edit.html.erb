
<%# No turbo-frame tag here, as it's already in the parent view %>
<div id="note-card" class="relative">
  <% current_frame_id = local_assigns[:detail_frame_id] || 'note_display_frame' %>
  <%# The lane's head over the form too (S3): the type word and the ✕; the
      form's own actions stay at its foot. %>
  <%= render 'organisations/knowledge/lane_head', type_word: t('views.organisations.knowledge.knowledge_row.note_type') %>
  <%= form_with(model: [@current_organisation, @project, @note], format: :turbo_stream, data: { turbo_frame: current_frame_id }) do |form| %>
    <%= hidden_field_tag :frame_id, current_frame_id %>
    <%# Optimistic locking: carries the version the tab loaded, so a concurrent save in %>
    <%# another tab makes this one fail with StaleObjectError instead of silently overwriting. %>
    <%= form.hidden_field :lock_version %>
      <div class="relative">
        <div class="flex flex-col mb-4">
          <%= form.text_field :title,
              placeholder: t('views.organisations.notes.note_edit.title_placeholder'),
              class: 'w-full py-3 px-4 h-12 text-lg font-bold border border-cream-300 rounded focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink bg-surface-raised' %>
        </div>

        <!-- Tags -->
        <div class="mb-4">
          <%= render 'organisations/tags/tag_form', form: form, taggable: @note, model_name: 'note' %>
        </div>

        <div class="my-4">
          <%# lexxy-content (not Tailwind prose) is what Lexxy's content stylesheet is %>
          <%# scoped to (:where(.lexxy-content)) — incl. table cell borders. prose would %>
          <%# override those via higher specificity, leaving tables without a grid. %>
          <%# Image rule (RichTextEmbeds, D5) via lexxy_embed_editor_options; notes have no %>
          <%# attachment field, refused files only get the hint. %>
          <%= form.lexxy_rich_text_area :content,
                **lexxy_embed_editor_options,
                class: "lexxy-content
                  w-full
                  px-4
                  py-3
                  bg-surface-raised
                  border
                  border-cream-300
                  rounded
                  focus:outline-none
                  focus:border-ink
                  focus:ring-1
                  focus:ring-ink
                  min-h-[300px]
                " do %>
            <%# @-mention picker: policy-scoped note/document search (see MentionsController). %>
            <lexxy-prompt trigger="@" name="mention"
                          src="<%= organisation_project_mentions_path(@current_organisation, @project) %>"></lexxy-prompt>
          <% end %>
        </div>

        <%# No indexing switch (doc/notizen_immer_indexiert_plan.md): a note is
            indexed like a ticket, whenever the organisation's embedding lane is
            usable; the seam (EmbeddingProcessingService) decides, not the writer. %>
        <!-- Button Container -->
        <div class="flex justify-between items-center mt-6">
          <div>
            <% if policy(@note).destroy? %>
              <%= render Neo::Buttons::ButtonComponent.new(
                variant: :danger,
                icon: "trash",
                confirm: t('views.confirm.are_you_sure'),
                form: {
                  action: organisation_project_note_path(@current_organisation, @project, @note),
                  method: :delete
                }
              ) do %>
                <%= t('views.organisations.notes.note_edit.delete') %>
              <% end %>
            <% end %>
          </div>

          <div class="flex gap-2">
            <%= render Neo::Buttons::ButtonComponent.new(
              variant: :edit,
              url: organisation_project_note_path(@current_organisation, @project, @note, format: :turbo_stream, frame_id: current_frame_id),
              data: { turbo_frame: current_frame_id }
            ) do %>
              <%= t('views.organisations.notes.note_edit.cancel') %>
            <% end %>

            <%= render Neo::Buttons::ButtonComponent.new(
              variant: :primary,
              type: "submit"
            ) do %>
              <%= t('views.organisations.notes.note_edit.save') %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

<%# One quiet column header for the rows layouts (desktop only): labels the Aufgaben / Meine To-dos
    columns ONCE instead of repeating them on every row (the per-row labels read as noise). Mirrors
    the row grid (org w-1/3 spacer + flex-1 columns, gap-6) so the labels sit over their columns.
    Locals: show_actions, show_todos. %>
<div class="hidden md:flex gap-6 px-4 py-2">
  <div class="w-1/3 flex-shrink-0"></div>
  <% if show_actions %>
    <div class="flex-1 font-black uppercase text-[10px] tracking-tight text-cream-500">
      <%= t('views.organisations.select.cockpit.rows.tasks') %>
    </div>
  <% end %>
  <% if show_todos %>
    <div class="flex-1 font-black uppercase text-[10px] tracking-tight text-cream-500">
      <%= t('views.organisations.select.cockpit.rows.todos') %>
    </div>
  <% end %>
</div>

<div class="pt-6">
  <%= render NeoTitleBoxComponent.new(
    title: t('.title'),
    variant: :organisation
  ) do |component| %>
    <% component.with_right_content do %>
      <%= render Neo::Buttons::HeaderButtonComponent.new(
        variant: :secondary,
        icon: "arrow-left",
        label: t('.back'),
        url: organisation_memberships_path(@current_organisation)
      ) %>
    <% end %>
  <% end %>

  <div class="max-w-2xl mt-6">
    <%= form_with model: [@current_organisation, @invitation], local: true do |form| %>
      <% if @invitation.errors.any? %>
        <div class="mb-4 p-4 bg-red-50 border-l-4 border-red-400 rounded">
          <div class="flex">
            <div class="flex-shrink-0">
              <i class="bi bi-exclamation-triangle text-red-400"></i>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-red-800">
                <%= t('.errors_prevent_save', count: @invitation.errors.count) %>
              </h3>
              <div class="mt-2 text-sm text-red-700">
                <ul class="list-disc list-inside">
                  <% @invitation.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Email field -->
      <div class="mb-4">
        <%= form.label :email, t('.email_label'), class: "block text-sm font-medium text-cream-700 mb-1" %>
        <%= form.email_field :email,
            class: "mt-1 block w-full px-3 py-2 bg-surface-raised border border-cream-300 rounded focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all sm:text-sm",
            placeholder: t('.email_placeholder'),
            required: true %>
      </div>

      <%# D1: Cancel secondary on the left, Send primary on the right — both ButtonComponent (P4), same size :large (h-10) as the Back header. %>
      <div class="flex items-center justify-end gap-3">
        <%= render Neo::Buttons::ButtonComponent.new(
          variant: :secondary,
          size: :large,
          url: organisation_memberships_path(@current_organisation)
        ) do %>
          <%= t('.cancel') %>
        <% end %>

        <%= render Neo::Buttons::ButtonComponent.new(
          variant: :primary,
          size: :large,
          icon: "envelope",
          tag: :button,
          type: 'submit'
        ) do %>
          <%= t('.send_invitation') %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<%# The meeting or the participant is no longer in this project (moved or deleted while its row
    was open). The answer goes into the dialog's frame, by the meeting id of the route, so the
    row says why instead of Turbo's "Content missing". %>
<%= turbo_frame_tag participant_link_modal_id(@meeting_id) do %>
  <p class="participant-link-gone mt-1 text-sm text-red-800" role="alert"><%= @errors.to_sentence %></p>
<% end %>

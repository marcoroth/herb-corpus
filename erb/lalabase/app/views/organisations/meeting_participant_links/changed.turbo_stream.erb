<%# A participant of THIS meeting was linked or unlinked: the dialog instance that sent it
    removed (its controller then empties the frame and returns the focus), the participant
    row redrawn, the flash. %>
<% if @modal_token %>
  <%= turbo_stream.remove participant_link_modal_instance_id(@meeting.id, @modal_token) %>
<% end %>
<%= render 'organisations/meeting_participant_links/row_stream', meeting: @meeting %>
<%= turbo_stream.prepend 'flash', partial: 'layouts/flash', locals: { flash: @flash_message } %>

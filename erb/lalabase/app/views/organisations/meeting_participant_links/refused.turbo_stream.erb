<%# The link was refused (nothing picked, someone already in the meeting, no right to create
    a person; not found answers with gone instead): the dialog again with the reason and what
    was picked, in place of the instance that sent it. A dialog closed meanwhile has no such element and stays
    closed. Without a usable token there is no instance to fill: the reason goes out as a
    flash, and the row shows the state as it is now. %>
<% if @modal_token %>
  <%= turbo_stream.replace participant_link_modal_instance_id(@meeting.id, @modal_token) do %>
    <%= render 'organisations/meeting_participant_links/modal',
               meeting: @meeting, participant: @participant, token: @modal_token,
               choice: @choice, new_person_name: @new_person_name, errors: @errors %>
  <% end %>
<% else %>
  <%= render 'organisations/meeting_participant_links/row_stream', meeting: @meeting %>
  <%= turbo_stream.prepend 'flash', partial: 'layouts/flash', locals: { flash: { alert: @errors.to_sentence } } %>
<% end %>

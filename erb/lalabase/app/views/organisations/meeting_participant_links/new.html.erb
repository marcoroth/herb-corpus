<%# The dialog "Mit Person verknüpfen", loaded into its frame by a trigger of the participant
    row (layout: false, only the frame counts). See _modal. %>
<%= turbo_frame_tag participant_link_modal_id(@meeting.id) do %>
  <%= render 'organisations/meeting_participant_links/modal',
             meeting: @meeting, participant: @participant, token: @modal_token, query: @query %>
<% end %>

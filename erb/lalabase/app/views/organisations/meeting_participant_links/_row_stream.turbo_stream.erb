<%# locals: (meeting:) %>
<%# The chips of this meeting as they are now, wherever the page shows them (the meeting's
    page or the panel beside a ticket). Only the chips: the dialog frame beside them stays, so
    this answer cannot close a dialog opened after it was sent. %>
<% participants = meeting.meeting_participants.in_row_order.to_a %>
<%= turbo_stream.replace meeting_participant_chips_id(meeting),
                         partial: 'organisations/meetings/participant_chips',
                         locals: { meeting: meeting, participants: participants,
                                   people: meeting_participant_people(meeting, participants) } %>

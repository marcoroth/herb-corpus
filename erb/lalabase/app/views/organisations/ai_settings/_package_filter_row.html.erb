<%# One row of the §7.1 two-filter bar. Locals: label, param, current, values
    ([value, text] pairs) and base_params (the currently active pair, so flipping
    one filter never resets the other).

    Plain links, not a JS-driven control: the whole filter state is two query
    params, which makes it bookmarkable, back-button-correct and directly
    assertable in a request spec — and Turbo Drive already makes it feel local.
    The anchor keeps the catalogue in view instead of jumping to the page top. %>
<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
  <span class="text-sm font-bold text-cream-900 md:w-32 shrink-0"><%= label %></span>
  <% values.each do |value, text| %>
    <% active = current == value %>
    <%= link_to organisation_ai_settings_path(@organisation,
                                              base_params.merge(param => value, anchor: 'ai_packages')),
                class: "inline-flex items-center px-3 py-1.5 rounded text-sm transition-all #{
                  active ? 'border-2 border-ink bg-ink text-cream-50 font-bold'
                         : 'border border-cream-300 bg-surface-raised text-cream-800 hover:border-ink'
                }",
                aria: { current: active ? 'true' : nil } do %>
      <%= text %>
    <% end %>
  <% end %>
</div>

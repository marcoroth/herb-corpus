<div class="pt-6">
  <%= render NeoTitleBoxComponent.new(
    title: t('.title'),
    variant: :organisation
  ) do |component| %>
    <% component.with_right_content do %>
      <%= render Neo::Buttons::HeaderButtonComponent.new(
        variant: :secondary,
        icon: "arrow-left",
        label: t('.back'),
        url: organisation_roles_path(@current_organisation)
      ) %>
    <% end %>
  <% end %>

<% if notice %>
  <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4" role="alert">
    <%= notice %>
  </div>
<% end %>

<% if alert %>
  <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4" role="alert">
    <%= alert %>
  </div>
<% end %>

  <!-- Form -->
  <%# Capped and on the page edge (layout.css, "Page widths"), not centred. %>
  <div class="width-capped mt-6">
    <%= form_with(model: [@current_organisation, @role], local: true) do |form| %>
      <% if @role.errors.any? %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4" role="alert">
          <h2 class="font-bold"><%= t('.errors_prevent_save', count: @role.errors.count) %></h2>
          <ul class="list-disc list-inside">
            <% @role.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Grundlegende Informationen -->
      <div class="bg-cream-50 border border-cream-300 rounded-lg p-6 mb-6">

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= form.label :title, t('.title_label'), class: 'block text-sm font-medium text-cream-700 mb-2' %>
          <%= form.text_field :title,
              class: 'w-full px-3 py-2 border border-cream-300 bg-surface-raised rounded text-sm focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all' %>
        </div>

        <div class="md:col-span-2">
          <%= form.label :description, t('.description_label'), class: 'block text-sm font-medium text-cream-700 mb-2' %>
          <%= form.text_area :description, rows: 3,
              class: 'w-full px-3 py-2 border border-cream-300 bg-surface-raised rounded text-sm focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all' %>
        </div>
      </div>

      <div class="mt-4 p-3 bg-cream-100 border border-cream-300 rounded">
        <p class="text-sm text-cream-700 flex items-center">
          <i class="bi bi-info-circle mr-2"></i>
          <%= t('.permissions_info') %>
        </p>
      </div>
    </div>

    <!-- Footer mit Buttons -->
    <div class="flex items-center justify-end gap-4">
      <%= render Neo::Buttons::ButtonComponent.new(variant: :secondary,
            url: organisation_roles_path(@current_organisation)) do %>
        <%= t('.cancel') %>
      <% end %>

      <%= render Neo::Buttons::ButtonComponent.new(
        variant: :primary,
        icon: "plus-lg",
        tag: :button,
        type: 'submit'
      ) do %>
        <%= t('.create_role') %>
      <% end %>
    </div>
    <% end %>
  </div>
</div>

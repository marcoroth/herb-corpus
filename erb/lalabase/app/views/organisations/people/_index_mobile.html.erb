<%# locals: (list:, lane:, open:) %>
<%# Mobile: the list, or the person (or the form) full screen with a way back,
    as on the meetings pages. Same frame id as on the desktop. %>
<div class="people-mobile-grid list">
  <%= render NeoMobileTicketViewComponent.new(
    selected_item: (open || nil),
    show_detail: open,
    back_url: organisation_people_path(@current_organisation, list_state),
    back_label: t('views.organisations.people.index.back_to_list')
  ) do |mobile| %>
    <% mobile.with_list do %>
      <%= list %>
    <% end %>

    <% mobile.with_detail do %>
      <turbo-frame id="<%= Organisations::PeopleController::DETAIL_FRAME_ID %>">
        <%= lane %>
      </turbo-frame>
    <% end %>
  <% end %>
</div>

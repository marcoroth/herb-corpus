<%# locals: (member:, url: nil, link: nil) %>
<%# A member whose details are still empty: say what is missing, and offer to
    add it to those who may write. %>
<div class="people-callout people-callout--quiet">
  <div class="people-callout__body">
    <p><%= t('views.organisations.people.show.bare_text', first_name: viewer_display_name(member)) %></p>
    <% if url || link %>
      <%= link_to(link ? link[:href] : url, class: 'people-secondary-action', data: link&.dig(:data)) do %>
        <i class="bi bi-pencil" aria-hidden="true"></i><%= t('views.organisations.people.show.add_details') %>
      <% end %>
    <% end %>
  </div>
</div>

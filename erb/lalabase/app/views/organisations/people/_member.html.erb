<%# locals: (member:) %>
<%# A member who has no row of their own yet: name and email from the account,
    and the invitation to add the details. "Angaben ergänzen" opens the form
    with the member chosen (?new=person&user_id=). The same order as a person
    row (_detail), without history: nothing was changed yet. %>
<% can_write = policy(Person).create? %>
<% add_link = add_member_details_link(member) if can_write %>
<div class="people-detail">
  <%= render 'organisations/people/lane_head', edit_link: add_link %>
  <div class="people-detail__body width-text">
    <%= render 'organisations/people/identity', name: viewer_display_name(member), user: member, line: person_kind_line(nil, member) %>
    <%= render 'organisations/people/bare_hint', member: member, link: add_link %>
    <%= render 'organisations/people/fields', fields: person_fields(nil, member) %>
    <%= render 'organisations/people/contact_summary', member: member,
                                                       more_url: member_organisation_people_path(@current_organisation, member.id, list_state.merge('meetings' => 'all')) %>
    <% membership = Membership.find_by(organisation: @current_organisation, user: member) %>
    <% if membership || !can_write %>
      <div class="people-footer">
        <% if membership %>
          <p class="people-history__line"><%= t('views.organisations.people.show.from_account', date: l(membership.created_at.to_date, format: :default)) %></p>
        <% end %>
        <% unless can_write %>
          <p class="people-footer__readonly"><%= t('views.organisations.people.show.read_only') %></p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<%# locals: (name:, line:, user: nil) %>
<%# The big avatar, the name, and one line under it: what the person is and
    the company (person_kind_line). %>
<div class="people-identity">
  <%= render Neo::Users::AvatarComponent.new(user: user, size: :large, fallback_initials: person_initials(name),
                                              class: "people-avatar #{'people-avatar--contact' unless user}") %>
  <div class="people-identity__text">
    <h2 class="people-identity__name"><%= name %></h2>
    <p class="people-identity__line"><%= line %></p>
  </div>
</div>

<%# locals: (fields:) %>
<%# Label and value per line; email and phone are links. The label says what
    a value is, so the desktop shows no icon before it. On a phone they are
    large tap targets instead ("anrufen"), with the icon. An additional
    detail that is a web address (external) opens in a new tab, without the
    opener. %>
<% if @viewport_mode == 'mobile' %>
  <% plain, links = fields.partition { |field| field[:href].nil? } %>
  <% if plain.any? %>
    <dl class="people-fields">
      <% plain.each do |field| %>
        <div class="people-fields__row people-fields__row--stacked"><dt><%= field[:label] %></dt><dd><%= field[:value] %></dd></div>
      <% end %>
    </dl>
  <% end %>
  <% links.each do |field| %>
    <%= link_to field[:href], class: 'people-tap',
                              **(field[:external] ? { target: '_blank', rel: 'noopener noreferrer' } : {}) do %>
      <i class="bi <%= field[:icon] %>" aria-hidden="true"></i><%= field[:value] %>
      <% if field[:action] %><span class="people-tap__hint"><%= field[:action] %></span><% end %>
    <% end %>
  <% end %>
<% elsif fields.any? %>
  <dl class="people-fields">
    <% fields.each do |field| %>
      <div class="people-fields__row">
        <dt><%= field[:label] %></dt>
        <dd>
          <% if field[:href] %>
            <%= link_to field[:value], field[:href], class: 'people-fields__link',
                                                     **(field[:external] ? { target: '_blank', rel: 'noopener noreferrer' } : {}) %>
          <% else %>
            <%= field[:value] %>
          <% end %>
        </dd>
      </div>
    <% end %>
  </dl>
<% end %>

<%# locals: (state:, person: nil, member: nil, message: nil) %>
<%# What the lane frame holds: a person row (:detail), a member without a row
    (:member), the form (:form, new or edit), or nothing yet (:empty).
    Rendered by the index on a full visit and alone for a frame request.
    person-content marks LOADED content for layout-toggle and index-page; the
    empty lane must not carry it, or they open an empty column. %>
<div class="<%= 'person-content' unless state == :empty %> people-lane min-w-0 relative">
  <% if state == :detail %>
    <%= render 'organisations/people/detail', person: person %>
  <% elsif state == :member %>
    <%= render 'organisations/people/member', member: member %>
  <% elsif state == :form %>
    <%= render 'organisations/people/form', person: person, message: message %>
  <% else %>
    <div id="person-display-placeholder" class="ticket-placeholder px-4 py-10 text-center">
      <h2 class="text-lg font-semibold text-heading"><%= t('views.organisations.people.index.placeholder_title') %></h2>
      <p class="text-sm text-muted"><%= t('views.organisations.people.index.placeholder_body') %></p>
    </div>
  <% end %>
</div>

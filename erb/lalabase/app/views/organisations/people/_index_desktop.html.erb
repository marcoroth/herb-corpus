<%# locals: (list:, lane:, open:) %>
<%# Desktop: list and lane side by side (NeoTwoColumnGridComponent, lane: true). %>
<%= render NeoTwoColumnGridComponent.new(
  selected_item: (open || nil),
  context_type: :people,
  css_classes: "#{open ? 'show-content' : 'hide-content'} hide-panel",
  additional_targets: { "index-page-target" => "layout" },
  chrome_height: NeoTwoColumnGridComponent::LANE_CHROME_HEIGHT_PX,
  lane: true
) do |grid| %>
  <% grid.with_list do %>
    <%= list %>
  <% end %>

  <% grid.with_main_content do %>
    <turbo-frame id="<%= Organisations::PeopleController::DETAIL_FRAME_ID %>">
      <%= lane %>
    </turbo-frame>
  <% end %>
<% end %>

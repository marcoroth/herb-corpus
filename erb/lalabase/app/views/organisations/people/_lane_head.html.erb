<%# locals: (edit_url: nil, edit_link: nil, menu: nil) %>
<%# The head of an open person: "Bearbeiten" for those who may write, the
    rarer actions behind "···" (menu: the items, captured by the caller), and
    the way out. What the person is stands under the name, not here. The ✕
    closes the lane in place (layout-toggle); on a phone the mobile view
    brings its own way back. %>
<div class="people-lane__head" data-lane-head data-lane-index-url="<%= organisation_people_path(@current_organisation) %>">
  <% if edit_url || edit_link %>
    <%= link_to(edit_link ? edit_link[:href] : edit_url, class: 'people-ghost-action', data: edit_link&.dig(:data)) do %>
      <i class="bi bi-pencil" aria-hidden="true"></i><%= t('views.organisations.people.show.edit') %>
    <% end %>
  <% end %>
  <% if menu.present? %>
    <details class="more-menu" data-controller="details-autoclose">
      <summary class="more-menu__trigger" title="<%= t('views.organisations.people.show.more_actions') %>"
               aria-label="<%= t('views.organisations.people.show.more_actions') %>"><i class="bi bi-three-dots" aria-hidden="true"></i></summary>
      <div class="more-menu__items"><%= menu %></div>
    </details>
  <% end %>
  <% unless @viewport_mode == 'mobile' %>
    <span class="people-lane__divider" aria-hidden="true"></span>
    <button type="button" class="people-icon-action" title="<%= t('views.organisations.people.show.close') %>"
            data-lane-close data-action="click->layout-toggle#closeContent">
      <i class="bi bi-x-lg" aria-hidden="true"></i>
    </button>
  <% end %>
</div>

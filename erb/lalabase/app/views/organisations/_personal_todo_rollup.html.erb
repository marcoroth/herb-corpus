<%# Cross-org personal To-Do roll-up on the cockpit. User-private (owner only), read-only: a quiet
    glance at open to-dos across orgs. Triage (add / check / delete) lives in the Notizblock drawer,
    not here. `rollup` = Dashboard::PersonalTaskRollup. Renders nothing when there is nothing open
    (the cockpit does not nag). Priority colours reuse the Notizblock helpers (amber/red, never lime;
    colour is never the only signal — the dot carries a title). %>
<% if rollup.any? %>
  <section class="mb-12" aria-labelledby="cockpit-todos-heading">
    <h2 id="cockpit-todos-heading" class="font-black uppercase text-xs tracking-tight mb-3 text-cream-500">
      <%= t('views.organisations.select.todos.heading') %>
    </h2>

    <div class="space-y-6">
      <% rollup.slices.each do |organisation, tasks| %>
        <div>
          <h3 class="text-sm font-bold text-cream-700 mb-2 truncate"><%= organisation.name %></h3>
          <ul class="divide-y divide-cream-200 border border-cream-300 rounded-lg bg-cream-50 overflow-hidden">
            <% tasks.each do |task| %>
              <li class="flex items-center gap-3 px-4 py-2.5">
                <% if personal_task_priority_filled?(task) %>
                  <i class="bi bi-circle-fill text-[0.5rem] <%= personal_task_priority_classes(task) %> flex-shrink-0"
                     title="<%= t("views.organisations.select.todos.priority.#{task.priority}") %>"></i>
                <% else %>
                  <i class="bi bi-circle text-[0.5rem] text-cream-300 flex-shrink-0" aria-hidden="true"></i>
                <% end %>
                <span class="flex-1 text-sm text-cream-900"><%= task.title %></span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

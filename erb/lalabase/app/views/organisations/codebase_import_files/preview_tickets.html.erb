<div class="container mx-auto px-4 py-8">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="border-stroke rounded-lg border bg-surface-raised p-6 mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-semibold text-cream-900 mb-2"><%= t('views.organisations.codebase_import_files.preview_tickets.title') %></h1>
          <p class="text-cream-900">
            <%= t('views.organisations.codebase_import_files.preview_tickets.subtitle', count: @ticket_count) %>
          </p>
        </div>
        <%= render Neo::Buttons::ButtonComponent.new(variant: :secondary, size: :medium, icon: "arrow-left",
              url: organisation_codebase_import_file_path(current_organisation, @import_file)) do %>
          <%= t('views.organisations.codebase_import_files.preview_tickets.back') %>
        <% end %>
      </div>
    </div>

    <%= form_with url: execute_tickets_import_organisation_codebase_import_file_path(current_organisation, @import_file),
                  method: :post,
                  local: true,
                  data: { turbo_confirm: t('views.confirm.start_ticket_import') } do |form| %>

      <!-- Projekt-Name Eingabe -->
      <div class="border-stroke rounded-lg border bg-surface-raised p-6 mb-8">
        <h2 class="text-xl font-semibold text-cream-900 mb-4"><%= t('views.organisations.codebase_import_files.preview_tickets.new_project') %></h2>
        <div class="mb-4">
          <label for="project_name" class="block text-sm font-medium text-cream-900 mb-2">
            <%= t('views.organisations.codebase_import_files.preview_tickets.project_name') %>
          </label>
          <%= form.text_field :project_name,
              value: @suggested_project_name,
              class: "w-full px-3 py-2 border border-slate-200 rounded focus:outline-none focus:ring-2 focus:ring-cobalt-500",
              placeholder: t('views.organisations.codebase_import_files.preview_tickets.project_name_placeholder'),
              required: true %>
          <p class="mt-2 text-sm text-gray-600">
            <%= t('views.organisations.codebase_import_files.preview_tickets.project_auto_create') %>
          </p>
        </div>
      </div>

      <!-- Custom Attributes Preview Section -->
      <% @custom_attribute_mappings.each do |attribute_type, mapping_data| %>
        <div class="border-stroke rounded-lg border bg-surface-raised p-6 mb-8">
          <h2 class="text-xl font-semibold text-cream-900 mb-4">
            <i class="bi bi-tag text-xl mr-2 <%= attribute_type == 'status' ? 'text-cobalt-600' : 'text-yellow-600' %>"></i>
            <%= t('views.organisations.codebase_import_files.preview_tickets.values_from_import', name: mapping_data[:attribute_name]) %>
          </h2>

          <% if mapping_data[:values].any? %>
            <p class="text-sm text-cream-900/70 mb-4">
              <%= t('views.organisations.codebase_import_files.preview_tickets.values_auto_create_desc') %>
            </p>

            <div class="flex flex-wrap gap-2">
              <% mapping_data[:values].each do |value| %>
                <span class="inline-flex items-center px-3 py-1 text-sm font-medium <%= attribute_type == 'status' ? 'bg-cobalt-100 text-cobalt-800 border-cobalt-300' : 'bg-yellow-100 text-yellow-800 border-yellow-300' %> border rounded">
                  <i class="bi bi-plus-lg text-base mr-1 text-green-600"></i>
                  <%= value %>
                </span>
              <% end %>
            </div>

            <div class="mt-4 p-3 bg-green-50 border border-green-200 rounded">
              <div class="flex items-start">
                <i class="bi bi-check-circle text-xl text-green-600 mt-0.5 mr-2"></i>
                <div>
                  <p class="text-sm font-medium text-green-800"><%= t('views.organisations.codebase_import_files.preview_tickets.auto_creation') %></p>
                  <p class="text-sm text-green-600">
                    <%= t('views.organisations.codebase_import_files.preview_tickets.auto_creation_desc', count: mapping_data[:values].count, name: mapping_data[:attribute_name]) %>
                  </p>
                </div>
              </div>
            </div>
          <% else %>
            <div class="p-4 bg-yellow-50 border border-yellow-200 rounded">
              <p class="text-sm text-yellow-800"><%= t('views.organisations.codebase_import_files.preview_tickets.no_values_found', name: mapping_data[:attribute_name]) %></p>
            </div>
          <% end %>
        </div>
      <% end %>

      <!-- User References Section -->
      <div class="border-stroke rounded-lg border bg-surface-raised p-6 mb-8">
        <h2 class="text-xl font-semibold text-cream-900 mb-4"><%= t('views.organisations.codebase_import_files.preview_tickets.user_references_status') %></h2>

        <% if @user_mappings.any? %>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <% @user_mappings.each do |codebase_user_id, mapping| %>
              <div class="border border-stroke rounded p-3 <%= mapping ? 'bg-green-50' : 'bg-red-50' %>">
                <div class="flex items-center justify-between">
                  <div>
                    <div class="font-medium text-sm"><%= t('views.organisations.codebase_import_files.preview_tickets.codebase_user_id', id: codebase_user_id) %></div>
                    <% if mapping %>
                      <div class="text-xs text-green-700">
                        <%= t('views.organisations.codebase_import_files.preview_tickets.mapped_to', type: mapping.entity_type, id: mapping.local_id) %>
                      </div>
                    <% else %>
                      <div class="text-xs text-red-700">
                        <%= t('views.organisations.codebase_import_files.preview_tickets.not_found_null') %>
                      </div>
                    <% end %>
                  </div>
                  <div>
                    <% if mapping %>
                      <i class="bi bi-check-circle-fill text-green-600"></i>
                    <% else %>
                      <i class="bi bi-exclamation-triangle-fill text-red-600"></i>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <div class="mt-4 py-2.5 px-4 rounded text-sm border border-slate-200 bg-cobalt-100 text-cream-900 shadow-sm">
            <div class="flex items-center gap-1">
              <i class="bi bi-info-circle text-lg me-3"></i>
              <span><%= t('views.organisations.codebase_import_files.preview_tickets.user_ref_note_html') %></span>
            </div>
          </div>
        <% else %>
          <p class="text-cream-900/70"><%= t('views.organisations.codebase_import_files.preview_tickets.no_user_references') %></p>
        <% end %>
      </div>

      <!-- Tag Import Options -->
      <%
        tickets_with_tags = @parsed_data.select { |t| t[:tags].present? }
        all_tags = tickets_with_tags.flat_map { |t| t[:tags].split(/\s+/) }.map(&:downcase).uniq
      %>
      <% if tickets_with_tags.any? %>
        <div class="border-stroke rounded-lg border bg-surface-raised p-6 mb-8">
          <h2 class="text-xl font-semibold text-cream-900 mb-4 flex items-center gap-2">
            <i class="bi bi-tag text-xl"></i>
            <%= t('views.organisations.codebase_import_files.preview_tickets.tag_import_settings') %>
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
            <div class="text-center p-4 bg-cobalt-50 border border-cobalt-200 rounded">
              <p class="text-2xl font-bold text-cobalt-600">
                <%= tickets_with_tags.count %>
              </p>
              <p class="text-sm text-cobalt-600"><%= t('views.organisations.codebase_import_files.preview_tickets.tickets_with_tags') %></p>
            </div>
            <div class="text-center p-4 bg-green-50 border border-green-200 rounded">
              <p class="text-2xl font-bold text-green-600">
                <%= all_tags.count %>
              </p>
              <p class="text-sm text-green-600"><%= t('views.organisations.codebase_import_files.preview_tickets.unique_tags') %></p>
            </div>
            <div class="text-center p-4 bg-purple-50 border border-purple-200 rounded">
              <p class="text-2xl font-bold text-purple-600">
                <%= tickets_with_tags.sum { |t| t[:tags].split(/\s+/).count } %>
              </p>
              <p class="text-sm text-purple-600"><%= t('views.organisations.codebase_import_files.preview_tickets.total_tag_assignments') %></p>
            </div>
          </div>

          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <%= form.check_box :include_tags,
                                 { class: "mt-1" },
                                 true, false %>
              <div>
                <label for="include_tags" class="text-sm font-medium text-cream-900 cursor-pointer">
                  <%= t('views.organisations.codebase_import_files.preview_tickets.import_tags') %>
                </label>
                <p class="text-xs text-cream-900/60 mt-1">
                  <%= t('views.organisations.codebase_import_files.preview_tickets.import_tags_desc') %>
                </p>
              </div>
            </div>

            <% if all_tags.any? %>
              <div class="bg-gray-50 border border-gray-200 rounded p-4">
                <h5 class="text-sm font-medium text-cream-900/70 mb-3"><%= t('views.organisations.codebase_import_files.preview_tickets.tag_preview') %></h5>
                <div class="flex flex-wrap gap-2">
                  <% all_tags.first(15).each do |tag| %>
                    <span class="inline-flex items-center px-2 py-1 text-xs font-medium bg-cobalt-100 text-cobalt-800 border border-cobalt-300 rounded">
                      <%= tag %>
                    </span>
                  <% end %>
                  <% if all_tags.count > 15 %>
                    <span class="inline-flex items-center px-2 py-1 text-xs font-medium bg-gray-100 text-gray-600 border border-gray-300 rounded">
                      <%= t('views.organisations.codebase_import_files.preview_tickets.more_tags', count: all_tags.count - 15) %>
                    </span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Import Summary and Action -->
      <div class="border-stroke rounded-lg border bg-surface-raised p-6">
        <h2 class="text-xl font-semibold text-cream-900 mb-4"><%= t('views.organisations.codebase_import_files.preview_tickets.import_summary') %></h2>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
          <div class="text-center p-4 border border-stroke rounded bg-lime-100">
            <div class="text-2xl font-semibold text-cream-900"><%= @parsed_data.count %></div>
            <div class="text-sm text-cream-900/70"><%= t('views.organisations.codebase_import_files.preview_tickets.stat_tickets') %></div>
          </div>
          <div class="text-center p-4 border border-stroke rounded bg-cobalt-100">
            <div class="text-2xl font-semibold text-cream-900">
              <%= (@custom_attribute_mappings.dig(:status, :values) || []).count %>
            </div>
            <div class="text-sm text-cream-900/70"><%= t('views.organisations.codebase_import_files.preview_tickets.stat_status_values') %></div>
          </div>
          <div class="text-center p-4 border border-stroke rounded bg-yellow-100">
            <div class="text-2xl font-semibold text-cream-900">
              <%= (@custom_attribute_mappings.dig(:priority, :values) || []).count %>
            </div>
            <div class="text-sm text-cream-900/70"><%= t('views.organisations.codebase_import_files.preview_tickets.stat_priority_values') %></div>
          </div>
          <div class="text-center p-4 border border-stroke rounded bg-gray-100">
            <div class="text-2xl font-semibold text-cream-900">
              <%= @parsed_data.sum { |t| t[:updates].length } %>
            </div>
            <div class="text-sm text-cream-900/70"><%= t('views.organisations.codebase_import_files.preview_tickets.stat_ticket_updates') %></div>
          </div>
        </div>

        <div class="flex justify-between items-center">
          <div class="py-2.5 px-4 rounded text-sm border border-slate-200 bg-green-100 text-cream-900 shadow-sm">
            <div class="flex items-center gap-1">
              <i class="bi bi-check-circle text-lg me-3"></i>
              <span><%= t('views.organisations.codebase_import_files.preview_tickets.ready_for_import_html') %></span>
            </div>
          </div>

          <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, size: :large, icon: "download", tag: :button, type: 'submit') do %>
            <%= t('views.organisations.codebase_import_files.preview_tickets.start_ticket_import') %>
          <% end %>
        </div>
      </div>

    <% end %>
  </div>
</div>

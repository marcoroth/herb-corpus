<% content_for :title, t('views.organisations.codebase_import_files.rollback.page_title') %>

<div class="max-w-4xl mx-auto py-6">
  <div class="bg-surface-raised shadow rounded-lg">
    <div class="px-6 py-4 border-b border-gray-200">
      <h1 class="text-2xl font-semibold text-gray-900"><%= t('views.organisations.codebase_import_files.rollback.title') %></h1>
      <p class="mt-1 text-sm text-gray-600">
        <%= t('views.organisations.codebase_import_files.rollback.subtitle') %>
      </p>
    </div>

    <div class="px-6 py-4">
      <!-- Import file information -->
      <div class="bg-cobalt-50 border border-cobalt-200 rounded-md p-4 mb-6">
        <div class="flex">
          <div class="flex-shrink-0">
            <i class="bi bi-info-circle-fill text-xl text-cobalt-400"></i>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-cobalt-800"><%= t('views.organisations.codebase_import_files.rollback.import_file_info') %></h3>
            <div class="mt-2 text-sm text-cobalt-700">
              <p><strong><%= t('views.organisations.codebase_import_files.rollback.file_label') %></strong> <%= @import_file.original_filename %></p>
              <p><strong><%= t('views.organisations.codebase_import_files.rollback.imported_at') %></strong> <%= @import_file.processing_completed_at&.strftime('%d.%m.%Y um %H:%M') || t('views.organisations.codebase_import_files.rollback.imported_at_unknown') %></p>
              <p><strong><%= t('views.organisations.codebase_import_files.rollback.status_label') %></strong> <%= @import_file.status %></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Warning -->
      <div class="bg-red-50 border border-red-200 rounded-md p-4 mb-6">
        <div class="flex">
          <div class="flex-shrink-0">
            <i class="bi bi-exclamation-triangle-fill text-xl text-red-400"></i>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-red-800"><%= t('views.organisations.codebase_import_files.rollback.warning_title') %></h3>
            <div class="mt-2 text-sm text-red-700">
              <p><%= t('views.organisations.codebase_import_files.rollback.warning_text_1') %></p>
              <p><%= t('views.organisations.codebase_import_files.rollback.warning_text_2') %></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Rollback summary -->
      <div class="bg-gray-50 rounded-lg p-6 mb-6">
        <h3 class="text-lg font-medium text-gray-900 mb-4"><%= t('views.organisations.codebase_import_files.rollback.objects_to_delete') %></h3>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
          <div class="bg-surface-raised rounded-lg border p-4 text-center">
            <div class="text-2xl font-bold text-cobalt-600"><%= @rollback_summary[:tickets] %></div>
            <div class="text-sm text-gray-600"><%= t('views.organisations.codebase_import_files.rollback.stat_tickets') %></div>
          </div>

          <div class="bg-surface-raised rounded-lg border p-4 text-center">
            <div class="text-2xl font-bold text-green-600"><%= @rollback_summary[:posts] %></div>
            <div class="text-sm text-gray-600"><%= t('views.organisations.codebase_import_files.rollback.stat_posts') %></div>
          </div>

          <div class="bg-surface-raised rounded-lg border p-4 text-center">
            <div class="text-2xl font-bold text-purple-600"><%= @rollback_summary[:total] %></div>
            <div class="text-sm text-gray-600"><%= t('views.organisations.codebase_import_files.rollback.stat_total') %></div>
          </div>
        </div>

        <% if @import_sessions.count > 1 %>
          <div class="mt-4">
            <h4 class="text-sm font-medium text-gray-700 mb-2"><%= t('views.organisations.codebase_import_files.rollback.import_sessions') %></h4>
            <div class="text-sm text-gray-600">
              <p><%= t('views.organisations.codebase_import_files.rollback.import_sessions_desc', count: @import_sessions.count) %></p>
              <ul class="list-disc list-inside mt-1">
                <% @import_sessions.each do |session_id, count| %>
                  <li><code class="bg-gray-100 px-1 rounded text-xs"><%= session_id[0..7] %>...</code> - <%= t('views.organisations.codebase_import_files.rollback.objects_count', count: count) %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Confirmation form -->
      <div class="bg-yellow-50 border border-yellow-200 rounded-md p-4 mb-6">
        <%= form_with url: execute_rollback_organisation_codebase_import_file_path(current_organisation, @import_file), method: :delete, local: true, class: "space-y-4" do |form| %>
          <div class="flex items-center">
            <%= form.check_box :confirm_rollback, { class: "h-4 w-4 text-red-600 focus:ring-red-500 border-gray-300 rounded", required: true }, "true", "" %>
            <%= form.label :confirm_rollback, t('views.organisations.codebase_import_files.rollback.confirm_delete'), class: "ml-2 block text-sm text-gray-900" %>
          </div>

          <div class="flex items-center">
            <%= form.check_box :understand_irreversible, { class: "h-4 w-4 text-red-600 focus:ring-red-500 border-gray-300 rounded", required: true }, "true", "" %>
            <%= form.label :understand_irreversible, t('views.organisations.codebase_import_files.rollback.confirm_irreversible'), class: "ml-2 block text-sm text-gray-900" %>
          </div>

          <div class="flex justify-end space-x-3 pt-4">
            <%= link_to t('views.organisations.codebase_import_files.rollback.cancel'), organisation_codebase_import_file_path(current_organisation, @import_file),
                class: "px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-surface-raised hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-cobalt-500" %>

            <%= form.submit t('views.organisations.codebase_import_files.rollback.execute_rollback'),
                class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-on-fill bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500",
                data: {
                  turbo_confirm: t('views.confirm.rollback_permanent', count: @rollback_summary[:total])
                } %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

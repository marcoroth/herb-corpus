<div class="flex flex-col gap-4 lg:gap-6 mx-auto px-4 lg:px-6 mb-6">

  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-cream-900"><%= t('views.organisations.codebase_import_files.assign_uploads.title') %></h1>
      <p class="text-sm text-cream-900/70">
        <%= t('views.organisations.codebase_import_files.assign_uploads.subtitle', project: @project.name) %>
      </p>
    </div>

    <%= render Neo::Buttons::ButtonComponent.new(
          variant: :secondary, size: :large, icon: "arrow-left",
          url: organisation_codebase_import_files_path(current_organisation)
        ) do %>
      <%= t('views.organisations.codebase_import_files.assign_uploads.back') %>
    <% end %>
  </div>

  <!-- Project Info -->
  <div class="p-6 bg-surface-raised/60 border border-stroke rounded shadow-neomorph">
    <h3 class="text-lg font-semibold mb-3 text-cream-900">
      <%= t('views.organisations.codebase_import_files.assign_uploads.project_info') %>
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <span class="text-sm font-medium text-cream-900/70"><%= t('views.organisations.codebase_import_files.assign_uploads.project_label') %></span>
        <p class="text-cream-900"><%= @project.name %></p>
      </div>
      <div>
        <span class="text-sm font-medium text-cream-900/70"><%= t('views.organisations.codebase_import_files.assign_uploads.processed_tickets') %></span>
        <p class="text-cream-900"><%= @processed_tickets_count %></p>
      </div>
    </div>
  </div>

  <!-- Upload Assignment Form -->
  <div class="bg-surface-raised/60 border border-stroke rounded shadow-neomorph">
    <div class="p-6 border-b border-stroke">
      <h2 class="text-xl font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.assign_uploads.assign_upload_files') %></h2>
    </div>

    <div class="p-6">
      <% if @upload_files.any? %>
        <%= form_with url: execute_upload_assignment_organisation_codebase_import_file_path(current_organisation, @import_file), method: :post, class: "space-y-6" do |form| %>
          <%= hidden_field_tag :project_id, @project.id %>

          <!-- Upload File Selection -->
          <div>
            <label class="block text-sm font-medium text-cream-900 mb-3">
              <%= t('views.organisations.codebase_import_files.assign_uploads.select_upload_file') %>
            </label>

            <div class="space-y-3">
              <% @upload_files.each do |upload_file| %>
                <div class="flex items-center p-4 border border-stroke/20 rounded bg-surface-raised/40">
                  <input type="radio"
                         name="upload_file_id"
                         value="<%= upload_file.id %>"
                         id="upload_file_<%= upload_file.id %>"
                         class="mr-3">
                  <label for="upload_file_<%= upload_file.id %>" class="flex-1 cursor-pointer">
                    <div class="flex items-center justify-between">
                      <div>
                        <div class="font-medium text-cream-900">
                          <%= upload_file.original_filename %>
                        </div>
                        <div class="text-sm text-cream-900/70">
                          <%= t('views.organisations.codebase_import_files.assign_uploads.uploaded_by_at', name: upload_file.uploaded_by_name, date: upload_file.created_at.strftime('%d.%m.%Y %H:%M')) %>
                        </div>
                        <div class="text-sm text-cream-900/70">
                          <%= t('views.organisations.codebase_import_files.assign_uploads.size_label', size: upload_file.file_size_human) %>
                          <% if upload_file.archive_file.present? %>
                            <%= t('views.organisations.codebase_import_files.assign_uploads.archive_file', size: ActionController::Base.helpers.number_to_human_size(upload_file.archive_file.byte_size)) %>
                          <% end %>
                        </div>
                      </div>
                      <div class="flex items-center gap-2">
                        <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-lime-200 text-cream-900 border border-stroke rounded">
                          <%= upload_file.file_type.humanize %>
                        </span>
                        <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-cobalt-200 text-cream-900 border border-stroke rounded">
                          <%= upload_file.status.humanize %>
                        </span>
                      </div>
                    </div>
                  </label>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Upload Count Info -->
          <div class="p-4 bg-cobalt-50 border border-cobalt-200 rounded">
            <div class="flex items-start gap-3">
              <i class="bi bi-info-circle text-xl text-cobalt-600 mt-0.5"></i>
              <div>
                <h4 class="font-medium text-cobalt-900"><%= t('views.organisations.codebase_import_files.assign_uploads.important_info_title') %></h4>
                <p class="text-sm text-cobalt-700 mt-1">
                  <%= t('views.organisations.codebase_import_files.assign_uploads.important_info_text') %>
                </p>
              </div>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex items-center gap-3 pt-4">
            <%= form.submit t('views.organisations.codebase_import_files.assign_uploads.start_assignment'),
                class: "py-2.5 px-5 relative inline-flex flex-row items-center justify-center gap-x-2 rounded text-sm tracking-[.00714em] font-medium border border-stroke bg-green-200 hover:bg-green-300 focus:bg-green-300 text-cream-900 hover:shadow-sm focus:shadow-sm" %>

            <%= render Neo::Buttons::ButtonComponent.new(
                  variant: :secondary, size: :large,
                  url: organisation_codebase_import_files_path(current_organisation)
                ) do %>
              <%= t('views.organisations.codebase_import_files.assign_uploads.cancel') %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-12">
          <i class="bi bi-paperclip block mx-auto mb-4 text-6xl text-cream-900/30"></i>
          <h3 class="text-lg font-semibold text-cream-900 mb-2"><%= t('views.organisations.codebase_import_files.assign_uploads.no_uploads_title') %></h3>
          <p class="text-cream-900/70 mb-4">
            <%= t('views.organisations.codebase_import_files.assign_uploads.no_uploads_description') %>
          </p>
          <%= render Neo::Buttons::ButtonComponent.new(
                variant: :primary, size: :large, icon: "plus-lg",
                url: new_organisation_codebase_import_file_path(current_organisation)
              ) do %>
            <%= t('views.organisations.codebase_import_files.assign_uploads.upload_file_btn') %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

</div>

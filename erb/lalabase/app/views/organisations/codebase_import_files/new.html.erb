<div class="pt-6">
  <%= render NeoTitleBoxComponent.new(
    title: t('views.organisations.codebase_import_files.new.title'),
    variant: :organisation
  ) do |component| %>
    <% component.with_right_content do %>
      <%= render Neo::Buttons::HeaderButtonComponent.new(
        variant: :secondary,
        icon: "arrow-left",
        label: t('views.organisations.codebase_import_files.new.back'),
        url: organisation_codebase_import_files_path(current_organisation)
      ) %>
    <% end %>
  <% end %>

  <div class="flex flex-col gap-4 lg:gap-6 mb-6">

  <!-- Upload Form -->
  <div class="bg-cream-50 border border-cream-300 rounded-lg">
    <div class="p-6 border-b border-cream-200">
      <h2 class="text-xl font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.new.file_upload') %></h2>
    </div>

    <div class="p-6">
      <%= form_with model: [current_organisation, @import_file],
          url: organisation_codebase_import_files_path(current_organisation),
          multipart: true,
          class: "space-y-6" do |form| %>

        <!-- File type selection -->
        <div>
          <%= form.label :file_type, t('views.organisations.codebase_import_files.new.file_type_label'), class: "block text-sm font-medium text-cream-900 mb-2" %>
          <%= form.select :file_type,
              options_for_select([
                [t('views.organisations.codebase_import_files.new.file_type_users'), 'users'],
                [t('views.organisations.codebase_import_files.new.file_type_tickets'), 'tickets'],
                [t('views.organisations.codebase_import_files.new.file_type_time_tracking'), 'time_tracking'],
                [t('views.organisations.codebase_import_files.new.file_type_uploads'), 'uploads']
              ]),
              { prompt: t('views.organisations.codebase_import_files.new.file_type_prompt') },
              { class: "w-full px-4 py-3 border border-cream-300 rounded bg-surface-raised text-cream-900 focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all",
                id: "codebase_import_file_file_type",
                onchange: "toggleTarFileField(this.value)" } %>
          <% if @import_file.errors[:file_type].any? %>
            <p class="mt-1 text-sm text-red-600"><%= @import_file.errors[:file_type].first %></p>
          <% end %>
        </div>

        <!-- File upload -->
        <div>
          <%= form.label :file, t('views.organisations.codebase_import_files.new.xml_file_label'), class: "block text-sm font-medium text-cream-900 mb-2" %>
          <div class="relative">
            <%= form.file_field :file,
                accept: ".xml,text/xml",
                class: "w-full px-4 py-3 border border-cream-300 rounded bg-surface-raised text-cream-900 focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all",
                required: true %>
          </div>
          <p class="mt-1 text-xs text-cream-600">
            <%= t('views.organisations.codebase_import_files.new.max_file_size', size: ActionController::Base.helpers.number_to_human_size(CodebaseImportFile::MAX_FILE_SIZE)) %>
          </p>
          <% if @import_file.errors[:file].any? %>
            <p class="mt-1 text-sm text-red-600"><%= @import_file.errors[:file].first %></p>
          <% end %>
        </div>

        <!-- TAR file upload (only for uploads) -->
        <div id="tar_file_field" style="display: none;"
             data-controller="upload-progress"
             data-upload-progress-direct-upload-url-value="<%= @direct_upload_url || '' %>">
          <%= form.label :tar_file, t('views.organisations.codebase_import_files.new.tar_file_label'), class: "block text-sm font-medium text-cream-900 mb-2" %>
          <div class="relative">
            <%= form.file_field :tar_file,
                accept: ".tar,.zip,application/x-tar,application/zip",
                class: "w-full px-4 py-3 border border-cream-300 rounded bg-surface-raised text-cream-900 focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink transition-all",
                data: {
                  upload_progress_target: "input",
                  direct_upload: @direct_upload_url.present?
                } %>
          </div>
          <p class="mt-1 text-xs text-cream-600">
            <%= t('views.organisations.codebase_import_files.new.max_file_size', size: ActionController::Base.helpers.number_to_human_size([CodebaseImportFile::MAX_TAR_FILE_SIZE, CodebaseImportFile::MAX_ZIP_FILE_SIZE].max)) %>
          </p>

          <!-- Upload Progress -->
          <div class="hidden mt-4" data-upload-progress-target="progress">
            <div class="bg-cream-200 rounded-full h-4 mb-2">
              <div class="bg-cobalt-600 h-4 rounded-full transition-all duration-300"
                   style="width: 0%"
                   data-upload-progress-target="progressBar"></div>
            </div>
            <p class="text-sm text-cream-600" data-upload-progress-target="status"><%= t('views.organisations.codebase_import_files.new.upload_in_progress') %></p>
          </div>

          <% if @import_file.errors[:archive_file].any? %>
            <p class="mt-1 text-sm text-red-600"><%= @import_file.errors[:archive_file].first %></p>
          <% end %>
        </div>

        <!-- Info Box -->
        <%# D5 Callout (info/hint): warm-quiet (S5), no shadow, decorative lime removed. %>
        <div class="p-4 bg-cream-100 border border-cream-300 rounded-lg">
          <div class="flex items-start gap-3">
            <i class="bi bi-info-circle text-cream-600 flex-shrink-0 mt-0.5"></i>
            <div>
              <h4 class="text-sm font-medium text-cream-900"><%= t('views.organisations.codebase_import_files.new.upload_notes_title') %></h4>
              <ul class="mt-2 text-xs text-cream-700 space-y-1">
                <li>&bull; <%= t('views.organisations.codebase_import_files.new.upload_note_stored') %></li>
                <li>&bull; <%= t('views.organisations.codebase_import_files.new.upload_note_preview') %></li>
                <li>&bull; <%= t('views.organisations.codebase_import_files.new.upload_note_delete') %></li>
                <li>&bull; <%= t('views.organisations.codebase_import_files.new.upload_note_format') %></li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <%# Footer (D1/P7): standalone form → keep Cancel. Cancel left, Submit right (G6).
            Both ButtonComponent (P4), size :large (B5). Submit keeps the upload-progress Stimulus target. %>
        <div class="flex justify-end gap-3">
          <%= render Neo::Buttons::ButtonComponent.new(
                variant: :secondary,
                size: :large,
                url: organisation_codebase_import_files_path(current_organisation)
              ) do %>
            <%= t('views.organisations.codebase_import_files.new.cancel') %>
          <% end %>

          <%= render Neo::Buttons::ButtonComponent.new(
                variant: :primary,
                size: :large,
                type: "submit",
                data: { upload_progress_target: "submitButton" }
              ) do %>
            <%= t('views.organisations.codebase_import_files.new.submit') %>
          <% end %>
        </div>

      <% end %>
    </div>
  </div>

  <!-- Help section -->
  <div class="bg-cream-50 border border-cream-300 rounded-lg">
    <div class="p-6 border-b border-cream-200">
      <h3 class="text-lg font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.new.help_title') %></h3>
    </div>
    <div class="p-6 space-y-4">
      <div>
        <h4 class="font-medium text-cream-900 mb-2"><%= t('views.organisations.codebase_import_files.new.help_step1_title') %></h4>
        <p class="text-sm text-cream-600">
          <%= t('views.organisations.codebase_import_files.new.help_step1_text') %>
        </p>
      </div>
      <div>
        <h4 class="font-medium text-cream-900 mb-2"><%= t('views.organisations.codebase_import_files.new.help_step2_title') %></h4>
        <p class="text-sm text-cream-600">
          <%= t('views.organisations.codebase_import_files.new.help_step2_text') %>
        </p>
      </div>
      <div>
        <h4 class="font-medium text-cream-900 mb-2"><%= t('views.organisations.codebase_import_files.new.help_step3_title') %></h4>
        <p class="text-sm text-cream-600">
          <%= t('views.organisations.codebase_import_files.new.help_step3_text') %>
        </p>
      </div>
    </div>
  </div>

  </div>
</div>

<script>
function toggleTarFileField(fileType) {
  const tarFileField = document.getElementById('tar_file_field');
  if (fileType === 'uploads') {
    tarFileField.style.display = 'block';
  } else {
    tarFileField.style.display = 'none';
  }
}

// Initialize on page load. turbo:load instead of DOMContentLoaded (app uses Turbo Drive → DOMContentLoaded
// does not fire on Turbo nav; otherwise toggleTarFileField only takes effect after a reload).
document.addEventListener('turbo:load', function() {
  const fileTypeSelect = document.getElementById('codebase_import_file_file_type');
  if (fileTypeSelect) {
    toggleTarFileField(fileTypeSelect.value);
  }
});
</script>

<div class="container mx-auto px-4 py-8">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="border-stroke rounded-lg border bg-surface-raised p-6 mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-semibold text-cream-900 mb-2"><%= @import_file.file_type == 'tickets' ? t('views.organisations.codebase_import_files.select_project.title_tickets') : t('views.organisations.codebase_import_files.select_project.title_time') %></h1>
          <p class="text-cream-900">
            <%= t('views.organisations.codebase_import_files.select_project.subtitle', count: @item_count, type: @item_type) %>
          </p>
        </div>
        <%= render Neo::Buttons::ButtonComponent.new(variant: :secondary, size: :medium, icon: "arrow-left",
              url: organisation_codebase_import_file_path(current_organisation, @import_file)) do %>
          <%= t('views.organisations.codebase_import_files.select_project.back') %>
        <% end %>
      </div>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">

      <!-- File Info Card -->
      <div class="border-stroke rounded-lg border bg-surface-raised p-6">
        <h3 class="text-lg font-semibold text-cream-900 mb-4"><%= t('views.organisations.codebase_import_files.select_project.file_info') %></h3>
        <div class="flex flex-col">
          <!-- Dateiname -->
          <div class="py-2 flex items-center gap-2 justify-between">
            <div class="flex items-center gap-2 font-medium text-sm">
              <i class="bi bi-file-earmark-text-fill text-cream-900"></i><%= t('views.organisations.codebase_import_files.select_project.filename') %>
            </div>
            <span class="text-sm font-medium truncate max-w-48" title="<%= @import_file.original_filename %>">
              <%= @import_file.original_filename %>
            </span>
          </div>

          <!-- Anzahl Items -->
          <div class="py-2 flex items-center gap-2 justify-between">
            <div class="flex items-center gap-2 font-medium text-sm">
              <i class="bi bi-<%= @import_file.file_type == 'tickets' ? 'ticket' : 'clock' %>-fill text-cream-900"></i><%= t('views.organisations.codebase_import_files.select_project.item_count', type: @item_type) %>
            </div>
            <span class="text-sm font-medium bg-lime-200 px-2 py-1 rounded border border-stroke">
              <%= @item_count %>
            </span>
          </div>

          <!-- Hochgeladen von -->
          <div class="py-2 flex items-center gap-2 justify-between">
            <div class="flex items-center gap-2 font-medium text-sm">
              <i class="bi bi-person-fill text-cream-900"></i><%= t('views.organisations.codebase_import_files.select_project.uploaded_by') %>
            </div>
            <span class="text-sm font-medium"><%= @import_file.uploaded_by_name %></span>
          </div>

          <!-- Hochgeladen am -->
          <div class="py-2 flex items-center gap-2 justify-between">
            <div class="flex items-center gap-2 font-medium text-sm">
              <i class="bi bi-calendar-fill text-cream-900"></i><%= t('views.organisations.codebase_import_files.select_project.uploaded_at') %>
            </div>
            <span class="text-sm font-medium"><%= @import_file.created_at.strftime('%d.%m.%Y %H:%M') %></span>
          </div>
        </div>
      </div>

      <!-- Project Selection Card -->
      <div class="border-stroke rounded-lg border bg-surface-raised p-6">
        <h3 class="text-lg font-semibold text-cream-900 mb-4"><%= t('views.organisations.codebase_import_files.select_project.select_target_project') %></h3>

        <%= form_with url: @import_file.file_type == 'tickets' ?
                           preview_tickets_organisation_codebase_import_file_path(current_organisation, @import_file) :
                           preview_time_sessions_organisation_codebase_import_file_path(current_organisation, @import_file),
                      method: :get,
                      local: true,
                      class: "flex flex-col gap-4" do |form| %>

          <div>
            <%= form.select :project_id,
                            options_from_collection_for_select(@available_projects, :id, :name),
                            { prompt: t('views.organisations.codebase_import_files.select_project.project_prompt') },
                            {
                              class: "w-full p-3 border border-stroke rounded focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-200",
                              required: true
                            } %>
          </div>

          <div class="py-2.5 px-4 rounded text-sm gap-2 items-center justify-between border border-slate-200 bg-yellow-100 text-cream-900 shadow-sm">
            <div class="flex items-center gap-1">
              <i class="bi bi-info-circle text-lg me-3"></i>
              <span><%= t('views.organisations.codebase_import_files.select_project.note_import_html', type: @item_type) %></span>
            </div>
          </div>

          <div class="flex justify-end mt-2">
            <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, size: :large, tag: :button, type: 'submit') do %>
              <%= t('views.organisations.codebase_import_files.select_project.preview_btn') %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- New Project Option Card -->
    <div class="border-stroke rounded-lg border bg-surface-raised p-6">
      <h3 class="text-lg font-semibold text-cream-900 mb-4"><%= t('views.organisations.codebase_import_files.select_project.new_project_title') %></h3>

      <div class="flex items-center justify-between">
        <div>
          <p class="text-cream-900 mb-2">
            <%= t('views.organisations.codebase_import_files.select_project.new_project_description') %>
          </p>
          <p class="text-sm text-cream-900/70">
            <%= t('views.organisations.codebase_import_files.select_project.new_project_hint') %>
          </p>
        </div>

        <%= render Neo::Buttons::ButtonComponent.new(
              variant: :secondary, size: :large, icon: "plus-lg",
              url: organisation_projects_path(current_organisation)
            ) do %>
          <%= t('views.organisations.codebase_import_files.select_project.new_project_btn') %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="flex flex-col gap-4 lg:gap-6 mx-auto px-4 lg:px-6 mb-6">

  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-cream-900">
        <%= @import_file.original_filename %>
      </h1>
      <p class="text-sm text-cream-900/70">
        <%= t('views.organisations.codebase_import_files.show.data_from_codebase', type: @import_file.file_type.humanize) %>
      </p>
    </div>

    <div class="flex items-center gap-3">
      <% if @import_file.file_type == 'users' && @parsed_data.present? && @import_file.status != 'processed' %>
        <%= render Neo::Buttons::ButtonComponent.new(
              variant: :primary, size: :large, icon: "download",
              url: preview_import_organisation_codebase_import_file_path(current_organisation, @import_file)
            ) do %>
          <%= t('views.organisations.codebase_import_files.show.start_import') %>
        <% end %>
      <% elsif @import_file.file_type == 'tickets' && @parsed_data.present? && @import_file.status != 'processed' %>
        <%= render Neo::Buttons::ButtonComponent.new(
              variant: :primary, size: :large, icon: "graph-up-arrow",
              url: preview_tickets_organisation_codebase_import_file_path(current_organisation, @import_file)
            ) do %>
          <%= t('views.organisations.codebase_import_files.show.prepare_import') %>
        <% end %>
      <% elsif @import_file.file_type == 'time_tracking' && @parsed_data.present? && @import_file.status != 'processed' %>
        <%= render Neo::Buttons::ButtonComponent.new(
              variant: :primary, size: :large, icon: "archive",
              url: select_project_organisation_codebase_import_file_path(current_organisation, @import_file)
            ) do %>
          <%= t('views.organisations.codebase_import_files.show.select_project') %>
        <% end %>
      <% elsif @import_file.status == 'processing' %>
        <div class="py-2.5 px-5 relative inline-flex flex-row items-center justify-center gap-x-2 rounded text-sm tracking-[.00714em] font-medium border border-stroke bg-yellow-200 text-cream-900">
          <i class="bi bi-arrow-repeat inline-block animate-spin text-xl leading-none" aria-hidden="true"></i>
          <%= t('views.organisations.codebase_import_files.show.import_running') %>
        </div>
      <% elsif @import_file.status == 'processed' %>
        <div class="flex items-center gap-3">
          <div class="py-2.5 px-5 relative inline-flex flex-row items-center justify-center gap-x-2 rounded text-sm tracking-[.00714em] font-medium border border-stroke bg-green-200 text-cream-900">
            <i class="bi bi-check-lg text-xl"></i>
            <%= t('views.organisations.codebase_import_files.show.already_imported') %>
          </div>

          <% if %w[tickets time_tracking].include?(@import_file.file_type) %>
            <%= render Neo::Buttons::ButtonComponent.new(
                  variant: :warning, size: :large, icon: "arrow-counterclockwise",
                  url: rollback_organisation_codebase_import_file_path(current_organisation, @import_file)
                ) do %>
              <%= t('views.organisations.codebase_import_files.show.rollback') %>
            <% end %>
          <% end %>
        </div>
      <% elsif @import_file.status == 'rolled_back' %>
        <div class="py-2.5 px-5 relative inline-flex flex-row items-center justify-center gap-x-2 rounded text-sm tracking-[.00714em] font-medium border border-stroke bg-purple-200 text-cream-900">
          <i class="bi bi-arrow-counterclockwise text-xl"></i>
          <%= t('views.organisations.codebase_import_files.show.rollback_done') %>
        </div>
      <% elsif @import_file.status == 'failed' %>
        <div class="py-2.5 px-5 relative inline-flex flex-row items-center justify-center gap-x-2 rounded text-sm tracking-[.00714em] font-medium border border-stroke bg-red-200 text-cream-900">
          <i class="bi bi-exclamation-triangle text-xl"></i>
          <%= t('views.organisations.codebase_import_files.show.import_failed') %>
        </div>
      <% end %>

      <%= render Neo::Buttons::ButtonComponent.new(
            variant: :danger, size: :large, icon: "trash",
            url: organisation_codebase_import_file_path(current_organisation, @import_file),
            data: {
              turbo_method: :delete,
              turbo_confirm: t('views.confirm.delete_import_file', filename: @import_file.original_filename)
            }
          ) do %>
        <%= t('views.organisations.codebase_import_files.show.delete_file') %>
      <% end %>

      <%= render Neo::Buttons::ButtonComponent.new(
            variant: :secondary, size: :large, icon: "arrow-left",
            url: organisation_codebase_import_files_path(current_organisation)
          ) do %>
        <%= t('views.organisations.codebase_import_files.show.back_to_overview') %>
      <% end %>
    </div>
  </div>

  <!-- File Info -->
  <div class="bg-surface-raised/60 border border-stroke rounded shadow-neomorph">
    <div class="p-6">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div>
          <h4 class="text-sm font-medium text-cream-900/70"><%= t('views.organisations.codebase_import_files.show.file_size') %></h4>
          <p class="text-lg font-semibold text-cream-900"><%= @import_file.file_size_human %></p>
        </div>
        <div>
          <h4 class="text-sm font-medium text-cream-900/70"><%= t('views.organisations.codebase_import_files.show.uploaded_by') %></h4>
          <p class="text-lg font-semibold text-cream-900"><%= @import_file.uploaded_by_name %></p>
        </div>
        <div>
          <h4 class="text-sm font-medium text-cream-900/70"><%= t('views.organisations.codebase_import_files.show.uploaded_at') %></h4>
          <p class="text-lg font-semibold text-cream-900"><%= @import_file.created_at.strftime('%d.%m.%Y %H:%M') %></p>
        </div>
        <div>
          <h4 class="text-sm font-medium text-cream-900/70"><%= t('views.organisations.codebase_import_files.show.status') %></h4>
          <% case @import_file.status %>
          <% when 'uploaded' %>
            <span class="inline-flex items-center px-3 py-1 text-sm font-medium bg-cobalt-200 text-cream-900 border border-stroke rounded">
              <%= t('views.organisations.codebase_import_files.show.status_uploaded') %>
            </span>
          <% when 'processing' %>
            <span class="inline-flex items-center px-3 py-1 text-sm font-medium bg-yellow-200 text-cream-900 border border-stroke rounded">
              <%= t('views.organisations.codebase_import_files.show.status_processing') %>
            </span>
          <% when 'processed' %>
            <span class="inline-flex items-center px-3 py-1 text-sm font-medium bg-green-200 text-cream-900 border border-stroke rounded">
              <%= t('views.organisations.codebase_import_files.show.status_processed') %>
            </span>
          <% when 'failed' %>
            <span class="inline-flex items-center px-3 py-1 text-sm font-medium bg-red-200 text-cream-900 border border-stroke rounded">
              <%= t('views.organisations.codebase_import_files.show.status_failed') %>
            </span>
          <% else %>
            <span class="inline-flex items-center px-3 py-1 text-sm font-medium bg-gray-200 text-cream-900 border border-stroke rounded">
              <%= @import_file.status.humanize %>
            </span>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Data Display -->
  <% if @import_file.file_type == 'users' && @parsed_data.present? %>
    <!-- Users Data Table -->
    <div class="bg-surface-raised/60 border border-stroke rounded shadow-neomorph">
      <div class="p-6 border-b border-stroke">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-semibold text-cream-900">
            <%= t('views.organisations.codebase_import_files.show.user_data') %>
          </h2>
          <span class="inline-flex items-center px-3 py-1 text-sm font-medium bg-cobalt-200 text-cream-900 border border-stroke rounded">
            <%= t('views.organisations.codebase_import_files.show.users_found', count: @parsed_data.count) %>
          </span>
        </div>
      </div>

      <div class="p-6">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-stroke/20">
                <th class="text-left py-3 px-4 font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.show.th_id') %></th>
                <th class="text-left py-3 px-4 font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.show.th_username') %></th>
                <th class="text-left py-3 px-4 font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.show.th_email') %></th>
                <th class="text-left py-3 px-4 font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.show.th_full_name') %></th>
                <th class="text-left py-3 px-4 font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.show.th_role') %></th>
                <th class="text-left py-3 px-4 font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.show.th_company') %></th>
              </tr>
            </thead>
            <tbody>
              <% @parsed_data.each_with_index do |user_data, index| %>
                <tr class="border-b border-stroke/10 <%= 'bg-gray-50' if index.even? %>">
                  <td class="py-3 px-4 text-cream-900 font-mono text-sm">
                    <%= user_data[:id] %>
                  </td>
                  <td class="py-3 px-4 text-cream-900">
                    <% if user_data[:username].present? %>
                      <span class="font-medium">@<%= user_data[:username] %></span>
                    <% else %>
                      <span class="text-cream-900/50 italic"><%= t('views.organisations.codebase_import_files.show.no_username') %></span>
                    <% end %>
                  </td>
                  <td class="py-3 px-4 text-cream-900">
                    <a href="mailto:<%= user_data[:email] %>" class="hover:underline">
                      <%= user_data[:email] %>
                    </a>
                  </td>
                  <td class="py-3 px-4 text-cream-900">
                    <%= user_data[:full_name] %>
                  </td>
                  <td class="py-3 px-4">
                    <div class="space-y-1">
                      <div class="flex items-center gap-2">
                        <span class="inline-flex items-center px-2 py-1 text-xs font-medium
                              <%= user_data[:role][:account_administrator] ? 'bg-red-200 text-red-800' : 'bg-cobalt-200 text-cobalt-800' %>
                              border border-stroke rounded">
                          <%= user_data[:role][:name] %>
                        </span>
                        <% if user_data[:role][:account_administrator] %>
                          <span class="inline-flex items-center px-2 py-1 text-xs font-medium bg-orange-200 text-orange-800 border border-stroke rounded">
                            Admin
                          </span>
                        <% end %>
                      </div>
                    </div>
                  </td>
                  <td class="py-3 px-4 text-cream-900">
                    <% if user_data[:company][:name].present? %>
                      <%= user_data[:company][:name] %>
                    <% else %>
                      <span class="text-cream-900/50 italic"><%= t('views.organisations.codebase_import_files.show.no_company') %></span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Statistics -->
    <div class="bg-surface-raised/60 border border-stroke rounded shadow-neomorph">
      <div class="p-6 border-b border-stroke">
        <h3 class="text-lg font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.show.statistics') %></h3>
      </div>
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
          <div class="text-center">
            <p class="text-2xl font-bold text-cream-900"><%= @parsed_data.count %></p>
            <p class="text-sm text-cream-900/70"><%= t('views.organisations.codebase_import_files.show.total_users') %></p>
          </div>
          <div class="text-center">
            <p class="text-2xl font-bold text-cream-900">
              <%= @parsed_data.count { |u| u[:role][:account_administrator] } %>
            </p>
            <p class="text-sm text-cream-900/70"><%= t('views.organisations.codebase_import_files.show.administrators') %></p>
          </div>
          <div class="text-center">
            <p class="text-2xl font-bold text-cream-900">
              <%= @parsed_data.count { |u| u[:username].present? } %>
            </p>
            <p class="text-sm text-cream-900/70"><%= t('views.organisations.codebase_import_files.show.with_username') %></p>
          </div>
          <div class="text-center">
            <p class="text-2xl font-bold text-cream-900">
              <%= @parsed_data.count { |u| u[:company][:name].present? } %>
            </p>
            <p class="text-sm text-cream-900/70"><%= t('views.organisations.codebase_import_files.show.with_company') %></p>
          </div>
        </div>
      </div>
    </div>

  <% elsif @import_file.status == 'processed' && @import_file.import_summary.present? %>
    <!-- Import Results -->
    <div class="bg-surface-raised/60 border border-stroke rounded shadow-neomorph">
      <div class="p-6 border-b border-stroke">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-semibold text-cream-900">
            <%= t('views.organisations.codebase_import_files.show.import_results') %>
          </h2>
          <span class="inline-flex items-center px-3 py-1 text-sm font-medium bg-green-200 text-cream-900 border border-stroke rounded">
            <%= t('views.organisations.codebase_import_files.show.successfully_processed') %>
          </span>
        </div>
      </div>

      <div class="p-6">
        <% results = @import_file.import_summary %>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
          <div class="text-center">
            <p class="text-2xl font-bold text-cream-900">
              <%= results['total_users'] || results['total_tickets'] || results['total'] || 0 %>
            </p>
            <p class="text-sm text-cream-900/70">
              <%= @import_file.file_type == 'tickets' ? t('views.organisations.codebase_import_files.show.total_tickets_result') : t('views.organisations.codebase_import_files.show.total_users_result') %>
            </p>
          </div>
          <div class="text-center">
            <p class="text-2xl font-bold text-green-600">
              <%= results['imported_users'] || results['imported_tickets'] || results['created'] || 0 %>
            </p>
            <p class="text-sm text-green-600">
              <%= @import_file.file_type == 'tickets' ? t('views.organisations.codebase_import_files.show.imported') : t('views.organisations.codebase_import_files.show.created') %>
            </p>
          </div>
          <div class="text-center">
            <p class="text-2xl font-bold text-cobalt-600">
              <%= results['error_users'] || results['error_tickets'] || results['mapped'] || 0 %>
            </p>
            <p class="text-sm text-cobalt-600">
              <%= @import_file.file_type == 'tickets' ? t('views.organisations.codebase_import_files.show.errors_result') : t('views.organisations.codebase_import_files.show.mapped') %>
            </p>
          </div>
          <div class="text-center">
            <p class="text-2xl font-bold text-red-600">
              <%= results['skipped'] || 0 %>
            </p>
            <p class="text-sm text-red-600"><%= t('views.organisations.codebase_import_files.show.skipped') %></p>
          </div>
        </div>

        <!-- Tag statistics if available -->
        <% if @import_file.includes_tags? %>
          <div class="mt-8">
            <h4 class="text-lg font-semibold text-cream-900 mb-4 flex items-center gap-2">
              <i class="bi bi-tag text-xl"></i>
              <%= t('views.organisations.codebase_import_files.show.tag_import_stats') %>
            </h4>

            <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
              <div class="text-center p-4 bg-cobalt-50 border border-cobalt-200 rounded">
                <p class="text-2xl font-bold text-cobalt-600">
                  <%= @import_file.total_tags_found %>
                </p>
                <p class="text-sm text-cobalt-600"><%= t('views.organisations.codebase_import_files.show.tags_found') %></p>
              </div>
              <div class="text-center p-4 bg-green-50 border border-green-200 rounded">
                <p class="text-2xl font-bold text-green-600">
                  <%= @import_file.tags_created_count %>
                </p>
                <p class="text-sm text-green-600"><%= t('views.organisations.codebase_import_files.show.tags_created') %></p>
              </div>
              <div class="text-center p-4 bg-yellow-50 border border-yellow-200 rounded">
                <p class="text-2xl font-bold text-yellow-600">
                  <%= @import_file.tags_reused_count %>
                </p>
                <p class="text-sm text-yellow-600"><%= t('views.organisations.codebase_import_files.show.tags_reused') %></p>
              </div>
              <div class="text-center p-4 bg-purple-50 border border-purple-200 rounded">
                <p class="text-2xl font-bold text-purple-600">
                  <%= @import_file.taggings_created_count %>
                </p>
                <p class="text-sm text-purple-600"><%= t('views.organisations.codebase_import_files.show.taggings_created') %></p>
              </div>
            </div>

            <% tag_stats = @import_file.tag_statistics %>
            <% if tag_stats['success'] == false && tag_stats['errors'].present? %>
              <div class="mt-4 p-4 bg-yellow-100 border border-yellow-300 rounded">
                <p class="text-sm text-yellow-800 font-medium mb-2 flex items-center gap-2">
                  <i class="bi bi-exclamation-triangle text-base"></i>
                  <%= t('views.organisations.codebase_import_files.show.tag_warnings') %>
                </p>
                <ul class="text-sm text-yellow-700 list-disc list-inside space-y-1">
                  <% tag_stats['errors'].first(3).each do |error| %>
                    <li><%= error %></li>
                  <% end %>
                  <% if tag_stats['errors'].length > 3 %>
                    <li class="italic"><%= t('views.organisations.codebase_import_files.show.more_warnings', count: tag_stats['errors'].length - 3) %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          </div>
        <% end %>

        <% if results['errors'] && results['errors'].any? %>
          <div class="mt-4 p-4 bg-red-100 border border-red-300 rounded">
            <p class="text-sm text-red-800 font-medium mb-2">
              <%= t('views.organisations.codebase_import_files.show.errors_occurred') %>
            </p>
            <ul class="text-sm text-red-700 list-disc list-inside space-y-1">
              <% results['errors'].first(5).each do |error| %>
                <li><%= error %></li>
              <% end %>
              <% if results['errors'].length > 5 %>
                <li class="italic"><%= t('views.organisations.codebase_import_files.show.more_errors', count: results['errors'].length - 5) %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% if results['project_name'] %>
          <div class="mt-4 text-sm text-cream-900/70">
            <%= t('views.organisations.codebase_import_files.show.imported_in_project') %> <strong><%= results['project_name'] %></strong>
          </div>
        <% end %>

        <div class="mt-2 text-sm text-cream-900/70">
          <%= t('views.organisations.codebase_import_files.show.import_completed_at') %> <%= @import_file.processing_completed_at&.strftime('%d.%m.%Y %H:%M') || @import_file.processed_at&.strftime('%d.%m.%Y %H:%M') %>
        </div>
      </div>
    </div>

  <% elsif @import_file.file_type == 'tickets' && @parsed_data.present? %>
    <!-- Tickets Data Table -->
    <div class="bg-surface-raised/60 border border-stroke rounded shadow-neomorph">
      <div class="p-6 border-b border-stroke">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-semibold text-cream-900">
            <%= t('views.organisations.codebase_import_files.show.ticket_data') %>
          </h2>
          <span class="inline-flex items-center px-3 py-1 text-sm font-medium bg-cobalt-200 text-cream-900 border border-stroke rounded">
            <%= t('views.organisations.codebase_import_files.show.tickets_found', count: @parsed_data.count) %>
          </span>
        </div>
      </div>

      <div class="p-6">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-stroke/20">
                <th class="text-left py-3 px-4 font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.show.th_id') %></th>
                <th class="text-left py-3 px-4 font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.show.th_number') %></th>
                <th class="text-left py-3 px-4 font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.show.th_title') %></th>
                <th class="text-left py-3 px-4 font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.show.th_status') %></th>
                <th class="text-left py-3 px-4 font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.show.th_priority') %></th>
                <th class="text-left py-3 px-4 font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.show.th_tags') %></th>
                <th class="text-left py-3 px-4 font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.show.th_reporter') %></th>
                <th class="text-left py-3 px-4 font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.show.th_updates') %></th>
              </tr>
            </thead>
            <tbody>
              <% @parsed_data.first(10).each_with_index do |ticket_data, index| %>
                <tr class="border-b border-stroke/10 <%= 'bg-gray-50' if index.even? %>">
                  <td class="py-3 px-4 text-cream-900 font-mono text-sm">
                    <%= ticket_data[:id] %>
                  </td>
                  <td class="py-3 px-4 text-cream-900 font-semibold">
                    #<%= ticket_data[:number] %>
                  </td>
                  <td class="py-3 px-4 text-cream-900">
                    <div class="max-w-xs truncate" title="<%= ticket_data[:subject] %>">
                      <%= ticket_data[:subject] %>
                    </div>
                  </td>
                  <td class="py-3 px-4">
                    <span class="inline-flex items-center px-2 py-1 text-xs font-medium bg-cobalt-200 text-cobalt-800 border border-stroke rounded">
                      <%= ticket_data[:status_cache] %>
                    </span>
                  </td>
                  <td class="py-3 px-4">
                    <span class="inline-flex items-center px-2 py-1 text-xs font-medium bg-yellow-200 text-yellow-800 border border-stroke rounded">
                      <%= ticket_data[:priority_cache] %>
                    </span>
                  </td>
                  <td class="py-3 px-4">
                    <% if ticket_data[:tags].present? %>
                      <div class="flex flex-wrap gap-1">
                        <% ticket_data[:tags].split(' ').first(3).each do |tag| %>
                          <span class="inline-flex items-center px-2 py-1 text-xs font-medium bg-purple-200 text-purple-800 border border-stroke rounded">
                            <%= tag %>
                          </span>
                        <% end %>
                        <% if ticket_data[:tags].split(' ').length > 3 %>
                          <span class="inline-flex items-center px-2 py-1 text-xs font-medium bg-gray-200 text-gray-800 border border-stroke rounded">
                            +<%= ticket_data[:tags].split(' ').length - 3 %>
                          </span>
                        <% end %>
                      </div>
                    <% else %>
                      <span class="text-cream-900/50 italic text-xs"><%= t('views.organisations.codebase_import_files.show.no_tags') %></span>
                    <% end %>
                  </td>
                  <td class="py-3 px-4 text-cream-900">
                    <% if ticket_data[:reporter_cache].present? %>
                      <div class="text-sm">
                        <div class="font-medium"><%= ticket_data[:reporter_cache] %></div>
                        <% if ticket_data[:reporter_email].present? %>
                          <div class="text-xs text-cream-900/60"><%= ticket_data[:reporter_email] %></div>
                        <% end %>
                      </div>
                    <% else %>
                      <span class="text-cream-900/50 italic"><%= t('views.organisations.codebase_import_files.show.unknown') %></span>
                    <% end %>
                  </td>
                  <td class="py-3 px-4 text-center">
                    <span class="inline-flex items-center px-2 py-1 text-xs font-medium bg-gray-200 text-gray-800 border border-stroke rounded">
                      <%= ticket_data[:updates].length %>
                    </span>
                  </td>
                </tr>
              <% end %>
              <% if @parsed_data.count > 10 %>
                <tr>
                  <td colspan="8" class="py-3 px-4 text-center text-cream-900/60 italic">
                    <%= t('views.organisations.codebase_import_files.show.more_tickets', count: @parsed_data.count - 10) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Tickets Statistics -->
    <div class="bg-surface-raised/60 border border-stroke rounded shadow-neomorph">
      <div class="p-6 border-b border-stroke">
        <h3 class="text-lg font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.show.ticket_statistics') %></h3>
      </div>
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
          <div class="text-center">
            <p class="text-2xl font-bold text-cream-900"><%= @parsed_data.count %></p>
            <p class="text-sm text-cream-900/70"><%= t('views.organisations.codebase_import_files.show.total_tickets') %></p>
          </div>
          <div class="text-center">
            <p class="text-2xl font-bold text-cream-900">
              <%= @parsed_data.map { |t| t[:status_cache] }.uniq.count %>
            </p>
            <p class="text-sm text-cream-900/70"><%= t('views.organisations.codebase_import_files.show.different_statuses') %></p>
          </div>
          <div class="text-center">
            <p class="text-2xl font-bold text-cream-900">
              <%= @parsed_data.map { |t| t[:priority_cache] }.uniq.count %>
            </p>
            <p class="text-sm text-cream-900/70"><%= t('views.organisations.codebase_import_files.show.different_priorities') %></p>
          </div>
          <div class="text-center">
            <p class="text-2xl font-bold text-cream-900">
              <%= @parsed_data.sum { |t| t[:updates].length } %>
            </p>
            <p class="text-sm text-cream-900/70"><%= t('views.organisations.codebase_import_files.show.total_updates') %></p>
          </div>
        </div>

        <!-- Tag preview for tickets -->
        <%
          tickets_with_tags = @parsed_data.select { |t| t[:tags].present? }
          all_tags = tickets_with_tags.flat_map { |t| t[:tags].split(/\s+/) }.map(&:downcase).uniq
        %>
        <% if tickets_with_tags.any? %>
          <div class="mt-8">
            <h4 class="text-lg font-semibold text-cream-900 mb-4 flex items-center gap-2">
              <i class="bi bi-tag text-xl"></i>
              <%= t('views.organisations.codebase_import_files.show.tag_preview') %>
            </h4>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
              <div class="text-center p-4 bg-cobalt-50 border border-cobalt-200 rounded">
                <p class="text-2xl font-bold text-cobalt-600">
                  <%= tickets_with_tags.count %>
                </p>
                <p class="text-sm text-cobalt-600"><%= t('views.organisations.codebase_import_files.show.tickets_with_tags') %></p>
              </div>
              <div class="text-center p-4 bg-green-50 border border-green-200 rounded">
                <p class="text-2xl font-bold text-green-600">
                  <%= all_tags.count %>
                </p>
                <p class="text-sm text-green-600"><%= t('views.organisations.codebase_import_files.show.unique_tags') %></p>
              </div>
              <div class="text-center p-4 bg-purple-50 border border-purple-200 rounded">
                <p class="text-2xl font-bold text-purple-600">
                  <%= tickets_with_tags.sum { |t| t[:tags].split(/\s+/).count } %>
                </p>
                <p class="text-sm text-purple-600"><%= t('views.organisations.codebase_import_files.show.total_tag_assignments') %></p>
              </div>
            </div>

            <% if all_tags.any? %>
              <div class="bg-gray-50 border border-gray-200 rounded p-4">
                <h5 class="text-sm font-medium text-cream-900/70 mb-3"><%= t('views.organisations.codebase_import_files.show.found_tags') %></h5>
                <div class="flex flex-wrap gap-2">
                  <% all_tags.first(20).each do |tag| %>
                    <span class="inline-flex items-center px-3 py-1 text-sm font-medium bg-cobalt-100 text-cobalt-800 border border-cobalt-300 rounded-full">
                      <%= tag %>
                    </span>
                  <% end %>
                  <% if all_tags.count > 20 %>
                    <span class="inline-flex items-center px-3 py-1 text-sm font-medium bg-gray-100 text-gray-600 border border-gray-300 rounded-full">
                      <%= t('views.organisations.codebase_import_files.show.more_tags', count: all_tags.count - 20) %>
                    </span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

  <% elsif @import_file.file_type == 'tickets' %>
    <!-- No Tickets Data -->
    <div class="bg-surface-raised/60 border border-stroke rounded shadow-neomorph">
      <div class="p-6 text-center">
        <i class="bi bi-file-earmark-text block mx-auto mb-4 text-6xl text-cream-900/30"></i>
        <h3 class="text-lg font-semibold text-cream-900 mb-2"><%= t('views.organisations.codebase_import_files.show.no_ticket_data_title') %></h3>
        <p class="text-cream-900/70">
          <%= t('views.organisations.codebase_import_files.show.no_ticket_data_desc') %>
        </p>
      </div>
    </div>

  <% elsif @import_file.file_type == 'time_tracking' && @parsed_data.present? %>
    <!-- Time Tracking Data Display -->
    <div class="bg-surface-raised/60 border border-stroke rounded shadow-neomorph">
      <div class="p-6 border-b border-stroke">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-semibold text-cream-900">
            <%= t('views.organisations.codebase_import_files.show.time_entries_data') %>
          </h2>
          <span class="inline-flex items-center px-3 py-1 text-sm font-medium bg-cobalt-200 text-cream-900 border border-stroke rounded">
            <%= t('views.organisations.codebase_import_files.show.time_entries_found', count: @parsed_data.count) %>
          </span>
        </div>
      </div>

      <div class="p-6">
        <% if @parsed_data.any? %>
          <!-- Summary -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <div class="bg-lime-50 p-4 rounded border border-stroke">
              <div class="text-2xl font-bold">
                <%= (@parsed_data.sum { |ts| ts[:minutes] } / 60.0).round(2) %> h
              </div>
              <div class="text-sm text-gray-600"><%= t('views.organisations.codebase_import_files.show.total_time') %></div>
            </div>

            <div class="bg-cobalt-50 p-4 rounded border border-stroke">
              <div class="text-2xl font-bold">
                <%= @parsed_data.map { |ts| ts[:cached_name] }.uniq.compact.count %>
              </div>
              <div class="text-sm text-gray-600"><%= t('views.organisations.codebase_import_files.show.users') %></div>
            </div>

            <div class="bg-purple-50 p-4 rounded border border-stroke">
              <div class="text-2xl font-bold">
                <%= @parsed_data.count { |ts| ts[:ticket_id].present? } %>
              </div>
              <div class="text-sm text-gray-600"><%= t('views.organisations.codebase_import_files.show.linked_to_tickets') %></div>
            </div>
          </div>

          <!-- Data table -->
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="border-b border-stroke/20">
                  <th class="text-left py-3 px-4 font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.show.th_id') %></th>
                  <th class="text-left py-3 px-4 font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.show.th_date') %></th>
                  <th class="text-left py-3 px-4 font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.show.th_user') %></th>
                  <th class="text-left py-3 px-4 font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.show.th_time') %></th>
                  <th class="text-left py-3 px-4 font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.show.th_description') %></th>
                  <th class="text-left py-3 px-4 font-semibold text-cream-900"><%= t('views.organisations.codebase_import_files.show.th_ticket') %></th>
                </tr>
              </thead>
              <tbody>
                <% @parsed_data.first(10).each_with_index do |session_data, index| %>
                  <tr class="border-b border-stroke/10 <%= 'bg-gray-50' if index.even? %>">
                    <td class="py-3 px-4 text-cream-900 font-mono text-sm">
                      <%= session_data[:id] %>
                    </td>
                    <td class="py-3 px-4 text-cream-900">
                      <%= Date.parse(session_data[:occurred_on]).strftime('%d.%m.%Y') rescue session_data[:occurred_on] %>
                    </td>
                    <td class="py-3 px-4 text-cream-900">
                      <%= session_data[:cached_name] || t('views.organisations.codebase_import_files.show.unknown_user') %>
                    </td>
                    <td class="py-3 px-4 text-cream-900">
                      <%= TimeSession.format_duration(session_data[:minutes]) %>
                    </td>
                    <td class="py-3 px-4 text-cream-900">
                      <div class="max-w-xs truncate" title="<%= session_data[:summary] %>">
                        <%= session_data[:summary] %>
                      </div>
                    </td>
                    <td class="py-3 px-4 text-cream-900">
                      <% if session_data[:ticket_id].present? %>
                        <span class="inline-flex items-center px-2 py-1 text-xs font-medium bg-cobalt-200 text-cobalt-800 border border-stroke rounded">
                          #<%= session_data[:ticket_id] %>
                        </span>
                      <% else %>
                        <span class="text-gray-400">-</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <% if @parsed_data.count > 10 %>
            <div class="mt-4 text-center text-sm text-cream-900/70">
              <%= t('views.organisations.codebase_import_files.show.more_time_entries', count: @parsed_data.count - 10) %>
            </div>
          <% end %>
        <% else %>
          <p class="text-cream-900/70"><%= t('views.organisations.codebase_import_files.show.no_time_entries') %></p>
        <% end %>
      </div>
    </div>

  <% elsif @import_file.file_type == 'uploads' && @parsed_data.present? %>
    <!-- Uploads Data Display -->
    <div class="bg-surface-raised/60 border border-stroke rounded shadow-neomorph">
      <div class="p-6">
        <div class="flex items-center justify-between mb-6">
          <h3 class="text-xl font-semibold text-cream-900 flex items-center gap-2">
            <i class="bi bi-cloud-upload text-2xl text-cobalt-600"></i>
            <%= t('views.organisations.codebase_import_files.show.uploads_found', count: @parsed_data.count) %>
          </h3>
        </div>

        <!-- Upload Statistics -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
          <div class="text-center p-4 bg-cobalt-50 border border-cobalt-200 rounded">
            <p class="text-2xl font-bold text-cobalt-600"><%= @parsed_data.count %></p>
            <p class="text-sm text-cobalt-600"><%= t('views.organisations.codebase_import_files.show.total_uploads') %></p>
          </div>
          <div class="text-center p-4 bg-green-50 border border-green-200 rounded">
            <p class="text-2xl font-bold text-green-600">
              <%= @parsed_data.map { |u| u[:linked_object_type] }.uniq.count %>
            </p>
            <p class="text-sm text-green-600"><%= t('views.organisations.codebase_import_files.show.object_types') %></p>
          </div>
          <div class="text-center p-4 bg-purple-50 border border-purple-200 rounded">
            <p class="text-2xl font-bold text-purple-600">
              <%= @parsed_data.map { |u| u[:file_content_type] }.uniq.count %>
            </p>
            <p class="text-sm text-purple-600"><%= t('views.organisations.codebase_import_files.show.file_types') %></p>
          </div>
          <div class="text-center p-4 bg-orange-50 border border-orange-200 rounded">
            <p class="text-2xl font-bold text-orange-600">
              <%= number_to_human_size(@parsed_data.sum { |u| u[:file_size] }) %>
            </p>
            <p class="text-sm text-orange-600"><%= t('views.organisations.codebase_import_files.show.total_size') %></p>
          </div>
        </div>

        <!-- Upload Preview Table -->
        <div class="overflow-x-auto">
          <table class="w-full border-collapse border border-stroke/20">
            <thead>
              <tr class="bg-gray-100">
                <th class="border border-stroke/20 px-4 py-2 text-left"><%= t('views.organisations.codebase_import_files.show.th_filename') %></th>
                <th class="border border-stroke/20 px-4 py-2 text-left"><%= t('views.organisations.codebase_import_files.show.th_type') %></th>
                <th class="border border-stroke/20 px-4 py-2 text-left"><%= t('views.organisations.codebase_import_files.show.th_size_upload') %></th>
                <th class="border border-stroke/20 px-4 py-2 text-left"><%= t('views.organisations.codebase_import_files.show.th_linked_to') %></th>
                <th class="border border-stroke/20 px-4 py-2 text-left"><%= t('views.organisations.codebase_import_files.show.th_date_upload') %></th>
              </tr>
            </thead>
            <tbody>
              <% @parsed_data.first(10).each do |upload_data| %>
                <tr class="hover:bg-gray-50">
                  <td class="border border-stroke/20 px-4 py-2 font-medium">
                    <%= upload_data[:file_name] %>
                  </td>
                  <td class="border border-stroke/20 px-4 py-2">
                    <span class="px-2 py-1 text-xs rounded bg-cobalt-100 text-cobalt-800">
                      <%= upload_data[:file_content_type] %>
                    </span>
                  </td>
                  <td class="border border-stroke/20 px-4 py-2">
                    <%= number_to_human_size(upload_data[:file_size]) %>
                  </td>
                  <td class="border border-stroke/20 px-4 py-2">
                    <span class="px-2 py-1 text-xs rounded bg-green-100 text-green-800">
                      <%= upload_data[:linked_object_type] %>
                    </span>
                    <span class="text-xs text-gray-500">#<%= upload_data[:linked_object_id] %></span>
                  </td>
                  <td class="border border-stroke/20 px-4 py-2 text-sm text-gray-600">
                    <%= upload_data[:created_at] %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <% if @parsed_data.count > 10 %>
          <div class="mt-4 p-4 bg-gray-50 border border-gray-200 rounded text-center">
            <p class="text-sm text-gray-600">
              <%= t('views.organisations.codebase_import_files.show.more_uploads', count: @parsed_data.count - 10) %>
            </p>
          </div>
        <% end %>

        <!-- Upload Assignment Actions -->
        <div class="mt-6 p-4 bg-cobalt-50 border border-cobalt-200 rounded">
          <div class="flex items-start gap-3">
            <i class="bi bi-link-45deg text-xl text-cobalt-600 mt-0.5"></i>
            <div class="flex-1">
              <h4 class="font-medium text-cobalt-900 mb-1"><%= t('views.organisations.codebase_import_files.show.assign_uploads_title') %></h4>
              <p class="text-sm text-cobalt-700 mb-3">
                <%= t('views.organisations.codebase_import_files.show.assign_uploads_desc') %>
              </p>

              <% if @import_file.archive_file.present? && @import_file.archive_file.blob.present? %>
                <%# Check if file exists on storage - if not, it's still uploading %>
                <% begin %>
                  <% file_exists = @import_file.archive_file.blob.service.exist?(@import_file.archive_file.blob.key) %>
                <% rescue => e %>
                  <% file_exists = false %>
                <% end %>

                <% if @import_file.archive_file.blob.byte_size > 50.megabytes && !file_exists %>
                  <!-- Large file still uploading -->
                  <div class="p-3 bg-yellow-100 border border-yellow-300 rounded mb-3">
                    <p class="text-sm text-yellow-800">
                      <i class="bi bi-arrow-repeat inline-block animate-spin leading-none mr-1" aria-hidden="true"></i>
                      <%= t('views.organisations.codebase_import_files.show.archive_uploading') %>
                    </p>
                  </div>
                <% else %>
                  <!-- Upload complete, show assignment options -->
                  <div class="flex gap-2">
                    <% if selectable_projects.any? %>
                      <%= form_with url: execute_upload_assignment_organisation_codebase_import_file_path(current_organisation, @import_file), method: :post, class: "flex items-center gap-2" do |f| %>
                        <%= f.hidden_field :upload_file_id, value: @import_file.id %>
                        <label for="project_id" class="text-sm font-medium text-cobalt-900"><%= t('views.organisations.codebase_import_files.show.select_project_label') %></label>
                        <%= f.select :project_id, selectable_projects.order(:name).map { |p| [p.name, p.id] },
                            {}, { class: "px-3 py-1 border border-cobalt-300 rounded text-sm", required: true } %>
                        <%= f.submit t('views.organisations.codebase_import_files.show.start_assignment'),
                            class: "py-1.5 px-4 text-sm font-medium bg-cobalt-200 hover:bg-cobalt-300 border border-cobalt-300 rounded hover:shadow-[2px_2px_0_0_#3b82f6] text-cobalt-900 cursor-pointer" %>
                      <% end %>
                    <% else %>
                      <p class="text-sm text-cobalt-700">
                        <%= t('views.organisations.codebase_import_files.show.create_project_first') %>
                      </p>
                    <% end %>
                  </div>
                <% end %>
              <% else %>
                <p class="text-sm text-yellow-700">
                  <%= t('views.organisations.codebase_import_files.show.no_archive_file') %>
                </p>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

  <% else %>
    <!-- Error or No Data -->
    <div class="bg-surface-raised/60 border border-stroke rounded shadow-neomorph">
      <div class="p-6 text-center">
        <i class="bi bi-exclamation-triangle block mx-auto mb-4 text-6xl text-red-400"></i>
        <h3 class="text-lg font-semibold text-cream-900 mb-2"><%= t('views.organisations.codebase_import_files.show.parse_error_title') %></h3>
        <p class="text-cream-900/70">
          <%= t('views.organisations.codebase_import_files.show.parse_error_desc') %>
        </p>
      </div>
    </div>
  <% end %>

</div>

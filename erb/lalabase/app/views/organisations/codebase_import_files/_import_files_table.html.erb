<div class="overflow-x-auto">
  <div class="bg-cream-50 rounded-lg overflow-hidden">
  <table class="min-w-full border-collapse">
    <thead>
      <tr>
        <th class="text-left py-3 px-4 text-[11px] font-mono font-medium uppercase tracking-wider text-cream-600 border-b border-ink"><%= t('views.organisations.codebase_import_files.import_files_table.th_filename') %></th>
        <th class="text-left py-3 px-4 text-[11px] font-mono font-medium uppercase tracking-wider text-cream-600 border-b border-ink"><%= t('views.organisations.codebase_import_files.import_files_table.th_type') %></th>
        <th class="text-left py-3 px-4 text-[11px] font-mono font-medium uppercase tracking-wider text-cream-600 border-b border-ink"><%= t('views.organisations.codebase_import_files.import_files_table.th_size') %></th>
        <th class="text-left py-3 px-4 text-[11px] font-mono font-medium uppercase tracking-wider text-cream-600 border-b border-ink"><%= t('views.organisations.codebase_import_files.import_files_table.th_uploaded_by') %></th>
        <th class="text-left py-3 px-4 text-[11px] font-mono font-medium uppercase tracking-wider text-cream-600 border-b border-ink"><%= t('views.organisations.codebase_import_files.import_files_table.th_date') %></th>
        <th class="text-left py-3 px-4 text-[11px] font-mono font-medium uppercase tracking-wider text-cream-600 border-b border-ink"><%= t('views.organisations.codebase_import_files.import_files_table.th_status') %></th>
        <th class="text-right py-3 px-4 text-[11px] font-mono font-medium uppercase tracking-wider text-cream-600 border-b border-ink"><%= t('views.organisations.codebase_import_files.import_files_table.th_actions') %></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-cream-200">
      <% import_files.each do |import_file| %>
        <tr class="hover:bg-cream-100 transition-colors">
          <td class="py-3 px-4 text-cream-900">
            <%= import_file.original_filename %>
          </td>
          <td class="py-3 px-4">
            <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-cream-200 text-cream-900 border border-cream-300 rounded">
              <%= import_file.file_type.humanize %>
            </span>
          </td>
          <td class="py-3 px-4 text-cream-900">
            <%= import_file.file_size_human %>
          </td>
          <td class="py-3 px-4 text-cream-900">
            <%= import_file.uploaded_by_name %>
          </td>
          <td class="py-3 px-4 text-cream-900">
            <%= import_file.created_at.strftime('%d.%m.%Y %H:%M') %>
          </td>
          <td class="py-3 px-4">
            <% case import_file.status %>
            <% when 'uploaded' %>
              <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-cobalt-200 text-cream-900 border border-cream-300 rounded">
                <%= t('views.organisations.codebase_import_files.import_files_table.status_uploaded') %>
              </span>
            <% when 'processing' %>
              <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-yellow-200 text-cream-900 border border-cream-300 rounded">
                <%= t('views.organisations.codebase_import_files.import_files_table.status_processing') %>
              </span>
            <% when 'processed' %>
              <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-green-200 text-cream-900 border border-cream-300 rounded">
                <%= t('views.organisations.codebase_import_files.import_files_table.status_processed') %>
              </span>
            <% when 'rolled_back' %>
              <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-purple-200 text-cream-900 border border-cream-300 rounded">
                <%= t('views.organisations.codebase_import_files.import_files_table.status_rolled_back') %>
              </span>
            <% when 'error' %>
              <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-red-200 text-cream-900 border border-cream-300 rounded">
                <%= t('views.organisations.codebase_import_files.import_files_table.status_error') %>
              </span>
            <% end %>
          </td>
          <td class="py-3 px-4 text-right">
            <%# D3 table row action cluster: IconButtonComponent, distinguished via variant/icon.
                View=secondary, Rollback=warning (has consequences), Delete=danger (+confirm). %>
            <div class="flex items-center justify-end gap-2">
              <%= render Neo::Buttons::IconButtonComponent.new(
                    variant: :secondary,
                    icon: "eye",
                    url: organisation_codebase_import_file_path(current_organisation, import_file),
                    title: t('views.organisations.codebase_import_files.import_files_table.tooltip_view')
                  ) %>

              <% if import_file.file_type == 'tickets' && import_file.status == 'processed' %>
                <%= render Neo::Buttons::IconButtonComponent.new(
                      variant: :warning,
                      icon: "arrow-counterclockwise",
                      url: rollback_organisation_codebase_import_file_path(current_organisation, import_file),
                      title: t('views.organisations.codebase_import_files.import_files_table.tooltip_rollback')
                    ) %>
              <% end %>

              <%= render Neo::Buttons::IconButtonComponent.new(
                    variant: :danger,
                    icon: "trash",
                    url: organisation_codebase_import_file_path(current_organisation, import_file),
                    title: t('views.organisations.codebase_import_files.import_files_table.tooltip_delete'),
                    interactive: true,
                    confirm: t('views.confirm.delete_import_file', filename: import_file.original_filename),
                    data: { turbo_method: :delete }
                  ) %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  </div>
</div>

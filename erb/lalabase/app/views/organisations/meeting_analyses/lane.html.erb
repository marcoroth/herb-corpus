<%# Rolling-deploy fallback only: current pages never request this retired lane. %>
<turbo-frame id="meeting_analyses_lane">
  <section class="meeting-content p-4">
    <p class="text-sm text-cream-700"><%= t('views.organisations.meetings.analyses.legacy_lane_moved') %></p>
    <%= link_to t('views.organisations.meetings.analyses.reload_meeting'),
                organisation_project_meeting_path(@current_organisation, @meeting.project, @meeting),
                class: 'inline-block mt-3 text-sm underline',
                data: { turbo_frame: '_top' } %>
  </section>
</turbo-frame>

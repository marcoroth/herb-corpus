<%# rows_compact / rows_detailed cockpit layout. Hero (B3, kept in every layout) + a flat naked
    table (compact) or an accent-block stack (detailed, F2: org-colour left stripe + warm fill, no
    shadow), one row per active org via Dashboard::CockpitRows. In rows mode the rows REPLACE the org
    tiles (B2), so the "+ Neue Organisation" affordance lives here. Locals: rows, detailed,
    member_counts, show_actions, show_todos, total. %>
<section class="mb-12" aria-labelledby="cockpit-rows-heading">
  <% if show_actions && total.to_i.positive? %>
    <h1 id="cockpit-rows-heading" class="text-2xl md:text-3xl font-bold text-cream-900 mb-1">
      <%= t('views.organisations.select.cockpit.needs_you', count: total) %>
    </h1>
    <p class="text-cream-600 mb-6"><%= t('views.organisations.select.cockpit.subtitle') %></p>
  <% end %>

  <%# Column labels ONCE above the rows (both layouts), not repeated per row. %>
  <% if show_actions || show_todos %>
    <%= render 'organisations/cockpit_rows_header', show_actions: show_actions, show_todos: show_todos %>
  <% end %>

  <% if detailed %>
    <div class="space-y-3">
      <% rows.each do |row| %>
        <% org_color = current_user.org_colors.effective_color(row.organisation) %>
        <div class="rounded-lg bg-cream-100 pl-4 pr-5 py-4 hover:bg-cream-200/70 transition-colors <%= 'border-l-4' if org_color %>"
             <% if org_color %> style="border-left-color: <%= org_color %>;"<% end %>>
          <%= render 'organisations/cockpit_row',
                     row: row, detailed: true, member_counts: member_counts,
                     show_actions: show_actions, show_todos: show_todos %>
        </div>
      <% end %>
    </div>

    <%= render 'organisations/cockpit_new_org_row', extra_class: 'mt-3 rounded-lg' %>
  <% else %>
    <div class="border border-cream-300 rounded-lg bg-cream-50 overflow-hidden divide-y divide-cream-200">
      <% rows.each do |row| %>
        <div class="px-4 py-3 hover:bg-cream-100 transition-colors">
          <%= render 'organisations/cockpit_row',
                     row: row, detailed: false, member_counts: member_counts,
                     show_actions: show_actions, show_todos: show_todos %>
        </div>
      <% end %>

      <%= render 'organisations/cockpit_new_org_row' %>
    </div>
  <% end %>
</section>

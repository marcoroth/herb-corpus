<%# The new version (S4 of doc/dokumentansicht_plan.md, the designer's 43a):
    the number first, the file as the zone, the title prefilled from the file
    name, "Was hat sich geändert?" optional, the summary switch bound to
    create_summary (D2: the field the other two forms bind and the controller
    permits; it used to post :process_with_ai, which nothing read), the locked
    state per D3, the sentence that answers the fear, a grey button until a
    file is chosen, "Abbrechen" as a text action that folds the form (the
    toggle in _document_content_for_frame owns it). %>
<% vf = 'views.organisations.documents.version_form' %>
<% field = 'mt-1 block w-full rounded-md border border-cream-300 px-3 py-2 bg-surface-raised focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink' %>
<% current_label = document.current_version&.label %>
<%= form_with(model: version,
              url: create_version_organisation_project_document_path(document.project.organisation, document.project, document, frame: params[:frame]),
              html: { multipart: true, class: 'space-y-5' },
              data: { controller: 'upload-zone', upload_zone_over_class: 'border-ink bg-cream-100',
                      upload_zone_empty_label_value: t('views.organisations.documents.upload_zone.none_chosen') }) do |form| %>
  <% if params[:frame] == 'content' %>
    <%= hidden_field_tag 'frame', 'content' %>
  <% end %>

  <p class="font-mono text-[13px] tracking-wide text-cream-500" data-version-form-heading><%= t("#{vf}.heading", label: "v#{document.next_version_number}") %></p>

  <%= render 'organisations/documents/upload_zone', form: form %>

  <div class="space-y-1">
    <%= form.label :title, t("#{vf}.title_label"), class: 'block text-sm font-medium text-cream-700' %>
    <%= form.text_field :title, value: version.title.presence, class: field, data: { upload_zone_target: 'title' } %>
  </div>

  <div class="space-y-1">
    <%= form.label :description, class: 'block text-sm font-medium text-cream-700' do %>
      <%= t("#{vf}.changed_label") %>
      <span class="font-normal text-cream-500"><%= t("#{vf}.optional") %></span>
    <% end %>
    <%= form.text_area :description, rows: 3, class: field %>
  </div>

  <%# One switch, the summary (chat lane, :document_summary), asking its own row (R4). %>
  <% document_summary = @current_organisation&.ai_available_for?(:document_summary) %>
  <% if document_summary&.available? %>
    <label class="flex items-start gap-2 text-sm text-cream-700">
      <%= form.check_box :create_summary, class: 'mt-0.5 h-4 w-4 rounded border-cream-300 accent-ink' %>
      <span>
        <%= t("#{vf}.create_summary") %>
        <span class="block text-xs text-cream-600"><%= t("#{vf}.summary_description") %></span>
      </span>
    </label>
  <% else %>
    <%= render Neo::Ai::UnavailableHintComponent.new(availability: document_summary, organisation: @current_organisation, feature: :document_summary) %>
  <% end %>
  <%= render 'organisations/documents/ai_locked_state' %>

  <% if current_label %>
    <p class="text-sm text-cream-600" data-version-form-keeps><%= t("#{vf}.keeps_previous", label: current_label) %></p>
  <% end %>

  <div class="flex items-center justify-end gap-3">
    <button type="button" class="<%= text_action_classes %>" data-action="toggle#toggle"><%= t("#{vf}.cancel") %></button>
    <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, type: 'submit', disabled: true, data: { upload_zone_target: 'submit' }) do %>
      <%= t("#{vf}.save") %>
    <% end %>
  </div>
<% end %>

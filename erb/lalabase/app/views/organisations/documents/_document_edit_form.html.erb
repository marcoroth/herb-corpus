<%= form_with(model: [@current_organisation, @project, @document], local: true) do |form| %>
  <% if params[:frame] == 'content' %>
    <%= hidden_field_tag 'frame', 'content' %>
    <%# Submit frame_id along so that update writes the content back into the
        correct frame (Knowledge = knowledge_display_frame), otherwise the update
        lands in the default frame and has no effect in the Knowledge view. %>
    <%= hidden_field_tag 'frame_id', params[:frame_id] %>
  <% end %>
  <!-- Title field -->
  <div class="mb-4">
    <%= form.label :title, t('views.organisations.documents.document_edit_form.title_label'), class: "block text-sm font-medium text-cream-700 mb-1" %>
    <%= form.text_field :title, class: "mt-1 block w-full px-3 py-2 bg-surface-raised border border-cream-300 rounded-md placeholder-cream-500 focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink sm:text-sm" %>
    <% if @document.errors[:title].any? %>
      <p class="mt-1 text-sm text-red-600"><%= @document.errors[:title].first %></p>
    <% end %>
  </div>

  <!-- Description field -->
  <div class="mb-4">
    <%= form.label :description, t('views.organisations.documents.document_edit_form.description_label'), class: "block text-sm font-medium text-cream-700 mb-1" %>
    <%= form.text_area :description, rows: 4, class: "mt-1 block w-full px-3 py-2 bg-surface-raised border border-cream-300 rounded-md placeholder-cream-500 focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink sm:text-sm" %>
    <% if @document.errors[:description].any? %>
      <p class="mt-1 text-sm text-red-600"><%= @document.errors[:description].first %></p>
    <% end %>
  </div>

  <!-- Tags -->
  <%= render 'organisations/tags/tag_form', form: form, taggable: @document, model_name: 'document' %>

  <!-- Button Container -->
  <%
    # frame_id of the current view (Knowledge = knowledge_display_frame), default = Documents view.
    content_frame_id = params[:frame_id].presence || 'document_display_frame'
    # Set the proper cancel path depending on the frame context
    cancel_path = if params[:frame] == 'content'
                   # HTML frame navigation back to the content (NO turbo_stream — otherwise
                   # show looks for the content partial as .turbo_stream -> Missing partial).
                   # Pass frame_id along, otherwise the content lands in the wrong frame.
                   organisation_project_document_path(@current_organisation, @project, @document, frame: 'content', frame_id: params[:frame_id].presence)
                 else
                   organisation_project_document_path(@current_organisation, @project, @document, format: :turbo_stream)
                 end
  %>
  <%= render 'common/button_container_standard_edit_form',
            form: form,
            cancel_path: cancel_path,
            turbo_frame_id: (params[:frame] == 'content' ? content_frame_id : nil),
            delete_path: organisation_project_document_path(@current_organisation, @project, @document, frame: params[:frame]) %>

<% end %>

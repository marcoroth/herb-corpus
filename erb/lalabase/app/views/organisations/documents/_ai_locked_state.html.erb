<%# The locked state (D3 of doc/dokumentansicht_plan.md, the designer's 2.3),
    in exactly ONE state: the organisation has AI on and no usable embedding
    lane. One sentence, no box: what is saved and what is not, with the way to
    the access settings for those who may set them up (AiSettingsPolicy). In
    every other state the forms say nothing about indexing (#778). %>
<% organisation = @current_organisation %>
<% if organisation&.ai_enabled? && !organisation.ai_available_for?(:content_indexing).available? %>
  <p class="text-sm text-cream-600" data-ai-locked-state>
    <%= t('views.organisations.documents.ai_locked_state.sentence') %>
    <% if AiSettingsPolicy.new(current_user, organisation).show? %>
      <%# _top: the forms sit inside the lane's frame, and the settings page has
          no such frame; without it Turbo answered "Content missing" (review of #784). %>
      <%= link_to t('views.organisations.documents.ai_locked_state.set_up'), organisation_ai_settings_path(organisation),
                  class: 'underline decoration-cream-400 underline-offset-2 hover:decoration-cream-900',
                  data: { turbo_frame: '_top' } %>
    <% end %>
  </p>
<% end %>

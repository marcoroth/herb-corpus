<!-- heading -->
<div class="flex items-center gap-4 justify-between">
  <h2 class="text-2xl md:text-[1.6rem] font-semibold"><%= t('views.organisations.documents.new.title') %></h2>
  <%= render(Neo::Buttons::ButtonComponent.new(variant: :primary, icon: "plus-lg", url: new_organisation_project_document_path(@current_organisation, @project))) { t('views.organisations.documents.new.new_file') } %>
</div>

<% if flash[:alert] %>
  <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
    <strong class="font-bold"><%= t('views.organisations.documents.new.error') %></strong>
    <span class="block sm:inline"><%= flash[:alert] %></span>
  </div>
<% end %>

<div class="grid grid-cols-1 xl:grid-cols-3 gap-4 lg:gap-6">
  <div class="xl:col-span-1">
    <div class="border-stroke rounded-lg border text-base bg-surface-raised min-h-[70vh] overflow-hidden">
      <div class="flex justify-between items-center gap-3 px-6 pt-3 mb-3">
        <h2 class="text-lg font-semibold"></h2>
        <%= render(Neo::Buttons::ButtonComponent.new(variant: :secondary, size: :medium, icon: "list-ul")) { t('views.organisations.documents.new.list') } %>
      </div>
      <!-- table -->
      <div class="relative w-full overflow-y-auto">
        <%= render 'organisations/documents/document_list', documents: @documents, selected_document: @document %>
      </div>
    </div>
  </div>

  <div class="xl:col-span-2">
    <div class="border-stroke rounded-lg border p-6 text-base bg-surface-raised">
    <turbo-frame id="document-show">
      <%= render 'organisations/documents/document_form', document: @document, versions: @versions, current_version: @current_version, new_version: @new_version, current_organisation: @current_organisation %>
    </turbo-frame>
    </div>
  </div>
</div>
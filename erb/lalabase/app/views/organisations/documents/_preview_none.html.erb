<%# locals: (proxy:, sentence:) %>
<%# The fourth case (D3 of doc/dateivorschau_plan.md): one sentence and the
    download as the lime main action; also what an undecodable image steps
    aside for. %>
<p class="text-sm text-cream-700" data-preview-none><%= sentence %></p>
<% if proxy %>
  <div class="mt-4">
    <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, size: :medium, icon: 'download', url: proxy, download: '') do %>
      <%= t('views.organisations.documents.preview.download') %>
    <% end %>
  </div>
<% end %>

<%# This partial can be rendered in document-show, document_display_frame OR knowledge_display_frame.
    With frame=content, use the passed frame_id (default document_display_frame). Otherwise
    Turbo cannot find the frame in the knowledge view (knowledge_display_frame) ("Content missing"). %>
<turbo-frame id="<%= params[:frame] == 'content' ? (params[:frame_id].presence || 'document_display_frame') : 'document-show' %>">
  <div class="document-content">
    <div class="mb-4" id="document-card">
      <%= render 'organisations/knowledge/lane_head', type_word: t('views.organisations.knowledge.knowledge_row.document_type') %>
      <h2 class="text-[22px] leading-snug font-bold tracking-tight text-cream-900" data-lane-title><%= t('views.organisations.documents.document_edit.editing') %>: <%= @document.title %></h2>
      <div class="py-6">
        <%= render 'organisations/documents/document_edit_form', document: @document, current_organisation: @current_organisation %>
      </div>
    </div>
  </div>
</turbo-frame>

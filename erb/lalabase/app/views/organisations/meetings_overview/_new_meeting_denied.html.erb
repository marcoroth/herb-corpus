<%# locals: () %>
<%# The "+" of "Alle Meetings" asked for the project select, and this person may
    write meetings nowhere (any more: the right can go while the page stays
    open). A normal outcome, so it answers in the lane like the select would,
    with the lane head to close it (MeetingsOverviewController#render_lane_frame). %>
<div class="meeting-content min-w-0 relative">
  <%= render 'organisations/meetings/form_lane_head', new_form: true, project: nil %>
  <h2 class="text-[22px] leading-snug font-bold text-cream-900 mb-6">
    <%= t('views.organisations.meetings.index.new_meeting') %>
  </h2>
  <p class="py-10 text-center text-sm text-cream-500">
    <%= t('views.organisations.meetings_overview.new_meeting.denied') %>
  </p>
</div>

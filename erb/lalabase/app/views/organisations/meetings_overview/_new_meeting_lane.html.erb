<%# locals: (projects:) %>
<%# "Neues Meeting" on "Alle Meetings", in the lane as on the project page
    (doc meetings_uebersicht_vereinheitlichen_plan.md, PR 4). A meeting always
    belongs to a project, so the lane asks for one first and only then loads the
    form for it. MeetingsOverviewController#index renders this for ?new=meeting,
    on a full visit and into the lane frame alike.

    The select stands OUTSIDE the frame below it on purpose: it decides what the
    frame shows, so it must survive every load of it, a refused save included.
    The frame is filled by the project-nested MeetingsController#new (frame:
    'content') with the SAME form the project page uses, so there is no second
    copy of the meeting form. Each <option> carries its own address, built here;
    meeting-project-select only copies it onto the frame. list_context says which
    list a save redraws (MeetingList). The list state in it is the one this lane
    was opened with; layout-toggle sets the live one into the form at submit (the
    form names its project index, meetings/_meeting_new_for_frame).

    projects: where this person may WRITE meetings, nothing else
    (MeetingsOverviewController#writable_meeting_projects). Exactly one is chosen
    at once, and its form loads with the lane. %>
<% form_frame_id = Organisations::MeetingsOverviewController::NEW_FORM_FRAME_ID %>
<% context = Meetings::ListState.context_query(organisation: true) %>
<% form_urls = projects.to_h do |project|
     [project.id, new_organisation_project_meeting_path(@current_organisation, project, frame: 'content', frame_id: form_frame_id,
                                                                                         **context.symbolize_keys, **meeting_list_state.symbolize_keys)]
   end %>
<% chosen = projects.one? ? projects.first : nil %>
<div class="meeting-content min-w-0 relative" data-controller="meeting-project-select">
  <%= render 'organisations/meetings/form_lane_head', new_form: true, project: nil %>
  <h2 class="text-[22px] leading-snug font-bold text-cream-900 mb-6">
    <%= t('views.organisations.meetings.index.new_meeting') %>
  </h2>

  <div class="mb-6">
    <label for="meeting-new-project" class="block text-sm font-medium text-cream-700 mb-1">
      <%= t('views.organisations.meetings_overview.new_meeting.project_label') %>
    </label>
    <select id="meeting-new-project"
            data-meeting-project-select-target="select"
            data-action="change->meeting-project-select#choose"
            class="block w-full py-2 px-4 border border-cream-300 rounded-lg bg-surface-raised focus:outline-none focus:border-ink focus:ring-1 focus:ring-ink">
      <option value=""><%= t('views.organisations.meetings_overview.new_meeting.project_prompt') %></option>
      <% projects.each do |project| %>
        <%= tag.option project.name, value: project.id, selected: project == chosen, data: { form_url: form_urls[project.id] } %>
      <% end %>
    </select>
  </div>

  <%# The frame's zero state, also put back when the choice is taken back. %>
  <% placeholder = capture do %>
    <p class="py-10 text-center text-sm text-cream-500">
      <%= t('views.organisations.meetings_overview.new_meeting.select_project_first') %>
    </p>
  <% end %>
  <template data-meeting-project-select-target="placeholder"><%= placeholder %></template>

  <%# frame-error: a denied write, a deleted project or an expired session
      answers this frame with a redirect. Without it Turbo blanks the frame to
      its bare "Content missing" and throws; with it the reader gets a message.
      Same wiring as tickets/_tickets_results.html.erb. %>
  <%= turbo_frame_tag form_frame_id, src: (form_urls[chosen.id] if chosen),
                                     data: { controller: 'frame-error', meeting_project_select_target: 'frame' } do %>
    <%= placeholder %>
  <% end %>
</div>

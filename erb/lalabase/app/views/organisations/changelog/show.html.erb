<div data-controller="changelog-lightbox"
     data-action="keydown.esc@window->changelog-lightbox#close">
<%= render NeoTitleBoxComponent.new(
  title: t('views.organisations.changelog.title'),
  variant: :organisation
) %>

<div class="max-w-3xl mx-auto px-4">
  <% if @entries.empty? %>
    <div class="text-center py-16">
      <i class="bi bi-megaphone text-4xl text-gray-300"></i>
      <p class="mt-4 text-gray-500"><%= t('views.organisations.changelog.empty') %></p>
    </div>
  <% else %>
    <% @grouped_entries.each do |month, entries| %>
      <div class="sticky top-0 z-10 bg-cream-50/90 backdrop-blur-sm py-2 mb-4 border-b border-gray-200">
        <h2 class="text-sm font-bold uppercase text-gray-500">
          <%= l(month, format: '%B %Y') %>
        </h2>
      </div>

      <div class="flex flex-col gap-6 mb-10">
        <% entries.each do |entry| %>
          <%= render NeoCardComponent.new(variant: :white, shadow: :always, padding: :medium) do %>
            <div class="flex items-start justify-between mb-3">
              <h3 class="text-lg font-bold"><%= entry.title %></h3>
              <span class="text-xs text-gray-400 whitespace-nowrap ml-4"><%= l(entry.date, format: :long) %></span>
            </div>

            <div class="prose prose-sm max-w-none">
              <%= entry.body_html.html_safe %>
            </div>

            <% if entry.images.any? %>
              <div class="mt-4 flex flex-wrap gap-4">
                <% entry.images.each do |img| %>
                  <a href="<%= image_path(img) %>" target="_blank"
                     class="block cursor-zoom-in"
                     data-action="click->changelog-lightbox#open"
                     data-changelog-lightbox-src-param="<%= image_path(img) %>">
                    <%= image_tag(img, class: 'border border-slate-200 rounded-lg max-w-xs max-h-48 w-auto h-auto object-contain hover:shadow-md hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all duration-200', loading: 'lazy') %>
                  </a>
                <% end %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

<%# Lightbox Overlay %>
<div class="fixed inset-0 z-50 hidden items-center justify-center bg-ink bg-opacity-60 backdrop-blur-sm cursor-zoom-out"
     data-changelog-lightbox-target="overlay"
     data-action="click->changelog-lightbox#close">
  <img src="" alt="" class="max-w-[90vw] max-h-[90vh] object-contain rounded-lg border border-cream-300 shadow-[4px_4px_0_0_#14110c] bg-surface-raised p-2"
       data-changelog-lightbox-target="image">
</div>
</div>

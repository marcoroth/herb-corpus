<%# "+ Neue Organisation" affordance for the rows layouts. In rows mode the org tiles (which normally
    carry the new-org modal trigger) are hidden (B2), so the rows provide this entry instead — a plain
    link to the new-org page rather than the tiles' modal. Shared by both row densities; the caller
    passes extra_class for layout-specific spacing (detailed wraps it as its own block). %>
<%= link_to new_organisation_path,
      class: "flex items-center gap-3 px-4 py-3 text-cream-500 hover:text-cream-900 hover:bg-cream-100 transition-colors #{local_assigns.fetch(:extra_class, '')}" do %>
  <span class="w-10 h-10 rounded-lg border-2 border-dashed border-cream-300 flex items-center justify-center flex-shrink-0">
    <i class="bi bi-plus-lg" aria-hidden="true"></i>
  </span>
  <span class="font-bold text-sm"><%= t('views.organisations.select.cockpit.rows.new_organisation') %></span>
<% end %>

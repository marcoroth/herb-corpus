<%# A set of reference values is stored as JSON so names containing commas survive. %>
<% selected = smart_folder_reference_set_values(form.object.field, form.object.value) %>
<% options = available_reference_options(form.object.field, @current_organisation, project: project) %>
<% options += (selected - options.map { |option| option[:value] }).map { |value| { value: value, label: value } } %>
<div class="border border-gray-300 rounded-md max-h-48 overflow-y-auto py-1"
     data-smart-folder-form-target="multiSelect" data-encoding="json" data-reference-field="<%= form.object.field %>">
  <% options.each do |option| %>
    <label class="flex items-center gap-2 px-3 py-1.5 text-sm">
      <input type="checkbox" value="<%= option[:value] %>" <%= 'checked' if selected.include?(option[:value]) %>
             data-action="change->smart-folder-form#checkboxListChanged">
      <span><%= option[:label] %></span>
    </label>
  <% end %>
</div>
<%= form.hidden_field :value, value: selected.to_json, data: { smart_folder_form_target: 'multiSelectHidden' } %>

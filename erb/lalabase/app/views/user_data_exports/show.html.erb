<% content_for :title, t('user_data_export.title') %>

<div class="container mx-auto px-4 py-8">
  <div class="max-w-2xl mx-auto bg-surface-raised rounded-lg shadow-md p-6">
    <h1 class="text-2xl font-bold mb-6">
      <i class="bi bi-download inline mr-2"></i>
      <%= t('user_data_export.title') %>
    </h1>

    <p class="text-gray-700 mb-4"><%= t('user_data_export.intro') %></p>
    <ul class="list-disc list-inside text-gray-600 space-y-1 mb-6">
      <li><%= t('user_data_export.includes_account') %></li>
      <li><%= t('user_data_export.includes_security') %></li>
      <li><%= t('user_data_export.includes_orgs') %></li>
    </ul>
    <p class="text-sm text-gray-500 mb-6"><%= t('user_data_export.org_content_note') %></p>

    <% if @export.present? %>
      <%# Latest export status: pending / processing / completed / expired / failed %>
      <% status_key = @export.expired? ? 'expired' : @export.status %>
      <div class="bg-cream-100 border border-stroke rounded-lg p-4 mb-6">
        <p class="font-semibold mb-1">
          <%= t("user_data_export.status.#{status_key}.title") %>
        </p>
        <p class="text-sm text-gray-600">
          <%= t("user_data_export.status.#{status_key}.hint") %>
        </p>

        <% if @export.downloadable? %>
          <div class="mt-4 flex items-center gap-4">
            <%= link_to download_user_data_export_path,
                class: 'bg-ink text-on-fill py-2 px-4 rounded-md hover:opacity-90 transition-opacity inline-flex items-center gap-2' do %>
              <i class="bi bi-file-earmark-zip"></i>
              <%= t('user_data_export.download_button') %>
            <% end %>
            <span class="text-sm text-gray-500">
              <%= t('user_data_export.valid_until', date: l(@export.expires_at, format: :long)) %>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>

    <% unless @export&.pending? || @export&.processing? %>
      <div class="border-t border-stroke pt-6">
        <h2 class="text-lg font-semibold mb-2"><%= t('user_data_export.request_title') %></h2>
        <p class="text-sm text-gray-600 mb-4"><%= t('user_data_export.request_hint') %></p>

        <%= form_with url: user_data_export_path, method: :post, local: true, class: 'space-y-4' do |form| %>
          <div>
            <%= form.label :current_password, t('user_data_export.password_label'),
                           class: 'block text-sm font-medium text-gray-700 mb-2' %>
            <%= form.password_field :current_password,
                                    autocomplete: 'current-password',
                                    required: true,
                                    class: 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-ink' %>
            <p class="text-sm text-gray-500 mt-1"><%= t('user_data_export.password_hint') %></p>
          </div>

          <%= form.submit t('user_data_export.request_button'),
                          class: 'bg-ink text-on-fill py-2 px-4 rounded-md hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-ink transition-opacity' %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

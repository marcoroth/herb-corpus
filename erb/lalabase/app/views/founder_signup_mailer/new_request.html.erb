<p><%= t('founder_signup_mailer.new_request.intro') %></p>

<ul>
  <li><strong><%= t('activerecord.attributes.founder_signup.company_name') %>:</strong> <%= @founder_signup.company_name %></li>
  <li><strong><%= t('activerecord.attributes.founder_signup.company_seat') %>:</strong> <%= @founder_signup.company_seat %></li>
  <li><strong><%= t('activerecord.attributes.founder_signup.founded_on') %>:</strong> <%= l(@founder_signup.founded_on, format: :long) %></li>
  <li><strong><%= t('activerecord.attributes.founder_signup.revenue_band') %>:</strong> <%= t("founder_signup.revenue_bands.#{@founder_signup.revenue_band}") %></li>
  <li><strong><%= t('activerecord.attributes.founder_signup.phone') %>:</strong> <%= @founder_signup.phone %></li>
  <li><strong><%= t('activerecord.attributes.founder_signup.marketing_consent') %>:</strong>
    <%= @founder_signup.marketing_consent ? t('founder_signup.marketing_consent_granted') : t('founder_signup.marketing_consent_withheld') %></li>
</ul>

<p><%= t('founder_signup_mailer.new_request.account', name: @account.name) %></p>

<% if @console_url %>
  <p><%= link_to t('founder_signup_mailer.new_request.cta'), @console_url %></p>
<% end %>

<p><%= t('founder_signup_mailer.new_request.reminder') %></p>

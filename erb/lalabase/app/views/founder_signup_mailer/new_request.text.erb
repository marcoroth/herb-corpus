<%= t('founder_signup_mailer.new_request.intro') %>

<%= t('activerecord.attributes.founder_signup.company_name') %>: <%= @founder_signup.company_name %>
<%= t('activerecord.attributes.founder_signup.company_seat') %>: <%= @founder_signup.company_seat %>
<%= t('activerecord.attributes.founder_signup.founded_on') %>: <%= l(@founder_signup.founded_on, format: :long) %>
<%= t('activerecord.attributes.founder_signup.revenue_band') %>: <%= t("founder_signup.revenue_bands.#{@founder_signup.revenue_band}") %>
<%= t('activerecord.attributes.founder_signup.phone') %>: <%= @founder_signup.phone %>
<%= t('activerecord.attributes.founder_signup.marketing_consent') %>: <%= @founder_signup.marketing_consent ? t('founder_signup.marketing_consent_granted') : t('founder_signup.marketing_consent_withheld') %>

<%= t('founder_signup_mailer.new_request.account', name: @account.name) %>

<% if @console_url -%>
<%= @console_url %>

<% end -%>
<%= t('founder_signup_mailer.new_request.reminder') %>

<%# Per-language preview of a persona's `labels` jsonb, shared by the operator and
    in-app index tables. Unlike the two _form partials (deliberately separate —
    different design systems), this markup is byte-identical in both indexes: one
    <div> per supported language ("DE  Überblick"), em-dash when a language is
    unset. Extracted so a third language or an empty-state tweak changes one place,
    mirroring _locale_fields for the form inputs. %>
<%# locals: (persona:) -%>
<% Lalabase::Languages::SUPPORTED.each do |lang| %>
  <div><span class="text-xs font-bold text-gray-400 mr-1"><%= lang.upcase %></span><%= persona.labels&.dig(lang).presence || '—' %></div>
<% end %>

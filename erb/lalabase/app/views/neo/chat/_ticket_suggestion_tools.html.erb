<div hidden data-assistant-suggestion-composer-target="tools" class="mb-2 text-xs">
  <button type="button" class="text-cobalt-700 underline py-1" data-action="assistant-suggestion-composer#prepare"><%= t('assistant_suggestions.heading') %></button>
  <div hidden data-assistant-suggestion-composer-target="mode" class="rounded-lg border border-cream-300 p-2 mt-1 space-y-2">
    <label class="block"><%= t('assistant_suggestions.target') %>
      <select aria-label="<%= t('assistant_suggestions.target') %>" class="block w-full rounded border border-cream-300 text-base md:text-sm mt-1"
              data-assistant-suggestion-composer-target="meeting" data-action="change->assistant-suggestion-composer#select"></select>
    </label>
    <p><%= t('assistant_suggestions.visibility') %></p>
    <p><%= t('assistant_suggestions.sources') %></p>
    <p><%= t('assistant_suggestions.replaces_open', limit: number_with_delimiter(Meetings::AssistantSource::MAX_TEXT_CHARS)) %></p>
    <button type="button" class="underline" data-action="assistant-suggestion-composer#cancel"><%= t('assistant_suggestions.cancel') %></button>
  </div>
  <p role="status" data-assistant-suggestion-composer-target="status" class="text-muted mt-1"></p>
  <button hidden type="button" class="underline" data-assistant-suggestion-composer-target="retry" data-action="assistant-suggestion-composer#reloadOptions"><%= t('assistant_suggestions.reload_options') %></button>
</div>

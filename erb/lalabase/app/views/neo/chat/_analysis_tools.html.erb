<details hidden class="assistant-analysis-tools mb-2 text-xs" data-meeting-analysis-composer-target="tools" data-action="toggle->meeting-analysis-composer#toolsToggled">
  <summary class="cursor-pointer text-cobalt-700 py-1"><%= t('assistant_analysis.examples') %></summary>
  <div class="flex flex-wrap gap-2 mt-1">
    <% MeetingAnalysis::SUGGESTED_PROMPT_KEYS.first(3).each do |key| %>
      <button type="button" class="rounded-full border border-cream-300 px-2.5 py-1 hover:bg-cream-100 focus-visible:outline"
              data-action="meeting-analysis-composer#example"
              data-prompt="<%= t("views.organisations.meetings.analyses.suggestions.#{key}.text") %>">
        <%= t("views.organisations.meetings.analyses.suggestions.#{key}.label") %>
      </button>
    <% end %>
    <button type="button" class="text-cobalt-700 underline" data-meeting-analysis-composer-target="chooseTemplate" data-action="meeting-analysis-composer#choose"><%= t('assistant_analysis.choose_template') %></button>
    <button type="button" hidden class="text-muted underline" data-meeting-analysis-composer-target="saveTemplate" data-action="meeting-analysis-composer#title"><%= t('assistant_analysis.save_template') %></button>
  </div>
  <div hidden data-meeting-analysis-composer-target="picker" class="mt-2 rounded-lg border border-cream-300 p-2 space-y-2">
    <input type="search" autocomplete="off" aria-label="<%= t('assistant_analysis.search_templates') %>" placeholder="<%= t('assistant_analysis.search_templates') %>"
           class="block w-full rounded border border-cream-300 text-base md:text-sm"
           data-meeting-analysis-composer-target="search" data-action="input->meeting-analysis-composer#filter keydown.enter->meeting-analysis-composer#preventSubmit">
    <div data-meeting-analysis-composer-target="list" class="assistant-analysis-template-list space-y-1"></div>
    <%# A switch, not an action: aria-pressed carries its state (meeting-analysis-composer#setManaging). %>
    <button hidden type="button" aria-pressed="false" data-meeting-analysis-composer-target="manage" data-action="meeting-analysis-composer#toggleManage"
            data-delete-label="<%= t('assistant_analysis.delete_template') %>"
            data-delete-confirm="<%= t('assistant_analysis.delete_template_confirm', title: '__TITLE__') %>"
            class="text-cobalt-700 underline"><%= t('assistant_analysis.manage_templates') %></button>
  </div>
  <div hidden data-meeting-analysis-composer-target="titleBox" class="mt-2 space-y-2">
    <p class="text-muted"><%= t('assistant_analysis.template_hint') %></p>
    <input type="text" autocomplete="off" aria-label="<%= t('assistant_analysis.template_title') %>" placeholder="<%= t('assistant_analysis.template_title') %>"
           class="block w-full rounded border border-cream-300 text-base md:text-sm" data-meeting-analysis-composer-target="title"
           data-action="keydown.enter->meeting-analysis-composer#preventSubmit">
    <button type="button" class="rounded border border-cream-300 px-2 py-1" data-action="meeting-analysis-composer#save"><%= t('assistant_analysis.save_template') %></button>
  </div>
  <p role="status" data-meeting-analysis-composer-target="status" class="mt-1 text-muted"></p>
</details>

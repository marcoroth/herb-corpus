<% if token.revoked? %>
  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold border border-stroke bg-gray-200 text-gray-700">
    <%= t('views.users.personal_access_tokens.index.status_revoked') %>
  </span>
<% elsif token.expired? %>
  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold border border-stroke bg-amber-100 text-amber-900">
    <%= t('views.users.personal_access_tokens.index.status_expired') %>
  </span>
<% else %>
  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold border border-stroke bg-lime-200 text-cream-900">
    <%= t('views.users.personal_access_tokens.index.status_active') %>
  </span>
<% end %>

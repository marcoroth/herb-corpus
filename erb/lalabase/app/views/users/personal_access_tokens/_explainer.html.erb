<%# Plain-language "what a Personal Access Token is / is NOT" panel, shown beside the
    token list on the index. Written for non-technical readers: a token is a password
    for programs, only needed to connect external developer tools (e.g. Claude Code);
    it is NOT a login and NOT a way to invite colleagues. Mirrors the documentation
    empty-state explainer (organisations/documentation/_empty_explainer). Keep every
    string in t() (DE + EN). Long-form lives in Hilfe guides/ai/personal-access-tokens. %>
<aside class="flex flex-col gap-4 rounded-lg border border-cream-300 bg-surface-raised p-6 text-left">
  <h3 class="text-base font-semibold text-heading">
    <%= t('views.users.personal_access_tokens.index.explainer.title') %>
  </h3>

  <p class="text-sm text-muted">
    <%= t('views.users.personal_access_tokens.index.explainer.intro') %>
  </p>

  <ul class="flex flex-col gap-3 text-sm text-muted">
    <% { purpose: 'plug', scope: 'sliders', permissions: 'shield-check' }.each do |point, icon| %>
      <li class="flex items-start gap-2.5">
        <i class="bi bi-<%= icon %> mt-0.5 shrink-0 text-heading" aria-hidden="true"></i>
        <span><%= t("views.users.personal_access_tokens.index.explainer.point_#{point}") %></span>
      </li>
    <% end %>
  </ul>

  <div class="rounded-md border border-cream-300 bg-cream-100 px-3 py-2.5">
    <p class="text-xs font-semibold text-heading">
      <%= t('views.users.personal_access_tokens.index.explainer.not_title') %>
    </p>
    <p class="mt-0.5 text-xs text-muted">
      <%= t('views.users.personal_access_tokens.index.explainer.not_body') %>
    </p>
  </div>

  <p class="text-xs italic text-muted">
    <%= t('views.users.personal_access_tokens.index.explainer.reassure') %>
  </p>
</aside>

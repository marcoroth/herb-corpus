<div class="pt-6">
  <%= render NeoTitleBoxComponent.new(
    title: t('views.users.personal_access_tokens.created.title'),
    subtitle: @token.name,
    variant: :project
  ) %>

  <div class="max-w-3xl space-y-4">
    <%= render NeoCardComponent.new(variant: :amber, shadow: :always, padding: :medium) do %>
      <div class="flex items-start gap-3">
        <i class="bi bi-exclamation-triangle-fill text-2xl text-amber-700 shrink-0"></i>
        <div>
          <h3 class="text-base font-bold mb-1">
            <%= t('views.users.personal_access_tokens.created.warning_title') %>
          </h3>
          <p class="text-sm text-gray-800">
            <%= t('views.users.personal_access_tokens.created.warning_body') %>
          </p>
        </div>
      </div>
    <% end %>

    <%= render NeoCardComponent.new(variant: :white, shadow: :always, padding: :medium) do %>
      <label class="block text-xs font-bold uppercase tracking-tight text-gray-600 mb-2">
        <%= t('views.users.personal_access_tokens.created.token_label') %>
      </label>

      <div class="flex items-center gap-2"
           data-controller="clipboard"
           data-clipboard-success-text-value="<%= t('views.users.personal_access_tokens.created.copied') %>">
        <input type="text"
               readonly
               autocomplete="off"
               value="<%= @plaintext_token %>"
               data-clipboard-target="source"
               class="flex-1 h-11 px-4 rounded border-2 border-stroke bg-gray-50 font-mono text-sm text-cream-900 select-all">
        <button type="button"
                data-action="click->clipboard#copy"
                data-clipboard-target="button"
                class="h-11 px-4 rounded text-sm font-bold border-2 border-stroke bg-lime-300 hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all whitespace-nowrap">
          <i class="bi bi-clipboard mr-1"></i>
          <span data-clipboard-target="buttonLabel">
            <%= t('views.users.personal_access_tokens.created.copy') %>
          </span>
        </button>
      </div>

      <div class="text-sm text-gray-700 mt-4 border-t border-gray-200 pt-3">
        <div class="font-bold uppercase text-xs tracking-tight mb-1">
          <%= t('views.users.personal_access_tokens.created.scope_overview') %>
        </div>
        <%= render 'scope_summary', token: @token %>
      </div>

      <div class="text-sm text-gray-700 mt-3">
        <strong><%= t('views.users.personal_access_tokens.index.col_expires') %>:</strong>
        <%= l(@token.expires_at, format: :short) %>
      </div>
    <% end %>

    <div class="flex justify-end">
      <%= render Neo::Buttons::ButtonComponent.new(
        variant: :primary,
        size: :medium,
        icon: 'arrow-left',
        url: users_personal_access_tokens_path
      ) do %>
        <%= t('views.users.personal_access_tokens.created.back_to_index') %>
      <% end %>
    </div>
  </div>
</div>

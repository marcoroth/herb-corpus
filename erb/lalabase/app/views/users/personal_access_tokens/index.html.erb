<div class="pt-6">
  <%= render NeoTitleBoxComponent.new(
    title: t('views.users.personal_access_tokens.index.title'),
    subtitle: t('views.users.personal_access_tokens.index.subtitle'),
    variant: :project
  ) do |c| %>
    <% c.with_right_content do %>
      <%= render Neo::Buttons::ButtonComponent.new(
        variant: :primary,
        size: :medium,
        icon: 'plus-lg',
        url: new_users_personal_access_token_path
      ) do %>
        <%= t('views.users.personal_access_tokens.index.new_button') %>
      <% end %>
    <% end %>
  <% end %>

  <%# Two-column split: token list (left) beside the plain-language explainer (right),
      so a confused non-technical user immediately sees what this page is for. On lg the
      explainer sticks while the list scrolls; on small screens the list comes first. %>
  <div class="grid max-w-6xl grid-cols-1 gap-6 lg:grid-cols-5 lg:items-start">
    <div class="lg:col-span-3">
      <% if @tokens.empty? %>
        <%= render NeoCardComponent.new(variant: :gray, shadow: :none, padding: :large) do %>
          <p class="text-sm text-gray-700">
            <i class="bi bi-key text-2xl mb-2 block text-gray-400"></i>
            <%= t('views.users.personal_access_tokens.index.empty') %>
          </p>
        <% end %>
      <% else %>
        <div class="space-y-3">
          <% @tokens.each do |token| %>
            <%= render NeoCardComponent.new(variant: :white, shadow: :always, padding: :medium) do %>
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    <h3 class="text-base font-bold text-cream-900 truncate"><%= token.name %></h3>
                    <%= render 'status_badge', token: token %>
                  </div>
                  <div class="font-mono text-xs text-gray-500 mb-2"><%= token.token_prefix %>…</div>

                  <div class="text-xs text-gray-700 mb-2">
                    <strong><%= t('views.users.personal_access_tokens.index.col_scope') %>:</strong>
                    <%= render 'scope_summary', token: token %>
                  </div>

                  <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-500">
                    <span>
                      <i class="bi bi-calendar3"></i>
                      <%= t('views.users.personal_access_tokens.index.col_created') %>:
                      <%= l(token.created_at, format: :short) %>
                    </span>
                    <span>
                      <i class="bi bi-hourglass-split"></i>
                      <%= t('views.users.personal_access_tokens.index.col_expires') %>:
                      <%= l(token.expires_at, format: :short) %>
                    </span>
                    <% if token.last_used_at %>
                      <span>
                        <i class="bi bi-clock-history"></i>
                        <%= t('views.users.personal_access_tokens.index.col_last_used') %>:
                        <%= time_ago_in_words(token.last_used_at) %>
                      </span>
                    <% end %>
                  </div>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                  <% if token.active? %>
                    <%= render Neo::Buttons::ButtonComponent.new(
                      variant: :secondary,
                      size: :small,
                      icon: 'pencil',
                      url: edit_users_personal_access_token_path(token)
                    ) do %>
                      <%= t('views.users.personal_access_tokens.index.edit') %>
                    <% end %>
                    <%= render Neo::Buttons::ButtonComponent.new(
                      variant: :danger,
                      size: :small,
                      icon: 'x-lg',
                      url: users_personal_access_token_path(token),
                      data: {
                        turbo_method: :delete,
                        turbo_confirm: t('views.users.personal_access_tokens.index.revoke_confirm')
                      }
                    ) do %>
                      <%= t('views.users.personal_access_tokens.index.revoke') %>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="lg:col-span-2 lg:sticky lg:top-6">
      <%= render 'explainer' %>
    </div>
  </div>
</div>

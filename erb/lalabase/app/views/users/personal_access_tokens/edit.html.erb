<div class="pt-6">
  <%= render NeoTitleBoxComponent.new(
    title: t('views.users.personal_access_tokens.edit.title'),
    subtitle: @token.name,
    variant: :project
  ) %>

  <div class="max-w-2xl">
    <%= render NeoCardComponent.new(variant: :white, shadow: :always, padding: :medium) do %>
      <p class="text-sm text-gray-700 mb-4">
        <%= t('views.users.personal_access_tokens.edit.hint') %>
      </p>

      <%= form_with model: @token,
                    url: users_personal_access_token_path(@token),
                    method: :patch,
                    local: true,
                    data: { turbo: false },
                    class: "space-y-4" do |form| %>
        <div>
          <%= form.label :name, t('views.users.personal_access_tokens.new.name_label'),
                class: "block text-sm font-bold mb-1" %>
          <%= form.text_field :name,
                required: true,
                class: "w-full h-10 px-4 rounded border-2 border-stroke focus:outline-none focus:shadow-[2px_2px_0_0_#000000] transition-all bg-surface-raised" %>
        </div>

        <div>
          <label class="flex items-start gap-2 cursor-pointer">
            <%= form.check_box :read_only,
                  class: "h-5 w-5 mt-0.5 border-2 border-stroke accent-lime-400" %>
            <span>
              <span class="block text-sm font-bold"><%= t('views.users.personal_access_tokens.new.read_only_label') %></span>
              <span class="block text-xs text-gray-500"><%= t('views.users.personal_access_tokens.new.read_only_help') %></span>
            </span>
          </label>
        </div>

        <div class="text-sm text-gray-600 border-t border-gray-200 pt-4">
          <div>
            <strong><%= t('views.users.personal_access_tokens.index.col_scope') %>:</strong>
            <%= render 'scope_summary', token: @token %>
          </div>
          <div>
            <strong><%= t('views.users.personal_access_tokens.index.col_expires') %>:</strong>
            <%= l(@token.expires_at, format: :short) %>
          </div>
        </div>

        <div class="flex justify-end gap-3 pt-2">
          <%= render Neo::Buttons::ButtonComponent.new(
            variant: :secondary,
            size: :medium,
            url: users_personal_access_tokens_path
          ) do %>
            <%= t('views.users.personal_access_tokens.new.cancel') %>
          <% end %>
          <%= form.submit t('views.users.personal_access_tokens.edit.submit'),
                class: "py-2.5 px-5 rounded text-sm font-bold border-2 border-stroke bg-lime-300 hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all text-cream-900 cursor-pointer" %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<%# Notification badge for header with Neo styling %>
<div class="notification-badge-wrapper">
  <% if defined?(count) && count && count > 0 %>
    <span class="notification-badge notification-badge--default" 
          role="status" 
          aria-label="<%= pluralize(count, 'unread notification') %>">
      <%= count > 99 ? '99+' : count %>
    </span>
  <% end %>
</div>
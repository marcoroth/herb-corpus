<% if defined?(message) && message.present? %>
  <%= render NeoFlashComponent.new(
    type: local_assigns[:type] || :notice,
    message: message,
    dismissible: true,
    auto_hide: true
  ) %>
<% elsif defined?(flash) && flash.any? %>
  <%= render NeoFlashContainerComponent.new(flash: flash) %>
<% end %>
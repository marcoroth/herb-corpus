<div class="rounded-lg bg-red-50 border border-stroke p-4">
  <div class="flex">
    <div class="ml-3">
      <h3 class="text-sm font-medium text-red-800">
        <span id="error_count"><%= t('shared.form_errors.errors_found', count: object.errors.count) %></span>
      </h3>
      <div class="mt-2 text-sm text-red-700">
        <ul id="error_list" class="list-disc pl-5 space-y-1">
          <% object.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>
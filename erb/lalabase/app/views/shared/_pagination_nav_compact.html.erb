<%# app/views/shared/_pagination_nav_compact.html.erb %>
<%# Compact pagination navigation for narrow columns %>
<%
  frame_id = pagination_frame_id(frame_id: local_assigns[:frame_id])
  items_frame = pagination_items_frame(frame_id: frame_id, selected_object: local_assigns[:selected_object])
  current_items = if local_assigns.key?(:items_per_page) && local_assigns[:items_per_page].present?
                    local_assigns[:items_per_page]
                  elsif params[:items].present?
                    params[:items].to_i
                  else
                    respond_to?(:items_per_page) ? items_per_page : 20
                  end
  org = local_assigns[:current_organisation] || @current_organisation || @organisation
  proj = local_assigns[:project] || @project
  sf_id = local_assigns[:smart_folder_id]
  sp = local_assigns[:sort_params] || {}
  # base_path: a list whose address the controller name does not tell
  # (meetings_overview/_results, also rendered from MeetingsController).
  url_opts = { organisation: org, project: proj, sort_params: sp, smart_folder_id: sf_id, base_path: local_assigns[:base_path] }

  link_class = "flex items-center justify-center px-3 h-8 leading-tight [&.active]:bg-lime-300 hover:bg-lime-300 bg-surface-raised border border-stroke"
  disabled_class = "flex items-center justify-center px-3 h-8 leading-tight bg-surface-raised border border-stroke opacity-50 cursor-not-allowed"
%>

<div class="pagination-container-compact my-2"
     data-controller="neo-pagination"
     data-neo-pagination-frame-value="<%= items_frame %>">
  <div class="flex items-center gap-2">
    <%# Info text on the left %>
    <div class="flex-1">
      <span class="text-xs text-gray-400">
        <%= pagination_info_text(pagy) %>
      </span>
    </div>

    <%# Centered navigation %>
    <div class="flex items-center justify-center flex-1">
      <% if pagy.pages > 1 %>
        <nav aria-label="Pagination">
          <ul class="inline-flex items-center -space-x-px text-sm h-8 rounded hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[2px_2px_0_0_#000000] transition duration-200">
            <%# Previous page %>
            <li>
              <% if pagy.prev %>
                <a href="<%= pagination_page_url(pagy, pagy.prev, **url_opts) %>"
                   class="<%= link_class %> rounded-s"
                   data-turbo-frame="<%= frame_id %>"
                   title="<%= t('views.shared.pagination_compact.previous_page') %>">
                  <i class="bi bi-arrow-left rtl:rotate-180 text-sm"></i>
                </a>
              <% else %>
                <span class="<%= disabled_class %> rounded-s">
                  <i class="bi bi-arrow-left rtl:rotate-180 text-sm"></i>
                </span>
              <% end %>
            </li>

            <%# Compact page display %>
            <li>
              <span class="flex items-center justify-center px-3 h-8 text-sm leading-tight bg-surface-raised border border-stroke whitespace-nowrap">
                <%= t('views.shared.pagination_compact.page_of', page: pagy.page, total: pagy.pages) %>
              </span>
            </li>

            <%# Next page %>
            <li>
              <% if pagy.next %>
                <a href="<%= pagination_page_url(pagy, pagy.next, **url_opts) %>"
                   class="<%= link_class %> rounded-e"
                   data-turbo-frame="<%= frame_id %>"
                   title="<%= t('views.shared.pagination_compact.next_page') %>">
                  <i class="bi bi-arrow-right rtl:rotate-180 text-sm"></i>
                </a>
              <% else %>
                <span class="<%= disabled_class %> rounded-e">
                  <i class="bi bi-arrow-right rtl:rotate-180 text-sm"></i>
                </span>
              <% end %>
            </li>
          </ul>
        </nav>
      <% end %>
    </div>

    <%# Items-per-page select on the right %>
    <div class="flex-1 flex justify-end">
      <select class="border border-stroke rounded-md pl-3 pr-8 py-1 text-sm bg-surface-raised hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[2px_2px_0_0_#000000] transition duration-200 min-w-[90px]"
              data-action="change->neo-pagination#changeItemsPerPage">
        <% PaginationHelper::ITEMS_OPTIONS_COMPACT.each do |n| %>
          <option value="<%= pagination_items_url(n, **url_opts) %>"
                  <%= "selected" if current_items == n %>>
            <%= n %>
          </option>
        <% end %>
      </select>
    </div>
  </div>
</div>

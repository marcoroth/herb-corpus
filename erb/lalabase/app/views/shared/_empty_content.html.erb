<% empty_variant = defined?(variant) && variant.present? ? variant.to_sym : :first_time %>

<%# Canonical empty state (style guide "Leerzustände"): dashed border marks
    "nothing here (yet)" — same structure and sizing as the documentation empty
    state (organisations/documentation/_empty), which is the reference. Fills
    its container (grid cell / list area); text stays at reading width. %>
<div class="flex h-full w-full flex-col items-center justify-center gap-3 rounded-lg border border-dashed border-cream-300 px-6 py-16 text-center">
  <% if defined?(message) && message.present? %>
    <div class="p-3 bg-green-50 text-green-800 border border-green-200 rounded">
      <p class="font-medium text-sm"><%= message %></p>
    </div>
  <% end %>

  <div class="flex h-14 w-14 items-center justify-center rounded-full bg-surface-raised">
    <i class="<%= defined?(icon_class) && icon_class.present? ? icon_class : 'bi bi-list-task' %> text-2xl text-muted"></i>
  </div>

  <h2 class="text-lg font-semibold text-heading">
    <%= defined?(title) && title.present? ? title : t('shared.empty_content.default_title') %>
  </h2>

  <p class="max-w-md text-sm text-muted leading-relaxed">
    <%= defined?(description) && description.present? ? description : t('shared.empty_content.default_description') %>
  </p>

  <% if defined?(actions) && actions.present? %>
    <div class="flex flex-wrap justify-center gap-3">
      <%= actions %>
    </div>
  <% elsif defined?(cta_text) && cta_text.present? && defined?(cta_url) && cta_url.present? %>
    <%# P4/AP5: Komponente statt handgebaut → border-stroke + lime-300 + Schatten + Hover + Fokus-Ring (B1/B4). %>
    <div class="flex justify-center">
      <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, icon: "plus-lg", size: :large, url: cta_url) do %>
        <%= cta_text %>
      <% end %>
    </div>
  <% end %>
</div>

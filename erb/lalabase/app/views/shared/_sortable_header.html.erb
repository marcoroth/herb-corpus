<%# Sortable table header %>
<%
  # The address of this request with the new sorting.
  sort_query_params = { sort: { column: column, direction: sort_direction == "asc" ? "desc" : "asc" } }

  # The saved view and the project of the address travel with the link. Both
  # through `permit`, which keeps scalars only: read from `params` directly, a
  # value sent as a hash (`?project_id[a]=1`) raised in `to_query` (until 2026-11-19).
  sort_query_params.merge!(params.permit(:smart_folder_id, :project_id).to_h.compact_blank)

  # No page: a new sorting starts at page 1. The search stays.
  sort_query_params.merge!(params.permit(:search, :context_type, :filter).to_h)

  # The path of this request without its format (PaginationHelper#page_url_base_path),
  # not url_for with the path parameters: that raised "arguments passed to url_for
  # can't be handled", and the tag list, the only page with this header, answered
  # 500 until 2026-11-19.
  sort_url = "#{page_url_base_path}?#{sort_query_params.to_query}"
%>
<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider cursor-pointer hover:bg-gray-50">
  <a href="<%= sort_url %>" class="text-gray-500 no-underline" data-turbo="true">
    <div class="flex items-center space-x-1">
      <span><%= title %></span>
      <span class="sort-icon">
        <% if sort_column == column %>
          <%= sort_direction == "asc" ? "↑" : "↓" %>
        <% else %>
          <span class="text-gray-400">↕</span>
        <% end %>
      </span>
    </div>
  </a>
</th>

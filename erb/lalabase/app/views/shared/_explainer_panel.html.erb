<%# locals: (i18n_scope:, points:) %>
<%# Plain-language explainer aside for first-time empty states: what an area is,
    what you can do with it and — optionally — what it is NOT, written for
    non-technical readers. `points` maps point key => Bootstrap icon name; the
    texts live under `<i18n_scope>.point_<key>` next to a required `title` and
    the optional `intro`, `not_title` + `not_body` and `reassure` keys (DE + EN
    in the area locale file). Same pattern as
    organisations/documentation/_empty_explainer and
    users/personal_access_tokens/_explainer (PRs #301/#302) — fold those onto
    this partial once they land. %>
<% intro = t("#{i18n_scope}.intro", default: nil) %>
<% not_title = t("#{i18n_scope}.not_title", default: nil) %>
<% reassure = t("#{i18n_scope}.reassure", default: nil) %>
<aside class="flex h-full flex-col gap-4 rounded-lg border border-cream-300 bg-surface-raised p-6 text-left">
  <h3 class="text-base font-semibold text-heading">
    <%= t("#{i18n_scope}.title") %>
  </h3>

  <% if intro.present? %>
    <p class="text-sm text-muted"><%= intro %></p>
  <% end %>

  <ul class="flex flex-col gap-3 text-sm text-muted">
    <% points.each do |key, icon| %>
      <li class="flex items-start gap-2.5">
        <i class="bi bi-<%= icon %> mt-0.5 shrink-0 text-heading" aria-hidden="true"></i>
        <span><%= t("#{i18n_scope}.point_#{key}") %></span>
      </li>
    <% end %>
  </ul>

  <% if not_title.present? %>
    <div class="mt-auto rounded-md border border-cream-300 bg-cream-100 px-3 py-2.5">
      <p class="text-xs font-semibold text-heading"><%= not_title %></p>
      <p class="mt-0.5 text-xs text-muted"><%= t("#{i18n_scope}.not_body") %></p>
    </div>
  <% end %>

  <% if reassure.present? %>
    <p class="text-xs italic text-muted"><%= reassure %></p>
  <% end %>
</aside>

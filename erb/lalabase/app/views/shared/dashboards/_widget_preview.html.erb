<%# Live preview content for one widget slot (front of the flip card). Rendered inline by _edit_slot
    AND returned by the widget_preview endpoint when settings change on the back, so the inline render
    and the refreshed render can never diverge. pointer-events-none: a preview, not a live widget.
    Locals: component (ViewComponent instance or nil), widget_label, no_access. %>
<% if no_access %>
  <div class="dashboard-edit-placeholder"><i class="bi bi-lock" aria-hidden="true"></i> <%= t('dashboard.configuration.no_access') %></div>
<% elsif component&.should_render? %>
  <div class="pointer-events-none select-none"><%= render component %></div>
<% else %>
  <div class="dashboard-edit-placeholder"><%= widget_label %></div>
<% end %>

<div class="container mx-auto px-8 py-8 max-w-7xl">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-4xl font-black text-black uppercase mb-2">Drag & Drop</h1>
    <p class="text-gray-600">Interaktive Sortierung mit SortableJS</p>
  </div>

  <!-- Basic Example -->
  <div class="border-2 border-black rounded-lg bg-white p-6 mb-8 shadow-[2px_2px_0_0_#000000]">
    <h2 class="text-2xl font-bold mb-4">Basis Implementierung</h2>
    
    <div class="mb-6">
      <h3 class="text-lg font-bold mb-2">Live Demo</h3>
      <div class="border-2 border-black rounded-lg p-4 bg-gray-50">
        <div data-controller="sortable" 
             data-sortable-animation-value="150"
             data-sortable-update-url-value="#"
             class="space-y-2">
          <% ['Erstes Element', 'Zweites Element', 'Drittes Element', 'Viertes Element'].each_with_index do |item, index| %>
            <div class="flex items-center gap-3 p-3 bg-white border border-gray-300 rounded-lg hover:shadow-md transition-shadow cursor-move"
                 data-id="item-<%= index %>">
              <i class="bi bi-grip-vertical text-gray-400"></i>
              <span class="font-medium"><%= item %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="mb-6">
      <h3 class="text-lg font-bold mb-2">Code</h3>
      <pre class="bg-gray-100 border border-black rounded p-4 text-sm overflow-x-auto"><code>&lt;div data-controller="sortable" 
     data-sortable-animation-value="150"
     data-sortable-update-url-value="#"
     class="space-y-2"&gt;
  &lt;% items.each do |item| %&gt;
    &lt;div class="..." data-id="&lt;%= item.id %&gt;"&gt;
      &lt;i class="bi bi-grip-vertical"&gt;&lt;/i&gt;
      &lt;%= item.name %&gt;
    &lt;/div&gt;
  &lt;% end %&gt;
&lt;/div&gt;</code></pre>
    </div>

    <div class="bg-yellow-50 border-2 border-yellow-400 rounded-lg p-4">
      <p class="text-sm font-bold mb-2">Wichtig:</p>
      <ul class="text-sm space-y-1 list-disc list-inside">
        <li>Jedes sortierbare Element braucht ein <code class="bg-gray-200 px-1 rounded">data-id</code> Attribut</li>
        <li>Der Container benötigt <code class="bg-gray-200 px-1 rounded">data-controller="sortable"</code></li>
        <li>Optional: <code class="bg-gray-200 px-1 rounded">data-sortable-update-url-value</code> für Server-Updates</li>
      </ul>
    </div>
  </div>

  <!-- With Handle -->
  <div class="border-2 border-black rounded-lg bg-white p-6 mb-8 shadow-[2px_2px_0_0_#000000]">
    <h2 class="text-2xl font-bold mb-4">Mit Handle (Griff)</h2>
    
    <div class="mb-6">
      <h3 class="text-lg font-bold mb-2">Live Demo</h3>
      <div class="border-2 border-black rounded-lg p-4 bg-gray-50">
        <div data-controller="sortable" 
             data-sortable-animation-value="150"
             class="space-y-2">
          <% ['Status 1', 'Status 2', 'Status 3'].each_with_index do |status, index| %>
            <div class="flex items-center gap-3 p-3 bg-white border-2 border-black rounded-lg"
                 data-id="status-<%= index %>">
              <span data-sortable-target="handle" class="cursor-move">
                <i class="bi bi-grip-vertical text-gray-600 text-xl"></i>
              </span>
              <div class="flex-1">
                <span class="font-bold"><%= status %></span>
                <span class="text-sm text-gray-500 ml-2">Position: <%= index + 1 %></span>
              </div>
              <span class="px-3 py-1 bg-lime-200 rounded-full text-sm font-bold">
                <%= ['Offen', 'In Arbeit', 'Erledigt'][index] %>
              </span>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="bg-red-50 border-2 border-red-400 rounded-lg p-4 mb-6">
      <p class="text-sm font-bold mb-2">⚠️ Achtung bei Modals:</p>
      <p class="text-sm">
        Die Handle-Option kann in Modals zu Problemen führen (Drag funktioniert, Drop nicht). 
        In diesem Fall die Handle-Option weglassen und das gesamte Element ziehbar machen.
      </p>
    </div>

    <div class="mb-6">
      <h3 class="text-lg font-bold mb-2">Code mit Handle</h3>
      <pre class="bg-gray-100 border border-black rounded p-4 text-sm overflow-x-auto"><code>&lt;div data-controller="sortable"&gt;
  &lt;div data-id="item-1"&gt;
    &lt;span data-sortable-target="handle" class="cursor-move"&gt;
      &lt;i class="bi bi-grip-vertical"&gt;&lt;/i&gt;
    &lt;/span&gt;
    &lt;!-- Rest of content --&gt;
  &lt;/div&gt;
&lt;/div&gt;</code></pre>
    </div>
  </div>

  <!-- Styling -->
  <div class="border-2 border-black rounded-lg bg-white p-6 mb-8 shadow-[2px_2px_0_0_#000000]">
    <h2 class="text-2xl font-bold mb-4">CSS Klassen</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <h3 class="text-lg font-bold mb-2">Drag States</h3>
        <table class="w-full border-2 border-black">
          <thead class="bg-gray-100">
            <tr>
              <th class="border-b-2 border-black p-2 text-left">Klasse</th>
              <th class="border-b-2 border-black p-2 text-left">Beschreibung</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="border-b border-black p-2"><code>.sortable-ghost</code></td>
              <td class="border-b border-black p-2">Platzhalter beim Ziehen</td>
            </tr>
            <tr>
              <td class="border-b border-black p-2"><code>.sortable-chosen</code></td>
              <td class="border-b border-black p-2">Ausgewähltes Element</td>
            </tr>
            <tr>
              <td class="p-2"><code>.sortable-drag</code></td>
              <td class="p-2">Element während des Ziehens</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div>
        <h3 class="text-lg font-bold mb-2">Standard Styles</h3>
        <pre class="bg-gray-100 border border-black rounded p-4 text-sm overflow-x-auto"><code>.sortable-ghost {
  opacity: 0.4;
  background-color: #f3f4f6;
}

.sortable-chosen {
  background-color: #fef3c7;
  cursor: move !important;
}

.sortable-drag {
  opacity: 1 !important;
  z-index: 70 !important; /* popover - above content during drag */
  cursor: move !important;
}</code></pre>
      </div>
    </div>
  </div>

  <!-- Server Integration -->
  <div class="border-2 border-black rounded-lg bg-white p-6 mb-8 shadow-[2px_2px_0_0_#000000]">
    <h2 class="text-2xl font-bold mb-4">Server Integration</h2>
    
    <div class="mb-6">
      <h3 class="text-lg font-bold mb-2">Frontend</h3>
      <pre class="bg-gray-100 border border-black rounded p-4 text-sm overflow-x-auto"><code>&lt;div data-controller="sortable"
     data-sortable-update-url-value="&lt;%= sort_organisation_ticket_statuses_path(@current_organisation) %&gt;"&gt;
  &lt;!-- Items --&gt;
&lt;/div&gt;</code></pre>
    </div>

    <div class="mb-6">
      <h3 class="text-lg font-bold mb-2">Controller (Ruby)</h3>
      <pre class="bg-gray-100 border border-black rounded p-4 text-sm overflow-x-auto"><code>def sort
  params[:ticket_status].each_with_index do |id, index|
    TicketStatus.find(id).update(position: index)
  end
  head :ok
end</code></pre>
    </div>

    <div class="bg-cobalt-50 border-2 border-cobalt-400 rounded-lg p-4">
      <p class="text-sm font-bold mb-2">Integration via Importmap:</p>
      <pre class="bg-white border border-gray-300 rounded p-2 text-xs"><code># config/importmap.rb
pin "sortablejs", preload: false # @1.15.2, vendored in vendor/javascript/sortablejs.js</code></pre>
    </div>
  </div>

  <!-- Troubleshooting -->
  <div class="border-2 border-black rounded-lg bg-white p-6 mb-8 shadow-[2px_2px_0_0_#000000]">
    <h2 class="text-2xl font-bold mb-4">Fehlerbehebung</h2>
    
    <div class="space-y-4">
      <div class="border-l-4 border-red-500 pl-4">
        <h3 class="font-bold text-red-700">Problem: Drag & Drop funktioniert nicht in Modals</h3>
        <p class="text-sm mt-1">
          <strong>Lösung:</strong> Handle-Option entfernen und gesamtes Element ziehbar machen. 
          Die Handle-Option kann in Modals zu Konflikten führen.
        </p>
      </div>

      <div class="border-l-4 border-red-500 pl-4">
        <h3 class="font-bold text-red-700">Problem: Elemente springen beim Ziehen</h3>
        <p class="text-sm mt-1">
          <strong>Lösung:</strong> CSS-Position und z-index prüfen. Container sollte <code>position: relative</code> haben.
        </p>
      </div>

      <div class="border-l-4 border-red-500 pl-4">
        <h3 class="font-bold text-red-700">Problem: Server-Update schlägt fehl</h3>
        <p class="text-sm mt-1">
          <strong>Lösung:</strong> CSRF-Token und korrekten Update-URL prüfen. 
          Console auf Netzwerk-Fehler untersuchen.
        </p>
      </div>
    </div>
  </div>

  <!-- Best Practices -->
  <div class="border-2 border-black rounded-lg bg-white p-6 mb-8 shadow-[2px_2px_0_0_#000000]">
    <h2 class="text-2xl font-bold mb-4">Best Practices</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <h3 class="text-lg font-bold mb-3">Do's ✅</h3>
        <ul class="space-y-2 text-sm">
          <li class="flex items-start">
            <i class="bi bi-check-circle-fill text-green-500 mr-2 mt-0.5"></i>
            <span>Immer <code>data-id</code> Attribute verwenden</span>
          </li>
          <li class="flex items-start">
            <i class="bi bi-check-circle-fill text-green-500 mr-2 mt-0.5"></i>
            <span>Visuelle Feedback mit CSS-Klassen geben</span>
          </li>
          <li class="flex items-start">
            <i class="bi bi-check-circle-fill text-green-500 mr-2 mt-0.5"></i>
            <span>Touch-Support durch Importmap-Version</span>
          </li>
          <li class="flex items-start">
            <i class="bi bi-check-circle-fill text-green-500 mr-2 mt-0.5"></i>
            <span>Minimale Konfiguration für Modals</span>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-lg font-bold mb-3">Don'ts ❌</h3>
        <ul class="space-y-2 text-sm">
          <li class="flex items-start">
            <i class="bi bi-x-circle-fill text-red-500 mr-2 mt-0.5"></i>
            <span>CDN-Version verwenden (nutze Importmap)</span>
          </li>
          <li class="flex items-start">
            <i class="bi bi-x-circle-fill text-red-500 mr-2 mt-0.5"></i>
            <span>Handle in Modals erzwingen</span>
          </li>
          <li class="flex items-start">
            <i class="bi bi-x-circle-fill text-red-500 mr-2 mt-0.5"></i>
            <span>Komplexe forceFallback-Optionen</span>
          </li>
          <li class="flex items-start">
            <i class="bi bi-x-circle-fill text-red-500 mr-2 mt-0.5"></i>
            <span>Vergessen den Controller zu destroyen</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Documentation Reference -->
  <div class="border-2 border-black rounded-lg bg-cobalt-50 p-6 shadow-[2px_2px_0_0_#000000]">
    <h2 class="text-2xl font-bold mb-4">Weiterführende Dokumentation</h2>
    
    <div class="flex items-start">
      <i class="bi bi-file-earmark-text text-2xl text-cobalt-600 mr-3"></i>
      <div>
        <p class="text-sm mb-2">
          Detaillierte technische Dokumentation zur ViewConfiguration und Drag & Drop Implementierung findest du unter:
        </p>
        <code class="bg-white border border-gray-300 rounded px-2 py-1 text-sm">
          docs/dokumentation/view_configuration_drag_drop.md
        </code>
        <p class="text-sm mt-3 text-gray-600">
          Die Dokumentation enthält:
        </p>
        <ul class="text-sm mt-2 space-y-1 list-disc list-inside text-gray-600">
          <li>Architektur-Details zum ViewConfiguration Model</li>
          <li>Migration von CDN zu Importmap</li>
          <li>Ausführliche Problemlösungen</li>
          <li>Testing-Strategien</li>
          <li>Debugging-Tipps</li>
        </ul>
      </div>
    </div>
  </div>
</div>
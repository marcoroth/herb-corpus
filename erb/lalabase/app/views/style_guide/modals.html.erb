<div class="container mx-auto px-8 py-8 max-w-7xl">
  
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-4xl font-black text-black uppercase mb-2">Modals</h1>
    <p class="text-gray-600">Modal-Dialoge für Formulare und Interaktionen im Neo Brutalist Style</p>
  </div>

  <!-- Design Principles -->
  <div class="border-2 border-black rounded-lg bg-white p-6 mb-8 shadow-[2px_2px_0_0_#000000]">
    <h2 class="text-2xl font-bold mb-4">Design-Prinzipien</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <h3 class="font-bold mb-2">Struktur</h3>
        <ul class="space-y-1 text-sm">
          <li>• Halbtransparenter Backdrop (bg-gray-500/60)</li>
          <li>• Weißer Container mit 2px schwarzem Border</li>
          <li>• Header mit Hintergrundfarbe (je nach Kontext)</li>
          <li>• Klare Trennung zwischen Header, Content und Footer</li>
        </ul>
      </div>
      <div>
        <h3 class="font-bold mb-2">Interaktion</h3>
        <ul class="space-y-1 text-sm">
          <li>• ESC-Taste zum Schließen</li>
          <li>• Klick auf Backdrop schließt Modal</li>
          <li>• X-Button oben rechts</li>
          <li>• Body-Overflow wird verhindert</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Implementation Guide -->
  <div class="border-2 border-black rounded-lg bg-yellow-50 p-6 mb-8">
    <h2 class="text-xl font-bold mb-4">
      <i class="bi bi-exclamation-triangle-fill text-yellow-600 mr-2"></i>
      Wichtig: Modal Pattern Dokumentation
    </h2>
    <p class="mb-4">
      Für die Implementierung von Modals <strong>IMMER</strong> die ausführliche Dokumentation konsultieren:
    </p>
    <div class="bg-white border-2 border-black rounded p-4">
      <code class="text-sm font-mono">docs/dokumentation/modal_pattern.md</code>
    </div>
    <p class="mt-4 text-sm text-gray-600">
      Die TimeSession-Modal-Implementierung dient als Referenz für alle neuen Modals.
    </p>
  </div>

  <!-- Examples -->
  <div class="space-y-8">
    <!-- Basic Modal Example -->
    <div class="border-2 border-black rounded-lg bg-white overflow-hidden">
      <div class="bg-gray-100 border-b-2 border-black p-4">
        <h3 class="font-bold">Basic Modal</h3>
      </div>
      <div class="p-6">
        <p class="text-sm text-gray-600 mb-4">Standard Modal für Formulare und einfache Interaktionen</p>
        
        <!-- Code Example -->
        <div class="mt-6">
          <h4 class="font-bold text-sm mb-2">HTML Struktur:</h4>
          <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;div data-controller="modal-name"&gt;
  &lt;button data-action="click->modal-name#open"&gt;Öffnen&lt;/button&gt;
  
  &lt;div class="fixed z-modal inset-0 overflow-y-auto hidden" 
       data-modal-name-target="modal"&gt;
    &lt;!-- Backdrop --&gt;
    &lt;div class="fixed inset-0 bg-gray-500 bg-opacity-60 backdrop-blur-sm"&gt;&lt;/div&gt;
    
    &lt;!-- Modal Content --&gt;
    &lt;div class="flex items-center justify-center min-h-screen p-4"&gt;
      &lt;div class="bg-white rounded-lg shadow-xl max-w-md w-full relative border-2 border-black"&gt;
        &lt;!-- Header, Content, Footer --&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;</code></pre>
        </div>
      </div>
    </div>

    <!-- Color Variants -->
    <div class="border-2 border-black rounded-lg bg-white overflow-hidden">
      <div class="bg-gray-100 border-b-2 border-black p-4">
        <h3 class="font-bold">Header-Varianten</h3>
      </div>
      <div class="p-6">
        <p class="text-sm text-gray-600 mb-6">Verschiedene Header-Farben für unterschiedliche Kontexte</p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Success -->
          <div class="border-2 border-black rounded-lg overflow-hidden">
            <div class="border-b-2 border-black p-4 bg-lime-50">
              <div class="flex justify-between items-center">
                <h4 class="font-bold">Erfolg / Standard</h4>
                <i class="bi bi-x-lg"></i>
              </div>
            </div>
            <div class="p-4 text-sm">
              <code>bg-lime-50</code>
            </div>
          </div>
          
          <!-- Info -->
          <div class="border-2 border-black rounded-lg overflow-hidden">
            <div class="border-b-2 border-black p-4 bg-cobalt-50">
              <div class="flex justify-between items-center">
                <h4 class="font-bold">Information</h4>
                <i class="bi bi-x-lg"></i>
              </div>
            </div>
            <div class="p-4 text-sm">
              <code>bg-cobalt-50</code>
            </div>
          </div>
          
          <!-- Warning -->
          <div class="border-2 border-black rounded-lg overflow-hidden">
            <div class="border-b-2 border-black p-4 bg-yellow-50">
              <div class="flex justify-between items-center">
                <h4 class="font-bold">Warnung</h4>
                <i class="bi bi-x-lg"></i>
              </div>
            </div>
            <div class="p-4 text-sm">
              <code>bg-yellow-50</code>
            </div>
          </div>
          
          <!-- Danger -->
          <div class="border-2 border-black rounded-lg overflow-hidden">
            <div class="border-b-2 border-black p-4 bg-red-50">
              <div class="flex justify-between items-center">
                <h4 class="font-bold">Gefahr / Löschen</h4>
                <i class="bi bi-x-lg"></i>
              </div>
            </div>
            <div class="p-4 text-sm">
              <code>bg-red-50</code>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Size Variants -->
    <div class="border-2 border-black rounded-lg bg-white overflow-hidden">
      <div class="bg-gray-100 border-b-2 border-black p-4">
        <h3 class="font-bold">Größen-Varianten</h3>
      </div>
      <div class="p-6">
        <div class="space-y-4">
          <div class="flex items-center gap-4">
            <span class="font-bold text-sm w-24">Small:</span>
            <code class="text-sm bg-gray-100 px-2 py-1 rounded">max-w-sm (384px)</code>
            <span class="text-sm text-gray-600">Für kurze Bestätigungen</span>
          </div>
          <div class="flex items-center gap-4">
            <span class="font-bold text-sm w-24">Medium:</span>
            <code class="text-sm bg-gray-100 px-2 py-1 rounded">max-w-md (448px)</code>
            <span class="text-sm text-gray-600">Standard für die meisten Formulare</span>
          </div>
          <div class="flex items-center gap-4">
            <span class="font-bold text-sm w-24">Large:</span>
            <code class="text-sm bg-gray-100 px-2 py-1 rounded">max-w-2xl (672px)</code>
            <span class="text-sm text-gray-600">Für komplexe Formulare</span>
          </div>
          <div class="flex items-center gap-4">
            <span class="font-bold text-sm w-24">X-Large:</span>
            <code class="text-sm bg-gray-100 px-2 py-1 rounded">max-w-4xl (896px)</code>
            <span class="text-sm text-gray-600">Für Tabellen oder Konfigurationen</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Best Practices -->
    <div class="border-2 border-black rounded-lg bg-white overflow-hidden">
      <div class="bg-gray-100 border-b-2 border-black p-4">
        <h3 class="font-bold">Best Practices</h3>
      </div>
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <h4 class="font-bold mb-2 text-green-600">
              <i class="bi bi-check-circle-fill mr-1"></i>
              DO's
            </h4>
            <ul class="space-y-2 text-sm">
              <li>✓ Stimulus Controller für Interaktivität verwenden</li>
              <li>✓ Turbo Frames für dynamischen Content nutzen</li>
              <li>✓ ESC-Taste und Backdrop-Klick implementieren</li>
              <li>✓ Body-Overflow beim Öffnen verhindern</li>
              <li>✓ Klare visuelle Hierarchie einhalten</li>
              <li>✓ Form-Reset nach dem Schließen</li>
            </ul>
          </div>
          <div>
            <h4 class="font-bold mb-2 text-red-600">
              <i class="bi bi-x-circle-fill mr-1"></i>
              DON'Ts
            </h4>
            <ul class="space-y-2 text-sm">
              <li>✗ Verschachtelte Modals vermeiden</li>
              <li>✗ Keine wichtigen Aktionen nur im Modal</li>
              <li>✗ Zu viel Content in einem Modal</li>
              <li>✗ Automatisches Öffnen ohne User-Aktion</li>
              <li>✗ Fehlende Schließ-Möglichkeiten</li>
              <li>✗ Inkonsistente Styling-Patterns</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


<div class="container mx-auto px-8 py-8 max-w-7xl">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-4xl font-black text-black uppercase mb-2">Typografie</h1>
    <p class="text-gray-600">Schriftarten und Text-Stile</p>
  </div>
  
  <!-- Headings -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Überschriften</h2>
    <div class="space-y-6">
      <div class="border-2 border-black rounded-lg p-6 bg-white">
        <h1 class="text-4xl font-black text-black uppercase mb-2">H1: Hauptüberschrift</h1>
        <p class="text-sm font-mono text-gray-600">text-4xl font-black uppercase</p>
      </div>
      
      <div class="border-2 border-black rounded-lg p-6 bg-white">
        <h2 class="text-2xl font-bold mb-2">H2: Abschnittsüberschrift</h2>
        <p class="text-sm font-mono text-gray-600">text-2xl font-bold</p>
      </div>
      
      <div class="border-2 border-black rounded-lg p-6 bg-white">
        <h3 class="text-xl font-bold mb-2">H3: Unterüberschrift</h3>
        <p class="text-sm font-mono text-gray-600">text-xl font-bold</p>
      </div>
      
      <div class="border-2 border-black rounded-lg p-6 bg-white">
        <h4 class="text-lg font-bold mb-2">H4: Kleine Überschrift</h4>
        <p class="text-sm font-mono text-gray-600">text-lg font-bold</p>
      </div>
    </div>
  </section>
  
  <!-- Body Text -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Fließtext</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="border-2 border-black rounded-lg p-6 bg-white">
        <h3 class="font-bold mb-3">Standard Text</h3>
        <p class="mb-2">Dies ist ein normaler Absatz mit Standardschriftgröße. Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
        <p class="text-sm font-mono text-gray-600">text-base (default)</p>
      </div>
      
      <div class="border-2 border-black rounded-lg p-6 bg-white">
        <h3 class="font-bold mb-3">Kleiner Text</h3>
        <p class="text-sm mb-2">Dies ist ein kleinerer Text für Beschreibungen und Hinweise.</p>
        <p class="text-sm font-mono text-gray-600">text-sm</p>
      </div>
      
      <div class="border-2 border-black rounded-lg p-6 bg-white">
        <h3 class="font-bold mb-3">Sehr kleiner Text</h3>
        <p class="text-xs mb-2">Dies ist sehr kleiner Text für Metadaten und Zeitstempel.</p>
        <p class="text-sm font-mono text-gray-600">text-xs</p>
      </div>
      
      <div class="border-2 border-black rounded-lg p-6 bg-white">
        <h3 class="font-bold mb-3">Großer Text</h3>
        <p class="text-lg mb-2">Dies ist größerer Text für Hervorhebungen.</p>
        <p class="text-sm font-mono text-gray-600">text-lg</p>
      </div>
    </div>
  </section>
  
  <!-- Font Weights -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Schriftgewichte</h2>
    <div class="space-y-4">
      <div class="border-2 border-black rounded-lg p-4 bg-white">
        <p class="font-normal">font-normal: Normale Schriftstärke für Fließtext</p>
      </div>
      <div class="border-2 border-black rounded-lg p-4 bg-white">
        <p class="font-medium">font-medium: Mittlere Schriftstärke für leichte Betonung</p>
      </div>
      <div class="border-2 border-black rounded-lg p-4 bg-white">
        <p class="font-semibold">font-semibold: Halbfette Schrift für Zwischenüberschriften</p>
      </div>
      <div class="border-2 border-black rounded-lg p-4 bg-white">
        <p class="font-bold">font-bold: Fette Schrift für wichtige Elemente</p>
      </div>
      <div class="border-2 border-black rounded-lg p-4 bg-white">
        <p class="font-black">font-black: Extra fette Schrift für maximale Betonung</p>
      </div>
    </div>
  </section>
  
  <!-- Text Colors -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Textfarben</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="border-2 border-black rounded-lg p-4 bg-white">
        <p class="text-black mb-2">text-black: Primäre Textfarbe</p>
        <p class="text-sm font-mono text-gray-600">#000000</p>
      </div>
      <div class="border-2 border-black rounded-lg p-4 bg-white">
        <p class="text-gray-600 mb-2">text-gray-600: Sekundäre Textfarbe</p>
        <p class="text-sm font-mono text-gray-600">#4b5563</p>
      </div>
      <div class="border-2 border-black rounded-lg p-4 bg-white">
        <p class="text-gray-500 mb-2">text-gray-500: Deaktivierter Text</p>
        <p class="text-sm font-mono text-gray-600">#6b7280</p>
      </div>
      <div class="border-2 border-black rounded-lg p-4 bg-white">
        <p class="text-red-600 mb-2">text-red-600: Fehlertext</p>
        <p class="text-sm font-mono text-gray-600">#dc2626</p>
      </div>
    </div>
  </section>
  
  <!-- Special Styles -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Spezielle Stile</h2>
    <div class="space-y-6">
      <div class="border-2 border-black rounded-lg p-6 bg-white">
        <h3 class="font-bold mb-3">Uppercase Labels</h3>
        <p class="text-xs font-black uppercase tracking-wider mb-2">KATEGORIEN</p>
        <p class="text-sm font-mono text-gray-600">text-xs font-black uppercase tracking-wider</p>
      </div>
      
      <div class="border-2 border-black rounded-lg p-6 bg-white">
        <h3 class="font-bold mb-3">Monospace Code</h3>
        <p class="font-mono bg-gray-100 p-2 rounded border border-gray-300">const button = new Neo::Buttons::ButtonComponent();</p>
        <p class="text-sm font-mono text-gray-600 mt-2">font-mono</p>
      </div>
      
      <div class="border-2 border-black rounded-lg p-6 bg-white">
        <h3 class="font-bold mb-3">Links</h3>
        <p>
          <a href="#" class="text-cobalt-600 hover:text-cobalt-800 underline">Standard Link</a><br>
          <a href="#" class="text-black hover:underline">Dezenter Link</a>
        </p>
        <p class="text-sm font-mono text-gray-600 mt-2">text-cobalt-600 hover:text-cobalt-800 underline</p>
      </div>
    </div>
  </section>
  
  <!-- Usage Guidelines -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Verwendungsrichtlinien</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="border-2 border-black rounded-lg p-6 bg-yellow-50">
        <h3 class="font-bold mb-3">Do's ✓</h3>
        <ul class="space-y-2 text-sm">
          <li>• <strong>font-black</strong> für Hauptüberschriften verwenden</li>
          <li>• <strong>uppercase</strong> für Labels und Kategorien</li>
          <li>• <strong>font-mono</strong> für Code und technische Begriffe</li>
          <li>• Ausreichend Kontrast für Lesbarkeit</li>
        </ul>
      </div>
      
      <div class="border-2 border-black rounded-lg p-6 bg-red-50">
        <h3 class="font-bold mb-3">Don'ts ✗</h3>
        <ul class="space-y-2 text-sm">
          <li>• Keine zu dünnen Schriftgewichte (< font-normal)</li>
          <li>• Keine zu hellen Grautöne für wichtigen Text</li>
          <li>• Kein übermäßiger Einsatz von uppercase</li>
          <li>• Keine zu kleinen Schriftgrößen (< text-xs)</li>
        </ul>
      </div>
    </div>
  </section>
</div>
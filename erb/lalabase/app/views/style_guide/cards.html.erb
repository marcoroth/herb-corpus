<div class="container mx-auto px-8 py-8 max-w-7xl">
  
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-4xl font-black text-black uppercase mb-2">Card Komponenten</h1>
    <p class="text-gray-600">Card-Komponenten für die Darstellung von Inhalten in einem strukturierten, interaktiven Format</p>
  </div>

  <!-- Basic Card -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Basic Card</h2>
    <p class="text-gray-600 mb-6">Grundlegende Card mit Hover-Effekt und optionalem Footer.</p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
      <!-- Basic Card -->
      <div class="border-2 border-black rounded-lg bg-white shadow-[2px_2px_0_0_#000000] hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all">
        <div class="p-6">
          <h3 class="text-xl font-black uppercase tracking-tight mb-2">Card Title</h3>
          <p class="text-sm text-gray-600">
            Dies ist eine einfache Card mit grundlegendem Styling und Hover-Effekt.
          </p>
        </div>
      </div>

      <!-- Card with Footer -->
      <div class="border-2 border-black rounded-lg bg-white shadow-[2px_2px_0_0_#000000] hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all flex flex-col">
        <div class="p-6 flex-1">
          <h3 class="text-xl font-black uppercase tracking-tight mb-2">Mit Footer</h3>
          <p class="text-sm text-gray-600">
            Card mit separatem Footer-Bereich für Actions oder Status.
          </p>
        </div>
        <div class="px-6 py-4 border-t-2 border-black bg-gray-50 rounded-b-lg">
          <span class="text-sm text-gray-700">Footer Content</span>
        </div>
      </div>

      <!-- Card with Status Badge -->
      <div class="border-2 border-black rounded-lg bg-white shadow-[2px_2px_0_0_#000000] hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all flex flex-col">
        <div class="p-6 flex-1">
          <h3 class="text-xl font-black uppercase tracking-tight mb-2">Mit Status</h3>
          <p class="text-sm text-gray-600">
            Card mit Status-Badge im Footer.
          </p>
        </div>
        <div class="px-6 py-4 border-t-2 border-black bg-gray-50 rounded-b-lg flex items-center justify-between">
          <span class="inline-flex items-center gap-x-1.5 py-1.5 px-3 rounded-full text-xs font-medium border border-black bg-lime-200 text-black">
            Aktiv
          </span>
          <div class="flex gap-2">
            <%= render Neo::Buttons::IconButtonComponent.new(
              variant: :edit,
              size: :small,
              icon: "pencil"
            ) %>
            <%= render Neo::Buttons::IconButtonComponent.new(
              variant: :danger,
              size: :small,
              icon: "trash"
            ) %>
          </div>
        </div>
      </div>
    </div>

    <div class="border-2 border-black rounded-lg bg-gray-100 p-6">
      <h4 class="font-bold mb-3">Code Example:</h4>
      <pre class="bg-white border border-black rounded p-4 overflow-x-auto text-sm"><code>&lt;div class="border-2 border-black rounded-lg bg-white shadow-[2px_2px_0_0_#000000] 
     hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 
     transition-all flex flex-col"&gt;
  &lt;div class="p-6 flex-1"&gt;
    &lt;h3 class="text-xl font-black uppercase tracking-tight mb-2"&gt;
      Card Title
    &lt;/h3&gt;
    &lt;p class="text-sm text-gray-600"&gt;
      Card content goes here.
    &lt;/p&gt;
  &lt;/div&gt;
  &lt;div class="px-6 py-4 border-t-2 border-black bg-gray-50 rounded-b-lg"&gt;
    &lt;!-- Footer content --&gt;
  &lt;/div&gt;
&lt;/div&gt;</code></pre>
    </div>
  </section>

  <!-- Interactive Cards -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Interactive Cards</h2>
    <p class="text-gray-600 mb-6">Cards mit verschiedenen Hover-Effekten und Interaktions-Zuständen.</p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
      <!-- Clickable Card -->
      <div class="border-2 border-black rounded-lg bg-white shadow-[2px_2px_0_0_#000000] hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:bg-yellow-100 transition-all group flex flex-col cursor-pointer">
        <div class="p-6 flex-1">
          <h3 class="text-xl font-black uppercase tracking-tight mb-2 group-hover:text-black">
            Clickable Card
          </h3>
          <p class="text-sm text-gray-600">
            Gesamte Card ist klickbar mit gelbem Hover-Effekt.
          </p>
        </div>
        <div class="px-6 py-4 border-t-2 border-black bg-gray-50 rounded-b-lg flex items-center justify-center">
          <span class="text-sm text-gray-700">Details anzeigen <i class="bi bi-arrow-right ml-1"></i></span>
        </div>
      </div>

      <!-- Card with Icon -->
      <div class="border-2 border-black rounded-lg bg-white shadow-[2px_2px_0_0_#000000] hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all">
        <div class="p-6">
          <div class="flex items-start justify-between mb-4">
            <div class="flex-1">
              <h3 class="text-xl font-black uppercase tracking-tight mb-2">Mit Icon</h3>
              <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                System
              </span>
            </div>
            <i class="bi bi-folder-fill text-2xl text-cobalt-500"></i>
          </div>
          <p class="text-sm text-gray-600">
            Card mit Icon und Label.
          </p>
        </div>
      </div>

      <!-- Card with Meta Info -->
      <div class="border-2 border-black rounded-lg bg-white shadow-[2px_2px_0_0_#000000] hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all">
        <div class="p-6">
          <h3 class="text-xl font-black uppercase tracking-tight mb-4">Mit Meta-Info</h3>
          <div class="flex items-center gap-4 text-sm text-gray-500 mb-4">
            <span>
              <i class="bi bi-collection"></i> 12 Items
            </span>
            <span>
              <i class="bi bi-people"></i> 5 Users
            </span>
          </div>
          <p class="text-sm text-gray-600">
            Card mit zusätzlichen Meta-Informationen.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Card States -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Card States</h2>
    <p class="text-gray-600 mb-6">Verschiedene Zustände und Status-Anzeigen für Cards.</p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
      <!-- Active Card -->
      <div class="border-2 border-black rounded-lg bg-white shadow-[2px_2px_0_0_#000000] hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all flex flex-col">
        <div class="p-6 flex-1">
          <h3 class="text-xl font-black uppercase tracking-tight mb-2">Active State</h3>
          <p class="text-sm text-gray-600">Card mit aktivem Status.</p>
        </div>
        <div class="px-6 py-4 border-t-2 border-black bg-gray-50 rounded-b-lg">
          <span class="inline-flex items-center gap-x-1.5 py-1.5 px-3 rounded-full text-xs font-medium border border-black bg-lime-200 text-black">
            Aktiv
          </span>
        </div>
      </div>

      <!-- Inactive Card -->
      <div class="border-2 border-black rounded-lg bg-white shadow-[2px_2px_0_0_#000000] hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all flex flex-col opacity-75">
        <div class="p-6 flex-1">
          <h3 class="text-xl font-black uppercase tracking-tight mb-2">Inactive State</h3>
          <p class="text-sm text-gray-600">Card mit inaktivem Status.</p>
        </div>
        <div class="px-6 py-4 border-t-2 border-black bg-gray-50 rounded-b-lg">
          <span class="inline-flex items-center gap-x-1.5 py-1.5 px-3 rounded-full text-xs font-medium border border-black bg-red-200 text-black">
            Inaktiv
          </span>
        </div>
      </div>

      <!-- Empty State Card -->
      <div class="border-2 border-black rounded-lg bg-white shadow-[2px_2px_0_0_#000000] p-12 text-center">
        <i class="bi bi-inbox text-4xl text-gray-400 mb-2 block"></i>
        <p class="text-sm text-gray-500">Keine Daten vorhanden</p>
      </div>
    </div>
  </section>

  <!-- Dashboard Cards -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Dashboard Cards</h2>
    <p class="text-gray-600 mb-6">Spezielle Card-Layouts für Dashboard-Ansichten mit einheitlichem Styling.</p>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
      <!-- Statistics Card -->
      <div>
        <h3 class="font-bold mb-4">Statistics Cards</h3>
        <div class="grid grid-cols-2 gap-4 mb-4">
          <div class="border-2 border-black rounded-lg p-4 bg-lime-50 shadow-[2px_2px_0_0_#000000]">
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-sm font-bold uppercase text-black opacity-70">Tasks</h3>
              <i class="bi bi-check2-square text-xl"></i>
            </div>
            <p class="text-3xl font-black mb-1">42</p>
            <p class="text-xs text-black opacity-50">12 abgeschlossen</p>
          </div>
          
          <div class="border-2 border-black rounded-lg p-4 bg-cyan-50 shadow-[2px_2px_0_0_#000000]">
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-sm font-bold uppercase text-black opacity-70">Zeit</h3>
              <i class="bi bi-clock-history text-xl"></i>
            </div>
            <p class="text-3xl font-black mb-1">128h</p>
            <p class="text-xs text-black opacity-50">Diese Woche</p>
          </div>
        </div>
      </div>

      <!-- Content Card with Header -->
      <div>
        <h3 class="font-bold mb-4">Content Cards mit Header</h3>
        <div class="border-2 border-black rounded-lg bg-lime-50 shadow-[2px_2px_0_0_#000000] p-4">
          <div class="flex justify-between items-center mb-4">
            <h2 class="text-xl font-black uppercase">Aktuelle Tasks</h2>
            <div class="flex items-center gap-2">
              <button class="py-2 px-4 text-sm font-bold uppercase border border-black bg-white hover:bg-gray-100 hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all">
                Alle anzeigen
              </button>
              <button class="py-2 px-4 text-sm font-bold uppercase border border-black bg-lime-200 hover:bg-lime-300 hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all">
                <i class="bi bi-plus-lg"></i> Neu
              </button>
            </div>
          </div>
          <div class="space-y-3">
            <div class="block p-3 border border-black rounded hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all">
              <h4 class="font-bold text-sm mb-1">Task Beispiel</h4>
              <div class="flex items-center gap-2 text-xs">
                <span class="px-2 py-1 rounded border border-black bg-yellow-200">In Bearbeitung</span>
                <span class="text-black opacity-50">#123</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="border-2 border-black rounded-lg bg-gray-100 p-6">
      <h4 class="font-bold mb-3">Dashboard Card Guidelines:</h4>
      <ul class="space-y-2 text-sm mb-4">
        <li class="flex items-start">
          <i class="bi bi-check-circle-fill text-green-500 mr-2 mt-0.5"></i>
          <span><strong>Einheitliche Struktur:</strong> Alle Cards verwenden border-2, rounded-lg und shadow-[2px_2px_0_0_#000000]</span>
        </li>
        <li class="flex items-start">
          <i class="bi bi-check-circle-fill text-green-500 mr-2 mt-0.5"></i>
          <span><strong>Durchgehender Hintergrund:</strong> Keine separaten Header-Bereiche, sondern einheitliche Hintergrundfarbe (bg-lime-50, bg-cobalt-50, etc.)</span>
        </li>
        <li class="flex items-start">
          <i class="bi bi-check-circle-fill text-green-500 mr-2 mt-0.5"></i>
          <span><strong>Konsistente Ecken:</strong> Alle Cards nutzen rounded-lg für einheitliche Abrundung</span>
        </li>
      </ul>
      <pre class="bg-white border border-black rounded p-4 overflow-x-auto text-sm"><code>&lt;!-- Dashboard Content Card --&gt;
&lt;div class="border-2 border-black rounded-lg bg-lime-50 shadow-[2px_2px_0_0_#000000] p-4"&gt;
  &lt;div class="flex justify-between items-center mb-4"&gt;
    &lt;h2 class="text-xl font-black uppercase"&gt;Titel&lt;/h2&gt;
    &lt;div class="flex items-center gap-2"&gt;
      &lt;!-- Action buttons --&gt;
    &lt;/div&gt;
  &lt;/div&gt;
  &lt;div&gt;
    &lt;!-- Content --&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;!-- Statistics Card --&gt;
&lt;div class="border-2 border-black rounded-lg p-4 bg-lime-50 shadow-[2px_2px_0_0_#000000]"&gt;
  &lt;div class="flex items-center justify-between mb-2"&gt;
    &lt;h3 class="text-sm font-bold uppercase text-black opacity-70"&gt;Label&lt;/h3&gt;
    &lt;i class="bi bi-icon text-xl"&gt;&lt;/i&gt;
  &lt;/div&gt;
  &lt;p class="text-3xl font-black mb-1"&gt;42&lt;/p&gt;
  &lt;p class="text-xs text-black opacity-50"&gt;Zusatzinfo&lt;/p&gt;
&lt;/div&gt;</code></pre>
    </div>
  </section>

  <!-- Complex Cards -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Complex Cards</h2>
    <p class="text-gray-600 mb-6">Cards mit erweiterten Inhalten und Strukturen.</p>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
      <!-- Card with List -->
      <div class="border-2 border-black rounded-lg bg-white shadow-[2px_2px_0_0_#000000] hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all">
        <div class="p-6">
          <h3 class="text-xl font-black uppercase tracking-tight mb-4">Mit Liste</h3>
          <div class="flex items-center gap-4 text-sm text-gray-500 mb-4">
            <span><i class="bi bi-collection"></i> 5 Attribute</span>
            <span><i class="bi bi-folder"></i> 3 Projekte</span>
          </div>
          <div class="border-t pt-4">
            <h4 class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">Attribute</h4>
            <div class="space-y-1">
              <div class="flex items-center gap-2 text-sm">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700">text</span>
                <span class="text-gray-900">Kundenname</span>
              </div>
              <div class="flex items-center gap-2 text-sm">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700">select</span>
                <span class="text-gray-900">Priorität</span>
              </div>
              <div class="flex items-center gap-2 text-sm">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700">date</span>
                <span class="text-gray-900">Fälligkeitsdatum</span>
              </div>
              <div class="text-xs text-gray-500 pt-1">... und 2 weitere</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Card Grid Example -->
      <div class="border-2 border-black rounded-lg bg-gray-100 p-6">
        <h4 class="font-bold mb-3">Usage in Grid:</h4>
        <pre class="bg-white border border-black rounded p-4 overflow-x-auto text-sm"><code>&lt;div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"&gt;
  &lt;% items.each do |item| %&gt;
    &lt;div class="border-2 border-black rounded-lg bg-white 
         shadow-[2px_2px_0_0_#000000] hover:shadow-[2px_2px_0_0_#000000] 
         hover:-translate-x-0.5 hover:-translate-y-0.5 hover:bg-yellow-100 
         transition-all group flex flex-col"&gt;
      &lt;!-- Card content --&gt;
    &lt;/div&gt;
  &lt;% end %&gt;
&lt;/div&gt;</code></pre>
      </div>
    </div>
  </section>

  <!-- Styling Guidelines -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Styling Guidelines</h2>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="border-2 border-black rounded-lg bg-white p-6">
        <h3 class="font-bold mb-4">Design Principles</h3>
        <ul class="space-y-2 text-sm">
          <li class="flex items-start">
            <i class="bi bi-check-circle-fill text-green-500 mr-2 mt-0.5"></i>
            <span><strong>Border:</strong> Immer 2px border-black</span>
          </li>
          <li class="flex items-start">
            <i class="bi bi-check-circle-fill text-green-500 mr-2 mt-0.5"></i>
            <span><strong>Shadow:</strong> Standard [2px_2px_0_0_#000000], Hover [4px_4px_0_0_#000000]</span>
          </li>
          <li class="flex items-start">
            <i class="bi bi-check-circle-fill text-green-500 mr-2 mt-0.5"></i>
            <span><strong>Hover:</strong> translate-x-0.5 translate-y-0.5 mit optional bg-yellow-100</span>
          </li>
          <li class="flex items-start">
            <i class="bi bi-check-circle-fill text-green-500 mr-2 mt-0.5"></i>
            <span><strong>Typography:</strong> Titel in uppercase mit font-black</span>
          </li>
          <li class="flex items-start">
            <i class="bi bi-check-circle-fill text-green-500 mr-2 mt-0.5"></i>
            <span><strong>Footer:</strong> border-t-2 border-black mit bg-gray-50</span>
          </li>
        </ul>
      </div>
      
      <div class="border-2 border-black rounded-lg bg-white p-6">
        <h3 class="font-bold mb-4">Common Patterns</h3>
        <ul class="space-y-2 text-sm">
          <li class="flex items-start">
            <i class="bi bi-arrow-right-circle text-cobalt-500 mr-2 mt-0.5"></i>
            <span><strong>Grid Layout:</strong> Verwende responsive grid-cols für verschiedene Breakpoints</span>
          </li>
          <li class="flex items-start">
            <i class="bi bi-arrow-right-circle text-cobalt-500 mr-2 mt-0.5"></i>
            <span><strong>Status Badges:</strong> Nutze rounded-full mit passenden Farben (lime-200 für aktiv, red-200 für inaktiv)</span>
          </li>
          <li class="flex items-start">
            <i class="bi bi-arrow-right-circle text-cobalt-500 mr-2 mt-0.5"></i>
            <span><strong>Actions:</strong> Platziere Buttons im Footer mit Neo::Buttons::ButtonComponent</span>
          </li>
          <li class="flex items-start">
            <i class="bi bi-arrow-right-circle text-cobalt-500 mr-2 mt-0.5"></i>
            <span><strong>Flex Layout:</strong> Nutze flex-col mit flex-1 für gleichmäßige Höhen</span>
          </li>
        </ul>
      </div>
    </div>
  </section>
</div>
<% # Style-Guide-Seite: Farbpalette (Warm-Editorial, var-gebacken).
   # Alle Farbklassen sind CSS-Variablen -> die Swatches flippen live mit dem Theme.
   # Quelle: doc/design_system.md Teil G + application.tailwind.css. Siehe auch /style_guide/themes. %>
<div class="container mx-auto px-8 py-8 max-w-7xl text-body">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-4xl font-black text-heading uppercase mb-2">Farbpalette</h1>
    <p class="text-muted">Warm-Editorial — eine Palette als CSS-Variablen. Jede Kachel flippt mit der gewählten <%= link_to "Ansicht", style_guide_themes_path, class: "text-info underline" %> (Hell/Dunkel/Pop).</p>
  </div>

  <!-- Note -->
  <div class="border-l-4 border-edge-strong bg-surface-shell rounded-r-lg p-5 mb-12 text-sm">
    <p>
      <i class="bi bi-info-circle text-info"></i>
      Es gibt <strong>keine festen Hex-Werte</strong> mehr in den Views. Tailwind-Klassen wie
      <code class="bg-surface px-1 rounded">bg-surface</code> oder <code class="bg-surface px-1 rounded">text-heading</code>
      lösen auf <code class="bg-surface px-1 rounded">rgb(var(--token))</code> auf. Die hier gezeigten RGB-Werte gelten für
      <strong>Hell</strong> — schalte oben um, um Dunkel/Pop zu sehen. Mechanik: <%= link_to "Themes", style_guide_themes_path, class: "text-info underline" %>.
    </p>
  </div>

  <!-- Warm neutral ramp -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-heading mb-2 pb-2 border-b border-edge-strong">Warme Rampe (cream)</h2>
    <p class="text-muted text-sm mb-6">Das Rückgrat: Flächen, Strich und Text leiten sich aus dieser einen Rampe ab — Hover/Selected = eine Wert-Stufe dunkler, nie ein neuer Farbton.</p>
    <div class="grid grid-cols-3 sm:grid-cols-5 lg:grid-cols-10 gap-2">
      <% {
        50 => "250 248 245", 100 => "245 241 234", 200 => "235 227 212", 300 => "220 215 205",
        400 => "188 182 169", 500 => "147 140 127", 600 => "109 104 92", 700 => "79 74 64",
        800 => "53 48 41", 900 => "33 30 24"
      }.each do |step, rgb| %>
        <div class="rounded-lg overflow-hidden border border-edge">
          <div class="h-16 bg-cream-<%= step %>"></div>
          <div class="p-2 bg-surface-raised">
            <p class="font-mono text-xs font-bold text-heading">cream-<%= step %></p>
            <p class="text-[10px] text-faint"><%= rgb %></p>
          </div>
        </div>
      <% end %>
    </div>
    <div class="mt-4 flex flex-wrap gap-4 text-sm">
      <div class="flex items-center gap-2">
        <span class="inline-block w-8 h-8 rounded border-2 border-edge-strong"></span>
        <span><code class="text-muted">ink</code> / <code class="text-muted">stroke</code> — Tinten-Strich (<span class="font-mono text-xs">--ink = 20 17 12</span>)</span>
      </div>
    </div>
  </section>

  <!-- Semantic surfaces -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-heading mb-2 pb-2 border-b border-edge-strong">Semantische Flächen</h2>
    <p class="text-muted text-sm mb-6">Views referenzieren diese Aliase statt der Rampe direkt — Bedeutung statt Wert.</p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <% [
        ["surface",        "--cream-50",  "Inhalts-/Tabellenfläche"],
        ["surface-shell",  "--cream-100", "Shell / Sidebar"],
        ["surface-raised", "--white",     "Modal / Input"],
        ["selected",       "--cream-200", "aktiv / ausgewählt"]
      ].each do |name, var, desc| %>
        <div class="rounded-lg overflow-hidden border border-edge">
          <div class="h-16 bg-<%= name %> border-b border-edge"></div>
          <div class="p-3 bg-surface-raised">
            <p class="font-bold text-sm text-heading"><%= name %></p>
            <p class="text-[11px] text-faint"><%= var %> · <%= desc %></p>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <!-- Accent & action -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-heading mb-2 pb-2 border-b border-edge-strong">Akzent & Aktion</h2>
    <p class="text-muted text-sm mb-6">Hue ist rationiert: Lime = Primäraktion, Cobalt = Daten/Links/Fokus. <code class="bg-surface-shell px-1 rounded">accent</code> ist per-Org überschreibbar.</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="rounded-lg overflow-hidden border border-edge">
        <div class="h-20 bg-btn-primary"></div>
        <div class="p-4 bg-surface-raised">
          <p class="font-bold text-sm text-heading">btn-primary</p>
          <p class="text-xs text-muted">Primär-Button-Füllung (Lime). Text darauf immer dunkel.</p>
        </div>
      </div>
      <div class="rounded-lg overflow-hidden border border-edge">
        <div class="h-20 bg-accent"></div>
        <div class="p-4 bg-surface-raised">
          <p class="font-bold text-sm text-heading">accent</p>
          <p class="text-xs text-muted">Primäraktion / Hervorhebung. Per-Org inline überschreibbar.</p>
        </div>
      </div>
      <div class="rounded-lg overflow-hidden border border-edge">
        <div class="h-20 bg-info"></div>
        <div class="p-4 bg-surface-raised">
          <p class="font-bold text-sm text-heading">info</p>
          <p class="text-xs text-muted">Daten / Links / Fokus (Cobalt).</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Status tones -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-heading mb-2 pb-2 border-b border-edge-strong">Status-Töne</h2>
    <p class="text-muted text-sm mb-6">Nur Bedeutung, kein Schmuck. Im Dunkel werden die hellen Tints automatisch zu gedämpften dunklen Washes.</p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
      <div class="rounded-lg p-5 bg-red-50 text-red-800 border border-edge">
        <p class="font-bold mb-1">Danger</p><p class="text-xs">Fehler, irreversible Aktion</p>
      </div>
      <div class="rounded-lg p-5 bg-amber-50 text-amber-800 border border-edge">
        <p class="font-bold mb-1">Warning</p><p class="text-xs">Hinweis, Achtung</p>
      </div>
      <div class="rounded-lg p-5 bg-green-50 text-green-800 border border-edge">
        <p class="font-bold mb-1">Success</p><p class="text-xs">Erfolg, erledigt</p>
      </div>
      <div class="rounded-lg p-5 bg-cobalt-50 text-cobalt-900 border border-edge">
        <p class="font-bold mb-1">Info</p><p class="text-xs">System, neutral</p>
      </div>
    </div>
  </section>

  <!-- Text -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-heading mb-2 pb-2 border-b border-edge-strong">Textfarben</h2>
    <div class="bg-surface-raised border border-edge rounded-lg p-6 space-y-1">
      <p class="text-heading font-bold text-lg">heading — Überschriften (--cream-900)</p>
      <p class="text-body">body — Fließtext (--cream-800)</p>
      <p class="text-muted">muted — gedämpft / Caption (--cream-600)</p>
      <p class="text-faint">faint — sehr leise / Placeholder (--cream-500)</p>
      <p class="text-info">info — Links / Fokus (--info)</p>
    </div>
  </section>
</div>

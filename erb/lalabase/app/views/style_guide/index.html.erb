<div class="container mx-auto px-8 py-8 max-w-7xl">
  
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-4xl font-black text-black uppercase mb-2">Neo Brutalist Style Guide</h1>
    <p class="text-gray-600">Komponenten-Bibliothek für die Lalabase Anwendung</p>
  </div>

  <!-- Welcome Section -->
  <div class="border-2 border-black rounded-lg bg-yellow-50 p-8 mb-8 shadow-[2px_2px_0_0_#000000]">
    <h2 class="text-2xl font-bold mb-4">Willkommen im Style Guide</h2>
    <p class="text-lg mb-4">
      Dieser Style Guide dokumentiert alle UI-Komponenten und Design-Patterns der Lalabase Anwendung im Neo Brutalist Design.
    </p>
    <p class="text-gray-700">
      Nutzen Sie die Navigation links, um die verschiedenen Komponenten zu erkunden. Jede Seite enthält Beispiele, Code-Snippets und Best Practices.
    </p>
  </div>
  
  <!-- Design Principles -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Design Prinzipien</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="border-2 border-black rounded-lg bg-white p-6 hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all">
        <i class="bi bi-border-all text-3xl mb-3 block"></i>
        <h3 class="font-bold mb-2">Schwarze Borders</h3>
        <p class="text-sm text-gray-600">2px für Hauptelemente, 1px für kleinere Komponenten</p>
      </div>
      
      <div class="border-2 border-black rounded-lg bg-white p-6 hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all">
        <i class="bi bi-layers-fill text-3xl mb-3 block"></i>
        <h3 class="font-bold mb-2">Box Shadows</h3>
        <p class="text-sm text-gray-600">Harte Schatten ohne blur für 3D-Effekt</p>
      </div>
      
      <div class="border-2 border-black rounded-lg bg-white p-6 hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all">
        <i class="bi bi-hand-index text-3xl mb-3 block"></i>
        <h3 class="font-bold mb-2">Hover Effects</h3>
        <p class="text-sm text-gray-600">Transform mit translate für interaktive Elemente</p>
      </div>
      
      <div class="border-2 border-black rounded-lg bg-white p-6 hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all">
        <i class="bi bi-palette-fill text-3xl mb-3 block"></i>
        <h3 class="font-bold mb-2">Kräftige Farben</h3>
        <p class="text-sm text-gray-600">Flache, lebendige Farben ohne Verläufe</p>
      </div>
    </div>
  </section>

  <!-- Quick Links -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Häufig genutzte Komponenten</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <%= link_to style_guide_buttons_path, class: "border-2 border-black rounded-lg bg-white p-6 hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:bg-lime-100 transition-all block" do %>
        <h3 class="font-bold mb-2">Buttons</h3>
        <p class="text-sm text-gray-600 mb-4">Primary, Secondary, Danger und weitere Button-Varianten</p>
        <span class="text-sm font-medium text-lime-600">Erkunden →</span>
      <% end %>
      
      <%= link_to style_guide_cards_path, class: "border-2 border-black rounded-lg bg-white p-6 hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:bg-yellow-100 transition-all block" do %>
        <h3 class="font-bold mb-2">Cards <span class="text-xs text-green-600">New!</span></h3>
        <p class="text-sm text-gray-600 mb-4">Card-Komponenten für strukturierte Inhalte</p>
        <span class="text-sm font-medium text-yellow-600">Erkunden →</span>
      <% end %>
      
      <%= link_to style_guide_headers_path, class: "border-2 border-black rounded-lg bg-white p-6 hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:bg-cyan-100 transition-all block" do %>
        <h3 class="font-bold mb-2">Headers</h3>
        <p class="text-sm text-gray-600 mb-4">TitleBox und Navigation Komponenten</p>
        <span class="text-sm font-medium text-cyan-600">Erkunden →</span>
      <% end %>
      
      <%= link_to style_guide_tags_path, class: "border-2 border-black rounded-lg bg-white p-6 hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:bg-purple-100 transition-all block" do %>
        <h3 class="font-bold mb-2">Tags <span class="text-xs text-green-600">New!</span></h3>
        <p class="text-sm text-gray-600 mb-4">Tag-Komponenten für Labels und Kategorien</p>
        <span class="text-sm font-medium text-purple-600">Erkunden →</span>
      <% end %>
      
      <%= link_to style_guide_activities_path, class: "border-2 border-black rounded-lg bg-white p-6 hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:bg-orange-100 transition-all block" do %>
        <h3 class="font-bold mb-2">Activities <span class="text-xs text-green-600">New!</span></h3>
        <p class="text-sm text-gray-600 mb-4">Activity-Feed und Timeline-Komponenten</p>
        <span class="text-sm font-medium text-orange-600">Erkunden →</span>
      <% end %>

      <%= link_to style_guide_name_display_path, class: "border-2 border-black rounded-lg bg-white p-6 hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:bg-sky-100 transition-all block" do %>
        <h3 class="font-bold mb-2">Namensanzeige <span class="text-xs text-green-600">New!</span></h3>
        <p class="text-sm text-gray-600 mb-4">Avatar-Chip und Schreibweise eines Nutzernamens</p>
        <span class="text-sm font-medium text-sky-600">Erkunden →</span>
      <% end %>
    </div>
  </section>
  
  <!-- Project Name Label: Parallelogramm-Badge -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Projekt-Label</h2>
    <p class="text-gray-600 mb-6">Einheitliche Darstellung von Projektnamen mit <code class="bg-gray-100 px-1 rounded">project_name_label</code> Helper. Zwei Varianten für unterschiedliche Kontexte.</p>

    <div class="space-y-6">
      <%# Bold (default) %>
      <div class="border-2 border-black rounded-lg bg-white p-6">
        <h3 class="font-bold mb-1 text-sm uppercase tracking-wide">:bold (default)</h3>
        <p class="text-xs text-gray-400 mb-4">Für Headings, Projektkarten, prominente Stellen</p>
        <div class="space-y-4">
          <div>
            <span>Projektkarte: </span>
            <%= project_name_label("Fakolith") %>
          </div>
          <div class="flex gap-3 flex-wrap">
            <%= project_name_label("Marketing") %>
            <%= project_name_label("Backend API") %>
            <%= project_name_label("Lalabase") %>
          </div>
        </div>
      </div>

      <%# Light %>
      <div class="border-2 border-black rounded-lg bg-white p-6">
        <h3 class="font-bold mb-1 text-sm uppercase tracking-wide">:light</h3>
        <p class="text-xs text-gray-400 mb-4">Für Listen, Inline-Metadaten, untergeordnete Info</p>
        <div class="space-y-4">
          <div class="text-sm">
            <span class="font-medium">#283 Neue Funktion | Import</span>
            <span class="text-xs text-black/50 ml-1"><%= project_name_label("Calc", variant: :light) %> &middot; Status: neu</span>
          </div>
          <div class="text-sm">
            <span class="font-medium">#162 E-Mail Erinnerung</span>
            <span class="text-xs text-black/50 ml-1"><%= project_name_label("Akquiseportal", variant: :light) %> &middot; Status: offen</span>
          </div>
          <div class="flex gap-3 flex-wrap">
            <%= project_name_label("Marketing", variant: :light) %>
            <%= project_name_label("Backend API", variant: :light) %>
            <%= project_name_label("Lalabase", variant: :light) %>
          </div>
        </div>
      </div>

      <%# Usage %>
      <div class="border-2 border-black rounded-lg bg-white p-6">
        <h3 class="font-bold mb-4 text-sm uppercase tracking-wide">Verwendung</h3>
        <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;%= project_name_label(@project) %&gt;
&lt;%= project_name_label(@project, variant: :light) %&gt;</code></pre>
      </div>
    </div>
  </section>

  <!-- Code Examples -->
  <section>
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Quick Start</h2>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div class="border-2 border-black rounded-lg bg-white p-6">
        <h3 class="font-bold mb-4">Button Component</h3>
        <p class="text-sm text-gray-600 mb-4">Der am häufigsten verwendete Component:</p>
        <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;%= render Neo::Buttons::ButtonComponent.new(
  variant: :primary,
  icon: "plus-lg"
) do %&gt;
  Neuer Eintrag
&lt;% end %&gt;</code></pre>
      </div>
      
      <div class="border-2 border-black rounded-lg bg-white p-6">
        <h3 class="font-bold mb-4">Header Component</h3>
        <p class="text-sm text-gray-600 mb-4">Für konsistente Seitentitel:</p>
        <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;%= render NeoTitleBoxComponent.new(
  title: "Projekt",
  subtitle: "My Project",
  variant: :project
) do |c| %&gt;
  &lt;% c.with_right_content do %&gt;
    &lt;!-- Actions --&gt;
  &lt;% end %&gt;
&lt;% end %&gt;</code></pre>
      </div>
    </div>
  </section>
</div>
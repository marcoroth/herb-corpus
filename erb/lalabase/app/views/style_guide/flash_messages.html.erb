<div class="container mx-auto px-8 py-8 max-w-7xl">
  
  <h1 class="text-4xl font-black text-black uppercase mb-8">Flash Messages</h1>
  
  <!-- Introduction -->
  <div class="border-2 border-black rounded-lg bg-white p-6 mb-8">
    <h2 class="text-2xl font-bold mb-4">NeoFlashComponent</h2>
    <p class="text-gray-700 mb-4">
      Flash-Messages sind temporäre Benachrichtigungen, die dem Benutzer Feedback über Aktionen geben. 
      Die NeoFlashComponent bietet verschiedene Typen, Positionen und Verhaltensweisen.
    </p>
  </div>

  <!-- Types Section -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Message Types</h2>
    
    <div class="space-y-6">
      <!-- Success -->
      <div class="border-2 border-black rounded-lg bg-gray-50 p-6">
        <h3 class="font-bold mb-4">Success / Notice</h3>
        <div class="mb-4 relative h-20">
          <div class="relative w-auto max-w-md shadow-[2px_2px_0_0_#000000] rounded border-2 border-black bg-lime-200 text-black">
            <div class="flex flex-row items-center gap-4 py-3 px-4">
              <i class="bi bi-check-circle-fill text-green-700"></i>
              <p class="flex flex-grow text-sm tracking-[0.25px] font-medium">Erfolgreich gespeichert! Ihre Änderungen wurden übernommen.</p>
              <button class="flex items-center hover:bg-black/10 rounded p-1 transition-colors">
                <span class="bi bi-x-lg"></span>
              </button>
            </div>
          </div>
        </div>
        <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm mt-4"><code>&lt;%= render NeoFlashComponent.new(
  type: :success,
  message: "Erfolgreich gespeichert!",
  auto_hide: false
) %&gt;</code></pre>
      </div>

      <!-- Error -->
      <div class="border-2 border-black rounded-lg bg-gray-50 p-6">
        <h3 class="font-bold mb-4">Error / Alert</h3>
        <div class="mb-4 relative h-20">
          <div class="relative w-auto max-w-md shadow-[2px_2px_0_0_#000000] rounded border-2 border-black bg-red-100 text-black">
            <div class="flex flex-row items-center gap-4 py-3 px-4">
              <i class="bi bi-exclamation-triangle-fill text-red-700"></i>
              <p class="flex flex-grow text-sm tracking-[0.25px] font-medium">Fehler beim Speichern! Bitte überprüfen Sie Ihre Eingaben.</p>
              <button class="flex items-center hover:bg-black/10 rounded p-1 transition-colors">
                <span class="bi bi-x-lg"></span>
              </button>
            </div>
          </div>
        </div>
        <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm mt-4"><code>&lt;%= render NeoFlashComponent.new(
  type: :error,
  message: "Fehler beim Speichern!",
  auto_hide: false
) %&gt;</code></pre>
      </div>

      <!-- Warning -->
      <div class="border-2 border-black rounded-lg bg-gray-50 p-6">
        <h3 class="font-bold mb-4">Warning</h3>
        <div class="mb-4 relative h-20">
          <div class="relative w-auto max-w-md shadow-[2px_2px_0_0_#000000] rounded border-2 border-black bg-yellow-100 text-black">
            <div class="flex flex-row items-center gap-4 py-3 px-4">
              <i class="bi bi-exclamation-triangle-fill text-yellow-700"></i>
              <p class="flex flex-grow text-sm tracking-[0.25px] font-medium">Achtung! Diese Aktion kann nicht rückgängig gemacht werden.</p>
              <button class="flex items-center hover:bg-black/10 rounded p-1 transition-colors">
                <span class="bi bi-x-lg"></span>
              </button>
            </div>
          </div>
        </div>
        <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm mt-4"><code>&lt;%= render NeoFlashComponent.new(
  type: :warning,
  message: "Achtung! Diese Aktion kann nicht rückgängig gemacht werden.",
  auto_hide: false
) %&gt;</code></pre>
      </div>

      <!-- Info -->
      <div class="border-2 border-black rounded-lg bg-gray-50 p-6">
        <h3 class="font-bold mb-4">Info</h3>
        <div class="mb-4 relative h-20">
          <div class="relative w-auto max-w-md shadow-[2px_2px_0_0_#000000] rounded border-2 border-black bg-cobalt-100 text-black">
            <div class="flex flex-row items-center gap-4 py-3 px-4">
              <i class="bi bi-info-circle-fill text-cobalt-700"></i>
              <p class="flex flex-grow text-sm tracking-[0.25px] font-medium">Hinweis: Die Wartungsarbeiten beginnen um 14:00 Uhr.</p>
              <button class="flex items-center hover:bg-black/10 rounded p-1 transition-colors">
                <span class="bi bi-x-lg"></span>
              </button>
            </div>
          </div>
        </div>
        <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm mt-4"><code>&lt;%= render NeoFlashComponent.new(
  type: :info,
  message: "Hinweis: Die Wartungsarbeiten beginnen um 14:00 Uhr.",
  auto_hide: false
) %&gt;</code></pre>
      </div>
    </div>
  </section>

  <!-- Options Section -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Options</h2>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Auto Hide -->
      <div class="border-2 border-black rounded-lg bg-gray-50 p-6">
        <h3 class="font-bold mb-4">Auto Hide (3 Sekunden)</h3>
        <button class="mb-4 px-4 py-2 bg-lime-200 border-2 border-black rounded hover:bg-lime-300" 
                onclick="showAutoHideDemo()">
          Demo anzeigen
        </button>
        <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm mt-4"><code>&lt;%= render NeoFlashComponent.new(
  type: :success,
  message: "Auto-Hide nach 3 Sekunden",
  auto_hide: true,
  hide_delay: 3000
) %&gt;</code></pre>
      </div>

      <!-- No Dismiss Button -->
      <div class="border-2 border-black rounded-lg bg-gray-50 p-6">
        <h3 class="font-bold mb-4">Ohne Dismiss Button</h3>
        <div class="mb-4 relative h-20">
          <div class="relative w-auto max-w-md shadow-[2px_2px_0_0_#000000] rounded border-2 border-black bg-cobalt-100 text-black">
            <div class="flex flex-row items-center gap-4 py-3 px-4">
              <i class="bi bi-info-circle-fill text-cobalt-700"></i>
              <p class="flex flex-grow text-sm tracking-[0.25px] font-medium">Diese Nachricht hat keinen Schließen-Button</p>
            </div>
          </div>
        </div>
        <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm mt-4"><code>&lt;%= render NeoFlashComponent.new(
  type: :info,
  message: "Ohne Schließen-Button",
  dismissible: false,
  auto_hide: false
) %&gt;</code></pre>
      </div>
    </div>
  </section>

  <!-- Position Section -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Positions</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="border-2 border-black rounded-lg bg-gray-50 p-6">
        <h3 class="font-bold mb-2">Top Center (Default)</h3>
        <p class="text-sm text-gray-600 mb-4">position: :top_center</p>
      </div>

      <div class="border-2 border-black rounded-lg bg-gray-50 p-6">
        <h3 class="font-bold mb-2">Top Right</h3>
        <p class="text-sm text-gray-600 mb-4">position: :top_right</p>
      </div>

      <div class="border-2 border-black rounded-lg bg-gray-50 p-6">
        <h3 class="font-bold mb-2">Top Left</h3>
        <p class="text-sm text-gray-600 mb-4">position: :top_left</p>
      </div>
      
      <div class="border-2 border-black rounded-lg bg-gray-50 p-6">
        <h3 class="font-bold mb-2">Bottom Right</h3>
        <p class="text-sm text-gray-600 mb-4">position: :bottom_right</p>
      </div>
      
      <div class="border-2 border-black rounded-lg bg-gray-50 p-6">
        <h3 class="font-bold mb-2">Bottom Left</h3>
        <p class="text-sm text-gray-600 mb-4">position: :bottom_left</p>
      </div>
    </div>
    
    <div class="mt-6 text-center">
      <button class="px-4 py-2 bg-cobalt-200 border-2 border-black rounded hover:bg-cobalt-300 mr-2"
              onclick="showPositionDemo('top_center')">Top Center</button>
      <button class="px-4 py-2 bg-cobalt-200 border-2 border-black rounded hover:bg-cobalt-300 mr-2"
              onclick="showPositionDemo('top_left')">Top Left</button>
      <button class="px-4 py-2 bg-cobalt-200 border-2 border-black rounded hover:bg-cobalt-300 mr-2" 
              onclick="showPositionDemo('top_right')">Top Right</button>
      <button class="px-4 py-2 bg-cobalt-200 border-2 border-black rounded hover:bg-cobalt-300 mr-2" 
              onclick="showPositionDemo('bottom_left')">Bottom Left</button>
      <button class="px-4 py-2 bg-cobalt-200 border-2 border-black rounded hover:bg-cobalt-300" 
              onclick="showPositionDemo('bottom_right')">Bottom Right</button>
    </div>
  </section>

  <!-- Usage in Controllers -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Controller Usage</h2>
    
    <div class="border-2 border-black rounded-lg bg-gray-50 p-6">
      <p class="mb-4">So verwenden Sie Flash-Messages in Ihren Controllern:</p>
      <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>class TicketsController &lt; ApplicationController
  def update
    if @ticket.update(ticket_params)
      flash[:success] = "Ticket erfolgreich aktualisiert!"
      redirect_to @ticket
    else
      flash.now[:error] = "Fehler beim Speichern"
      render :edit
    end
  end
  
  def destroy
    @ticket.destroy
    flash[:warning] = "Ticket wurde gelöscht"
    redirect_to tickets_path
  end
end</code></pre>
    </div>
  </section>

  <!-- Container Component -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Flash Container</h2>
    
    <div class="border-2 border-black rounded-lg bg-gray-50 p-6">
      <p class="mb-4">Für die automatische Anzeige aller Flash-Messages in Layouts:</p>
      <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;!-- In layouts/application.html.erb --&gt;
&lt;%= render NeoFlashContainerComponent.new(flash: flash) %&gt;

&lt;!-- Mit Custom Options --&gt;
&lt;%= render NeoFlashContainerComponent.new(
  flash: flash,
  position: :bottom_right,
  hide_delay: 5000
) %&gt;</code></pre>
    </div>
  </section>

  <!-- JavaScript API -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">JavaScript API</h2>
    
    <div class="border-2 border-black rounded-lg bg-gray-50 p-6">
      <p class="mb-4">Der neo-flash Stimulus Controller bietet folgende Methoden:</p>
      <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>// Element mit Flash-Controller finden
const flashElement = document.querySelector('[data-controller="neo-flash"]')
const flashController = this.application.getControllerForElementAndIdentifier(
  flashElement, 
  'neo-flash'
)

// Manuell anzeigen
flashController.show()

// Manuell ausblenden
flashController.hide()

// Dismiss (mit Cleanup)
flashController.dismiss()</code></pre>
    </div>
  </section>

  <!-- Advanced Usage -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Erweiterte Verwendung</h2>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="border-2 border-black rounded-lg bg-gray-50 p-6">
        <h3 class="font-bold mb-4">Mit Turbo Streams</h3>
        <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm mt-4"><code># update.turbo_stream.erb
&lt;%= turbo_stream.prepend "flash" do %&gt;
  &lt;%= render NeoFlashComponent.new(
    type: :success,
    message: "Gespeichert!"
  ) %&gt;
&lt;% end %&gt;</code></pre>
      </div>
      
      <div class="border-2 border-black rounded-lg bg-gray-50 p-6">
        <h3 class="font-bold mb-4">Mit Stimulus</h3>
        <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm mt-4"><code>// In einem Stimulus Controller
import { Controller } from "@hotwired/stimulus"

export default class extends Controller {
  showSuccess() {
    const flash = document.createElement('div')
    flash.innerHTML = `
      &lt;%= render NeoFlashComponent.new(
        type: :success,
        message: "Aktion erfolgreich!"
      ) %&gt;
    `
    document.body.appendChild(flash)
  }
}</code></pre>
      </div>
    </div>
  </section>
</div>

<!-- Demo Container for dynamic flash messages -->
<div id="flash-demo-container"></div>

<script>
function showAutoHideDemo() {
  const container = document.getElementById('flash-demo-container');
  const id = 'demo_' + Date.now();
  const html = `
    <div id="${id}" 
         class="fixed z-toast top-4 right-4 w-auto max-w-md shadow-[2px_2px_0_0_#000000] rounded border-2 border-black transition-opacity duration-300 ease-out motion-reduce:transition-none overflow-hidden bg-lime-200 text-black"
         style="opacity: 0;"
         data-controller="neo-flash"
         data-neo-flash-auto-show-value="true"
         data-neo-flash-auto-hide-value="true"
         data-neo-flash-hide-delay-value="3000">
      <div class="flex flex-row items-center gap-4 py-3 px-4">
        <i class="bi bi-check-circle-fill text-green-700"></i>
        <p class="flex flex-grow text-sm tracking-[0.25px] font-medium">Diese Nachricht verschwindet automatisch nach 3 Sekunden!</p>
        <button data-action="click->neo-flash#dismiss" 
                class="flex items-center hover:bg-black/10 rounded p-1 transition-colors">
          <span class="bi bi-x-lg"></span>
        </button>
      </div>
    </div>
  `;
  
  container.insertAdjacentHTML('beforeend', html);
}

function showPositionDemo(position) {
  const container = document.getElementById('flash-demo-container');
  const id = 'demo_' + Date.now();
  const positions = {
    top_left: { message: "Oben Links", class: "top-4 left-4" },
    top_right: { message: "Oben Rechts", class: "top-4 right-4" },
    bottom_left: { message: "Unten Links", class: "bottom-4 left-4" },
    bottom_right: { message: "Unten Rechts", class: "bottom-4 right-4" }
  };
  
  const pos = positions[position];
  const html = `
    <div id="${id}" 
         class="fixed z-toast ${pos.class} w-auto max-w-md shadow-[2px_2px_0_0_#000000] rounded border-2 border-black transition-opacity duration-300 ease-out motion-reduce:transition-none overflow-hidden bg-cobalt-100 text-black"
         style="opacity: 0;"
         data-controller="neo-flash"
         data-neo-flash-auto-show-value="true"
         data-neo-flash-auto-hide-value="true"
         data-neo-flash-hide-delay-value="2000">
      <div class="flex flex-row items-center gap-4 py-3 px-4">
        <i class="bi bi-info-circle-fill text-cobalt-700"></i>
        <p class="flex flex-grow text-sm tracking-[0.25px] font-medium">Position: ${pos.message}</p>
        <button data-action="click->neo-flash#dismiss" 
                class="flex items-center hover:bg-black/10 rounded p-1 transition-colors">
          <span class="bi bi-x-lg"></span>
        </button>
      </div>
    </div>
  `;
  
  container.insertAdjacentHTML('beforeend', html);
}
</script>
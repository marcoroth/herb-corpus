            <th class="px-4 py-3 text-center font-bold">Wert</th>
            <th class="px-4 py-3 text-left font-bold">Verwendung</th>
            <th class="px-4 py-3 text-left font-bold">Beispiele</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-gray-200 bg-white">
            <td class="px-4 py-3 font-mono font-bold">base</td>
            <td class="px-4 py-3"><code class="bg-gray-100 px-2 py-0.5 rounded text-xs">z-base</code></td>
            <td class="px-4 py-3 text-center font-mono">0</td>
            <td class="px-4 py-3">Hintergrund-Elemente</td>
            <td class="px-4 py-3 text-gray-600">Timeline-Linien, dekorative Elemente</td>
          </tr>
          <tr class="border-b border-gray-200 bg-gray-50">
            <td class="px-4 py-3 font-mono font-bold">sticky</td>
            <td class="px-4 py-3"><code class="bg-gray-100 px-2 py-0.5 rounded text-xs">z-sticky</code></td>
            <td class="px-4 py-3 text-center font-mono">10</td>
            <td class="px-4 py-3">Sticky Headers, Form-Overlays</td>
            <td class="px-4 py-3 text-gray-600">Tabellen-Header, Permission-Checkboxen, Timeline-Icons</td>
          </tr>
          <tr class="border-b border-gray-200 bg-white">
            <td class="px-4 py-3 font-mono font-bold">backdrop</td>
            <td class="px-4 py-3"><code class="bg-gray-100 px-2 py-0.5 rounded text-xs">z-backdrop</code></td>
            <td class="px-4 py-3 text-center font-mono">20</td>
            <td class="px-4 py-3">Hintergrund-Overlays</td>
            <td class="px-4 py-3 text-gray-600">Sidebar-Backdrop</td>
          </tr>
          <tr class="border-b border-gray-200 bg-gray-50">
            <td class="px-4 py-3 font-mono font-bold">dropdown</td>
            <td class="px-4 py-3"><code class="bg-gray-100 px-2 py-0.5 rounded text-xs">z-dropdown</code></td>
            <td class="px-4 py-3 text-center font-mono">30</td>
            <td class="px-4 py-3">Dropdown-Menus</td>
            <td class="px-4 py-3 text-gray-600">User-Menu, Settings, Notifications, Projekt-Selector, Tag-Input</td>
          </tr>
          <tr class="border-b border-gray-200 bg-white">
            <td class="px-4 py-3 font-mono font-bold">sidebar</td>
            <td class="px-4 py-3"><code class="bg-gray-100 px-2 py-0.5 rounded text-xs">z-sidebar</code></td>
            <td class="px-4 py-3 text-center font-mono">40</td>
            <td class="px-4 py-3">Navigation Panels</td>
            <td class="px-4 py-3 text-gray-600">Sidebar, Notification-Backdrop, Scroll-to-Top</td>
          </tr>
          <tr class="border-b border-gray-200 bg-gray-50">
            <td class="px-4 py-3 font-mono font-bold">modal</td>
            <td class="px-4 py-3"><code class="bg-gray-100 px-2 py-0.5 rounded text-xs">z-modal</code></td>
            <td class="px-4 py-3 text-center font-mono">50</td>
            <td class="px-4 py-3">Modale Dialoge + Backdrops</td>
            <td class="px-4 py-3 text-gray-600">Alle Modals, Help-Dialoge, Lightbox, Deletion-Warning</td>
          </tr>
          <tr class="border-b border-gray-200 bg-white">
            <td class="px-4 py-3 font-mono font-bold">toast</td>
            <td class="px-4 py-3"><code class="bg-gray-100 px-2 py-0.5 rounded text-xs">z-toast</code></td>
            <td class="px-4 py-3 text-center font-mono">60</td>
            <td class="px-4 py-3">Toast- / Flash-Nachrichten</td>
            <td class="px-4 py-3 text-gray-600">NeoFlashComponent, Inline-Erfolgsmeldungen</td>
          </tr>
          <tr class="border-b border-gray-200 bg-gray-50">
            <td class="px-4 py-3 font-mono font-bold">popover</td>
            <td class="px-4 py-3"><code class="bg-gray-100 px-2 py-0.5 rounded text-xs">z-popover</code></td>
            <td class="px-4 py-3 text-center font-mono">70</td>
            <td class="px-4 py-3">Popovers &amp; Tooltips</td>
            <td class="px-4 py-3 text-gray-600">popover_controller.js, Hover-Arrows, Drag-Ghosts</td>
          </tr>
          <tr class="bg-white">
            <td class="px-4 py-3 font-mono font-bold">mobile-nav</td>
            <td class="px-4 py-3"><code class="bg-gray-100 px-2 py-0.5 rounded text-xs">z-mobile-nav</code></td>
            <td class="px-4 py-3 text-center font-mono">80</td>
            <td class="px-4 py-3">Mobile Navigation</td>
            <td class="px-4 py-3 text-gray-600">NeoMobileNavComponent</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Visual demo -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Visuelle Hierarchie</h2>
    <p class="text-gray-600 mb-6">Die Layers von hinten nach vorne. Hoehere Werte ueberlagern niedrigere.</p>

    <div class="border-2 border-black rounded-lg p-8 bg-gray-100 shadow-[2px_2px_0_0_#000000]">
      <div class="relative" style="height: 360px;">
        <!-- base (0) -->
        <div class="absolute left-0 bottom-0 w-full border-2 border-black rounded-lg bg-gray-200 p-4 shadow-[1px_1px_0_0_#000000]"
             style="height: 340px;">
          <span class="font-mono text-xs font-bold bg-white px-2 py-1 rounded border border-black">z-base (0)</span>
          <span class="text-xs text-gray-500 ml-2">Hintergrund</span>
        </div>

        <!-- sticky (10) -->
        <div class="absolute left-4 bottom-4 border-2 border-black rounded-lg bg-cobalt-100 p-4 shadow-[1px_1px_0_0_#000000]"
             style="width: calc(100% - 2rem); height: 290px;">
          <span class="font-mono text-xs font-bold bg-white px-2 py-1 rounded border border-black">z-sticky (10)</span>
          <span class="text-xs text-gray-500 ml-2">Sticky Elements</span>
        </div>

        <!-- backdrop (20) -->
        <div class="absolute left-8 bottom-8 border-2 border-black rounded-lg bg-gray-300 bg-opacity-80 p-4 shadow-[1px_1px_0_0_#000000]"
             style="width: calc(100% - 4rem); height: 240px;">
          <span class="font-mono text-xs font-bold bg-white px-2 py-1 rounded border border-black">z-backdrop (20)</span>
          <span class="text-xs text-gray-500 ml-2">Backdrops</span>
        </div>

        <!-- dropdown (30) -->
        <div class="absolute left-12 bottom-12 border-2 border-black rounded-lg bg-lime-100 p-4 shadow-[1px_1px_0_0_#000000]"
             style="width: calc(100% - 6rem); height: 190px;">
          <span class="font-mono text-xs font-bold bg-white px-2 py-1 rounded border border-black">z-dropdown (30)</span>
          <span class="text-xs text-gray-500 ml-2">Dropdowns</span>
        </div>

        <!-- sidebar (40) -->
        <div class="absolute left-16 bottom-16 border-2 border-black rounded-lg bg-yellow-100 p-4 shadow-[1px_1px_0_0_#000000]"
             style="width: calc(100% - 8rem); height: 140px;">
          <span class="font-mono text-xs font-bold bg-white px-2 py-1 rounded border border-black">z-sidebar (40)</span>
          <span class="text-xs text-gray-500 ml-2">Sidebars</span>
        </div>

        <!-- modal (50) -->
        <div class="absolute left-20 bottom-20 border-2 border-black rounded-lg bg-orange-100 p-4 shadow-[2px_2px_0_0_#000000]"
             style="width: calc(100% - 10rem); height: 90px;">
          <span class="font-mono text-xs font-bold bg-white px-2 py-1 rounded border border-black">z-modal (50)</span>
          <span class="text-xs text-gray-500 ml-2">Modals</span>
        </div>

        <!-- toast / popover / mobile-nav -->
        <div class="absolute right-4 top-4 flex flex-col gap-2">
          <div class="border-2 border-black rounded-lg bg-red-100 px-3 py-2 shadow-[2px_2px_0_0_#000000]">
            <span class="font-mono text-xs font-bold">z-toast (60)</span>
          </div>
          <div class="border-2 border-black rounded-lg bg-purple-100 px-3 py-2 shadow-[2px_2px_0_0_#000000]">
            <span class="font-mono text-xs font-bold">z-popover (70)</span>
          </div>
          <div class="border-2 border-black rounded-lg bg-pink-100 px-3 py-2 shadow-[2px_2px_0_0_#000000]">

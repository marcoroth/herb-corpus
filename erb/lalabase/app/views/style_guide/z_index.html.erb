  <!-- Tailwind Config -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Tailwind-Konfiguration</h2>
    <p class="text-gray-600 mb-4">
      Die Tokens sind in <code class="bg-gray-100 px-1 rounded">config/tailwind.config.js</code> definiert und stehen als
      Tailwind-Klassen zur Verfuegung.
    </p>
    <div class="border-2 border-black rounded-lg overflow-hidden shadow-[2px_2px_0_0_#000000]">
      <div class="bg-black text-white px-4 py-2 text-xs font-mono">config/tailwind.config.js</div>
      <pre class="bg-gray-900 text-gray-100 p-4 overflow-x-auto text-sm"><code>theme: {
  extend: {
    zIndex: {
      'base':       '0',
      'sticky':     '10',
      'backdrop':   '20',
      'dropdown':   '30',
      'sidebar':    '40',
      'modal':      '50',
      'toast':      '60',
      'popover':    '70',
      'mobile-nav': '80',
    },
  },
}</code></pre>
    </div>
  </section>

  <!-- Usage -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Verwendung</h2>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

      <!-- Correct -->
      <div class="border-2 border-green-600 rounded-lg overflow-hidden">
        <div class="bg-green-600 text-white px-4 py-2 font-bold flex items-center">
          <i class="bi bi-check-circle mr-2"></i> Richtig
        </div>
        <div class="p-4 space-y-3">
          <div>
            <p class="text-sm font-bold mb-1">ERB / HTML</p>
            <pre class="bg-gray-900 text-gray-100 p-3 rounded text-xs overflow-x-auto"><code>&lt;div class="fixed inset-0 z-modal"&gt;
  &lt;!-- Modal-Inhalt --&gt;
&lt;/div&gt;

&lt;div class="absolute z-dropdown bg-white ..."&gt;
  &lt;!-- Dropdown-Menu --&gt;
&lt;/div&gt;

&lt;div class="sticky top-0 z-sticky"&gt;
  &lt;!-- Tabellen-Header --&gt;
&lt;/div&gt;</code></pre>
          </div>
          <div>
            <p class="text-sm font-bold mb-1">JavaScript (Stimulus)</p>
            <pre class="bg-gray-900 text-gray-100 p-3 rounded text-xs overflow-x-auto"><code>// Tailwind-Klasse dynamisch setzen
element.classList.add("z-popover")

// In CSS-Property (nur wenn unvermeidbar)
element.style.zIndex = "50" // = modal</code></pre>
          </div>
          <div>
            <p class="text-sm font-bold mb-1">Responsive</p>
            <pre class="bg-gray-900 text-gray-100 p-3 rounded text-xs overflow-x-auto"><code>&lt;aside class="max-lg:z-sidebar"&gt;
  &lt;!-- Sidebar nur mobil elevated --&gt;
&lt;/aside&gt;</code></pre>
          </div>
        </div>
      </div>

      <!-- Wrong -->
      <div class="border-2 border-red-600 rounded-lg overflow-hidden">
        <div class="bg-red-600 text-white px-4 py-2 font-bold flex items-center">
          <i class="bi bi-x-circle mr-2"></i> Falsch
        </div>
        <div class="p-4 space-y-3">
          <div>
            <p class="text-sm font-bold mb-1">Numerische z-Werte</p>
            <pre class="bg-gray-900 text-gray-100 p-3 rounded text-xs overflow-x-auto"><code>&lt;!-- NICHT: Numerische Tailwind-Klassen --&gt;
&lt;div class="z-10"&gt;...&lt;/div&gt;
&lt;div class="z-50"&gt;...&lt;/div&gt;

&lt;!-- NICHT: Arbitraere Werte --&gt;
&lt;div class="z-[9999]"&gt;...&lt;/div&gt;</code></pre>
          </div>
          <div>
            <p class="text-sm font-bold mb-1">Inline-Styles</p>
            <pre class="bg-gray-900 text-gray-100 p-3 rounded text-xs overflow-x-auto"><code>&lt;!-- NICHT: Inline z-index --&gt;
&lt;div style="z-index: 9999;"&gt;...&lt;/div&gt;
&lt;div style="z-index: 99999;"&gt;...&lt;/div&gt;
&lt;div style="z-index: 100;"&gt;...&lt;/div&gt;</code></pre>
          </div>
          <div>
            <p class="text-sm font-bold mb-1">Magic Numbers in JS</p>
            <pre class="bg-gray-900 text-gray-100 p-3 rounded text-xs overflow-x-auto"><code>// NICHT: Magische Zahlen
element.style.zIndex = "9999"
element.style.zIndex = "2147483647"</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Rules -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Regeln</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="border-2 border-black rounded-lg bg-white p-6 hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all">
        <i class="bi bi-1-circle text-2xl mb-3 block"></i>
        <h3 class="font-bold mb-2">Immer semantische Tokens</h3>
        <p class="text-sm text-gray-600">Verwende <code class="bg-gray-100 px-1 rounded">z-modal</code> statt <code class="bg-gray-100 px-1 rounded">z-50</code>. Der Name dokumentiert die Absicht.</p>
      </div>

      <div class="border-2 border-black rounded-lg bg-white p-6 hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all">
        <i class="bi bi-2-circle text-2xl mb-3 block"></i>
        <h3 class="font-bold mb-2">Keine Inline-Styles</h3>
        <p class="text-sm text-gray-600">Kein <code class="bg-gray-100 px-1 rounded">style="z-index: ..."</code>. Ausnahme: Extrem seltene Faelle in JS-Controllern, dann mit Kommentar.</p>
      </div>

      <div class="border-2 border-black rounded-lg bg-white p-6 hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all">
        <i class="bi bi-3-circle text-2xl mb-3 block"></i>
        <h3 class="font-bold mb-2">Keine verschachtelten Modals</h3>
        <p class="text-sm text-gray-600">Ein Modal oeffnet kein weiteres Modal. Stattdessen: Inhalt im bestehenden Modal austauschen (z.B. via Turbo Frame).</p>
      </div>

      <div class="border-2 border-black rounded-lg bg-white p-6 hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all">
        <i class="bi bi-4-circle text-2xl mb-3 block"></i>
        <h3 class="font-bold mb-2">Layer-Hierarchie respektieren</h3>
        <p class="text-sm text-gray-600">Toast &gt; Modal &gt; Sidebar &gt; Dropdown &gt; Content. Kein Element darf seine Schicht ueberspringen.</p>
      </div>
    </div>
  </section>

  <!-- Decision aid -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Welchen Token brauche ich?</h2>
    <div class="border-2 border-black rounded-lg overflow-hidden shadow-[2px_2px_0_0_#000000]">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-black text-white">
            <th class="px-4 py-3 text-left font-bold">Ich baue...</th>
            <th class="px-4 py-3 text-left font-bold">Token</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-gray-200 bg-white">
            <td class="px-4 py-3">...einen Sticky-Header oder eine fixierte Tabellenzeile</td>
            <td class="px-4 py-3"><code class="bg-cobalt-100 px-2 py-0.5 rounded text-xs font-bold">z-sticky</code></td>
          </tr>
          <tr class="border-b border-gray-200 bg-gray-50">
            <td class="px-4 py-3">...einen halbtransparenten Hintergrund hinter einem Overlay</td>
            <td class="px-4 py-3"><code class="bg-gray-200 px-2 py-0.5 rounded text-xs font-bold">z-backdrop</code></td>
          </tr>
          <tr class="border-b border-gray-200 bg-white">
            <td class="px-4 py-3">...ein Dropdown-Menu, eine Autosuggest-Liste, ein Kontext-Menu</td>
            <td class="px-4 py-3"><code class="bg-lime-100 px-2 py-0.5 rounded text-xs font-bold">z-dropdown</code></td>
          </tr>
          <tr class="border-b border-gray-200 bg-gray-50">
            <td class="px-4 py-3">...eine Sidebar oder ein Navigation-Panel</td>
            <td class="px-4 py-3"><code class="bg-yellow-100 px-2 py-0.5 rounded text-xs font-bold">z-sidebar</code></td>
          </tr>
          <tr class="border-b border-gray-200 bg-white">
            <td class="px-4 py-3">...ein modales Fenster mit Backdrop</td>
            <td class="px-4 py-3"><code class="bg-orange-100 px-2 py-0.5 rounded text-xs font-bold">z-modal</code></td>
          </tr>
          <tr class="border-b border-gray-200 bg-gray-50">
            <td class="px-4 py-3">...eine Flash-Nachricht oder Toast-Notification</td>
            <td class="px-4 py-3"><code class="bg-red-100 px-2 py-0.5 rounded text-xs font-bold">z-toast</code></td>
          </tr>
          <tr class="border-b border-gray-200 bg-white">
            <td class="px-4 py-3">...einen Tooltip, Popover oder Hover-Pfeil</td>
            <td class="px-4 py-3"><code class="bg-purple-100 px-2 py-0.5 rounded text-xs font-bold">z-popover</code></td>
          </tr>
          <tr class="bg-gray-50">
            <td class="px-4 py-3">...die mobile Bottom-Navigation</td>
            <td class="px-4 py-3"><code class="bg-pink-100 px-2 py-0.5 rounded text-xs font-bold">z-mobile-nav</code></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</div>

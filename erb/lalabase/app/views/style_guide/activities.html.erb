<div class="container mx-auto px-8 py-8 max-w-7xl">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-4xl font-black text-black uppercase mb-2">Activities</h1>
    <p class="text-gray-600">Aktivitätsverlauf und Timeline-Komponenten</p>
  </div>

  <!-- Introduction -->
  <section class="mb-12">
    <div class="border-2 border-black rounded-lg bg-yellow-50 p-6 mb-8">
      <h2 class="text-xl font-bold mb-3">Übersicht</h2>
      <p class="mb-3">
        Activity-Komponenten werden verwendet, um Änderungen und Ereignisse in einer chronologischen Timeline darzustellen.
        Sie zeigen wer, was, wann geändert hat - mit visueller Hervorhebung von alten und neuen Werten.
      </p>
      <p class="text-sm text-gray-600">
        <strong>Verwendung:</strong> Ticket-Historie, TimeSessionGroup-Aktivitäten, Projekt-Timeline
      </p>
    </div>
  </section>

  <!-- Basic Activity Card -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Basic Activity Card</h2>
    
    <div class="mb-6">
      <h3 class="text-lg font-semibold mb-3">Standard Activity</h3>
      <p class="text-gray-600 mb-4">Die Basis-Komponente für alle Aktivitäten mit Icon, Actor und Timestamp.</p>
      
      <div class="border-2 border-black rounded-lg bg-white p-6 mb-4">
        <div class="activity-card bg-gray-50 py-4 px-6 rounded-lg border border-black hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 duration-300 ease-in-out relative">
          <div class="flex items-start gap-3">
            <div class="flex-shrink-0 mt-0.5">
              <div class="w-8 h-8 rounded-full bg-cobalt-600 flex items-center justify-center">
                <i class="bi bi-pencil text-white text-sm"></i>
              </div>
            </div>
            <div class="flex-grow">
              <p class="text-sm font-medium text-gray-700">
                <span class="font-semibold">Max Mustermann</span>
                hat die Gruppe bearbeitet
              </p>
              <div class="mt-1 text-xs text-gray-500 italic">
                vor 2 Stunden
              </div>
            </div>
          </div>
        </div>
      </div>

      <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;div class="activity-card bg-gray-50 py-4 px-6 rounded-lg border border-black 
     hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 
     duration-300 ease-in-out"&gt;
  &lt;div class="flex items-start gap-3"&gt;
    &lt;!-- Icon --&gt;
    &lt;div class="w-8 h-8 rounded-full bg-cobalt-600 flex items-center justify-center"&gt;
      &lt;i class="bi bi-pencil text-white text-sm"&gt;&lt;/i&gt;
    &lt;/div&gt;
    &lt;!-- Content --&gt;
    &lt;div class="flex-grow"&gt;
      &lt;p class="text-sm font-medium text-gray-700"&gt;
        &lt;span class="font-semibold"&gt;Max Mustermann&lt;/span&gt;
        hat die Gruppe bearbeitet
      &lt;/p&gt;
      &lt;div class="mt-1 text-xs text-gray-500 italic"&gt;
        vor 2 Stunden
      &lt;/div&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;</code></pre>
    </div>
  </section>

  <!-- Activity Icons -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Activity Icons</h2>
    <p class="text-gray-600 mb-6">Jede Activity-Art hat ein spezifisches Icon mit passendem Hintergrund.</p>
    
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
      <div class="border border-black rounded-lg bg-white p-4 text-center">
        <div class="w-12 h-12 rounded-full bg-green-600 flex items-center justify-center mx-auto mb-2">
          <i class="bi bi-plus-circle text-white"></i>
        </div>
        <p class="text-sm font-medium">Created</p>
        <p class="text-xs text-gray-500">bg-green-600</p>
      </div>
      
      <div class="border border-black rounded-lg bg-white p-4 text-center">
        <div class="w-12 h-12 rounded-full bg-cobalt-600 flex items-center justify-center mx-auto mb-2">
          <i class="bi bi-pencil text-white"></i>
        </div>
        <p class="text-sm font-medium">Updated</p>
        <p class="text-xs text-gray-500">bg-cobalt-600</p>
      </div>
      
      <div class="border border-black rounded-lg bg-white p-4 text-center">
        <div class="w-12 h-12 rounded-full bg-red-600 flex items-center justify-center mx-auto mb-2">
          <i class="bi bi-trash text-white"></i>
        </div>
        <p class="text-sm font-medium">Deleted</p>
        <p class="text-xs text-gray-500">bg-red-600</p>
      </div>
      
      <div class="border border-black rounded-lg bg-white p-4 text-center">
        <div class="w-12 h-12 rounded-full bg-orange-600 flex items-center justify-center mx-auto mb-2">
          <i class="bi bi-exclamation-triangle text-white"></i>
        </div>
        <p class="text-sm font-medium">Warning</p>
        <p class="text-xs text-gray-500">bg-orange-600</p>
      </div>
      
      <div class="border border-black rounded-lg bg-white p-4 text-center">
        <div class="w-12 h-12 rounded-full bg-purple-600 flex items-center justify-center mx-auto mb-2">
          <i class="bi bi-plus-square text-white"></i>
        </div>
        <p class="text-sm font-medium">Added</p>
        <p class="text-xs text-gray-500">bg-purple-600</p>
      </div>
      
      <div class="border border-black rounded-lg bg-white p-4 text-center">
        <div class="w-12 h-12 rounded-full bg-yellow-600 flex items-center justify-center mx-auto mb-2">
          <i class="bi bi-x-circle text-white"></i>
        </div>
        <p class="text-sm font-medium">Reverted</p>
        <p class="text-xs text-gray-500">bg-yellow-600</p>
      </div>
      
      <div class="border border-black rounded-lg bg-white p-4 text-center">
        <div class="w-12 h-12 rounded-full bg-cyan-600 flex items-center justify-center mx-auto mb-2">
          <i class="bi bi-arrow-right-circle text-white"></i>
        </div>
        <p class="text-sm font-medium">Status Change</p>
        <p class="text-xs text-gray-500">bg-cyan-600</p>
      </div>
      
      <div class="border border-black rounded-lg bg-white p-4 text-center">
        <div class="w-12 h-12 rounded-full bg-gray-600 flex items-center justify-center mx-auto mb-2">
          <i class="bi bi-circle text-white"></i>
        </div>
        <p class="text-sm font-medium">Default</p>
        <p class="text-xs text-gray-500">bg-gray-600</p>
      </div>
    </div>
  </section>

  <!-- Activity with Changes -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Activity mit Änderungen</h2>
    <p class="text-gray-600 mb-6">Zeigt alte und neue Werte mit visueller Hervorhebung an.</p>
    
    <div class="border-2 border-black rounded-lg bg-white p-6 mb-4">
      <% activity = @sample_activities[1] %>
      <div class="activity-card bg-gray-50 py-4 px-6 rounded-lg border border-black hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 duration-300 ease-in-out relative">
        <div class="flex items-start gap-3">
          <div class="flex-shrink-0 mt-0.5">
            <div class="w-8 h-8 rounded-full bg-cobalt-600 flex items-center justify-center">
              <i class="bi bi-pencil text-white text-sm"></i>
            </div>
          </div>
          <div class="flex-grow">
            <p class="text-sm font-medium text-gray-700">
              <span class="font-semibold"><%= viewer_display_name(activity.actor) %></span>
              hat die Gruppe bearbeitet
            </p>
            
            <details class="mt-2" open>
              <summary class="text-xs font-medium text-purple-600 cursor-pointer hover:text-purple-800 select-none">
                Details anzeigen
              </summary>
              <div class="mt-2 text-xs bg-white p-3 rounded border border-gray-200">
                <% activity.attribute_changes.each do |key, value| %>
                  <div class="mb-1">
                    <strong class="font-semibold"><%= key.humanize %>:</strong>
                    <span class="bg-red-100 px-1 rounded text-red-700 line-through"><%= value[0] %></span>
                    <span class="mx-1">→</span>
                    <span class="bg-green-100 px-1 rounded text-green-700"><%= value[1] %></span>
                  </div>
                <% end %>
              </div>
            </details>
            
            <div class="mt-1 text-xs text-gray-500 italic">
              <%= time_ago_in_words(activity.created_at) %> ago
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="border border-gray-300 rounded-lg p-4">
        <h4 class="font-semibold mb-2">Werte-Darstellung</h4>
        <div class="space-y-2">
          <div class="flex items-center gap-2">
            <span class="bg-red-100 px-2 py-1 rounded text-red-700 line-through text-sm">Alter Wert</span>
            <span class="text-gray-600">Gelöscht/Ersetzt</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="bg-green-100 px-2 py-1 rounded text-green-700 text-sm">Neuer Wert</span>
            <span class="text-gray-600">Hinzugefügt/Neu</span>
          </div>
        </div>
      </div>
      
      <div class="border border-gray-300 rounded-lg p-4">
        <h4 class="font-semibold mb-2">Spezielle Felder</h4>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• <strong>Booleans:</strong> "Abgerechnet" statt "true"</li>
          <li>• <strong>Datum:</strong> Formatiert als "01.01.2024 10:30"</li>
          <li>• <strong>Leere Werte:</strong> Zeigt "[leer]" an</li>
          <li>• <strong>Arrays:</strong> Als kommaseparierte Liste</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Warning Activities -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Warning Activities</h2>
    <p class="text-gray-600 mb-6">Spezielle Darstellung für kritische Änderungen.</p>
    
    <div class="border-2 border-black rounded-lg bg-white p-6 mb-4">
      <% activity = @sample_activities[3] %>
      <div class="activity-card bg-gray-50 py-4 px-6 rounded-lg border border-black hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 duration-300 ease-in-out relative">
        <div class="flex items-start gap-3">
          <div class="flex-shrink-0 mt-0.5">
            <div class="w-8 h-8 rounded-full bg-orange-600 flex items-center justify-center">
              <i class="bi bi-exclamation-triangle text-white text-sm"></i>
            </div>
          </div>
          <div class="flex-grow">
            <p class="text-sm font-medium text-gray-700">
              <span class="font-semibold"><%= viewer_display_name(activity.actor) %></span>
              <span class="text-orange-600">hat Daten einer abgerechneten Gruppe geändert</span>
            </p>
            
            <details class="mt-2" open>
              <summary class="text-xs font-medium text-purple-600 cursor-pointer hover:text-purple-800 select-none">
                Details anzeigen
              </summary>
              <div class="mt-2 text-xs bg-white p-3 rounded border border-gray-200">
                <% activity.attribute_changes.each do |key, value| %>
                  <div class="mb-1">
                    <strong class="font-semibold"><%= key.humanize %>:</strong>
                    <span class="bg-red-100 px-1 rounded text-red-700 line-through"><%= value[0] %></span>
                    <span class="mx-1">→</span>
                    <span class="bg-green-100 px-1 rounded text-green-700"><%= value[1] %></span>
                  </div>
                <% end %>
                
                <div class="mt-2 p-2 bg-orange-50 border border-orange-200 rounded">
                  <i class="bi bi-exclamation-triangle text-orange-600"></i>
                  <span class="text-orange-700 font-semibold">
                    Warnung: Änderung nach Abrechnung wurde bestätigt
                  </span>
                </div>
              </div>
            </details>
            
            <div class="mt-1 text-xs text-gray-500 italic">
              <%= time_ago_in_words(activity.created_at) %> ago
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Complete Timeline Example -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Komplette Timeline</h2>
    <p class="text-gray-600 mb-6">Beispiel einer vollständigen Activity-Timeline.</p>
    
    <div class="border-2 border-black rounded-lg bg-white p-6">
      <h3 class="text-lg font-semibold mb-4">Aktivitätsverlauf</h3>
      
      <div class="space-y-3">
        <% @sample_activities.each do |activity| %>
          <div class="activity-card bg-gray-50 py-4 px-6 rounded-lg border border-black hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 duration-300 ease-in-out relative">
            <div class="flex items-start gap-3">
              <div class="flex-shrink-0 mt-0.5">
                <div class="w-8 h-8 rounded-full flex items-center justify-center
                  <% case activity.action %>
                  <% when 'created' %>
                    bg-green-600
                  <% when 'updated' %>
                    bg-cobalt-600
                  <% when 'marked_as_billed' %>
                    bg-green-600
                  <% when 'billed_data_changed' %>
                    bg-orange-600
                  <% when 'time_sessions_added' %>
                    bg-purple-600
                  <% else %>
                    bg-gray-600
                  <% end %>">
                  <i class="bi bi-<%= 
                    case activity.action
                    when 'created' then 'plus-circle'
                    when 'updated' then 'pencil'
                    when 'marked_as_billed' then 'check-circle'
                    when 'billed_data_changed' then 'exclamation-triangle'
                    when 'time_sessions_added' then 'plus-square'
                    else 'circle'
                    end
                  %> text-white text-sm"></i>
                </div>
              </div>
              
              <div class="flex-grow">
                <p class="text-sm font-medium text-gray-700">
                  <span class="font-semibold"><%= viewer_display_name(activity.actor) %></span>
                  
                  <% case activity.action %>
                  <% when 'created' %>
                    hat die Gruppe "<%= activity.parameters['display_name'] %>" erstellt
                  <% when 'updated' %>
                    hat die Gruppe bearbeitet
                  <% when 'marked_as_billed' %>
                    hat die Gruppe als abgerechnet markiert
                    <span class="text-gray-600">(Rechnung: <%= activity.parameters['invoice_number'] %>)</span>
                  <% when 'billed_data_changed' %>
                    <span class="text-orange-600">hat Daten einer abgerechneten Gruppe geändert</span>
                  <% when 'time_sessions_added' %>
                    hat <%= activity.parameters['count'] %> Zeit-Sessions hinzugefügt
                    <span class="text-gray-600">(Dauer: <%= activity.parameters['total_duration'] %>)</span>
                  <% end %>
                </p>
                
                <% if activity.attribute_changes.present? %>
                  <details class="mt-2">
                    <summary class="text-xs font-medium text-purple-600 cursor-pointer hover:text-purple-800 select-none">
                      Details anzeigen
                    </summary>
                    <div class="mt-2 text-xs bg-white p-3 rounded border border-gray-200">
                      <% activity.attribute_changes.each do |key, value| %>
                        <div class="mb-1">
                          <strong class="font-semibold"><%= key.humanize %>:</strong>
                          <span class="bg-red-100 px-1 rounded text-red-700 line-through"><%= value[0] %></span>
                          <span class="mx-1">→</span>
                          <span class="bg-green-100 px-1 rounded text-green-700"><%= value[1] %></span>
                        </div>
                      <% end %>
                      
                      <% if activity.action == 'billed_data_changed' %>
                        <div class="mt-2 p-2 bg-orange-50 border border-orange-200 rounded">
                          <i class="bi bi-exclamation-triangle text-orange-600"></i>
                          <span class="text-orange-700 font-semibold">
                            Warnung: Änderung nach Abrechnung wurde bestätigt
                          </span>
                        </div>
                      <% end %>
                    </div>
                  </details>
                <% end %>
                
                <div class="mt-1 text-xs text-gray-500 italic">
                  <%= time_ago_in_words(activity.created_at) %> ago
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- Usage Guidelines -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Usage Guidelines</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="border border-black rounded-lg bg-white p-6">
        <h3 class="font-bold mb-3">Best Practices</h3>
        <ul class="text-sm space-y-2">
          <li class="flex items-start gap-2">
            <i class="bi bi-check-circle text-green-600 mt-0.5"></i>
            <span>Verwende konsistente Icons für gleiche Aktionen</span>
          </li>
          <li class="flex items-start gap-2">
            <i class="bi bi-check-circle text-green-600 mt-0.5"></i>
            <span>Zeige immer Actor und Timestamp</span>
          </li>
          <li class="flex items-start gap-2">
            <i class="bi bi-check-circle text-green-600 mt-0.5"></i>
            <span>Details-Dropdown für umfangreiche Änderungen</span>
          </li>
          <li class="flex items-start gap-2">
            <i class="bi bi-check-circle text-green-600 mt-0.5"></i>
            <span>Farbcodierung für verschiedene Activity-Typen</span>
          </li>
        </ul>
      </div>
      
      <div class="border border-black rounded-lg bg-white p-6">
        <h3 class="font-bold mb-3">Zu vermeiden</h3>
        <ul class="text-sm space-y-2">
          <li class="flex items-start gap-2">
            <i class="bi bi-x-circle text-red-600 mt-0.5"></i>
            <span>Technische IDs statt Anzeigenamen</span>
          </li>
          <li class="flex items-start gap-2">
            <i class="bi bi-x-circle text-red-600 mt-0.5"></i>
            <span>Unformatierte Timestamps</span>
          </li>
          <li class="flex items-start gap-2">
            <i class="bi bi-x-circle text-red-600 mt-0.5"></i>
            <span>Zu viele Details ohne Dropdown</span>
          </li>
          <li class="flex items-start gap-2">
            <i class="bi bi-x-circle text-red-600 mt-0.5"></i>
            <span>Inkonsistente Icon-Verwendung</span>
          </li>
        </ul>
      </div>
    </div>
  </section>
</div>
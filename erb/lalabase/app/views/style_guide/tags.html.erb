<div class="container mx-auto px-8 py-8 max-w-7xl">
  
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-4xl font-black text-black uppercase mb-2">Tag Komponenten</h1>
    <p class="text-gray-600">Alle Tag-Varianten und Verwendungsbeispiele</p>
  </div>
  
  <!-- Basic Variants -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Varianten</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="space-y-4">
        <h3 class="font-bold mb-2">Standard Varianten</h3>
        <div class="flex flex-wrap gap-3">
          <%= render NeoTagComponent.new(text: "Primary", variant: :primary) %>
          <%= render NeoTagComponent.new(text: "Secondary", variant: :secondary) %>
          <%= render NeoTagComponent.new(text: "Success", variant: :success) %>
          <%= render NeoTagComponent.new(text: "Danger", variant: :danger) %>
          <%= render NeoTagComponent.new(text: "Warning", variant: :warning) %>
          <%= render NeoTagComponent.new(text: "Info", variant: :info) %>
          <%= render NeoTagComponent.new(text: "Neutral", variant: :neutral) %>
        </div>
      </div>
      
      <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;%= render NeoTagComponent.new(
  text: "Primary",
  variant: :primary
) %&gt;</code></pre>
    </div>
  </section>
  
  <!-- Tag Sizes -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Größen</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="space-y-4">
        <h3 class="font-bold mb-2">Verfügbare Größen</h3>
        <div class="flex flex-wrap items-center gap-3">
          <%= render NeoTagComponent.new(text: "Small", size: :small) %>
          <%= render NeoTagComponent.new(text: "Medium", size: :medium) %>
          <%= render NeoTagComponent.new(text: "Large", size: :large) %>
        </div>
      </div>
      
      <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;%= render NeoTagComponent.new(
  text: "Small",
  size: :small
) %&gt;</code></pre>
    </div>
  </section>
  
  <!-- Tags with Icons -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Mit Icons</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="space-y-4">
        <h3 class="font-bold mb-2">Icons mit Bootstrap Icons</h3>
        <div class="flex flex-wrap gap-3">
          <%= render NeoTagComponent.new(text: "User", icon: "person", variant: :primary) %>
          <%= render NeoTagComponent.new(text: "Settings", icon: "gear", variant: :secondary) %>
          <%= render NeoTagComponent.new(text: "Verified", icon: "check-circle", variant: :success) %>
          <%= render NeoTagComponent.new(text: "Error", icon: "exclamation-circle", variant: :danger) %>
          <%= render NeoTagComponent.new(text: "Alert", icon: "bell", variant: :warning) %>
        </div>
      </div>
      
      <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;%= render NeoTagComponent.new(
  text: "User",
  icon: "person",
  variant: :primary
) %&gt;</code></pre>
    </div>
  </section>
  
  <!-- Removable Tags -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Entfernbare Tags</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="space-y-4">
        <h3 class="font-bold mb-2">Mit Entfernen-Button</h3>
        <p class="text-sm text-gray-600 mb-3">Klicke auf das X um Tags zu entfernen</p>
        <div class="flex flex-wrap gap-3" id="removable-tags-demo">
          <%= render NeoTagComponent.new(text: "JavaScript", removable: true, variant: :primary) %>
          <%= render NeoTagComponent.new(text: "Ruby on Rails", removable: true, variant: :warning) %>
          <%= render NeoTagComponent.new(text: "PostgreSQL", removable: true, variant: :info) %>
          <%= render NeoTagComponent.new(text: "Redis", removable: true, variant: :danger) %>
          <%= render NeoTagComponent.new(text: "Docker", removable: true, variant: :secondary) %>
        </div>
      </div>
      
      <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;%= render NeoTagComponent.new(
  text: "JavaScript",
  removable: true,
  variant: :primary
) %&gt;</code></pre>
    </div>
  </section>
  
  <!-- Proposals are not tags (Belegungstabelle B15 / F31) -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Vorschläge sind keine Tags</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="space-y-4">
        <p class="text-sm text-gray-600 mb-3">
          Der gestrichelte Vorschlags-Chip ist weg. Ein Vorschlag von außen (Assistent, Parser) ist
          keine Bedingung, die schon filtert, und kein Tag, das noch nicht gespeichert ist: er ist
          eine Frage, die der Leser noch nicht beantwortet hat. Dafür gibt es die Vorschlagszeile
          (F31) der Filterleiste: eine eigene Zeile unter den Bedingungen mit der Quelle als
          Marke, dem Satz und zwei Entscheidungen. Der gestrichelte Rand ist seither unbelegt.
        </p>
        <div class="flex flex-wrap items-center gap-3 border-t border-divider py-2 text-xs text-body">
          <span class="text-[9.5px] uppercase tracking-wider border border-cream-300 rounded px-1.5 text-muted">Assistent</span>
          <span class="mr-auto">Auch nach <strong class="font-semibold text-heading">Fällig: bis Freitag</strong> filtern?</span>
          <span class="text-xs font-medium text-body underline underline-offset-2">Übernehmen</span>
          <span class="text-xs font-medium text-body underline underline-offset-2">Ablehnen</span>
        </div>
        <p class="text-xs text-gray-500">Statische Abbildung; die echte Zeile rendert <code class="px-1 py-0.5 bg-gray-100 rounded text-xs">NeoFilterBarComponent</code> aus <code class="px-1 py-0.5 bg-gray-100 rounded text-xs">proposals:</code>.</p>
      </div>

      <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;%= render NeoFilterBarComponent.new(
  ...,
  proposals: [
    { source: "Assistent", category: "due_date",
      value: "this_week", label: "bis Freitag" }
  ]
) %&gt;</code></pre>
    </div>
  </section>

  <!-- Clickable Tags -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Klickbare Tags (Links)</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="space-y-4">
        <h3 class="font-bold mb-2">Tags als Navigation</h3>
        <div class="flex flex-wrap gap-3">
          <%= render NeoTagComponent.new(text: "Go to Buttons", href: style_guide_buttons_path, variant: :primary) %>
          <%= render NeoTagComponent.new(text: "View Typography", href: style_guide_typography_path, variant: :secondary) %>
          <%= render NeoTagComponent.new(text: "See Colors", href: style_guide_colors_path, icon: "palette", variant: :info) %>
        </div>
      </div>
      
      <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;%= render NeoTagComponent.new(
  text: "Go to Buttons",
  href: style_guide_buttons_path,
  variant: :primary
) %&gt;</code></pre>
    </div>
  </section>
  
  <!-- Complex Examples -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Komplexe Beispiele</h2>
    <div class="border-2 border-black rounded-lg p-6 bg-white">
      <div class="space-y-6">
        <!-- Category tags -->
        <div>
          <h3 class="text-sm font-semibold mb-3">Kategorien:</h3>
          <div class="flex flex-wrap gap-2">
            <%= render NeoTagComponent.new(text: "Frontend", icon: "code", removable: true, size: :small, variant: :primary) %>
            <%= render NeoTagComponent.new(text: "Backend", icon: "server", removable: true, size: :small, variant: :secondary) %>
            <%= render NeoTagComponent.new(text: "DevOps", icon: "cloud", removable: true, size: :small, variant: :info) %>
            <%= render NeoTagComponent.new(text: "Design", icon: "brush", removable: true, size: :small, variant: :warning) %>
          </div>
        </div>
        
        <!-- Status tags -->
        <div>
          <h3 class="text-sm font-semibold mb-3">Status:</h3>
          <div class="flex flex-wrap gap-2">
            <%= render NeoTagComponent.new(text: "Active", icon: "check-circle", variant: :success) %>
            <%= render NeoTagComponent.new(text: "Pending", icon: "clock", variant: :warning) %>
            <%= render NeoTagComponent.new(text: "Archived", icon: "archive", variant: :neutral) %>
          </div>
        </div>
        
        <!-- Code Example -->
        <div class="mt-6 pt-6 border-t border-gray-200">
          <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;%= render NeoTagComponent.new(
  text: "Frontend",
  icon: "code",
  removable: true,
  size: :small,
  variant: :primary
) %&gt;</code></pre>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Using with Blocks -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Mit Content Blocks</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="space-y-4">
        <h3 class="font-bold mb-2">Flexible Inhalte</h3>
        <p class="text-sm text-gray-600 mb-3">Tags können auch Block-Content enthalten</p>
        <div class="flex flex-wrap gap-3">
          <%= render NeoTagComponent.new(variant: :primary, removable: true) do %>
            <span class="font-bold">Bold</span> Text
          <% end %>
          
          <%= render NeoTagComponent.new(variant: :info, icon: "star-fill") do %>
            Featured <span class="text-xs">(New!)</span>
          <% end %>
        </div>
      </div>
      
      <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;%= render NeoTagComponent.new(
  variant: :primary,
  removable: true
) do %&gt;
  &lt;span class="font-bold"&gt;Bold&lt;/span&gt; Text
&lt;% end %&gt;</code></pre>
    </div>
  </section>
  
  <!-- Info Tags Section -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Info Tags (Status-Indikatoren)</h2>
    
    <!-- Basic Info Tags -->
    <div class="mb-8">
      <h3 class="text-xl font-bold mb-4">Standard Varianten</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="space-y-4">
          <p class="text-sm text-gray-600 mb-3">Spezielle Tags für Status-Anzeigen und Informationen</p>
          <div class="flex flex-wrap gap-3">
            <%= render NeoInfoTagComponent.new(text: "Suchbar", variant: :success) %>
            <%= render NeoInfoTagComponent.new(text: "Warnung", variant: :warning) %>
            <%= render NeoInfoTagComponent.new(text: "Fehler", variant: :danger) %>
            <%= render NeoInfoTagComponent.new(text: "Info", variant: :info) %>
            <%= render NeoInfoTagComponent.new(text: "Wird verarbeitet", variant: :processing, animated: true) %>
            <%= render NeoInfoTagComponent.new(text: "Neutral", variant: :neutral) %>
          </div>
        </div>
        
        <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;%= render NeoInfoTagComponent.new(
  text: "Suchbar",
  variant: :success,
  title: "Tooltip Text"
) %&gt;</code></pre>
      </div>
    </div>
    
    <!-- Info Tag Sizes -->
    <div class="mb-8">
      <h3 class="text-xl font-bold mb-4">Größen</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div class="flex flex-wrap items-center gap-3">
            <%= render NeoInfoTagComponent.new(text: "Small Info", variant: :info, size: :small) %>
            <%= render NeoInfoTagComponent.new(text: "Medium Info", variant: :info, size: :medium) %>
            <%= render NeoInfoTagComponent.new(text: "Large Info", variant: :info, size: :large) %>
          </div>
        </div>
        
        <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;%= render NeoInfoTagComponent.new(
  text: "Large Info",
  variant: :info,
  size: :large
) %&gt;</code></pre>
      </div>
    </div>
    
    <!-- Animated Processing -->
    <div class="mb-8">
      <h3 class="text-xl font-bold mb-4">Animierte Status</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="space-y-4">
          <p class="text-sm text-gray-600 mb-3">Processing-Variante mit Animation für laufende Prozesse</p>
          <div class="flex flex-wrap gap-3">
            <%= render NeoInfoTagComponent.new(text: "Wird verarbeitet", variant: :processing, animated: true) %>
            <%= render NeoInfoTagComponent.new(text: "Embeddings erstellen", variant: :processing, animated: true, icon: "arrow-repeat") %>
            <%= render NeoInfoTagComponent.new(text: "Synchronisiere", variant: :processing, animated: true, size: :medium) %>
          </div>
        </div>
        
        <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;%= render NeoInfoTagComponent.new(
  text: "Wird verarbeitet",
  variant: :processing,
  animated: true
) %&gt;</code></pre>
      </div>
    </div>
    
    <!-- Real World Examples -->
    <div class="mb-8">
      <h3 class="text-xl font-bold mb-4">Praxisbeispiele</h3>
      <div class="border-2 border-black rounded-lg p-6 bg-white">
        <div class="space-y-6">
          <!-- Document Status -->
          <div>
            <h4 class="text-sm font-semibold mb-3">Dokument-Status:</h4>
            <div class="flex flex-wrap gap-2">
              <%= render NeoInfoTagComponent.new(text: "PDF", variant: :neutral, icon: "file-pdf") %>
              <%= render NeoInfoTagComponent.new(text: "Verschlüsselt", variant: :success, icon: "lock-fill") %>
              <%= render NeoInfoTagComponent.new(text: "Läuft ab in 7 Tagen", variant: :warning, icon: "calendar-x") %>
            </div>
          </div>
          
          <!-- System Status -->
          <div>
            <h4 class="text-sm font-semibold mb-3">System-Status:</h4>
            <div class="flex flex-wrap gap-2">
              <%= render NeoInfoTagComponent.new(text: "Online", variant: :success, icon: "wifi") %>
              <%= render NeoInfoTagComponent.new(text: "Wartung", variant: :warning, icon: "tools") %>
              <%= render NeoInfoTagComponent.new(text: "Offline", variant: :danger, icon: "wifi-off") %>
              <%= render NeoInfoTagComponent.new(text: "Backup läuft", variant: :processing, animated: true) %>
            </div>
          </div>
          
          <!-- AI/ML Status -->
          <div>
            <h4 class="text-sm font-semibold mb-3">KI-Status:</h4>
            <div class="flex flex-wrap gap-2">
              <%= render NeoInfoTagComponent.new(text: "Suchbar", variant: :success, title: "KI-Embeddings erstellt") %>
              <%= render NeoInfoTagComponent.new(text: "Wird indiziert", variant: :processing, animated: true, title: "Embeddings werden erstellt") %>
              <%= render NeoInfoTagComponent.new(text: "Fehler bei Analyse", variant: :danger, title: "Siehe Fehlerprotokoll") %>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Feature Overview -->
    <div class="border-2 border-black rounded-lg p-6 bg-gray-50">
      <h4 class="font-bold mb-4">Info Tag Features</h4>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <ul class="space-y-2 text-sm">
          <li class="flex items-start">
            <i class="bi bi-check-circle text-green-600 mr-2 mt-0.5"></i>
            <span><strong>Vordefinierte Icons:</strong> Jede Variante hat ein Standard-Icon</span>
          </li>
          <li class="flex items-start">
            <i class="bi bi-check-circle text-green-600 mr-2 mt-0.5"></i>
            <span><strong>Custom Icons:</strong> Eigene Bootstrap Icons möglich</span>
          </li>
          <li class="flex items-start">
            <i class="bi bi-check-circle text-green-600 mr-2 mt-0.5"></i>
            <span><strong>Animation:</strong> Processing-Variante kann animiert werden</span>
          </li>
        </ul>
        <ul class="space-y-2 text-sm">
          <li class="flex items-start">
            <i class="bi bi-check-circle text-green-600 mr-2 mt-0.5"></i>
            <span><strong>Tooltips:</strong> Title-Attribut für zusätzliche Informationen</span>
          </li>
          <li class="flex items-start">
            <i class="bi bi-check-circle text-green-600 mr-2 mt-0.5"></i>
            <span><strong>Größen:</strong> Small (default), Medium, Large</span>
          </li>
          <li class="flex items-start">
            <i class="bi bi-check-circle text-green-600 mr-2 mt-0.5"></i>
            <span><strong>Semantisch:</strong> Klare Bedeutung durch Varianten</span>
          </li>
        </ul>
      </div>
    </div>
  </section>
  
  <!-- Usage Guidelines -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Verwendungsrichtlinien</h2>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div class="border-2 border-black rounded-lg p-6">
        <h3 class="font-bold mb-4">Best Practices</h3>
        <ul class="space-y-2 text-sm">
          <li class="flex items-start">
            <i class="bi bi-check-circle text-green-600 mr-2 mt-0.5"></i>
            <span>Verwende aussagekräftige, kurze Texte</span>
          </li>
          <li class="flex items-start">
            <i class="bi bi-check-circle text-green-600 mr-2 mt-0.5"></i>
            <span>Nutze konsistente Varianten für gleiche Kategorien</span>
          </li>
          <li class="flex items-start">
            <i class="bi bi-check-circle text-green-600 mr-2 mt-0.5"></i>
            <span>Icons sollten den Inhalt unterstützen</span>
          </li>
          <li class="flex items-start">
            <i class="bi bi-check-circle text-green-600 mr-2 mt-0.5"></i>
            <span>Removable nur wenn User die Kontrolle hat</span>
          </li>
        </ul>
      </div>
      
      <div class="border-2 border-black rounded-lg p-6">
        <h3 class="font-bold mb-4">Wann welche Komponente?</h3>
        <div class="space-y-4">
          <div>
            <h4 class="font-semibold text-sm mb-2">NeoTagComponent verwenden für:</h4>
            <ul class="space-y-1 text-sm ml-4">
              <li>• Kategorien und Labels</li>
              <li>• Entfernbare Tags (z.B. Filter)</li>
              <li>• Klickbare Tags als Navigation</li>
              <li>• Allgemeine Metadaten</li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold text-sm mb-2">NeoInfoTagComponent verwenden für:</h4>
            <ul class="space-y-1 text-sm ml-4">
              <li>• Status-Indikatoren</li>
              <li>• System-Zustände</li>
              <li>• Prozess-Informationen</li>
              <li>• Wichtige Hinweise mit Icons</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
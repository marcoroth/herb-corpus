<div class="container mx-auto px-8 py-8 max-w-7xl">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-4xl font-black text-black uppercase mb-2">Form Komponenten</h1>
    <p class="text-gray-600">Formular-Elemente im Neo Brutalist Style für konsistente und interaktive Benutzererfahrungen</p>
  </div>
  
  <!-- NeoToggleComponent -->
  <div class="border-2 border-black rounded-lg bg-white p-8 mb-8 shadow-[2px_2px_0_0_#000000]">
    <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
      <i class="bi bi-toggle-on text-lime-500"></i>
      NeoToggleComponent
    </h2>
    <p class="text-gray-600 mb-6">Touch-freundliche Toggle-Switches mit visueller Animation und Neo Brutalist Styling.</p>
    
    <!-- Basic Examples -->
    <div class="mb-8">
      <h3 class="text-lg font-semibold mb-4">Basic Usage</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-6 bg-gray-50 rounded border">
        <!-- Unchecked -->
        <%= render NeoToggleComponent.new(
          name: "example_toggle_1",
          label: "Enable Notifications",
          description: "Receive notifications in your inbox",
          interactive: true
        ) %>
        
        <!-- Checked -->
        <%= render NeoToggleComponent.new(
          name: "example_toggle_2", 
          checked: true,
          label: "Dark Mode",
          description: "Use dark theme for better visibility",
          interactive: true
        ) %>
      </div>
    </div>
    
    <!-- Sizes -->
    <div class="mb-8">
      <h3 class="text-lg font-semibold mb-4">Sizes</h3>
      <div class="flex items-center gap-8 p-6 bg-gray-50 rounded border">
        <%= render NeoToggleComponent.new(
          name: "small_toggle",
          size: :small,
          label: "Small Toggle",
          interactive: true
        ) %>
        
        <%= render NeoToggleComponent.new(
          name: "medium_toggle",
          size: :medium,
          checked: true,
          label: "Medium Toggle",
          interactive: true
        ) %>
        
        <%= render NeoToggleComponent.new(
          name: "large_toggle",
          size: :large,
          label: "Large Toggle",
          interactive: true
        ) %>
      </div>
    </div>
    
    <!-- States -->
    <div class="mb-8">
      <h3 class="text-lg font-semibold mb-4">States</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-6 bg-gray-50 rounded border">
        <%= render NeoToggleComponent.new(
          name: "disabled_toggle",
          disabled: true,
          label: "Disabled Toggle",
          description: "This toggle is disabled",
          interactive: false
        ) %>
        
        <%= render NeoToggleComponent.new(
          name: "disabled_checked_toggle",
          disabled: true,
          checked: true,
          label: "Disabled & Checked",
          description: "This toggle is disabled but checked",
          interactive: false
        ) %>
      </div>
    </div>
    
    <!-- Code Example -->
    <div class="bg-black text-lime-400 p-4 rounded font-mono text-sm overflow-x-auto">
      <pre>render NeoToggleComponent.new(
  name: "user_preferences[email_notifications]",
  checked: @user.email_notifications_enabled?,
  label: "Email Notifications", 
  description: "Receive updates via email",
  interactive: true
)</pre>
    </div>
  </div>
  
  <!-- NeoSelectComponent -->
  <div class="border-2 border-black rounded-lg bg-white p-8 mb-8 shadow-[2px_2px_0_0_#000000]">
    <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
      <i class="bi bi-caret-down-square text-cobalt-500"></i>
      NeoSelectComponent
    </h2>
    <p class="text-gray-600 mb-6">Dropdown-Selects mit custom Styling und Keyboard-Navigation.</p>
    
    <!-- Basic Examples -->
    <div class="mb-8">
      <h3 class="text-lg font-semibold mb-4">Basic Usage</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-6 bg-gray-50 rounded border">
        <%= render NeoSelectComponent.new(
          name: "frequency_select",
          label: "Notification Frequency",
          options: [
            ['Immediate', 'immediate'],
            ['Daily digest', 'daily'],
            ['Weekly digest', 'weekly'],
            ['Never', 'never']
          ],
          selected: 'daily',
          interactive: false
        ) %>
        
        <%= render NeoSelectComponent.new(
          name: "priority_select",
          label: "Priority Level",
          description: "Select the priority for this item",
          options: [
            ['High Priority', 'high'],
            ['Medium Priority', 'medium'],
            ['Low Priority', 'low']
          ],
          placeholder: "Choose priority...",
          interactive: false
        ) %>
      </div>
    </div>
    
    <!-- Sizes -->
    <div class="mb-8">
      <h3 class="text-lg font-semibold mb-4">Sizes</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 p-6 bg-gray-50 rounded border">
        <%= render NeoSelectComponent.new(
          name: "small_select",
          size: :small,
          label: "Small Select",
          options: [['Option A', 'a'], ['Option B', 'b']],
          interactive: false
        ) %>
        
        <%= render NeoSelectComponent.new(
          name: "medium_select",
          size: :medium,
          label: "Medium Select",
          options: [['Option A', 'a'], ['Option B', 'b']],
          interactive: false
        ) %>
        
        <%= render NeoSelectComponent.new(
          name: "large_select",
          size: :large,
          label: "Large Select",
          options: [['Option A', 'a'], ['Option B', 'b']],
          interactive: false
        ) %>
      </div>
    </div>
    
    <!-- States -->
    <div class="mb-8">
      <h3 class="text-lg font-semibold mb-4">States</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-6 bg-gray-50 rounded border">
        <%= render NeoSelectComponent.new(
          name: "required_select",
          required: true,
          label: "Required Select",
          options: [['Option A', 'a'], ['Option B', 'b']],
          placeholder: "Please select...",
          interactive: false
        ) %>
        
        <%= render NeoSelectComponent.new(
          name: "disabled_select",
          disabled: true,
          label: "Disabled Select",
          options: [['Option A', 'a'], ['Option B', 'b']],
          selected: 'a',
          interactive: false
        ) %>
      </div>
    </div>
    
    <!-- Code Example -->
    <div class="bg-black text-lime-400 p-4 rounded font-mono text-sm overflow-x-auto">
      <pre>render NeoSelectComponent.new(
  name: "notification[frequency]",
  label: "Email Frequency",
  options: [
    ['Immediate', 'immediate'],
    ['Daily digest', 'daily'],
    ['Weekly digest', 'weekly']
  ],
  selected: @notification.frequency,
  required: true,
  interactive: true
)</pre>
    </div>
  </div>
  
  <!-- NeoSegmentedRadioComponent -->
  <div class="border-2 border-black rounded-lg bg-white p-8 mb-8 shadow-[2px_2px_0_0_#000000]">
    <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
      <i class="bi bi-segmented-nav text-cobalt-500"></i>
      NeoSegmentedRadioComponent
    </h2>
    <p class="text-gray-600 mb-6">Segmentierte Radio-Button-Gruppen für exklusive Auswahl-Optionen mit zusammenhängendem Design.</p>

    <!-- Form-language rule: the form reveals the behavior -->
    <div class="mb-6 border-l-4 border-lime-400 bg-lime-50 p-4 rounded">
      <p class="text-sm font-semibold mb-1">Regel — die Form verrät das Verhalten (nicht die Farbe)</p>
      <ul class="text-sm text-gray-700 list-disc list-inside space-y-1">
        <li><strong>Single-Select</strong> (genau eins) → <strong>verbundenes Segment in Stadion-Form</strong> (voll gerundete Außenenden, geteilte Rahmen), aktiv = lime. Für 2–5 kurze, feste Optionen.</li>
        <li>Bei &gt;5 Optionen oder einer „Eigener…/Custom"-Escape → Segment für die Presets + <strong>abgesetzte Pill</strong> bzw. Dropdown daneben (Muster: ZEITRAUM-Filter).</li>
        <li><strong>Multi-Select</strong> (mehrere unabhängig) → <strong>getrennte Checkbox-Pills</strong>, NICHT dieses Segment.</li>
        <li>Die Aktiv-Farbe bleibt immer <strong>lime</strong>; die Unterscheidung kommt aus der <em>Form</em> (verbunden vs. getrennt), nicht aus neuen Farben.</li>
      </ul>
      <p class="text-xs text-gray-500 mt-2">Link-basierte Segmente (Navigation statt Form-Radio) nutzen dieselbe Optik via <code class="px-1 bg-white rounded">SegmentStylesHelper#segment_cell_classes</code>.</p>
    </div>

    <!-- Basic Examples -->
    <div class="mb-8">
      <h3 class="text-lg font-semibold mb-4">Basic Usage</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-6 bg-gray-50 rounded border">
        <!-- With Icons -->
        <%= render NeoSegmentedRadioComponent.new(
          name: "view_mode",
          options: [
            ['Chronologisch', 'chronological', 'list-ul'],
            ['Gruppiert', 'grouped', 'collection']
          ],
          selected: 'chronological',
          size: :medium,
          data: { controller: 'example', action: 'change->example#update' }
        ) %>
        
        <!-- Without Icons -->
        <%= render NeoSegmentedRadioComponent.new(
          name: "sort_order",
          options: [
            ['Neueste', 'newest'],
            ['Älteste', 'oldest'],
            ['Alphabetisch', 'alpha']
          ],
          selected: 'newest',
          size: :medium
        ) %>
      </div>
    </div>
    
    <!-- Sizes -->
    <div class="mb-8">
      <h3 class="text-lg font-semibold mb-4">Sizes</h3>
      <div class="space-y-4 p-6 bg-gray-50 rounded border">
        <!-- Small -->
        <div>
          <p class="text-xs text-gray-600 mb-2">Small Size</p>
          <%= render NeoSegmentedRadioComponent.new(
            name: "size_small",
            options: [
              ['Option A', 'a'],
              ['Option B', 'b'],
              ['Option C', 'c']
            ],
            selected: 'a',
            size: :small
          ) %>
        </div>
        
        <!-- Medium -->
        <div>
          <p class="text-xs text-gray-600 mb-2">Medium Size (Default)</p>
          <%= render NeoSegmentedRadioComponent.new(
            name: "size_medium",
            options: [
              ['Option A', 'a'],
              ['Option B', 'b'],
              ['Option C', 'c']
            ],
            selected: 'b',
            size: :medium
          ) %>
        </div>
        
        <!-- Large -->
        <div>
          <p class="text-xs text-gray-600 mb-2">Large Size</p>
          <%= render NeoSegmentedRadioComponent.new(
            name: "size_large",
            options: [
              ['Option A', 'a'],
              ['Option B', 'b'],
              ['Option C', 'c']
            ],
            selected: 'c',
            size: :large
          ) %>
        </div>
      </div>
    </div>
    
    <!-- With Shadow -->
    <div class="mb-8">
      <h3 class="text-lg font-semibold mb-4">With Neo Brutalist Shadow</h3>
      <div class="flex items-center gap-8 p-6 bg-gray-50 rounded border">
        <!-- Without Shadow (Default) -->
        <div>
          <p class="text-xs text-gray-600 mb-2">Without Shadow</p>
          <%= render NeoSegmentedRadioComponent.new(
            name: "shadow_none",
            options: [
              ['Active', 'active', 'check-circle'],
              ['Inactive', 'inactive', 'x-circle']
            ],
            selected: 'active',
            with_shadow: false
          ) %>
        </div>
        
        <!-- With Shadow -->
        <div>
          <p class="text-xs text-gray-600 mb-2">With Shadow</p>
          <%= render NeoSegmentedRadioComponent.new(
            name: "shadow_yes",
            options: [
              ['Active', 'active', 'check-circle'],
              ['Inactive', 'inactive', 'x-circle']
            ],
            selected: 'active',
            with_shadow: true
          ) %>
        </div>
      </div>
    </div>
    
    <!-- Real-World Examples -->
    <div class="mb-8">
      <h3 class="text-lg font-semibold mb-4">Real-World Examples</h3>
      <div class="space-y-4 p-6 bg-gray-50 rounded border">
        <!-- Time Range -->
        <div>
          <label class="block text-sm font-medium mb-2">Zeitraum</label>
          <%= render NeoSegmentedRadioComponent.new(
            name: "time_range",
            options: [
              ['Heute', 'today', 'calendar-day'],
              ['Woche', 'week', 'calendar-week'],
              ['Monat', 'month', 'calendar-month'],
              ['Jahr', 'year', 'calendar']
            ],
            selected: 'week',
            size: :medium
          ) %>
        </div>
        
        <!-- Priority -->
        <div>
          <label class="block text-sm font-medium mb-2">Priorität</label>
          <%= render NeoSegmentedRadioComponent.new(
            name: "priority",
            options: [
              ['Niedrig', 'low'],
              ['Mittel', 'medium'],
              ['Hoch', 'high'],
              ['Kritisch', 'critical']
            ],
            selected: 'medium',
            size: :medium
          ) %>
        </div>
        
        <!-- View Type -->
        <div>
          <label class="block text-sm font-medium mb-2">Ansicht</label>
          <%= render NeoSegmentedRadioComponent.new(
            name: "view_type",
            options: [
              ['Liste', 'list', 'list'],
              ['Kacheln', 'grid', 'grid-3x3-gap'],
              ['Kanban', 'kanban', 'kanban']
            ],
            selected: 'list',
            size: :medium
          ) %>
        </div>
      </div>
    </div>
    
    <!-- Code Example -->
    <div class="bg-black text-lime-400 p-4 rounded font-mono text-sm overflow-x-auto">
      <pre>render NeoSegmentedRadioComponent.new(
  name: 'view_mode',
  options: [
    ['Chronologisch', 'chronological', 'list-ul'],
    ['Gruppiert', 'grouped', 'collection']
  ],
  selected: current_view_mode,
  size: :medium,
  with_shadow: false,
  data: { 
    action: 'change->filter#submitForm' 
  }
)</pre>
    </div>
  </div>
  
  <!-- NeoFormSectionComponent -->
  <div class="border-2 border-black rounded-lg bg-white p-8 mb-8 shadow-[2px_2px_0_0_#000000]">
    <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
      <i class="bi bi-layout-text-window-reverse text-purple-500"></i>
      NeoFormSectionComponent
    </h2>
    <p class="text-gray-600 mb-6">Collapsible form sections for better organization and user experience.</p>
    
    <!-- Basic Example -->
    <div class="mb-8">
      <h3 class="text-lg font-semibold mb-4">Basic Usage</h3>
      <div class="space-y-4">
        <%= render NeoFormSectionComponent.new(
          title: "Account Settings",
          description: "Manage your account preferences and security settings",
          icon: "person-gear"
        ) do %>
          <div class="space-y-4">
            <%= render NeoToggleComponent.new(
              name: "account[two_factor]",
              label: "Two-Factor Authentication",
              description: "Add an extra layer of security to your account",
              interactive: false
            ) %>
            
            <%= render NeoSelectComponent.new(
              name: "account[language]",
              label: "Language",
              options: [['English', 'en'], ['German', 'de'], ['French', 'fr']],
              selected: 'en',
              interactive: false
            ) %>
          </div>
        <% end %>
        
        <%= render NeoFormSectionComponent.new(
          title: "Notification Preferences",
          description: "Choose how you want to be notified",
          icon: "bell",
          variant: :primary,
          expanded: false
        ) do %>
          <div class="space-y-4">
            <%= render NeoToggleComponent.new(
              name: "notifications[email]",
              checked: true,
              label: "Email Notifications",
              interactive: false
            ) %>
            
            <%= render NeoToggleComponent.new(
              name: "notifications[push]",
              label: "Push Notifications",
              interactive: false
            ) %>
          </div>
        <% end %>
      </div>
    </div>
    
    <!-- Variants -->
    <div class="mb-8">
      <h3 class="text-lg font-semibold mb-4">Variants</h3>
      <div class="space-y-4">
        <% [
          { variant: :default, title: "Default Section", icon: "gear" },
          { variant: :primary, title: "Primary Section", icon: "star" },
          { variant: :warning, title: "Warning Section", icon: "exclamation-triangle" },
          { variant: :danger, title: "Danger Section", icon: "x-circle" },
          { variant: :success, title: "Success Section", icon: "check-circle" }
        ].each do |config| %>
          <%= render NeoFormSectionComponent.new(
            title: config[:title],
            variant: config[:variant],
            icon: config[:icon],
            collapsible: false,
            size: :small
          ) do %>
            <p class="text-sm text-gray-600">This is a <%= config[:variant] %> section variant.</p>
          <% end %>
        <% end %>
      </div>
    </div>
    
    <!-- Code Example -->
    <div class="bg-black text-lime-400 p-4 rounded font-mono text-sm overflow-x-auto">
      <pre>render NeoFormSectionComponent.new(
  title: "Critical Notifications",
  description: "High-priority events you shouldn't miss",
  icon: "exclamation-triangle",
  variant: :warning,
  expanded: true
) do
  # Form content goes here
  render NeoToggleComponent.new(...)
end</pre>
    </div>
  </div>
  
  <!-- Best Practices -->
  <div class="border-2 border-black rounded-lg bg-lime-50 p-8 shadow-[2px_2px_0_0_#000000]">
    <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
      <i class="bi bi-lightbulb text-yellow-500"></i>
      Best Practices
    </h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <h3 class="font-semibold mb-2 text-green-800">✅ Do</h3>
        <ul class="text-sm space-y-2 text-green-700">
          <li>• Use descriptive labels and descriptions</li>
          <li>• Group related form fields in sections</li>
          <li>• Provide immediate visual feedback</li>
          <li>• Use appropriate sizes for different contexts</li>
          <li>• Enable interactive mode for production forms</li>
          <li>• Test keyboard navigation and accessibility</li>
        </ul>
      </div>
      
      <div>
        <h3 class="font-semibold mb-2 text-red-800">❌ Don't</h3>
        <ul class="text-sm space-y-2 text-red-700">
          <li>• Use vague or ambiguous labels</li>
          <li>• Create overly complex nested forms</li>
          <li>• Forget to handle disabled states</li>
          <li>• Mix different component sizes inconsistently</li>
          <li>• Ignore mobile responsiveness</li>
          <li>• Skip form validation</li>
        </ul>
      </div>
    </div>
  </div>
  
  <!-- Integration Examples -->
  <div class="border-2 border-black rounded-lg bg-white p-8 mt-8 shadow-[2px_2px_0_0_#000000]">
    <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
      <i class="bi bi-puzzle text-cobalt-500"></i>
      Integration Example
    </h2>
    <p class="text-gray-600 mb-6">Complete form using all components together (from Notification Preferences)</p>
    
    <div class="bg-gray-50 p-6 rounded border">
      <%= render NeoFormSectionComponent.new(
        title: "🔔 Critical Notifications",
        description: "High-priority events you shouldn't miss",
        variant: :warning,
        expanded: true,
        size: :small
      ) do %>
        <div class="preference-row grid grid-cols-1 md:grid-cols-3 gap-4 p-4 border border-gray-200 rounded bg-white">
          <div class="event-info">
            <h4 class="font-semibold text-gray-900 mb-1">Mentions</h4>
            <p class="text-xs text-gray-600">When you are mentioned in comments</p>
          </div>
          
          <div class="channel-settings">
            <%= render NeoToggleComponent.new(
              name: "demo[mention][in_app]",
              checked: true,
              label: "In-App",
              description: "Show in notification center",
              size: :small,
              interactive: false
            ) %>
          </div>
          
          <div class="channel-settings">
            <%= render NeoToggleComponent.new(
              name: "demo[mention][email]",
              checked: true,
              label: "Email",
              description: "Send to your email",
              size: :small,
              interactive: false
            ) %>
            
            <div class="mt-2">
              <%= render NeoSelectComponent.new(
                name: "demo[mention][frequency]",
                label: "Frequency",
                options: [
                  ['Immediate', 'immediate'],
                  ['Daily', 'daily'],
                  ['Weekly', 'weekly']
                ],
                selected: 'immediate',
                size: :small,
                interactive: false
              ) %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
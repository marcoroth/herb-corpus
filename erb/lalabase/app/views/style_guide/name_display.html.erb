<%#
  Name display: avatar chip + spelling.
  Canonical source of the rules: docs/dokumentation/namensanzeige_flaechenregister.md
  Code samples come from StyleGuideController::NAME_DISPLAY_SAMPLES: the register
  guard turns a raw name under app/views red, and showing that is the point here.
%>
<% sizes = Neo::Users::AvatarComponent::SIZES
   modes = User::PreferenceStore::NAME_DISPLAY_MODES
   default_mode = User::PreferenceStore::NAME_DISPLAY_DEFAULT

   size_usage = {
     xs: { px: "20px", where: "Attributzeilen: Ticket-Kopf, Listenzeilen, Modal-Vorschau" },
     small: { px: "26px", where: "Kommentare und Pillen" },
     medium: { px: "32px", where: "Team-Listen und Einstellungen" }
   } %>

<div class="container mx-auto px-8 py-8 max-w-7xl">

  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-4xl font-black text-black uppercase mb-2">Namensanzeige</h1>
    <p class="text-gray-600">Wie ein Nutzer dargestellt wird: das Bild zeigt immer, die Einstellung schreibt nur den Namen</p>
    <div class="mt-3 flex flex-wrap gap-2 text-xs">
      <span class="px-2 py-1 rounded bg-gray-100 font-mono">Neo::Users::AvatarComponent</span>
      <span class="px-2 py-1 rounded bg-gray-100 font-mono">Neo::Users::NameComponent</span>
      <span class="px-2 py-1 rounded bg-gray-100 font-mono">viewer_user_chip</span>
      <span class="px-2 py-1 rounded bg-gray-100 font-mono">viewer_user_list</span>
    </div>
  </div>

  <!-- The model -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Das Modell</h2>

    <div class="border-2 border-black rounded-lg bg-yellow-50 p-6 mb-6 shadow-[2px_2px_0_0_#000000]">
      <p class="font-bold mb-2">Das Bild ist kein Modus. Es gehört dem dargestellten Nutzer und erscheint an Identitätsstellen <span class="uppercase">immer</span>.</p>
      <ul class="space-y-1 ml-4 text-sm">
        <li class="flex items-start">
          <i class="bi bi-check-circle-fill text-green-500 mr-2 mt-0.5 flex-shrink-0"></i>
          <span><strong>Betrachter-Prinzip:</strong> Die Einstellung des <em>angemeldeten</em> Nutzers bestimmt, wie Namen für ihn geschrieben werden. Nicht die Einstellung des Dargestellten.</span>
        </li>
        <li class="flex items-start">
          <i class="bi bi-check-circle-fill text-green-500 mr-2 mt-0.5 flex-shrink-0"></i>
          <span><strong>Eine Form überall:</strong> das Quadrat mit 5px-Ecke. Ein Kreis wäre auf den meisten Screens die einzige runde Form.</span>
        </li>
        <li class="flex items-start">
          <i class="bi bi-check-circle-fill text-green-500 mr-2 mt-0.5 flex-shrink-0"></i>
          <span><strong>Foto gewinnt, Initialen fangen auf:</strong> ohne hochgeladenes Bild zeichnet der Chip die Initialen, nie nichts.</span>
        </li>
        <li class="flex items-start">
          <i class="bi bi-x-circle-fill text-red-500 mr-2 mt-0.5 flex-shrink-0"></i>
          <span><strong>Kein externer Dienst:</strong> Namen von Nutzern verlassen die Anwendung nicht, um ein Bild zu erzeugen.</span>
        </li>
      </ul>
      <p class="text-sm text-gray-600 mt-4">Vorbild ist Slack. Kanonische Quelle mit allen Flächen und Ausnahmen: <code class="px-1 py-0.5 bg-gray-100 rounded text-xs">docs/dokumentation/namensanzeige_flaechenregister.md</code></p>
    </div>

    <%= render "style_guide/shared/rationale",
        title: "Warum getrennt",
        body: "Bild und Schreibweise waren bis 05.09.2026 <strong>ein</strong> Schalter: wer „Kreis“ wählte, bekam ein Bild und verlor den Namen. Das beantwortete zwei Fragen mit einer Antwort. Ein Bild ist aber keine Schreibweise eines Namens. Seit der Trennung zeigt das Bild immer, und die Einstellung entscheidet nur noch über den Text daneben." %>
  </section>

  <!-- The three sizes -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Größen</h2>
    <p class="text-gray-600 mb-6">Drei Stufen, nach Fläche gewählt. Die Liste kommt aus <code class="px-1 py-0.5 bg-gray-100 rounded text-xs">AvatarComponent::SIZES</code> und wächst mit ihr.</p>

    <div class="border-2 border-black rounded-lg bg-white p-6 shadow-[2px_2px_0_0_#000000]">
      <div class="space-y-5">
        <% sizes.each_key do |size| %>
          <% usage = size_usage[size] %>
          <div class="flex items-center gap-5 flex-wrap">
            <div class="w-12 flex justify-center">
              <%= render Neo::Users::AvatarComponent.new(user: @demo_user, size: size) %>
            </div>
            <div class="min-w-0">
              <p class="font-bold text-sm">
                <code class="px-1 py-0.5 bg-gray-100 rounded text-xs">:<%= size %></code>
                <% if usage %>
                  <span class="text-gray-500 font-normal ml-1"><%= usage[:px] %></span>
                <% end %>
              </p>
              <% if usage %>
                <p class="text-sm text-gray-600"><%= usage[:where] %></p>
              <% else %>
                <p class="text-sm text-red-600">Neue Größe ohne Eintrag auf dieser Seite. Verwendungszweck in <code class="px-1 py-0.5 bg-gray-100 rounded text-xs">name_display.html.erb</code> ergänzen.</p>
              <% end %>
              <p class="text-xs text-gray-400 font-mono mt-0.5"><%= sizes[size] %></p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- The three spellings -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Schreibweisen</h2>
    <p class="text-gray-600 mb-6">Das ist der ganze Umfang der Einstellung. Die Liste kommt aus <code class="px-1 py-0.5 bg-gray-100 rounded text-xs">User::PreferenceStore::NAME_DISPLAY_MODES</code>, die Beschriftungen aus denselben Locale-Keys, die die Einstellungsseite rendert. Beides kann hier nicht abweichen.</p>

    <div class="border-2 border-black rounded-lg bg-white p-6 shadow-[2px_2px_0_0_#000000] mb-6">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b-2 border-black text-left">
            <th class="pb-2 font-black uppercase text-xs">Modus</th>
            <th class="pb-2 font-black uppercase text-xs">Kurzer Name</th>
            <th class="pb-2 font-black uppercase text-xs">Langer Name</th>
          </tr>
        </thead>
        <tbody>
          <% modes.each do |mode| %>
            <tr class="border-b border-gray-200 last:border-0">
              <td class="py-3 pr-4 align-top">
                <code class="px-1 py-0.5 bg-gray-100 rounded text-xs"><%= mode %></code>
                <% if mode == default_mode %>
                  <span class="ml-1 px-1.5 py-0.5 rounded text-[10px] font-bold bg-black text-white">Standard</span>
                <% end %>
                <%# The label the user actually reads in Settings, not a second wording of it. %>
                <% mode_label = t("user_preferences.edit.display.name_display.#{mode}", default: nil) %>
                <% if mode_label %>
                  <p class="text-xs text-gray-500 mt-1"><%= mode_label %></p>
                <% else %>
                  <p class="text-xs text-red-600 mt-1">Kein Locale-Eintrag unter <code class="px-1 py-0.5 bg-gray-100 rounded">user_preferences.edit.display.name_display.<%= mode %></code>. Die Einstellungsseite zeigt diesen Modus ohne Beschriftung an.</p>
                <% end %>
              </td>
              <td class="py-3 pr-4 align-top">
                <span class="inline-flex items-center gap-1.5">
                  <%= render Neo::Users::AvatarComponent.new(user: @demo_user, size: :small) %>
                  <%= render Neo::Users::NameComponent.new(user: @demo_user, mode: mode) %>
                </span>
              </td>
              <td class="py-3 align-top">
                <span class="inline-flex items-center gap-1.5">
                  <%= render Neo::Users::AvatarComponent.new(user: @demo_long_name, size: :small) %>
                  <%= render Neo::Users::NameComponent.new(user: @demo_long_name, mode: mode) %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="border-2 border-black rounded-lg bg-white p-6 shadow-[2px_2px_0_0_#000000]">
      <p class="font-bold mb-2">Der volle Name bleibt erreichbar.</p>
      <p class="text-sm text-gray-600">Jede abgekürzte Schreibweise trägt den ungekürzten Namen im <code class="px-1 py-0.5 bg-gray-100 rounded text-xs">title</code>-Attribut. Wer den Zeiger auf einen Namen hält, liest ihn ganz. Fahre über die Namen in der Tabelle darüber.</p>
    </div>
  </section>

  <!-- The pair -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Das Paar</h2>
    <p class="text-gray-600 mb-6">An einer Identitätsstelle gehören Bild und Name zusammen. Dafür gibt es einen Helfer, damit die beiden Teile nicht an jeder Stelle neu von Hand verheiratet werden. Für eine Gruppe von Personen gibt es einen zweiten, der die Dichte selbst entscheidet.</p>

    <div class="border-2 border-black rounded-lg bg-white p-6 shadow-[2px_2px_0_0_#000000] mb-4">
      <p class="text-xs font-black uppercase text-gray-500 mb-3">Einer</p>
      <div class="mb-5"><%= viewer_user_chip(@demo_user) %></div>

      <p class="text-xs font-black uppercase text-gray-500 mb-3">Gruppe mit einer Person</p>
      <div class="mb-5"><%= viewer_user_list([@demo_user]) %></div>

      <p class="text-xs font-black uppercase text-gray-500 mb-3">Gruppe mit mehreren</p>
      <div class="mb-5"><%= viewer_user_list([@demo_single_name, @demo_user, @demo_long_name]) %></div>

      <p class="text-xs font-black uppercase text-gray-500 mb-3">Im Satz</p>
      <p class="text-sm">Zugewiesen von <%= viewer_display_name(@demo_user) %> am 06.09.2026.</p>
    </div>

    <div class="border-l-4 border-black bg-gray-50 rounded-r px-4 py-3 mb-4">
      <p class="text-sm text-gray-700"><strong>Die Gruppe ist adaptiv.</strong> Eine Person bekommt Bild und Name, mehrere nur die Bilder, der Name steht im Hover-Titel. Zwei Namen passen in keine Zuweisungsspalte, zwei Bilder schon. Und die Gruppe ist sortiert: wer sie betrachtet, steht selbst vorn, danach alphabetisch. Die Demos hier sind nicht du, deshalb siehst du nur den zweiten Teil der Regel.</p>
    </div>

    <div class="border-l-4 border-black bg-gray-50 rounded-r px-4 py-3">
      <p class="text-sm text-gray-700">Diese Demos rendern in <strong>deiner</strong> Schreibweise, weil kein Modus fest verdrahtet ist. Die Tabelle darüber pinnt jeden Modus ausdrücklich, sonst zeigte sie dreimal dasselbe.</p>
    </div>
  </section>

  <!-- Edges -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Kanten</h2>
    <p class="text-gray-600 mb-6">Nicht jeder Nutzer hat zwei Namensteile, und nicht jeder Autor existiert noch. Keine dieser Lagen darf eine Zeile verrutschen lassen.</p>

    <div class="grid gap-4 md:grid-cols-2">
      <div class="border-2 border-black rounded-lg bg-white p-5 shadow-[2px_2px_0_0_#000000]">
        <p class="font-bold text-sm mb-3">Nur ein Namensteil</p>
        <div class="mb-3"><%= viewer_user_chip(@demo_single_name) %></div>
        <p class="text-sm text-gray-600">Abkürzen braucht zwei Teile. Gibt es nur einen, steht er in jedem Modus ganz da.</p>
      </div>

      <div class="border-2 border-black rounded-lg bg-white p-5 shadow-[2px_2px_0_0_#000000]">
        <p class="font-bold text-sm mb-3">Gar kein Name</p>
        <div class="mb-3"><%= viewer_user_chip(@demo_nameless) %></div>
        <p class="text-sm text-gray-600">Rückfall auf den Teil der E-Mail vor dem @. Ein Nutzer ohne Namen bleibt ansprechbar.</p>
      </div>

      <div class="border-2 border-black rounded-lg bg-white p-5 shadow-[2px_2px_0_0_#000000]">
        <p class="font-bold text-sm mb-3">Gelöschter Autor</p>
        <div class="mb-3"><%= viewer_user_chip(nil) %></div>
        <p class="text-sm text-gray-600">Der Chip bleibt leer stehen, statt zu verschwinden. Sonst rutschte die Textspalte dieser Zeile unter den Zeilen darüber weg.</p>
      </div>

      <div class="border-2 border-black rounded-lg bg-white p-5 shadow-[2px_2px_0_0_#000000]">
        <p class="font-bold text-sm mb-3">Kein Mensch</p>
        <div class="mb-3">
          <span class="inline-flex items-center gap-1.5">
            <%= render Neo::Users::AvatarComponent.new(user: nil, size: :small, fallback_initials: "S") %>
            <span class="text-sm">Systemmeldung</span>
          </span>
        </div>
        <p class="text-sm text-gray-600">Mit <code class="px-1 py-0.5 bg-gray-100 rounded text-xs">fallback_initials:</code> zeichnet der Chip vorgegebene Buchstaben. So markiert die Benachrichtigungsliste Ereignisse ohne Urheber.</p>
      </div>
    </div>
  </section>

  <!-- The picture -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Das Bild</h2>
    <p class="text-gray-600 mb-6">Alle Chips auf dieser Seite zeigen Initialen: die Demo-Objekte sind nicht gespeichert und können deshalb kein Bild tragen. Der Foto-Pfad hat drei Regeln, die sich sonst rächen.</p>

    <div class="space-y-4">
      <div class="border-2 border-black rounded-lg bg-white p-5 shadow-[2px_2px_0_0_#000000]">
        <p class="font-bold text-sm mb-1">Die Thumb-Variante, über den eigenen Server</p>
        <p class="text-sm text-gray-600">Der Chip lädt <code class="px-1 py-0.5 bg-gray-100 rounded text-xs">avatar.variant(:thumb)</code> über <code class="px-1 py-0.5 bg-gray-100 rounded text-xs">rails_storage_proxy_path</code>. Nie das Original, nie eine fremde Adresse.</p>
      </div>

      <div class="border-2 border-red-500 rounded-lg bg-red-50 p-5">
        <p class="font-bold text-sm mb-1">Ein schwebender Anhang ist noch kein Bild</p>
        <p class="text-sm text-gray-700"><code class="px-1 py-0.5 bg-white rounded text-xs">attached?</code> ist auch dann wahr, wenn der Nutzer gerade eine Datei gewählt hat und das Formular danach scheiterte, etwa wegen eines falschen Passworts. Gespeichert ist nichts, und die Signatur eines solchen Anhangs wirft. Ohne die Prüfung auf <code class="px-1 py-0.5 bg-white rounded text-xs">persisted?</code> antwortet genau die Seite mit einem Fehler, die den Hinweis auf den Fehler zeigen soll. Der ehrliche Rückfall sind die Initialen.</p>
      </div>

      <div class="border-2 border-black rounded-lg bg-white p-5 shadow-[2px_2px_0_0_#000000]">
        <p class="font-bold text-sm mb-1">Listen brauchen ein Preload</p>
        <p class="text-sm text-gray-600 mb-2">Jede Schleife, die Chips zeichnet, fragt sonst pro Nutzer erneut die Datenbank.</p>
        <pre class="bg-gray-900 text-gray-100 p-3 rounded text-xs overflow-x-auto whitespace-pre-wrap break-words"><code><%= @samples[:preload] %></code></pre>
      </div>
    </div>
  </section>

  <!-- Usage -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Verwendung</h2>
    <p class="text-gray-600 mb-6">Drei Nahtstellen decken alles ab. Was an ihnen vorbeigeht, nimmt an der Einstellung nicht teil, und niemand merkt es: die Seite rendert, nur der Name ist der falsche.</p>

    <div class="grid gap-4 md:grid-cols-2 mb-6">
      <div class="border-2 border-green-600 rounded-lg bg-green-50 p-5">
        <p class="font-black uppercase text-xs text-green-800 mb-3">So</p>
        <div class="space-y-3">
          <div>
            <p class="text-xs text-gray-600 mb-1">Identitätsstelle, Bild und Name</p>
            <pre class="bg-gray-900 text-gray-100 p-3 rounded text-xs overflow-x-auto whitespace-pre-wrap break-words"><code><%= @samples[:pair] %></code></pre>
          </div>
          <div>
            <p class="text-xs text-gray-600 mb-1">Eine Gruppe von Nutzern: Paar bei einer Person, Chips bei mehreren, Betrachter zuerst</p>
            <pre class="bg-gray-900 text-gray-100 p-3 rounded text-xs overflow-x-auto whitespace-pre-wrap break-words"><code><%= @samples[:list] %></code></pre>
          </div>
          <div>
            <p class="text-xs text-gray-600 mb-1">Ein Name mitten im Satz</p>
            <pre class="bg-gray-900 text-gray-100 p-3 rounded text-xs overflow-x-auto whitespace-pre-wrap break-words"><code><%= @samples[:prose] %></code></pre>
          </div>
          <div>
            <p class="text-xs text-gray-600 mb-1">Nur das Bild</p>
            <pre class="bg-gray-900 text-gray-100 p-3 rounded text-xs overflow-x-auto whitespace-pre-wrap break-words"><code><%= @samples[:picture_only] %></code></pre>
          </div>
        </div>
      </div>

      <div class="border-2 border-red-500 rounded-lg bg-red-50 p-5">
        <p class="font-black uppercase text-xs text-red-700 mb-3">Nicht so</p>
        <div class="space-y-3">
          <div>
            <pre class="bg-gray-900 text-gray-100 p-3 rounded text-xs overflow-x-auto whitespace-pre-wrap break-words"><code><%= @samples[:raw_name] %></code></pre>
            <p class="text-xs text-gray-700 mt-1">Umgeht die Einstellung vollständig.</p>
          </div>
          <div>
            <pre class="bg-gray-900 text-gray-100 p-3 rounded text-xs overflow-x-auto whitespace-pre-wrap break-words"><code><%= @samples[:raw_display_name] %></code></pre>
            <p class="text-xs text-gray-700 mt-1">Ohne Modus ist es immer der volle Name, egal was der Betrachter eingestellt hat.</p>
          </div>
          <div>
            <pre class="bg-gray-900 text-gray-100 p-3 rounded text-xs overflow-x-auto whitespace-pre-wrap break-words"><code><%= @samples[:external_avatar] %></code></pre>
            <p class="text-xs text-gray-700 mt-1">Schickt den Namen eines Nutzers an einen fremden Dienst. Aus dieser Anwendung entfernt.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="border-2 border-black rounded-lg bg-white p-5 shadow-[2px_2px_0_0_#000000]">
      <p class="font-bold text-sm mb-2">Einen Modus festnageln</p>
      <p class="text-sm text-gray-600 mb-2">Nur dort richtig, wo die Schreibweise selbst das Thema ist: in der Vorschau der Einstellungen, und in der Tabelle weiter oben auf dieser Seite. Überall sonst entscheidet der Betrachter.</p>
      <pre class="bg-gray-900 text-gray-100 p-3 rounded text-xs overflow-x-auto whitespace-pre-wrap break-words"><code><%= @samples[:pinned_mode] %></code></pre>
    </div>
  </section>

  <!-- Safeguards -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Absicherung</h2>

    <div class="border-2 border-black rounded-lg bg-white p-6 shadow-[2px_2px_0_0_#000000]">
      <p class="text-sm text-gray-600 mb-4">Die Regel steht nicht nur hier. Ein Wächter-Spec liest alle Views und Komponenten und macht die CI rot, sobald ein Name an den Nahtstellen vorbei gerendert wird.</p>
      <div class="flex flex-wrap gap-2 mb-4">
        <span class="px-2 py-1 rounded text-xs font-mono bg-gray-100">spec/views/name_display_register_guard_spec.rb</span>
        <span class="px-2 py-1 rounded text-xs font-mono bg-gray-100">docs/dokumentation/namensanzeige_flaechenregister.md</span>
      </div>
      <p class="text-sm text-gray-600">Eine bewusste Ausnahme, etwa in Mailern ohne Betrachter, braucht beides: einen Eintrag in der Allowlist des Wächters <strong>mit Begründung</strong> und eine Zeile im Register.</p>

      <%= render "style_guide/shared/rationale",
          title: "Warum ein Wächter",
          body: "Nach dem Ausrollen kamen zwei Meldungen derselben Art: „der Kreis tut hier nichts“. Beide Male war eine einzelne Stelle an der Nahtstelle vorbeigewachsen. Das fällt beim Lesen nicht auf, weil die Seite normal aussieht. Eine Regel, die man nur einhalten kann, indem man an sie denkt, wird irgendwann gebrochen." %>
    </div>
  </section>

  <!-- Related -->
  <div class="border-t-2 border-black pt-6 flex flex-wrap gap-3">
    <%= link_to style_guide_activities_path, class: "text-sm font-medium text-cobalt-600 hover:underline" do %>
      <i class="bi bi-arrow-right-circle mr-1"></i>Activities
    <% end %>
    <%= link_to style_guide_tags_path, class: "text-sm font-medium text-cobalt-600 hover:underline" do %>
      <i class="bi bi-arrow-right-circle mr-1"></i>Tags
    <% end %>
    <%= link_to style_guide_changelog_path, class: "text-sm font-medium text-cobalt-600 hover:underline" do %>
      <i class="bi bi-arrow-right-circle mr-1"></i>Changelog
    <% end %>
  </div>
</div>

<!-- Basic Variants -->
<section class="mb-12">
  <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Varianten</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="space-y-4">
      <h3 class="font-bold mb-2">Standard Varianten</h3>
      <div class="flex flex-wrap gap-3">
        <%= render Neo::Buttons::ButtonComponent.new(variant: :primary) do %>Primary<% end %>
        <%= render Neo::Buttons::ButtonComponent.new(variant: :secondary) do %>Secondary<% end %>
        <%= render Neo::Buttons::ButtonComponent.new(variant: :danger) do %>Danger<% end %>
        <%= render Neo::Buttons::ButtonComponent.new(variant: :edit) do %>Edit<% end %>
        <%= render Neo::Buttons::ButtonComponent.new(variant: :ghost) do %>Ghost<% end %>
      </div>

      <h3 class="font-bold mb-2 mt-6">Spezial-Varianten</h3>
      <div class="flex flex-wrap gap-3">
        <%= render Neo::Buttons::ButtonComponent.new(variant: :warning, icon: "exclamation-triangle") do %>Warning<% end %>
        <%= render Neo::Buttons::ButtonComponent.new(variant: :info, icon: "clock") do %>Info<% end %>
        <%= render Neo::Buttons::ButtonComponent.new(variant: :ai, icon: "magic") do %>AI<% end %>
        <%= render Neo::Buttons::IconButtonComponent.new(variant: :plain, icon: "x-lg", class: "opacity-50 hover:opacity-100") %>
      </div>
      <p class="text-sm text-gray-600 mt-2">
        <strong>warning</strong> (gelb) &mdash; Warnung / reversibler Zustandswechsel (z.B. Archivieren); <em>nicht</em> Chat &middot;
        <strong>info</strong> (blau) &mdash; Daten/Info (z.B. Zeit-Buttons) &middot;
        <strong>ai</strong> (lila) &mdash; KI-Features &middot;
        <strong>plain</strong> (transparent) &mdash; Modal-Close-Buttons
      </p>
    </div>

    <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;%= render Neo::Buttons::ButtonComponent.new(variant: :primary) do %&gt;
  Primary
&lt;% end %&gt;

&lt;!-- Spezial-Varianten --&gt;
&lt;%= render Neo::Buttons::ButtonComponent.new(variant: :warning, icon: "exclamation-triangle") do %&gt;
  Warnung
&lt;% end %&gt;

&lt;%= render Neo::Buttons::ButtonComponent.new(variant: :ai, icon: "magic") do %&gt;
  Zusammenfassung
&lt;% end %&gt;

&lt;%= render Neo::Buttons::IconButtonComponent.new(
  variant: :plain, icon: "x-lg",
  class: "opacity-50 hover:opacity-100"
) %&gt;</code></pre>
  </div>

  <%= render 'style_guide/shared/rationale',
        principles: ["P2"],
        body: "Jede Farbe ist einer <strong>Bedeutungsdomäne</strong> zugeordnet, damit man den Aktionstyp am Farbton erkennt, nicht erst am Text: <strong>lime</strong> = die eine Hauptaktion, <strong>weiß</strong> = neutrale Zweitaktion, <strong>rot</strong> = destruktiv, <strong>gelb</strong> = weiche Aufmerksamkeit (Chat), <strong>cobalt</strong> = Daten/Info, <strong>lila</strong> = KI. Die Hierarchie zwischen gleichrangigen Buttons trägt damit die Farbe &mdash; nicht der Schatten (der bleibt für „steht auf der Fläche“ reserviert, P1)." %>
</section>
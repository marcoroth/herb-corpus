<!-- Interactive Examples -->
<section class="mb-12">
  <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Interaktive Beispiele</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="space-y-4">
      <h3 class="font-bold mb-2">Mit Bestätigung</h3>
      <div class="flex flex-wrap gap-3">
        <%= render Neo::Buttons::ButtonComponent.new(
          variant: :danger,
          icon: "trash",
          interactive: true,
          confirm: "Möchten Sie diesen Eintrag wirklich löschen? Diese Aktion kann nicht rückgängig gemacht werden."
        ) do %>
          Löschen mit Bestätigung
        <% end %>
      </div>
      
      <h3 class="font-bold mb-2 mt-6">Click Handler</h3>
      <div class="flex flex-wrap gap-3">
        <%= render Neo::Buttons::ButtonComponent.new(
          variant: :primary,
          interactive: true,
          onclick: "alert('Button wurde geklickt!'); return false;"
        ) do %>
          Klick mich!
        <% end %>
      </div>
    </div>
    
    <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;%= render Neo::Buttons::ButtonComponent.new(
  variant: :danger,
  icon: "trash",
  interactive: true,
  confirm: "Wirklich löschen?"
) do %&gt;
  Löschen
&lt;% end %&gt;</code></pre>
  </div>
</section>
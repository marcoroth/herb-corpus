<!-- Usage Guidelines -->
<section class="mb-12">
  <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Verwendungsrichtlinien</h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="border-2 border-black rounded-lg p-4 bg-green-50">
      <h3 class="font-bold mb-2 text-green-800">Primary (Lime)</h3>
      <p class="text-sm">Hauptaktionen wie "Erstellen", "Speichern", "Hinzufügen"</p>
    </div>
    
    <div class="border-2 border-black rounded-lg p-4 bg-gray-50">
      <h3 class="font-bold mb-2 text-gray-800">Secondary (Gray)</h3>
      <p class="text-sm">Sekundäre Aktionen, neutrale Buttons</p>
    </div>
    
    <div class="border-2 border-black rounded-lg p-4 bg-red-50">
      <h3 class="font-bold mb-2 text-red-800">Danger (Red)</h3>
      <p class="text-sm">Destruktive Aktionen wie "Löschen", "Entfernen"</p>
    </div>
    
    <div class="border-2 border-black rounded-lg p-4 bg-white">
      <h3 class="font-bold mb-2">Edit (Hover Only)</h3>
      <p class="text-sm">Bearbeiten-Buttons in Tabellen</p>
    </div>
    
    <div class="border-2 border-black rounded-lg p-4 bg-white">
      <h3 class="font-bold mb-2">Ghost (Transparent)</h3>
      <p class="text-sm">Tertiäre Aktionen, "Abbrechen"</p>
    </div>
  </div>

  <%= render 'style_guide/shared/rationale',
        principles: ["P2", "P1"],
        body: "Eine View hat <strong>genau eine</strong> Primäraktion (lime) &mdash; gibt es zwei, ist keine mehr primär. Alle anderen Aktionen sind sekundär (weiß). Die Wichtigkeit trägt die Farbe, nicht Größe oder Schatten: jeder freistehende Button bekommt denselben Schatten (P1), weil er als eigenständige Aktion „auf der Fläche steht“." %>

  <!-- Danger: zwei Stufen -->
  <div class="mt-10">
    <h3 class="text-xl font-bold mb-4 pb-2 border-b-2 border-black">Destruktive Aktionen &mdash; zwei Stufen</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <!-- danger -->
      <div class="border-2 border-black rounded-lg overflow-hidden">
        <div class="px-4 py-2 bg-red-200 border-b-2 border-black font-bold text-red-900">danger &mdash; reversibel</div>
        <div class="p-4">
          <div class="mb-3">
            <%= render Neo::Buttons::ButtonComponent.new(variant: :danger, icon: "trash") do %>Löschen<% end %>
          </div>
          <p class="text-sm text-gray-700">Gefüllt hell-rot, Mülleimer-Icon. Für <strong>alltägliches, wiederholbares</strong> Löschen: Ticket, Notiz, Dokument, Mitglied entfernen, Token widerrufen.</p>
        </div>
      </div>

      <!-- danger-zone -->
      <div class="border-2 border-red-500 rounded-lg overflow-hidden">
        <div class="px-4 py-2 bg-red-50 border-b border-red-500 font-bold text-red-700 flex items-center gap-2">
          <i class="bi bi-exclamation-triangle"></i> danger-zone &mdash; irreversibel
        </div>
        <div class="p-4">
          <div class="mb-3">
            <a href="#" onclick="return false"
               class="h-8 px-3 text-sm font-medium border rounded inline-flex items-center justify-center gap-x-2 border-red-500 text-red-600 bg-white hover:bg-red-600 hover:text-white shadow-[2px_2px_0_0_#000] hover:shadow-[3px_3px_0_0_#000] hover:-translate-x-px hover:-translate-y-px transition-all">
              <i class="bi bi-exclamation-triangle"></i> Account löschen
            </a>
          </div>
          <p class="text-sm text-gray-700">Outline rot, Warndreieck. <strong>Beim Hover invertiert</strong> der Button (roter Hintergrund, weiße Schrift). Für <strong>irreversible</strong> Aktionen: Account / Projekt / Organisation endgültig löschen.</p>
          <p class="text-xs text-gray-400 mt-2">&uarr; Mit der Maus drüberfahren, um die Invertierung zu sehen.</p>
        </div>
      </div>
    </div>

    <%= render 'style_guide/shared/rationale',
          title: "Warum sehen Danger-Buttons so aus?",
          tone: :danger,
          principles: ["P8", "P6", "P3"],
          body: "Eine <strong>irreversible</strong> Aktion muss zwei <em>gegensätzliche</em> Dinge leisten (P8). " \
                "<strong>(a) Im Ruhezustand nicht zum Klick einladen</strong> &mdash; deshalb <em>outline</em> statt gefüllt: der Button tritt zurück, sieht nicht „erwünscht“ aus, das Gegenteil eines Primär-CTA. " \
                "<strong>(b) Im Moment der Interaktion maximal warnen</strong> &mdash; deshalb die <em>Hover-Invertierung</em> auf Vollflächen-Rot mit weißer Schrift (P6): sobald der Zeiger drauf ist, springt die Gefahr ins Gesicht. " \
                "Das <strong>Warndreieck statt Mülleimer</strong> trennt die Kategorie <em>irreversibel</em> sichtbar vom alltäglichen Löschen (P3) &mdash; der Mülleimer ist durch tausend Listen-Aktionen „abgenutzt“ und zu harmlos für „Account unwiederbringlich weg“. " \
                "Die schwächere Stufe <strong>danger</strong> (gefüllt, 🗑) bleibt dem reversiblen Alltags-Löschen vorbehalten, das nicht dramatisieren soll." %>
  </div>
</section>
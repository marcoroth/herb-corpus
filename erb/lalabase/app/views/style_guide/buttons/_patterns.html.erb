<%#
  Patterns (part D of the spec): compositions that go beyond a single button.
  Shown live here: D4 selection cards, D5 callout boxes, D6 inline action icons.
  Source: doc/design_system.md, part D.
%>
<section class="mb-12">
  <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Muster</h2>

  <!-- D4 selection cards -->
  <div class="mb-10">
    <h3 class="text-lg font-bold mb-3">D4 &mdash; Auswahl-Karten</h3>
    <div class="flex flex-col sm:flex-row gap-3 mb-3">
      <% [["sg_color", "🇩🇪 Deutsch", true], ["sg_color", "🇺🇸 English", false]].each_with_index do |(name, label, checked), i| %>
        <label class="flex flex-col items-center gap-2 cursor-pointer">
          <input type="radio" name="sg_d4_demo" class="sr-only peer" <%= 'checked' if checked %>>
          <div class="flex items-center gap-2 px-4 py-3 border-2 border-black rounded-lg bg-white
                      hover:shadow-[2px_2px_0_0_#000] hover:-translate-x-0.5 hover:-translate-y-0.5
                      peer-checked:shadow-[2px_2px_0_0_#000] peer-checked:-translate-x-0.5 peer-checked:-translate-y-0.5
                      peer-checked:bg-lime-50
                      peer-focus-visible:ring-2 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-black
                      transition-all">
            <span class="font-medium text-black"><%= label %></span>
          </div>
        </label>
      <% end %>
    </div>
    <%= render 'style_guide/shared/rationale',
          principles: ["P1", "P10"],
          body: "Klickbare Karten zur Optionswahl (Sprache, Farbprofil, Layout). <strong>Ausgewählt = hebt sich ab</strong> (Offset-Schatten + Lift, P1), nicht nur Farbe. Umsetzung: verstecktes Radio <code class=\"bg-gray-200 px-1 rounded text-xs\">sr-only peer</code>, Karte reagiert mit <code class=\"bg-gray-200 px-1 rounded text-xs\">peer-checked:…</code>. <strong>Falle:</strong> <code class=\"bg-gray-200 px-1 rounded text-xs\">peer-checked</code> wirkt nur auf DIREKTE Geschwister des Inputs &mdash; die gestylte Box darf nicht verschachtelt sein." %>
  </div>

  <!-- D5 callout boxes -->
  <div class="mb-10">
    <h3 class="text-lg font-bold mb-3">D5 &mdash; Hinweis-/Callout-Boxen</h3>
    <div class="space-y-3 mb-3 max-w-2xl">
      <% [
        ["bg-cobalt-50", "info-circle", "text-cobalt-700", "Info / neutral — z.B. Erklärungstext."],
        ["bg-lime-50", "check-circle", "text-lime-700", "Erfolg / Hervorhebung — z.B. Hinweis-Box."],
        ["bg-amber-50", "exclamation-triangle", "text-amber-700", "Warnung — z.B. Sicherheitshinweis."],
        ["bg-red-50", "exclamation-octagon", "text-red-700", "Gefahr / irreversibel."],
      ].each do |bg, icon, color, text| %>
        <div class="<%= bg %> border-2 border-black rounded-lg p-4 flex items-start gap-3">
          <i class="bi bi-<%= icon %> <%= color %> mt-0.5"></i>
          <p class="text-sm text-gray-800"><%= text %></p>
        </div>
      <% end %>
    </div>
    <%= render 'style_guide/shared/rationale',
          principles: ["P2", "P1"],
          body: "Inline-Boxen für Hinweise. <strong>border-black, kein Schatten</strong> (eingebettet, P1). Hintergrund nach <strong>Bedeutung gestuft</strong> (immer <code class=\"bg-gray-200 px-1 rounded text-xs\">-50</code>-Ton, P2): info=cobalt, Erfolg=lime, Warnung=amber, Gefahr=rot. Off-Palette (blue-50, farbig-helle Rahmen) raus." %>
  </div>

  <!-- D6 inline action icons -->
  <div class="mb-10">
    <h3 class="text-lg font-bold mb-3">D6 &mdash; Inline-Aktions-Icons</h3>
    <div class="max-w-md border-2 border-black rounded-lg p-4 mb-3 space-y-2">
      <% ["Status", "Priorität"].each do |field| %>
        <div class="flex items-center justify-between text-sm">
          <span class="font-medium"><%= field %></span>
          <div class="flex items-center gap-2">
            <span class="text-xs text-gray-500 bg-gray-100 px-2 py-0.5 rounded">select</span>
            <a href="#" onclick="return false" title="Bearbeiten"
               class="p-1 text-gray-400 hover:text-black focus-visible:text-black focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-black rounded transition-colors">
              <i class="bi bi-pencil text-xs"></i>
            </a>
          </div>
        </div>
      <% end %>
    </div>
    <%= render 'style_guide/shared/rationale',
          principles: ["P1", "P3"],
          body: "Einzelne Edit-/Aktions-Icons, die an einem <strong>Listen-Eintrag</strong> kleben (nicht in eigener Aktionsspalte). <strong>Rahmenlos</strong>, kein Hintergrund/Schatten (in den Fluss eingelassen, P1); Ruhe <code class=\"bg-gray-200 px-1 rounded text-xs\">text-gray-400</code>, Hover <code class=\"bg-gray-200 px-1 rounded text-xs\">hover:text-black</code> + Tastatur-Fokus-Ring. <strong>Abgrenzung:</strong> Aktionen in eigener Spalte → D3 (flache Icon-Buttons); freistehende Aktion → IconButtonComponent. Ein voller Button-Rahmen würde die dichte Liste „zerhacken“." %>
  </div>
</section>

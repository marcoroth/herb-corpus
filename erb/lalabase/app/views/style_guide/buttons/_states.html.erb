<!-- States -->
<section class="mb-12">
  <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Zustände</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="space-y-4">
      <div class="flex flex-wrap gap-3">
        <%= render Neo::Buttons::ButtonComponent.new(variant: :primary) do %>Normal<% end %>
        <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, loading: true) do %>Loading<% end %>
        <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, disabled: true) do %>Disabled<% end %>
      </div>
    </div>
    
    <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;%= render Neo::Buttons::ButtonComponent.new(
  variant: :primary,
  loading: true
) do %&gt;
  Loading
&lt;% end %&gt;

&lt;%= render Neo::Buttons::ButtonComponent.new(
  variant: :primary,
  disabled: true
) do %&gt;
  Disabled
&lt;% end %&gt;</code></pre>
  </div>

  <%= render 'style_guide/shared/rationale',
        title: "Disabled — sparsam & erklärt",
        principles: ["P9"],
        body: "Ein ausgegrauter Button ist fast immer die schlechtere Wahl: er ist nicht fokussierbar, Screenreader überspringen ihn, und der Nutzer erfährt nicht, <em>warum</em> er nicht klicken kann. <strong>Kein Dirty-Disabling</strong> (Submit grau, bis etwas geändert wurde) &mdash; der Button bleibt aktiv, ein No-Op-Speichern ist harmlos. Disabled ist nur dann richtig, wenn die Aktion teuer/irreversibel ist <strong>und</strong> der Grund sichtbar erklärt wird (z.B. Pflichtfeld leer &rarr; Hinweis daneben). Validierungs-Sperre (mit Grund) ist ok; stumme Zustands-Sperre nicht." %>

  <%= render 'style_guide/shared/rationale',
        title: "Tastatur-Fokus",
        principles: ["P10"],
        body: "Jeder Button zeigt bei <strong>Tastatur-Fokus</strong> (Tab) einen sichtbaren Ring (<code class=\"bg-gray-200 px-1 rounded text-xs\">focus-visible:ring-2 ring-offset-2 ring-black</code>). Probier es: mit Tab durch die Buttons oben springen. <code class=\"bg-gray-200 px-1 rounded text-xs\">focus-visible</code> (nicht <code class=\"bg-gray-200 px-1 rounded text-xs\">focus</code>) sorgt dafür, dass der Ring nur bei Tastatur erscheint, nicht beim Maus-Klick &mdash; kein Rauschen für Maus-Nutzer. Jeder Hover-Effekt braucht ein Tastatur-Äquivalent." %>

  <!-- Zwei Fokus-Modelle -->
  <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="border-2 border-black rounded-lg p-4 bg-white">
      <h4 class="font-bold mb-2">Aktivierung (Button/Link)</h4>
      <%= render Neo::Buttons::ButtonComponent.new(variant: :secondary) do %>Tab mich an<% end %>
      <p class="text-sm text-gray-700 mt-3"><strong>Fokus heißt:</strong> „gleich auslösen“ &mdash; flüchtig. Ring nur bei <strong>Tastatur</strong>.</p>
    </div>
    <div class="border-2 border-black rounded-lg p-4 bg-white">
      <h4 class="font-bold mb-2">Eingabe (Input/Select)</h4>
      <input type="text" placeholder="Klick oder Tab — sieh den Aktiv-Zustand"
             class="w-full h-10 px-4 rounded border-2 border-black bg-white focus:outline-none focus:shadow-[2px_2px_0_0_#000] focus:-translate-x-0.5 focus:-translate-y-0.5 transition-all">
      <p class="text-sm text-gray-700 mt-3"><strong>Fokus heißt:</strong> „hier landet, was ich tippe“ &mdash; dauerhaft. Schatten + Lift bei <strong>Klick UND Tastatur</strong>.</p>
    </div>
  </div>

  <%= render 'style_guide/shared/rationale',
        title: "Warum zwei Fokus-Signale?",
        principles: ["B6.1", "P10"],
        body: "Buttons und Eingabefelder fokussieren <strong>bewusst verschieden</strong>, weil Fokus für sie Verschiedenes bedeutet. Ein <strong>Button</strong> wird kurz aktiviert und wieder verlassen &rarr; ein <em>Tastatur-Ring</em> reicht (und stört die Maus nicht). Ein <strong>Eingabefeld</strong> ist der Ort, an dem man tippt &rarr; es braucht einen <em>dauerhaften</em> „ich bin aktiv“-Zustand, auch beim Maus-Klick. Würde man beide gleich machen, verlöre das Feld sein Aktiv-Signal beim Klicken. (Entspricht Material/Carbon.)" %>
</section>
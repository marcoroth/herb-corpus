<!-- With Icons -->
<section class="mb-12">
  <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Mit Icons</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="space-y-4">
      <h3 class="font-bold mb-2">Icon Links</h3>
      <div class="flex flex-wrap gap-3">
        <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, icon: "plus-lg") do %>Hinzufügen<% end %>
        <%= render Neo::Buttons::ButtonComponent.new(variant: :secondary, icon: "pencil") do %>Bearbeiten<% end %>
        <%= render Neo::Buttons::ButtonComponent.new(variant: :danger, icon: "trash") do %>Löschen<% end %>
      </div>
      
      <h3 class="font-bold mb-2 mt-6">Icon Rechts</h3>
      <div class="flex flex-wrap gap-3">
        <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, icon: "arrow-right", icon_position: :right) do %>Weiter<% end %>
        <%= render Neo::Buttons::ButtonComponent.new(variant: :secondary, icon: "download", icon_position: :right) do %>Download<% end %>
      </div>
      
      <h3 class="font-bold mb-2 mt-6">Nur Icon (Automatisch)</h3>
      <div class="flex flex-wrap gap-3">
        <%= render Neo::Buttons::ButtonComponent.new(variant: :edit, icon: "pencil", size: :small) %>
        <%= render Neo::Buttons::ButtonComponent.new(variant: :danger, icon: "trash", size: :small) %>
        <%= render Neo::Buttons::ButtonComponent.new(variant: :secondary, icon: "gear", size: :small) %>
      </div>
    </div>
    
    <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;%= render Neo::Buttons::ButtonComponent.new(
  variant: :primary,
  icon: "plus-lg"
) do %&gt;
  Hinzufügen
&lt;% end %&gt;

&lt;!-- Icon rechts --&gt;
&lt;%= render Neo::Buttons::ButtonComponent.new(
  icon: "arrow-right",
  icon_position: :right
) do %&gt;
  Weiter
&lt;% end %&gt;

&lt;!-- Nur Icon --&gt;
&lt;%= render Neo::Buttons::ButtonComponent.new(
  variant: :edit,
  icon: "pencil",
  size: :small
) %&gt;</code></pre>
  </div>

  <%= render 'style_guide/shared/rationale',
        title: "Wann ein Icon?",
        principles: ["P3"],
        body: "Ein Icon gehört nur an einen Button, wenn es <strong>Information hinzufügt</strong> &mdash; nicht zur Dekoration. <strong>Mit Icon:</strong> Löschen (🗑), Senden (✉), Reset (↺), Hinzufügen (+) &mdash; das Icon trägt die Folge oder Kategorie der Aktion. <strong>Ohne Icon:</strong> „Speichern“, „Abbrechen“, „Aktualisieren“ &mdash; der Text sagt schon alles, ein ✓ wäre Redundanz (und semantisch falsch: ✓ heißt „erledigt“, nicht „ausführen“). Faustregel: Je seltener Icons, desto stärker wirken die bedeutungstragenden." %>
</section>
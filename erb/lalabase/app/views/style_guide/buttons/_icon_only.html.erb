<!-- Icon-Only Buttons -->
<section class="mb-12">
  <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Icon-Only Buttons</h2>
  <p class="text-gray-600 mb-6">Icon-Only Buttons werden mit <code class="bg-gray-200 px-1 rounded">Neo::Buttons::IconButtonComponent</code> gerendert. Sie werden in Tabellen, Cards und Toolbars verwendet.</p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="space-y-4">
      <h3 class="font-bold mb-2">Empfohlene Verwendung in Tabellen/Cards</h3>
      <div class="border border-black rounded-lg p-4 bg-gray-50">
        <p class="text-sm mb-3">Aktionen in engen Bereichen (z.B. Tabellen, Card-Footer):</p>
        <div class="flex gap-2">
          <%= render Neo::Buttons::IconButtonComponent.new(
            variant: :secondary,
            size: :medium,
            icon: "eye",
            title: "Details anzeigen"
          ) %>
          <%= render Neo::Buttons::IconButtonComponent.new(
            variant: :edit,
            size: :medium,
            icon: "pencil",
            title: "Bearbeiten"
          ) %>
          <%= render Neo::Buttons::IconButtonComponent.new(
            variant: :danger,
            size: :medium,
            icon: "trash",
            title: "Löschen"
          ) %>
        </div>
      </div>

      <h3 class="font-bold mb-2 mt-6">Größen-Vergleich</h3>
      <div class="space-y-3">
        <div class="flex items-center gap-3">
          <span class="text-sm w-20">Small:</span>
          <%= render Neo::Buttons::IconButtonComponent.new(variant: :edit, icon: "pencil", size: :small, title: "Small") %>
          <span class="text-xs text-gray-500">(h-6 px-2) - Sehr kompakt</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-sm w-20">Medium:</span>
          <%= render Neo::Buttons::IconButtonComponent.new(variant: :edit, icon: "pencil", size: :medium, title: "Medium") %>
          <span class="text-xs text-gray-500">(h-8 px-3) - Empfohlen</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-sm w-20">Large:</span>
          <%= render Neo::Buttons::IconButtonComponent.new(variant: :edit, icon: "pencil", size: :large, title: "Large") %>
          <span class="text-xs text-gray-500">(h-10 px-4) - Für wichtige Aktionen</span>
        </div>
      </div>

      <h3 class="font-bold mb-2 mt-6">Spezial-Varianten</h3>
      <div class="flex gap-2">
        <%= render Neo::Buttons::IconButtonComponent.new(variant: :plain, icon: "x-lg", class: "opacity-50 hover:opacity-100", title: "Schließen") %>
        <%= render Neo::Buttons::IconButtonComponent.new(variant: :ghost, icon: "archive", title: "Archivieren") %>
        <%= render Neo::Buttons::IconButtonComponent.new(variant: :success, icon: "check2", title: "Bestätigen") %>
      </div>
      <p class="text-sm text-gray-600 mt-2">
        <strong>plain</strong> &mdash; Modal-Close &middot;
        <strong>ghost</strong> &mdash; Sekundäre Aktionen &middot;
        <strong>success</strong> &mdash; Bestätigen
      </p>
    </div>

    <div>
      <h4 class="font-mono text-sm mb-2">Code:</h4>
      <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm mb-4"><code>&lt;!-- Neo::Buttons::IconButtonComponent (icon-only) --&gt;
&lt;%= render Neo::Buttons::IconButtonComponent.new(
  variant: :edit,
  size: :medium,
  icon: "pencil",
  title: "Bearbeiten",
  url: edit_path(item)
) %&gt;

&lt;!-- Neo::Buttons::ButtonComponent (icon + label) --&gt;
&lt;%= render Neo::Buttons::ButtonComponent.new(
  variant: :primary,
  icon: "plus-lg"
) do %&gt;
  Neuer Task
&lt;% end %&gt;

&lt;!-- Modal-Close (plain, transparent) --&gt;
&lt;%= render Neo::Buttons::IconButtonComponent.new(
  variant: :plain, icon: "x-lg",
  class: "opacity-50 hover:opacity-100"
) %&gt;</code></pre>

      <div class="p-3 bg-yellow-50 border border-yellow-300 rounded">
        <p class="text-xs font-semibold mb-1">Verwendung:</p>
        <ul class="text-xs space-y-1">
          <li>• <code class="bg-gray-200 px-1 rounded">Neo::Buttons::IconButtonComponent</code> &mdash; Nur Icon (Tabellen, Toolbars, Close-X)</li>
          <li>• <code class="bg-gray-200 px-1 rounded">Neo::Buttons::ButtonComponent</code> &mdash; Icon + Label (Primäre Aktionen)</li>
          <li>• Immer <code class="bg-gray-200 px-1 rounded">title</code> setzen für Barrierefreiheit</li>
        </ul>
      </div>
    </div>
  </div>
</section>

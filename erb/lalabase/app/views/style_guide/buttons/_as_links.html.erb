<!-- As Links -->
<section class="mb-12">
  <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Als Links</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="space-y-4">
      <div class="flex flex-wrap gap-3">
        <%= render Neo::Buttons::ButtonComponent.new(tag: :a, href: "#", variant: :primary, icon: "house") do %>
          Zur Startseite
        <% end %>
        <%= render Neo::Buttons::ButtonComponent.new(tag: :a, href: "#", variant: :secondary, icon: "arrow-left") do %>
          Zurück
        <% end %>
        <%= render Neo::Buttons::ButtonComponent.new(tag: :a, href: "#", variant: :ghost) do %>
          Abbrechen
        <% end %>
      </div>
    </div>
    
    <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;%= render Neo::Buttons::ButtonComponent.new(
  tag: :a,
  href: root_path,
  variant: :primary,
  icon: "house"
) do %&gt;
  Zur Startseite
&lt;% end %&gt;</code></pre>
  </div>
</section>
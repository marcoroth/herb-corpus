<!-- Toggle States -->
<section class="mb-12">
  <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Toggle-Zustände</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="space-y-4">
      <h3 class="font-bold mb-2">Toggle mit Durchstrich-Effekt</h3>
      <p class="text-sm text-gray-600 mb-4">
        Für Toggle-Buttons, die einen deaktivierten Zustand anzeigen, verwenden wir einen diagonalen Durchstrich-Effekt.
        Dies wird häufig für Filter-Buttons verwendet (z.B. Aktivitätsverlauf, Zeiterfassung).
      </p>
      <div class="flex flex-wrap gap-3">
        <%= render Neo::Buttons::ButtonComponent.new(variant: :ghost, icon: "activity", class: "toggle-inactive") do %>Aktivitäten<% end %>
        <%= render Neo::Buttons::ButtonComponent.new(variant: :ghost, icon: "clock", class: "toggle-inactive") do %>Zeiterfassung<% end %>
        <%= render Neo::Buttons::ButtonComponent.new(variant: :ghost, icon: "filter") do %>Filter aktiv<% end %>
      </div>
      
      <!-- Add CSS for demo -->
    </div>
    
    <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;!-- Button mit Durchstrich (deaktiviert) --&gt;
&lt;%= render Neo::Buttons::ButtonComponent.new(
  variant: :ghost,
  icon: "activity",
  class: "toggle-inactive"
) do %&gt;
  Aktivitäten
&lt;% end %&gt;

&lt;!-- CSS für den Durchstrich-Effekt --&gt;
&lt;style&gt;
  .toggle-inactive {
    position: relative;
    overflow: hidden;
  }
  
  .toggle-inactive::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 141.42%;
    height: 1px;
    background-color: #475569;
    transform-origin: top left;
    transform: rotate(45deg);
    pointer-events: none;
  }
&lt;/style&gt;

&lt;!-- JavaScript für Toggle --&gt;
&lt;script&gt;
  button.addEventListener('click', () =&gt; {
    button.classList.toggle('toggle-inactive');
  });
&lt;/script&gt;</code></pre>
  </div>
</section>
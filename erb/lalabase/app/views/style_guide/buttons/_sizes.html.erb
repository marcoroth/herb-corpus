<!-- Sizes -->
<section class="mb-12">
  <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Größen</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="space-y-4">
      <div class="flex items-end gap-3">
        <%= render Neo::Buttons::ButtonComponent.new(size: :small, variant: :primary) do %>Small<% end %>
        <%= render Neo::Buttons::ButtonComponent.new(size: :medium, variant: :primary) do %>Medium<% end %>
        <%= render Neo::Buttons::ButtonComponent.new(size: :large, variant: :primary) do %>Large<% end %>
      </div>
    </div>
    
    <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm"><code>&lt;%= render Neo::Buttons::ButtonComponent.new(
  size: :large,
  variant: :primary
) do %&gt;
  Large Button
&lt;% end %&gt;</code></pre>
  </div>

  <!-- Which size when? -->
  <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="border-2 border-black rounded-lg p-4 bg-white">
      <div class="flex items-center gap-2 mb-1"><span class="font-bold">large</span><code class="text-xs text-gray-500">h-10</code></div>
      <p class="text-sm text-gray-700">Primäre Form-Submits (Speichern/Senden), Haupt-CTAs, Header-Aktionen.</p>
    </div>
    <div class="border-2 border-black rounded-lg p-4 bg-white">
      <div class="flex items-center gap-2 mb-1"><span class="font-bold">medium</span><code class="text-xs text-gray-500">h-8 · Default</code></div>
      <p class="text-sm text-gray-700">Standard-Buttons, sekundäre Aktionen, Toolbars.</p>
    </div>
    <div class="border-2 border-black rounded-lg p-4 bg-white">
      <div class="flex items-center gap-2 mb-1"><span class="font-bold">small</span><code class="text-xs text-gray-500">h-6</code></div>
      <p class="text-sm text-gray-700">Dichte Kontexte: Tabellen-Zeilen, Karten-Ecken, Inline-Chips.</p>
    </div>
  </div>

  <%= render 'style_guide/shared/rationale',
        title: "Welche Größe? — nach Prominenz",
        principles: ["B5", "P4"],
        body: "Die Größe richtet sich nach der <strong>Prominenz der Aktion</strong>, nicht nach dem Zufall des Markups. In einem <strong>Form-Footer</strong> ist der primäre Submit <code class=\"bg-gray-200 px-1 rounded text-xs\">size: :large</code>, und die begleitenden Buttons (Abbrechen/Löschen) bekommen <strong>dieselbe Größe</strong> &mdash; keine ungleichen Höhen. <strong>Achtung:</strong> der Default der Komponente ist <code class=\"bg-gray-200 px-1 rounded text-xs\">:medium</code> &mdash; Form-Submits also <strong>immer explizit</strong> <code class=\"bg-gray-200 px-1 rounded text-xs\">size: :large</code> setzen, sonst schrumpft der Button ungewollt." %>
</section>
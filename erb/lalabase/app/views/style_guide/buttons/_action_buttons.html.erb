<!-- Action Buttons -->
<section class="mb-12">
  <h2 class="text-2xl font-bold mb-6 pb-2 border-b-2 border-black">Action Button Komponenten</h2>
  <p class="text-gray-600 mb-6">Spezialisierte Komponenten für die häufigsten Aktionen. Diese vereinfachen die Verwendung und garantieren Konsistenz.</p>
  
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Show Button -->
    <div class="border border-black rounded-lg p-4">
      <h3 class="font-bold mb-3">Neo::Buttons::ShowButtonComponent</h3>
      <p class="text-sm text-gray-600 mb-4">Für Detail-Ansichten und Read-Only Aktionen</p>
      
      <div class="space-y-3 mb-4">
        <div class="flex items-center gap-3">
          <span class="text-sm w-24">Icon-Only:</span>
          <%= render Neo::Buttons::ShowButtonComponent.new(href: "#") %>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-sm w-24">Mit Text:</span>
          <%= render Neo::Buttons::ShowButtonComponent.new(href: "#", icon_only: false) do %>
            Details
          <% end %>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-sm w-24">Small:</span>
          <%= render Neo::Buttons::ShowButtonComponent.new(href: "#", size: :small) %>
        </div>
      </div>
      
      <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm mt-4"><code>&lt;!-- Standard (Icon-Only) --&gt;
&lt;%= render Neo::Buttons::ShowButtonComponent.new(
  href: item_path(item)
) %&gt;

&lt;!-- Mit Text --&gt;
&lt;%= render Neo::Buttons::ShowButtonComponent.new(
  href: item_path(item),
  icon_only: false
) do %&gt;
  Details anzeigen
&lt;% end %&gt;</code></pre>
    </div>
    
    <!-- Edit Button -->
    <div class="border border-black rounded-lg p-4">
      <h3 class="font-bold mb-3">Neo::Buttons::EditButtonComponent</h3>
      <p class="text-sm text-gray-600 mb-4">Für Bearbeitungs-Aktionen</p>
      
      <div class="space-y-3 mb-4">
        <div class="flex items-center gap-3">
          <span class="text-sm w-24">Icon-Only:</span>
          <%= render Neo::Buttons::EditButtonComponent.new(href: "#") %>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-sm w-24">Mit Text:</span>
          <%= render Neo::Buttons::EditButtonComponent.new(href: "#", icon_only: false) do %>
            Bearbeiten
          <% end %>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-sm w-24">Custom Title:</span>
          <%= render Neo::Buttons::EditButtonComponent.new(href: "#", title: "Eintrag bearbeiten") %>
        </div>
      </div>
      
      <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm mt-4"><code>&lt;!-- Standard (Icon-Only) --&gt;
&lt;%= render Neo::Buttons::EditButtonComponent.new(
  href: edit_item_path(item)
) %&gt;

&lt;!-- Custom Tooltip --&gt;
&lt;%= render Neo::Buttons::EditButtonComponent.new(
  href: edit_item_path(item),
  title: "Projekt bearbeiten"
) %&gt;</code></pre>
    </div>
    
    <!-- Delete Button -->
    <div class="border border-black rounded-lg p-4 lg:col-span-2">
      <h3 class="font-bold mb-3">Neo::Buttons::DeleteButtonComponent</h3>
      <p class="text-sm text-gray-600 mb-4">Für Lösch-Aktionen mit automatischem Confirm-Dialog</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        <div class="space-y-3">
          <h4 class="text-sm font-semibold">Link-basiert (Standard)</h4>
          <div class="flex items-center gap-3">
            <span class="text-sm w-24">Icon-Only:</span>
            <%= render Neo::Buttons::DeleteButtonComponent.new(href: "#") %>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-sm w-24">Mit Text:</span>
            <%= render Neo::Buttons::DeleteButtonComponent.new(href: "#", icon_only: false) do %>
              Löschen
            <% end %>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-sm w-24">Custom Msg:</span>
            <%= render Neo::Buttons::DeleteButtonComponent.new(
              href: "#", 
              confirm: "Diesen Eintrag wirklich löschen?",
              title: "Eintrag entfernen"
            ) %>
          </div>
        </div>
        
        <div class="space-y-3">
          <h4 class="text-sm font-semibold">Form-basiert (button_to)</h4>
          <div class="flex items-center gap-3">
            <span class="text-sm w-24">Mit Form:</span>
            <%= render Neo::Buttons::DeleteButtonComponent.new(
              href: "#",
              form: {
                action: "#",
                method: :delete
              }
            ) %>
          </div>
        </div>
      </div>
      
      <pre class="bg-gray-900 text-gray-100 p-4 rounded overflow-x-auto text-sm mt-4"><code>&lt;!-- Link-basiert (Standard) --&gt;
&lt;%= render Neo::Buttons::DeleteButtonComponent.new(
  href: item_path(item)
) %&gt;

&lt;!-- Custom Confirm Message --&gt;
&lt;%= render Neo::Buttons::DeleteButtonComponent.new(
  href: item_path(item),
  confirm: "Wirklich löschen? Diese Aktion kann nicht rückgängig gemacht werden."
) %&gt;

&lt;!-- Form-basiert (für button_to) --&gt;
&lt;%= render Neo::Buttons::DeleteButtonComponent.new(
  href: item_path(item),
  form: {
    action: item_path(item),
    method: :delete
  }
) %&gt;</code></pre>
    </div>
  </div>
  
  <!-- Best Practices -->
  <div class="mt-6 p-4 bg-blue-50 border border-blue-300 rounded-lg">
    <h3 class="font-bold mb-2">Best Practices für Action Buttons</h3>
    <ul class="text-sm space-y-1">
      <li>• <strong>Standard-Verwendung:</strong> Nutze diese Komponenten statt direkt Neo::Buttons::ButtonComponent für Show/Edit/Delete</li>
      <li>• <strong>Icon-Only Default:</strong> Standardmäßig werden nur Icons angezeigt (platzsparend in Tabellen/Cards)</li>
      <li>• <strong>Konsistente Größe:</strong> Alle verwenden standardmäßig <code class="bg-gray-200 px-1 rounded">size: :medium</code></li>
      <li>• <strong>Barrierefreiheit:</strong> Title-Attribute werden automatisch gesetzt</li>
      <li>• <strong>Delete-Sicherheit:</strong> Confirm-Dialog ist bei Delete standardmäßig aktiv</li>
    </ul>
  </div>

  <%= render 'style_guide/shared/rationale',
        title: "Bestätigung — ein Mechanismus, gestuft",
        principles: ["P8", "B7"],
        body: "Die Reibung einer Bestätigung steigt mit der Konsequenz. <strong>danger (reversibel):</strong> ein Neo-Stil-Dialog „Wirklich löschen?“ &mdash; nicht der native Browser-<code class=\"bg-gray-200 px-1 rounded text-xs\">confirm()</code>, der den Stil bricht. <strong>danger-zone (irreversibel):</strong> stärkere Hürde &mdash; den Namen tippen, bevor Bestätigen aktiv wird (hier ist Disabling korrekt, weil der Grund sichtbar ist). Heute uneinheitlich (mal Komponenten-confirm, mal rohes data-turbo-confirm, vereinzelt Custom-Modal) &rarr; auf einen Mechanismus konsolidieren." %>
</section>
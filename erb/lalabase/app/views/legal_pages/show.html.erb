<%# The operator's own text. Markdown, sanitised by the markdown helper -- an
    admin can paste anything and this page is public. Styling lives in
    views.css under the .legal-page anchor, per the CSS convention. %>
<div class="legal-page width-text">
  <h1 class="legal-page-title"><%= @title %></h1>

  <div class="legal-page-body">
    <%= markdown(@body) %>
  </div>

  <p class="legal-page-back">
    <%= link_to t('views.shared.legal.back_to_sign_in'), new_user_session_path %>
  </p>
</div>

<%# Shown when this instance has no catalogue file: a self-hosted instance, or a
    machine that has not fetched one. The documentation is not missing, it is
    published elsewhere, so this says where and links into it rather than showing
    an error or an empty tree.

    Carries the SAME frame as show.html.erb, because the contextual-help drawer
    fetches this address too and would otherwise graft Turbo's untranslated
    "Content missing" into itself. %>
<% content_for(:page_title, t('views.organisations.help.unavailable.title')) %>

<div id="help-page" class="flex flex-col gap-5">
  <%= render NeoTitleBoxComponent.new(
        title: t('views.organisations.help.shared.title'),
        variant: :organisation,
        margin_bottom: nil
      ) %>

  <%= turbo_frame_tag 'contextual_help_content', target: '_top' do %>
    <div class="rounded-md border border-cream-300 bg-surface-raised px-4 py-8 text-center">
      <p class="text-lg font-semibold text-heading"><%= t('views.organisations.help.unavailable.title') %></p>
      <p class="mt-1 text-sm text-muted"><%= t('views.organisations.help.unavailable.body') %></p>
      <%= link_to t('views.organisations.help.unavailable.public_link'),
            @public_docs_url,
            target: '_blank', rel: 'noopener',
            class: 'mt-4 inline-block text-sm underline' %>
    </div>
  <% end %>
</div>

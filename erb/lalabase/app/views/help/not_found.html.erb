<%# App-styled 404 for unknown help slugs (deliberately NOT the public docs 404). %>
<% content_for(:page_title, t('views.organisations.help.not_found.title')) %>

<div id="help-page" class="flex flex-col gap-5">
  <%= render NeoTitleBoxComponent.new(
        title: t('views.organisations.help.shared.title'),
        variant: :organisation,
        margin_bottom: nil
      ) %>

  <%# The 404 carries the SAME frame as show.html.erb: the contextual-help drawer
      fetches stale/renamed slugs too — without a matching frame Turbo would graft
      its untranslated "Content missing" into the drawer (turbo:frame-missing). %>
  <%= turbo_frame_tag 'contextual_help_content', target: '_top' do %>
    <div class="rounded-md border border-cream-300 bg-surface-raised px-4 py-8 text-center">
      <p class="text-lg font-semibold text-heading"><%= t('views.organisations.help.not_found.title') %></p>
      <p class="mt-1 text-sm text-muted"><%= t('views.organisations.help.not_found.body') %></p>
      <%= link_to t('views.organisations.help.not_found.home_link'),
            help_path,
            class: 'mt-4 inline-block text-sm underline' %>
    </div>
  <% end %>
</div>

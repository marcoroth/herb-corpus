<%# Search field above the navigation (D10): debounced input OUTSIDE the Turbo
    frame (keeps focus), results swap inside. The field value + result list are
    seeded from @query so a page opened from a result keeps them (they survive the
    click). The X button clears both — but ONLY on click, never on a result click.
    Same search-pill look as the documentation/tickets filter bars so search reads
    as ONE control app-wide. %>
<div data-controller="frame-search"
     data-frame-search-url-value="<%= help_search_path %>"
     data-frame-search-frame-value="help-search-results"
     data-frame-search-highlight-selector-value=".help-prose">
  <div class="relative w-full">
    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pr-1.5 text-gray-500 pointer-events-none z-10">
      <i class="bi bi-search text-xs"></i>
    </span>
    <%# role=combobox opts this input into keyboard nav (arrow/Enter over the result
        cards); the widget's search input has no role, so it stays a plain field. %>
    <input type="search"
           autocomplete="off"
           value="<%= @query %>"
           role="combobox"
           aria-expanded="false"
           aria-autocomplete="list"
           aria-controls="help-search-listbox"
           placeholder="<%= t('views.organisations.help.search.placeholder') %>"
           data-frame-search-target="input"
           data-action="input->frame-search#search keydown->frame-search#onKeydown"
           class="doc-search-input w-full h-8 pl-9 pr-8 text-xs border border-slate-300 rounded-full bg-surface-raised
                  focus:outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-200 transition-colors">
    <button type="button"
            data-frame-search-target="clear"
            data-action="frame-search#clear"
            <%= 'hidden' if @query.blank? %>
            aria-label="<%= t('views.organisations.help.search.clear') %>"
            title="<%= t('views.organisations.help.search.clear') %>"
            class="absolute inset-y-0 right-0 flex items-center pr-3 text-gray-500 hover:text-heading z-10">
      <i class="bi bi-x-lg text-xs"></i>
    </button>
  </div>

  <%= turbo_frame_tag 'help-search-results' do %>
    <%= render 'results' %>
  <% end %>
</div>

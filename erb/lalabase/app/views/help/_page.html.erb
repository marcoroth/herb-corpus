<%# locals: page (Docs::Catalogue::Page), body_html (String, links already
    rewritten onto help paths), language_fallback (Boolean, D9 banner).
    The search term is highlighted client-side (frame-search#highlightContent over
    the .help-prose container), so the body is rendered plain here. %>
<div>
  <% if language_fallback %>
    <div class="mb-4 flex items-center gap-2 rounded-md border border-cream-300 bg-surface-raised px-3 py-2 text-sm text-muted">
      <i class="bi bi-translate"></i>
      <span><%= t('views.organisations.help.show.fallback_notice') %></span>
    </div>
  <% end %>

  <article class="help-prose max-w-3xl"
           data-controller="help-copy"
           data-action="click->help-copy#copy"
           data-help-copy-copy-label-value="<%= t('docs.chrome.copy') %>"
           data-help-copy-copied-label-value="<%= t('docs.chrome.copied') %>">
    <%# body_html is server-side rendered Markdown from our own repo-authored docs
        files; sanitize on output as defense in depth (documentation-area pattern). %>
    <%= sanitize body_html,
          tags: Docs::Contract::ALLOWED_TAGS,
          attributes: Docs::Contract::ALLOWED_ATTRIBUTES %>
  </article>
</div>

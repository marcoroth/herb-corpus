<% content_for(:page_title, "#{@page.title} · #{t('views.organisations.help.shared.title')}") %>

<%# help-scope is the class-based anchor for the .help-prose styles (views.css) —
    shared with the contextual-help drawer, which grafts only the frame below,
    without this #help-page wrapper (doc/kontexthilfe_drawer_plan.md §8). %>
<div id="help-page"
     class="help-scope flex flex-col gap-5"
     data-controller="viewport"
     data-viewport-current-mode-value="<%= @viewport_mode %>">

  <%= render NeoTitleBoxComponent.new(
        title: t('views.organisations.help.shared.title'),
        variant: :organisation,
        margin_bottom: nil
      ) %>

  <% if @viewport_mode == 'mobile' %>
    <div class="flex flex-col gap-3">
      <%# Back link passes the viewport through — otherwise the index redirects
          back to a page and the tree stays unreachable (inbox redirect lesson). %>
      <%= link_to help_path(viewport: 'mobile'),
            class: "inline-flex items-center gap-1 text-sm text-muted" do %>
        <i class="bi bi-arrow-left"></i>
        <%= t('views.organisations.help.show.back_to_tree') %>
      <% end %>
      <%# Frame target for the contextual-help drawer (D2): the drawer sets this
          frame's src and Turbo grafts only this content. target="_top" keeps
          in-prose links navigating the whole page on a direct visit. %>
      <%= turbo_frame_tag 'contextual_help_content', target: '_top' do %>
        <%= render 'page', page: @page, body_html: @body_html, language_fallback: @language_fallback %>
      <% end %>
    </div>
  <% else %>
    <div class="flex gap-6">
      <aside class="w-72 shrink-0 border-r border-cream-300 pr-4">
        <%= render 'search_box' %>
        <%= render 'tree', groups: @groups, active_slug: @active_slug %>
      </aside>
      <main class="min-w-0 flex-1">
        <%= turbo_frame_tag 'contextual_help_content', target: '_top' do %>
          <%= render 'page', page: @page, body_html: @body_html, language_fallback: @language_fallback %>
        <% end %>
      </main>
    </div>
  <% end %>
</div>

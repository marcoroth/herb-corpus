<%# Mobile-only in practice: desktop requests are redirected to the first page
    in the controller (DT7 — mobile needs a reachable tree view). %>
<% content_for(:page_title, t('views.organisations.help.shared.title')) %>

<div id="help-page"
     class="flex flex-col gap-5"
     data-controller="viewport"
     data-viewport-current-mode-value="<%= @viewport_mode %>">

  <%= render NeoTitleBoxComponent.new(
        title: t('views.organisations.help.shared.title'),
        variant: :organisation,
        margin_bottom: nil
      ) %>

  <%= render 'search_box' %>

  <%= render 'tree', groups: @groups, active_slug: @active_slug %>
</div>

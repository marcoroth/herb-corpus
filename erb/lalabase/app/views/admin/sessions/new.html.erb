<div class="min-h-screen flex items-center justify-center bg-gray-50">
  <div class="max-w-[600px] w-full px-4 py-6">
    <div class="text-center mb-8">
      <h2 class="text-2xl md:text-[1.6rem] font-semibold"><%= t('views.admin.sessions.new.title') %></h2>
    </div>

    <% if flash[:notice].present? %>
      <div class="bg-green-50 border border-green-300 rounded-lg p-4 mb-6">
        <div class="flex">
          <div class="flex-shrink-0">
            <i class="bi bi-check-circle-fill text-green-500"></i>
          </div>
          <div class="ml-3">
            <p class="text-sm text-green-700"><%= flash[:notice] %></p>
          </div>
        </div>
      </div>
    <% end %>

    <div class="border border-black rounded-lg p-6 bg-white shadow-md">
      <%= form_with url: admin_log_in_path, local: true, method: :post, class: "space-y-6" do |f| %>
        <div>
          <%= f.label :email, t('views.admin.sessions.new.email_label'), class: "block text-sm font-medium mb-2" %>
          <%= f.text_field :email,
                         class: "w-full py-2.5 px-4 rounded border border-black focus:outline-none focus:-translate-x-0.5 focus:-translate-y-0.5 focus:shadow-[2px_2px_0_0_#000000] focus:bg-white",
                         placeholder: t('views.admin.sessions.new.email_placeholder') %>
        </div>

        <div>
          <%= f.label :password, t('views.admin.sessions.new.password_label'), class: "block text-sm font-medium mb-2" %>
          <%= f.password_field :password,
                             class: "w-full py-2.5 px-4 rounded border border-black focus:outline-none focus:-translate-x-0.5 focus:-translate-y-0.5 focus:shadow-[2px_2px_0_0_#000000] focus:bg-white",
                             placeholder: t('views.admin.sessions.new.password_placeholder') %>
        </div>

        <div>
          <%= f.submit t('views.admin.sessions.new.submit'),
                      class: "w-full py-2.5 px-5 relative inline-flex flex-row items-center justify-center gap-x-2 rounded text-sm tracking-[.00714em] font-medium border border-black hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[2px_2px_0_0_#000000] focus:-translate-x-0.5 focus:-translate-y-0.5 focus:shadow-[2px_2px_0_0_#000000] bg-lime-200 hover:bg-lime-300 focus:bg-lime-300 text-black" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="container mx-auto px-4 py-8">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold mb-2"><%= t('.title') %></h1>
    <p class="text-gray-600"><%= t('.description') %></p>
  </div>

  <!-- Statistik-Karten -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white border-2 border-black rounded-lg p-4 shadow-[2px_2px_0_0_#000000]">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600"><%= t('.stats.total') %></p>
          <p class="text-2xl font-bold"><%= @organisations.count %></p>
        </div>
        <i class="bi bi-building-fill text-3xl text-blue-500"></i>
      </div>
    </div>

    <div class="bg-white border-2 border-black rounded-lg p-4 shadow-[2px_2px_0_0_#000000]">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600"><%= t('.stats.own_credentials') %></p>
          <p class="text-2xl font-bold"><%= @ai_stats[:with_own_credentials] %></p>
          <%# The remainder, split by where it actually routes — "not BYOK" is
              two different recipients (package credential vs. system row). %>
          <p class="text-xs text-gray-500">
            <%= t('.stats.routing_split', package: @ai_stats[:with_package], system: @ai_stats[:using_system_credentials]) %>
          </p>
        </div>
        <i class="bi bi-person-gear text-3xl text-green-500"></i>
      </div>
    </div>

    <div class="bg-white border-2 border-black rounded-lg p-4 shadow-[2px_2px_0_0_#000000]">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600"><%= t('.stats.tokens_30d') %></p>
          <p class="text-2xl font-bold"><%= number_with_delimiter(@ai_stats[:total_usage_30d]) %></p>
        </div>
        <i class="bi bi-cpu text-3xl text-purple-500"></i>
      </div>
    </div>

    <div class="bg-white border-2 border-black rounded-lg p-4 shadow-[2px_2px_0_0_#000000]">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600"><%= t('.stats.costs_30d') %></p>
          <p class="text-2xl font-bold"><%= number_to_currency(@ai_stats[:total_cost_30d] / 100.0, unit: "€") %></p>
        </div>
        <i class="bi bi-currency-euro text-3xl text-yellow-500"></i>
      </div>
    </div>
  </div>

  <!-- Organisations Table -->
  <div class="bg-white border-2 border-black rounded-lg shadow-[2px_2px_0_0_#000000] overflow-hidden">
    <div class="px-4 py-3 border-b-2 border-black bg-gray-50">
      <h2 class="text-lg font-bold"><%= t('.table_title') %></h2>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-100 border-b-2 border-black">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('.table.organisation') %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('.table.created') %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('.table.members') %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('.table.ai_routing') %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('.table.data_import') %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('.table.code_indexing') %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('.table.assistant') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @organisations.each do |organisation| %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-4 py-3 whitespace-nowrap">
                <div class="flex items-center">
                  <div class="flex-shrink-0 h-10 w-10">
                    <div class="h-10 w-10 rounded-lg border-2 border-black bg-lime-100 flex items-center justify-center font-bold">
                      <%= organisation.name.first.upcase %>
                    </div>
                  </div>
                  <div class="ml-3">
                    <div class="text-sm font-bold"><%= organisation.name %></div>
                  </div>
                </div>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm">
                <div>
                  <div class="font-medium"><%= organisation.created_at.strftime("%d.%m.%Y") %></div>
                  <div class="text-xs text-gray-500"><%= t('.ago', time: time_ago_in_words(organisation.created_at)) %></div>
                </div>
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-bold bg-green-100 text-green-800 border border-green-300">
                  <%# .size uses the preloaded :memberships collection — .count would fire a COUNT per row (N+1). %>
                  <%= organisation.memberships.size %>
                </span>
              </td>
              <td class="px-4 py-3">
                <%= render 'admin/organisations/ai_routing', summary: @ai_routing_by_org_id[organisation.id] %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                <%= render 'admin/organisations/flag_toggle',
                           enabled: organisation.data_import_enabled?,
                           on_label: t('.data_import_on'),
                           off_label: t('.data_import_off'),
                           button_label: t('.toggle_data_import'),
                           confirm: t('.toggle_data_import_confirm', name: organisation.name),
                           path: toggle_data_import_admin_organisation_path(organisation) %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                <div class="flex items-center gap-2">
                  <%= render 'admin/organisations/flag_toggle',
                             enabled: organisation.code_indexing?,
                             on_label: t('.code_indexing_on'),
                             off_label: t('.code_indexing_off'),
                             button_label: t('.toggle_code_indexing'),
                             confirm: t('.toggle_code_indexing_confirm', name: organisation.name),
                             path: toggle_code_indexing_admin_organisation_path(organisation) %>
                  <%# S3: link to the org detail page (KI-Kontingent override + Historie). %>
                  <%= link_to t('.details'), admin_organisation_path(organisation),
                              class: 'text-xs px-2 py-1 rounded-md border-2 border-black bg-white hover:bg-gray-100 font-medium shadow-[1px_1px_0_0_#000000]' %>
                </div>
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                <%= render 'admin/organisations/flag_toggle',
                           enabled: organisation.assistant_enabled?,
                           on_label: t('.assistant_on'),
                           off_label: t('.assistant_off'),
                           button_label: t('.toggle_assistant'),
                           confirm: t('.toggle_assistant_confirm', name: organisation.name),
                           path: toggle_assistant_admin_organisation_path(organisation) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @organisations.empty? %>
      <div class="px-4 py-8 text-center text-gray-500">
        <i class="bi bi-building text-4xl mb-2"></i>
        <p><%= t('.no_organisations') %></p>
      </div>
    <% end %>
  </div>
</div>

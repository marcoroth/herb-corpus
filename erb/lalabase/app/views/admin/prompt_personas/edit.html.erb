<div class="max-w-4xl mx-auto py-6 sm:px-6 lg:px-8">
  <div class="px-4 py-6 sm:px-0">
    <div class="mb-8 flex items-center">
      <%= link_to admin_prompt_personas_path, class: "text-gray-500 hover:text-gray-700 mr-4" do %>
        <i class="bi bi-arrow-left text-xl"></i>
      <% end %>
      <div>
        <h1 class="text-3xl font-bold text-gray-900 flex items-center gap-3">
          <%= t('views.admin.prompt_personas.edit.title', key: @prompt_persona.key) %>
          <% if @prompt_persona.system? %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800 border border-purple-300">
              <i class="bi bi-shield-lock mr-1"></i><%= t('views.admin.prompt_personas.edit.system_badge') %>
            </span>
          <% end %>
        </h1>
        <p class="mt-2 text-sm text-gray-600"><%= t('views.admin.prompt_personas.edit.subtitle') %></p>
      </div>
    </div>

    <div class="bg-white border-2 border-black rounded-lg shadow-[2px_2px_0_0_#000000] p-6">
      <%= render 'form', prompt_persona: @prompt_persona %>
    </div>
  </div>
</div>

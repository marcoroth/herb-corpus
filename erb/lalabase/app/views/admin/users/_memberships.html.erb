<div class="mt-8">
  <h3 class="text-lg font-medium text-gray-900 mb-4">Organisation Memberships</h3>
  
  <div class="bg-white shadow overflow-hidden sm:rounded-md">
    <ul class="divide-y divide-gray-200">
      <% @memberships.each do |membership| %>
        <li class="px-6 py-4">
          <div class="flex items-center justify-between">
            <div class="flex-1">
              <p class="text-sm font-medium text-gray-900">
                <%= membership.organisation.name %>
              </p>
              <p class="text-sm text-gray-500">
                Role: <%= membership.role&.title || 'No role assigned' %>
                <% if membership.active? %>
                  <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    Active
                  </span>
                <% else %>
                  <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                    Inactive
                  </span>
                <% end %>
              </p>
              <p class="text-xs text-gray-400 mt-1">
                Member since: <%= membership.created_at.strftime('%B %d, %Y') %>
              </p>
            </div>
            
            <div class="ml-4">
              <%= button_to "Remove from Organisation", 
                  membership_admin_user_path(@user, membership), 
                  method: :delete,
                  data: {
                    turbo_confirm: t('views.confirm.remove_membership', name: @user.full_name, organisation: membership.organisation.name)
                  },
                  class: "inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
            </div>
          </div>
        </li>
      <% end %>
      
      <% if @memberships.empty? %>
        <li class="px-6 py-4 text-center text-gray-500">
          User has no organisation memberships
          <% if @user.deletion_recommended? %>
            <p class="mt-2 text-sm text-red-600">
              ⚠️ This user is flagged for deletion review
            </p>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</div>
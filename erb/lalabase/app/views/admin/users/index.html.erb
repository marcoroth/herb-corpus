<div class="container mx-auto px-4 py-8">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold mb-2"><%= t('views.admin.users.index.title') %></h1>
    <p class="text-gray-600"><%= t('views.admin.users.index.subtitle') %></p>
  </div>

  <!-- Statistik-Karten -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white border-2 border-black rounded-lg p-4 shadow-[2px_2px_0_0_#000000]">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600"><%= t('views.admin.users.index.total') %></p>
          <p class="text-2xl font-bold"><%= Admin::User.count %></p>
        </div>
        <i class="bi bi-people-fill text-3xl text-blue-500"></i>
      </div>
    </div>

    <div class="bg-white border-2 border-black rounded-lg p-4 shadow-[2px_2px_0_0_#000000]">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600"><%= t('views.common.active') %></p>
          <p class="text-2xl font-bold"><%= Admin::User.active.count %></p>
        </div>
        <i class="bi bi-person-check-fill text-3xl text-green-500"></i>
      </div>
    </div>

    <div class="bg-white border-2 border-black rounded-lg p-4 shadow-[2px_2px_0_0_#000000]">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600"><%= t('views.common.inactive') %></p>
          <p class="text-2xl font-bold"><%= Admin::User.inactive.count %></p>
        </div>
        <i class="bi bi-person-x-fill text-3xl text-red-500"></i>
      </div>
    </div>

    <div class="bg-white border-2 border-black rounded-lg p-4 shadow-[2px_2px_0_0_#000000]">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600"><%= t('views.common.deleted') %></p>
          <p class="text-2xl font-bold"><%= Admin::User.unscoped.where.not(deleted_at: nil).count %></p>
        </div>
        <i class="bi bi-trash-fill text-3xl text-gray-500"></i>
      </div>
    </div>
  </div>

  <!-- Filter -->
  <div class="bg-white border-2 border-black rounded-lg p-4 mb-6 shadow-[2px_2px_0_0_#000000]">
    <div class="flex flex-wrap gap-2">
      <%= link_to admin_users_path,
            class: "inline-flex items-center px-4 py-2 rounded-lg font-medium transition-all #{params[:status].blank? ? 'bg-black text-white' : 'bg-white border-2 border-black hover:shadow-[2px_2px_0_0_#000000]'}" do %>
        <%= t('views.common.all') %>
      <% end %>
      <%= link_to admin_users_path(status: 'active'),
            class: "inline-flex items-center px-4 py-2 rounded-lg font-medium transition-all #{params[:status] == 'active' ? 'bg-green-500 text-white border-2 border-black' : 'bg-white border-2 border-black hover:shadow-[2px_2px_0_0_#000000]'}" do %>
        <%= t('views.common.active') %>
      <% end %>
      <%= link_to admin_users_path(status: 'inactive'),
            class: "inline-flex items-center px-4 py-2 rounded-lg font-medium transition-all #{params[:status] == 'inactive' ? 'bg-red-500 text-white border-2 border-black' : 'bg-white border-2 border-black hover:shadow-[2px_2px_0_0_#000000]'}" do %>
        <%= t('views.common.inactive') %>
      <% end %>
      <%= link_to deleted_admin_users_path,
            class: "inline-flex items-center px-4 py-2 bg-white border-2 border-black rounded-lg font-medium hover:shadow-[2px_2px_0_0_#000000] transition-all" do %>
        <i class="bi bi-trash mr-2"></i>
        <%= t('views.admin.users.index.show_deleted') %>
      <% end %>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="mb-6">
    <%= link_to new_admin_user_path,
          class: "inline-flex items-center px-4 py-2 bg-black text-white rounded-lg font-medium hover:shadow-[2px_2px_0_0_#000000] transition-all" do %>
      <i class="bi bi-plus-lg mr-2"></i>
      <%= t('views.admin.users.index.create_new_user') %>
    <% end %>
  </div>

  <!-- Users Table -->
  <div class="bg-white border-2 border-black rounded-lg shadow-[2px_2px_0_0_#000000] overflow-hidden">
    <div class="px-4 py-3 border-b-2 border-black bg-gray-50">
      <h2 class="text-lg font-bold">
        <%= params[:status] == 'active' ? t('views.admin.users.index.active_users') : params[:status] == 'inactive' ? t('views.admin.users.index.inactive_users') : t('views.admin.users.index.all_users') %>
      </h2>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-100 border-b-2 border-black">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('views.admin.users.index.user') %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider hidden md:table-cell"><%= t('views.admin.users.index.created') %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider hidden lg:table-cell"><%= t('views.common.organisations') %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('views.common.status') %></th>
            <th class="px-4 py-3 text-center text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('views.common.actions') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @users.each do |user| %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-4 py-3">
                <div class="flex items-center">
                  <div class="flex-shrink-0 h-10 w-10">
                    <div class="h-10 w-10 rounded-lg border-2 border-black bg-blue-100 flex items-center justify-center font-bold">
                      <%= user.initials %>
                    </div>
                  </div>
                  <div class="ml-3">
                    <div class="text-sm font-bold"><%= user.display_name %></div>
                    <div class="text-sm text-gray-500"><%= user.email %></div>
                    <!-- Mobile: Show creation date and status -->
                    <div class="md:hidden text-xs text-gray-400 mt-1">
                      <%= user.created_at.strftime("%d.%m.%Y") %> •
                      <% if user.active? %>
                        <span class="text-green-600"><%= t('views.common.active') %></span>
                      <% else %>
                        <span class="text-red-600"><%= t('views.common.inactive') %></span>
                      <% end %>
                      <% if user.is_ai? %>
                        • <span class="text-purple-600"><%= t('views.common.ai') %></span>
                      <% end %>
                    </div>
                  </div>
                </div>
              </td>

              <td class="px-4 py-3 whitespace-nowrap hidden md:table-cell">
                <div>
                  <div class="text-sm font-medium"><%= user.created_at.strftime("%d.%m.%Y") %></div>
                  <div class="text-xs text-gray-500"><%= time_ago_in_words(user.created_at) %> <%= t('views.common.ago_suffix') %></div>
                </div>
              </td>

              <td class="px-4 py-3 hidden lg:table-cell">
                <% if user.organisations.any? %>
                  <div class="text-sm font-medium">
                    <%= t('views.admin.users.index.organisation_count', count: user.organisations.count) %>
                  </div>
                  <div class="text-xs text-gray-500">
                    <%= user.organisations.limit(2).pluck(:name).join(', ') %>
                    <% if user.organisations.count > 2 %>
                      <span>...</span>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-sm text-gray-400"><%= t('views.common.none') %></span>
                <% end %>
              </td>

              <td class="px-4 py-3 whitespace-nowrap">
                <div class="flex flex-col space-y-1">
                  <% if user.active? %>
                    <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-green-100 text-green-800 border border-green-300">
                      <%= t('views.common.active') %>
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-red-100 text-red-800 border border-red-300">
                      <%= t('views.common.inactive') %>
                    </span>
                  <% end %>
                  <% if user.is_ai? %>
                    <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-purple-100 text-purple-800 border border-purple-300">
                      <%= t('views.common.ai') %>
                    </span>
                  <% end %>
                  <% if user.deletion_scheduled? %>
                    <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-yellow-100 text-yellow-800 border border-yellow-300">
                      <%= t('views.admin.users.index.deletion_scheduled') %>
                    </span>
                  <% end %>
                </div>
              </td>

              <td class="px-4 py-3 text-center">
                <%= link_to admin_user_path(user),
                      class: "inline-flex items-center px-3 py-1 text-sm font-medium rounded-md bg-white border-2 border-black hover:shadow-[2px_2px_0_0_#000000] transition-all" do %>
                  <i class="bi bi-eye mr-1"></i>
                  <%= t('views.common.details') %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @users.empty? %>
      <div class="px-4 py-8 text-center text-gray-500">
        <i class="bi bi-people text-4xl mb-2"></i>
        <p><%= t('views.admin.users.index.no_users_found') %></p>
      </div>
    <% end %>
  </div>
</div>

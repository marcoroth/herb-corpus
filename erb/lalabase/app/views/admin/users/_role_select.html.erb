<turbo-frame id="role_select">
  <div>
    <label for="role_id" class="block text-sm font-medium text-gray-700 mb-2"><%= t('views.admin.users.role_select.role') %></label>
    <select name="role_id" id="role_id" required
            class="mt-1 block w-full rounded-md border-2 border-black shadow-sm focus:border-blue-500 focus:ring-blue-500">
      <option value=""><%= t('views.admin.users.role_select.select_role') %></option>
      <% roles.each do |role| %>
        <option value="<%= role.id %>"><%= role.display_title %></option>
      <% end %>
    </select>
  </div>
</turbo-frame>

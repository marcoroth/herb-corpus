<div class="container mx-auto px-4 py-8">
  <!-- Header -->
  <div class="mb-8">
    <nav class="mb-4" aria-label="Breadcrumb">
      <%= link_to t('views.admin.users.deleted.breadcrumb_users'), admin_users_path, class: "text-blue-600 hover:text-blue-800" %> &gt; <%= t('views.admin.users.deleted.title') %>
    </nav>

    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-3xl font-bold mb-2"><%= t('views.admin.users.deleted.title') %></h1>
        <p class="text-gray-600"><%= t('views.admin.users.deleted.subtitle') %></p>
      </div>

      <div class="flex items-center space-x-3">
        <%= link_to t('views.admin.users.deleted.active_users'), admin_users_path,
              class: "px-4 py-2 border-2 border-black rounded-lg hover:shadow-[2px_2px_0_0_#000000] transition-all" %>
      </div>
    </div>
  </div>

  <!-- Statistics Overview -->
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-8">
    <div class="bg-white border-2 border-black rounded-lg p-4 shadow-[2px_2px_0_0_#000000]">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600"><%= t('views.admin.users.deleted.total_deleted') %></p>
          <p class="text-2xl font-bold text-red-600"><%= @deletion_stats[:total_deleted] %></p>
        </div>
        <i class="bi bi-trash-fill text-3xl text-red-500"></i>
      </div>
    </div>

    <div class="bg-white border-2 border-black rounded-lg p-4 shadow-[2px_2px_0_0_#000000]">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600"><%= t('views.admin.users.deleted.today') %></p>
          <p class="text-2xl font-bold"><%= @deletion_stats[:deleted_today] %></p>
        </div>
        <i class="bi bi-calendar-day text-3xl text-blue-500"></i>
      </div>
    </div>

    <div class="bg-white border-2 border-black rounded-lg p-4 shadow-[2px_2px_0_0_#000000]">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600"><%= t('views.admin.users.deleted.this_week') %></p>
          <p class="text-2xl font-bold"><%= @deletion_stats[:deleted_this_week] %></p>
        </div>
        <i class="bi bi-calendar-week text-3xl text-green-500"></i>
      </div>
    </div>

    <div class="bg-white border-2 border-black rounded-lg p-4 shadow-[2px_2px_0_0_#000000]">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600"><%= t('views.admin.users.deleted.this_month') %></p>
          <p class="text-2xl font-bold"><%= @deletion_stats[:deleted_this_month] %></p>
        </div>
        <i class="bi bi-calendar-month text-3xl text-purple-500"></i>
      </div>
    </div>

    <div class="bg-white border-2 border-black rounded-lg p-4 shadow-[2px_2px_0_0_#000000]">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600"><%= t('views.admin.users.deleted.backend_deletions') %></p>
          <p class="text-2xl font-bold text-blue-600"><%= @deletion_stats[:backend_deletions] %></p>
        </div>
        <i class="bi bi-shield-check text-3xl text-blue-500"></i>
      </div>
    </div>

    <div class="bg-white border-2 border-black rounded-lg p-4 shadow-[2px_2px_0_0_#000000]">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600"><%= t('views.admin.users.deleted.self_service') %></p>
          <p class="text-2xl font-bold text-green-600"><%= @deletion_stats[:selfservice_deletions] %></p>
        </div>
        <i class="bi bi-person-x text-3xl text-green-500"></i>
      </div>
    </div>
  </div>

  <!-- Deleted Users List -->
  <div class="bg-white border-2 border-black rounded-lg shadow-[2px_2px_0_0_#000000] overflow-hidden">
    <div class="px-4 py-3 border-b-2 border-black bg-gray-50">
      <h2 class="text-lg font-bold"><%= t('views.admin.users.deleted.deleted_users_count', count: @deleted_users.count) %></h2>
    </div>

      <% if @deleted_users.any? %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-100 border-b-2 border-black">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  <%= t('views.admin.users.deleted.user_anonymized') %>
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  <%= t('views.admin.users.deleted.deleted_at') %>
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  <%= t('views.admin.users.deleted.deleted_by') %>
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  <%= t('views.admin.users.deleted.source') %>
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  <%= t('views.admin.users.deleted.reason') %>
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  <%= t('views.common.status') %>
                </th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @deleted_users.each do |user| %>
                <% deletion_record = @deletion_map[user.id] %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center">
                      <div class="flex-shrink-0 h-10 w-10">
                        <div class="h-10 w-10 rounded-full bg-red-100 flex items-center justify-center">
                          <span class="text-sm font-medium text-red-800">
                            <%= user.first_name&.first || 'A' %>
                          </span>
                        </div>
                      </div>
                      <div class="ml-4">
                        <div class="text-sm font-medium text-gray-900">
                          <%= user.first_name %> <%= user.last_name %>
                        </div>
                        <div class="text-sm text-gray-500">
                          <%= user.email %>
                        </div>
                        <div class="text-xs text-gray-400">
                          ID: <%= user.id %>
                        </div>
                      </div>
                    </div>
                  </td>

                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    <div><%= user.deleted_at&.strftime("%d.%m.%Y") %></div>
                    <div class="text-xs text-gray-500"><%= user.deleted_at&.strftime("%H:%M") %> <%= t('views.admin.users.deleted.clock_suffix') %></div>
                    <div class="text-xs text-gray-400">
                      <%= time_ago_in_words(user.deleted_at) %> <%= t('views.common.ago_suffix') %>
                    </div>
                  </td>

                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    <% if deletion_record&.deleter %>
                      <div class="font-medium">
                        <%= deletion_record.deleter.respond_to?(:email) ? deletion_record.deleter.email : "#{deletion_record.deleter.try(:firstname)} #{deletion_record.deleter.try(:lastname)}" %>
                      </div>
                      <div class="text-xs text-gray-500">
                        <%= deletion_record.deleter_type %>
                      </div>
                    <% else %>
                      <span class="text-gray-400"><%= t('views.common.unknown') %></span>
                    <% end %>
                  </td>

                  <td class="px-6 py-4 whitespace-nowrap">
                    <% if deletion_record %>
                      <% if deletion_record.source == 'backend' %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                          <%= t('views.admin.users.deleted.backend') %>
                        </span>
                      <% elsif deletion_record.source == 'selfservice' %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                          <%= t('views.admin.users.deleted.self_service') %>
                        </span>
                      <% else %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                          <%= deletion_record.source %>
                        </span>
                      <% end %>
                    <% else %>
                      <span class="text-gray-400">-</span>
                    <% end %>
                  </td>

                  <td class="px-6 py-4 text-sm text-gray-900">
                    <% if deletion_record&.reason.present? %>
                      <div class="max-w-xs truncate" title="<%= deletion_record.reason %>">
                        <%= deletion_record.reason %>
                      </div>
                    <% else %>
                      <span class="text-gray-400"><%= t('views.admin.users.deleted.no_reason') %></span>
                    <% end %>
                  </td>

                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex flex-col space-y-1">
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                        <%= t('views.common.deleted') %>
                      </span>
                      <% if user.deletion_recommended? %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                          <%= t('views.admin.users.deleted.recommended_deletion') %>
                        </span>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
      <div class="px-4 py-12 text-center">
        <div class="text-gray-400 text-6xl mb-4">&#128465;&#65039;</div>
        <h3 class="text-lg font-bold text-gray-900 mb-2"><%= t('views.admin.users.deleted.no_deleted_users') %></h3>
        <p class="text-gray-500"><%= t('views.admin.users.deleted.no_users_deleted_yet') %></p>
      </div>
      <% end %>
    </div>

    <!-- Additional Information -->
    <div class="mt-8 bg-blue-50 border border-blue-200 rounded-lg p-4">
      <div class="flex">
        <div class="ml-3">
          <h3 class="text-sm font-medium text-blue-800"><%= t('views.admin.users.deleted.info_title') %></h3>
          <div class="mt-2 text-sm text-blue-700">
            <p class="mb-2">
              <%= t('views.admin.users.deleted.info_text') %>
            </p>
            <ul class="list-disc list-inside space-y-1 ml-4">
              <li><%= t('views.admin.users.deleted.info_anonymized') %></li>
              <li><%= t('views.admin.users.deleted.info_memberships_removed') %></li>
              <li><%= t('views.admin.users.deleted.info_audit_trail') %></li>
              <li><%= t('views.admin.users.deleted.info_email_in_audit') %></li>
            </ul>
          </div>
        </div>
      </div>
    </div>

</div>

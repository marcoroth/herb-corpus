<div class="email-preview-container">
  <!-- Email Headers -->
  <div class="border-b pb-4 mb-4">
    <div class="grid grid-cols-2 gap-2 text-sm">
      <div class="flex">
        <span class="font-semibold text-gray-600 w-24"><%= t('views.admin.email_logs.show.from') %>:</span>
        <span class="text-gray-900"><%= @email_log.metadata&.dig('from') || 'noreply@localhost' %></span>
      </div>
      <div class="flex">
        <span class="font-semibold text-gray-600 w-24"><%= t('views.admin.email_logs.show.to') %>:</span>
        <span class="text-gray-900"><%= @email_log.recipient_email || t('views.common.na') %></span>
      </div>
      <div class="flex">
        <span class="font-semibold text-gray-600 w-24"><%= t('views.admin.email_logs.show.subject') %>:</span>
        <span class="text-gray-900"><%= @email_log.subject || @email_log.metadata&.dig('subject') || t('views.common.no_subject') %></span>
      </div>
      <div class="flex">
        <span class="font-semibold text-gray-600 w-24"><%= t('views.admin.email_logs.show.sent') %>:</span>
        <span class="text-gray-900">
          <%= @email_log.sent_at&.strftime('%B %d, %Y at %I:%M %p') ||
              @email_log.created_at.strftime('%B %d, %Y at %I:%M %p') %>
        </span>
      </div>
    </div>
  </div>

  <!-- Email Status -->
  <div class="bg-gray-50 rounded-lg p-4 mb-4">
    <h4 class="font-semibold text-gray-700 mb-2"><%= t('views.admin.email_logs.show.delivery_status') %></h4>
    <div class="flex items-center gap-4">
      <span class="px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full
        <%= case @email_log.status
            when 'delivered', 'opened', 'clicked' then 'bg-green-100 text-green-800'
            when 'bounced', 'failed', 'complaint' then 'bg-red-100 text-red-800'
            when 'sent' then 'bg-blue-100 text-blue-800'
            else 'bg-gray-100 text-gray-800'
            end %>">
        <%= @email_log.status.humanize %>
      </span>

      <% if @email_log.provider_message_id.present? %>
      <span class="text-sm text-gray-600">
        <%= t('views.admin.email_logs.show.message_id') %>: <code class="bg-gray-100 px-2 py-1 rounded"><%= @email_log.provider_message_id %></code>
      </span>
      <% end %>
    </div>

    <% if @email_log.metadata&.dig('error').present? %>
    <div class="mt-3 p-3 bg-red-50 border border-red-200 rounded">
      <p class="text-sm text-red-700">
        <strong><%= t('views.common.error') %>:</strong> <%= @email_log.metadata['error'] %>
      </p>
    </div>
    <% end %>

    <!-- Timeline -->
    <div class="mt-4">
      <h5 class="text-sm font-semibold text-gray-600 mb-2"><%= t('views.admin.email_logs.show.timeline') %></h5>
      <div class="space-y-2">
        <div class="flex items-center gap-2 text-sm">
          <i class="bi bi-clock text-gray-400"></i>
          <span><%= t('views.admin.email_logs.show.queued') %>: <%= @email_log.created_at.strftime('%H:%M:%S') %></span>
        </div>
        <% if @email_log.sent_at %>
        <div class="flex items-center gap-2 text-sm">
          <i class="bi bi-send text-blue-400"></i>
          <span><%= t('views.admin.email_logs.show.sent') %>: <%= @email_log.sent_at.strftime('%H:%M:%S') %></span>
        </div>
        <% end %>
        <% if @email_log.delivered_at %>
        <div class="flex items-center gap-2 text-sm">
          <i class="bi bi-check-circle text-green-400"></i>
          <span><%= t('views.admin.email_logs.show.delivered') %>: <%= @email_log.delivered_at.strftime('%H:%M:%S') %></span>
        </div>
        <% end %>
        <% if @email_log.opened_at %>
        <div class="flex items-center gap-2 text-sm">
          <i class="bi bi-envelope-open text-purple-400"></i>
          <span><%= t('views.admin.email_logs.show.opened') %>: <%= @email_log.opened_at.strftime('%H:%M:%S') %>
            <% if @email_log.open_count > 1 %>
              (<%= t('views.admin.email_logs.show.times', count: @email_log.open_count) %>)
            <% end %>
          </span>
        </div>
        <% end %>
        <% if @email_log.bounced_at %>
        <div class="flex items-center gap-2 text-sm">
          <i class="bi bi-x-circle text-red-400"></i>
          <span><%= t('views.admin.email_logs.show.bounced') %>: <%= @email_log.bounced_at.strftime('%H:%M:%S') %>
            <% if @email_log.bounce_type %>
              (<%= @email_log.bounce_type %>)
            <% end %>
          </span>
        </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Email Body Preview -->
  <div class="mb-4">
    <h4 class="font-semibold text-gray-700 mb-2"><%= t('views.admin.email_logs.show.email_content') %></h4>

    <% if @email_log.body_preview.present? %>
    <div class="bg-white border rounded-lg p-4 mb-2">
      <p class="text-sm text-gray-600"><%= t('views.admin.email_logs.show.preview_label') %>:</p>
      <p class="text-gray-900"><%= @email_log.body_preview %></p>
    </div>
    <% end %>

    <% if @email_log.body_html.present? %>
    <div class="border rounded-lg overflow-hidden">
      <div class="bg-gray-100 px-3 py-2 border-b">
        <span class="text-sm font-medium text-gray-700"><%= t('views.admin.email_logs.show.html_content') %></span>
      </div>
      <div class="p-4 bg-white">
        <iframe srcdoc="<%= html_escape(@email_log.body_html || '') %>"
                class="w-full h-96 border-0"
                sandbox=""
                referrerpolicy="no-referrer">
        </iframe>
      </div>
    </div>
    <% elsif @email_log.body_text.present? %>
    <div class="border rounded-lg overflow-hidden">
      <div class="bg-gray-100 px-3 py-2 border-b">
        <span class="text-sm font-medium text-gray-700"><%= t('views.admin.email_logs.show.text_content') %></span>
      </div>
      <div class="p-4 bg-white">
        <pre class="whitespace-pre-wrap text-sm text-gray-900"><%= @email_log.body_text %></pre>
      </div>
    </div>
    <% else %>
    <div class="bg-gray-50 rounded-lg p-8 text-center text-gray-500">
      <i class="bi bi-file-earmark-text text-4xl mb-2"></i>
      <p><%= t('views.admin.email_logs.show.no_content') %></p>
    </div>
    <% end %>
  </div>

  <!-- Additional Metadata -->
  <% if @email_log.metadata.present? && @email_log.metadata.keys.any? { |k| !['subject', 'from', 'to', 'error', 'sent_at'].include?(k) } %>
  <div class="border-t pt-4">
    <h4 class="font-semibold text-gray-700 mb-2"><%= t('views.admin.email_logs.show.additional_info') %></h4>
    <div class="bg-gray-50 rounded-lg p-3">
      <dl class="grid grid-cols-2 gap-2 text-sm">
        <% @email_log.metadata.except('subject', 'from', 'to', 'error', 'sent_at', 'body').each do |key, value| %>
        <div class="flex">
          <dt class="font-medium text-gray-600"><%= key.humanize %>:</dt>
          <dd class="ml-2 text-gray-900"><%= value.to_s.truncate(100) %></dd>
        </div>
        <% end %>
      </dl>
    </div>
  </div>
  <% end %>

  <!-- Actions -->
  <div class="border-t pt-4 mt-4 flex justify-between">
    <% if @email_log.can_resend? %>
    <%= button_to t('views.admin.email_logs.show.resend_email'), resend_admin_email_log_path(@email_log),
        method: :post,
        class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-green-600 hover:bg-green-700",
        data: { turbo_confirm: t('views.confirm.resend_email') } %>
    <% end %>

    <button onclick="closeEmailPreview()"
            class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
      <%= t('views.common.close') %>
    </button>
  </div>
</div>

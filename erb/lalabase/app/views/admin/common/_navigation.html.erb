<nav class="bg-white shadow-sm border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      <div class="flex">
        <div class="flex-shrink-0 flex items-center">
          <%= link_to admin_dashboard_path, class: "text-xl font-bold text-gray-900" do %>
            Lalabase - Backend
          <% end %>
        </div>

        <div class="hidden sm:ml-6 sm:flex sm:space-x-8">
          <!-- <%= t('.dashboard_individual') %> -->
          <%= link_to admin_dashboard_path,
              class: "inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium #{current_page?(admin_dashboard_path) ? 'border-lime-500 text-gray-900' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'}" do %>
            <%= t('.dashboard') %>
          <% end %>

          <!-- Verwaltung Dropdown -->
          <div class="relative inline-flex items-center" data-controller="dropdown">
            <button type="button"
                    data-dropdown-target="button"
                    data-action="click->dropdown#toggle"
                    class="inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 focus:outline-none">
              <%= t('.management') %>
              <i class="bi bi-chevron-down ml-1 text-xs"></i>
            </button>

            <div data-dropdown-target="menu"
                 class="hidden absolute left-0 top-full mt-2 w-56 bg-white rounded-md shadow-lg ring-1 ring-black ring-opacity-5 z-dropdown">
              <div class="py-1">
                <%= link_to admin_organisations_path,
                    class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{current_page?(admin_organisations_path) ? 'bg-lime-100 text-black font-bold' : ''}" do %>
                  <%= t('.organisations') %>
                <% end %>

                <%= admin_extension_slot(:navigation_management, variant: :desktop) %>

                <%= link_to admin_users_path,
                    class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{current_page?(admin_users_path) ? 'bg-lime-100 text-black font-bold' : ''}" do %>
                  <%= t('.users') %>
                <% end %>

                <%= link_to admin_beusers_path,
                    class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{current_page?(admin_beusers_path) ? 'bg-lime-100 text-black font-bold' : ''}" do %>
                  <%= t('views.admin.navigation.backend_admins') %>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Monitoring Dropdown -->
          <div class="relative inline-flex items-center" data-controller="dropdown">
            <button type="button"
                    data-dropdown-target="button"
                    data-action="click->dropdown#toggle"
                    class="inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 focus:outline-none">
              <%= t('views.admin.navigation.monitoring') %>
              <i class="bi bi-chevron-down ml-1 text-xs"></i>
            </button>

            <div data-dropdown-target="menu"
                 class="hidden absolute left-0 top-full mt-2 w-56 bg-white rounded-md shadow-lg ring-1 ring-black ring-opacity-5 z-dropdown">
              <div class="py-1">
                <%= link_to admin_user_activities_path,
                    class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{controller_name == 'user_activities' && action_name == 'index' ? 'bg-lime-100 text-black font-bold' : ''}" do %>
                  <%= t('views.admin.navigation.all_activities') %>
                <% end %>

                <%= link_to security_admin_user_activities_path,
                    class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{controller_name == 'user_activities' && action_name == 'security' ? 'bg-lime-100 text-black font-bold' : ''}" do %>
                  <%= t('views.admin.navigation.security_events') %>
                <% end %>

                <%= link_to "/admin/jobs",
                    class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{request.path.start_with?('/admin/jobs') ? 'bg-lime-100 text-black font-bold' : ''}" do %>
                  <i class="bi bi-gear-fill mr-2"></i>
                  <%= t('views.admin.navigation.job_queue') %>
                <% end %>

                <%= link_to admin_email_logs_path,
                    class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{controller_name == 'email_logs' ? 'bg-lime-100 text-black font-bold' : ''}" do %>
                  <i class="bi bi-envelope-fill mr-2"></i>
                  <%= t('views.admin.navigation.email_dashboard') %>
                <% end %>

                <%= admin_extension_slot(:navigation_monitoring, variant: :desktop) %>

                <%= link_to admin_deletion_register_path,
                    class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{controller_name == 'deletion_registers' ? 'bg-lime-100 text-black font-bold' : ''}" do %>
                  <i class="bi bi-trash3-fill mr-2"></i>
                  <%= t('views.admin.navigation.deletion_register') %>
                <% end %>

                <%= link_to admin_monitoring_path,
                    class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{controller_name == 'monitoring' ? 'bg-lime-100 text-black font-bold' : ''}" do %>
                  <i class="bi bi-activity mr-2"></i>
                  <%= t('views.admin.navigation.system_monitoring') %>
                <% end %>

                <div class="border-t border-gray-200"></div>

                <%= link_to deleted_admin_users_path,
                    class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{current_page?(deleted_admin_users_path) ? 'bg-lime-100 text-black font-bold' : ''}" do %>
                  <%= t('views.admin.navigation.deleted_users') %>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Einstellungen Dropdown -->
          <div class="relative inline-flex items-center" data-controller="dropdown">
            <button type="button"
                    data-dropdown-target="button"
                    data-action="click->dropdown#toggle"
                    class="inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 focus:outline-none">
              <%= t('views.admin.navigation.settings') %>
              <i class="bi bi-chevron-down ml-1 text-xs"></i>
            </button>

            <div data-dropdown-target="menu"
                 class="hidden absolute left-0 top-full mt-2 w-56 bg-white rounded-md shadow-lg ring-1 ring-black ring-opacity-5 z-dropdown">
              <div class="py-1">
                <%= link_to admin_system_settings_path,
                    class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{current_page?(admin_system_settings_path) ? 'bg-lime-100 text-black font-bold' : ''}" do %>
                  <%= t('.system_settings') %>
                <% end %>

                <%= link_to admin_ai_credentials_path,
                    class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{current_page?(admin_ai_credentials_path) ? 'bg-lime-100 text-black font-bold' : ''}" do %>
                  <%= t('.ai_credentials') %>
                <% end %>

                <%# Right next to the credentials: those are the stock room,
                    packages the shop window (§7b.1). %>
                <%= link_to admin_ai_packages_path,
                    class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{current_page?(admin_ai_packages_path) ? 'bg-lime-100 text-black font-bold' : ''}" do %>
                  <%= t('views.admin.navigation.ai_packages') %>
                <% end %>

                <%= link_to admin_prompt_personas_path,
                    class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{current_page?(admin_prompt_personas_path) ? 'bg-lime-100 text-black font-bold' : ''}" do %>
                  <%= t('views.admin.navigation.prompt_personas') %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- <%= t('.user_menu_right') %> -->
      <div class="hidden sm:ml-6 sm:flex sm:items-center">
        <div class="relative" data-controller="dropdown">
          <button type="button"
                  data-dropdown-target="button"
                  data-action="click->dropdown#toggle"
                  class="flex items-center text-sm rounded-full focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-black">
            <span class="inline-flex items-center px-3 py-2 text-sm text-gray-700 hover:text-gray-900">
              <i class="bi bi-person-circle mr-2 text-lg"></i>
              <span class="font-medium"><%= current_user&.firstname || current_user&.email || 'Admin' %></span>
              <i class="bi bi-chevron-down ml-2 text-xs"></i>
            </span>
          </button>

          <div data-dropdown-target="menu"
               class="hidden absolute right-0 top-full mt-2 w-48 bg-white rounded-md shadow-lg ring-1 ring-black ring-opacity-5 z-dropdown">
            <div class="py-1">
              <div class="px-4 py-2 text-xs text-gray-500 border-b border-gray-200">
                <%= t('.logged_in_as') %><br>
                <span class="font-medium text-gray-700"><%= current_user&.email %></span>
              </div>

              <%= link_to edit_admin_beuser_path(current_user),
                  class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" do %>
                <%= t('.my_profile') %>
              <% end %>

              <%= link_to edit_password_admin_beuser_path(current_user),
                  class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" do %>
                <%= t('.change_password') %>
              <% end %>

              <div class="border-t border-gray-200"></div>

              <%= link_to admin_log_out_path,
                  class: "block px-4 py-2 text-sm text-red-600 hover:bg-red-50" do %>
                <%= t('views.admin.navigation.logout') %>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Mobile menu button -->
      <div class="sm:hidden flex items-center">
        <button type="button"
                class="bg-white inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-black"
                data-controller="toggle"
                data-action="click->toggle#toggle">
          <span class="sr-only"><%= t('views.admin.navigation.open_main_menu') %></span>
          <i class="bi bi-list text-2xl"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="sm:hidden hidden" data-controller="toggle" data-toggle-target="content">
    <div class="pt-2 pb-3 space-y-1">
      <!-- Dashboard -->
      <%= link_to admin_dashboard_path,
          class: "block px-4 py-2 text-base font-medium #{current_page?(admin_dashboard_path) ? 'bg-lime-100 border-l-4 border-lime-500 text-black font-bold' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'}" do %>
        <%= t('views.admin.navigation.dashboard') %>
      <% end %>

      <!-- Verwaltung Section -->
      <div class="border-t border-gray-200 pt-2">
        <div class="px-4 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">
          <%= t('views.admin.navigation.management_section') %>
        </div>
        <%= link_to admin_organisations_path,
            class: "block px-4 py-2 text-base font-medium #{current_page?(admin_organisations_path) ? 'bg-lime-100 border-l-4 border-lime-500 text-black font-bold' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'}" do %>
          <%= t('views.admin.navigation.organisations') %>
        <% end %>

        <%= admin_extension_slot(:navigation_management, variant: :mobile) %>

        <%= link_to admin_users_path,
            class: "block px-4 py-2 text-base font-medium #{current_page?(admin_users_path) ? 'bg-lime-100 border-l-4 border-lime-500 text-black font-bold' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'}" do %>
          <%= t('views.admin.navigation.users') %>
        <% end %>

        <%= link_to admin_beusers_path,
            class: "block px-4 py-2 text-base font-medium #{current_page?(admin_beusers_path) ? 'bg-lime-100 border-l-4 border-lime-500 text-black font-bold' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'}" do %>
          <%= t('views.admin.navigation.backend_admins') %>
        <% end %>
      </div>

      <!-- Monitoring Section -->
      <div class="border-t border-gray-200 pt-2">
        <div class="px-4 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">
          <%= t('views.admin.navigation.monitoring_section') %>
        </div>
        <%= link_to admin_user_activities_path,
            class: "block px-4 py-2 text-base font-medium #{controller_name == 'user_activities' ? 'bg-lime-100 border-l-4 border-lime-500 text-black font-bold' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'}" do %>
          <%= t('views.admin.navigation.activities') %>
        <% end %>

        <%= link_to security_admin_user_activities_path,
            class: "block px-4 py-2 text-base font-medium text-gray-600 hover:bg-gray-50 hover:text-gray-900" do %>
          <%= t('views.admin.navigation.security_events') %>
        <% end %>

        <%= link_to "/admin/jobs",
            class: "block px-4 py-2 text-base font-medium #{request.path.start_with?('/admin/jobs') ? 'bg-lime-100 border-l-4 border-lime-500 text-black font-bold' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'}" do %>
          <i class="bi bi-gear-fill mr-2"></i>
          <%= t('views.admin.navigation.job_queue') %>
        <% end %>

        <%= link_to admin_email_logs_path,
            class: "block px-4 py-2 text-base font-medium #{controller_name == 'email_logs' ? 'bg-lime-100 border-l-4 border-lime-500 text-black font-bold' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'}" do %>
          <i class="bi bi-envelope-fill mr-2"></i>
          <%= t('views.admin.navigation.email_dashboard') %>
        <% end %>

        <%= admin_extension_slot(:navigation_monitoring, variant: :mobile) %>

        <%= link_to admin_deletion_register_path,
            class: "block px-4 py-2 text-base font-medium #{controller_name == 'deletion_registers' ? 'bg-lime-100 border-l-4 border-lime-500 text-black font-bold' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'}" do %>
          <i class="bi bi-trash3-fill mr-2"></i>
          <%= t('views.admin.navigation.deletion_register') %>
        <% end %>

        <%= link_to admin_monitoring_path,
            class: "block px-4 py-2 text-base font-medium #{controller_name == 'monitoring' ? 'bg-lime-100 border-l-4 border-lime-500 text-black font-bold' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'}" do %>
          <i class="bi bi-activity mr-2"></i>
          <%= t('views.admin.navigation.system_monitoring') %>
        <% end %>
      </div>

      <!-- Einstellungen Section -->
      <div class="border-t border-gray-200 pt-2">
        <div class="px-4 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">
          <%= t('views.admin.navigation.settings_section') %>
        </div>
        <%= link_to admin_system_settings_path,
            class: "block px-4 py-2 text-base font-medium #{current_page?(admin_system_settings_path) ? 'bg-lime-100 border-l-4 border-lime-500 text-black font-bold' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'}" do %>
          <%= t('views.admin.navigation.system_settings') %>
        <% end %>

        <%= link_to admin_ai_credentials_path,
            class: "block px-4 py-2 text-base font-medium #{current_page?(admin_ai_credentials_path) ? 'bg-lime-100 border-l-4 border-lime-500 text-black font-bold' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'}" do %>
          <%= t('views.admin.navigation.ai_credentials') %>
        <% end %>

        <%# The navigation exists twice — every settings entry needs BOTH the
            desktop dropdown above and this mobile list. %>
        <%= link_to admin_ai_packages_path,
            class: "block px-4 py-2 text-base font-medium #{current_page?(admin_ai_packages_path) ? 'bg-lime-100 border-l-4 border-lime-500 text-black font-bold' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'}" do %>
          <%= t('views.admin.navigation.ai_packages') %>
        <% end %>

        <%= link_to admin_prompt_personas_path,
            class: "block px-4 py-2 text-base font-medium #{current_page?(admin_prompt_personas_path) ? 'bg-lime-100 border-l-4 border-lime-500 text-black font-bold' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'}" do %>
          <%= t('views.admin.navigation.prompt_personas') %>
        <% end %>
      </div>

      <!-- User Section -->
      <div class="border-t border-gray-200 pt-4 pb-3">
        <div class="flex items-center px-4">
          <div>
            <div class="text-base font-medium text-gray-800">
              <%= current_user&.firstname || 'Admin' %>
            </div>
            <div class="text-sm text-gray-500">
              <%= current_user&.email %>
            </div>
          </div>
        </div>
        <div class="mt-3 space-y-1">
          <%= link_to admin_log_out_path,
              class: "block px-4 py-2 text-base font-medium text-red-600 hover:bg-red-50" do %>
            <%= t('views.admin.navigation.logout') %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</nav>

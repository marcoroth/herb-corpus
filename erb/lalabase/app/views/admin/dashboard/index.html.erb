<% content_for :title, t('admin.dashboard.title') %>

<div class="container mx-auto px-4 py-8">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold mb-2"><%= t('admin.dashboard.title') %></h1>
    <p class="text-gray-600"><%= t('admin.dashboard.subtitle') %></p>
  </div>

  <!-- Verwaltung -->
  <section class="mb-8">
    <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-3">
      <%= t('admin.dashboard.group_management') %>
    </h2>
    <%# Three tiles of its own; a fourth column only when the slot brings one. %>
    <div class="grid grid-cols-1 sm:grid-cols-2 <%= admin_extension_slot?(:dashboard_management_tiles) ? 'lg:grid-cols-4' : 'lg:grid-cols-3' %> gap-6">
      <%= render 'tile', path: admin_organisations_path, icon: 'building', icon_color: 'text-lime-600',
                         title: t('admin.dashboard.organisations'), count: @organisation_count %>
      <%= render 'tile', path: admin_users_path, icon: 'people', icon_color: 'text-green-600',
                         title: t('admin.dashboard.users'), count: @user_count %>
      <%= render 'tile', path: admin_beusers_path, icon: 'shield-check', icon_color: 'text-purple-600',
                         title: t('admin.dashboard.admins'), count: @admin_count %>
      <%= admin_extension_slot(:dashboard_management_tiles) %>
    </div>
  </section>

  <!-- Monitoring -->
  <section class="mb-8">
    <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-3">
      <%= t('admin.dashboard.group_monitoring') %>
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <%= render 'tile', path: '/admin/jobs', icon: 'gear-fill', icon_color: 'text-blue-600',
                         title: t('admin.dashboard.job_queue'), description: t('admin.dashboard.job_queue_desc') %>
      <%= render 'tile', path: admin_email_logs_path, icon: 'envelope-fill', icon_color: 'text-amber-600',
                         title: t('admin.dashboard.email_dashboard'), description: t('admin.dashboard.email_dashboard_desc') %>
      <%= render 'tile', path: admin_monitoring_path, icon: 'activity', icon_color: 'text-rose-600',
                         title: t('admin.dashboard.system_monitoring'), description: t('admin.dashboard.system_monitoring_desc') %>
    </div>
  </section>

  <!-- Einstellungen -->
  <section>
    <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-3">
      <%= t('admin.dashboard.group_settings') %>
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <%= render 'tile', path: admin_system_settings_path, icon: 'sliders', icon_color: 'text-gray-700',
                         title: t('admin.dashboard.system_settings'), description: t('admin.dashboard.system_settings_desc') %>
      <%= render 'tile', path: admin_ai_credentials_path, icon: 'key-fill', icon_color: 'text-indigo-600',
                         title: t('admin.dashboard.ai_credentials'), description: t('admin.dashboard.ai_credentials_desc') %>
      <%= render 'tile', path: admin_prompt_personas_path, icon: 'chat-dots', icon_color: 'text-teal-600',
                         title: t('admin.dashboard.prompt_personas'), description: t('admin.dashboard.prompt_personas_desc') %>
    </div>
  </section>
</div>

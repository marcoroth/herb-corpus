<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
    <div>
      <h1 class="admin-page-title mb-0"><%= t('views.admin.monitoring.index.title') %></h1>
      <p class="text-sm text-gray-500"><%= t('views.admin.monitoring.index.subtitle') %></p>
    </div>
  </div>

  <div class="admin-card">
    <dl class="admin-definition-list">
      <div class="admin-definition-list__row">
        <dt><%= t('views.admin.monitoring.index.last_deployment') %></dt>
        <dd>
          <% if @last_deployed_at.present? %>
            <%= l(@last_deployed_at, format: :long) %>
          <% else %>
            <span class="text-gray-500"><%= t('views.common.unknown') %></span>
          <% end %>
        </dd>
      </div>

      <div class="admin-definition-list__row">
        <dt><%= t('views.admin.monitoring.index.current_commit') %></dt>
        <dd>
          <% if @commit_hash.present? %>
            <code class="inline-block bg-gray-100 border border-gray-200 rounded px-2 py-1 text-xs"><%= @commit_hash %></code>
          <% else %>
            <span class="text-gray-500"><%= t('views.common.unknown') %></span>
          <% end %>
        </dd>
      </div>
    </dl>
  </div>
</div>

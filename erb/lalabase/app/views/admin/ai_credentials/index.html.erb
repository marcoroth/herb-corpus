<div class="container mx-auto px-4 py-8">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold mb-2"><%= t('.title') %></h1>
    <p class="text-gray-600"><%= t('.subtitle') %></p>
  </div>

  <!-- Provider Overview Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <% @provider_stats.each do |provider, stats| %>
      <div class="bg-white border-2 border-black rounded-lg shadow-[2px_2px_0_0_#000000] overflow-hidden">
          <div class="p-5">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <i class="bi bi-<%= provider == AiCredential::PROVIDER_OPENAI ? 'cpu' : 'robot' %> text-2xl text-lime-600"></i>
              </div>
              <div class="ml-5 w-0 flex-1">
                <dl>
                  <dt class="text-sm font-medium text-gray-500 truncate">
                    <%= AiCredential.provider_display_names[provider] %>
                  </dt>
                  <dd class="text-lg font-medium text-gray-900">
                    <%= t('views.admin.ai_credentials.index.active_count', enabled: stats[:enabled], total: stats[:total]) %>
                  </dd>
                </dl>
              </div>
            </div>

            <% if stats[:active] %>
              <div class="mt-3">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                  <i class="bi bi-check-circle mr-1"></i>
                  <%= stats[:active].name %>
                </span>
              </div>
            <% else %>
              <div class="mt-3">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                  <i class="bi bi-x-circle mr-1"></i>
                  <%= t('views.admin.ai_credentials.index.no_active_credential') %>
                </span>
              </div>
            <% end %>

            <div class="mt-3 text-xs text-gray-500">
              <%= t('views.admin.ai_credentials.index.tokens_30d', count: number_with_delimiter(stats[:usage_30d])) %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

  <!-- Statistics Summary -->
  <div class="bg-white border-2 border-black rounded-lg p-4 mb-6 shadow-[2px_2px_0_0_#000000]">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-6">
        <div>
          <p class="text-sm text-gray-600"><%= t('views.admin.ai_credentials.index.total_credentials') %></p>
          <p class="text-2xl font-bold"><%= @ai_credentials.count %></p>
        </div>
        <div>
          <p class="text-sm text-gray-600"><%= t('views.admin.ai_credentials.index.active_providers') %></p>
          <p class="text-2xl font-bold text-green-600"><%= @provider_stats.count { |_, stats| stats[:active] } %></p>
        </div>
      </div>
      <div>
        <%= link_to new_admin_ai_credential_path,
            class: "inline-flex items-center px-4 py-2 border-2 border-black rounded-lg bg-black text-white hover:shadow-[2px_2px_0_0_#000000] transition-all" do %>
          <i class="bi bi-plus mr-2"></i>
          <%= t('views.admin.ai_credentials.index.add_credential') %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Credentials Table -->
  <div class="bg-white border-2 border-black rounded-lg shadow-[2px_2px_0_0_#000000] overflow-hidden">
    <div class="px-4 py-3 border-b-2 border-black bg-gray-50">
      <h2 class="text-lg font-bold"><%= t('views.admin.ai_credentials.index.table_title') %></h2>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-100 border-b-2 border-black">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                <div class="flex items-center">
                  <i class="bi bi-tag text-gray-400 mr-2"></i>
                  <%= t('views.admin.ai_credentials.index.th_credential') %>
                </div>
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                <div class="flex items-center">
                  <i class="bi bi-cpu text-gray-400 mr-2"></i>
                  <%= t('views.admin.ai_credentials.index.th_provider_model') %>
                </div>
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                <div class="flex items-center">
                  <i class="bi bi-bullseye text-gray-400 mr-2"></i>
                  <%= t('views.admin.ai_credentials.index.th_purpose') %>
                </div>
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                <div class="flex items-center">
                  <i class="bi bi-box-seam text-gray-400 mr-2"></i>
                  <%= t('views.admin.ai_credentials.index.th_packages') %>
                </div>
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                <div class="flex items-center">
                  <i class="bi bi-cash-coin text-gray-400 mr-2"></i>
                  <%= t('views.admin.ai_credentials.index.th_billing') %>
                </div>
              </th>
              <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                <div class="flex items-center justify-end">
                  <i class="bi bi-graph-up text-gray-400 mr-2"></i>
                  <%= t('views.admin.ai_credentials.index.th_usage_30d') %>
                </div>
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                <div class="flex items-center">
                  <i class="bi bi-toggle-on text-gray-400 mr-2"></i>
                  <%= t('views.admin.ai_credentials.index.th_status') %>
                </div>
              </th>
              <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                <div class="flex items-center justify-end">
                  <i class="bi bi-gear text-gray-400 mr-2"></i>
                  <%= t('views.admin.ai_credentials.index.th_actions') %>
                </div>
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @ai_credentials.each do |credential| %>
              <tr class="hover:bg-gray-50 transition-colors duration-200 <%= 'bg-blue-50' if credential.active? %>">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center">
                    <div class="flex-shrink-0 h-10 w-10">
                      <div class="h-10 w-10 rounded-full <%= credential.enabled? ? 'bg-green-100' : 'bg-gray-100' %> flex items-center justify-center">
                        <span class="text-sm font-medium <%= credential.enabled? ? 'text-green-800' : 'text-gray-500' %>">
                          <%= credential.provider.first.upcase %>
                        </span>
                      </div>
                    </div>
                    <div class="ml-4">
                      <div class="text-sm font-medium text-gray-900 flex items-center">
                        <%= credential.name %>
                        <% if credential.active? %>
                          <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                            <i class="bi bi-star-fill mr-1"></i>
                            <%= t('views.admin.ai_credentials.index.badge_active') %>
                          </span>
                        <% end %>
                      </div>
                      <%# The effective name carries what the provider value lost once
                          three EU presets all run as openai_compatible. %>
                      <% if credential.display_name.present? && credential.display_name != credential.name %>
                        <div class="text-sm text-gray-500">
                          <%= credential.display_name %>
                        </div>
                      <% end %>
                      <% if credential.description.present? %>
                        <div class="text-sm text-gray-500">
                          <%= truncate(credential.description, length: 50) %>
                        </div>
                      <% end %>
                      <div class="text-xs text-gray-400 font-mono mt-0.5">
                        <%= credential.key_fingerprint %>
                      </div>
                      <% if credential.organization_id.present? %>
                        <div class="text-xs text-gray-400">
                          Org: <%= credential.organization_id %>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex flex-col space-y-1">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= credential.provider == AiCredential::PROVIDER_OPENAI ? 'bg-green-100 text-green-800' : 'bg-purple-100 text-purple-800' %>">
                      <i class="bi bi-<%= credential.provider == AiCredential::PROVIDER_OPENAI ? 'cpu' : 'robot' %> mr-1"></i>
                      <%= credential.provider_display_name %>
                    </span>
                    <% if credential.default_model.present? %>
                      <span class="text-xs text-gray-500">
                        Model: <%= credential.default_model %>
                      </span>
                    <% end %>
                    <% if credential.region.present? %>
                      <span class="text-xs text-gray-500">
                        <i class="bi bi-globe mr-1"></i><%= credential.region %>
                      </span>
                    <% end %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% purpose_css = { 'chat' => 'bg-blue-100 text-blue-800', 'embedding' => 'bg-purple-100 text-purple-800', 'both' => 'bg-indigo-100 text-indigo-800' } %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= purpose_css.fetch(credential.purpose, 'bg-gray-100 text-gray-800') %>">
                    <%= t("views.admin.ai_credentials.index.purpose.#{credential.purpose}", default: credential.purpose.to_s.capitalize) %>
                  </span>
                </td>
                <td class="px-6 py-4">
                  <%# Deliberate twin of the "Referenziert von" badges on show.html.erb:
                      the shared part is one link_to, the surroundings differ (table cell
                      vs. section). A third rendering is the moment to extract a partial. %>
                  <% references = @package_references_by_credential.fetch(credential.id, []) %>
                  <% if references.any? %>
                    <div class="flex flex-col items-start space-y-1">
                      <% references.each do |reference| %>
                        <%= link_to admin_ai_package_path(reference[:package]),
                            class: "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800 hover:bg-amber-200 transition-colors" do %>
                          <i class="bi bi-box-seam mr-1"></i>
                          <%= t('views.admin.ai_credentials.shared.package_badge',
                                package: reference[:package].name,
                                role: reference[:label].presence || t('views.admin.ai_credentials.shared.package_role_embedding')) %>
                        <% end %>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="text-sm text-gray-400"><%= t('views.admin.ai_credentials.index.packages_none') %></span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if credential.included_in_quota? %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
                      <i class="bi bi-cash-coin mr-1"></i>
                      <%= t('views.admin.ai_credentials.index.billing_metered') %>
                    </span>
                    <div class="mt-1 text-xs text-gray-500 font-mono tabular-nums">
                      <% if AiCredentialPricing::CHAT_PURPOSES.include?(credential.purpose) %>
                        <div><%= t('views.admin.ai_credentials.index.price_in_out', in: credential.input_cost_per_1m_cents, out: credential.output_cost_per_1m_cents) %></div>
                      <% end %>
                      <% if AiCredentialPricing::EMBEDDING_PURPOSES.include?(credential.purpose) %>
                        <div><%= t('views.admin.ai_credentials.index.price_embedding', emb: credential.embedding_cost_per_1m_cents) %></div>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                      <%= t('views.admin.ai_credentials.index.billing_unmetered') %>
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right">
                  <% usage = @usage_by_credential[credential.id] || { tokens: 0, cost_cents: 0 } %>
                  <% if usage[:tokens].to_i.positive? %>
                    <div class="text-sm font-medium text-gray-900 tabular-nums">
                      <%= t('views.admin.ai_credentials.index.usage_tokens', count: number_with_delimiter(usage[:tokens])) %>
                    </div>
                    <% if usage[:cost_cents].to_f.positive? %>
                      <div class="text-xs text-gray-500 tabular-nums">
                        <%= t('views.admin.ai_credentials.index.usage_cost', cost: number_to_currency(usage[:cost_cents].to_f / 100.0, unit: '€')) %>
                      </div>
                    <% end %>
                  <% else %>
                    <span class="text-sm text-gray-400"><%= t('views.admin.ai_credentials.index.usage_none') %></span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex flex-col space-y-1">
                    <% if credential.enabled? %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                        <i class="bi bi-check-circle mr-1"></i>
                        <%= t('views.admin.ai_credentials.index.status_enabled') %>
                      </span>
                    <% else %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                        <i class="bi bi-x-circle mr-1"></i>
                        <%= t('views.admin.ai_credentials.index.status_disabled') %>
                      </span>
                    <% end %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <div class="flex items-center justify-end space-x-2">
                    <%# Plain GET link to the detail page (model-availability matrix
                        lives there) — no turbo_method, so it works reliably in the
                        admin area where rails-ujs is disabled. %>
                    <%= link_to admin_ai_credential_path(credential),
                        class: "inline-flex items-center px-2 py-1 border-2 border-black rounded-lg hover:shadow-[2px_2px_0_0_#000000] transition-all",
                        title: t('views.admin.ai_credentials.index.tooltip_details') do %>
                      <i class="bi bi-eye"></i>
                    <% end %>

                    <%# button_to (native form POST): data-turbo-method is unreliable
                        in the admin area — same reason as the vertex-availability
                        button. %>
                    <%= button_to test_connection_admin_ai_credential_path(credential),
                        form_class: "inline-block",
                        class: "inline-flex items-center px-2 py-1 border-2 border-black rounded-lg hover:shadow-[2px_2px_0_0_#000000] transition-all",
                        title: t('views.admin.ai_credentials.index.tooltip_test_connection') do %>
                      <i class="bi bi-wifi"></i>
                    <% end %>

                    <%= link_to edit_admin_ai_credential_path(credential),
                        class: "inline-flex items-center px-2 py-1 border-2 border-black rounded-lg hover:shadow-[2px_2px_0_0_#000000] transition-all" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>

                    <% unless credential.active? %>
                      <%# Sets this credential as the provider's default. button_to
                          (native form PATCH) for the same reason as the test-connection
                          button above: data-turbo-method is unreliable here. %>
                      <%= button_to activate_admin_ai_credential_path(credential),
                          method: :patch,
                          form_class: "inline-block",
                          class: "inline-flex items-center px-2 py-1 border-2 border-black rounded-lg bg-blue-100 hover:bg-blue-200 hover:shadow-[2px_2px_0_0_#000000] transition-all",
                          title: t('views.admin.ai_credentials.index.btn_set_default') do %>
                        <i class="bi bi-star"></i>
                      <% end %>
                    <% end %>

                    <%= link_to toggle_enabled_admin_ai_credential_path(credential),
                        data: { turbo_method: :patch },
                        class: "inline-flex items-center px-2 py-1 border-2 border-black rounded-lg bg-yellow-100 hover:bg-yellow-200 hover:shadow-[2px_2px_0_0_#000000] transition-all" do %>
                      <i class="bi bi-toggle-<%= credential.enabled? ? 'off' : 'on' %>"></i>
                    <% end %>

                    <%= link_to admin_ai_credential_path(credential),
                        data: {
                          turbo_method: :delete,
                          turbo_confirm: t('views.confirm.delete_ai_credential')
                        },
                        class: "inline-flex items-center px-2 py-1 border-2 border-black rounded-lg bg-red-100 hover:bg-red-200 hover:shadow-[2px_2px_0_0_#000000] transition-all" do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @ai_credentials.empty? %>
        <div class="px-4 py-12 text-center">
          <i class="bi bi-cpu text-gray-400 text-4xl mb-4"></i>
          <h3 class="text-lg font-bold text-gray-900 mb-2"><%= t('views.admin.ai_credentials.index.empty_title') %></h3>
          <p class="text-gray-500 mb-4"><%= t('views.admin.ai_credentials.index.empty_description') %></p>
          <%= link_to new_admin_ai_credential_path,
              class: "inline-flex items-center px-4 py-2 border-2 border-black rounded-lg bg-black text-white hover:shadow-[2px_2px_0_0_#000000] transition-all" do %>
            <i class="bi bi-plus mr-2"></i>
            <%= t('views.admin.ai_credentials.index.empty_add_first') %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

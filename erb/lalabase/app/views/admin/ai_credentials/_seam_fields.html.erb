<%# S2: routing (effective name + endpoint) and metering (per-1M-token prices) %>
<%# fields, shared by new + edit so the two forms cannot drift. `form` is passed in. %>
<% input_class = "w-full pl-3 pr-3 py-2 border border-black rounded text-sm focus:outline-none focus:-translate-x-0.5 focus:-translate-y-0.5 focus:shadow-[2px_2px_0_0_#000000] focus:ring-0 transition-all" %>

<div class="pb-6">
  <h3 class="text-lg font-medium leading-6 text-gray-900 mb-4">
    <i class="bi bi-diagram-3 text-gray-400 mr-2"></i>
    <%= t('views.admin.ai_credentials.seam.section_routing') %>
  </h3>
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :display_name, t('views.admin.ai_credentials.seam.label_display_name'), class: "block text-sm font-bold text-gray-900" %>
      <%= form.text_field :display_name, class: input_class, placeholder: t('views.admin.ai_credentials.seam.placeholder_display_name') %>
      <p class="mt-1 text-sm text-gray-500"><%= t('views.admin.ai_credentials.seam.display_name_help') %></p>
    </div>

    <div>
      <%= form.label :purpose, t('views.admin.ai_credentials.seam.label_purpose'), class: "block text-sm font-bold text-gray-900" %>
      <%= form.select :purpose,
            options_for_select(AiCredential::PURPOSES.map { |p| [t("views.admin.ai_credentials.seam.purpose_#{p}"), p] }, @ai_credential.purpose),
            {}, class: input_class %>
    </div>

    <div class="sm:col-span-2">
      <%= form.label :api_base, t('views.admin.ai_credentials.seam.label_api_base'), class: "block text-sm font-bold text-gray-900" %>
      <%= form.text_field :api_base, class: input_class, autocomplete: "off",
            placeholder: t('views.admin.ai_credentials.seam.placeholder_api_base') %>
      <p class="mt-1 text-sm text-gray-500"><%= t('views.admin.ai_credentials.seam.api_base_help') %></p>
    </div>

    <div>
      <%= form.label :region, t('views.admin.ai_credentials.seam.label_region'), class: "block text-sm font-bold text-gray-900" %>
      <%= form.select :region,
            options_for_select([[t('views.admin.ai_credentials.seam.region_none'), ''], ['US', 'us'], ['EU', 'eu']], @ai_credential.region),
            {}, class: input_class %>
    </div>

    <%# E12 (plan §3.3): the SECOND jurisdiction axis, deliberately next to the
        region select — region answers "where does it run", this answers "who runs
        it", and a package's jurisdiction is only derivable from both. Blank stays
        a real value ("not recorded"): eu_native claims fail closed on it rather
        than us guessing a domicile from the provider name (E12 option B). %>
    <div>
      <%= form.label :company_domicile, t('views.admin.ai_credentials.seam.label_company_domicile'), class: "block text-sm font-bold text-gray-900" %>
      <%= form.select :company_domicile,
            options_for_select(
              [[t('views.admin.ai_credentials.seam.company_domicile_none'), '']] +
                AiCredential::COMPANY_DOMICILES.map { |value| [t("views.admin.ai_credentials.seam.company_domicile_#{value}"), value] },
              @ai_credential.company_domicile
            ),
            {}, class: input_class %>
      <p class="mt-1 text-sm text-gray-500"><%= t('views.admin.ai_credentials.seam.company_domicile_help') %></p>
    </div>

    <div class="flex items-center">
      <div class="flex items-center h-5">
        <%= form.check_box :included_in_quota, class: "w-4 h-4 border-2 border-black rounded focus:ring-2 focus:ring-black accent-lime-500" %>
      </div>
      <div class="ml-2 text-sm">
        <%= form.label :included_in_quota, t('views.admin.ai_credentials.seam.label_included_in_quota'), class: "font-bold text-gray-900" %>
        <p class="text-gray-500"><%= t('views.admin.ai_credentials.seam.included_in_quota_help') %></p>
      </div>
    </div>
  </div>

  <h4 class="text-sm font-bold text-gray-900 mt-6 mb-2">
    <i class="bi bi-cash-coin text-gray-400 mr-2"></i>
    <%= t('views.admin.ai_credentials.seam.section_pricing') %>
  </h4>
  <p class="text-sm text-gray-500 mb-3"><%= t('views.admin.ai_credentials.seam.pricing_help') %></p>
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
    <div>
      <%= form.label :input_cost_per_1m_cents, t('views.admin.ai_credentials.seam.label_input_cost'), class: "block text-sm font-bold text-gray-900" %>
      <%= form.number_field :input_cost_per_1m_cents, min: 0, class: input_class %>
    </div>
    <div>
      <%= form.label :output_cost_per_1m_cents, t('views.admin.ai_credentials.seam.label_output_cost'), class: "block text-sm font-bold text-gray-900" %>
      <%= form.number_field :output_cost_per_1m_cents, min: 0, class: input_class %>
    </div>
    <div>
      <%= form.label :embedding_cost_per_1m_cents, t('views.admin.ai_credentials.seam.label_embedding_cost'), class: "block text-sm font-bold text-gray-900" %>
      <%= form.number_field :embedding_cost_per_1m_cents, min: 0, class: input_class %>
    </div>
  </div>
</div>

<%# locals: (jurisdiction:) -%>
<%# The §3 honesty ladder as a badge. Always the FULL wording — "EU region,
    non-European provider" never collapses into a green EU badge, because this
    claim ends up in the AVV (§9 Falle 6).

    Colours come from AiPackage::JURISDICTION_BADGE_STYLES, so a new rung cannot
    quietly acquire a grey fallback here while the select next door renders it
    from JURISDICTIONS. Rendered from BOTH index and show, hence the
    partial-neutral locale scope for the blank state. %>
<% if jurisdiction.present? %>
  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= AiPackage::JURISDICTION_BADGE_STYLES.fetch(jurisdiction, 'bg-gray-100 text-gray-800') %>">
    <%= t("views.admin.ai_packages.jurisdictions.#{jurisdiction}", default: jurisdiction) %>
  </span>
<% else %>
  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500">
    <%= t('views.admin.ai_packages.jurisdictions.blank') %>
  </span>
<% end %>

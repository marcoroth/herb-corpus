<div class="max-w-5xl mx-auto py-6 sm:px-6 lg:px-8">
  <div class="px-4 py-6 sm:px-0">
    <!-- Header -->
    <div class="mb-8 flex items-start justify-between">
      <div class="flex items-center">
        <%= link_to admin_ai_packages_path, class: "text-gray-500 hover:text-gray-700 mr-4" do %>
          <i class="bi bi-arrow-left text-xl"></i>
        <% end %>
        <div>
          <h1 class="text-3xl font-bold text-gray-900 flex items-center">
            <%= @ai_package.name %>
            <%= render 'published_badge', active: @ai_package.active?, extra_class: 'ml-3' %>
          </h1>
          <p class="mt-2 text-sm text-gray-600"><%= t('views.admin.ai_packages.show.subtitle', position: @ai_package.position) %></p>
        </div>
      </div>

      <%= link_to edit_admin_ai_package_path(@ai_package),
          class: "inline-flex items-center px-3 py-2 border border-black rounded text-sm font-medium bg-white hover:bg-gray-100 hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[2px_2px_0_0_#000000] transition-all" do %>
        <i class="bi bi-pencil mr-2"></i>
        <%= t('views.admin.ai_packages.show.btn_edit') %>
      <% end %>
    </div>

    <!-- Customer-facing copy, collected. NOT the catalogue card component: that
         one is built in P2; a second hand-maintained rendering of the same copy
         would only drift (§7b.1). This is the honest approximation. -->
    <div class="bg-white border-2 border-black rounded-lg shadow-[2px_2px_0_0_#000000] mb-8">
      <div class="px-6 py-4 border-b-2 border-black">
        <h2 class="text-lg font-medium text-gray-900">
          <i class="bi bi-eye text-gray-400 mr-2"></i>
          <%= t('views.admin.ai_packages.show.section_customer') %>
        </h2>
        <p class="mt-1 text-sm text-gray-500"><%= t('views.admin.ai_packages.show.section_customer_help') %></p>
      </div>
      <div class="px-6 py-4 space-y-4">
        <div>
          <h3 class="text-sm font-bold text-gray-900"><%= t('views.admin.ai_packages.show.label_jurisdiction') %></h3>
          <div class="mt-1"><%= render 'jurisdiction_badge', jurisdiction: @ai_package.jurisdiction %></div>
        </div>

        <div>
          <h3 class="text-sm font-bold text-gray-900"><%= t('views.admin.ai_packages.show.label_processing_region') %></h3>
          <p class="mt-1 text-sm text-gray-700"><%= @ai_package.processing_region.presence || t('views.admin.ai_packages.show.value_blank') %></p>
        </div>

        <div>
          <h3 class="text-sm font-bold text-gray-900"><%= t('views.admin.ai_packages.show.label_description') %></h3>
          <p class="mt-1 text-sm text-gray-700 whitespace-pre-line"><%= @ai_package.description.presence || t('views.admin.ai_packages.show.value_blank') %></p>
        </div>

        <div>
          <h3 class="text-sm font-bold text-gray-900"><%= t('views.admin.ai_packages.show.label_provider_note') %></h3>
          <p class="mt-1 text-sm text-gray-700 whitespace-pre-line"><%= @ai_package.provider_note.presence || t('views.admin.ai_packages.show.value_blank') %></p>
        </div>
      </div>
    </div>

    <!-- Technical configuration: the embedding triple + the chat ladder -->
    <div class="bg-white border-2 border-black rounded-lg shadow-[2px_2px_0_0_#000000] mb-8">
      <div class="px-6 py-4 border-b-2 border-black">
        <h2 class="text-lg font-medium text-gray-900">
          <i class="bi bi-diagram-3 text-gray-400 mr-2"></i>
          <%= t('views.admin.ai_packages.show.section_config') %>
        </h2>
      </div>
      <div class="px-6 py-4">
        <h3 class="text-sm font-bold text-gray-900 mb-2"><%= t('views.admin.ai_packages.show.label_embedding') %></h3>
        <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
          <div>
            <dt class="text-gray-500"><%= t('views.admin.ai_packages.show.label_embedding_credential') %></dt>
            <dd class="mt-1 text-gray-900">
              <% if @ai_package.embedding_credential %>
                <%= link_to ai_credential_option_label(@ai_package.embedding_credential),
                    admin_ai_credential_path(@ai_package.embedding_credential), class: "underline hover:text-gray-700" %>
              <% else %>
                <%= t('views.admin.ai_packages.show.value_blank') %>
              <% end %>
            </dd>
          </div>
          <div>
            <dt class="text-gray-500"><%= t('views.admin.ai_packages.show.label_embedding_model') %></dt>
            <dd class="mt-1 font-mono text-gray-900"><%= @ai_package.embedding_model.presence || t('views.admin.ai_packages.show.value_blank') %></dd>
          </div>
          <div>
            <dt class="text-gray-500"><%= t('views.admin.ai_packages.show.label_embedding_dims') %></dt>
            <dd class="mt-1 tabular-nums text-gray-900"><%= @ai_package.embedding_dims || t('views.admin.ai_packages.show.value_blank') %></dd>
          </div>
        </dl>

        <h3 class="text-sm font-bold text-gray-900 mt-6 mb-2"><%= t('views.admin.ai_packages.show.label_tiers') %></h3>
        <% if @ai_package.tiers.any? %>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('views.admin.ai_packages.show.th_tier') %></th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('views.admin.ai_packages.show.th_credential') %></th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('views.admin.ai_packages.show.th_model') %></th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @ai_package.tiers.each do |tier| %>
                  <tr>
                    <td class="px-4 py-3 text-sm text-gray-900">
                      <%= tier.label %>
                      <span class="ml-2 font-mono text-xs text-gray-500"><%= tier.key %></span>
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-700">
                      <% if tier.chat_credential %>
                        <%= link_to ai_credential_option_label(tier.chat_credential),
                            admin_ai_credential_path(tier.chat_credential), class: "underline hover:text-gray-900" %>
                      <% else %>
                        <%= t('views.admin.ai_packages.show.value_blank') %>
                      <% end %>
                    </td>
                    <td class="px-4 py-3 text-sm font-mono text-gray-700">
                      <%# The model that would actually be called. Resolved by the
                          model (#effective_chat_model), not re-derived here —
                          the tier's own override wins over the credential's
                          default (§6.1) in exactly ONE place. %>
                      <%= tier.effective_chat_model.presence || t('views.admin.ai_packages.show.value_blank') %>
                      <% if tier.chat_model.blank? && tier.chat_credential&.default_model.present? %>
                        <span class="ml-2 font-sans text-xs text-gray-500"><%= t('views.admin.ai_packages.show.model_from_credential') %></span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-sm text-gray-500"><%= t('views.admin.ai_packages.show.tiers_empty') %></p>
        <% end %>
      </div>
    </div>

    <%# Vertex status — only for packages that actually reference a google
        credential. Cache read only via VertexAvailabilityProbe.cached (the
        controller never probes on GET); the button below POSTs a fresh probe.
        DELIBERATE DUPLICATION of the green/red/yellow badges in
        admin/ai_credentials/_vertex_availability.html.erb: that partial renders
        the full region × model matrix for ONE credential and reads @ai_credential
        directly, this table renders the ONE cell each package slot uses. The
        rule itself lives in AiPackagesController#vertex_state — a third caller
        is the moment to extract it. %>
    <% if @vertex_checks.any? %>
      <div class="bg-white border-2 border-black rounded-lg shadow-[2px_2px_0_0_#000000]">
        <div class="px-6 py-4 border-b-2 border-black">
          <h2 class="text-lg font-medium text-gray-900">
            <i class="bi bi-globe-europe-africa text-gray-400 mr-2"></i>
            <%= t('views.admin.ai_packages.show.section_vertex') %>
          </h2>
          <p class="mt-1 text-sm text-gray-500"><%= t('views.admin.ai_packages.show.section_vertex_help') %></p>
        </div>
        <div class="px-6 py-4">
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('views.admin.ai_packages.show.th_slot') %></th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('views.admin.ai_packages.show.th_model') %></th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('views.admin.ai_packages.show.th_region') %></th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('views.admin.ai_packages.show.th_state') %></th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @vertex_checks.each do |check| %>
                  <tr>
                    <td class="px-4 py-3 text-sm text-gray-900">
                      <%= check[:slot] == :embedding ? t('views.admin.ai_packages.show.slot_embedding') : check[:tier_label] %>
                      <div class="text-xs text-gray-500">
                        <%= link_to ai_credential_option_label(check[:credential]),
                            admin_ai_credential_path(check[:credential]), class: "underline hover:text-gray-700" %>
                      </div>
                    </td>
                    <td class="px-4 py-3 text-sm font-mono text-gray-700"><%= check[:model].presence || t('views.admin.ai_packages.show.value_blank') %></td>
                    <td class="px-4 py-3 text-sm font-mono text-gray-700"><%= check[:region].presence || t('views.admin.ai_packages.show.value_blank') %></td>
                    <td class="px-4 py-3 text-sm">
                      <% case check[:state] %>
                      <% when :available %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                          <i class="bi bi-check-circle mr-1"></i><%= t('views.admin.ai_packages.show.vertex_available') %>
                        </span>
                      <% when :unavailable %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                          <i class="bi bi-x-circle mr-1"></i><%= t('views.admin.ai_packages.show.vertex_unavailable') %>
                        </span>
                      <% else %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                          <i class="bi bi-exclamation-triangle mr-1"></i><%= t('views.admin.ai_packages.show.vertex_unknown') %>
                        </span>
                      <% end %>
                      <% if check[:checked_at] %>
                        <div class="mt-1 text-xs text-gray-500">
                          <%# l(), not strftime: a hardcoded %d.%m.%Y stays German
                              under the EN locale while its label translates. %>
                          <%= t('views.admin.ai_packages.show.vertex_last_checked', time: l(check[:checked_at], format: :stamp)) %>
                        </div>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <div class="mt-4">
            <%# button_to (native form POST) — a GET must never probe, and
                data-turbo-method is unreliable in the admin area. %>
            <%= button_to vertex_check_admin_ai_package_path(@ai_package),
                form_class: "inline-block",
                class: "inline-flex items-center px-3 py-2 border border-black rounded text-sm font-medium bg-white hover:bg-gray-100 hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[2px_2px_0_0_#000000] transition-all" do %>
              <i class="bi bi-arrow-clockwise mr-2"></i>
              <%= t('views.admin.ai_packages.show.btn_vertex_check') %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

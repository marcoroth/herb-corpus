<%# locals: (active:, extra_class: nil) -%>
<%# "Veröffentlicht", never "Aktiv" — the word "aktiv" is already taken twice on
    the credential screens (§7b.1). Rendered from index and show; extra_class
    carries the show header's spacing so the two callers share the wording
    instead of drifting apart ("Ja/Nein" vs "Veröffentlicht/Nicht veröffentlicht"
    is exactly the drift this partial ends). %>
<% if active %>
  <span class="<%= extra_class %> inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
    <i class="bi bi-check-circle mr-1"></i><%= t('views.admin.ai_packages.shared.published_yes') %>
  </span>
<% else %>
  <span class="<%= extra_class %> inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
    <i class="bi bi-eye-slash mr-1"></i><%= t('views.admin.ai_packages.shared.published_no') %>
  </span>
<% end %>

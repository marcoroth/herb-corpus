<div class="max-w-4xl mx-auto py-6 sm:px-6 lg:px-8">
  <div class="px-4 py-6 sm:px-0">
    <div class="mb-8 flex items-center">
      <%= link_to admin_ai_packages_path, class: "text-gray-500 hover:text-gray-700 mr-4" do %>
        <i class="bi bi-arrow-left text-xl"></i>
      <% end %>
      <div>
        <h1 class="text-3xl font-bold text-gray-900"><%= t('views.admin.ai_packages.new.title') %></h1>
        <p class="mt-2 text-sm text-gray-600"><%= t('views.admin.ai_packages.new.subtitle') %></p>
      </div>
    </div>

    <div class="bg-white border-2 border-black rounded-lg shadow-[2px_2px_0_0_#000000] p-6">
      <%= render 'form', ai_package: @ai_package,
                         embedding_credentials: @embedding_credentials,
                         chat_credentials: @chat_credentials %>
    </div>
  </div>
</div>

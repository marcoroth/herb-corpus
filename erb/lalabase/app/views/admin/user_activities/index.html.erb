<div class="container mx-auto px-4 py-8">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold mb-2"><%= t('views.admin.user_activities.index.title') %></h1>
    <p class="text-gray-600"><%= t('views.admin.user_activities.index.subtitle') %></p>
  </div>

  <!-- Stat Cards -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white border-2 border-black rounded-lg p-4 shadow-[2px_2px_0_0_#000000]">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600"><%= t('views.admin.user_activities.index.stat_active_today') %></p>
          <p class="text-2xl font-bold"><%= @stats[:active_users_today] %></p>
        </div>
        <i class="bi bi-people-fill text-3xl text-blue-500"></i>
      </div>
    </div>

    <div class="bg-white border-2 border-black rounded-lg p-4 shadow-[2px_2px_0_0_#000000]">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600"><%= t('views.admin.user_activities.index.stat_activities_today') %></p>
          <p class="text-2xl font-bold"><%= @stats[:total_today] %></p>
        </div>
        <i class="bi bi-activity text-3xl text-green-500"></i>
      </div>
    </div>

    <div class="bg-white border-2 border-black rounded-lg p-4 shadow-[2px_2px_0_0_#000000]">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600"><%= t('views.admin.user_activities.index.stat_failed_logins') %></p>
          <p class="text-2xl font-bold text-red-600"><%= @stats[:failed_logins_today] %></p>
        </div>
        <i class="bi bi-shield-exclamation text-3xl text-red-500"></i>
      </div>
    </div>

    <div class="bg-white border-2 border-black rounded-lg p-4 shadow-[2px_2px_0_0_#000000]">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-600"><%= t('views.admin.user_activities.index.stat_new_registrations') %></p>
          <p class="text-2xl font-bold"><%= @stats[:new_registrations_today] %></p>
        </div>
        <i class="bi bi-person-plus-fill text-3xl text-purple-500"></i>
      </div>
    </div>
  </div>

  <!-- Filter -->
  <div class="bg-white border-2 border-black rounded-lg p-4 mb-6 shadow-[2px_2px_0_0_#000000]">
    <%= form_with url: admin_user_activities_path, method: :get, local: true, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-4">
        <!-- Category Filter -->
        <div>
          <%= label_tag :category, t('views.admin.user_activities.index.filter_category'), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= select_tag :category,
              options_for_select([
                [t('views.admin.user_activities.index.filter_all'), ''],
                ['Authentication', 'auth'],
                ['Profile', 'profile'],
                ['Permissions', 'permissions'],
                ['Security', 'security'],
                ['Invitations', 'invitations']
              ], params[:category]),
              class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
        </div>

        <!-- Status Filter -->
        <div>
          <%= label_tag :status, t('views.admin.user_activities.index.filter_status'), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= select_tag :status,
              options_for_select([
                [t('views.admin.user_activities.index.filter_all'), ''],
                [t('views.admin.user_activities.index.filter_status_success'), 'success'],
                [t('views.admin.user_activities.index.filter_status_failed'), 'failed'],
                [t('views.admin.user_activities.index.filter_status_pending'), 'pending']
              ], params[:status]),
              class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
        </div>

        <!-- Action Type Filter -->
        <div>
          <%= label_tag :action_type, t('views.admin.user_activities.index.filter_action'), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= select_tag :action_type,
              options_for_select([
                [t('views.admin.user_activities.index.filter_all'), ''],
                ['Login', 'login'],
                ['Logout', 'logout'],
                ['Login Failed', 'login_failed'],
                ['Registered', 'registered'],
                ['Password Reset', 'password_reset_requested']
              ], params[:action_type]),
              class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
        </div>

        <!-- Date From -->
        <div>
          <%= label_tag :date_from, t('views.admin.user_activities.index.filter_date_from'), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= date_field_tag :date_from, params[:date_from],
              class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
        </div>

        <!-- Date To -->
        <div>
          <%= label_tag :date_to, t('views.admin.user_activities.index.filter_date_to'), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= date_field_tag :date_to, params[:date_to],
              class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
        </div>

        <!-- Submit -->
        <div class="flex items-end">
          <%= submit_tag t('views.admin.user_activities.index.btn_filter'),
              class: "w-full px-4 py-2 bg-black text-white rounded-md hover:bg-gray-800 transition-colors" %>
        </div>
      </div>

      <div class="flex justify-between items-center">
        <%= link_to t('views.admin.user_activities.index.btn_reset_filters'), admin_user_activities_path,
            class: "text-sm text-gray-600 hover:text-gray-900" %>

        <%= link_to admin_user_activities_path(format: :csv, **request.query_parameters),
            class: "inline-flex items-center px-4 py-2 border-2 border-black rounded-lg hover:shadow-[2px_2px_0_0_#000000] transition-all" do %>
          <i class="bi bi-download mr-2"></i>
          <%= t('views.admin.user_activities.index.btn_csv_export') %>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Top Users -->
  <% if @top_users.any? %>
    <div class="bg-white border-2 border-black rounded-lg p-4 mb-6 shadow-[2px_2px_0_0_#000000]">
      <h3 class="text-lg font-bold mb-3"><%= t('views.admin.user_activities.index.top_users_title') %></h3>
      <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
        <% @top_users.each do |user| %>
          <div class="flex items-center justify-between p-2 bg-gray-50 rounded">
            <div class="flex-1 min-w-0">
              <%= link_to admin_user_activities_path(user_id: user.id),
                  class: "text-sm font-medium text-blue-600 hover:text-blue-800 truncate block" do %>
                <%= user.email %>
              <% end %>
            </div>
            <span class="ml-2 px-2 py-1 text-xs font-bold bg-blue-100 text-blue-800 rounded">
              <%= user.activities_count %>
            </span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Activities Table -->
  <div class="bg-white border-2 border-black rounded-lg shadow-[2px_2px_0_0_#000000] overflow-hidden">
    <div class="px-4 py-3 border-b-2 border-black bg-gray-50">
      <h2 class="text-lg font-bold">
        <%= t('views.admin.user_activities.index.table_title') %>
        <% if @filtered_user %>
          <%= t('views.admin.user_activities.index.table_title_for_user', email: @filtered_user.email) %>
        <% end %>
      </h2>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-100 border-b-2 border-black">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('views.admin.user_activities.index.th_time') %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('views.admin.user_activities.index.th_user') %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('views.admin.user_activities.index.th_action') %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('views.admin.user_activities.index.th_category') %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('views.admin.user_activities.index.th_status') %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('views.admin.user_activities.index.th_ip') %></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('views.admin.user_activities.index.th_organisation') %></th>
            <th class="px-4 py-3 text-center text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('views.admin.user_activities.index.th_details') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @activities.each do |activity| %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-4 py-3 whitespace-nowrap text-sm">
                <div>
                  <div class="font-medium"><%= l(activity.created_at, format: :short) %></div>
                  <div class="text-xs text-gray-500"><%= activity.created_at.strftime('%H:%M:%S') %></div>
                </div>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm">
                <%= link_to activity.user.email,
                    admin_user_path(activity.user),
                    class: "text-blue-600 hover:text-blue-800" %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm">
                <span class="font-medium"><%= activity.action.humanize %></span>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm">
                <span class="px-2 py-1 text-xs rounded-full
                  <%= case activity.category
                      when 'auth' then 'bg-blue-100 text-blue-800'
                      when 'profile' then 'bg-purple-100 text-purple-800'
                      when 'permissions' then 'bg-yellow-100 text-yellow-800'
                      when 'security' then 'bg-red-100 text-red-800'
                      else 'bg-gray-100 text-gray-800'
                      end %>">
                  <%= activity.category %>
                </span>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm">
                <span class="inline-flex items-center">
                  <% if activity.status == 'success' %>
                    <i class="bi bi-check-circle-fill text-green-500 mr-1"></i>
                  <% elsif activity.status == 'failed' %>
                    <i class="bi bi-x-circle-fill text-red-500 mr-1"></i>
                  <% else %>
                    <i class="bi bi-clock-fill text-yellow-500 mr-1"></i>
                  <% end %>
                  <%= activity.status %>
                </span>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">
                <%= activity.ip_address || '-' %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm">
                <%= activity.organisation&.name || '-' %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-center">
                <%= link_to admin_user_activity_path(activity),
                    class: "text-gray-600 hover:text-gray-900" do %>
                  <i class="bi bi-eye"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @activities.empty? %>
      <div class="px-4 py-8 text-center text-gray-500">
        <%= t('views.admin.user_activities.index.empty') %>
      </div>
    <% end %>

    <!-- Info -->
    <% if @activities.any? %>
      <div class="px-4 py-3 border-t border-gray-200 text-sm text-gray-600">
        <%= t('views.admin.user_activities.index.showing_count', count: @activities.count) %>
      </div>
    <% end %>
  </div>

  <!-- Links -->
  <div class="mt-6 flex gap-4">
    <%= link_to security_admin_user_activities_path,
        class: "inline-flex items-center px-4 py-2 border-2 border-black rounded-lg bg-red-100 hover:bg-red-200 hover:shadow-[2px_2px_0_0_#000000] transition-all" do %>
      <i class="bi bi-shield-exclamation mr-2"></i>
      <%= t('views.admin.user_activities.index.btn_security_events') %>
    <% end %>
  </div>
</div>

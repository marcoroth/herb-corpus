<div class="container mx-auto px-4 py-8 max-w-4xl">
  <!-- Navigation -->
  <div class="mb-6">
    <%= link_to admin_user_activities_path, 
        class: "inline-flex items-center text-gray-600 hover:text-gray-900" do %>
      <i class="bi bi-arrow-left mr-2"></i>
      <%= t('views.admin.user_activities.show.back_to_overview') %>
    <% end %>
  </div>

  <!-- Activity Details -->
  <div class="bg-white border-2 border-black rounded-lg shadow-[6px_6px_0_0_#000000] overflow-hidden">
    <!-- Header -->
    <div class="px-6 py-4 border-b-2 border-black bg-gray-50">
      <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold flex items-center gap-2">
          <i class="bi <%= @activity.icon_class %>"></i>
          Activity Details
        </h1>
        <span class="px-3 py-1 text-sm font-bold rounded-full
          <%= case @activity.status
              when 'success' then 'bg-green-100 text-green-800'
              when 'failed' then 'bg-red-100 text-red-800'
              else 'bg-yellow-100 text-yellow-800'
              end %>">
          <%= @activity.status.upcase %>
        </span>
      </div>
    </div>

    <!-- Main Info -->
    <div class="p-6 space-y-6">
      <!-- Basic Information -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <h3 class="text-sm font-medium text-gray-500 mb-1"><%= t('views.admin.user_activities.show.action') %></h3>
          <p class="text-lg font-semibold"><%= @activity.action.humanize %></p>
        </div>
        
        <div>
          <h3 class="text-sm font-medium text-gray-500 mb-1"><%= t('views.admin.user_activities.show.category') %></h3>
          <p class="text-lg">
            <span class="px-2 py-1 text-sm rounded
              <%= case @activity.category
                  when 'auth' then 'bg-blue-100 text-blue-800'
                  when 'profile' then 'bg-purple-100 text-purple-800'
                  when 'permissions' then 'bg-yellow-100 text-yellow-800'
                  when 'security' then 'bg-red-100 text-red-800'
                  else 'bg-gray-100 text-gray-800'
                  end %>">
              <%= @activity.category %>
            </span>
          </p>
        </div>
        
        <div>
          <h3 class="text-sm font-medium text-gray-500 mb-1"><%= t('views.admin.user_activities.show.user') %></h3>
          <p class="text-lg">
            <%= link_to @user.email, 
                admin_user_path(@user),
                class: "text-blue-600 hover:text-blue-800" %>
          </p>
        </div>
        
        <div>
          <h3 class="text-sm font-medium text-gray-500 mb-1"><%= t('views.admin.user_activities.show.timestamp') %></h3>
          <p class="text-lg">
            <%= l(@activity.created_at, format: :long) %>
            <span class="text-sm text-gray-500">
              (<%= t('views.admin.user_activities.show.time_ago', time: time_ago_in_words(@activity.created_at)) %>)
            </span>
          </p>
        </div>
        
        <% if @activity.organisation.present? %>
          <div>
            <h3 class="text-sm font-medium text-gray-500 mb-1"><%= t('views.admin.user_activities.show.organisation') %></h3>
            <p class="text-lg"><%= @activity.organisation.name %></p>
          </div>
        <% end %>
        
        <% if @activity.ip_address.present? %>
          <div>
            <h3 class="text-sm font-medium text-gray-500 mb-1"><%= t('views.admin.user_activities.show.ip_address') %></h3>
            <p class="text-lg font-mono"><%= @activity.ip_address %></p>
          </div>
        <% end %>
      </div>

      <!-- Description -->
      <div class="border-t pt-4">
        <h3 class="text-sm font-medium text-gray-500 mb-2"><%= t('views.admin.user_activities.show.description') %></h3>
        <p class="text-lg"><%= @activity.description %></p>
      </div>

      <!-- Failure Reason -->
      <% if @activity.failure_reason.present? %>
        <div class="border-t pt-4">
          <h3 class="text-sm font-medium text-gray-500 mb-2"><%= t('views.admin.user_activities.show.failure_reason') %></h3>
          <div class="bg-red-50 border border-red-200 rounded-lg p-3">
            <p class="text-red-800"><%= @activity.failure_reason %></p>
          </div>
        </div>
      <% end %>

      <!-- Technical Details -->
      <div class="border-t pt-4">
        <h3 class="text-sm font-medium text-gray-500 mb-2"><%= t('views.admin.user_activities.show.technical_details') %></h3>
        <div class="bg-gray-50 rounded-lg p-4 space-y-2">
          <div class="flex justify-between">
            <span class="text-sm text-gray-600">Activity ID:</span>
            <span class="text-sm font-mono"><%= @activity.id %></span>
          </div>
          
          <% if @activity.session_id.present? %>
            <div class="flex justify-between">
              <span class="text-sm text-gray-600">Session ID:</span>
              <span class="text-sm font-mono"><%= @activity.session_id %></span>
            </div>
          <% end %>
          
          <% if @activity.user_agent.present? %>
            <div class="flex justify-between">
              <span class="text-sm text-gray-600">User Agent:</span>
              <span class="text-sm font-mono text-right" style="max-width: 400px;"><%= @activity.user_agent %></span>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Metadata -->
      <% if @activity.metadata.present? && @activity.metadata.any? %>
        <div class="border-t pt-4">
          <h3 class="text-sm font-medium text-gray-500 mb-2">Metadata</h3>
          <div class="bg-gray-50 rounded-lg p-4">
            <dl class="space-y-2">
              <% @activity.metadata.each do |key, value| %>
                <div class="flex justify-between">
                  <dt class="text-sm text-gray-600"><%= key.humanize %>:</dt>
                  <dd class="text-sm font-medium"><%= value %></dd>
                </div>
              <% end %>
            </dl>
          </div>
        </div>
      <% end %>

      <!-- Changes -->
      <% if @activity.attribute_changes.present? && @activity.attribute_changes.any? %>
        <div class="border-t pt-4">
          <h3 class="text-sm font-medium text-gray-500 mb-2"><%= t('views.admin.user_activities.show.changes') %></h3>
          <div class="bg-yellow-50 rounded-lg p-4">
            <dl class="space-y-2">
              <% @activity.attribute_changes.each do |attr, changes| %>
                <div>
                  <dt class="text-sm font-medium text-gray-700"><%= attr.humanize %>:</dt>
                  <dd class="text-sm">
                    <span class="text-red-600 line-through"><%= changes[0] %></span>
                    →
                    <span class="text-green-600"><%= changes[1] %></span>
                  </dd>
                </div>
              <% end %>
            </dl>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Related Activities -->
  <% if @session_activities&.any? %>
    <div class="mt-6 bg-white border-2 border-black rounded-lg shadow-[2px_2px_0_0_#000000] overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-bold"><%= t('views.admin.user_activities.show.more_activities_in_session') %></h2>
      </div>
      <div class="divide-y divide-gray-200">
        <% @session_activities.limit(5).each do |activity| %>
          <div class="px-6 py-3 flex items-center justify-between hover:bg-gray-50">
            <div class="flex items-center gap-3">
              <i class="bi <%= activity.icon_class %> text-gray-500"></i>
              <div>
                <p class="font-medium"><%= activity.action.humanize %></p>
                <p class="text-sm text-gray-500"><%= l(activity.created_at, format: :short) %></p>
              </div>
            </div>
            <%= link_to admin_user_activity_path(activity),
                class: "text-gray-600 hover:text-gray-900" do %>
              <i class="bi bi-arrow-right"></i>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Navigation between activities -->
  <div class="mt-6 flex justify-between">
    <% if @previous_activity %>
      <%= link_to admin_user_activity_path(@previous_activity),
          class: "inline-flex items-center px-4 py-2 border-2 border-black rounded-lg hover:shadow-[2px_2px_0_0_#000000] transition-all" do %>
        <i class="bi bi-chevron-left mr-2"></i>
        <%= t('views.admin.user_activities.show.previous_activity') %>
      <% end %>
    <% else %>
      <div></div>
    <% end %>
    
    <% if @next_activity %>
      <%= link_to admin_user_activity_path(@next_activity),
          class: "inline-flex items-center px-4 py-2 border-2 border-black rounded-lg hover:shadow-[2px_2px_0_0_#000000] transition-all" do %>
<%= t('views.admin.user_activities.show.next_activity') %>
        <i class="bi bi-chevron-right ml-2"></i>
      <% end %>
    <% end %>
  </div>
</div>
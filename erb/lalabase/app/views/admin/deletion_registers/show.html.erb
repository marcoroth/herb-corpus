<div class="container mx-auto px-4 py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold mb-2"><%= t('.title') %></h1>
    <p class="text-gray-600"><%= t('.description') %></p>
  </div>

  <%# Sits BEFORE the numbers, not below them. Whoever sees a zero or a short list
      must first have read since when the register is kept at all. Otherwise
      "keine Eintraege" reads as "nichts geloescht". %>
  <div class="mb-6 px-4 py-3 bg-yellow-50 border-2 border-yellow-300 rounded-lg text-sm text-yellow-900">
    <% if @started_at %>
      <p class="font-medium"><%= t('.started_at', date: l(@started_at.to_date)) %></p>
    <% else %>
      <p class="font-medium"><%= t('.register_empty') %></p>
    <% end %>
    <p class="mt-1"><%= t('.scope_hint') %></p>
    <p class="mt-1"><%= t('.retention_hint', years: AttachmentDeletionRecord::RETENTION.in_years.to_i) %></p>
  </div>

  <div class="mb-6 bg-white border-2 border-black rounded-lg p-4 shadow-[2px_2px_0_0_#000000]">
    <%# The choices come from the REGISTER, not from the organisation list.
        An entry outlives the organisation it concerns, and that is exactly
        when the proof is requested. %>
    <%= form_with url: admin_deletion_register_path, method: :get, local: true, class: 'flex flex-wrap items-end gap-3' do |f| %>
      <div>
        <%= f.label :organisation_id, t('.organisation_label'), class: 'block text-sm font-medium text-gray-700 mb-1' %>
        <%= f.select :organisation_id,
                     options_for_select(@organisations.map { |id, name| [name.presence || id, id] }, @organisation_id),
                     { include_blank: t('.all_organisations') },
                     class: 'border-2 border-black rounded-md px-3 py-2' %>
      </div>
      <%= f.submit t('.apply'), class: 'px-4 py-2 bg-lime-400 border-2 border-black rounded-lg font-medium hover:shadow-[2px_2px_0_0_#000000] transition-all' %>
      <% if @organisation_id %>
        <%= link_to t('.reset'), admin_deletion_register_path, class: 'px-4 py-2 border-2 border-black rounded-lg text-sm font-medium hover:bg-gray-100' %>
      <% end %>
    <% end %>
  </div>

  <div class="mb-6 grid gap-4 sm:grid-cols-3">
    <div class="bg-white border-2 border-black rounded-lg p-4 shadow-[2px_2px_0_0_#000000]">
      <p class="text-xs uppercase tracking-wider text-gray-500"><%= t('.stat_total') %></p>
      <p class="text-2xl font-bold"><%= @total %></p>
    </div>
    <%# Entries without a follow-up confirmation get their own number, not just a
        marker in the row: on page 2 of 5 the gap would otherwise be invisible. %>
    <div class="bg-white border-2 border-black rounded-lg p-4 shadow-[2px_2px_0_0_#000000]">
      <p class="text-xs uppercase tracking-wider text-gray-500"><%= t('.stat_pending') %></p>
      <p class="text-2xl font-bold"><%= @pending_confirmation %></p>
      <p class="text-xs text-gray-500 mt-1"><%= t('.stat_pending_hint') %></p>
    </div>
    <% if @without_organisation %>
      <div class="bg-white border-2 border-black rounded-lg p-4 shadow-[2px_2px_0_0_#000000]">
        <p class="text-xs uppercase tracking-wider text-gray-500"><%= t('.stat_without_organisation') %></p>
        <p class="text-2xl font-bold"><%= @without_organisation %></p>
        <p class="text-xs text-gray-500 mt-1"><%= t('.stat_without_organisation_hint') %></p>
      </div>
    <% end %>
  </div>

  <div class="bg-white border-2 border-black rounded-lg shadow-[2px_2px_0_0_#000000] overflow-hidden">
    <% if @records.empty? %>
      <p class="px-4 py-6 text-center text-sm text-gray-500"><%= t('.no_entries') %></p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-100 border-b border-gray-300">
            <tr>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('.table.organisation') %></th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('.table.filename') %></th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('.table.carrier') %></th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('.table.size') %></th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('.table.deleted_at') %></th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"><%= t('.table.backup') %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @records.each do |record| %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-4 py-3 text-sm">
                  <%# The denormalised name, not the one from the organisations table:
                      that row may no longer exist. %>
                  <%= record.organisation_name.presence || t('.organisation_unknown') %>
                </td>
                <td class="px-4 py-3 text-sm font-medium"><%= record.filename %></td>
                <td class="px-4 py-3 text-sm text-gray-600">
                  <% if record.record_type.present? %>
                    <%= record.record_type %>
                  <% else %>
                    <span class="text-gray-400">&mdash;</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 whitespace-nowrap text-sm"><%= number_to_human_size(record.byte_size || 0) %></td>
                <%# :long, not :short. The hand-maintained short formats carry no
                    year in EITHER language ("%d %b %H:%M"), and a proof without a
                    year is worthless as proof: the entries live for three years. %>
                <td class="px-4 py-3 whitespace-nowrap text-sm"><%= l(record.deleted_at, format: :long) %></td>
                <td class="px-4 py-3 whitespace-nowrap text-sm">
                  <% if record.backup_confirmed? %>
                    <div><%= l(record.backup_deleted_at.to_date) %></div>
                    <% if record.backup_expires_at %>
                      <%# Proven and calculated are shown separately. The backup
                          script confirmed the one, the other is an addition. %>
                      <div class="text-xs text-gray-500"><%= t('.expires_at', date: l(record.backup_expires_at)) %></div>
                    <% end %>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-yellow-100 text-yellow-800 border border-yellow-300">
                      <%= t('.pending_confirmation') %>
                    </span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <%# Built by hand and NOT via pagy_nav, for the same reason as on the billing
      list: the app's own override of pagy_url_for rebuilds the query from a fixed
      allowlist that does not contain organisation_id. Page 2 would then silently
      fall back to "alle Organisationen", which means disclosing other
      organisations' records. %>
  <% if @pagy.pages > 1 %>
    <nav class="mt-6 flex items-center gap-3" aria-label="<%= t('.pagination_label') %>">
      <% if @pagy.prev %>
        <%= link_to t('.previous'), admin_deletion_register_path(page: @pagy.prev, organisation_id: @organisation_id),
                    class: 'px-3 py-2 border-2 border-black rounded-lg text-sm font-medium hover:bg-gray-100' %>
      <% end %>
      <span class="text-sm text-gray-600"><%= t('.page_of', page: @pagy.page, total: @pagy.pages) %></span>
      <% if @pagy.next %>
        <%= link_to t('.next'), admin_deletion_register_path(page: @pagy.next, organisation_id: @organisation_id),
                    class: 'px-3 py-2 border-2 border-black rounded-lg text-sm font-medium hover:bg-gray-100' %>
      <% end %>
    </nav>
  <% end %>
</div>

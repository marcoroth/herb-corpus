<div class="max-w-4xl mx-auto py-6 sm:px-6 lg:px-8">
  <div class="px-4 py-6 sm:px-0">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center">
        <%= link_to admin_beusers_path, class: "text-gray-500 hover:text-gray-700 mr-4" do %>
          <i class="bi bi-arrow-left text-xl"></i>
        <% end %>
        <div>
          <h1 class="text-3xl font-bold text-gray-900"><%= t('views.admin.beusers.new.title') %></h1>
          <p class="mt-2 text-sm text-gray-600">
            <%= t('views.admin.beusers.new.subtitle') %>
          </p>
        </div>
      </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white border-2 border-black rounded-lg shadow-[2px_2px_0_0_#000000]">
      <div class="px-6 py-6">
        <%= form_with model: [:admin, @beuser], local: true, class: "space-y-6" do |form| %>

          <!-- Error Display -->
          <% if @beuser.errors.any? %>
            <div class="border-2 border-red-500 bg-red-50 rounded-lg p-4 shadow-[2px_2px_0_0_#ef4444]">
              <div class="flex">
                <div class="flex-shrink-0">
                  <i class="bi bi-exclamation-triangle text-red-400 text-xl"></i>
                </div>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-red-800">
                    <%= t('views.common.errors_occurred', count: @beuser.errors.count) %>
                  </h3>
                  <div class="mt-2 text-sm text-red-700">
                    <ul class="list-disc pl-5 space-y-1">
                      <% @beuser.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <!-- Personal Information Section -->
          <div class="border-b-2 border-black pb-6">
            <h3 class="text-lg font-medium leading-6 text-gray-900 mb-4">
              <i class="bi bi-person text-gray-400 mr-2"></i>
              <%= t('views.admin.beusers.new.personal_info') %>
            </h3>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <%= form.label :firstname, t('views.common.first_name'), class: "block text-sm font-bold text-gray-900" %>
                <div class="mt-1 relative">
                  <%= form.text_field :firstname,
                      class: "w-full px-4 py-2 border border-black rounded text-sm focus:outline-none focus:-translate-x-0.5 focus:-translate-y-0.5 focus:shadow-[2px_2px_0_0_#000000] focus:ring-0 transition-all",
                      placeholder: "Max" %>
                </div>
              </div>

              <div>
                <%= form.label :lastname, t('views.common.last_name'), class: "block text-sm font-bold text-gray-900" %>
                <div class="mt-1 relative">
                  <%= form.text_field :lastname,
                      class: "w-full px-4 py-2 border border-black rounded text-sm focus:outline-none focus:-translate-x-0.5 focus:-translate-y-0.5 focus:shadow-[2px_2px_0_0_#000000] focus:ring-0 transition-all",
                      placeholder: "Mustermann" %>
                </div>
              </div>
            </div>

            <div class="mt-6">
              <%= form.label :email, t('views.common.email'), class: "block text-sm font-bold text-gray-900" %>
              <div class="mt-1 relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <i class="bi bi-envelope text-gray-400"></i>
                </div>
                <%= form.email_field :email,
                    class: "w-full pl-10 pr-3 py-2 border border-black rounded text-sm focus:outline-none focus:-translate-x-0.5 focus:-translate-y-0.5 focus:shadow-[2px_2px_0_0_#000000] focus:ring-0 transition-all",
                    placeholder: "max.mustermann@firma.de" %>
              </div>
            </div>
          </div>

          <!-- Security Section -->
          <div class="border-b-2 border-black pb-6">
            <h3 class="text-lg font-medium leading-6 text-gray-900 mb-4">
              <i class="bi bi-shield-lock text-gray-400 mr-2"></i>
              <%= t('views.admin.beusers.new.security') %>
            </h3>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <%= form.label :password, t('views.common.password'), class: "block text-sm font-bold text-gray-900" %>
                <div class="mt-1 relative">
                  <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i class="bi bi-key text-gray-400"></i>
                  </div>
                  <%= form.password_field :password,
                      class: "w-full pl-10 pr-3 py-2 border border-black rounded text-sm focus:outline-none focus:-translate-x-0.5 focus:-translate-y-0.5 focus:shadow-[2px_2px_0_0_#000000] focus:ring-0 transition-all",
                      placeholder: "••••••••" %>
                </div>
              </div>

              <div>
                <%= form.label :password_confirmation, t('views.common.password_confirm'), class: "block text-sm font-bold text-gray-900" %>
                <div class="mt-1 relative">
                  <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i class="bi bi-key text-gray-400"></i>
                  </div>
                  <%= form.password_field :password_confirmation,
                      class: "w-full pl-10 pr-3 py-2 border border-black rounded text-sm focus:outline-none focus:-translate-x-0.5 focus:-translate-y-0.5 focus:shadow-[2px_2px_0_0_#000000] focus:ring-0 transition-all",
                      placeholder: "••••••••" %>
                </div>
              </div>
            </div>
          </div>

          <!-- Permissions Section -->
          <div class="pb-6">
            <h3 class="text-lg font-medium leading-6 text-gray-900 mb-4">
              <i class="bi bi-gear text-gray-400 mr-2"></i>
              <%= t('views.admin.beusers.new.permissions') %>
            </h3>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <%= form.label :role, t('views.common.role'), class: "block text-sm font-bold text-gray-900" %>
                <div class="mt-1">
                  <%= form.select :role,
                      @role_hash || options_for_select([[t('views.admin.beusers.new.role_user'), 'user'], [t('views.admin.beusers.new.role_admin'), 'admin']], @beuser.role),
                      { include_blank: false },
                      class: "w-full px-4 py-2 border border-black rounded text-sm focus:outline-none focus:-translate-x-0.5 focus:-translate-y-0.5 focus:shadow-[2px_2px_0_0_#000000] focus:ring-0 transition-all" %>
                </div>
              </div>

              <div class="flex items-center">
                <div class="flex items-center h-5">
                  <%= form.check_box :active,
                      class: "w-4 h-4 border-2 border-black rounded focus:ring-2 focus:ring-black accent-lime-500",
                      id: "active_checkbox" %>
                </div>
                <div class="ml-3 text-sm">
                  <%= form.label :active, t('views.admin.beusers.new.activate_account'),
                      class: "font-medium text-gray-700",
                      for: "active_checkbox" %>
                  <p class="text-gray-500"><%= t('views.admin.beusers.new.user_can_login') %></p>
                </div>
              </div>
            </div>
          </div>

          <!-- Form Actions -->
          <div class="flex justify-end space-x-3 pt-6 border-t-2 border-black">
            <%= link_to admin_beusers_path,
                class: "py-2 px-4 border border-black rounded text-sm font-medium bg-gray-200 hover:bg-gray-300 hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[2px_2px_0_0_#000000] transition-all" do %>
              <%= t('views.common.cancel') %>
            <% end %>
            <%= form.submit t('views.admin.beusers.new.create_admin'),
                class: "inline-flex justify-center py-2 px-4 border border-black rounded text-sm font-medium bg-lime-200 hover:bg-lime-300 hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[2px_2px_0_0_#000000] transition-all" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

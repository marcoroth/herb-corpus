<div class="container mx-auto px-4 py-8">
  <!-- Breadcrumb -->
  <nav class="mb-4" aria-label="Breadcrumb">
    <div class="flex items-center text-sm">
      <%= link_to admin_beusers_path, class: "text-blue-600 hover:text-blue-800 font-medium" do %>
        &larr; <%= t('views.admin.beusers.edit.breadcrumb_admins') %>
      <% end %>
      <span class="mx-2 text-gray-400">/</span>
      <span class="text-gray-600"><%= t('views.admin.beusers.edit.breadcrumb_edit') %></span>
    </div>
  </nav>

  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold mb-2"><%= t('views.admin.beusers.edit.title') %></h1>
    <p class="text-gray-600">
      <%= t('views.admin.beusers.edit.subtitle_html', email: @beuser.email) %>
    </p>
  </div>

  <!-- Form Card -->
  <div class="bg-white border-2 border-black rounded-lg shadow-[2px_2px_0_0_#000000] overflow-hidden">
    <div class="px-6 py-6">
      <%= form_with model: [:admin, @beuser], local: true do |form| %>

        <!-- Error Display -->
        <% if @beuser.errors.any? %>
          <div class="mb-6 p-4 bg-red-50 border-2 border-red-300 rounded-lg">
            <div class="flex">
              <div class="flex-shrink-0">
                <i class="bi bi-exclamation-triangle-fill text-red-500 text-xl"></i>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-bold text-red-800">
                  <%= t('views.common.errors_occurred', count: @beuser.errors.count) %>
                </h3>
                <div class="mt-2 text-sm text-red-700">
                  <ul class="list-disc pl-5 space-y-1">
                    <% @beuser.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Personal Information Section -->
        <div class="mb-8 p-4 bg-gray-50 border-2 border-black rounded-lg">
          <h3 class="text-lg font-bold mb-4 flex items-center">
            <i class="bi bi-person-fill mr-2"></i>
            <%= t('views.admin.beusers.edit.personal_info') %>
          </h3>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
              <%= form.label :firstname, t('views.common.first_name'), class: "block text-sm font-bold text-gray-700 mb-1" %>
              <%= form.text_field :firstname,
                  class: "w-full px-3 py-2 border-2 border-black rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500",
                  placeholder: "Max" %>
            </div>

            <div>
              <%= form.label :lastname, t('views.common.last_name'), class: "block text-sm font-bold text-gray-700 mb-1" %>
              <%= form.text_field :lastname,
                  class: "w-full px-3 py-2 border-2 border-black rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500",
                  placeholder: "Mustermann" %>
            </div>
          </div>

          <div class="mt-6">
            <%= form.label :email, t('views.common.email'), class: "block text-sm font-bold text-gray-700 mb-1" %>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <i class="bi bi-envelope-fill text-gray-400"></i>
              </div>
              <%= form.email_field :email,
                  class: "w-full pl-10 pr-3 py-2 border-2 border-black rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500",
                  placeholder: "max.mustermann@firma.de" %>
            </div>
          </div>
        </div>

        <!-- Account Status -->
        <div class="mb-8 p-4 bg-gray-50 border-2 border-black rounded-lg">
          <h3 class="text-lg font-bold mb-4 flex items-center">
            <i class="bi bi-toggle2-on mr-2"></i>
            <%= t('views.admin.beusers.edit.account_status') %>
          </h3>
          <div class="flex items-start">
            <div class="flex items-center h-5">
              <%= form.check_box :active,
                  class: "w-4 h-4 text-blue-600 border-2 border-black rounded focus:ring-2 focus:ring-blue-500",
                  id: "active_checkbox" %>
            </div>
            <div class="ml-3">
              <%= form.label :active, t('views.admin.beusers.edit.account_activated'),
                  class: "text-sm font-bold text-gray-700",
                  for: "active_checkbox" %>
              <p class="text-sm text-gray-500"><%= t('views.admin.beusers.edit.deactivated_hint') %></p>
            </div>
          </div>
        </div>

        <!-- Permissions Section (Only for Admins) -->
        <% if current_user.admin? %>
          <div class="mb-8 p-4 bg-gray-50 border-2 border-black rounded-lg">
            <h3 class="text-lg font-bold mb-4 flex items-center">
              <i class="bi bi-shield-check-fill mr-2"></i>
              <%= t('views.admin.beusers.edit.permissions') %>
            </h3>

            <div class="mb-6 p-3 bg-yellow-50 border-2 border-yellow-300 rounded-lg">
              <div class="flex">
                <div class="flex-shrink-0">
                  <i class="bi bi-exclamation-triangle-fill text-yellow-500"></i>
                </div>
                <div class="ml-3">
                  <p class="text-sm text-yellow-800">
                    <%= t('views.admin.beusers.edit.admin_area_warning_html') %>
                  </p>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <%= form.label :role, t('views.common.role'), class: "block text-sm font-bold text-gray-700 mb-1" %>
                <%= form.select :role,
                    @role_hash || options_for_select([[t('views.admin.beusers.edit.role_user'), 'user'], [t('views.admin.beusers.edit.role_admin'), 'admin']], @beuser.role),
                    { include_blank: false },
                    class: "w-full px-3 py-2 border-2 border-black rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" %>
              </div>

              <div>
                <label class="block text-sm font-bold text-gray-700 mb-3"><%= t('views.admin.beusers.edit.special_permissions') %></label>
                <div class="p-3 bg-white border-2 border-gray-300 rounded-lg">
                  <div class="flex items-start">
                    <div class="flex items-center h-5">
                      <%= hidden_field_tag "beuser[permissions][users]", nil %>
                      <%= check_box_tag "beuser[permissions][users]", 1,
                          @beuser.permission?("users"),
                          class: "w-4 h-4 text-blue-600 border-2 border-black rounded focus:ring-2 focus:ring-blue-500",
                          id: "permissions_users_check" %>
                    </div>
                    <div class="ml-3">
                      <label for="permissions_users_check" class="text-sm font-bold text-gray-700">
                        <%= t('views.admin.beusers.edit.manage_user_list') %>
                      </label>
                      <p class="text-sm text-gray-500"><%= t('views.admin.beusers.edit.manage_user_list_hint') %></p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Form Actions -->
        <div class="flex justify-between items-center pt-6 border-t-2 border-gray-200">
          <div>
            <%= link_to edit_password_admin_beuser_path(@beuser),
                class: "inline-flex items-center px-4 py-2 bg-white border-2 border-black rounded-lg font-medium hover:shadow-[2px_2px_0_0_#000000] transition-all" do %>
              <i class="bi bi-key-fill mr-2"></i>
              <%= t('views.admin.beusers.edit.change_password') %>
            <% end %>
          </div>

          <div class="flex gap-3">
            <%= link_to admin_beusers_path,
                class: "px-4 py-2 bg-white border-2 border-black rounded-lg font-medium hover:shadow-[2px_2px_0_0_#000000] transition-all" do %>
              <%= t('views.common.cancel') %>
            <% end %>
            <%= form.submit t('views.admin.beusers.edit.save_changes'),
                class: "px-4 py-2 bg-black text-white border-2 border-black rounded-lg font-medium hover:shadow-[2px_2px_0_0_#000000] transition-all cursor-pointer" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Additional Information -->
  <div class="mt-6 bg-white border-2 border-black rounded-lg shadow-[2px_2px_0_0_#000000] overflow-hidden">
    <div class="px-4 py-3 border-b-2 border-black bg-gray-50">
      <h3 class="text-lg font-bold"><%= t('views.admin.beusers.edit.account_info') %></h3>
    </div>
    <div class="p-4">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="bg-gray-50 rounded-lg p-3">
          <div class="text-sm font-medium text-gray-500"><%= t('views.common.created_at') %></div>
          <div class="mt-1 text-sm font-bold text-gray-900">
            <%= @beuser.created_at.strftime("%d.%m.%Y %H:%M") %>
          </div>
        </div>
        <div class="bg-gray-50 rounded-lg p-3">
          <div class="text-sm font-medium text-gray-500"><%= t('views.common.updated_at') %></div>
          <div class="mt-1 text-sm font-bold text-gray-900">
            <%= @beuser.updated_at.strftime("%d.%m.%Y %H:%M") %>
          </div>
        </div>
        <div class="bg-gray-50 rounded-lg p-3">
          <div class="text-sm font-medium text-gray-500"><%= t('views.admin.beusers.edit.current_role') %></div>
          <div class="mt-1">
            <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium <%= @beuser.admin? ? 'bg-purple-100 text-purple-800 border border-purple-300' : 'bg-gray-100 text-gray-800 border border-gray-300' %>">
              <%= @beuser.admin? ? t('views.admin.beusers.edit.role_admin') : t('views.admin.beusers.edit.role_user') %>
            </span>
          </div>
        </div>
        <div class="bg-gray-50 rounded-lg p-3">
          <div class="text-sm font-medium text-gray-500"><%= t('views.common.status') %></div>
          <div class="mt-1">
            <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium <%= @beuser.active? ? 'bg-green-100 text-green-800 border border-green-300' : 'bg-red-100 text-red-800 border border-red-300' %>">
              <%= @beuser.active? ? t('views.common.active') : t('views.common.inactive') %>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

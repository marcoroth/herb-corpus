<div class="container mx-auto px-4 py-8">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold mb-2"><%= t('.title') %></h1>
    <p class="text-gray-600"><%= t('.subtitle') %></p>
  </div>

  <!-- Statistics Card -->
  <div class="bg-white border-2 border-black rounded-lg p-4 mb-6 shadow-[2px_2px_0_0_#000000]">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-6">
        <div>
          <p class="text-sm text-gray-600"><%= t('.total_admins') %></p>
          <p class="text-2xl font-bold"><%= @beusers.count %></p>
        </div>
        <div>
          <p class="text-sm text-gray-600"><%= t('.active_admins') %></p>
          <p class="text-2xl font-bold text-green-600"><%= @beusers.where(active: true).count %></p>
        </div>
      </div>
      <div>
        <%= link_to new_admin_beuser_path,
            class: "inline-flex items-center px-4 py-2 border-2 border-black rounded-lg bg-black text-white hover:shadow-[2px_2px_0_0_#000000] transition-all" do %>
          <i class="bi bi-plus mr-2"></i>
          <%= t('.add_new_admin') %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Admin Users Table -->
  <div class="bg-white border-2 border-black rounded-lg shadow-[2px_2px_0_0_#000000] overflow-hidden">
    <div class="px-4 py-3 border-b-2 border-black bg-gray-50">
      <h2 class="text-lg font-bold"><%= t('.administrator_users') %></h2>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-100 border-b-2 border-black">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                <div class="flex items-center">
                  <i class="bi bi-person text-gray-400 mr-2"></i>
                  <%= t('views.admin.beusers.index.admin_user') %>
                </div>
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                <div class="flex items-center">
                  <i class="bi bi-envelope text-gray-400 mr-2"></i>
                  <%= t('views.admin.beusers.index.email_header') %>
                </div>
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                <div class="flex items-center">
                  <i class="bi bi-shield text-gray-400 mr-2"></i>
                  <%= t('views.admin.beusers.index.role_and_status') %>
                </div>
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                <div class="flex items-center">
                  <i class="bi bi-calendar text-gray-400 mr-2"></i>
                  <%= t('views.admin.beusers.index.created') %>
                </div>
              </th>
              <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                <div class="flex items-center justify-end">
                  <i class="bi bi-gear text-gray-400 mr-2"></i>
                  <%= t('views.common.actions') %>
                </div>
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @beusers.each_with_index do |beuser, index| %>
              <tr class="hover:bg-gray-50 transition-colors duration-200 <%= 'bg-blue-50' if beuser.id == current_user.id %>">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center">
                    <div class="flex-shrink-0 h-10 w-10">
                      <div class="h-10 w-10 rounded-full <%= beuser.active? ? 'bg-green-100' : 'bg-gray-100' %> flex items-center justify-center">
                        <span class="text-sm font-medium <%= beuser.active? ? 'text-green-800' : 'text-gray-500' %>">
                          <%= (beuser.firstname.presence || beuser.email).first.upcase %>
                        </span>
                      </div>
                    </div>
                    <div class="ml-4">
                      <div class="text-sm font-medium text-gray-900 flex items-center">
                        <%= [beuser.firstname, beuser.lastname].compact.join(' ').presence || beuser.email.split('@').first %>
                        <% if beuser.id == current_user.id %>
                          <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                            <%= t('views.common.you') %>
                          </span>
                        <% end %>
                      </div>
                      <% if beuser.firstname.present? && beuser.lastname.present? %>
                        <div class="text-sm text-gray-500">
                          <%= beuser.firstname %> <%= beuser.lastname %>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm text-gray-900">
                    <%= beuser.email %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex flex-col space-y-1">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= beuser.role == 'admin' ? 'bg-purple-100 text-purple-800' : 'bg-gray-100 text-gray-800' %>">
                      <i class="bi bi-shield-check mr-1"></i>
                      <%= beuser.role.capitalize %>
                    </span>
                    <% if beuser.active? %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                        <i class="bi bi-check-circle mr-1"></i>
                        <%= t('views.common.active') %>
                      </span>
                    <% else %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                        <i class="bi bi-x-circle mr-1"></i>
                        <%= t('views.common.inactive') %>
                      </span>
                    <% end %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm text-gray-900">
                    <%= beuser.created_at.strftime("%d.%m.%Y") %>
                  </div>
                  <div class="text-sm text-gray-500">
                    <%= time_ago_in_words(beuser.created_at) %> <%= t('views.common.ago_suffix') %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <div class="flex items-center justify-end space-x-2">
                    <%= link_to edit_admin_beuser_path(beuser),
                        class: "inline-flex items-center px-3 py-2 border-2 border-black rounded-lg hover:shadow-[2px_2px_0_0_#000000] transition-all" do %>
                      <i class="bi bi-pencil mr-1"></i>
                      <%= t('views.common.edit') %>
                    <% end %>

                    <% if beuser.id != current_user.id %>
                      <%= link_to admin_beuser_path(beuser),
                          data: {
                            turbo_method: :delete,
                            turbo_confirm: t('views.confirm.delete_admin_user')
                          },
                          class: "inline-flex items-center px-3 py-2 border-2 border-black rounded-lg bg-red-100 hover:bg-red-200 hover:shadow-[2px_2px_0_0_#000000] transition-all" do %>
                        <i class="bi bi-trash mr-1"></i>
                        <%= t('views.common.delete') %>
                      <% end %>
                    <% else %>
                      <span class="inline-flex items-center px-3 py-2 border-2 border-gray-300 rounded-lg bg-gray-100 text-gray-400 cursor-not-allowed">
                        <i class="bi bi-shield-lock mr-1"></i>
                        <%= t('views.common.protected') %>
                      </span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @beusers.empty? %>
        <div class="px-4 py-12 text-center">
          <i class="bi bi-shield-check text-gray-400 text-4xl mb-4"></i>
          <h3 class="text-lg font-bold text-gray-900 mb-2"><%= t('views.admin.beusers.index.no_admins') %></h3>
          <p class="text-gray-500 mb-4"><%= t('views.admin.beusers.index.no_admins_created') %></p>
          <%= link_to new_admin_beuser_path,
              class: "inline-flex items-center px-4 py-2 border-2 border-black rounded-lg bg-black text-white hover:shadow-[2px_2px_0_0_#000000] transition-all" do %>
            <i class="bi bi-plus mr-2"></i>
            <%= t('views.admin.beusers.index.add_first_admin') %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="max-w-2xl mx-auto py-6 sm:px-6 lg:px-8">
  <div class="px-4 py-6 sm:px-0">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center">
        <%= link_to edit_admin_beuser_path(@beuser), class: "text-gray-500 hover:text-gray-700 mr-4" do %>
          <i class="bi bi-arrow-left text-xl"></i>
        <% end %>
        <div>
          <h1 class="text-3xl font-bold text-gray-900"><%= t('views.admin.beusers.edit_password.title') %></h1>
          <p class="mt-2 text-sm text-gray-600">
            <%= t('views.admin.beusers.edit_password.subtitle_html', email: @beuser.email) %>
          </p>
        </div>
      </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white border-2 border-black rounded-lg shadow-[2px_2px_0_0_#000000]">
      <div class="px-6 py-6">
        <%= form_with model: [:admin, @beuser],
            url: update_password_admin_beuser_path(@beuser),
            method: :post,
            local: true,
            class: "space-y-6" do |form| %>

          <!-- Error Display -->
          <% if @beuser.errors.any? %>
            <div class="border-2 border-red-500 bg-red-50 rounded-lg p-4 shadow-[2px_2px_0_0_#ef4444]">
              <div class="flex">
                <div class="flex-shrink-0">
                  <i class="bi bi-exclamation-triangle text-red-400 text-xl"></i>
                </div>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-red-800">
                    <%= t('views.common.errors_occurred', count: @beuser.errors.count) %>
                  </h3>
                  <div class="mt-2 text-sm text-red-700">
                    <ul class="list-disc pl-5 space-y-1">
                      <% @beuser.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <!-- Security Warning -->
          <div class="border-2 border-yellow-500 bg-yellow-50 rounded-lg p-4 shadow-[2px_2px_0_0_#d97706]">
            <div class="flex">
              <div class="flex-shrink-0">
                <i class="bi bi-shield-exclamation text-yellow-400 text-xl"></i>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-yellow-800"><%= t('views.admin.beusers.edit_password.security_warning_title') %></h3>
                <div class="mt-2 text-sm text-yellow-700">
                  <p><%= t('views.admin.beusers.edit_password.security_warning_text') %></p>
                </div>
              </div>
            </div>
          </div>

          <!-- Password Section -->
          <div class="space-y-6">
            <h3 class="text-lg font-medium leading-6 text-gray-900 border-b-2 border-black pb-3">
              <i class="bi bi-key text-gray-400 mr-2"></i>
              <%= t('views.admin.beusers.edit_password.set_new_password') %>
            </h3>

            <div>
              <%= form.label :password, t('views.admin.beusers.edit_password.new_password'), class: "block text-sm font-bold text-gray-900" %>
              <div class="mt-1 relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <i class="bi bi-lock text-gray-400"></i>
                </div>
                <%= form.password_field :password,
                    class: "w-full pl-10 pr-3 py-2 border border-black rounded text-sm focus:outline-none focus:-translate-x-0.5 focus:-translate-y-0.5 focus:shadow-[2px_2px_0_0_#000000] focus:ring-0 transition-all",
                    placeholder: "••••••••",
                    autocomplete: "new-password" %>
              </div>
              <p class="mt-2 text-sm text-gray-500">
                <%= t('views.admin.beusers.edit_password.password_hint') %>
              </p>
            </div>

            <div>
              <%= form.label :password_confirmation, t('views.common.password_confirm'), class: "block text-sm font-bold text-gray-900" %>
              <div class="mt-1 relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <i class="bi bi-lock-fill text-gray-400"></i>
                </div>
                <%= form.password_field :password_confirmation,
                    class: "w-full pl-10 pr-3 py-2 border border-black rounded text-sm focus:outline-none focus:-translate-x-0.5 focus:-translate-y-0.5 focus:shadow-[2px_2px_0_0_#000000] focus:ring-0 transition-all",
                    placeholder: "••••••••",
                    autocomplete: "new-password" %>
              </div>
              <p class="mt-2 text-sm text-gray-500">
                <%= t('views.admin.beusers.edit_password.confirm_password_hint') %>
              </p>
            </div>
          </div>

          <!-- Form Actions -->
          <div class="flex justify-end space-x-3 pt-6 border-t-2 border-black">
            <%= link_to edit_admin_beuser_path(@beuser),
                class: "py-2 px-4 border border-black rounded text-sm font-medium bg-gray-200 hover:bg-gray-300 hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[2px_2px_0_0_#000000] transition-all" do %>
              <%= t('views.common.cancel') %>
            <% end %>
            <%= form.submit t('views.admin.beusers.edit_password.submit'),
                class: "inline-flex justify-center py-2 px-4 border border-black rounded text-sm font-medium bg-red-100 hover:bg-red-200 hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[2px_2px_0_0_#000000] transition-all",
                data: { turbo_confirm: t('views.confirm.change_password') } %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Additional Security Info -->
    <div class="mt-6 bg-gray-50 border border-black rounded-lg p-6">
      <h4 class="text-sm font-medium text-gray-900 mb-3">
        <i class="bi bi-info-circle text-gray-400 mr-2"></i>
        <%= t('views.admin.beusers.edit_password.security_tips_title') %>
      </h4>
      <ul class="text-sm text-gray-600 space-y-1">
        <li class="flex items-start">
          <i class="bi bi-check text-green-500 mr-2 mt-0.5"></i>
          <%= t('views.admin.beusers.edit_password.tip_mixed_case') %>
        </li>
        <li class="flex items-start">
          <i class="bi bi-check text-green-500 mr-2 mt-0.5"></i>
          <%= t('views.admin.beusers.edit_password.tip_special_chars') %>
        </li>
        <li class="flex items-start">
          <i class="bi bi-check text-green-500 mr-2 mt-0.5"></i>
          <%= t('views.admin.beusers.edit_password.tip_min_length') %>
        </li>
        <li class="flex items-start">
          <i class="bi bi-check text-green-500 mr-2 mt-0.5"></i>
          <%= t('views.admin.beusers.edit_password.tip_no_personal') %>
        </li>
      </ul>
    </div>
  </div>
</div>

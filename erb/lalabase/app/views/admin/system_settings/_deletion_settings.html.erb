<div class="bg-white border-2 border-black rounded-lg shadow-[2px_2px_0_0_#000000] overflow-hidden">
  <div class="px-6 py-4 border-b-2 border-black bg-red-50">
    <h2 class="text-xl font-bold flex items-center gap-2">
      <i class="bi bi-trash text-red-600"></i>
      <%= t('views.admin.system_settings.deletion.title') %>
    </h2>
  </div>

  <div class="p-6">
    <%= form_with url: admin_update_deletion_settings_path,
                  method: :patch,
                  data: { turbo_frame: "_top" },
                  class: "space-y-4" do |form| %>

      <div class="space-y-4">
        <div>
          <label for="grace_period_days" class="block text-sm font-medium text-gray-700 mb-2">
            <%= t('views.admin.system_settings.deletion.grace_period_label') %>
          </label>

          <div class="flex items-center gap-4">
            <%= number_field_tag :grace_period_days,
                                grace_period_days,
                                min: 0,
                                max: 365,
                                class: "w-24 px-3 py-2 border-2 border-black rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500" %>
            <span class="text-gray-600"><%= t('views.admin.system_settings.deletion.days') %></span>
          </div>

          <p class="mt-2 text-sm text-gray-500">
            <%= t('views.admin.system_settings.deletion.grace_period_help_html').html_safe %>
          </p>
        </div>

        <div class="bg-yellow-50 border border-yellow-400 rounded-lg p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <i class="bi bi-info-circle text-yellow-400"></i>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-yellow-800">
                <%= t('views.admin.system_settings.deletion.info_title') %>
              </h3>
              <div class="mt-2 text-sm text-yellow-700">
                <ul class="list-disc list-inside space-y-1">
                  <li><%= t('views.admin.system_settings.deletion.info_immediate') %></li>
                  <li><%= t('views.admin.system_settings.deletion.info_cancel') %></li>
                  <li><%= t('views.admin.system_settings.deletion.info_job') %></li>
                  <li><%= t('views.admin.system_settings.deletion.info_admin') %></li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <% if grace_period_days > 0 %>
          <div class="bg-blue-50 border border-blue-400 rounded-lg p-4">
            <p class="text-sm text-blue-800">
              <i class="bi bi-clock-history mr-2"></i>
              <%= t('views.admin.system_settings.deletion.current_setting_html', days: grace_period_days).html_safe %>
            </p>
          </div>
        <% else %>
          <div class="bg-red-50 border border-red-400 rounded-lg p-4">
            <p class="text-sm text-red-800">
              <i class="bi bi-exclamation-triangle mr-2"></i>
              <%= t('views.admin.system_settings.deletion.warning_no_grace_html').html_safe %>
            </p>
          </div>
        <% end %>
      </div>

      <div class="flex justify-end">
        <%= form.submit t('views.admin.system_settings.deletion.btn_save'),
            class: "px-6 py-2 bg-red-600 text-white font-medium rounded-lg hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 transition-colors" %>
      </div>
    <% end %>
  </div>
</div>

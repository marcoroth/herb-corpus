<div class="bg-white border-2 border-black rounded-lg p-6 shadow-[6px_6px_0_0_#000000]">
  <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
    <i class="bi bi-person-plus-fill"></i>
    <%= t('views.admin.system_settings.registration.title') %>
  </h2>

  <%= form_with url: admin_update_registration_path, method: :patch, local: false,
                class: 'space-y-6',
                data: {
                  controller: 'registration-toggle',
                  'registration-toggle-form-value': 'form'
                } do |form| %>
    <!-- Toggle for registration allow/disallow -->
    <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
      <div class="flex items-start justify-between">
        <div class="flex-1">
          <h3 class="text-lg font-medium text-gray-900 mb-1">
            <%= t('views.admin.system_settings.registration.status_title') %>
          </h3>
          <p class="text-sm text-gray-600" data-registration-toggle-target="statusText">
            <%= registration_allowed ?
                t('views.admin.system_settings.registration.status_enabled') :
                t('views.admin.system_settings.registration.status_disabled') %>
          </p>
        </div>

        <div class="ml-4">
          <label class="relative inline-flex items-center cursor-pointer">
            <%= check_box_tag :allow_registration,
                'true',
                registration_allowed,
                class: 'sr-only peer',
                id: 'registration-toggle',
                data: {
                  'registration-toggle-target': 'checkbox',
                  action: 'change->registration-toggle#checkboxChanged'
                } %>
            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-lime-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-lime-500"></div>
          </label>
        </div>
      </div>

      <div class="mt-4 border-t border-gray-200 pt-4">
        <div class="flex items-center justify-between">
          <button type="button"
                  data-registration-toggle-target="button"
                  data-action="click->registration-toggle#toggle"
                  class="inline-flex items-center px-6 py-3 border-2 border-black rounded-lg hover:shadow-[2px_2px_0_0_#000000] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all <%= registration_allowed ? 'bg-lime-200 hover:bg-lime-300' : 'bg-red-100 hover:bg-red-200' %>">
            <i class="bi <%= registration_allowed ? 'bi-unlock' : 'bi-lock' %> text-xl mr-3"></i>
            <div class="text-left">
              <span class="block font-bold text-lg">
                <%= registration_allowed ? t('views.admin.system_settings.registration.btn_disable') : t('views.admin.system_settings.registration.btn_enable') %>
              </span>
              <span class="block text-sm text-gray-600">
                <%= registration_allowed ? t('views.admin.system_settings.registration.click_to_lock') : t('views.admin.system_settings.registration.click_to_unlock') %>
              </span>
            </div>
          </button>

          <button type="submit"
                  data-registration-toggle-target="form"
                  class="px-6 py-3 bg-black text-white rounded-lg hover:bg-gray-800 transition-colors font-medium">
            <i class="bi bi-save mr-2"></i>
            <%= t('views.admin.system_settings.registration.btn_save') %>
          </button>
        </div>
      </div>
    </div>

    <!-- Message when registration is disabled -->
    <div class="<%= registration_allowed ? 'opacity-50' : '' %> transition-opacity">
      <label class="block text-sm font-medium text-gray-700 mb-2">
        <%= t('views.admin.system_settings.registration.message_label') %>
      </label>
      <%= text_area_tag :registration_disabled_message,
          registration_message,
          rows: 3,
          class: 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-lime-500',
          placeholder: t('views.admin.system_settings.registration.message_placeholder'),
          disabled: registration_allowed %>
      <p class="text-xs text-gray-500 mt-1">
        <%= t('views.admin.system_settings.registration.message_help') %>
      </p>
    </div>

    <!-- Save button (only when message has changed) -->
    <% unless registration_allowed %>
      <div class="mt-4 flex justify-end">
        <%= button_tag type: 'submit',
            class: "py-2.5 px-5 relative inline-flex flex-row items-center justify-center gap-x-2 rounded text-sm tracking-[.00714em] font-medium border border-black hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[2px_2px_0_0_#000000] focus:-translate-x-0.5 focus:-translate-y-0.5 focus:shadow-[2px_2px_0_0_#000000] bg-lime-200 hover:bg-lime-300 focus:bg-lime-300 text-black" do %>
          <i class="bi bi-save"></i>
          <span><%= t('views.admin.system_settings.registration.btn_save_message') %></span>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <!-- Status display -->
  <div class="mt-6 p-4 rounded-lg border <%= registration_allowed ? 'bg-green-50 border-green-300' : 'bg-yellow-50 border-yellow-300' %>">
    <div class="flex items-center gap-2">
      <i class="bi <%= registration_allowed ? 'bi-check-circle-fill text-green-600' : 'bi-exclamation-triangle-fill text-yellow-600' %> text-xl"></i>
      <span class="font-medium <%= registration_allowed ? 'text-green-800' : 'text-yellow-800' %>">
        <%= registration_allowed ? t('views.admin.system_settings.registration.status_active') : t('views.admin.system_settings.registration.status_inactive') %>
      </span>
    </div>
  </div>
</div>

<%= turbo_frame_tag 'mobile_project_switcher' do %>
  <div data-controller="mobile-project-search">
    <% if mobile_projects.length >= 8 %>
      <label class="mobile-search-field"><i class="bi bi-search" aria-hidden="true"></i><input type="search" autocomplete="off" aria-label="<%= t('mobile.search_projects') %>" placeholder="<%= t('mobile.search_projects') %>" data-action="input->mobile-project-search#filter"></label>
    <% end %>
    <p class="mobile-section-label"><%= t('mobile.project_counts') %></p>
    <%= render 'layouts/mobile_project_list', switcher: true %>
    <%= link_to t('mobile.all_projects'), organisation_mobile_projects_path(current_organisation), class: 'mobile-text-action', data: { turbo_frame: '_top' } %>
  </div>
<% end %>

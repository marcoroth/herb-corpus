<%# The native modal keeps existing forms in the DOM and makes them inert. %>
<div data-controller="session-timeout"
     data-session-timeout-expires-at-value="<%= (Time.current + current_user.timeout_in).iso8601 %>"
     data-session-timeout-warn-seconds-value="60"
     data-session-timeout-user-id-value="<%= current_user.id %>"
     data-session-timeout-touch-url-value="<%= session_touch_path %>"
     data-session-timeout-login-url-value="<%= new_user_session_path %>">
  <dialog data-session-timeout-target="modal"
          data-action="cancel->session-timeout#preventClose"
          class="m-auto bg-surface-raised text-cream-900 border border-cream-300 shadow-[4px_4px_0_0_#14110c] max-w-md w-[92%] p-6 backdrop:bg-ink/60"
          aria-label="<%= t('views.session_timeout.dialog_label') %>">
    <section data-session-timeout-target="warning" hidden>
      <h2 class="text-xl font-black mb-3"><%= t('views.session_timeout.warning_title') %></h2>
      <p class="text-sm mb-4">
        <%= t('views.session_timeout.warning_body_html',
              countdown: tag.span('60', data: { session_timeout_target: 'countdown' }, class: 'font-bold tabular-nums')) %>
      </p>
      <div class="flex items-center justify-between gap-3">
        <%= link_to t('views.session_timeout.session_settings'), session_user_preferences_path,
                    target: '_blank', rel: 'noopener', class: 'text-xs underline text-cream-600 hover:text-cream-900' %>
        <button type="button" data-action="click->session-timeout#stayLoggedIn"
                class="px-4 py-2 border border-ink bg-lime-200 hover:bg-lime-300 font-bold">
          <%= t('views.session_timeout.stay_logged_in') %>
        </button>
      </div>
    </section>
    <section data-session-timeout-target="expired" hidden>
      <h2 class="text-xl font-black mb-3"><%= t('views.session_timeout.expired_title') %></h2>
      <p class="text-sm mb-4"><%= t('views.session_timeout.expired_body') %></p>
      <%= link_to t('views.session_timeout.sign_in'), new_user_session_path, target: '_blank', rel: 'noopener',
                  class: 'inline-block px-4 py-2 border border-ink bg-lime-200 hover:bg-lime-300 font-bold' %>
    </section>
    <section data-session-timeout-target="checking" hidden>
      <h2 class="text-xl font-black mb-3"><%= t('views.session_timeout.checking_title') %></h2>
      <p class="text-sm mb-4"><%= t('views.session_timeout.checking_body') %></p>
    </section>
    <section data-session-timeout-target="accountChanged" hidden>
      <h2 class="text-xl font-black mb-3"><%= t('views.session_timeout.account_changed_title') %></h2>
      <p class="text-sm mb-4"><%= t('views.session_timeout.account_changed_body') %></p>
      <%= link_to t('views.session_timeout.open_app'), root_path, target: '_blank', rel: 'noopener', class: 'underline font-bold' %>
    </section>
    <p data-session-timeout-target="error" role="alert" class="text-sm mt-4" hidden>
      <%= t('views.session_timeout.check_failed') %>
    </p>
    <button type="button" data-action="click->session-timeout#checkSession" class="text-sm underline mt-4">
      <%= t('views.session_timeout.check_again') %>
    </button>
  </dialog>
</div>

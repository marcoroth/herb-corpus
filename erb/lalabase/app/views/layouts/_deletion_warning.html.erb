<%# Rendered at the top of the main column, IN the document flow. It used to be
    `fixed top-0` plus a hard-coded h-16 spacer further down to make room; the
    spacer guessed the height and guessed wrong as soon as the bar wrapped on a
    narrow screen. In the flow the height takes care of itself.

    data-turbo-permanent stays: the close button below uses it as its selector
    hook (`closest('div[data-turbo-permanent]')`). %>
<div class="bg-red-600 text-on-fill border-2 border-black shadow-lg" data-turbo-permanent>
  <div class="px-4 py-3">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <i class="bi bi-exclamation-triangle-fill text-xl"></i>
        <div>
          <strong><%= t('views.layouts.deletion_warning.title') %></strong>
          <span class="ml-2">
            <%= t('views.layouts.deletion_warning.account_deleted_on') %>
            <strong><%= l(current_user.scheduled_deletion_at, format: :long) %></strong>
            <%= t('views.layouts.deletion_warning.deleted') %>
            <span class="text-red-200">
              (<%= t('views.layouts.deletion_warning.in_days', count: current_user.days_until_deletion) %>)
            </span>
          </span>
        </div>
      </div>

      <div class="flex items-center space-x-4">
        <%# Grace period IS the export window (Art. 20 until the very end) —
            keep the reminder visible on every page until deletion runs. %>
        <%= link_to user_data_export_path, class: 'underline hover:text-red-200 transition-colors' do %>
          <i class="bi bi-download mr-1"></i><%= t('views.layouts.deletion_warning.export_data') %>
        <% end %>

        <%= render Neo::Buttons::ButtonComponent.new(variant: :success, size: :medium,
              url: cancel_account_deletion_path) do %>
          <%= t('views.layouts.deletion_warning.cancel_deletion') %>
        <% end %>

        <button type="button"
                onclick="this.closest('div[data-turbo-permanent]').style.display = 'none';"
                class="text-on-fill hover:text-red-200 transition-colors"
                title="<%= t('views.layouts.deletion_warning.hide_banner') %>">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
    </div>
  </div>
</div>

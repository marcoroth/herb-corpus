<!doctype html>
<html class="theme-lime" lang="<%= I18n.locale %>">
  <head>
    <title><%= t("application.title", default: "Projektmanagement") %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= csrf_meta_tags %> <%= csp_meta_tag %>

    <!-- Favicon -->
    <%= favicon_link_tag 'favicon.svg', type: 'image/svg+xml' %>
    <%= favicon_link_tag 'favicon.png', type: 'image/png', sizes: '32x32' %>

    <!-- Display Serif + Mono — self-hosted (GDPR-compliant, no Google CDN) -->
    <%= stylesheet_link_tag "lalabase-fonts", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= stylesheet_link_tag "slimselect", "data-turbo-track": "reload" %>
    <!-- Bootstrap Icons: local via Asset Pipeline (application.css) -->
    <%= javascript_include_tag "alpinejs.min", defer: true %>
    <!-- This is the Import Map tag that Rails uses -->
    <meta name="turbo-prefetch" content="false">
  </head>

  <body class="font-sans text-base font-normal text-black dark:text-gray-100 bg-gray-100 dark:bg-gray-500">
  <%# ========== TOP NAV (consistent with landing) ========== %>
  <header class="fixed top-0 start-0 end-0 z-40 bg-white dark:bg-neutral-950 border-b-2 border-black">
    <div class="container xl:max-w-6xl mx-auto px-4">
      <div class="flex items-center justify-between py-3">
        <%# Logo → Home page: the one brand mark (shared/_brand_mark), no copy of
            its own (this one was w-9 with a 2px border while every other was w-8). %>
        <%= link_to root_path, class: "text-2xl font-black flex flex-row items-center gap-1.5" do %>
          <%= render 'shared/brand_mark' %>
        <% end %>

        <%# Contextual right side %>
        <div class="flex items-center gap-2 sm:gap-3">
          <%= link_to root_path, class: "max-sm:hidden font-mono text-xs uppercase tracking-wider text-gray-700 dark:text-gray-300 hover:text-cobalt-600 dark:hover:text-lime-300 transition-colors" do %>
            <i class="bi bi-arrow-left"></i> <%= t('buttons.to_homepage') %>
          <% end %>
          <% unless current_page?(new_user_session_path) %>
            <%= link_to new_user_session_path,
                class: "py-2 px-4 inline-flex items-center justify-center gap-x-2 rounded text-sm font-medium border-2 border-black hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[3px_3px_0_0_#000000] bg-white text-black transition-all" do %>
              <%= t('buttons.login') %>
            <% end %>
          <% end %>
          <% unless current_page?(new_user_registration_path) %>
            <%= link_to new_user_registration_path,
                class: "py-2 px-4 inline-flex items-center justify-center gap-x-2 rounded text-sm font-medium border-2 border-black hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[3px_3px_0_0_#000000] bg-lime-300 hover:bg-lime-400 text-black transition-all" do %>
              <%= t('buttons.register') %> <i class="bi bi-arrow-right"></i>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </header>

  <div class="container px-4 pt-20 pb-3 lg:px-8 mx-auto">
    <% if notice.present? || alert.present? %>
      <div class="mb-4">
        <% if notice.present? %>
          <div class="p-4 border-2 border-black shadow-[2px_2px_0_0_#000000] rounded-lg bg-green-100 text-green-800">
            <div class="flex items-center">
              <i class="bi bi-check-circle-fill text-base leading-none ml-0.5 mr-2.5" aria-hidden="true"></i>
              <span><%= notice %></span>
            </div>
          </div>
        <% end %>
        <% if alert.present? %>
          <div class="p-4 border-2 border-black shadow-[2px_2px_0_0_#000000] rounded-lg bg-red-100 text-red-800">
            <div class="flex items-center">
              <i class="bi bi-x-circle-fill text-base leading-none ml-0.5 mr-2.5" aria-hidden="true"></i>
              <span><%= alert %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
    <div class="w-full grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12 py-8 lg:py-12 text-base">
      <%= yield %>
    </div>

    <!-- Footer -->
    <footer class="mt-8 py-4 border-t border-gray-200 dark:border-gray-700">
      <div class="text-center">
        <p class="text-sm text-gray-500 dark:text-gray-400">
          <%= legal_operator_credit %>
          <% legal_links = legal_footer_links(
               separator: safe_join([' ', tag.span('|', class: 'mx-2'), ' ']),
               class: 'text-lime-600 dark:text-lime-400 hover:text-lime-700 dark:hover:text-lime-300 underline'
             ) %>
          <% if legal_links.present? %>
            <span class="mx-2">|</span>
            <%= legal_links %>
          <% end %>
        </p>
      </div>
    </footer>
  </div>

  <% if Rails.env.staging? %>
    <!-- Staging Environment Indicator -->
    <div class="staging-indicator">
      <input type="checkbox" id="staging-toggle" class="staging-toggle">
      <label for="staging-toggle" class="staging-badge">staging</label>
      <div class="staging-info">
        <div style="font-weight: bold; margin-bottom: 4px;">STAGING ENVIRONMENT</div>
        <div>Branch: main</div>
        <div>Deployed: <%= File.mtime(Rails.root.join('REVISION_TIME')).strftime('%Y-%m-%d %H:%M UTC') rescue 'Unknown' %></div>
        <div>Rev: <%= File.read(Rails.root.join('REVISION')).strip[0..7] rescue 'Unknown' %></div>
      </div>
    </div>
  <% end %>

<!--
  Deployment Info:
  - Deployed: <%= File.mtime(Rails.root.join('REVISION_TIME')).strftime('%Y-%m-%d %H:%M:%S UTC') rescue 'Unknown' %>
  - Revision: <%= File.read(Rails.root.join('REVISION')).strip rescue 'Unknown' %>
-->
</body>

</html>

<%# On-demand global-search overlay (command-palette style).
    Rendered ONCE at body level — NOT inside <aside id="sidebar">, whose translate-x +
    overflow-hidden would create a containing block for position:fixed and clip this overlay.
    Controlled by search_overlay_controller, which is mounted on <body> so the "Suche" nav
    item (inside the transformed sidebar) and Cmd/Ctrl+K can both open it.
    Hidden by default; gated to the same access as the search feature itself. %>
<% if global_search_available? %>
  <div data-search-overlay-target="overlay"
       data-action="click->search-overlay#closeOnBackdrop"
       class="hidden fixed inset-0 z-modal overflow-y-auto"
       role="dialog" aria-modal="true"
       aria-label="<%= t('navigation.search_in_organisation', organisation: current_organisation.name) %>">
    <div class="fixed inset-0 bg-ink bg-opacity-60 backdrop-blur-sm"></div>
    <div class="flex items-start justify-center min-h-screen px-4 pt-[12vh]">
      <div data-search-overlay-target="panel"
           class="relative w-full max-w-xl bg-surface-raised rounded-lg border border-cream-300 shadow-[4px_4px_0_0_#14110c] p-4">
        <div class="flex items-center justify-between gap-2 mb-3">
          <%# "Suche in <Org>" makes the org-wide scope explicit. min-w-0 + truncate so a
              long organisation name shrinks instead of pushing the close button off-panel. %>
          <h2 class="min-w-0 text-sm font-bold text-cream-900 flex items-center gap-2">
            <i class="bi bi-search shrink-0"></i>
            <span class="truncate"><%= t('navigation.search_in_organisation', organisation: current_organisation.name) %></span>
          </h2>
          <button type="button"
                  data-action="click->search-overlay#close"
                  aria-label="<%= t('navigation.search_close') %>"
                  class="w-7 h-7 flex items-center justify-center text-cream-500 hover:text-cream-900 hover:bg-cream-200 rounded transition-all">
            <i class="bi bi-x-lg text-sm"></i>
          </button>
        </div>
        <%= render 'common/global_search_form' %>
      </div>
    </div>
  </div>
<% end %>

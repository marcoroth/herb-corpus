    <%# Theme mode (Light/Dark/Pop): apply before the first paint (no FOUC) + toggle logic.
        Identical to the app layout (application.html.erb), so that the Style Guide shows the same
        three views live. Switch at the bottom of the sidebar. See doc/token_layer_phase2_dark_plan.md %>
    <script>
      (function () {
        var KEY = 'lb-theme', root = document.documentElement;
        function apply(t) {
          root.classList.remove('dark', 'theme-pop');
          if (t === 'dark') { root.classList.add('dark'); }
          else if (t === 'pop') { root.classList.add('theme-pop'); }
        }
        function get() { try { return localStorage.getItem(KEY) || 'pop'; } catch (e) { return 'pop'; } }
        function mark() {
          var cur = get(), els = document.querySelectorAll('[data-theme-set]');
          for (var i = 0; i < els.length; i++) {
            els[i].setAttribute('aria-pressed', els[i].getAttribute('data-theme-set') === cur ? 'true' : 'false');
          }
        }
        function set(t) { try { localStorage.setItem(KEY, t); } catch (e) {} apply(t); mark(); }
        apply(get()); // vor dem Paint
        window.__lbTheme = { set: set, get: get };
        document.addEventListener('click', function (e) {
          var b = e.target.closest ? e.target.closest('[data-theme-set]') : null;
          if (b) { e.preventDefault(); set(b.getAttribute('data-theme-set')); }
        });
        document.addEventListener('DOMContentLoaded', mark);
        document.addEventListener('turbo:load', function () { apply(get()); mark(); });
      })();
    </script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>

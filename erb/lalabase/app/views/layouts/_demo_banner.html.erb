<%# Demo mode (Lalabase::Demo): every visitor shares this account. Shaped like
    layouts/_email_confirmation and rendered in the same place, in the flow. Not
    dismissible: it is the one place that says why things change on their own. %>
<div class="bg-sky-200 text-black border-2 border-black" data-testid="demo-banner">
  <div class="px-4 py-3 flex items-center gap-3 text-sm">
    <i class="bi bi-info-circle-fill text-xl" aria-hidden="true"></i>
    <p>
      <strong><%= t('views.demo.banner.title') %></strong>
      <span class="ms-2"><%= t('views.demo.banner.body', time: Lalabase::Demo.reset_time) %></span>
    </p>
    <%= demo_website_link(class: 'ms-auto shrink-0 font-semibold underline decoration-2 underline-offset-2 hover:no-underline') %>
  </div>
</div>

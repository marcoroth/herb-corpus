<%# Wrapper around every rendered rich text (tickets, comments, notes). %>
<%# `lexxy-content`: Lexxy's content stylesheet styles attachments, galleries and tables %>
<%# identically in the editor and in the display. The zoom controller is delegated here %>
<%# because ActionText sanitizes the attachment partials and strips data attributes from %>
<%# them; a click on an `a.attachment__zoom` inside opens the lightbox. %>
<div class="lexxy-content rich-text"
     data-controller="neo-rich-text-zoom"
     data-action="click->neo-rich-text-zoom#open"
     data-zoom-close-label="<%= t('views.action_text.zoom_close') %>">
  <%= yield -%>
</div>

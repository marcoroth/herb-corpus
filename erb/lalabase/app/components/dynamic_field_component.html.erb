<div class="form-group mb-4">
  <label for="<%= field_id %>" class="block text-sm font-medium text-gray-700 mb-1">
    <%= label_text %>
    <% if required? %>
      <span class="text-red-500">*</span>
    <% end %>
  </label>
  
  <%= render_field %>
  
  <% if help_text.present? %>
    <p class="mt-1 text-sm text-gray-500">
      <%= help_text %>
    </p>
  <% end %>
  
  <% if ticket.errors.any? && ticket.errors.messages[:base].any? { |msg| msg.include?(label_text) } %>
    <p class="mt-1 text-sm text-red-600">
      <%= ticket.errors.messages[:base].find { |msg| msg.include?(label_text) } %>
    </p>
  <% end %>
</div>
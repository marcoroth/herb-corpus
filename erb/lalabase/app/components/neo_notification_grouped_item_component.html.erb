<div class="relative flex items-start gap-2 text-sm group pl-12 sm:pl-0 <%= primary_text_class %>">
  <!-- Mobile Action Buttons (links, nebeneinander) -->
  <div class="absolute left-0 top-1/2 -translate-y-1/2 flex flex-row gap-1 sm:hidden">
    <% if @notification.unread? %>
      <%= button_to mark_read_url,
                  method: :patch,
                  class: "w-5 h-5 rounded-full bg-green-100 hover:bg-green-200 border border-green-300 flex items-center justify-center",
                  data: { turbo_frame: "_top" },
                  title: "Als gelesen markieren" do %>
        <i class="bi bi-check text-green-600 text-xs"></i>
      <% end %>
    <% end %>

    <% if @notification.state_archived? %>
      <%= button_to unarchive_url,
                  method: :patch,
                  class: "w-5 h-5 rounded bg-surface-raised hover:bg-gray-100 border border-gray-300 flex items-center justify-center",
                  data: { turbo_frame: "_top" },
                  title: "Wiederherstellen" do %>
        <i class="bi bi-arrow-counterclockwise text-gray-600 text-xs"></i>
      <% end %>
    <% else %>
      <%= button_to archive_url,
                  method: :patch,
                  class: "w-5 h-5 rounded bg-gray-100 hover:bg-gray-200 border border-gray-300 flex items-center justify-center",
                  data: { turbo_frame: "_top" },
                  title: "Archivieren" do %>
        <i class="bi bi-archive text-gray-600 text-xs"></i>
      <% end %>
    <% end %>
  </div>

  <!-- State Indicator -->
  <div class="flex-shrink-0 mt-0.5">
    <%= state_indicator %>
  </div>

  <!-- Time -->
  <div class="flex-shrink-0 <%= secondary_text_class %> text-xs mt-0.5 w-12">
    <%= time_display %>
  </div>

  <!-- Icon -->
  <div class="flex-shrink-0 mt-0.5">
    <i class="bi bi-<%= event_icon %> text-gray-500 text-xs"></i>
  </div>

  <!-- Description -->
  <div class="flex-1 min-w-0">
    <div class="break-words <%= primary_text_class %>">
      <%= event_description %>
    </div>
  </div>

  <!-- Desktop Action Buttons (rechts, on hover) -->
  <div class="hidden sm:flex flex-shrink-0 items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
    <% if @notification.unread? %>
      <%= button_to mark_read_url,
                  method: :patch,
                  class: "inline-flex items-center gap-1 px-2 py-1 text-xs font-medium rounded border border-green-300 bg-green-50 text-green-700 hover:bg-green-100 hover:border-green-400 transition-all",
                  data: { turbo_frame: "_top" },
                  title: t('views.organisations.notifications.index.mark_as_read', default: 'Als gelesen markieren') do %>
        <i class="bi bi-check"></i> Erledigt
      <% end %>
    <% end %>

    <% if @notification.state_archived? %>
      <%= button_to unarchive_url,
                  method: :patch,
                  class: "inline-flex items-center gap-1 px-2 py-1 text-xs font-medium rounded border border-gray-300 bg-surface-raised text-gray-600 hover:bg-gray-100 hover:border-gray-400 transition-all",
                  data: { turbo_frame: "_top" },
                  title: t('views.organisations.notifications.index.unarchive', default: 'Wiederherstellen') do %>
        <i class="bi bi-arrow-counterclockwise"></i> Wiederherstellen
      <% end %>
    <% else %>
      <%= button_to archive_url,
                  method: :patch,
                  class: "inline-flex items-center gap-1 px-2 py-1 text-xs font-medium rounded border border-gray-300 bg-gray-50 text-gray-600 hover:bg-gray-100 hover:border-gray-400 transition-all",
                  data: { turbo_frame: "_top" },
                  title: t('views.organisations.notifications.index.archive_single', default: 'Archivieren') do %>
        <i class="bi bi-archive"></i> Archiv
      <% end %>
    <% end %>
  </div>

</div>

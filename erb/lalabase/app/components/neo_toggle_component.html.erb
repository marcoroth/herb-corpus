<div class="<%= wrapper_classes %>">
  <!-- Hidden input for unchecked state (Rails convention) -->
  <%= tag.input **hidden_input_attributes %>
  
  <!-- Toggle Switch -->
  <label class="<%= toggle_track_classes %>" for="<%= toggle_id %>" style="<%= track_inline_styles %>">
    <!-- Actual checkbox input (hidden but accessible) -->
    <%= tag.input(
      **component_attributes.merge(
        class: "sr-only"
      )
    ) %>
    
    <!-- Visual toggle thumb -->
    <span class="<%= toggle_thumb_classes %>" style="<%= thumb_inline_styles %>"></span>
  </label>

  <!-- Label and Description -->
  <div class="flex flex-col">
    <label for="<%= toggle_id %>" class="<%= label_text_classes %>">
      <%= @label %>
    </label>
    <% if @description.present? %>
      <p class="<%= description_classes %>">
        <%= @description %>
      </p>
    <% end %>
  </div>
</div>
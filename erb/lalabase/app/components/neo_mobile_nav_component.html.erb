<div class="mobile-bottom-bar" data-controller="neo-mobile-nav"
     data-neo-mobile-nav-edit-label-value="<%= t('mobile.edit_count', count: '%{count}') %>"
     data-action="ticket-selection:change@window->neo-mobile-nav#selectionChanged">
  <nav class="mobile-bottom-links" aria-label="<%= t('mobile.organisation_navigation') %>" data-neo-mobile-nav-target="navigation">
    <% helpers.mobile_navigation_items.each do |item| %>
      <%= link_to item[:path], class: ('is-active' if helpers.mobile_active_destination == item[:key]), aria: { current: ('page' if request.path == URI.parse(item[:path]).path), label: (helpers.navigation_notifications_label(unread_count) if item[:key] == 'inbox') },
          data: (item[:key] == 'inbox' ? { controller: 'notification-count-listener', notification_count_listener_count_value: unread_count,
            notification_count_listener_zero_label_value: t('mobile.inbox'), notification_count_listener_one_label_value: t('mobile.inbox'), notification_count_listener_other_label_value: t('mobile.inbox') } : {}) do %>
        <span class="mobile-nav-icon"><i class="bi bi-<%= item[:icon] %>" aria-hidden="true"></i>
          <% if item[:key] == 'inbox' %><%= render Neo::UnreadMarkerComponent.new(count: unread_count, live: true, class: 'mobile-inbox-count', data: { notification_count_listener_target: 'indicator' }) %><% end %>
        </span>
        <span><%= t("mobile.#{item[:key]}") %></span>
      <% end %>
    <% end %>
  </nav>
  <div class="mobile-bottom-actions" hidden data-neo-mobile-nav-target="actions">
    <button type="button" class="mobile-primary" data-neo-mobile-nav-target="edit" data-action="neo-mobile-nav#edit"></button>
    <button type="button" class="mobile-icon" data-action="neo-mobile-nav#more" aria-label="<%= t('mobile.more_actions') %>"><i class="bi bi-three-dots" aria-hidden="true"></i></button>
  </div>
</div>

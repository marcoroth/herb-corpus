<div class="relative">
  <div class="<%= container_classes %>">
    <% @options.each_with_index do |option, index| %>
      <% label, value, icon = option %>
      <% input_id = unique_id(value) %>
      
      <label for="<%= input_id %>" class="<%= label_classes %>">
        <%= tag.input(**input_attributes(value).merge(id: input_id)) %>
        <% if icon.present? %>
          <i class="bi bi-<%= icon %> text-xs"></i>
        <% end %>
        <span><%= label %></span>
      </label>
    <% end %>
  </div>
</div>
<%# Org-wide key figures as a 2x2 grid of compact cards. Numbers are sans-bold tabular-nums (no
    display serif for figures), labels mono-uppercase — consistent with the week-stats card. %>
<div>
  <%= render WidgetHeaderComponent.new(title: t('overview.widgets.org_stats_cards')) %>
  <div class="grid grid-cols-2 gap-3">
    <% cards.each do |card| %>
      <% card_body = capture do %>
        <div class="font-mono text-xs uppercase tracking-wider text-cream-600 mb-2"><%= t("overview.cards.#{card[:key]}") %></div>
        <div class="flex items-baseline gap-1">
          <span class="font-mono text-3xl font-bold tracking-tight text-cream-900 tabular-nums"><%= card[:value] %></span>
          <% if card[:unit] %><span class="font-mono text-sm text-cream-600"><%= t('overview.cards.hours_unit') %></span><% end %>
        </div>
      <% end %>
      <% if card[:href] %>
        <%= link_to card[:href], class: "block p-4 bg-cream-50 border border-cream-300 rounded-lg transition-colors hover:border-cobalt-400 hover:bg-cobalt-50",
                    aria: { label: t('overview.drilldown.view_aria', label: t("overview.cards.#{card[:key]}")) } do %>
          <%= card_body %>
        <% end %>
      <% else %>
        <div class="p-4 bg-cream-50 border border-cream-300 rounded-lg"><%= card_body %></div>
      <% end %>
    <% end %>
  </div>
</div>

<%# Section header (title + period subtitle) + period switcher. Both week widgets render this
    identical chrome; only the body below differs. Tabs target this widget's own frame — the frame's
    target is _top, so the tabs override it back to the frame via data-turbo-frame. %>
<div>
  <%= render WidgetHeaderComponent.new(title: t(title_key), subtitle: subtitle) %>

  <div class="flex items-center gap-1 mb-3 flex-wrap" role="tablist">
    <% tabs.each do |tab| %>
      <%= link_to tab[:label],
                  tab[:url],
                  role: 'tab',
                  'aria-selected': tab[:active].to_s,
                  data: { turbo_frame: frame_id },
                  class: tab_classes(tab[:active]) %>
    <% end %>
  </div>
</div>

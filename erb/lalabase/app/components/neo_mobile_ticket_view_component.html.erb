<div class="<%= container_classes %>" data-controller="mobile-ticket-view">

  <% if show_list? %>
    <!-- List view for mobile -->
    <div class="mobile-list-view" data-mobile-ticket-view-target="listView">
      <%= list %>
    </div>
  <% end %>

  <% if show_detail_view? %>
    <!-- Detail view for mobile -->
    <div class="mobile-detail-view" data-mobile-ticket-view-target="detailView">
      <!-- Back Button -->
      <div class="flex justify-center py-3">
        <%= render Neo::Buttons::ButtonComponent.new(
          variant: :secondary,
          size: :medium,
          icon: "list",
          url: back_url,
          data: { turbo_frame: "_top" }
        ) do %>
          <%= back_label %>
        <% end %>
      </div>

      <!-- Detail Content -->
      <div class="mobile-detail-content">
        <%= detail %>
      </div>
    </div>
  <% end %>

</div>

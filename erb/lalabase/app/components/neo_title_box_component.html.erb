<div style="<%= gradient_style %>" class="<%= wrapper_classes %>">
  <% if center_content? %>
    <!-- 3-Column Layout when center content exists -->
    <div class="grid grid-cols-2 sm:grid-cols-3 items-center">
      <!-- Title Section (Left) -->
      <div class="min-w-0">
        <div class="flex items-baseline gap-3">
          <h1 class="text-2xl leading-tight font-bold text-heading">
            <%= @title %>
          </h1>
          <% if @badge.present? %>
            <span class="text-xs font-normal text-muted whitespace-nowrap"><%= @badge %></span>
          <% end %>
        </div>
        <% if resolved_subtitle.present? %>
          <p class="text-sm text-muted truncate"><%= resolved_subtitle %></p>
        <% end %>
      </div>

      <!-- Combined Center & Right Section on Mobile, Separate on Desktop -->
      <div class="flex items-center justify-end gap-4 sm:hidden">
        <!-- Actions (right) -->
        <div class="flex items-center gap-2">
          <% if title_action? %>
            <%= title_action %>
          <% end %>
          <% if right_content? %>
            <%= right_content %>
          <% elsif content.present? %>
            <%= content %>
          <% end %>
        </div>
      </div>

      <!-- Center Section (responsive positioning) -->
      <div class="flex justify-start sm:justify-center">
        <%= center_content %>
      </div>

      <!-- Desktop only: Right Section -->
      <div class="hidden sm:flex items-center gap-2 justify-end">
        <% if title_action? %>
          <%= title_action %>
        <% end %>
        <% if right_content? %>
          <%= right_content %>
        <% elsif content.present? %>
          <%= content %>
        <% end %>
      </div>
    </div>
  <% else %>
    <!-- 2-Column Layout when no center content -->
    <div class="flex flex-wrap items-start justify-between gap-4">
      <!-- Title Section (Left) -->
      <div class="min-w-0">
        <div class="flex items-baseline gap-3">
          <h1 class="text-2xl leading-tight font-bold text-heading">
            <%= @title %>
          </h1>
          <% if @badge.present? %>
            <span class="text-xs font-normal text-muted whitespace-nowrap"><%= @badge %></span>
          <% end %>
        </div>
        <% if resolved_subtitle.present? %>
          <p class="text-sm text-muted truncate"><%= resolved_subtitle %></p>
        <% end %>
      </div>

      <!-- Right Section (Actions) -->
      <div class="flex items-center gap-2">
        <% if title_action? %>
          <%= title_action %>
        <% end %>
        <% if right_content? %>
          <%= right_content %>
        <% elsif content.present? %>
          <%= content %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

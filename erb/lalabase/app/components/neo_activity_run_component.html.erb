<% if project_row? %>
  <div class="<%= project_row_wrapper_classes %>">
    <% row_tag = project_row_path ? :a : :div %>
    <%= content_tag row_tag,
                    href: project_row_path,
                    class: project_row_link_classes,
                    data: project_row_data do %>
      <span class="mt-0.5 flex h-[22px] w-[22px] items-center justify-center text-cream-500" aria-hidden="true">
        <i class="bi bi-<%= project_kind_icon %> text-[13px]"></i>
      </span>
      <span class="min-w-0">
        <span class="block text-[13px] leading-relaxed text-cream-800"><%= net_line %></span>
        <span class="mt-0.5 block truncate text-[12px] leading-relaxed text-cream-600">
          <%= project_actor_name %><span class="px-1" aria-hidden="true">&nbsp;·&nbsp;</span><%= project_object_name %>
        </span>
      </span>
      <span class="shrink-0 font-mono text-[12px] tabular-nums text-cream-500"><%= time_range %></span>
    <% end %>

    <details class="-mt-1 pb-2.5 pl-[58px] pr-3 text-[12px] text-cream-600">
      <summary class="cursor-pointer select-none rounded text-cream-700 hover:text-cream-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-ink">
        <%= steps_label %>
      </summary>
      <% if net_details.any? %>
        <div class="mt-2 border-l border-cream-300 pl-3">
          <%= render NeoActivityChangeDetailsComponent.new(changes: net_details) %>
        </div>
      <% end %>
      <div class="mt-1 border-l border-cream-300 pl-3">
        <% steps.each do |step| %>
          <div class="flex items-baseline gap-4 py-0.5">
            <span class="min-w-0 flex-1"><%= helpers.timeline_change_line(step, project_ticket || ticket) %></span>
            <span class="shrink-0 font-mono text-[12px] tabular-nums text-cream-500"><%= helpers.timeline_row_clock(step) %></span>
          </div>
        <% end %>
      </div>
    </details>
  </div>
<% else %>
<div class="activity-card" data-timeline-filter-target="activity"
     style="display: none;">
  <%# Same quiet row as a single change (NeoActivityComponent), but the line
      is the NET result of the cascade and the clock carries the span. The
      steps sit in the disclosure, ordered like the timeline itself; a net
      pair too long for the line stands above them. %>
  <div class="py-1.5 pl-[38px] text-[13px] leading-relaxed text-cream-600">
    <div class="flex items-baseline gap-4">
      <span class="min-w-0 flex-1">
        <%= net_line %><% if actor_suffix %> <span class="text-cream-500">&middot; <%= actor_suffix %></span><% end %>
      </span>
      <span class="shrink-0 font-mono text-[12px] text-cream-500"><%= time_range %></span>
    </div>

    <details class="mt-1">
      <summary class="cursor-pointer select-none text-cream-500 hover:text-cream-800">
        <%= steps_label %>
      </summary>
      <% if net_details.any? %>
        <div class="mt-2 rounded border border-cream-200 bg-surface-raised p-3 text-xs">
          <%= render NeoActivityChangeDetailsComponent.new(changes: net_details) %>
        </div>
      <% end %>
      <div class="mt-1">
        <% steps.each do |step| %>
          <div class="flex items-baseline gap-4 py-0.5">
            <span class="min-w-0 flex-1"><%= helpers.timeline_change_line(step, ticket) %></span>
            <span class="shrink-0 font-mono text-[12px] text-cream-500"><%= helpers.timeline_row_clock(step) %></span>
          </div>
        <% end %>
      </div>
    </details>
  </div>
</div>
<% end %>

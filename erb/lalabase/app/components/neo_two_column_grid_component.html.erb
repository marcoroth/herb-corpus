<div class="<%= grid_classes %>"
     <%= 'data-controller="lane-split"'.html_safe if lane %>
     style="height: calc(100vh - <%= chrome_height %>px);<%= ' margin-top: 4px;' unless lane %> overflow: hidden;"
     <%= grid_controller_attributes.map { |k, v| "#{k}=\"#{v}\"" }.join(" ").html_safe %>>

  <!-- List Column -->
  <aside class="column list column-spacing-sm" data-hover-arrows-target="list">
    <div id="<%= list_container_id %>" data-keyboard-navigation-target="listContainer">
      <%= list %>
    </div>
  </aside>

  <%# The split between list and lane, grabbed at the line that separates them.
      It is NOT a grid track: a track would take width from the two columns and
      have to be subtracted everywhere the template is written. It lies over the
      channel instead, absolutely placed from the same --list-split the list
      track reads (layout.css, ".lane-split"), so the thing one drags and the
      thing that moves are one number.
      A separator with a value, not a button: screen readers announce a
      percentage and the arrow keys move it. %>
  <% if lane %>
    <div class="lane-split"
         data-lane-split-target="handle"
         data-action="pointerdown->lane-split#start keydown->lane-split#nudge dblclick->lane-split#reset"
         role="separator"
         aria-orientation="vertical"
         aria-valuemin="0"
         aria-valuemax="100"
         tabindex="0"
         title="<%= I18n.t('views.shared.lane_split') %>"
         aria-label="<%= I18n.t('views.shared.lane_split') %>"></div>
  <% end %>

  <!-- Content Column -->
  <main class="column content column-spacing-sm" data-hover-arrows-target="content">
    <div class="content-close-bar">
      <button class="content-close-text-btn content-close"
              data-action="click->layout-toggle#closeContent">
        <%= I18n.t('views.shared.close_content_panel') %> <i class="bi bi-x"></i>
      </button>
    </div>
    <%= main_content %>
  </main>

  <!-- Panel Column (third lane), only for the page that fills it (meetings; knowledge dropped its chat placeholder on 10.09.2026) -->
  <% if panel? %>
  <aside class="column panel">
    <button class="icon-button panel-close opacity-50 hover:opacity-100"
            data-action="click->layout-toggle#togglePanel"
            title="<%= panel_close_title.presence || I18n.t('views.shared.close_chat') %>"><i class="bi bi-x"></i></button>
    <%= panel %>
  </aside>
  <% end %>

  <%= side_panel if side_panel? %>
</div>

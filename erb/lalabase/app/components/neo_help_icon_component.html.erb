<div class="neo-help-icon-component inline-block" 
     data-controller="help-modal"
     data-help-modal-context-value="<%= context %>">
  
  <!-- Help Icon -->
  <button type="button"
          class="<%= icon_classes %>"
          data-action="click->help-modal#open"
          aria-label="<%= t('common.help.show_help') %>"
          title="<%= t('common.help.show_help') %>">
    <i class="bi bi-question-circle"></i>
  </button>

  <!-- Help Modal -->
  <div data-help-modal-target="modal"
       id="<%= modal_id %>"
       class="hidden fixed inset-0 z-modal overflow-y-auto"
       aria-labelledby="<%= modal_id %>-title"
       role="dialog"
       aria-modal="true">
    
    <!-- Backdrop -->
    <div class="fixed inset-0 bg-ink bg-opacity-50 opacity-0 transition-opacity duration-200"
         data-action="click->help-modal#close"
         data-help-modal-target="backdrop"></div>

    <!-- Modal Content -->
    <div class="flex items-center justify-center min-h-screen p-4">
      <div class="relative bg-surface-raised rounded-lg border border-slate-200 shadow-lg max-w-2xl w-full max-h-[80vh] flex flex-col overflow-hidden opacity-0 scale-95 transition-all duration-200"
           data-help-modal-target="content">

        <!-- Header -->
        <div class="flex-shrink-0 bg-yellow-100 border-b border-slate-200 px-6 py-4">
          <div class="flex items-center justify-between">
            <h2 id="<%= modal_id %>-title" class="text-xl font-bold text-cream-900">
              <%= t("#{context}_help.title") %>
            </h2>
            <button type="button"
                    class="p-2 hover:bg-yellow-200 rounded transition-colors"
                    data-action="click->help-modal#close"
                    aria-label="<%= t('common.close') %>">
              <i class="bi bi-x-lg text-xl"></i>
            </button>
          </div>
        </div>

        <!-- Actions List (Grouped) -->
        <div class="flex-1 min-h-0 overflow-y-auto px-6 py-4 bg-surface-raised">
          <div class="space-y-6">
            <% help_content_grouped.each do |group| %>
              <!-- Group Section -->
              <div>
                <!-- Group Title -->
                <h3 class="text-sm font-bold text-gray-600 uppercase tracking-wider mb-3 pb-2 border-b border-gray-300">
                  <%= group[:title] %>
                </h3>
                
                <!-- Group Actions -->
                <div class="space-y-2">
                  <% group[:actions].each do |action| %>
                    <div class="flex gap-4 p-3 rounded-lg border border-stroke bg-gray-50 hover:bg-lime-100 hover:shadow-sm transition-all duration-200">
                      <!-- Icon Button (matching actual button style) -->
                      <div class="flex-shrink-0">
                        <div class="w-10 h-10 rounded bg-orange-200 border border-stroke flex items-center justify-center hover:shadow-sm">
                          <i class="bi bi-<%= action[:icon] %> text-cream-900"></i>
                        </div>
                      </div>
                      
                      <!-- Content -->
                      <div class="flex-grow">
                        <div class="flex items-center gap-2 mb-1">
                          <h4 class="font-bold text-cream-900">
                            <%= action[:title] %>
                          </h4>
                          <% if action[:keyboard_shortcut].present? %>
                            <kbd class="px-2 py-0.5 text-xs font-mono bg-ink text-on-fill rounded">
                              <%= action[:keyboard_shortcut] %>
                            </kbd>
                          <% end %>
                        </div>
                        <div class="text-sm text-gray-700">
                          <%= simple_format(action[:description], {}, wrapper_tag: "div") %>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Footer -->
        <div class="flex-shrink-0 bg-gray-100 border-t border-slate-200 px-6 py-3">
          <div class="flex justify-between items-center">
            <p class="text-xs text-gray-600">
              <%= t('common.help.footer_hint') %>
            </p>
            <%= render Neo::Buttons::ButtonComponent.new(
              variant: :primary,
              size: :medium,
              data: { action: "click->help-modal#close" }
            ) do %>
              <%= t('common.close') %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
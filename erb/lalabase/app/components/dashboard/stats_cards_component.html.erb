<%# Konfigurierbare Statistik-Karten. auto-fit + minmax: the cards reflow to the widget's own
    width (not the viewport), so the same widget shows 1x4 when wide and 2x2 when half-width. %>
<div class="hidden md:grid grid-cols-[repeat(auto-fit,minmax(9rem,1fr))] gap-4 mb-8">
  <% visible_cards.each do |card| %>
    <%= render NeoCardComponent.new(variant: :transparent, shadow: :none, padding: :small, classes: card[:config][:bg]) do %>
      <div class="flex items-center justify-between mb-2">
        <h3 class="text-sm font-bold uppercase text-cream-900 opacity-70"><%= t(card[:config][:label_key]) %></h3>
        <i class="<%= card[:config][:icon] %> text-xl"></i>
      </div>
      <p class="text-3xl font-black mb-1"><%= card[:data][:value] %></p>
      <p class="text-xs text-cream-900 opacity-50">
        <%= card[:data][:subtitle] %>
      </p>
    <% end %>
  <% end %>
</div>

<%= render NeoCardComponent.new(variant: :surface, shadow: :none, padding: :small, classes: 'mt-6') do %>
  <%= render WidgetHeaderComponent.new(title: t('dashboard.team_members.title')) do |header| %>
    <% if can_manage_members? %>
      <% header.with_actions do %>
        <%= render Neo::Buttons::ButtonComponent.new(
              variant: :secondary,
              size: :medium,
              url: helpers.organisation_project_project_permissions_path(current_organisation, project)
            ) do %>
              <%= t('dashboard.team_members.manage') %>
            <% end %>
      <% end %>
    <% end %>
  <% end %>
  <div>
  <% if members.any? %>
    <div class="flex flex-wrap gap-3">
      <% members.each do |member| %>
        <% person = member.user %>
        <div class="flex items-center gap-2 px-3 py-2 border border-cream-300 rounded bg-cream-100">
          <%# Avatar + spelled name (Slack model, 05.09.2026). %>
          <%= helpers.viewer_user_chip(person, size: :medium, text_class: 'text-sm font-medium') %>
          <% if (badge = source_badge(member)) %>
            <span class="text-xs text-cream-600 whitespace-nowrap">· <%= badge %></span>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-center text-cream-600 py-4"><%= t('dashboard.team_members.no_members') %></p>
  <% end %>
  </div>
<% end %>

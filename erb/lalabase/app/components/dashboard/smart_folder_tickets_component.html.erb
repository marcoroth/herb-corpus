<%= render NeoCardComponent.new(variant: :surface, shadow: :none, padding: :small) do %>
  <%= render WidgetHeaderComponent.new(title: folder_name) do |header| %>
    <% if folder_available? %>
      <% header.with_actions do %>
        <%= render Neo::Buttons::ButtonComponent.new(
              variant: :secondary,
              size: :medium,
              url: helpers.organisation_project_tickets_path(current_organisation, project)
            ) do %>
              <span class="hidden sm:inline"><%= t('dashboard.smart_folder_tickets.view_all') %></span>
              <span class="sm:hidden"><%= t('dashboard.smart_folder_tickets.all') %></span>
            <% end %>
      <% end %>
    <% end %>
  <% end %>
  <div>
  <% if !folder_available? %>
    <div class="text-center py-8">
      <i class="bi bi-exclamation-triangle text-2xl text-cream-500 mb-2"></i>
      <p class="text-cream-600"><%= t('dashboard.smart_folder_tickets.unavailable_message') %></p>
    </div>
  <% elsif results.any? %>
    <div class="space-y-3">
      <% results.each do |ticket| %>
        <%= link_to ticket_turbo_frame_path(current_organisation, project, ticket),
            class: "block p-3 border border-cream-300 rounded hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all #{ticket_highlight_classes(ticket)}" do %>
          <div class="flex justify-between items-start">
            <div class="flex-1">
              <h4 class="font-bold text-sm mb-1">
                #<%= ticket.number %>
                <%= render Neo::UnreadMarkerComponent.new(count: unread_notifications_per_ticket[ticket.id].to_i, variant: :dot,
                                                          class: 'align-middle ml-0.5', label: t('tickets.has_unread_notifications')) %>
                <%= ticket.title %><% if ticket.overdue? %> <%= helpers.ticket_due_badge(ticket) %><% end %>
              </h4>
              <div class="space-y-1">
                <div class="text-xs text-cream-600">
                  <%= t('dashboard.smart_folder_tickets.updated') %>: <%= ticket.updated_at.strftime("%d.%m.%y %H:%M") %>
                </div>
                <div class="text-xs">
                  <%= helpers.ticket_priority_info(ticket) %>
                </div>
                <div class="text-xs">
                  <%= helpers.ticket_status_info(ticket) %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="text-center text-cream-600 py-8"><%= t('dashboard.smart_folder_tickets.no_tickets') %></p>
  <% end %>
  </div>
<% end %>

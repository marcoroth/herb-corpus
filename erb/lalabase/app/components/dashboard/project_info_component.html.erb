<%= render NeoCardComponent.new(variant: :surface, shadow: :none, padding: :medium, classes: 'hidden md:block') do %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <h3 class="text-sm font-bold uppercase text-cream-600 mb-2"><%= t('organisations.projects.show.description') %></h3>
      <p class="text-cream-900">
        <%= project.description.present? ? project.description : t('organisations.projects.show.no_description') %>
      </p>
    </div>
    <div>
      <%# Header = pure label; the „Feld hinzufügen" action sits BELOW the list (expands the list). %>
      <h3 class="text-sm font-bold uppercase text-cream-600 mb-2"><%= t('organisations.projects.show.custom_fields') %></h3>
      <% if custom_fields.any? %>
        <div class="space-y-1">
          <% custom_fields.each do |attr_def| %>
            <div class="flex items-center justify-between text-sm">
              <span class="font-medium"><%= attr_def.label_for %></span>
              <div class="flex items-center gap-2">
                <%# Type badge: neutral pill (D6). %>
                <span class="text-xs text-cream-600 bg-cream-100 px-2 py-0.5 rounded"><%= attr_def.field_type %></span>
                <% if helpers.policy(current_organisation).admin? %>
                  <%# D6 inline action icon: borderless, hover color change + keyboard focus ring. %>
                  <%= link_to helpers.edit_organisation_project_ticket_attribute_definition_path(current_organisation, project, attr_def),
                              title: t('common.edit'),
                              class: "p-1 text-cream-500 hover:text-cream-900 focus-visible:text-cream-900 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ink rounded transition-colors" do %>
                    <i class="bi bi-pencil text-xs"></i>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-cream-600"><%= t('organisations.projects.show.no_custom_fields') %></p>
      <% end %>

      <% if helpers.policy(current_organisation).admin? %>
        <%# „Feld hinzufügen" BELOW the list — expands the list (inline-add pattern), not in the header. %>
        <div class="mt-3">
          <%= render Neo::Buttons::ButtonComponent.new(
                variant: :primary,
                size: :small,
                icon: "plus-lg",
                url: helpers.new_organisation_project_ticket_attribute_definition_path(current_organisation, project)
              ) do %>
            <%= t('organisations.projects.show.add_field') %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<%= render NeoCardComponent.new(variant: :surface, shadow: :none, padding: :small) do %>
  <%= render WidgetHeaderComponent.new(title: t('dashboard.notifications.title')) do |header| %>
    <% header.with_actions do %>
      <% if unread_count > 0 %>
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-red-100 border border-cream-300 text-red-800">
          <%= unread_count %>
        </span>
      <% end %>
      <%= render Neo::Buttons::ButtonComponent.new(
            variant: :secondary,
            size: :medium,
            url: helpers.organisation_notifications_path(current_organisation)
          ) do %>
            <span class="hidden sm:inline"><%= t('dashboard.notifications.view_all') %></span>
            <span class="sm:hidden"><%= t('dashboard.notifications.all') %></span>
          <% end %>
    <% end %>
  <% end %>
  <div>
  <% if notifications.any? %>
    <div class="space-y-3">
      <% notifications.each do |notification| %>
        <div class="block p-3 border border-cream-300 rounded bg-cream-50">
          <div class="flex items-start gap-2">
            <% if notification.actor.present? %>
              <div class="w-6 h-6 rounded-full bg-cream-200 border border-cream-300 flex-shrink-0 flex items-center justify-center text-xs font-bold">
                <%= notification.actor.first_name&.first&.upcase || '' %>
              </div>
            <% else %>
              <div class="w-6 h-6 rounded-full bg-cream-100 border border-cream-300 flex-shrink-0 flex items-center justify-center">
                <i class="bi bi-bell text-xs"></i>
              </div>
            <% end %>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium truncate">
                <%= notification.payload&.dig('title') || notification.event_type&.humanize || t('dashboard.notifications.notification') %>
              </p>
              <p class="text-xs text-cream-900 opacity-50 mt-0.5">
                <%= helpers.time_ago_in_words(notification.created_at) %> <%= t('dashboard.notifications.ago') %>
              </p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-center text-cream-600 py-8"><%= t('dashboard.notifications.no_notifications') %></p>
  <% end %>
  </div>
<% end %>

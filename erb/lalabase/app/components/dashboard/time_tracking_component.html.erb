<%= render NeoCardComponent.new(variant: :surface, shadow: :none, padding: :small) do %>
  <%= render WidgetHeaderComponent.new(title: t('dashboard.time_tracking.title')) do |header| %>
    <% header.with_actions do %>
      <%= render Neo::Buttons::ButtonComponent.new(
            variant: :secondary,
            size: :medium,
            url: helpers.time_list_path(current_organisation, project: project)
          ) do %>
            <span class="hidden sm:inline"><%= t('dashboard.time_tracking.view_all') %></span>
            <span class="sm:hidden"><%= t('dashboard.time_tracking.all') %></span>
          <% end %>
    <% end %>
  <% end %>

  <%# Statistik-Karten %>
  <div class="grid grid-cols-3 gap-3 mb-4">
    <div class="text-center p-2 bg-cream-50 border border-cream-300 rounded">
      <p class="text-2xl font-black"><%= formatted_duration %>h</p>
      <p class="text-xs text-cream-900 opacity-50"><%= t('dashboard.time_tracking.unbilled') %></p>
    </div>
    <div class="text-center p-2 bg-cream-50 border border-cream-300 rounded">
      <p class="text-2xl font-black"><%= unbilled_stats[:session_count] %></p>
      <p class="text-xs text-cream-900 opacity-50"><%= t('dashboard.time_tracking.sessions') %></p>
    </div>
    <div class="text-center p-2 bg-cream-50 border border-cream-300 rounded">
      <p class="text-2xl font-black"><%= unbilled_stats[:open_tickets_count] %></p>
      <p class="text-xs text-cream-900 opacity-50"><%= t('dashboard.time_tracking.open_tickets') %></p>
    </div>
  </div>

  <%# Letzte Sessions %>
  <% if recent_sessions.any? %>
    <div class="space-y-2">
      <% recent_sessions.each do |session| %>
        <% if session.ticket.present? %>
          <%= link_to helpers.organisation_project_ticket_path(current_organisation, project, session.ticket),
              class: "block p-2 border border-cream-300 rounded bg-cream-50 text-sm hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all" do %>
            <div class="flex justify-between items-center">
              <div class="flex-1 min-w-0">
                <span class="font-medium truncate block">
                  #<%= session.ticket.number %> <%= session.ticket.title.truncate(40) %>
                </span>
                <span class="text-xs text-cream-900 opacity-50">
                  <%= helpers.viewer_display_name(session.creator) %> &middot; <%= session.created_at.strftime("%d.%m.%y") %>
                </span>
              </div>
              <span class="font-bold text-xs whitespace-nowrap ml-2">
                <%= (session.duration / 60.0).round(1) %>h
              </span>
            </div>
          <% end %>
        <% else %>
          <div class="p-2 border border-cream-300 rounded bg-cream-50 text-sm">
            <div class="flex justify-between items-center">
              <div class="flex-1 min-w-0">
                <span class="font-medium truncate block"><%= t('dashboard.time_tracking.no_ticket') %></span>
                <span class="text-xs text-cream-900 opacity-50">
                  <%= helpers.viewer_display_name(session.creator) %> &middot; <%= session.created_at.strftime("%d.%m.%y") %>
                </span>
              </div>
              <span class="font-bold text-xs whitespace-nowrap ml-2">
                <%= (session.duration / 60.0).round(1) %>h
              </span>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="text-center text-cream-600 py-4"><%= t('dashboard.time_tracking.no_sessions') %></p>
  <% end %>
<% end %>

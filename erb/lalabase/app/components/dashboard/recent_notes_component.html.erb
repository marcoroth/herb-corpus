<%= render NeoCardComponent.new(variant: :surface, shadow: :none, padding: :small) do %>
  <%= render WidgetHeaderComponent.new(title: t('dashboard.recent_notes.title')) do |header| %>
    <% header.with_actions do %>
      <%= render Neo::Buttons::ButtonComponent.new(
            variant: :secondary,
            size: :medium,
            url: helpers.organisation_project_notes_path(current_organisation, project)
          ) do %>
            <span class="hidden sm:inline"><%= t('dashboard.recent_notes.view_all') %></span>
            <span class="sm:hidden"><%= t('dashboard.recent_notes.all') %></span>
          <% end %>
      <% if can_create_notes? %>
        <%# New note: an icon-only plus (D2.1). It names the address of the form outright,
            the knowledge page with the form open. Over notes/new it would arrive there as
            well, after a redirect and a second full render of that page. %>
        <%= render Neo::Buttons::IconButtonComponent.new(
              variant: :primary,
              size: :medium,
              icon: "plus-lg",
              title: t('buttons.new', default: 'New'),
              url: helpers.organisation_project_knowledge_index_path(current_organisation, project, new: 'note')
            ) %>
      <% end %>
    <% end %>
  <% end %>
  <div>
  <% if recent_notes.any? %>
    <div class="space-y-3">
      <% recent_notes.each do |note| %>
        <%= link_to helpers.organisation_project_note_path(current_organisation, project, note),
            class: "block p-3 border border-cream-300 rounded hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all" do %>
          <h4 class="font-bold text-sm mb-1"><%= note.title %></h4>
          <% if note.description.present? %>
            <p class="text-xs text-cream-900 opacity-70 line-clamp-2"><%= note.description %></p>
          <% end %>
          <p class="text-xs text-cream-900 opacity-50 mt-1">
            <%= note.created_at.strftime("%d.%m.%Y %H:%M") %>
          </p>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="text-center text-cream-600 py-8"><%= t('dashboard.recent_notes.no_notes') %></p>
  <% end %>
  </div>
<% end %>

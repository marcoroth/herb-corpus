<% if project_row? %>
  <div class="<%= project_row_wrapper_classes %>">
    <% row_tag = project_row_path ? :a : :div %>
    <%= content_tag row_tag,
                    href: project_row_path,
                    class: project_row_link_classes,
                    data: project_row_data do %>
      <span class="mt-0.5 flex h-[22px] w-[22px] items-center justify-center text-cream-500" aria-hidden="true">
        <i class="bi bi-<%= project_kind_icon %> text-[13px]"></i>
      </span>
      <span class="min-w-0">
        <span class="block text-[13px] leading-relaxed text-cream-800"><%= activity_line %></span>
        <span class="mt-0.5 block truncate text-[12px] leading-relaxed text-cream-600">
          <%= project_actor_name %><span class="px-1" aria-hidden="true">&nbsp;·&nbsp;</span><%= project_object_name %>
        </span>
      </span>
      <span class="shrink-0 font-mono text-[12px] tabular-nums text-cream-500"><%= row_time %></span>
    <% end %>

    <% if show_details? %>
      <details class="-mt-1 pb-2.5 pl-[58px] pr-3 text-[12px] text-cream-600">
        <summary class="cursor-pointer select-none rounded text-cream-700 hover:text-cream-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-ink">
          <%= details_label %>
        </summary>
        <div class="mt-2 border-l border-cream-300 pl-3">
          <%= render NeoActivityChangeDetailsComponent.new(changes: change_details) %>
        </div>
      </details>
    <% end %>
  </div>
<% else %>
<div class="<%= base_classes %>" data-timeline-filter-target="activity"
     style="display: none;">
  <%# T4 quiet side note: one grey line, the record of what happened, not a
      card competing with the comments. Indented by the author mark's width
      plus its gap (26 + 12) so its text starts on the SAME edge as a
      comment's - the 26px column names the KIND, and a change carries no
      mark at all (designer round 05.09.2026). %>
  <div class="py-1.5 pl-[38px] text-[13px] leading-relaxed text-cream-600">
    <%# Field first, arrow instead of sentence; the actor only when the
        person switches; the time sits on the right in mono, always
        visible. %>
    <div class="flex items-baseline gap-4">
      <span class="min-w-0 flex-1">
        <%= activity_line %><% if actor_suffix %> <span class="text-cream-500">&middot; <%= actor_suffix %></span><% end %>
      </span>
      <span class="shrink-0 font-mono text-[12px] text-cream-500"><%= row_time %></span>
    </div>

    <% if show_details? %>
      <details class="mt-1">
        <summary class="cursor-pointer select-none text-cream-500 hover:text-cream-800">
          <%= details_label %>
        </summary>
        <div class="mt-2 rounded border border-cream-200 bg-surface-raised p-3 text-xs">
          <%= render NeoActivityChangeDetailsComponent.new(changes: change_details) %>
        </div>
      </details>
    <% end %>
  </div>
</div>
<% end %>

<!-- Project Tab Navigation (Minimal with Bold Typography) -->
<div class="mb-8 -mt-8">
  <div class="flex overflow-x-auto scrollbar-hide gap-8">
    <!-- Dashboard -->
    <% if @has_project_access %>
      <%= link_to helpers.organisation_project_path(organisation_id: @project.organisation_id, id: @project.id),
          class: tab_classes(tab_active?('dashboard')) do %>
        Dashboard
      <% end %>
    <% end %>

    <!-- Tickets -->
    <% if @can_access_tickets %>
      <%= link_to helpers.organisation_project_tickets_path(organisation_id: @project.organisation_id, project_id: @project.id, **tickets_params),
          class: tab_classes(tab_active?('tasks')) do %>
        Tickets
      <% end %>
    <% end %>

    <!-- Knowledge (Notes + Documents) -->
    <% if @can_access_knowledge %>
      <%= link_to helpers.organisation_project_knowledge_index_path(organisation_id: @project.organisation_id, project_id: @project.id, **navigation_params),
          class: tab_classes(tab_active?('knowledge')) do %>
        Wissen
      <% end %>
    <% end %>

    <!-- Documentation (external synced docs) -->
    <% if @can_access_documentation %>
      <%= link_to helpers.organisation_project_documentation_index_path(organisation_id: @project.organisation_id, project_id: @project.id, **navigation_params),
          class: tab_classes(tab_active?('documentation')) do %>
        <%= helpers.t('navigation.documentation') %>
      <% end %>
    <% end %>

    <!-- Meetings (Gespräche) — text-only to match the sibling tabs (they carry no icon) -->
    <% if @can_access_meetings %>
      <%= link_to helpers.organisation_project_meetings_path(organisation_id: @project.organisation_id, project_id: @project.id, **navigation_params),
          class: tab_classes(tab_active?('meetings')) do %>
        <%= helpers.t('navigation.meetings') %>
      <% end %>
    <% end %>

    <!-- Team (Project Permissions) -->
    <% if @can_view_members %>
      <%= link_to helpers.organisation_project_project_permissions_path(organisation_id: @project.organisation_id, project_id: @project.id),
          class: tab_classes(tab_active?('members')) do %>
        Team
      <% end %>
    <% end %>

    <!-- Smart Folders -->
    <% if @is_admin %>
      <%= link_to helpers.organisation_project_smart_folders_path(organisation_id: @project.organisation_id, project_id: @project.id),
          class: tab_classes(tab_active?('smart_folders')) do %>
        Smart Folders
      <% end %>
    <% end %>

    <!-- Settings (edit project) -->
    <% if @can_change_project %>
      <%= link_to helpers.edit_organisation_project_path(organisation_id: @project.organisation_id, id: @project.id),
          class: tab_classes(tab_active?('settings')) do %>
        Einstellungen
      <% end %>
    <% end %>

    <!-- Activities -->
    <% if @can_view_activities %>
      <%= link_to helpers.organisation_project_activities_path(organisation_id: @project.organisation_id, project_id: @project.id),
          class: tab_classes(tab_active?('activities')) do %>
        Aktivitäten
      <% end %>
    <% end %>
  </div>
</div>

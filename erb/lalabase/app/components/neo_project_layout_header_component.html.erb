<!-- Project Header with Title -->
<% component = NeoTitleBoxComponent.new(
  title: computed_title,
  subtitle: subtitle,
  badge: badge_text,
  variant: :project,
  margin_bottom: margin_bottom
) %>

<%= render component do |c| %>
  <% if title_action? %>
    <% c.with_title_action do %>
      <%= title_action %>
    <% end %>
  <% end %>
  <!-- Actions (Right) -->
  <% c.with_right_content do %>
    <div class="flex items-center gap-2">
      <%= right_content %>
    </div>
  <% end %>
<% end %>

<% if active_smart_folder.present? && active_smart_folder.description.present? %>
  <p class="text-sm text-cream-900 opacity-50 mb-4 mt-8"><%= active_smart_folder.description %></p>
<% end %>

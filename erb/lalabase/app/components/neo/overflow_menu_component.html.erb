<div class="relative" data-controller="dropdown">
  <%= render Neo::Buttons::IconButtonComponent.new(
        icon: icon,
        variant: :ghost,
        size: size,
        title: t(trigger_label_key),
        data: { action: 'click->dropdown#toggle' }
      ) %>
  <div class="hidden absolute right-0 top-full mt-1 w-56 bg-surface-raised border border-cream-300 rounded-lg shadow-md py-1 z-50"
       data-dropdown-target="menu">
    <% items.each do |item| %>
      <%= item %>
    <% end %>
  </div>
</div>

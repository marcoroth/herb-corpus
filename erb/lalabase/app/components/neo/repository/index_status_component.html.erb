<%# id MUST equal ProjectIndex#status_dom_id — it is the Turbo replace target %>
<div id="<%= @index.status_dom_id %>" class="flex flex-wrap items-center gap-2 text-xs">
  <span class="inline-flex items-center px-2 py-0.5 border-2 border-stroke rounded font-bold uppercase tracking-wide <%= status_style %>">
    <%= status_label %>
  </span>

  <% if show_progress? %>
    <span class="text-gray-600 tabular-nums"><%= progress_text %></span>
  <% elsif ready? %>
    <span class="text-gray-500"><%= last_indexed_text %></span>
  <% end %>

  <% if failed? && @index.error_message.present? %>
    <span class="basis-full text-red-700">
      <span class="font-semibold"><%= t('views.organisations.indexing.error_prefix') %>:</span>
      <%= @index.error_message %>
    </span>
  <% end %>
</div>

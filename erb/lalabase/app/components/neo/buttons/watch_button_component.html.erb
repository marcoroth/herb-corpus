<div id="<%= dom_id %>">
  <div class="flex items-center gap-2">
    <div class="relative inline-flex">
      <%= render button_component_class.new(**button_attributes) do %>
        <%= button_text %>
      <% end %>
      <% if override? %>
        <span class="absolute -top-1 -right-1 w-2.5 h-2.5 bg-amber-400 border border-stroke rounded-full" title="<%= override_text %>"></span>
      <% end %>
    </div>
  </div>
</div>

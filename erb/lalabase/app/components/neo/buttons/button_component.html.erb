<% if @form %>
  <%= button_to @form[:action],
    method: @form[:method] || :post,
    params: @form[:params],
    class: component_classes,
    form: { data: { turbo_confirm: @confirm }.compact.merge(@form[:data] || {}) },
    **form_button_attributes do %>
    <%= render_spinner(visible: @loading) %>
    <%= render_icon(:left) %>
    <span data-neo-button-target="content">
      <%= content.presence || "" %>
    </span>
    <%= render_icon(:right) %>
  <% end %>
<% else %>
  <%= content_tag(
    @tag,
    class: component_classes,
    **component_attributes
  ) do %>
    <%= render_spinner(visible: @loading) %>
    <%= render_icon(:left) %>
    <span data-neo-button-target="content">
      <%= content.presence || "" %>
    </span>
    <%= render_icon(:right) %>
  <% end %>
<% end %>

<%# data-assistant-history: the panel controller's way of seeing that the list
    is ALREADY showing. Without it a second press on the header button rebuilds
    the address from a chat frame that is no longer in the document, drops the
    ?current= the first press carried, and the back arrow below silently points
    at the newest thread instead of the one the list was opened from. %>
<div data-assistant-history class="flex-1 min-h-0 flex flex-col">
  <div class="flex items-center gap-2 px-4 py-3 border-b-2 border-cream-300 shrink-0">
    <%# Targets the panel frame like every other link here: the back arrow must
        exchange the frame's content, never navigate the page the panel rides on.
        Absent in the lane variant, where the conversation is already visible. %>
    <% if back? %>
      <%= link_to back_path,
                  data: { turbo_frame: Neo::Chat::HistoryListComponent::FRAME_ID },
                  title: t('views.organisations.assistant_panels.history.back'),
                  aria: { label: t('views.organisations.assistant_panels.history.back') },
                  class: 'w-7 h-7 shrink-0 flex items-center justify-center text-cream-500 hover:text-cream-900 hover:bg-cream-200 rounded transition-all' do %>
        <i class="bi bi-arrow-left text-sm" aria-hidden="true"></i>
      <% end %>
    <% end %>
    <h3 class="min-w-0 truncate text-sm font-bold text-cream-900">
      <%= t('views.organisations.assistant_panels.history.title') %>
    </h3>
  </div>

  <% if threads.empty? %>
    <p class="p-4 text-sm text-muted">
      <%= t('views.organisations.assistant_panels.history.empty') %>
    </p>
  <% else %>
    <ul class="flex-1 min-h-0 overflow-y-auto">
      <% threads.each do |chat| %>
        <li>
          <%= link_to path_for(chat),
                      data: { turbo_frame: Neo::Chat::HistoryListComponent::FRAME_ID,
                              chat_id: chat.id,
                              assistant_history_current: current?(chat).to_s },
                      aria: { current: current?(chat) ? 'true' : nil },
                      class: "flex flex-col gap-0.5 px-4 py-3 border-b border-cream-200 hover:bg-cream-100 transition-colors #{'bg-cream-100' if current?(chat)}" do %>
            <span class="text-sm font-medium text-cream-900 truncate"><%= label_for(chat) %></span>
            <span class="text-xs text-muted"><%= created_on(chat) %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>

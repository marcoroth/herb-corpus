<div data-assistant-panel-target="draftReferences"
     data-reference-keys="<%= reference_keys %>"
     data-reference-limit="<%= Assistant::ReferenceRegistry::MAX_REFERENCES %>"
     data-reference-limit-label="<%= t('flash.assistant_chats.reference_limit', count: Assistant::ReferenceRegistry::MAX_REFERENCES) %>"
     data-reference-busy-label="<%= t('flash.assistant_chats.reference_busy') %>"
     data-remove-label="<%= t('views.organisations.assistant_panels.reference.remove', title: '__TITLE__') %>"
     class="mb-1 flex flex-wrap items-center gap-2">
  <%# One pill template for both client-side selection and a failed submit. %>
  <% [nil, *references].each do |record| %>
    <% key = record && Assistant::ReferenceRegistry.key_of(record) %>
    <% title = record && title_for(record) %>
    <% pill = capture do %>
      <span data-draft-reference class="inline-flex max-w-full items-center gap-1 rounded-full border border-ink bg-cream-200 px-2.5 py-0.5 text-xs font-semibold text-cream-900">
        <span class="text-faint"><%= t('views.organisations.assistant_panels.reference.label') %></span>
        <span data-draft-label class="truncate" title="<%= title %>"><%= title %></span>
        <input type="hidden" name="chat[reference_keys][]" value="<%= key %>">
        <button type="button" data-action="assistant-panel#removeDraftReference"
                class="-my-1 -mr-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-cream-700 hover:text-cream-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink"
                aria-label="<%= t('views.organisations.assistant_panels.reference.remove', title: title) %>">
          <i class="bi bi-x-lg text-[10px]" aria-hidden="true"></i>
        </button>
      </span>
    <% end %>
    <% if record %>
      <%= pill %>
    <% else %>
      <template data-assistant-panel-target="draftReferenceTemplate"><%= pill %></template>
    <% end %>
  <% end %>
  <p hidden role="alert" data-assistant-panel-target="referenceStatus" class="basis-full text-xs text-amber-700"></p>
</div>

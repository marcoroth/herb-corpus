<%# The persona select in the assistant settings. Auto-submit on change, the
    established pattern for a select that IS a setting (scope chip, style levels,
    meetings overview). The response is a turbo_stream, which Turbo applies
    wherever it lands, so this form carries NO turbo_frame: it navigates nothing
    and must not pull the settings view out from under itself. %>
<div class="<%= dom_class %>">
  <label class="block text-xs font-bold text-cream-900" for="assistant_persona_select">
    <%= t('views.organisations.assistant_panels.settings.persona_label') %>
  </label>
  <p class="mt-1 text-xs text-muted"><%= t('views.organisations.assistant_panels.settings.persona_hint') %></p>
  <%= form_with url: update_path, method: :patch,
                data: { controller: 'auto-submit' }, class: 'mt-2 block' do |form| %>
    <%# text-xs explicitly and focus:ring-0, for the reason the scope chip
        documents: form controls do not inherit font-size, and @tailwindcss/forms
        would otherwise paint its own blue focus ring, which is the browser's
        language rather than this app's. %>
    <%= form.select :prompt_persona_id,
                    options_from_collection_for_select(options, :id, ->(persona) { persona.label(I18n.locale) }, selected_id),
                    { include_blank: t('views.organisations.assistant_panels.settings.persona_default') },
                    name: 'chat_style_preference[prompt_persona_id]',
                    id: 'assistant_persona_select',
                    class: 'w-full truncate rounded border border-cream-300 bg-cream-50 ps-2.5 pe-7 py-1 text-xs ' \
                           'text-cream-900 transition-colors hover:bg-cream-100 hover:border-cream-400 ' \
                           'focus:outline-none focus:ring-0' %>
  <% end %>
</div>

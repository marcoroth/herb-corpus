<!-- Neo Flash Component -->
<div id="<%= @turbo_frame || "flash_#{SecureRandom.hex(4)}" %>"
     class="<%= component_classes %>"
     style="opacity: 0;"
     data-controller="neo-flash"
     data-neo-flash-auto-show-value="<%= true %>"
     data-neo-flash-auto-hide-value="<%= @auto_hide %>"
     data-neo-flash-hide-delay-value="<%= @hide_delay %>">
  <div class="flex flex-row items-center gap-4 py-3 px-4">
    <i class="bi <%= icon_name %> <%= icon_color %>"></i>
    <p class="flex flex-grow text-sm tracking-[0.25px] font-medium"><%= @message %></p>

    <% if @dismissible %>
      <button data-action="click->neo-flash#dismiss"
              class="flex items-center hover:bg-scrim/10 rounded p-1 transition-colors">
        <span class="bi bi-x-lg"></span>
      </button>
    <% end %>
  </div>
</div>

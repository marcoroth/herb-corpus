<div class="<%= row_classes %>"
     data-inbox-bulk-select-target="row"
     data-notification-id="<%= notification.id %>">
  <div class="flex items-start gap-3">

    <%# Bulk-select checkbox %>
    <div class="flex-shrink-0 pt-1">
      <input type="checkbox"
             class="w-4 h-4 border-2 border-stroke rounded cursor-pointer"
             aria-label="<%= t('views.organisations.notifications.item.select_aria', default: 'Auswählen') %>"
             data-inbox-bulk-select-target="checkbox"
             data-notification-id="<%= notification.id %>"
             data-action="change->inbox-bulk-select#toggle click->inbox-bulk-select#stopRowClick">
    </div>

    <%# Clickable main area: for ticket notifications → load the pane via
        turbo-frame, otherwise full navigation. %>
    <%= link_to link_url,
                class: 'flex items-start gap-3 flex-1 min-w-0',
                data: link_data do %>

    <%# Unread indicator. The event icon was DELIBERATELY removed — it got lost in
        the information noise of the row and was barely noticed. %>
    <div class="flex-shrink-0 pt-1.5">
      <% if unread? %>
        <%= render Neo::UnreadMarkerComponent.new(count: 1, variant: :dot, class: 'block',
                                                  label: t('views.organisations.notifications.item.unread_label')) %>
      <% else %>
        <span class="w-2 h-2 block"></span>
      <% end %>
    </div>

    <%# Main content %>
    <div class="flex-1 min-w-0">

      <%# Row 1: actor + archived badge + time-ago %>
      <div class="flex items-baseline justify-between gap-2">
        <span class="font-bold text-sm truncate <%= primary_text_class %>">
          <%= actor_name %>
        </span>
        <% if archived? %>
          <span class="inline-flex items-center gap-1 px-1.5 py-0.5 text-[10px] uppercase tracking-wider font-mono font-bold rounded bg-cream-200 text-cream-700 border border-cream-300 flex-shrink-0">
            <i class="bi bi-archive text-[9px]"></i>
            <%= t('views.organisations.notifications.item.archived_badge', default: 'Archiviert') %>
          </span>
        <% end %>
        <%# Bundle indicator: subtle — stack icon + number, no background.
            Full text in the title (hover/screenreader). %>
        <% if show_group_badge? %>
          <span class="inline-flex items-center gap-0.5 text-[11px] font-mono font-medium tabular-nums flex-shrink-0 <%= secondary_text_class %>"
                title="<%= t('views.organisations.notifications.item.bundle_badge_title', count: group_count, default: '%{count} Aktualisierungen') %>">
            <i class="bi bi-layers text-[10px]" aria-hidden="true"></i><%= group_count %>
          </span>
        <% end %>
        <span class="text-xs flex-shrink-0 <%= secondary_text_class %>">
          <%= time_ago %>
        </span>
      </div>

      <%# Row 2: event + notifiable title %>
      <p class="text-sm mt-0.5 line-clamp-2 <%= primary_text_class %>">
        <span class="<%= secondary_text_class %>"><%= event_label %></span>
        <% if notifiable_title.present? %>
          <span class="font-medium">— <%= notifiable_title %></span>
        <% end %>
      </p>

      <%# Row 3: project subline %>
      <% if project_name.present? %>
        <p class="text-xs mt-0.5 truncate <%= secondary_text_class %>">
          <i class="bi bi-folder text-xs mr-1"></i><%= project_name %>
        </p>
      <% end %>
    </div>
    <% end %>
    <%# End of link_to main area %>
  </div>
</div>

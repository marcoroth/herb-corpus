<div class="space-y-5" data-testid="project-activity-timeline">
  <% grouped_items.each do |date, day_items| %>
    <section aria-labelledby="activity-day-<%= date.iso8601 %>">
      <div class="mb-1 flex items-center gap-3 px-3">
        <h2 id="activity-day-<%= date.iso8601 %>" class="font-mono text-[12px] font-semibold tabular-nums text-cream-900">
          <%= formatted_date(date) %>
        </h2>
        <span class="font-mono text-[12px] tabular-nums text-cream-600"><%= activity_count(day_items) %></span>
        <span class="h-px min-w-8 flex-1 bg-cream-200" aria-hidden="true"></span>
      </div>

      <div>
        <% day_items.each do |item| %>
          <% if item.is_a?(Activities::RunCollapser::ActivityRun) %>
            <%= render NeoActivityRunComponent.new(
                  activity_run: item,
                  ticket: ticket_for(item),
                  project: project
                ) %>
          <% else %>
            <%= render NeoActivityComponent.new(
                  activity: item,
                  ticket: ticket_for(item),
                  project: project
                ) %>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>

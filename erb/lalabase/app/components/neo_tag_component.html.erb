<span class="<%= component_classes %>" <%= tag.attributes(component_attributes) %>>
  <% if @icon %>
    <i class="bi bi-<%= @icon %>"></i>
  <% end %>
  
  <span class="tag-text">
    <%= tag_content %>
  </span>
  
  <% if @removable %>
    <button type="button" 
            class="remove-button ml-1 -mr-1 p-0.5 rounded-full hover:bg-ink hover:bg-opacity-10 transition-colors"
            data-action="click->neo-tag#remove"
            aria-label="<%= remove_label %>">
      <i class="bi bi-x flex h-3 w-3 items-center justify-center text-base leading-none" aria-hidden="true"></i>
    </button>
  <% end %>
</span>
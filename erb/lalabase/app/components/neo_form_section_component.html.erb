<section id="<%= section_id %>" class="<%= wrapper_classes %>" <%= tag.attributes(data: data_attributes) %>>
  <!-- Section Header -->
  <div class="<%= header_classes %>" <%= @collapsible ? tag.attributes(data: { action: 'click->neo-form-section#toggle' }) : '' %>>
    <div class="flex items-start">
      <!-- Icon -->
      <%= render_icon %>
      
      <!-- Title & Description -->
      <div class="flex-1">
        <h3 class="<%= title_classes %>">
          <%= @title %>
        </h3>
        <% if @description.present? %>
          <p class="<%= description_classes %>">
            <%= @description %>
          </p>
        <% end %>
      </div>
    </div>
    
    <!-- Collapse Toggle -->
    <% if @collapsible %>
      <div class="flex-shrink-0 ml-4">
        <i class="bi <%= collapse_icon %> text-lg text-cream-500 transition-transform duration-200"
           <%= tag.attributes(data: chevron_data_attributes) %>></i>
      </div>
    <% end %>
  </div>

  <!-- Section Content -->
  <div class="<%= content_classes %>" <%= tag.attributes(data: content_data_attributes) %>>
    <%= content %>
  </div>
</section>

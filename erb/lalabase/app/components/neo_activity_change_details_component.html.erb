<%# One entry per field, or one Note for the list of a bulk run. The long form
    of a pair is a definition list: the word above each text says which side
    it is, so neither needs a colour or a line-through to tell them apart.
    Running text keeps the 70-character measure of the ticket description
    (max-w-[70ch]). %>
<div class="space-y-3">
  <% changes.each do |change| %>
    <% if note?(change) %>
      <%# A bulk run's list: one text under its label. No "vorher" and
          "nachher", because there is no pair to compare. %>
      <div>
        <div class="font-semibold text-cream-700"><%= change.label %></div>
        <p class="mt-1 max-w-[70ch] text-[13px] leading-relaxed text-cream-800"><%= change.text %></p>
      </div>
    <% elsif inline?(change) %>
      <div><%= helpers.timeline_change_pair(change) %></div>
    <% else %>
      <div>
        <div class="font-semibold text-cream-700"><%= change.label %></div>
        <dl class="mt-1 space-y-2">
          <% sides(change).each do |side_label, value| %>
            <div>
              <dt class="text-[11px] text-cream-500"><%= side_label %></dt>
              <dd class="max-w-[70ch] text-[13px] leading-relaxed text-cream-800">
                <% if value.blank? %>
                  <%= t('views.organisations.tickets.timeline.no_value') %>
                <% elsif markdown?(change, value) %>
                  <%= render Neo::MarkdownPreviewComponent.new(markdown: value, size: :base) %>
                <% else %>
                  <%= value %>
                <% end %>
              </dd>
            </div>
          <% end %>
        </dl>
      </div>
    <% end %>
  <% end %>
</div>

<% if cell.blocked? %>
  <span class="am-pill inline-flex items-center gap-1 rounded border px-2 py-0.5 text-xs font-medium bg-red-100 text-red-800 border-red-300"
        title="<%= t('views.organisations.access_matrix.states.blocked') %>">
    <i class="bi bi-x-circle" aria-hidden="true"></i>
    <span><%= t('views.organisations.access_matrix.states.blocked') %></span>
  </span>
<% elsif cell.none? %>
  <span class="am-pill inline-flex items-center gap-1 rounded border px-2 py-0.5 text-xs font-medium bg-cream-100 text-cream-500 border-cream-300">
    <i class="bi bi-dash-lg" aria-hidden="true"></i>
    <span><%= t('views.organisations.access_matrix.states.none') %></span>
  </span>
<% else %>
  <details class="am-cell">
    <summary class="am-pill inline-flex cursor-pointer items-center gap-1 rounded border px-2 py-0.5 text-xs font-medium <%= pill_class %>">
      <i class="bi bi-<%= icon %>" aria-hidden="true"></i>
      <span><%= level_label %></span>
      <% if cell.inherited? %>
        <i class="bi bi-lock-fill text-[10px] opacity-60" aria-hidden="true"></i>
        <span class="sr-only"><%= t('views.organisations.project_permissions.shared.inherited') %></span>
      <% end %>
    </summary>
    <div class="am-cell__pop" role="group" aria-label="<%= t('views.organisations.access_matrix.cell.details_label') %>">
      <p class="am-cell__pop-title"><%= t('views.organisations.access_matrix.cell.details_label') %></p>
      <ul class="am-cell__pop-list">
        <% areas.each do |area| %>
          <li>
            <span class="am-cell__pop-area"><%= area_label(area) %></span>
            <span class="am-cell__pop-level"><%= level_label(cell.per_area[area]) %></span>
          </li>
        <% end %>
      </ul>
    </div>
  </details>
<% end %>

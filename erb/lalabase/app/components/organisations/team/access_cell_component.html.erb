<% if mode == :edit %>
  <div class="inline-flex overflow-hidden rounded-md border border-cream-300"
       role="radiogroup"
       aria-label="<%= t("views.organisations.project_permissions.areas.#{area}") %>">
    <% LEVELS.each do |lvl| %>
      <div class="relative">
        <input type="radio"
               class="peer sr-only"
               name="<%= field_name %>"
               id="<%= input_id(lvl) %>"
               value="<%= lvl %>"
               <%= 'checked' if level == lvl %>
               data-action="change->team-member-edit#markDirty">
        <label for="<%= input_id(lvl) %>"
               title="<%= level_label(lvl) %>"
               class="flex h-11 w-11 cursor-pointer items-center justify-center text-cream-500 hover:bg-cream-100 md:h-9 md:w-9 <%= checked_class(lvl) %>">
          <i class="bi bi-<%= icon(lvl) %>" aria-hidden="true"></i>
          <span class="sr-only"><%= level_label(lvl) %></span>
        </label>
      </div>
    <% end %>
  </div>
<% else %>
  <span class="inline-flex items-center gap-1 rounded border px-2 py-0.5 text-xs font-medium <%= pill_class %>"
        title="<%= inherited ? t('views.organisations.project_permissions.shared.inherited') : '' %>">
    <i class="bi bi-<%= icon %>" aria-hidden="true"></i>
    <span><%= level_label %></span>
    <% if inherited %>
      <i class="bi bi-lock-fill text-[10px] opacity-60" aria-hidden="true"></i>
      <span class="sr-only"><%= t('views.organisations.project_permissions.shared.inherited') %></span>
    <% end %>
  </span>
<% end %>

<%# View row: a table row on md+, a bordered card on mobile %>
<tr data-team-member-edit-target="viewRow"
    class="mb-3 block rounded-lg border-2 border-ink p-3 md:mb-0 md:table-row md:rounded-none md:border-0 md:border-b md:border-cream-200 md:p-0 md:hover:bg-cream-100">
  <%# Name + provenance (primary) %>
  <td class="block border-b border-cream-200 pb-2 md:table-cell md:border-0 md:py-3 md:pl-1 md:pr-3 md:align-top">
    <div class="font-medium text-ink">
      <%= helpers.viewer_display_name(user) %>
      <% if member.is_self %><span class="font-normal text-cream-500"><%= t('views.organisations.project_permissions.member_row.you') %></span><% end %>
      <% if member.blocked? %>
        <span class="ml-1 inline-flex items-center gap-1 rounded border border-red-300 bg-red-50 px-1.5 py-0.5 text-[11px] font-medium uppercase tracking-wide text-red-700">
          <i class="bi bi-slash-circle" aria-hidden="true"></i><%= t('views.organisations.project_permissions.member_row.blocked') %>
        </span>
      <% end %>
    </div>
    <div class="text-xs text-cream-600">
      <% if link_role_source? %>
        <%= link_to source_label, helpers.organisation_roles_path(organisation),
                    class: "underline decoration-cream-300 underline-offset-2 hover:text-cobalt-700" %>
      <% else %>
        <%= source_label %>
      <% end %>
    </div>
  </td>

  <%# Effective access per area (secondary) %>
  <% AREAS.each do |area| %>
    <% cell = member.cells[area] %>
    <td class="flex items-center justify-between py-1 md:table-cell md:py-3 md:text-center">
      <span class="text-xs font-medium uppercase tracking-wide text-cream-500 md:hidden"><%= area_label(area) %></span>
      <%= render Organisations::Team::AccessCellComponent.new(area: area, level: cell.level, inherited: cell.inherited) %>
    </td>
  <% end %>

  <%# Time (status label + gear to the granular settings) %>
  <td class="flex items-center justify-between py-1 md:table-cell md:py-3 md:text-center">
    <span class="text-xs font-medium uppercase tracking-wide text-cream-500 md:hidden"><%= area_label(:time_sessions) %></span>
    <span class="inline-flex items-center gap-1">
      <span class="inline-flex items-center gap-1 rounded border border-cream-300 bg-cream-100 px-2 py-0.5 text-xs font-medium text-cream-700">
        <i class="bi bi-clock" aria-hidden="true"></i><%= time_label %>
      </span>
      <% if time_settings_path %>
        <%= link_to time_settings_path, class: "text-cream-500 hover:text-cobalt-700",
                    title: t('views.organisations.project_permissions.time.settings') do %>
          <i class="bi bi-gear-fill" aria-hidden="true"></i>
          <span class="sr-only"><%= t('views.organisations.project_permissions.time.settings') %></span>
        <% end %>
      <% end %>
    </span>
  </td>

  <%# Actions (tertiary) %>
  <td class="mt-3 flex justify-end gap-2 md:mt-0 md:table-cell md:py-3 md:pr-1 md:text-right md:align-top">
    <% if editable_inline? %>
      <button type="button" data-action="team-member-edit#open" title="<%= t('views.organisations.project_permissions.member_row.edit') %>"
              class="inline-flex h-8 w-8 items-center justify-center rounded border border-cream-300 text-cream-700 hover:bg-cream-100">
        <i class="bi bi-pencil" aria-hidden="true"></i>
        <span class="sr-only"><%= t('views.organisations.project_permissions.member_row.edit') %></span>
      </button>
    <% end %>

    <% if offer_explicit? %>
      <%= form_with url: create_path, method: :post, class: "inline" do %>
        <%= hidden_field_tag 'project_permission[user_id]', user.id %>
        <% AREAS.each do |area| %>
          <%= hidden_field_tag "project_permission[#{area}_access]", member.cells[area].level %>
        <% end %>
        <button type="submit" title="<%= t('views.organisations.project_permissions.member_row.make_explicit') %>"
                class="inline-flex h-8 items-center gap-1 rounded border border-cream-300 px-2 text-xs font-medium text-cream-700 hover:bg-cream-100">
          <i class="bi bi-pencil-square" aria-hidden="true"></i><%= t('views.organisations.project_permissions.member_row.make_explicit') %>
        </button>
      <% end %>
    <% end %>

    <% if revocable? %>
      <%= form_with url: revoke_path, method: :delete, class: "inline",
                    data: { turbo_confirm: t('views.confirm.remove_user') } do %>
        <button type="submit" title="<%= t('views.organisations.project_permissions.member_row.remove') %>"
                class="inline-flex h-8 w-8 items-center justify-center rounded border border-red-300 text-red-700 hover:bg-red-50">
          <i class="bi bi-trash" aria-hidden="true"></i>
          <span class="sr-only"><%= t('views.organisations.project_permissions.member_row.remove') %></span>
        </button>
      <% end %>
    <% end %>

    <%# A block is reversible on purpose: dropping the grant hands the role right back. %>
    <% if unblockable? %>
      <%= form_with url: destroy_path, method: :delete, class: "inline",
                    data: { turbo_confirm: t('views.confirm.unblock_user') } do %>
        <button type="submit" title="<%= t('views.organisations.project_permissions.member_row.unblock') %>"
                class="inline-flex h-8 items-center gap-1 rounded border border-cream-300 px-2 text-xs font-medium text-cream-700 hover:bg-cream-100">
          <i class="bi bi-unlock" aria-hidden="true"></i><%= t('views.organisations.project_permissions.member_row.unblock') %>
        </button>
      <% end %>
    <% end %>
  </td>
</tr>

<%# Edit row: pre-rendered, hidden, toggled by Stimulus. No GET-edit route, no fetch. %>
<% if editable_inline? %>
  <tr data-team-member-edit-target="editRow" class="hidden">
    <td colspan="8" class="block md:table-cell">
      <div class="mb-3 rounded-lg border-2 border-cobalt-300 bg-cobalt-50 p-4">
        <%= form_with url: destroy_path, method: :patch, scope: :project_permission do |f| %>
          <div class="mb-2 text-sm font-medium text-ink"><%= t('views.organisations.project_permissions.member_row.edit_title', name: helpers.viewer_display_name(user)) %></div>
          <div class="flex flex-wrap gap-x-6 gap-y-3">
            <% AREAS.each do |area| %>
              <div>
                <div class="mb-1 text-xs font-medium uppercase tracking-wide text-cream-600"><%= area_label(area) %></div>
                <%= render Organisations::Team::AccessCellComponent.new(
                      area: area, level: member.cells[area].level, mode: :edit, user_id: user.id) %>
              </div>
            <% end %>
          </div>
          <div class="mt-4 flex items-center justify-end gap-2">
            <button type="button" data-action="team-member-edit#close"
                    class="rounded border border-cream-300 px-3 py-1.5 text-sm font-medium text-cream-700 hover:bg-cream-100">
              <%= t('views.organisations.project_permissions.member_row.cancel') %>
            </button>
            <button type="submit" disabled data-team-member-edit-target="saveButton"
                    class="cursor-not-allowed rounded border border-ink bg-cobalt-600 px-3 py-1.5 text-sm font-medium text-white opacity-50">
              <i class="bi bi-check-lg" aria-hidden="true"></i> <%= t('views.organisations.project_permissions.member_row.save') %>
            </button>
          </div>
        <% end %>
      </div>
    </td>
  </tr>
<% end %>

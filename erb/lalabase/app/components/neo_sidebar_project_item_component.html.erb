<li class="group/proj mt-3" data-sidebar-project-accordion-target="item" data-project-id="<%= @project.id %>">
  <%# Project header: clicking (on the chevron OR the name) expands/collapses the project.
      You reach the dashboard via the Dashboard menu item. Only when a
      project has nothing to expand is the name a direct dashboard link
      (then there is nothing to toggle). Pin on the right. %>
  <div class="flex items-center gap-0 pl-2 pr-3">
    <% if has_extras? %>
      <button type="button"
              data-action="click->sidebar-project-accordion#toggleProject"
              aria-expanded="false"
              class="group/name flex-1 min-w-0 flex items-center gap-1.5 py-1.5 px-1 rounded text-left hover:bg-white/55 transition-colors">
        <i class="bi bi-chevron-right text-[11px] text-cream-700 shrink-0 transition-transform group-hover/name:text-heading" data-chevron></i>
        <span class="block truncate text-sm font-semibold <%= current? ? 'text-cream-900' : 'text-cream-800' %> group-hover/name:text-cream-900 transition-colors">
          <%= @project.name %>
        </span>
      </button>
    <% else %>
      <%# Nothing to expand -> the name is a direct link to the dashboard. %>
      <%= link_to project_dashboard_path,
          class: "group/name flex-1 min-w-0 flex items-center gap-1.5 py-1.5 px-1 rounded hover:bg-cream-200 transition-colors" do %>
        <%# Placeholder the width of the chevron so the name stays aligned with toggleable projects. %>
        <span class="shrink-0 w-3" aria-hidden="true"></span>
        <span class="block truncate text-sm font-semibold <%= current? ? 'text-cream-900' : 'text-cream-800' %> group-hover/name:text-cream-900 transition-colors">
          <%= @project.name %>
        </span>
      <% end %>
    <% end %>

    <%= pin_toggle(group: 'proj') %>
  </div>

  <%# Children indented with a connector line -> membership immediately visible.
      "extra" items (not pinned/active) are hidden when collapsed (see component). %>
  <ul class="flex flex-col gap-0.5 ml-6 pl-3 pr-3 mt-0.5 border-l border-cream-300">
    <% render_items.each do |item| %>
      <%= render_nav_item(item, extra: extra?(item), collapsed: true) %>
    <% end %>

    <% if has_more_items? %>
      <%# Administrative items (Team/Settings/Activities) behind "More":
          clicking reveals them at exactly this position and removes the "More"
          (one-time expand, no collapsing again). The whole group is
          data-extra and collapses together with the project chevron. %>
      <li data-extra data-controller="reveal-more" class="hidden">
        <button data-action="click->reveal-more#reveal"
                class="flex items-center gap-2 text-sm px-2 py-1.5 rounded text-cream-600 hover:text-cream-900 hover:bg-cream-200 transition-colors w-full text-left">
          <i class="bi bi-chevron-right text-[10px] shrink-0"></i>
          <span><%= t('navigation.more') %></span>
        </button>
        <ul class="flex flex-col gap-0.5">
          <% more_items.each do |item| %>
            <%= render_nav_item(item, more_item: true) %>
          <% end %>
        </ul>
      </li>
    <% end %>
  </ul>
</li>

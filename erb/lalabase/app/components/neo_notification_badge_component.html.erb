<div id="notification_badge" class="<%= wrapper_classes %>">
  <% if render? %>
    <span class="<%= badge_classes %>"
          role="status"
          aria-label="<%= aria_label %>">
      <%= display_count %>
      <% if @variant == :dot %>
        <span class="sr-only"><%= aria_label %></span>
      <% end %>
    </span>
  <% end %>
</div>
<div class="p-8 space-y-8 bg-gray-50">
  <h1 class="text-2xl font-bold mb-6">Neo Button Component - All Variants</h1>

  <!-- Variants -->
  <section>
    <h2 class="text-lg font-semibold mb-4">Variants</h2>
    <div class="flex flex-wrap gap-4">
      <%= render Neo::Buttons::ButtonComponent.new(variant: :primary) do %>Primary<% end %>
      <%= render Neo::Buttons::ButtonComponent.new(variant: :secondary) do %>Secondary<% end %>
      <%= render Neo::Buttons::ButtonComponent.new(variant: :danger) do %>Danger<% end %>
      <%= render Neo::Buttons::ButtonComponent.new(variant: :edit) do %>Edit<% end %>
      <%= render Neo::Buttons::ButtonComponent.new(variant: :ghost) do %>Ghost<% end %>
    </div>
  </section>

  <!-- Sizes -->
  <section>
    <h2 class="text-lg font-semibold mb-4">Sizes</h2>
    <div class="flex items-end gap-4">
      <%= render Neo::Buttons::ButtonComponent.new(size: :small, variant: :primary) do %>Small<% end %>
      <%= render Neo::Buttons::ButtonComponent.new(size: :medium, variant: :primary) do %>Medium<% end %>
      <%= render Neo::Buttons::ButtonComponent.new(size: :large, variant: :primary) do %>Large<% end %>
    </div>
  </section>

  <!-- With Icons -->
  <section>
    <h2 class="text-lg font-semibold mb-4">With Icons</h2>
    <div class="flex flex-wrap gap-4">
      <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, icon: "plus-lg") do %>Add Item<% end %>
      <%= render Neo::Buttons::ButtonComponent.new(variant: :secondary, icon: "pencil") do %>Edit<% end %>
      <%= render Neo::Buttons::ButtonComponent.new(variant: :danger, icon: "trash") do %>Delete<% end %>
      <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, icon: "arrow-right", icon_position: :right) do %>Continue<% end %>
    </div>
  </section>

  <!-- States -->
  <section>
    <h2 class="text-lg font-semibold mb-4">States</h2>
    <div class="flex flex-wrap gap-4">
      <%= render Neo::Buttons::ButtonComponent.new(variant: :primary) do %>Normal<% end %>
      <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, loading: true) do %>Loading<% end %>
      <%= render Neo::Buttons::ButtonComponent.new(variant: :primary, disabled: true) do %>Disabled<% end %>
    </div>
  </section>

  <!-- Interactive Examples -->
  <section>
    <h2 class="text-lg font-semibold mb-4">Interactive Examples</h2>
    <div class="flex flex-wrap gap-4">
      <%= render Neo::Buttons::ButtonComponent.new(
        variant: :danger,
        icon: "trash",
        interactive: true,
        confirm: "Are you sure? This action cannot be undone."
      ) do %>
        Delete with Confirm
      <% end %>

      <%= render Neo::Buttons::ButtonComponent.new(
        variant: :primary,
        interactive: true,
        onclick: "alert('Button clicked!'); return false;"
      ) do %>
        Click Me
      <% end %>
    </div>
  </section>

  <!-- As Links -->
  <section>
    <h2 class="text-lg font-semibold mb-4">As Links</h2>
    <div class="flex flex-wrap gap-4">
      <%= render Neo::Buttons::ButtonComponent.new(tag: :a, href: "#", variant: :primary, icon: "arrow-left") do %>
        Back
      <% end %>
      <%= render Neo::Buttons::ButtonComponent.new(tag: :a, href: "#", variant: :secondary) do %>
        Cancel
      <% end %>
    </div>
  </section>
</div>

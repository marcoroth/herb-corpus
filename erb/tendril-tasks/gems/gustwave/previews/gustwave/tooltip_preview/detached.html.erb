<%# Look for a gray border on the two outer edges of the light tooltip's arrow, although the tooltip doesn't directly follow its trigger. %>
<% tooltip = Gustwave::Tooltip.new("Tooltip content", color: :light) %>

<div class="flex items-center justify-center gap-4 py-32">
  <%= render Gustwave::Buttons::Default.new("Show tooltip", **tooltip.trigger_options(placement: placement.to_sym)) %>

  <p class="text-sm text-gray-500">Another element sits between the trigger and its tooltip.</p>

  <%= render tooltip %>
</div>

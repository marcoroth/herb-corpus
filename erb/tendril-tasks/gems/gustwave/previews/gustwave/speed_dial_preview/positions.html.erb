<% %i[bottom_right bottom_left top_right top_left].each do |position| %>
  <%= render Gustwave::SpeedDial.new(position:) do |dial| %>
    <% dial.with_action "Share", icon: :share_nodes %>
    <% dial.with_action "Print", icon: :printer %>
    <% dial.with_action "Download", icon: :download %>
    <% dial.with_action "Copy", icon: :file_copy %>
  <% end %>
<% end %>

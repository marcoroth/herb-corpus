<%= render Gustwave::Timeline.new do |timeline| %>
  <% timeline.with_item do %>
    <%= time_tag Date.new(2022, 2, 1), "February 2022", class: "text-sm font-normal leading-none text-gray-400 dark:text-gray-500" %>
    <%= render Gustwave::Heading.new("Application UI code in Tailwind CSS", tag: :h3, size: :xs, class: "text-lg") %>
    <%= render Gustwave::Paragraph.new("Get access to over 20+ pages including a dashboard layout, charts, kanban board, calendar, and pre-order E-commerce & Marketing pages.", class: "mb-4") %>

    <%= render Gustwave::Buttons::Default.new("Learn more", tag: :a, href: "#", color: :alternative, size: :sm) do |button| %>
      <% button.with_trailing_visual_icon :arrow_right %>
    <% end %>
  <% end %>

  <% timeline.with_item do %>
    <%= time_tag Date.new(2022, 3, 1), "March 2022", class: "text-sm font-normal leading-none text-gray-400 dark:text-gray-500" %>
    <%= render Gustwave::Heading.new("Marketing UI design in Figma", tag: :h3, size: :xs, class: "text-lg") %>
    <%= render Gustwave::Paragraph.new("All of the pages and components are first designed in Figma and we keep a parity between the two versions even as we update the project.") %>
  <% end %>

  <% timeline.with_item do %>
    <%= time_tag Date.new(2022, 4, 1), "April 2022", class: "text-sm font-normal leading-none text-gray-400 dark:text-gray-500" %>
    <%= render Gustwave::Heading.new("E-Commerce UI code in Tailwind CSS", tag: :h3, size: :xs, class: "text-lg") %>
    <%= render Gustwave::Paragraph.new("Get started with dozens of web components and interactive elements built on top of Tailwind CSS.") %>
  <% end %>
<% end %>

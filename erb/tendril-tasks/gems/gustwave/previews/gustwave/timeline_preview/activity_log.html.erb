<%= render Gustwave::Timeline.new do |timeline| %>
  <% timeline.with_item do |item| %>
    <% item.with_marker_image "/icon.png", alt: "Bonnie Green" %>

    <%= render Gustwave::Card.new(class: "max-w-none shadow-xs dark:bg-gray-700 dark:border-gray-600") do |card| %>
      <% card.configure_body(class: "p-4 items-center justify-between sm:flex") %>
      <time class="block mb-1 text-xs font-normal text-gray-400 sm:order-last sm:mb-0">just now</time>

      <div class="text-sm font-normal text-gray-500 dark:text-gray-300">
        Bonnie moved <%= render Gustwave::Link.new("Jese Leos", href: "#", class: "font-semibold") %> to
        <%= render Gustwave::Badge.new("Funny Group", color: :dark) %>
      </div>
    <% end %>
  <% end %>

  <% timeline.with_item do |item| %>
    <% item.with_marker_image "/icon.png", alt: "Thomas Lean" %>

    <%= render Gustwave::Card.new(class: "max-w-none shadow-xs dark:bg-gray-700 dark:border-gray-600") do |card| %>
      <% card.configure_body(class: "p-4") %>

      <div class="items-center justify-between mb-3 sm:flex">
        <time class="block mb-1 text-xs font-normal text-gray-400 sm:order-last sm:mb-0">2 hours ago</time>

        <div class="text-sm font-normal text-gray-500 dark:text-gray-300">
          Thomas Lean commented on <%= render Gustwave::Link.new("Flowbite Pro", href: "#", class: "font-semibold") %>
        </div>
      </div>

      <div
        class="
          p-3 text-xs italic font-normal text-gray-500 border border-gray-200 rounded-lg bg-gray-50 dark:bg-gray-600
          dark:border-gray-500 dark:text-gray-300
        "
      >
        Hi ya'll! I wanted to share a webinar zeroheight is having regarding how to best measure your design system.
      </div>
    <% end %>
  <% end %>

  <% timeline.with_item do |item| %>
    <% item.with_marker_image "/icon.png", alt: "Jese Leos" %>

    <%= render Gustwave::Card.new(class: "max-w-none shadow-xs dark:bg-gray-700 dark:border-gray-600") do |card| %>
      <% card.configure_body(class: "p-4 items-center justify-between sm:flex") %>
      <time class="block mb-1 text-xs font-normal text-gray-400 sm:order-last sm:mb-0">1 day ago</time>

      <div class="text-sm font-normal text-gray-500 dark:text-gray-300">
        Jese Leos has changed <%= render Gustwave::Link.new("Pricing page", href: "#", class: "font-semibold") %> task
        status to <span class="font-semibold text-gray-900 dark:text-white">Finished</span>
      </div>
    <% end %>
  <% end %>
<% end %>

<% tooltip = Gustwave::Tooltip.new("Messages are end-to-end encrypted") %>

<%= render Gustwave::ButtonGroup.new do |group| %>
  <% group.with_button "Profile" %>
  <% group.with_button "Settings" %>
  <% group.with_button "Messages", **tooltip.trigger_options(placement: :top) %>

  <%= render tooltip %>
<% end %>

<%= render Gustwave::Dropdown.new do |dropdown| %>
  <% dropdown.with_trigger_generic do %>
    <%= render Gustwave::Badge.new("Open", color: :green, tag: :button) %>
  <% end %>

  <% dropdown.with_menu_list do |menu| %>
    <% menu.with_item_link "Open", href: "#" %>
    <% menu.with_item_link "Closed", href: "#" %>
  <% end %>
<% end %>

<%= render Gustwave::Dropdown.new("Projects") do |dropdown| %>
  <% dropdown.with_menu_list do |menu| %>
    <% menu.with_item_link "All projects", href: "#" %>

    <% menu.with_item_dropdown "Recent", placement: :right_start, trigger_event: :click do |submenu| %>
      <% submenu.with_menu_list do |items| %>
        <% items.with_item_link "Garden", href: "#" %>
        <% items.with_item_link "Library", href: "#" %>
        <% items.with_item_link "Archive", href: "#" %>
        <% items.with_item_link "Shared", href: "#" %>
      <% end %>
    <% end %>

    <% menu.with_item_link "Templates", href: "#" %>
    <% menu.with_item_link "Settings", href: "#" %>
  <% end %>
<% end %>

<%= render Gustwave::Dropdown.new("Projects") do |dropdown| %>
  <% dropdown.with_menu_list do |menu| %>
    <% menu.with_item_link "All projects", href: "#" %>

    <% menu.with_item_dropdown do |submenu| %>
      Recent
      <% submenu.with_menu_list do |items| %>
        <% items.with_item_link "Garden", href: "#" %>
        <% items.with_item_link "Library", href: "#" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<div class="flex flex-wrap items-center justify-center gap-4 py-32">
  <% placements.each do |placement| %>
    <%= render Gustwave::Dropdown.new(placement.to_s.humanize, placement:) do |dropdown| %>
      <% dropdown.with_menu_list do |menu| %>
        <% menu.with_item_link "First", href: "#" %>
        <% menu.with_item_link "Second", href: "#" %>
      <% end %>
    <% end %>
  <% end %>
</div>

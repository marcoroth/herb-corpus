<%= render Gustwave::Banner.new(floating: true, align: :start) do |banner| %>
  <% banner.with_dismiss_button %>

  <div class="flex flex-col items-start gap-3 md:flex-row md:items-center md:justify-between">
    <div class="flex flex-col items-start md:flex-row md:items-center">
      <%= render Gustwave::Link.new("Flowbite", href: "#", color: :none, class: "mb-2 text-lg font-semibold whitespace-nowrap text-gray-900 border-gray-200 md:mb-0 md:pe-4 md:me-4 md:border-e dark:text-white dark:border-gray-600") %>
      <span>Build websites even faster with components on top of Tailwind CSS</span>
    </div>

    <%= render Gustwave::Buttons::Default.new("Get started", tag: :a, href: "#", size: :xs, class: "shrink-0") %>
  </div>
<% end %>

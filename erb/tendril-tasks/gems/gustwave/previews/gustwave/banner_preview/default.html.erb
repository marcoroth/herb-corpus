<%= render Gustwave::Banner.new(position:) do |banner| %>
  <% banner.with_dismiss_button %>

  <span class="flex items-center justify-center">
    <span class="inline-flex items-center justify-center w-6 h-6 me-3 bg-gray-200 rounded-full shrink-0 dark:bg-gray-600">
      <%= render Gustwave::Icon.new(:bullhorn, theme: :solid, class: "w-6 h-6") %>
    </span>

    <span>
      New brand identity has been launched for the
      <%= render Gustwave::Link.new("Flowbite Library", href: "#", underline: :always, class: "font-medium") %>
    </span>
  </span>
<% end %>

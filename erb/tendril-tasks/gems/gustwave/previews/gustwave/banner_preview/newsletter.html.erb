<%= render Gustwave::Banner.new do |banner| %>
  <% banner.with_dismiss_button %>

  <form action="#" class="flex flex-col items-center md:flex-row md:justify-center">
    <label
      for="banner-newsletter-email"
      class="shrink-0 mb-2 text-sm font-medium text-gray-500 md:mb-0 md:me-4 dark:text-gray-400"
    >
      Sign up for our newsletter
    </label>

    <input
      type="email"
      id="banner-newsletter-email"
      placeholder="Enter your email"
      required
      autocomplete="email"
      class="
        block w-full p-2 mb-2 text-sm text-gray-900 bg-white border border-gray-300 rounded-lg md:w-64 md:mb-0
        md:me-4 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600
        dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500
      "
    >

    <%= render Gustwave::Buttons::Default.new("Subscribe", type: :submit, size: :xs, class: "w-full md:w-auto") %>
  </form>
<% end %>

<div class="mx-auto max-w-2xl p-8">
  <%= render Gustwave::Tabs.new(
    style: :underline,
    active_class: "text-purple-600 hover:text-purple-600 dark:text-purple-500 dark:hover:text-purple-500 border-purple-600 dark:border-purple-500",
    inactive_class: "dark:border-transparent text-gray-500 hover:text-gray-600 dark:text-gray-400 border-gray-100 hover:border-gray-300 dark:border-gray-700 dark:hover:text-gray-300"
  ) do |tabs| %>
    <% tabs.with_tab_button("Profile", selected: true) do |tab| %>
      <% tab.with_panel do %>
        <p class="text-sm text-gray-500 dark:text-gray-400">This is the Profile tab's associated content.</p>
      <% end %>
    <% end %>

    <% tabs.with_tab_button("Dashboard") do |tab| %>
      <% tab.with_panel do %>
        <p class="text-sm text-gray-500 dark:text-gray-400">This is the Dashboard tab's associated content.</p>
      <% end %>
    <% end %>

    <% tabs.with_tab_button("Settings") do |tab| %>
      <% tab.with_panel do %>
        <p class="text-sm text-gray-500 dark:text-gray-400">This is the Settings tab's associated content.</p>
      <% end %>
    <% end %>

    <% tabs.with_tab_button("Contacts") do |tab| %>
      <% tab.with_panel do %>
        <p class="text-sm text-gray-500 dark:text-gray-400">This is the Contacts tab's associated content.</p>
      <% end %>
    <% end %>
  <% end %>
</div>

<div class="mx-auto max-w-2xl p-8">
  <%= render Gustwave::Tabs.new(style: :underline, aria: { label: "Account" }) do |tabs| %>
    <% tabs.with_tab_link("Profile", href: "#", selected: true) do |tab| %>
      <% tab.with_leading_visual_icon :user_circle, theme: :solid %>
    <% end %>

    <% tabs.with_tab_link("Dashboard", href: "#") do |tab| %>
      <% tab.with_leading_visual_icon :chart_pie, theme: :solid %>
    <% end %>

    <% tabs.with_tab_link("Settings", href: "#") do |tab| %>
      <% tab.with_leading_visual_icon :cog, theme: :solid %>
    <% end %>

    <% tabs.with_tab_link("Contacts", href: "#") do |tab| %>
      <% tab.with_leading_visual_icon :address_book, theme: :solid %>
    <% end %>

    <% tabs.with_tab_link("Disabled", disabled: true) do |tab| %>
      <% tab.with_leading_visual_icon :envelope, theme: :solid %>
    <% end %>
  <% end %>
</div>

<% colors.each do |color, name| %>
  <% id = "alert-additional-content-#{color}" %>

  <%= render Gustwave::Alert.new(id:, color:, border: true, class: "mb-4") do %>
    <div class="flex items-center">
      <%= render Gustwave::Icon.new(:info_circle, theme: :solid, size: :sm, class: "shrink-0 w-4 h-4 me-2") %>
      <span class="sr-only"><%= name %></span>

      <h3 class="text-lg font-medium">Your plan renews next week</h3>
    </div>

    <div class="mt-2 mb-4 text-sm">
      We will charge the card on file on Monday. You can review the invoice now or change your plan before then.
    </div>

    <div class="flex">
      <%= render Gustwave::Button.for(:default).new("View invoice", color: :none, size: :none, class: primary_button.fetch(color)) do |button| %>
        <% button.with_leading_visual_icon(:eye, theme: :solid, class: "h-4 w-4 -ms-0.5") %>
      <% end %>

      <%= render Gustwave::DismissButton.new(id, theme: :default, icon: nil, color: :none, size: :none, class: secondary_button.fetch(color)) do %>
        Dismiss
      <% end %>
    </div>
  <% end %>
<% end %>

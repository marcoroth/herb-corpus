<% colors.each do |color, name| %>
  <%= render Gustwave::Alert.new(color:, class: "mb-4") do |alert| %>
    <% alert.with_icon(label: name) %> <% alert.with_dismiss_button %> A simple <%= name.downcase %> alert with an
    <a href="#example" class="font-semibold underline hover:no-underline">example link</a>. Give it a click if you like.
  <% end %>
<% end %>

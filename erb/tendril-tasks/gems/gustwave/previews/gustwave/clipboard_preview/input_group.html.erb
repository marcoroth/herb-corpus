<%
  clipboard = Gustwave::Clipboard.new(
    target_id: "website-url",
    theme: :default,
    class: "rounded-s-none rounded-e-lg py-3 px-4 border border-blue-700 dark:border-blue-600 hover:border-blue-800 dark:hover:border-blue-700"
  )
  clipboard.with_icon(:clipboard, class: "w-5 h-5 -my-0.5")
  clipboard.with_copied_icon(:check, class: "w-5 h-5 -my-0.5")
  clipboard.with_tooltip("Copy link")
%>

<div class="flex justify-center">
  <div class="w-full max-w-sm">
    <div class="mb-2 flex justify-between items-center">
      <label for="website-url" class="text-sm font-medium text-gray-900 dark:text-white">Verify your website:</label>
    </div>

    <%= render Gustwave::Form::InputGroup.new do |group| %>
      <% group.with_leading_addon_text("URL", class: "z-10 px-4 font-medium text-center bg-gray-100 rounded-s-lg") %>

      <% group.with_control_input(
           id: "website-url",
           value: "https://acme.com",
           disabled: true,
           readonly: true,
           aria: { describedby: "helper-text-explanation" },
           class: "text-gray-500 dark:text-gray-400 border-e-0"
         ) %>

      <% group.with_trailing_addon_renderable(clipboard) %>
    <% end %>

    <%= render Gustwave::Paragraph.new("Security certificate is required for approval", id: "helper-text-explanation", class: "mt-2 text-sm") %>
  </div>
</div>

<%
  clipboard = Gustwave::Clipboard.new(
    target_id: "url-shortener",
    theme: :default,
    color: :none,
    class: "rounded-s-none rounded-e-lg py-3 px-4 text-sm font-medium text-center text-gray-500 dark:text-gray-400 hover:text-gray-900 bg-gray-100 border border-gray-300 hover:bg-gray-200 focus:ring-4 focus:outline-none focus:ring-gray-100 dark:bg-gray-700 dark:hover:bg-gray-600 dark:focus:ring-gray-700 dark:hover:text-white dark:border-gray-600"
  )
  clipboard.with_icon(:clipboard, class: "w-5 h-5 -my-0.5")
  clipboard.with_copied_icon(:check, class: "w-5 h-5 -my-0.5")
  clipboard.with_tooltip("Copy link")
%>

<div class="flex justify-center">
  <div class="w-full max-w-sm">
    <div class="mb-2 flex justify-between items-center">
      <label for="url-shortener" class="text-sm font-medium text-gray-900 dark:text-white">Shorten URL:</label>
    </div>

    <%= render Gustwave::Form::InputGroup.new do |group| %>
      <% group.with_leading_addon_generic do %>
        <%= render Gustwave::Buttons::Default.new("Generate", class: "shrink-0 z-10 inline-flex items-center px-4 py-2.5 rounded-s-lg rounded-e-none border border-blue-700 dark:border-blue-600 hover:border-blue-700 dark:hover:border-blue-700") %>
      <% end %>

      <% group.with_control_input(
           id: "url-shortener",
           value: "https://bit.ly/3U2SXcF",
           disabled: true,
           readonly: true,
           aria: { describedby: "helper-text-explanation" },
           class: "text-gray-500 dark:text-gray-400 border-e-0 border-s-0"
         ) %>

      <% group.with_trailing_addon_renderable(clipboard) %>
    <% end %>

    <%= render Gustwave::Paragraph.new("Make sure that your URL is valid", id: "helper-text-explanation", class: "mt-2 text-sm") %>
  </div>
</div>

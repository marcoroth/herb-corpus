<div>
  <%= render Gustwave::Buttons::Default.new(size: :none, class: "p-2.5 text-sm font-medium me-2") do |button| %>
    <% button.with_leading_visual_icon :arrow_right, class: "h-[30px] w-[30px] -m-[5px]" %>
    <span class="sr-only">Icon description</span>
  <% end %>

  <%= render Gustwave::Buttons::Default.new(pill: true, size: :none, class: "p-2.5 text-sm font-medium me-2") do |button| %>
    <% button.with_leading_visual_icon :arrow_right, class: "h-6 w-6 -m-1" %>
    <span class="sr-only">Icon description</span>
  <% end %>

  <%= render Gustwave::Buttons::DefaultOutline.new(size: :none, class: "p-2.5 text-sm font-medium me-2") do |button| %>
    <% button.with_leading_visual_icon :thumbs_up, theme: :solid, class: "h-6 w-6 -m-0.5" %>
    <span class="sr-only">Icon description</span>
  <% end %>

  <%= render Gustwave::Buttons::DefaultOutline.new(pill: true, size: :none, class: "p-2.5 text-sm font-medium") do |button| %>
    <% button.with_leading_visual_icon :thumbs_up, theme: :solid, class: "h-5 w-5 -m-0.5" %>
    <span class="sr-only">Icon description</span>
  <% end %>
</div>

<div class="flex flex-wrap items-center gap-2">
  <%= render Gustwave::Buttons::Default.new("Add") do |button| %>
    <% button.with_leading_visual_icon :plus %>
  <% end %>

  <%= render Gustwave::Buttons::Default.new("Next") do |button| %>
    <% button.with_trailing_visual_icon :arrow_right %>
  <% end %>

  <%= render Gustwave::Buttons::Default.new(color: :red, aria: { label: "Delete" }) do |button| %>
    <% button.with_leading_visual_icon :trash_bin %>
  <% end %>
</div>

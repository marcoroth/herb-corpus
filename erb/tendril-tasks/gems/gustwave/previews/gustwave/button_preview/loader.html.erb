<div>
  <%= render Gustwave::Buttons::Default.new("Loading...", disabled: true, class: "me-2 disabled:bg-blue-700 disabled:hover:bg-blue-800 dark:disabled:bg-blue-600 dark:disabled:hover:bg-blue-700") do |button| %>
    <% button.with_leading_visual_icon :spinner, class: "h-4 w-4 me-1.5 text-gray-200 fill-white animate-spin" %>
  <% end %>

  <%= render Gustwave::Buttons::Default.new("Loading...", disabled: true, color: :alternative, class: "me-2") do |button| %>
    <% button.with_leading_visual_icon :spinner, class: "h-4 w-4 me-1.5 text-gray-200 fill-[#1C64F2] animate-spin dark:text-gray-600" %>
  <% end %>
</div>

<div class="flex flex-wrap items-center gap-2">
  <%= render Gustwave::Buttons::Default.new("XS", size: :xs) do |button| %>
    <% button.with_leading_visual_icon :envelope, theme: :solid, class: "h-3.5 w-3.5 -ms-px me-px" %>
  <% end %>

  <%= render Gustwave::Buttons::Default.new("SM", size: :sm) do |button| %>
    <% button.with_leading_visual_icon :envelope, theme: :solid, class: "h-3.5 w-3.5 -ms-px me-px" %>
  <% end %>

  <%= render Gustwave::Buttons::Default.new("MD", size: :md) do |button| %>
    <% button.with_leading_visual_icon :envelope, theme: :solid, class: "h-4 w-4" %>
  <% end %>

  <%= render Gustwave::Buttons::Default.new("LG", size: :lg) do |button| %>
    <% button.with_leading_visual_icon :envelope, theme: :solid, class: "h-[18px] w-[18px]" %>
  <% end %>

  <%= render Gustwave::Buttons::Default.new("XL", size: :xl) do |button| %>
    <% button.with_leading_visual_icon :envelope, theme: :solid, class: "h-[18px] w-[18px]" %>
  <% end %>
</div>

<div class="flex flex-wrap">
  <% buttons.each do |button_data| %>
    <%= render Gustwave::Buttons::Default.new(button_data[:text], color: :none, class: "focus:ring-4 focus:outline-none rounded-lg text-center me-2 mb-2 #{button_data[:colors]}") do |button| %>
      <% button.with_leading_visual_icon button_data[:icon], theme: :solid, class: button_data[:icon_class] %>
    <% end %>
  <% end %>
</div>

<% popover = Gustwave::Popover.new(class: "w-64") %>

<div class="flex justify-center py-32">
  <%= render Gustwave::Buttons::Default.new("Show popover", **popover.trigger_options(placement: placement.to_sym, trigger: trigger.to_sym)) %>

  <%= render popover do %>
    <div class="px-3 py-2">
      <p>Popovers show extra content next to their trigger.</p>
    </div>
  <% end %>
</div>

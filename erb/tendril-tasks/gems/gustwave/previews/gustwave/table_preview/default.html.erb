<%= render Gustwave::Table.new do |table| %>
  <% table.with_caption do |caption| %>
    <% caption.with_title "Supplies" %>
    <% caption.with_description "What we have in stock and where to find it." %>
  <% end %>

  <% table.with_head do |head| %>
    <% head.with_column "Item" %>
    <% head.with_column "Amount" %>
    <% head.with_column "Location" %>
  <% end %>

  <% table.with_body do |body| %>
    <% rows.each do |item, amount, location| %>
      <% body.with_row do |row| %>
        <% row.with_cell_th item %>
        <% row.with_cell_td amount %>
        <% row.with_cell_td location %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

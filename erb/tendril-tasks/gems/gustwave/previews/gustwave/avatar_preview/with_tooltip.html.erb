<% jane = Gustwave::Tooltip.new("Jane Cooper") %>
<% ada = Gustwave::Tooltip.new("Ada Lovelace") %>
<% alex = Gustwave::Tooltip.new("Alex Morgan") %>

<div class="w-fit">
  <%= render jane %>
  <%= render Gustwave::Avatar.new(src: "/icon.png", shape: :square, **jane.trigger_options) %>
</div>

<div class="w-fit">
  <%= render ada %>
  <%= render Gustwave::Avatar.new(src: "/icon.png", shape: :square, **ada.trigger_options) %>
</div>

<div class="w-fit">
  <%= render alex %>
  <%= render Gustwave::Avatar.new(src: "/icon.png", shape: :square, **alex.trigger_options) %>
</div>

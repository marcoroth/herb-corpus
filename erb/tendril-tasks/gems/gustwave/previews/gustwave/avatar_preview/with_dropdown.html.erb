<%= render Gustwave::Dropdown.new(placement: :bottom_start) do |dropdown| %>
  <%= dropdown.with_trigger_generic do %>
    <%= render Gustwave::Avatar.new(src: "/icon.png", alt: "User dropdown") %>
  <% end %>

  <% dropdown.with_menu_list class: "dark:divide-gray-600" do |menu| %>
    <% menu.with_header class: "py-3" do %>
      <div>Ada Lovelace</div>
      <div class="font-medium truncate">ada@example.com</div>
    <% end %>

    <% menu.with_item_link "Dashboard", href: "#" %>
    <% menu.with_item_link "Settings", href: "#" %>
    <% menu.with_item_link "Earnings", href: "#" %>

    <% menu.with_footer class: "px-0 py-1" do %>
      <a
        href="#example"
        class="
          block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 dark:text-gray-200
          dark:hover:text-white
        "
      >
        Sign out
      </a>
    <% end %>
  <% end %>
<% end %>

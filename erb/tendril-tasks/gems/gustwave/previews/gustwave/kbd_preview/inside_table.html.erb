<%= render Gustwave::Table.new do |table| %>
  <% table.with_head do |head| %>
    <% head.with_column "Key" %>
    <% head.with_column "Description" %>
  <% end %>

  <% table.with_body do |body| %>
    <% body.with_row do |row| %>
      <% row.with_cell_th do %>
        <%= render Gustwave::Kbd.new("Shift") %>
      <% end %>

      <% row.with_cell_td "Selects a range" %>
    <% end %>

    <% body.with_row do |row| %>
      <% row.with_cell_th do %>
        <%= render Gustwave::Kbd.new("Ctrl") %>
      <% end %>

      <% row.with_cell_td "Opens the context menu" %>
    <% end %>

    <% body.with_row do |row| %>
      <% row.with_cell_th do %>
        <%= render Gustwave::Kbd.new("Esc") %>
      <% end %>

      <% row.with_cell_td "Closes the dialog" %>
    <% end %>
  <% end %>
<% end %>

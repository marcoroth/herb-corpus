<% popover = Gustwave::Popover.new(class: "w-64") %>

<div class="pt-48">
  <%= render Gustwave::Paragraph.new do %>
    Track work across the enterprise through an open, collaborative platform. Plan your next trip to
    <%= tag.button "Italy", type: "button", class: "font-medium text-blue-600 underline dark:text-blue-500 hover:no-underline", **popover.trigger_options %>
    and deliver great service experiences fast.
  <% end %>

  <%= render popover do %>
    <div class="p-3 space-y-2">
      <%= render Gustwave::Heading.new("Italy", tag: :h3, size: :xs) %>
      <%= render Gustwave::Paragraph.new("Italy is a country in southern Europe, known for its art, food and history.") %>
    </div>
  <% end %>
</div>

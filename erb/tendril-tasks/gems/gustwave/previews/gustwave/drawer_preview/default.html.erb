<% drawer = Gustwave::Drawer.new(placement: placement.to_sym, backdrop:, body_scrolling:) %>

<div class="flex justify-center py-32">
  <%= render Gustwave::Buttons::Default.new("Show drawer", **drawer.trigger_options) %>
</div>

<% 30.times do |i| %>
  <p class="mb-4">
    Filler paragraph <%= i + 1 %>. Scroll the page while the drawer is open to see whether body scrolling is locked.
  </p>
<% end %>

<%= render drawer do |d| %>
  <% d.with_header("Info", icon: :info_circle) %>

  <p class="mb-6 text-sm text-gray-500 dark:text-gray-400">
    Drawers slide in from an edge of the screen and hold secondary content, such as navigation, settings or details.
  </p>
<% end %>

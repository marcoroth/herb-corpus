<% drawer = Gustwave::Drawer.new(placement: :right) %>

<div class="flex justify-center gap-4 py-32">
  <%= render Gustwave::Buttons::Default.new("Toggle drawer", **drawer.trigger_options) %>
  <%= render Gustwave::Buttons::Default.new("Show drawer", **drawer.trigger_options(action: :show)) %>
  <%= render Gustwave::Buttons::Default.new("Hide drawer", **drawer.trigger_options(action: :hide)) %>
</div>

<%= render drawer do |d| %>
  <% d.with_header("Multiple triggers") %>

  <p class="mb-6 text-sm text-gray-500 dark:text-gray-400">
    This drawer is opened and closed by separate toggle, show and hide buttons.
  </p>
<% end %>

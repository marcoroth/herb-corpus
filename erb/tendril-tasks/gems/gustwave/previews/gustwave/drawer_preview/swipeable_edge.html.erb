<% drawer = Gustwave::Drawer.new(placement: :bottom, edge: true) %>

<%= render drawer do |d| %>
  <% d.with_header("Swipe to see more", icon: :info_circle) %>

  <div class="p-4">
    <div class="grid grid-cols-3 gap-4">
      <% 6.times do |i| %>
        <div
          class="
            flex h-20 items-center justify-center rounded-lg bg-gray-100 text-sm text-gray-700 dark:bg-gray-700
            dark:text-gray-200
          "
        >
          Item <%= i + 1 %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<div class="flex flex-wrap items-center gap-8 p-4">
  <%= render Gustwave::Buttons::Default.new(class: "relative overflow-visible") do |button| %>
    <% button.with_leading_visual_icon :inbox %> Inbox
    <%= render Gustwave::Indicator.new("8", color: :red, size: :md, position: :top_right) %>
  <% end %>

  <div class="relative h-16 w-16 rounded-lg bg-gray-200 dark:bg-gray-700">
    <%= render Gustwave::Indicator.new(color: :green, size: :md, position: :bottom_right) %>
  </div>
</div>

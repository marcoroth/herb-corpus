<%= render Gustwave::Navbar.new do |navbar| %>
  <% navbar.with_brand(href: "#") do %>
    <%= render Gustwave::Icon.new(:rocket, theme: :solid, position: :standalone, class: "size-8 text-blue-700 dark:text-blue-500") %>
    <span class="self-center text-2xl font-semibold whitespace-nowrap dark:text-white">Flowbite</span>
  <% end %>

  <% navbar.with_item_link "Home", href: "#", active: true, class: "md:text-sm" %>

  <% navbar.with_item_generic do %>
    <%= render Gustwave::Dropdown.new("Services", inline: true, class: "flex justify-between w-full md:w-auto py-2 px-3 md:p-0 rounded-sm text-gray-700 md:text-sm hover:bg-gray-100 md:hover:bg-transparent md:hover:text-blue-700 dark:text-gray-400 dark:hover:text-white dark:focus:text-white dark:hover:bg-gray-700 md:dark:hover:bg-transparent") do |dropdown| %>
      <% dropdown.with_menu_list class: "font-normal dark:divide-gray-600" do |menu| %>
        <% menu.with_item_link "Design", href: "#" %>
        <% menu.with_item_link "Development", href: "#" %>
        <% menu.with_item_link "Consulting", href: "#" %>

        <% menu.with_footer class: "px-0 py-1" do %>
          <a
            href="#example"
            class="
              block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 dark:text-gray-200
              dark:hover:text-white
            "
          >
            Support
          </a>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% navbar.with_item_link "Portfolio", href: "#", class: "md:text-sm" %>
  <% navbar.with_item_link "Pricing", href: "#", class: "md:text-sm" %>
  <% navbar.with_item_link "Contact", href: "#", class: "md:text-sm" %>
<% end %>

<%= render Gustwave::Navbar.new do |navbar| %>
  <% navbar.with_brand(href: "#") do %>
    <%= render Gustwave::Icon.new(:rocket, theme: :solid, position: :standalone, class: "size-8 text-blue-700 dark:text-blue-500") %>
    <span class="self-center text-2xl font-semibold whitespace-nowrap dark:text-white">Flowbite</span>
  <% end %>

  <% navbar.with_item_link "Home", href: "#", active: true %>

  <% navbar.with_item_generic do %>
    <%= render Gustwave::Dropdown.new("Services", inline: true, class: "flex justify-between w-full md:w-auto py-2 px-3 md:p-0 rounded-sm text-gray-900 hover:bg-gray-100 md:hover:bg-transparent md:hover:text-blue-700 dark:text-white dark:hover:bg-gray-700 dark:hover:text-white md:dark:hover:bg-transparent md:dark:hover:text-blue-500") do |dropdown| %>
      <% dropdown.with_menu_list do |menu| %>
        <% menu.with_item_link "Design", href: "#" %>
        <% menu.with_item_link "Development", href: "#" %>
        <% menu.with_item_link "Consulting", href: "#" %>
      <% end %>
    <% end %>
  <% end %>

  <% navbar.with_item_link "Contact", href: "#" %>
<% end %>

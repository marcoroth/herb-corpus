<div class="p-6 space-y-12">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
    <%= render Gustwave::DeviceMockup.new(device: :phone, color: :dark) do %>
      <div
        class="
          size-full flex flex-col items-center justify-center gap-2 p-4 text-center bg-linear-to-br from-blue-100
          to-purple-200 dark:from-blue-900 dark:to-purple-900
        "
      >
        <%= render Gustwave::Heading.new("Tendril Tasks", tag: :h3) %>
        <%= render Gustwave::Paragraph.new("Your content goes here.") %>
      </div>
    <% end %>

    <%= render Gustwave::DeviceMockup.new(device: :phone, color: :light) do %>
      <div
        class="
          size-full flex flex-col items-center justify-center gap-2 p-4 text-center bg-linear-to-br from-blue-100
          to-purple-200 dark:from-blue-900 dark:to-purple-900
        "
      >
        <%= render Gustwave::Heading.new("Tendril Tasks", tag: :h3) %>
        <%= render Gustwave::Paragraph.new("Your content goes here.") %>
      </div>
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
    <%= render Gustwave::DeviceMockup.new(device: :laptop, color: :dark) do %>
      <div
        class="
          size-full flex flex-col items-center justify-center gap-2 p-4 text-center bg-linear-to-br from-blue-100
          to-purple-200 dark:from-blue-900 dark:to-purple-900
        "
      >
        <%= render Gustwave::Heading.new("Tendril Tasks", tag: :h3) %>
      </div>
    <% end %>

    <%= render Gustwave::DeviceMockup.new(device: :laptop, color: :light) do %>
      <div
        class="
          size-full flex flex-col items-center justify-center gap-2 p-4 text-center bg-linear-to-br from-blue-100
          to-purple-200 dark:from-blue-900 dark:to-purple-900
        "
      >
        <%= render Gustwave::Heading.new("Tendril Tasks", tag: :h3) %>
      </div>
    <% end %>
  </div>
</div>

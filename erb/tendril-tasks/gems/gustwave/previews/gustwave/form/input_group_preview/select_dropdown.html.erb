<%
  us_flag = tag.svg("aria-hidden": true, class: "h-3 me-2", viewBox: "0 0 15 12") do
    safe_join([
      tag.rect(x: 0.5, width: 14, height: 12, rx: 2, fill: "#fff"),
      tag.path(d: "M0.5 0.4H14.5M0.5 2H14.5M0.5 3.6H14.5M0.5 5.2H14.5M0.5 6.8H14.5M0.5 8.4H14.5M0.5 10H14.5M0.5 11.6H14.5", stroke: "#D02F44", "stroke-width": 0.8),
      tag.rect(x: 0.5, width: 6, height: 5.6, fill: "#46467F")
    ])
  end
  flag = lambda do |colors, round|
    tag.svg("aria-hidden": true, class: "h-3.5 w-3.5 me-2 #{'rounded-full' if round}", viewBox: "0 0 512 512") do
      safe_join(colors.each_with_index.map { |color, i| tag.path(d: "M0 #{i * 512 / colors.size}h512v#{512 / colors.size + 1}H0z", fill: color) })
    end
  end
  countries = [
    [ "United States", flag.call(%w[#bd3d44 #fff #192f5d], true) ],
    [ "Germany", flag.call(%w[#000 #d00 #ffce00], true) ],
    [ "France", flag.call(%w[#0055a4 #fff #ef4135], true) ],
    [ "Italy", flag.call(%w[#009246 #fff #ce2b37], true) ]
  ]
%>

<form class="max-w-sm mx-auto pb-48">
  <%= render Gustwave::Form::Field.new do |field| %>
    <% field.with_label("Choose a state", for: "states", class: "sr-only") %>

    <% field.with_control_input_group do |group| %>
      <% group.with_leading_addon_dropdown(tag.span(safe_join([ us_flag, "USA" ]), class: "inline-flex items-center"), menu_id: "dropdown-states", class: "text-gray-500 border-e") do |dropdown| %>
        <% dropdown.with_menu_list do |menu| %>
          <% countries.each do |name, icon| %>
            <% menu.with_item_link(tag: :button, href: nil, class: "inline-flex w-full") { safe_join([ icon, name ]) } %>
          <% end %>
        <% end %>
      <% end %>

      <% group.with_control_select(
           id: "states",
           choices: [ "California", "Texas", "Washington", "Florida", "Virginia" ],
           prompt: "Choose a state",
           class: "border-s-2 border-s-gray-100 dark:border-s-gray-700"
         ) %>
    <% end %>
  <% end %>
</form>

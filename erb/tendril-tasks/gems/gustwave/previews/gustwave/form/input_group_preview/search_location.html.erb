<%
  us_flag = tag.svg("aria-hidden": true, class: "h-3 me-2", viewBox: "0 0 15 12") do
    safe_join([
      tag.rect(x: 0.5, width: 14, height: 12, rx: 2, fill: "#fff"),
      tag.path(d: "M0.5 0.4H14.5M0.5 2H14.5M0.5 3.6H14.5M0.5 5.2H14.5M0.5 6.8H14.5M0.5 8.4H14.5M0.5 10H14.5M0.5 11.6H14.5", stroke: "#D02F44", "stroke-width": 0.8),
      tag.rect(x: 0.5, width: 6, height: 5.6, fill: "#46467F")
    ])
  end
  flag = lambda do |colors|
    tag.svg("aria-hidden": true, class: "h-3.5 w-3.5 rounded-full me-2", viewBox: "0 0 512 512") do
      safe_join(colors.each_with_index.map { |color, i| tag.path(d: "M0 #{i * 512 / colors.size}h512v#{512 / colors.size + 1}H0z", fill: color) })
    end
  end
  china_flag = tag.svg("aria-hidden": true, class: "h-3.5 w-3.5 rounded-full me-2", viewBox: "0 0 512 512") do
    safe_join([
      tag.defs(tag.path(id: "china-star", fill: "#ffde00", d: "M1-.3L-.7.8 0-1 .6.8-1-.3z")),
      tag.path(fill: "#de2910", d: "M0 0h512v512H0z"),
      tag.use(width: 30, height: 20, transform: "matrix(76.8 0 0 76.8 128 128)", "xlink:href": "#china-star"),
      tag.use(width: 30, height: 20, transform: "rotate(-121 142.6 -47) scale(25.5827)", "xlink:href": "#china-star"),
      tag.use(width: 30, height: 20, transform: "rotate(-98.1 198 -82) scale(25.6)", "xlink:href": "#china-star"),
      tag.use(width: 30, height: 20, transform: "rotate(-74 272.4 -114) scale(25.6137)", "xlink:href": "#china-star"),
      tag.use(width: 30, height: 20, transform: "matrix(16 -19.968 19.968 16 256 230.4)", "xlink:href": "#china-star")
    ])
  end
  countries = [
    [ "United States", flag.call(%w[#bd3d44 #fff #192f5d]) ],
    [ "Germany", flag.call(%w[#000 #d00 #ffce00]) ],
    [ "Italy", flag.call(%w[#009246 #fff #ce2b37]) ],
    [ "China", china_flag ]
  ]
%>

<form class="max-w-md mx-auto pb-48">
  <%= render Gustwave::Form::Field.new do |field| %>
    <% field.with_label("Search", for: "location-search", class: "sr-only") %>

    <% field.with_control_input_group do |group| %>
      <% group.with_leading_addon_dropdown(tag.span(safe_join([ us_flag, "USA" ]), class: "inline-flex items-center"), menu_id: "dropdown-locations", class: "text-gray-500 border-e") do |dropdown| %>
        <% dropdown.with_menu_list do |menu| %>
          <% countries.each do |name, icon| %>
            <% menu.with_item_link(tag: :button, href: nil, role: "menuitem", class: "inline-flex w-full") do %>
              <%= tag.div(safe_join([ icon, name ]), class: "inline-flex items-center") %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% group.with_control_input(
           type: :search,
           id: "location-search",
           placeholder: "Search for city or address",
           required: true,
           class: "border-s-2 border-s-gray-50 dark:border-s-gray-700"
         ) %>

      <% search_button = group.with_trailing_addon_button(
           type: :submit,
           aria: { label: "Search" }
         ) %>

      <% search_button.with_trailing_visual_icon :search, theme: :outline, class: "w-4 h-4" %>
    <% end %>
  <% end %>
</form>

<%
  addon = lambda do |group, side, type|
    case type
    when :text then group.public_send("with_#{side}_addon_text", "@")
    when :button then group.public_send("with_#{side}_addon_button", "Copy", type: :button, theme: :input_addon)
    when :dropdown
      group.public_send("with_#{side}_addon_dropdown", "Acme", menu_id: "playground-#{side}-menu") do |dropdown|
        dropdown.with_menu_list do |menu|
          menu.with_item_link "Projects", href: "#"
          menu.with_item_link "Tasks", href: "#"
        end
      end
    end
  end
%>

<form class="max-w-sm mx-auto">
  <%= render Gustwave::Form::Field.new(label: "Playground", helper_text: "Change the options in the params panel.") do |field| %>
    <% field.with_control_input_group(size: size) do |group| %>
      <% addon.call(group, :leading, leading) %>

      <% if control == :select %>
        <% group.with_control_select(id: "playground-control", choices: [ "Projects", "Tasks", "Notes" ], prompt: "Choose one") %>
      <% else %>
        <% group.with_control_input(id: "playground-control", placeholder: "Acme", icon: (:envelope if icon)) %>
      <% end %>

      <% addon.call(group, :trailing, trailing) %>
    <% end %>
  <% end %>
</form>

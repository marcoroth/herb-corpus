<form class="max-w-lg mx-auto pb-48">
  <%= render Gustwave::Form::Field.new do |field| %>
    <% field.with_label("Search", for: "search-dropdown", class: "sr-only") %>

    <% field.with_control_input_group do |group| %>
      <% group.with_leading_addon_dropdown("All categories", menu_id: "dropdown-categories", class: "border-e") do |dropdown| %>
        <% dropdown.with_menu_list do |menu| %>
          <% menu.with_item_link("Mockups", tag: :button, href: nil, class: "inline-flex w-full") %>
          <% menu.with_item_link("Templates", tag: :button, href: nil, class: "inline-flex w-full") %>
          <% menu.with_item_link("Design", tag: :button, href: nil, class: "inline-flex w-full") %>
          <% menu.with_item_link("Logos", tag: :button, href: nil, class: "inline-flex w-full") %>
        <% end %>
      <% end %>

      <% group.with_control_input(
           type: :search,
           id: "search-dropdown",
           placeholder: "Search Mockups, Logos, Design Templates...",
           required: true,
           class: "border-s-2 border-s-gray-50 dark:border-s-gray-700"
         ) %>

      <% search_button = group.with_trailing_addon_button(
           type: :submit,
           aria: { label: "Search" }
         ) %>

      <% search_button.with_trailing_visual_icon :search, theme: :outline, class: "w-4 h-4" %>
    <% end %>
  <% end %>
</form>

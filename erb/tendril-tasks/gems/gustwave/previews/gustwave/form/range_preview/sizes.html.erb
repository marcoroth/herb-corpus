<%= render Gustwave::Form::Field.new(label: "Small") do |field| %>
  <% field.with_control_range(id: "small-range", value: 50, size: :sm, class: "mb-6") %>
<% end %>

<%= render Gustwave::Form::Field.new(label: "Default") do |field| %>
  <% field.with_control_range(id: "medium-range", value: 50, size: :md, class: "mb-6") %>
<% end %>

<%= render Gustwave::Form::Field.new(label: "Large") do |field| %>
  <% field.with_control_range(id: "large-range", value: 50, size: :lg) %>
<% end %>

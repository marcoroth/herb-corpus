<%= render Gustwave::Form::Field.new(label: "Effort (hours)", helper_text: "Drag to set how many hours the task should take.", class: "mb-6") do |field| %>
  <% field.with_control_range(id: "helper-range", min: 0, max: 40, value: 8) %>
<% end %>

<%= render Gustwave::Form::Field.new(label: "Budget", validation: :error) do |field| %>
  <% field.with_control_range(id: "error-range", min: 0, max: 1500, value: 1200) %>

  <% field.with_validation_message do %>
    <span class="font-medium">Oops!</span> Budgets over $1000 need approval.
  <% end %>
<% end %>

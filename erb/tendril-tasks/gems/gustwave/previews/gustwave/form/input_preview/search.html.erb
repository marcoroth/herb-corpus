<form class="max-w-md mx-auto">
  <%= render Gustwave::Form::Field.new do |field| %>
    <% field.with_label("Search", class: "sr-only") %>

    <% field.with_control_input(type: :search, size: :lg, class: "text-sm", placeholder: "Search projects, tasks…", required: true) do |input| %>
      <% input.with_leading_visual_icon(:search, theme: :outline, class: "-ms-1") %>
      <% input.with_trailing_action_button("Search", type: :submit, class: "px-4") %>
    <% end %>
  <% end %>
</form>

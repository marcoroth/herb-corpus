<div class="max-w-md mx-auto space-y-4">
  <%= render Gustwave::Form::Input.new(type: :search, size: :sm, placeholder: "Search projects, tasks…", aria: { label: "Search" }) do |input| %>
    <% input.with_leading_visual_icon(:search, theme: :outline) %>
    <% input.with_trailing_action_button("Search", type: :submit) %>
  <% end %>

  <%= render Gustwave::Form::Input.new(type: :search, size: :md, placeholder: "Search projects, tasks…", aria: { label: "Search" }) do |input| %>
    <% input.with_leading_visual_icon(:search, theme: :outline) %>
    <% input.with_trailing_action_button("Search", type: :submit) %>
  <% end %>

  <%= render Gustwave::Form::Input.new(type: :search, size: :lg, placeholder: "Search projects, tasks…", aria: { label: "Search" }) do |input| %>
    <% input.with_leading_visual_icon(:search, theme: :outline) %>
    <% input.with_trailing_action_button("Search", type: :submit) %>
  <% end %>
</div>

<form class="flex items-center max-w-sm mx-auto">
  <%= render Gustwave::Form::Field.new(class: "w-full") do |field| %>
    <% field.with_label("Search", class: "sr-only") %>

    <% field.with_control_input(placeholder: "Search branch name…", required: true) do |input| %>
      <% input.with_leading_visual_icon(:code_pull_request, theme: :outline, class: "-ms-1") %>
    <% end %>
  <% end %>

  <%= render Gustwave::Buttons::Default.new(type: :submit, size: :none, class: "shrink-0 p-2.5 ms-2 text-sm font-medium border border-blue-700") do |button| %>
    <% button.with_leading_visual_icon :search, theme: :outline, class: "h-5 w-5 -m-0.5" %>
    <span class="sr-only">Search</span>
  <% end %>
</form>

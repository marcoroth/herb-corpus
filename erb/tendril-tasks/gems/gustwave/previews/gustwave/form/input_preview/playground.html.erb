<%= render Gustwave::Form::Field.new(label: "Playground", helper_text: "Change the options in the params panel.", validation: validation) do |field| %>
  <% field.with_control_input(type: type, size: size, icon: icon, disabled: disabled, placeholder: placeholder, id: "playground-input") do |input| %>
    <% input.with_trailing_action_button("Search", type: :submit) if trailing_action == :button %>
  <% end %>
<% end %>

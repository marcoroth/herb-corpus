<form class="flex items-center max-w-lg mx-auto">
  <%= render Gustwave::Form::Field.new(class: "w-full") do |field| %>
    <% field.with_label("Search", class: "sr-only") %>

    <% field.with_control_input(placeholder: "Search Mockups, Logos, Design Templates…", required: true) do |input| %>
      <% input.with_leading_visual_icon(:palette, theme: :outline, class: "-ms-1") %>

      <% input.with_trailing_action_generic do %>
        <button type="button" aria-label="Search by voice" class="absolute inset-y-0 end-0 flex items-center pe-3">
          <%= render Gustwave::Icon.new(:microphone, theme: :outline, class: "w-5 h-5 -me-0.5 text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white") %>
        </button>
      <% end %>
    <% end %>
  <% end %>

  <%= render Gustwave::Buttons::Default.new(type: :submit, size: :none, class: "inline-flex items-center shrink-0 py-2.5 px-3 ms-2 text-sm font-medium border border-blue-700") do |button| %>
    <% button.with_leading_visual_icon :search, theme: :outline, class: "h-5 w-5 -ms-0.5 -my-0.5 shrink-0" %> Search
  <% end %>
</form>

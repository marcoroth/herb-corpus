<%= render Gustwave::Form::Field.new(label: "Your email", class: "mb-6") do |field| %>
  <% field.with_control_input(type: :text, icon: :envelope, id: "input-group-1", placeholder: "ada@analytical.example") %>
<% end %>

<%= render Gustwave::Form::Field.new(label: "Username") do |field| %>
  <% field.with_control_input_group do |group| %>
    <% group.with_leading_addon_text { |addon| addon.with_leading_visual_icon(:user_circle) } %>
    <% group.with_control_input(id: "website-admin", placeholder: "ada") %>
  <% end %>
<% end %>

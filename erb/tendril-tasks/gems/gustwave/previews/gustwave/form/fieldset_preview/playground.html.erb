<%= render Gustwave::Form::Fieldset.new(label: "Notify me by", validation: validation, helper_text: helper_text, validation_message: ("Pick at least one channel." unless validation == :none)) do %>
  <%= render Gustwave::Form::InlineField.new(label: "Email", validation: validation, class: "mb-4") do |field| %>
    <% field.with_control_checkbox(id: "playground-email", name: "channels[]", value: "email") %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(label: "Text message", validation: validation) do |field| %>
    <% field.with_control_checkbox(id: "playground-sms", name: "channels[]", value: "sms") %>
  <% end %>
<% end %>

<h3 class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">Notifications</h3>

<%= render Gustwave::Form::Fieldset.new do |fieldset| %>
  <% fieldset.with_label("Notify me by", class: "sr-only") %>

  <%= render Gustwave::Form::InlineField.new(label: "Email", class: "mb-4") do |field| %>
    <% field.with_control_checkbox(id: "sr-email", name: "channels[]", value: "email", checked: true) %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(label: "Text message") do |field| %>
    <% field.with_control_checkbox(id: "sr-sms", name: "channels[]", value: "sms") %>
  <% end %>
<% end %>

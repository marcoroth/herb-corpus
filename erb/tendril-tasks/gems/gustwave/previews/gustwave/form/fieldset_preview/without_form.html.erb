<%= render Gustwave::Form::Fieldset.new(label: "Notify me by", validation: :error, helper_text: "Pick any.", validation_message: "Pick at least one channel.") do %>
  <%= render Gustwave::Form::InlineField.new(label: "Email", validation: :error, class: "mb-4") do |field| %>
    <% field.with_control_checkbox(id: "plain-email", name: "channels[]", value: "email") %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(label: "Text message", validation: :error) do |field| %>
    <% field.with_control_checkbox(id: "plain-sms", name: "channels[]", value: "sms") %>
  <% end %>
<% end %>

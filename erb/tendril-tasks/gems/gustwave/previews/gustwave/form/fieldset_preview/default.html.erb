<%= render Gustwave::Form::Fieldset.new(label: "Notify me by", helper_text: "You can change this at any time in your profile.") do %>
  <%= render Gustwave::Form::InlineField.new(label: "Email", class: "mb-4") do |field| %>
    <% field.with_control_checkbox(id: "default-email", name: "channels[]", value: "email", checked: true) %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(label: "Text message", class: "mb-4") do |field| %>
    <% field.with_control_checkbox(id: "default-sms", name: "channels[]", value: "sms") %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(label: "Push notification") do |field| %>
    <% field.with_control_checkbox(id: "default-push", name: "channels[]", value: "push") %>
  <% end %>
<% end %>

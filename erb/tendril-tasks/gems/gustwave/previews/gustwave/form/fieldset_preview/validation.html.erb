<%= render Gustwave::Form::Fieldset.new(label: "Notify me by", helper_text: "Pick any.", class: "mb-8") do %>
  <%= render Gustwave::Form::InlineField.new(label: "Email") do |field| %>
    <% field.with_control_checkbox(id: "none-email", name: "none[]", value: "email") %>
  <% end %>
<% end %>

<%= render Gustwave::Form::Fieldset.new(label: "Notify me by", validation: :success, validation_message: "Great, we will keep you posted.", class: "mb-8") do %>
  <%= render Gustwave::Form::InlineField.new(label: "Email", validation: :success) do |field| %>
    <% field.with_control_checkbox(id: "success-email", name: "success[]", value: "email", checked: true) %>
  <% end %>
<% end %>

<%= render Gustwave::Form::Fieldset.new(label: "Notify me by", validation: :error, validation_message: "Pick at least one channel.") do %>
  <%= render Gustwave::Form::InlineField.new(label: "Email", validation: :error) do |field| %>
    <% field.with_control_checkbox(id: "error-email", name: "error[]", value: "email") %>
  <% end %>
<% end %>

<input
  type="text"
  id="workspace-name"
  aria-invalid="true"
  aria-describedby="workspace-name-message"
  placeholder="Workspace name"
  class="
    block w-full p-2.5 text-sm text-gray-900 border border-red-500 rounded-lg bg-red-50 dark:bg-gray-700
    dark:border-red-500 dark:text-white
  "
>

<%= render Gustwave::Form::ValidationMessage.new(id: "workspace-name-message", validation: :error) do %>
  Enter a name for your workspace.
<% end %>

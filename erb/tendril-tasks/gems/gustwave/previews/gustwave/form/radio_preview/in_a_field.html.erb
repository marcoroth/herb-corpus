<%# A group in the error state: every radio colors its label, the Form::Fieldset renders the message once %>
<%= render Gustwave::Form::Fieldset.new(label: "Plan", validation: :error, validation_message: "Choose a plan to continue.") do %>
  <%= render Gustwave::Form::InlineField.new(label: "Free", validation: :error, class: "mb-2") do |field| %>
    <% field.with_control_radio(id: "plan-free", name: "plan", value: "free") %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(label: "Pro", validation: :error, class: "mb-2") do |field| %>
    <% field.with_control_radio(id: "plan-pro", name: "plan", value: "pro") %>
  <% end %>

  <%= render Gustwave::Form::InlineField.new(label: "Team", validation: :error) do |field| %>
    <% field.with_control_radio(id: "plan-team", name: "plan", value: "team") %>
  <% end %>
<% end %>

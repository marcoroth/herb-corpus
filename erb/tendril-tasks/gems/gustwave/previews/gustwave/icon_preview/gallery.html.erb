<div class="space-y-6">
  <% icons.each do |theme, names| %>
    <section class="space-y-2">
      <h2 class="text-sm font-semibold text-gray-900 dark:text-white"><%= theme %></h2>

      <ul class="flex flex-wrap gap-4">
        <% names.each do |name| %>
          <li class="flex w-24 flex-col items-center gap-1 text-xs text-gray-500 dark:text-gray-400">
            <%= render Gustwave::Icon.new(name, theme:, position: :standalone, color: :dark) %>
            <code><%= name.inspect %></code>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>

<div class="flex flex-wrap items-end gap-4">
  <% stroke_widths.each do |stroke_width| %>
    <div class="flex flex-col items-center gap-1 text-xs text-gray-500 dark:text-gray-400">
      <%= render Gustwave::Icon.new(:clock, stroke_width:, size: :xl, position: :standalone, color: :dark) %>
      <code><%= stroke_width.to_s %></code>
    </div>
  <% end %>
</div>

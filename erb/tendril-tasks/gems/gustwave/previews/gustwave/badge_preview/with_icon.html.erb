<div class="flex flex-wrap items-center gap-2">
  <%= render Gustwave::Badge.new(color: :dark, aria: { label: "Done" }) do |badge| %>
    <% badge.with_leading_visual_icon :check %>
  <% end %>

  <%= render Gustwave::Badge.new(aria: { label: "Verified" }) do |badge| %>
    <% badge.with_leading_visual_icon :badge_check, theme: :solid %>
  <% end %>

  <%= render Gustwave::Badge.new(color: :dark, aria: { label: "Assignee" }) do |badge| %>
    <% badge.with_leading_visual_icon :user_circle, theme: :solid %>
  <% end %>

  <%= render Gustwave::Badge.new(aria: { label: "Details" }) do |badge| %>
    <% badge.with_leading_visual_icon :info_circle, theme: :solid %>
  <% end %>
</div>

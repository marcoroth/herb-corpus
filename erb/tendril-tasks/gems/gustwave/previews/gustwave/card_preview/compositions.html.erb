<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4">
  <%= render Gustwave::Card.new do |card| %>
    <% card.configure_body(class: "px-0 pb-10 pt-4") %>

    <div class="flex justify-end px-4">
      <%= render Gustwave::Dropdown.new(inline: true, icon: :dots_vertical, trailing_icon: false, aria: { label: "Open user menu" }) do |dropdown| %>
        <% dropdown.with_menu_list do |menu| %>
          <% menu.with_item_link "Edit profile", href: "#" %>
          <% menu.with_item_link "Sign out", href: "#" %>
        <% end %>
      <% end %>
    </div>

    <div class="flex flex-col items-center">
      <%= render Gustwave::Avatar.new(src: "/icon.png", alt: "Jane Doe", size: :xl, class: "mb-3") %>
      <%= render Gustwave::Heading.new("Jane Doe", tag: :h5, class: "mb-1 tracking-tight") %>

      <span class="text-sm text-gray-500 dark:text-gray-400">Visual designer</span>

      <div class="mt-4 flex gap-3">
        <%= render Gustwave::Buttons::Default.new("Add friend", tag: :a, href: "#") %>
        <%= render Gustwave::Buttons::DefaultOutline.new("Message", tag: :a, href: "#") %>
      </div>
    </div>
  <% end %>

  <%= render Gustwave::Card.new do %>
    <div class="text-center">
      <%= render Gustwave::Heading.new("Ready to get started?", tag: :h5, class: "mb-2 tracking-tight") %>
      <%= render Gustwave::Paragraph.new("Start a free trial today and see how the platform fits your team.", class: "mb-4") %>

      <div class="flex justify-center gap-3">
        <%= render Gustwave::Buttons::Default.new("Start trial", tag: :a, href: "#") %>
        <%= render Gustwave::Buttons::DefaultOutline.new("Contact sales", tag: :a, href: "#") %>
      </div>
    </div>
  <% end %>

  <%= render Gustwave::Card.new do %>
    <%= render Gustwave::Heading.new("Standard", tag: :h5, class: "mb-2 tracking-tight") %>

    <div class="flex items-baseline text-gray-900 dark:text-white">
      <span class="text-3xl font-semibold">$29</span>
      <span class="ms-1 text-gray-500 dark:text-gray-400">/month</span>
    </div>

    <ul class="my-6 space-y-4 text-sm text-gray-500 dark:text-gray-400">
      <li class="flex items-center">
        <%= render Gustwave::Icon.new(:check, size: :xs, class: "me-2 text-green-500") %> Up to 10 users
      </li>

      <li class="flex items-center">
        <%= render Gustwave::Icon.new(:check, size: :xs, class: "me-2 text-green-500") %> 20 GB of storage
      </li>

      <li class="flex items-center">
        <%= render Gustwave::Icon.new(:check, size: :xs, class: "me-2 text-green-500") %> Priority support
      </li>
    </ul>

    <%= render Gustwave::Buttons::Default.new("Choose plan", tag: :a, href: "#", class: "w-full") %>
  <% end %>

  <%= render Gustwave::Card.new do %>
    <%= render Gustwave::Heading.new("Included in every plan", tag: :h5, class: "mb-4 tracking-tight") %>

    <ul class="space-y-3 text-sm text-gray-700 dark:text-gray-300">
      <li class="flex items-center">
        <%= render Gustwave::Icon.new(:check, size: :xs, class: "me-2 text-green-500") %> Unlimited projects
      </li>

      <li class="flex items-center">
        <%= render Gustwave::Icon.new(:check, size: :xs, class: "me-2 text-green-500") %> Shared calendars
      </li>

      <li class="flex items-center">
        <%= render Gustwave::Icon.new(:check, size: :xs, class: "me-2 text-green-500") %> Audit trail for every change
      </li>
    </ul>
  <% end %>
</div>

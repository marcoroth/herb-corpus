<%= tag.div(**@options) do %>
  <%= tag.div(class: classes(:strap_top)) if element?(:strap_top) %>

  <%= tag.div(class: classes(:frame)) do %>
    <% SIDE_PARTS.each do |part| %>
      <%= tag.div(class: classes(part)) if element?(part) %>
    <% end %>

    <%= tag.div(class: classes(:screen)) do %>
      <%= content %>
    <% end %>
  <% end %>

  <% if element?(:keyboard) %>
    <%= tag.div(class: classes(:keyboard)) do %>
      <%= tag.div(class: classes(:keyboard_notch)) %>
    <% end %>
  <% end %>

  <%= tag.div(class: classes(:chin)) if element?(:chin) %>
  <%= tag.div(class: classes(:stand)) if element?(:stand) %>
  <%= tag.div(class: classes(:strap_bottom)) if element?(:strap_bottom) %>
<% end %>

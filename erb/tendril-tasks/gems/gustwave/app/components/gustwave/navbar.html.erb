<%= tag.nav(**config) do %>
  <%= tag.div(**container_config) do %>
    <%= brand %>

    <% if actions? || items? %>
      <%= tag.div(**actions_config) do %>
        <%= actions %>

        <% if items? %>
          <%= render toggle %>
        <% end %>
      <% end %>
    <% end %>

    <% if items? %>
      <%= tag.div(**menu_config) do %>
        <%= tag.ul(**list_config) { safe_join(items.map(&:to_s)) } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

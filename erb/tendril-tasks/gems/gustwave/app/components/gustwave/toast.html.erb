<%= tag.div **@options do %>
  <%= text_or_content(text) %>

  <% if dismissible? %>
    <%= render Gustwave::DismissButton.new(@id, theme: :default, color: :none,
                                           icon_options: { stroke_width: 1.5, class: "h-6 w-6" },
                                           **attributes_for(:dismiss_button)) %>
  <% end %>
<% end %>

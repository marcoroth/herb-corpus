<%= render Gustwave::Toast.new(id: @id,
                               position: @position,
                               dismissible: @dismissible,
                               auto_remove: @auto_remove) do %>
  <%= tag.div **@options do %>
    <%= render Gustwave::Icon.new(@icon) %>
    <%= tag.span t(".#{@status}", default: ""), class: "sr-only" %>
  <% end %>

  <div class="ms-3 text-sm font-normal"><%= text_or_content(text) %></div>
<% end %>

<li>
  <label class="cursor-pointer">
    <%= checkbox_tag "coordinator_ids[]",
                     @coordinator.id,
                     @is_checked,
                     id: "coordinator_ids_#{@coordinator.id}_modal",
                     "data-action": "change->list-mover#toggle",
                     class: "sr-only peer" %>

    <span
      class="
        flex items-center gap-2 text-gray-900 rounded-lg bg-gray-50 hover:bg-gray-100 hover:shadow-sm
        dark:bg-gray-600 dark:hover:bg-gray-500 dark:text-white p-2 peer-focus:ring-2 peer-focus:ring-blue-500
      "
    >
      <%= render TendrilTasks::Avatar.new(@coordinator, size: :xs, tag: :span) %>
      <%= tag.span @coordinator.name, class: "text-sm dark:text-white truncate" %>
    </span>
  </label>
</li>

<li>
  <%= hidden_field_tag "assigned_coordinator_ids[]",
                       @coordinator.id,
                       id: "coordinator_ids_#{@coordinator.id}" %>

  <div class="flex items-center gap-2 p-2 text-gray-900 rounded-lg bg-gray-50 dark:bg-gray-600 dark:text-white">
    <%= render TendrilTasks::Avatar.new(@coordinator, size: :sm) %>
    <%= tag.span @coordinator.name, class: "font-medium dark:text-white truncate" %>
  </div>
</li>

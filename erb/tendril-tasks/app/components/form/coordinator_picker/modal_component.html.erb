<%= render Modal::ShellComponent.new(@id) do |shell| %>
  <% shell.with_heading t(".title"), class: "text-lg" %>

  <%# Modal body %>

  <%= form_with url: coordinators_searches_path,
                method: :post,
                data: {
                    controller: "auto-focus auto-submit list-mover dim-backdrop",
                    turbo_stream: "true"
                },
                class: "mx-auto" do |f| %>
    <div class="p-4 md:p-5">
      <%# Search box %>
      <div class="md:min-h-96 space-y-4">
        <%# Search field with a button that submits it through a GET request. It is the auto-submit target %>
        <%# and comes before the footer's submit button, so Enter in the field submits the search %>
        <%= render Gustwave::Form::Field.new(:search, form: f) do |field| %>
          <% field.with_label t(".select_additional_contacts"), class: "font-normal text-gray-500 dark:text-gray-400" %>

          <% field.with_control_input_group do |group| %>
            <% group.with_control_input(
                 type: :search,
                 placeholder: t(".search_by_name_or_username"),
                 autocomplete: "off",
                 data: {
                     action: "input->auto-submit#delayed",
                     auto_focus_target: "focusHere"
                 }) %>

            <% group.with_trailing_addon_button(
                 type: :submit,
                 formmethod: :get,
                 aria: { label: t("forms.search") },
                 data: { auto_submit_target: "submit" }) do |button| %>
              <% button.with_leading_visual_icon(:search, theme: :outline) %>
            <% end %>
          <% end %>
        <% end %>

        <%# Search results %>
        <%= render Form::CoordinatorPicker::SelectionComponent.new("candidates", @suggestions) %>
      </div>

      <%# Chosen coordinators %>
      <div class="md:min-h-36 space-y-4">
        <%= render Gustwave::Paragraph.new(t(".selected_contacts"), class: "text-sm font-normal") %>
        <%= render Form::CoordinatorPicker::SelectionComponent.new("coordinators", @assigned, is_checked: true) %>
      </div>
    </div>

    <%= render Modal::FooterComponent.new do %>
      <%= render Gustwave::Buttons::Default
                   .new(type: :submit,
                        class: "w-full",
                        **Gustwave::Modal.trigger_options(@id, action: :hide))
                   .with_content(t ".submit") %>
    <% end %>
  <% end # of form %>
<% end %>

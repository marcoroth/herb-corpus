<%= render Gustwave::Buttons::GradientDuotone.new(tag: :a,
                                                 href: rocketchat_link(to: @user),
                                                 target: "_blank",
                                                 color: :purple_to_blue,
                                                 size: :sm,
                                                 data: {
                                                   controller: "deeplink",
                                                   "app-link": rocketchat_applink(to: @user)
                                                 },
                                                 class: "m-0") do |contact_button| %>
  <% contact_button.with_leading_visual_image("rocketchat/icon-white.svg") %>

  <% if responsive? %>
    <%= tag.span t(".contact.long"), class: "hidden sm:inline" %>
    <%= tag.span t(".contact.abbr"), class: "sm:hidden" %>
  <% else %>
    <%= tag.span t(".contact.long") %>
  <% end %>
<% end %>

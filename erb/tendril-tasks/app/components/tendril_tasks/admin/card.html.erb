<%# Admin Menu Card %>
<li
  class="
    w-full border border-gray-200 bg-white rounded-lg shadow-md sm:max-w-md
    dark:bg-gray-800 dark:border-gray-700
  "
>
  <div class="p-6 gap-4 md:gap-6 sm:p-8 flex flex-col h-full">
    <div class="space-y-1">
      <%= heading %>

      <% if badges? %>
        <ul class="flex flex-wrap gap-y-0.5 gap-x-1">
          <% badges.each do |badge| %>
            <li><%= badge %></li>
          <% end %>
        </ul>
      <% end %>
    </div>

    <div class="grow">
      <% paragraphs.each do |paragraph| %>
        <%= paragraph %>
      <% end %>

      <%= content %>
    </div>

    <div class="grid grid-cols-1">
      <% buttons.each do |button| %>
        <%= button %>
      <% end %>
    </div>
  </div>
</li>

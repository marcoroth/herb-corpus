<%= render Gustwave::Dropdown.new(placement: :bottom_start,
                                  menu_id: "avatar-dropdown-menu") do |dropdown| %>
  <% dropdown.with_trigger_generic do %>
    <%= render TendrilTasks::Avatar.new(
      current_user,
      size: :md,
      type: :button,
      class: classes(:avatar)
    ) %>
  <% end %>

  <% dropdown.with_menu_list class: "min-w-44" do |menu| %>
    <% menu.with_header class: "space-y-1" do %>
      <div><%= current_user.name %></div>
      <div><%= render TendrilTasks::RoleBadge.new(current_user, size: :xs) %></div>
    <% end %>

    <% menu.with_item_link t(".profile"),
                 href: profile_path,
                 icon: :profile_card %>

    <% menu.with_item_link t(".dashboard"),
                 href: dashboard_path,
                 icon: :chalkboard %>

    <% if show_admin_settings? %>
      <% menu.with_item_divider %>
      <% menu.with_item_link t(".administration"),
                   href: admin_root_path,
                   icon: :cog %>
    <% end %>

    <% menu.with_item_divider %>

    <% menu.with_item_link t(".logout"),
                 icon: :arrow_left_to_bracket,
                 href: destroy_user_session_path,
                 data: { "turbo-method": :delete } %>
  <% end %>
<% end %>

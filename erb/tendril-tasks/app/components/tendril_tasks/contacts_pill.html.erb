<%= render Modal::ToggleButtonComponent.new(scheme: :none, modal_id: @modal_id, **@options) do %>
  <%= tag.span t(".contacts"),
               class: "shrink-0 text-xs bg-blue-600 rounded-full text-white px-4 py-1.5 me-3" %>

  <span class="flex gap-2 overflow-hidden shrink truncate">
    <% @coordinators.each do |coordinator| %>
      <span class="flex items-center gap-2 text-sm font-medium">
        <%= render TendrilTasks::Avatar.new(coordinator, size: :xs, tag: :span) %>
        <%= tag.span coordinator.name, class: "dark:text-white truncate" %>
      </span>
    <% end %>
  </span>

  <svg class="shrink-0 ms-2 w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
    <path
      fill-rule="evenodd"
      d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
      clip-rule="evenodd"
    ></path>
  </svg>
<% end %>

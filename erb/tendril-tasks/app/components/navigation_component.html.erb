<%= render Gustwave::Navbar.new(class: "min-w-[320px] border-b border-gray-100 shadow-xs") do |navbar| %>
  <% navbar.configure_container(class: "max-w-(--breakpoint-lg)") %>
  <% navbar.configure_menu(class: "md:ms-auto md:me-8") %>

  <%# Brand logo and label %>
  <% navbar.with_brand do %>
    <%= render Navigation::BrandComponent.new %>
  <% end %>

  <% navbar.with_actions do %>
    <%# User menu %>
    <%= render TendrilTasks::Navigation::AvatarDropdownMenu.new %>

    <%# Login button %>
    <% unless user_signed_in? %>
      <%= form_tag rocketchat_sign_in_path, method: rocketchat_sign_in_method do %>
        <%= render Gustwave::Buttons::GradientDuotone.new(
          color: :purple_to_blue,
          size: :xs,
          data: { turbo: false },
          type: :submit,
          class: "mt-1 sm:mt-0 sm:inline-flex sm:px-5 sm:py-2.5 sm:text-sm sm:font-medium") do %>
          <% it.with_leading_visual_svg("rocketchat/icon-white.svg") %>
          <span class="sr-only min-[400px]:not-sr-only"><%= t "rocketchat.sign_in_button.short" %></span>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% links.each do |link| %>
    <% navbar.with_item_generic do %>
      <%= link %>
    <% end %>
  <% end %>

  <%# Login/Logout buttons in hamburger menu %>
  <% if links? %>
    <% navbar.with_item_generic(class: "md:hidden") do %>
      <% if user_signed_in? %>
        <%= button_to t(".sign_out"), destroy_user_session_path, method: :delete, class: "nav-link" %>
      <% else %>
        <%= button_to t("rocketchat.sign_in_button.short"), rocketchat_sign_in_path, method: rocketchat_sign_in_method, data: { turbo: false }, class: "nav-link" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

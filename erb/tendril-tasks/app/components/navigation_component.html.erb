<nav class="min-w-[320px] bg-white border-b border-gray-100 shadow-xs dark:bg-gray-900">
  <div class="max-w-(--breakpoint-lg) flex flex-wrap items-center justify-between mx-auto p-4">
    <%# Brand logo and label %>
    <%= render Navigation::BrandComponent.new %>

    <%# Login button and user menu %>
    <div class="flex md:order-2 space-x-3 md:space-x-0">
      <%# User menu %>
      <%= render TendrilTasks::Navigation::AvatarDropdownMenu.new %>

      <%# Login button %>
      <% unless user_signed_in? %>
        <%= form_tag rocketchat_sign_in_path, method: rocketchat_sign_in_method do %>
          <%= render Gustwave::Button.new(
            theme: :gradient_duotone,
            scheme: :purple_to_blue,
            size: :xs,
            data: { turbo: false },
            type: :submit,
            class: "mt-1 sm:mt-0 sm:inline-flex sm:px-5 sm:py-2.5 sm:text-sm sm:font-medium") do %>
            <% it.leading_svg("rocketchat/icon-white.svg") %>
            <span class="sr-only min-[400px]:not-sr-only"><%= t "rocketchat.sign_in_button.short" %></span>
          <% end %>
        <% end %>
      <% end %>

      <%# Hamburger menu button %>
      <button
        data-collapse-toggle="navbar-cta"
        type="button"
        class="
          inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-500 rounded-lg md:hidden
          hover:bg-gray-100 focus:outline-hidden focus:ring-2 focus:ring-gray-200 dark:text-gray-400
          dark:hover:bg-gray-700 dark:focus:ring-gray-600
        "
        aria-controls="navbar-cta"
        aria-expanded="false"
      >
        <span class="sr-only"><%= t(".open_main_menu") %></span>

        <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14">
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 1h15M1 7h15M1 13h15"
          />
        </svg>
      </button>
    </div>

    <% if links? %>
      <div class="items-center justify-between hidden w-full md:flex md:w-auto md:order-1" id="navbar-cta">
        <ul
          class="
            flex flex-col font-medium p-4 md:p-0 mt-4 border border-gray-100 rounded-lg bg-gray-50 md:gap-8
            md:flex-row md:mt-0 md:border-0 md:bg-white dark:bg-gray-800 md:dark:bg-gray-900 dark:border-gray-700
          "
        >
          <% links.each do |link| %>
            <li><%= link %></li>
          <% end %>

          <%# Login/Logout buttons in hamburger menu %>
          <li class="md:hidden">
            <% if user_signed_in? %>
              <%= button_to t(".sign_out"), destroy_user_session_path, method: :delete, class: "nav-link" %>
            <% else %>
              <%= button_to t("rocketchat.sign_in_button.short"), rocketchat_sign_in_path, method: rocketchat_sign_in_method, data: { turbo: false }, class: "nav-link" %>
            <% end %>
          </li>
        </ul>
      </div>
    <% end %>
  </div>
</nav>

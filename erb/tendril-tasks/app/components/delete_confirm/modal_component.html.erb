<%# Modal to confirm deleting a resource %>
<%= render Modal::ShellComponent.new(@id, data: { controller: "cooldown", "cooldown-seconds-value": @cooldown }) do |shell| %>
  <% shell.with_heading do %>
    <%= heading %>
  <% end %>

  <%# Modal body %>
  <div class="p-4 md:p-5 space-y-4">
    <% body_elements.each do |element| %>
      <%= element %>
    <% end %>
  </div>

  <%# Modal footer %>
  <%= form_tag @delete_path, method: :delete, class: class_merge(Modal::ShellComponent::FOOTER_CLASS, "md:grid-cols-2") do %>
    <%= abort_button %>
    <%= confirm_button %>
  <% end %>
<% end %>

<%# Modal to confirm deleting a resource %>
<%= render Modal::ShellComponent.new(@id, data: { controller: "cooldown", "cooldown-seconds-value": @cooldown }) do |shell| %>
  <% shell.with_heading do %>
    <%= heading %>
  <% end %>

  <%# Modal body %>
  <%= render Gustwave::ModalBody.new do %>
    <% body_elements.each do |element| %>
      <%= element %>
    <% end %>
  <% end %>

  <%# Modal footer %>
  <%= form_tag @delete_path, method: :delete do %>
    <%= render Modal::FooterComponent.new(columns: 2) do %>
      <%= abort_button %>
      <%= confirm_button %>
    <% end %>
  <% end %>
<% end %>

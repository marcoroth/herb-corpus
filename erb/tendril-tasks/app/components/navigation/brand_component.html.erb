<div id="brand">
  <%# cache ["brand", @brand.updated_at] do %>
  <div class="flex items-center space-x-3">
    <a class="rounded-sm whitespace-nowrap inline-flex" href="/"><%= render TendrilTasks::Logo.new %></a>
    <%= render TendrilTasks::Navigation::BrandBadge.new(@brand) %>
  </div>
  <%# end %>
</div>

<%= tag.div **@options do %>
  <%= render Gustwave::Form::RichText::Toolbar.new(tag: :"lexxy-toolbar",
                                                   id: @id,
                                                   class: "p-0 gap-0 border-0",
                                                   data: { controller: "lexxy-heading" }) do %>
    <% @actions.each do |action| %>
      <% case action %>
      <% when :divider %>
        <%= render Gustwave::Form::RichText::Divider.new %>
      <% when :link %>
        <%= render Gustwave::Form::RichText::Lexxy::LinkToggle.new(disabled: disabled?(action)) %>
      <% when :highlight %>
        <%= render Gustwave::Form::RichText::Lexxy::HighlightToggle.new(disabled: disabled?(action)) %>
      <% else %>
        <%= render Gustwave::Form::RichText::Lexxy::Button.new(action,
                                                               disabled: disabled?(action),
                                                               **button_options(action)) %>
      <% end %>
    <% end %>

    <%# Lexxy moves buttons into this menu when they overflow the toolbar. Our toolbar wraps instead, so it stays hidden. %>
    <lexxy-toolbar-dropdown class="lexxy-editor__toolbar-dropdown lexxy-editor__toolbar-overflow" hidden>
      <button type="button" data-dropdown-trigger aria-haspopup="menu" aria-expanded="false" hidden></button>
      <div data-dropdown-panel role="menu" hidden></div>
    </lexxy-toolbar-dropdown>
  <% end %>
<% end %>

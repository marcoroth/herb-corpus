<%= content_tag :"lexxy-highlight-dropdown",
                class: "lexxy-editor__toolbar-dropdown lexxy-editor__toolbar-dropdown--highlight",
                **@options do %>
  <%= render Gustwave::Form::RichText::Button.new(:highlight, **trigger_options) %>

  <%= tag.div role: "menu",
              "aria-label": t(".highlight"),
              hidden: true,
              data: { "dropdown-panel": true } do %>
    <div class="lexxy-highlight-colors"></div>

    <%= render Gustwave::Button.new(t(".remove_highlight"),
                                    role: "menuitem",
                                    size: :xs,
                                    scheme: :alternative,
                                    "data-command": "removeHighlight") %>
  <% end %>
<% end %>

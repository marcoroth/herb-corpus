<%= content_tag :"lexxy-link-dropdown",
                class: "lexxy-editor__toolbar-dropdown lexxy-editor__toolbar-dropdown--link",
                **@options do %>
  <%= render Gustwave::Form::RichText::Button.new(:link, **trigger_options) %>

  <%= tag.div role: "dialog",
              "aria-label": t(".link"),
              hidden: true,
              data: { "dropdown-panel": true },
              class: "p-3 flex flex-nowrap gap-2" do %>
    <input
      type="url"
      autocomplete="url"
      placeholder="<%= t(".placeholder") %>"
      aria-label="<%= t(".url") %>"
      class="
        bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500
        block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white
        dark:focus:ring-blue-500 dark:focus:border-blue-500 w-64
      "
    >

    <div class="lexxy-editor__toolbar-dropdown-actions">
      <%= render Gustwave::Button.new(t(".link"), value: "link") %>
      <%= render Gustwave::Button.new(t(".unlink"), value: "unlink", scheme: :alternative) %>
    </div>
  <% end %>
<% end %>

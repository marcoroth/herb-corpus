<%# Generic modal window %>
<%= render Modal::ShellComponent.new(@id) do |shell| %>
  <% shell.with_heading do %>
    <%= heading %>
  <% end %>

  <%# Modal body %>
  <%= render Gustwave::ModalBody.new do %>
    <%= content %>
  <% end %>

  <%# Modal footer %>
  <%= render Modal::FooterComponent.new(columns: buttons.size) do %>
    <% buttons.each do |button| %>
      <%= button %>
    <% end %>
  <% end %>
<% end %>

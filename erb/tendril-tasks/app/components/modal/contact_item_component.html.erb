<%#
  Displays the coordinator's avatar, name and a link to contact them through
  Rocket Chat
%>

<%= render TendrilTasks::ListRow.new do |row| %>
  <% row.leading do %>
    <%= render TendrilTasks::Avatar.new(@coordinator) %>
  <% end %>

  <% row.title @coordinator.name %>

  <span class="inline-flex items-center justify-center">
    <%= render TendrilTasks::ContactButton.new(@coordinator) %>
  </span>
<% end %>

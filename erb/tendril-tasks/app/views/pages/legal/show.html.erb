<% content_for :title, t("pages.#{@page.slug}.title") %>

<%= render TendrilTasks::Content.new(width: :large) do %>
  <%= render TendrilTasks::Breadcrumb.new do |breadcrumb| %>
    <% breadcrumb.with_home %>
    <% breadcrumb.with_item t("pages.#{@page.slug}.title") %>
  <% end %>

  <%= render Gustwave::RichText.new(@page.content) %>
<% end %>

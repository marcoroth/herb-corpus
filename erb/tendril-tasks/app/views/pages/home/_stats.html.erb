<%# locals: (open_tasks_count:, initiatives_count:, new_tasks_count:) %>
<%# Links to the lists only for signed in users, who can open them %>
<% stats = [
     { key: :open_tasks, count: open_tasks_count, href: tasks_path, color: "text-blue-700 dark:text-blue-400" },
     { key: :initiatives, count: initiatives_count, href: projects_path, color: "text-purple-700 dark:text-purple-400" },
     { key: :new_tasks, count: new_tasks_count, href: tasks_path, color: "text-emerald-700 dark:text-emerald-400" }
   ] %>

<section id="home-stats" class="space-y-4">
  <%= render TendrilTasks::Heading.new(tag: :h2,
                                       scheme: :level3,
                                       class: "mb-0")
                                  .with_content(t(".title")) %>

  <ul class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <% stats.each do |stat| %>
      <li>
        <%= tag.public_send(user_signed_in? ? :a : :div,
                            href: (stat[:href] if user_signed_in?),
                            id: "home-stats-#{stat[:key].to_s.dasherize}",
                            class: "h-full flex items-center gap-4 px-5 py-4 sm:flex-col sm:items-start sm:gap-1 sm:p-6 bg-white border rounded-xl shadow-md dark:bg-gray-800 dark:border-gray-700 #{"hover:border-blue-300 dark:hover:border-blue-500" if user_signed_in?}") do %>
          <%# Number beside the text on phones, above it from sm up %>
          <%= tag.span stat[:count],
                       class: "min-w-14 text-4xl sm:text-5xl font-extrabold tracking-tight #{stat[:color]}" %>

          <span class="flex flex-col gap-0.5">
            <%= tag.span t(".#{stat[:key]}.label", count: stat[:count]),
                         class: "text-lg font-semibold text-gray-900 dark:text-white" %>

            <%= tag.span t(".#{stat[:key]}.description", count: stat[:count]),
                         class: "text-gray-500 dark:text-gray-400" %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>

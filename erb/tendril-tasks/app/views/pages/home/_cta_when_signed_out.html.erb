<%# locals: () %>
<%# On the hero picture, aligned left on wide screens. Signing in comes first, as the lists need an account %>
<%= form_tag rocketchat_sign_in_path,
             method: rocketchat_sign_in_method,
             class: "text-center lg:text-start" do %>
  <div class="flex flex-col gap-4 sm:flex-row sm:justify-center lg:justify-start" role="group">
    <%= render Gustwave::Button.new(type: :submit,
                                    theme: :gradient_duotone,
                                    scheme: :purple_to_blue,
                                    size: :xl,
                                    data: { turbo: false }) do |login_button| %>
      <% login_button.leading_svg("rocketchat/icon-white.svg") %>

      <%= t "rocketchat.sign_in_button.long",
            brand: RocketChatConfig.branding %>
    <% end %>

    <%= render Gustwave::Button
                 .new(tag: :a,
                      href: "#home-how-it-works",
                      theme: :outline,
                      scheme: :white,
                      size: :xl)
                 .with_content(t(".how_it_works")) %>
  </div>

  <%= tag.p t(".hint"), class: "mt-4 text-sm text-gray-200" %>
<% end %>

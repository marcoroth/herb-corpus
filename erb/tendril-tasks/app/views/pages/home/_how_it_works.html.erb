<%# locals: () %>
<% steps = [
     { key: :browse, icon: :layers, color: "bg-sky-100 text-sky-700 dark:bg-sky-900 dark:text-sky-300" },
     { key: :pick, icon: :clipboard_check, color: "bg-purple-100 text-purple-700 dark:bg-purple-900 dark:text-purple-300" },
     { key: :express_interest, icon: :messages, color: "bg-emerald-100 text-emerald-700 dark:bg-emerald-900 dark:text-emerald-300" }
   ] %>

<section id="home-how-it-works" class="space-y-6">
  <%= render TendrilTasks::Heading.new(tag: :h2,
                                       size: :lg,
                                       class: "text-center")
                                  .with_content(t(".title")) %>

  <ol class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <% steps.each_with_index do |step, index| %>
      <li class="flex flex-col gap-2 p-6 bg-white/70 border rounded-xl dark:bg-gray-800/70 dark:border-gray-700">
        <div class="flex items-center gap-3">
          <%= tag.span class: "size-11 flex items-center justify-center rounded-lg #{step[:color]}" do %>
            <%= render Gustwave::Icon.new(step[:icon], position: :standalone) %>
          <% end %>

          <%= tag.span t(".step", number: index + 1),
                       class: "font-mono text-sm text-gray-500 dark:text-gray-400" %>
        </div>

        <%= render TendrilTasks::Heading.new(tag: :h3,
                                             size: :xs,
                                             class: "mb-0")
                                        .with_content(t(".#{step[:key]}.title")) %>

        <%= render TendrilTasks::Paragraph.new(t(".#{step[:key]}.description",
                                                 brand: RocketChatConfig.branding),
                                               size: :md) %>
      </li>
    <% end %>
  </ol>
</section>

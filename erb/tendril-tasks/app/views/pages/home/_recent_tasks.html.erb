<%# locals: (tasks:, open_tasks_count:) %>
<section id="home-recent-tasks" class="space-y-4">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
    <%= render TendrilTasks::Heading.new(tag: :h2,
                                         scheme: :level3,
                                         class: "mb-0")
                                    .with_content(t(".title")) %>

    <%= link_to t(".view_all", count: open_tasks_count),
                tasks_path,
                class: "text-lg font-semibold text-blue-700 hover:underline dark:text-blue-400" %>
  </div>

  <%# Same grid as the tasks page %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% tasks.each do |task| %>
      <%= render TendrilTasks::Tasks::CompactCard.new(task) %>
    <% end %>
  </div>
</section>

<%# locals: (site:, applied: false) %>
<%# The introduction in white on the uploaded picture, or the default photo with its credit for Unsplash %>
<section id="home-hero" class="relative isolate overflow-hidden bg-gray-900">
  <%# The largest element on the page, so the browser fetches it first. Proxied, like the logo, which saves a redirect and lets browsers cache it %>
  <% if site.hero_image.attached? %>
    <%= image_tag rails_storage_proxy_path(site.hero_image.variant(:hero)),
                  alt: "",
                  fetchpriority: "high",
                  class: "absolute inset-0 -z-10 size-full object-cover object-[70%_60%]" %>
  <% else %>
    <%= image_tag "brand/hero.webp",
                  alt: "",
                  fetchpriority: "high",
                  class: "absolute inset-0 -z-10 size-full object-cover object-[70%_60%]" %>
  <% end %>

  <%# Darkens the picture behind the text by at least 75 %, so white text stays readable on a white picture. The picture shows above the text on phones and right of it on wide screens %>
  <div
    aria-hidden="true"
    class="
      absolute inset-0 -z-10 bg-linear-to-b from-gray-900/10 via-gray-900/80 via-30% to-gray-900/90
      lg:bg-linear-to-r lg:from-gray-900/90 lg:via-gray-900/80 lg:via-60% lg:to-gray-900/20
    "
  ></div>

  <div class="w-full mx-auto px-5 pt-40 pb-16 lg:py-28 max-w-(--breakpoint-lg)">
    <div class="max-w-2xl text-center lg:text-start">
      <%# Fades in on top of the picture, then the buttons follow. Not for those who prefer reduced motion %>
      <div class="motion-safe:animate-fade-up">
        <%= render TendrilTasks::Heading.new(
                     tag: :h1,
                     size: :"2xl",
                     class: "text-white dark:text-white") do %>
          <%= render ::Text::Highlight::GradientComponent.new(
            site.home_title,
            highlight: site.home_title_highlight,
            class: "from-sky-300 to-emerald-400"
          ) %>
        <% end %>

        <% site.home_introduction_paragraphs.each do |paragraph| %>
          <%= render TendrilTasks::Paragraph.new(class: "mb-6 text-gray-100 dark:text-gray-100") do %>
            <%= paragraph %>
          <% end %>
        <% end %>
      </div>

      <div class="motion-safe:animate-fade-up motion-safe:[animation-delay:150ms]">
        <% if user_signed_in? %>
          <%# CTA to projects and tasks %>
          <%= render "pages/home/cta_when_signed_in", applied: %>
        <% else %>
          <%# CTA with login button %>
          <%= render "pages/home/cta_when_signed_out" %>
        <% end %>
      </div>
    </div>
  </div>

  <% unless site.hero_image.attached? %>
    <%# On its own dark backing, because the overlay is light at the corner %>
    <p id="home-hero-credit" class="absolute bottom-2 end-3 px-2 py-0.5 rounded bg-gray-900/70 text-xs text-gray-100">
      <%= t(".credit_html",
            photographer: link_to("Anna Schroeder",
                                  "https://unsplash.com/@annatherphoto?utm_source=tendril_tasks&utm_medium=referral",
                                  class: "underline hover:text-white"),
            unsplash: link_to("Unsplash",
                              "https://unsplash.com/photos/yg9VZyUbpT8?utm_source=tendril_tasks&utm_medium=referral",
                              class: "underline hover:text-white")) %>
    </p>
  <% end %>
</section>

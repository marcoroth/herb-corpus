<%# locals: (applied:) %>
<%# On the hero picture, aligned left on wide screens. Finding a task comes first, then the user's own applications or else the initiatives %>
<div class="flex flex-col gap-4 sm:flex-row sm:justify-center lg:justify-start" role="group">
  <%= render Gustwave::Button
               .new(tag: :a,
                    href: tasks_path,
                    size: :lg)
               .with_content(t(".find_task")) %>

  <% if applied %>
    <%= render Gustwave::Button
                 .new(tag: :a,
                      href: dashboard_path,
                      theme: :outline,
                      scheme: :white,
                      size: :lg)
                 .with_content(t(".my_applications")) %>
  <% else %>
    <%= render Gustwave::Button
                 .new(tag: :a,
                      href: projects_path,
                      theme: :outline,
                      scheme: :white,
                      size: :lg)
                 .with_content(t(".browse_initiatives")) %>
  <% end %>
</div>

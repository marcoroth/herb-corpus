<%# Full width above the content, so the picture reaches the edges %>
<% content_for :hero do %>
  <%= render "pages/home/photo_hero", site: @site, applied: @applied %>
<% end %>

<%= render TendrilTasks::Content.new(class: "space-y-16") do %>
  <% if @open_tasks_count.positive? %>
    <%= render "pages/home/stats",
               open_tasks_count: @open_tasks_count,
               initiatives_count: @initiatives_count,
               new_tasks_count: @new_tasks_count %>
  <% end %>

  <% if @recent_tasks.present? %>
    <%= render "pages/home/recent_tasks",
               tasks: @recent_tasks,
               open_tasks_count: @open_tasks_count %>
  <% end %>

  <%= render "pages/home/how_it_works" %>
<% end %>

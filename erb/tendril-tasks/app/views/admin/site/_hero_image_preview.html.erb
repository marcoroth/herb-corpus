<%# locals: (site:) %>
<%# The uploaded picture, or the default photo the reset button restores, cropped wide like on the home page %>
<div id="current-hero-image" class="group space-y-3">
  <%# Shows the text of the home page on the picture, without JavaScript %>
  <label class="inline-flex items-center gap-3 cursor-pointer">
    <input type="checkbox" id="hero-image-show-text" class="sr-only peer">

    <span
      aria-hidden="true"
      class="
        relative w-11 h-6 shrink-0 bg-gray-200 rounded-full peer-focus-visible:ring-4 peer-focus-visible:ring-blue-300
        peer-checked:bg-blue-600 after:absolute after:top-0.5 after:start-0.5 after:size-5 after:bg-white
        after:border after:border-gray-300 after:rounded-full after:transition-all after:content-['']
        peer-checked:after:translate-x-full peer-checked:after:border-white rtl:peer-checked:after:-translate-x-full
        dark:bg-gray-700 dark:border-gray-600 dark:peer-focus-visible:ring-blue-800
      "
    ></span>

    <span class="text-sm font-medium text-gray-900 dark:text-gray-300">
      <%= t("admin.site.edit.home_page.hero_image.show_text") %>
    </span>
  </label>

  <figure class="space-y-1">
    <div class="@container relative overflow-hidden rounded-lg">
      <% if site.hero_image.attached? %>
        <%= image_tag rails_storage_proxy_path(site.hero_image.variant(:hero)),
                      alt: t("admin.site.edit.home_page.hero_image.alt"),
                      class: "w-full aspect-21/9 object-cover object-[70%_60%]" %>
      <% else %>
        <%= image_tag "brand/hero.webp",
                      alt: t("admin.site.edit.home_page.hero_image.alt"),
                      class: "w-full aspect-21/9 object-cover object-[70%_60%]" %>
      <% end %>

      <%= render "admin/site/hero_image_text_preview", site: site %>
    </div>

    <% unless site.hero_image.attached? %>
      <figcaption class="text-xs text-gray-500 dark:text-gray-400">
        <%= t("admin.site.edit.home_page.hero_image.default") %>
      </figcaption>
    <% end %>
  </figure>
</div>

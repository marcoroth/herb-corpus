<%# locals: (site:) %>
<%# Replaced when the texts are reset, which clears the fields %>
<%= form_with model: site,
              id: "site-home-text-form",
              url: admin_site_home_text_path,
              method: :put,
              class: "space-y-6 pb-6" do |form| %>
  <%# Shows the stored texts only, with the defaults in the admin's language as placeholders. %>
  <div class="flex flex-col gap-6 sm:flex-row sm:gap-4">
    <div class="grow">
      <%= render Form::TextFieldComponent.new(form,
                                              :home_title,
                                              t("admin.site.edit.home_page.text.title.label"),
                                              value: site[:home_title],
                                              placeholder: t("pages.home.title")) %>
    </div>

    <div class="sm:w-56">
      <%= render Form::TextFieldComponent.new(form,
                                              :home_title_highlight,
                                              t("admin.site.edit.home_page.text.title_highlight.label"),
                                              value: site[:home_title_highlight],
                                              placeholder: t("pages.home.title_highlight"),
                                              aria: { describedby: "site-home-title-highlight-help" }) %>

      <%= render Gustwave::Paragraph.new(t("admin.site.edit.home_page.text.title_highlight.helper_text"),
                                         id: "site-home-title-highlight-help",
                                         class: "mt-1 text-sm") %>
    </div>
  </div>

  <div>
    <%= render Form::TextAreaComponent.new(form,
                                           :home_introduction,
                                           t("admin.site.edit.home_page.text.introduction.label"),
                                           value: site[:home_introduction],
                                           placeholder: t("pages.home.hero").strip,
                                           rows: 4,
                                           aria: { describedby: "site-home-introduction-help" }) %>

    <%= render Gustwave::Paragraph.new(t("admin.site.edit.home_page.text.introduction.helper_text"),
                                       id: "site-home-introduction-help",
                                       class: "mt-1 text-sm") %>
  </div>

  <div class="flex flex-wrap">
    <div class="whitespace-nowrap space-x-2 pe-3 w-full [&_button]:w-1/2">
      <%= render Gustwave::Buttons::Default.new(type: :submit,
                                                size: :md,
                                                color: :red,
                                                form: "reset-site-home-text") do %>
        <%= t("forms.reset") %>
      <% end %>

      <%= render Gustwave::Buttons::Default.new(type: :submit,
                                                size: :md) do %>
        <%= t("forms.save") %>
      <% end %>
    </div>
  </div>
<% end %>

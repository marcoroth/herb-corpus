<%# locals: (site:) %>
<% if site.errors.any? %>
  <%= render TurboStream::NotificationComponent.new(site.errors.map(&:message).to_sentence, scheme: :alert) %>
<% else %>
  <%= render TurboStream::NotificationComponent.new(t("notification.saved")) %>

  <turbo-stream action="replace" target="brand">
    <template>
      <%= render Navigation::BrandComponent.new %>
    </template>
  </turbo-stream>
<% end %>

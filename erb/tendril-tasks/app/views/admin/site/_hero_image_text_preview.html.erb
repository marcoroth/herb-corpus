<%# locals: (site:) %>
<%# The home page on a wide screen, scaled to the width of the picture: sizes are in % of the 1280 pixel wide hero. Replaced on its own when the text is saved, so the toggle stays on %>
<div
  id="hero-image-text-preview"
  aria-hidden="true"
  class="
    hidden group-has-checked:flex absolute inset-0 items-center ps-[11.5cqw] bg-linear-to-r from-gray-900/90
    via-gray-900/80 via-60% to-gray-900/20
  "
>
  <div class="w-[52.5cqw]">
    <p class="mb-[1.25cqw] text-[4.7cqw] leading-none font-extrabold tracking-tight text-white">
      <%= render ::Text::Highlight::GradientComponent.new(
        site.home_title,
        highlight: site.home_title_highlight,
        class: "from-sky-300 to-emerald-400"
      ) %>
    </p>

    <% site.home_introduction_paragraphs.each do |paragraph| %>
      <p class="mb-[1.9cqw] text-[1.56cqw] leading-snug text-gray-100">
        <%= paragraph %>
      </p>
    <% end %>

    <p class="flex gap-[1.25cqw] text-[1.25cqw] font-medium text-white">
      <span class="inline-flex items-center h-[3.75cqw] px-[1.56cqw] bg-blue-700 rounded-[0.6cqw]">
        <%= t("pages.home.cta_when_signed_in.find_task") %>
      </span>

      <span class="inline-flex items-center h-[3.75cqw] px-[1.56cqw] border border-white rounded-[0.6cqw]">
        <%= t("pages.home.cta_when_signed_in.browse_initiatives") %>
      </span>
    </p>
  </div>
</div>

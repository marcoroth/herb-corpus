<% if @site.errors.any? %>
  <turbo-stream action="replace" target="hero-image-field">
    <template>
      <%= fields_for @site do |form| %>
        <%= render "admin/site/hero_image_file_field", form: form %>
      <% end %>
    </template>
  </turbo-stream>
<% else %>
  <turbo-stream action="replace" target="current-hero-image">
    <template>
      <%= render "admin/site/hero_image_preview", site: @site %>
    </template>
  </turbo-stream>
<% end %>

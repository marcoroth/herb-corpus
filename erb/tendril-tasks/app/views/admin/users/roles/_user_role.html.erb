<%# locals: (user:) %>
<%= render TendrilTasks::ListRow.new(id: "user-role-#{user.id}") do |row| %>
  <% row.with_leading do %>
    <%= render TendrilTasks::Avatar.new(user) %>
  <% end %>

  <% row.with_title user.name %>

  <%= form_with url: admin_users_role_path(user), method: :patch do %>
    <%# TODO this should become a selectbox %>
    <%= render TendrilTasks::ButtonGrid.new(orientation: :horizontal, size: :sm) do |grid| %>
      <% User.roles.each_key do |role_name| %>
        <%# Currently selected role %>
        <% if role_name == user.role %>
          <% grid.with_button(
               theme: :gradient_duotone,
               color: :purple_to_blue,
               disabled: true
             ).with_content(role_name.capitalize) %>
          <%# Other roles %>
        <% else %>
          <% grid.with_button(
               color: :alternative,
               type: :submit,
               name: :role,
               disabled: user.id == current_user.id,
               value: role_name).with_content(role_name.capitalize) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%# locals: (user:) %>
<%= render TendrilTasks::ListRow.new(id: "user-role-#{user.id}") do |row| %>
  <% row.with_leading do %>
    <%= render TendrilTasks::Avatar.new(user) %>
  <% end %>

  <% row.with_title user.name %>

  <%= form_with url: admin_users_role_path(user), method: :patch, data: { controller: "auto-submit" } do %>
    <%= render Gustwave::Form::Select.new(
          name: "role",
          choices: User.roles.keys.map { |role_name| [ role_name.capitalize, role_name ] },
          selected: user.role,
          size: :sm,
          disabled: user.id == current_user.id,
          aria: { label: t(".role_of", name: user.name) },
          data: { action: "change->auto-submit#immediately" }
        ) %>

    <%# Submit button used by the auto-submit controller %>
    <%= button_tag t(".save"), type: :submit, data: { auto_submit_target: "submit" }, class: "sr-only", tabindex: "-1" %>
  <% end %>
<% end %>

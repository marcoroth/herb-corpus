<%# locals: (item:) %>
<%= fields_for "categories[][links][]", item do |link_form| %>
  <div class="sitemap-link flex flex-nowrap space-x-4 mt-4 ms-2 lg:ms-4">
    <%# Title %>
    <div class="grow">
      <%= render Form::TextFieldComponent.new(link_form,
                                              :title,
                                              false,
                                              placeholder: t(".link.input.placeholder"),
                                              aria: { label: t(".link.input.title_label") }) %>
    </div>

    <%# Link href %>
    <div class="grow">
      <%= render Form::TextFieldComponent.new(link_form,
                                              :href,
                                              false,
                                              placeholder: "https://example.com",
                                              aria: { label: t(".link.input.href_label") }) %>
    </div>

    <%# Remove button %>
    <div>
      <%= render Gustwave::Button.new(theme: :outline,
                                      scheme: :red,
                                      data: {
                                        "action": "click->remove#ancestor",
                                        "remove-selector": ".sitemap-link"
                                      }) do |button| %>
        <% button.leading_icon(:close, class: "m-0 md:me-2") %>
        <span class="sr-only md:not-sr-only"><%= t(".link.button.remove") %></span>
      <% end %>
    </div>
  </div>
<% end %>

<%# locals: (form:) %>
<div class="flex flex-nowrap space-x-4">
  <%# Heading text %>
  <div class="grow">
    <%= render Form::TextFieldComponent.new(form,
                                            :title,
                                            t(".category.input.label"),
                                            placeholder: "Name") %>
  </div>

  <%# Add new link %>
  <div class="content-end">
    <%= render Gustwave::Buttons::DefaultOutline.new(data: {
                                                       action: "click->template#append",
                                                       "template-selector": "#sitemap-link-template"
                                                     }) do |button| %>
      <% button.with_leading_visual_icon(:plus, class: "m-0 md:me-2") %>
      <span class="sr-only md:not-sr-only"><%= t(".category.add_link") %></span>
    <% end %>
  </div>

  <%# Remove category %>
  <div class="content-end">
    <%= render Gustwave::Buttons::DefaultOutline.new(color: :red,
                                                     data: {
                                                       action: "click->template#replace",
                                                       "template-selector": "#sitemap-category-template",
                                                       "template-receiver": ".sitemap-category"
                                                     }) do |button| %>
      <% button.with_leading_visual_icon(:close, class: "m-0 md:me-2") %>
      <span class="sr-only md:not-sr-only"><%= t(".category.reset") %></span>
    <% end %>
  </div>
</div>

<%# locals: (category:) %>
<%= fields_for "categories[]", category do |category_form| %>
  <div data-controller="remove template" data-template-target="receiver" class="sitemap-category">
    <%# Category heading %>
    <%= render 'admin/footer/sitemap_category_heading', form: category_form %>

    <%# Category links %>
    <%= render partial: "admin/footer/sitemap_link", collection: category.links, as: :item %>
  </div>
<% end %>

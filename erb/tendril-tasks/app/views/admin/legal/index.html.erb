<%= render TendrilTasks::Content.new(width: :large) do %>
  <%= render TendrilTasks::Breadcrumb.new do |breadcrumb| %>
    <% breadcrumb.home %>
    <% breadcrumb.item t("breadcrumbs.admin"), href: admin_root_path %>
    <% breadcrumb.item t("admin.legal.title") %>
  <% end %>

  <%= render TendrilTasks::Heading.new(tag: :h1) do %>
    <%= t("admin.legal.title") %>
  <% end %>

  <%= render TendrilTasks::Paragraph.new(t(".description"), class: "mb-6") %>

  <ul class="my-4 space-y-3">
    <% Admin::LegalController::LEGAL_PAGES.each do |slug| %>
      <% exists = slug.in?(@pages) %>

      <%= render TendrilTasks::ListRow.new do |row| %>
        <% row.title do %>
          <%= link_to_if exists, t("pages.#{slug}.title"), legal_path(slug), class: "hover:underline" %>
        <% end %>

        <%= render Gustwave::Button.new(exists ? t(".edit") : t(".create"),
                                        tag: :a,
                                        href: edit_legal_path(slug)) do |button| %>
          <% button.leading_icon(exists ? :edit : :plus) %>
        <% end %>
      <% end %>
    <% end %>
  </ul>
<% end %>

<% if @setting.errors.any? %>
  <turbo-stream action="replace" target="brand-logo-field">
    <template>
      <%= fields_for @setting do |form| %>
        <%= render "admin/brand/logo_file_field", form: form %>
      <% end %>
    </template>
  </turbo-stream>
<% else %>
  <turbo-stream action="replace" target="brand-logo">
    <template>
      <%= render TendrilTasks::Logo.new(size: :sm) %>
    </template>
  </turbo-stream>

  <turbo-stream action="replace" target="current-brand-logo">
    <template>
      <%= render TendrilTasks::Logo.new(id: "current-brand-logo", size: :lg) %>
    </template>
  </turbo-stream>
<% end %>

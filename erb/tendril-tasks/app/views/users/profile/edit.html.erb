<%# User profile %>
<%= render TendrilTasks::Content.new(width: :large) do %>
  <%= render TendrilTasks::Breadcrumb.new do |breadcrumb| %>
    <% breadcrumb.home %>
    <% breadcrumb.item(t "breadcrumbs.profile") %>
  <% end %>

  <%= render TendrilTasks::Heading.new(t(".title"), tag: :h1) %>

  <%= render TendrilTasks::HorizontalLine.new %>

  <%# Personal data %>
  <%= render TendrilTasks::Heading.new(t(".personal_data"), tag: :h2, class: "sr-only") %>

  <div class="flex flex-nowrap gap-2">
    <%= render TendrilTasks::Avatar.new(@user, size: "2xl", class: "ms-2") %>

    <div class="ms-2 mt-2 mb-4">
      <h3
        class="
          mb-1 text-2xl lg:text-3xl font-bold leading-none md:leading-8 lg:leading-9 tracking-tight
          text-gray-900 dark:text-white
        "
      >
        <%= @user.name %>
      </h3>

      <%= render TendrilTasks::RoleBadge.new(current_user) %>
    </div>
  </div>

  <div class="space-y-4 mb-4">
    <%# E-Mail %>
    <div>
      <%= tag.label t(".your_email_address"),
                    for: "email",
                    class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>

      <div class="flex">
        <span
          class="
            inline-flex items-center px-3 text-sm text-gray-900 bg-gray-200 border rounded-e-none border-gray-300
            border-e-0 rounded-s-md dark:bg-gray-600 dark:text-gray-400 dark:border-gray-600
          "
        >
          <%=
            render Gustwave::Icon.new(
              :envelope,
              theme: :solid,
              size: :sm,
              position: :standalone,
              class: "text-gray-500 dark:text-gray-400"
            )
          %>
        </span>

        <input
          type="text"
          id="email"
          class="
            rounded-none rounded-e-lg bg-gray-50 border text-gray-900 focus:ring-blue-500 focus:border-blue-500
            block flex-1 min-w-0 w-full text-sm border-gray-300 p-2.5 dark:bg-gray-700 dark:border-gray-600
            dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500
          "
          value="<%= @user.email %>"
          readonly
        >
      </div>
    </div>

    <%# Username %>
    <div>
      <%= tag.label t(".your_rocket_chat_username",
                      brand: RocketChatConfig.branding),
                    for: "username",
                    class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>

      <div class="flex">
        <span
          class="
            inline-flex items-center px-3 text-sm text-gray-900 bg-gray-200 border rounded-e-none border-gray-300
            border-e-0 rounded-s-md dark:bg-gray-600 dark:text-gray-400 dark:border-gray-600
          "
        >
          <%=
            render Gustwave::Icon.new(
              :user_circle,
              theme: :solid,
              size: :sm,
              position: :standalone,
              class: "text-gray-500 dark:text-gray-400"
            )
          %>
        </span>

        <input
          type="text"
          id="username"
          class="
            rounded-none rounded-e-lg bg-gray-50 border text-gray-900 focus:ring-blue-500 focus:border-blue-500
            block flex-1 min-w-0 w-full text-sm border-gray-300 p-2.5 dark:bg-gray-700 dark:border-gray-600
            dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500
          "
          value="<%= @user.username %>"
          readonly
        >
      </div>
    </div>
  </div>

  <%# Data sync info ("info alert" element) %>
  <div
    class="
      flex items-center p-4 text-sm text-blue-800 border border-blue-300 rounded-lg bg-blue-50 dark:bg-gray-800
      dark:text-blue-400 dark:border-blue-800
    "
    role="alert"
  >
    <%=
      render Gustwave::Icon.new(
        :info_circle,
        theme: :solid,
        size: :sm,
        position: :standalone,
        class: "shrink-0 inline w-4 h-4 me-3"
      )
    %>

    <%= tag.span t(".info"), class: "sr-only" %>
    <%= tag.div t(".data_sync_info", brand: RocketChatConfig.branding) %>
  </div>

  <%= render TendrilTasks::HorizontalLine.new %>
  <%= render TendrilTasks::Heading.new(t(".browser_sessions"), tag: :h2) %>

  <%= form_with(
      id: "sign-out-from-all-sessions-form",
      url: destroy_user_session_path,
      method: :delete,
      class: "space-y-4"
    ) do |f| %>
    <%= render TendrilTasks::Paragraph.new(t(".sign_out_all_sessions_description")) %>
    <%= f.hidden_field :expire_all_remember_me_tokens, value: true %>

    <%= render Form::SubmitButtonGroupComponent.new(f) do |button_group| %>
      <% button_group.button(t(".sign_out_all_sessions")) %>
    <% end %>
  <% end %>

  <%= render TendrilTasks::HorizontalLine.new %>
  <%= render TendrilTasks::Heading.new(t(".user_account"), tag: :h2) %>
  <%= render TendrilTasks::Paragraph.new(t(".delete_account_description")) %>

  <%# Delete account button %>
  <%=
    render DeleteConfirm::ButtonComponent.new(
      text: t(".delete_confirm.delete_my_account_button"),
      target_modal_id: "confirm-account-deletion"
    )
  %>
<% end %>

<%= content_for :modal do %>
  <%= render DeleteConfirm::ModalComponent.new(id: "confirm-account-deletion", delete_path: profile_path) do |modal| %>
    <% modal.heading(t ".delete_confirm.modal.title") %>

    <% content = t(".delete_confirm.modal.content",
                   brand: RocketChatConfig.branding) %>

    <% paragraphize(content).each do |text| %>
      <% modal.paragraph(text) %>
    <% end %>

    <% modal.confirm_button(t(".delete_confirm.modal.confirm_button")) %>
  <% end %>
<% end %>

<%# locals: (form_object:) %>
<%= form_with model: form_object,
              url: form_object.form_path,
              method: form_object.form_method,
              class: "mx-auto space-y-4" do |f| %>
  <%= render Form::SelectComponent.new(
      f,
      :project_id,
      Project.model_name.human,
      form_object.project_options, :id, :title,
      error_field_attribute: :project,
      prompt: t(".choose_initiative")) do |project_select| %>
    <%# Creates the initiative in a modal, so the entries of this form are kept %>
    <% project_select.with_trailing_button(
         id: "new-project-button",
         **Gustwave::Modal.trigger_options("new-project-modal", action: :show)).with_content(t(".new_initiative_button")) if can?(:create, Project) %>
  <% end %>

  <%= render Form::TextFieldComponent.new(f, :title) %>

  <%= render Form::RichTextAreaComponent.new(f, :description) do |with| %>
    <% with.disabled_buttons(:heading1, :heading2, :heading3) %>
  <% end %>

  <%= render Form::CoordinatorPickerComponent.new(f, :coordinators) %>

  <%= render Form::ToggleComponent.new(f, :publish, t(".visibility")) do |toggle| %>
    <% toggle.with_checked_state_text(t(".private")) %>
    <% toggle.with_unchecked_state_text(t(".public")) %>
  <% end %>

  <% if form_object.persisted? %>
    <%= render Form::SubmitButtonGroupComponent.new(f) do |button_group| %>
      <% button_group.with_button_delete(t("forms.delete"), target_modal_id: "confirm-task-delete") %>
      <% button_group.with_button_regular(t("forms.update")) %>
    <% end %>
  <% else %>
    <%= render Form::SubmitButtonGroupComponent.new(f) do |button_group| %>
      <% button_group.with_button_regular(t("forms.create"), value: "save") %>
      <% button_group.with_button_regular(t(".save_and_new"), value: "save_and_new") %>
    <% end %>
  <% end %>
<% end %>

<% if can?(:create, Project) %>
  <%= content_for :modal do %>
    <%= render "tasks/projects/modal", project_form: ProjectForm.new(publish: true) %>
  <% end %>
<% end %>

<%= content_for :modal do %>
  <%= render DeleteConfirm::ModalComponent.new(
      id: "confirm-task-delete",
      delete_path: form_object.form_path) do |modal| %>
    <% modal.with_heading(t(".delete_confirm.modal.title")) %>

    <% paragraphize(t(".delete_confirm.modal.content")).each do |text| %>
      <% modal.with_body_element_paragraph(text) %>
    <% end %>
  <% end %>
<% end %>

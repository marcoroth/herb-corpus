<%# Modal to create an initiative without leaving the task form %>
<%= render Modal::ShellComponent.new(
      "new-project-modal",
      data: {
        controller: "modal-form dim-backdrop",
        action: "turbo:submit-end->modal-form#hideOnSuccess"
      }) do |shell| %>
  <% shell.with_heading t(".title") %>

  <%= render "tasks/projects/form", project_form: project_form %>
<% end %>

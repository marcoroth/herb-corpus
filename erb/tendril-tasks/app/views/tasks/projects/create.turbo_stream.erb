<% if @project_form.persisted? %>
  <%# Selects the new initiative in the task form %>
  <%= turbo_stream.update "task_form_project_id" do %>
    <%= options_from_collection_for_select(TaskForm.new.project_options, :id, :title, @project_form.project.id) %>
  <% end %>

  <%# Resets the modal for the next initiative %>
  <%= turbo_stream.replace "new-project-form" do %>
    <%= render "tasks/projects/form", project_form: ProjectForm.new(publish: true) %>
  <% end %>

  <%= render TurboStream::NotificationComponent.new(toast_message_for(@project_form.project, :create)) %>
<% else %>
  <%= turbo_stream.replace "new-project-form" do %>
    <%= render "tasks/projects/form", project_form: @project_form %>
  <% end %>
<% end %>

<%# locals: (application:, task:) %>
<%= render TendrilTasks::Heading
             .new(tag: :h3,
                  scheme: :level3,
                  id: "apply-now")
             .with_content(t ".apply_here") %>

<%= render TendrilTasks::Paragraph.new do %>
  <%= t(".procedure_and_motivation") %>
<% end %>

<%# Keep the submitted comment and its errors if the application was invalid %>
<%= form_with model: application&.new_record? ? application : TaskApplication.new,
              url: task_application_path(task),
              class: "mx-auto space-y-4" do |f| %>
  <%= render Form::TextAreaComponent.new(f,
                                         :comment,
                                         t("activerecord.attributes.task_application.comment"),
                                         rows: 8,
                                         maxlength: TaskApplication::COMMENT_MAX_LENGTH) %>

  <%= render Form::SubmitButtonGroupComponent.new(f) do |button_group| %>
    <% button_group.button(t(".submit"), value: "save") %>
  <% end %>
<% end %>

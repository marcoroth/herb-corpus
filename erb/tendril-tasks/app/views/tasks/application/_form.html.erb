<%#
  The current user's application for the task, or `nil` if they haven't applied.
  An unsaved application shows its validation errors.
%>
<%# locals: (task:, application:) %>
<div id="task-application">
  <%#
    User has applied
    - within the grace period they can edit their entry
    - after the grace period has passed they can withdraw their entry
  %>

  <% if application&.persisted? && !application.withdrawn? %>
    <%= render "tasks/application/form_when_user_has_applied_to_task",
               application: application,
               task: task %>
    <%# User has not yet applied or withdrawn %>
  <% else %>
    <%= render "tasks/application/form_when_user_has_not_applied_to_task",
               application: application,
               task: task %>
  <% end %>
</div>

<% if @application.persisted? %>
  <%# Update the application section %>
  <turbo-stream action="replace" method="morph" target="task-application">
    <template>
      <%= render partial: "tasks/application/form", locals: { task: @application.task, application: @application } %>
    </template>
  </turbo-stream>

  <%# Update application entry %>
  <turbo-stream action="prepend" target="task-applications-list">
    <template>
      <%= render TendrilTasks::Tasks::Application.new(@application) %>
    </template>
  </turbo-stream>

  <%# Celebrate the user's contribution instead of a notification %>
  <turbo-stream action="append" target="notifications">
    <template>
      <%= render partial: "tasks/application/fireworks" %>
    </template>
  </turbo-stream>
<% else %>
  <%# Show the validation errors %>
  <turbo-stream action="replace" method="morph" target="task-application">
    <template>
      <%= render partial: "tasks/application/form", locals: { task: @task, application: @application } %>
    </template>
  </turbo-stream>
<% end %>

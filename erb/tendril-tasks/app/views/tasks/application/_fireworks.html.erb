<%#
  Fireworks over a dimmed backdrop. Toward the end of the animation, a thank you
  modal fades in near the bottom center. The backdrop lets clicks through.
%>
<%# locals: () %>

<div
  data-controller="fireworks"
  data-fireworks-rockets-value="50"
  data-action="keydown.esc@window->fireworks#stop"
  class="fixed inset-0 z-50 pointer-events-none opacity-0 bg-gray-900/80 dark:bg-gray-900/80"
>
  <canvas data-fireworks-target="canvas" class="w-screen h-screen" aria-hidden="true"></canvas>

  <section
    role="status"
    data-fireworks-target="modal"
    class="
      opacity-0 absolute bottom-8 left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] max-w-md bg-white rounded-lg
      shadow-sm dark:bg-gray-700
    "
  >
    <div class="p-4 md:p-5 space-y-4">
      <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
        <%= t ".thanks_for_your_commitment" %>
      </h3>

      <%= render Modal::ParagraphComponent.new(t(".well_get_in_touch")) %>
    </div>
  </section>
</div>

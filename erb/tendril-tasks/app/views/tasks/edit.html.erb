<% content_for :title, t("forms.headings.edit", thing: @task_form.task.title_in_database) %>

<%= render TendrilTasks::Content.new(width: :large) do %>
  <%= render TendrilTasks::Breadcrumb.new do |breadcrumb| %>
    <% breadcrumb.with_home %>
    <% breadcrumb.with_item(Task.model_name.human(count: 2), href: tasks_path) %>
    <% breadcrumb.with_item(@task_form.title, href: task_path(@task_form.task)) %>
    <% breadcrumb.with_item(t("breadcrumbs.edit")) %>
  <% end %>

  <%= render TendrilTasks::Heading
               .new(tag: :h1)
               .with_content(t(".edit_task")) %>

  <%= render 'form', form_object: @task_form %>
<% end %>

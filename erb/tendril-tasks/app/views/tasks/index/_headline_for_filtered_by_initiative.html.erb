<%# locals: (count:, project:) %>
<%# Renders the headline when the index page is filtered by an initiative %>
<%= render TendrilTasks::Heading.new(tag: :h1,
                                     size: :lg,
                                     class: "font-extrabold text-center") do %>
  <%= render ::Text::Highlight::GradientComponent
               .new(t(".title",
                      count: count,
                      initiative: project.title),
                    highlight: project.title) %>
<% end %>

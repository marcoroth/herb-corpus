<%# locals: () %>
<div
  class="
    p-4 space-y-4 border border-dashed border-yellow-400 rounded-lg bg-yellow-50
    dark:bg-gray-700 dark:border-yellow-600
  "
>
  <%= render TendrilTasks::Paragraph.new(size: :sm) do %>
    <%= t(".hint") %>
  <% end %>

  <%= form_with url: dev_user_session_path, class: "space-y-4", data: { turbo: false } do |f| %>
    <%= render Form::SelectComponent.new(
      f,
      :user_id,
      t(".user_label"),
      User.order(:name, :username),
      :id,
      ->(user) { "#{user.name} (#{user.username}, #{user.role})" },
      prompt: t(".choose_user"),
    ) %>

    <%= render Gustwave::Button.new(type: :submit,
                                    size: :lg,
                                    class: "w-full justify-center") do %>
      <%= t(".submit_button") %>
    <% end %>
  <% end %>
</div>

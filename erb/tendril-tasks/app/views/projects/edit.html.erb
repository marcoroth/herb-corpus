<% content_for :title, t("forms.headings.edit", thing: @project_form.project.title_in_database) %>

<%= render TendrilTasks::Content.new(width: :large) do %>
  <%= render TendrilTasks::Breadcrumb.new do |breadcrumb| %>
    <% breadcrumb.with_home %>
    <% breadcrumb.with_item(Project.model_name.human(count: 2), href: projects_path) %>
    <% breadcrumb.with_item(@project_form.title, href: project_path(@project_form.project)) %>
    <% breadcrumb.with_item(t("forms.edit")) %>
  <% end %>

  <%= render TendrilTasks::Heading
               .new(tag: :h1)
               .with_content(t ".title") %>

  <%= render 'form', form_object: @project_form %>
<% end %>

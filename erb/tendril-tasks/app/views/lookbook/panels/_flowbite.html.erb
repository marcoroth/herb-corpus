<%# locals: (target:, **) %>
<div style="padding:1rem">
  <p>Reproduces these Flowbite examples:</p>

  <ul>
    <% Gustwave::FlowbiteCoverage.current.for_scenario(target.lookup_path).each do |example| %>
      <li>
        <%= link_to example.title, example.docs_url, style: "text-decoration:underline" %>
        <small>(<%= example.page %>)</small>
        <%= render "lookbook/flowbite/status", status: example.status, text: example.status_label %>
      </li>
    <% end %>
  </ul>
</div>

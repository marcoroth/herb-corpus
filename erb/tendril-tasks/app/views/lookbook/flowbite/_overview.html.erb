<% coverage = Gustwave::FlowbiteCoverage.current %>
<% statuses = Gustwave::FlowbiteCoverage::STATUSES %>
<% totals = coverage.totals %>

<p>
  How much of Flowbite <%= coverage.version %> Gustwave covers. <strong><%= coverage.possible_count %></strong> of
  <%= coverage.in_scope_count %> in-scope examples are possible today, and
  <strong><%= totals.fetch("previewed") %></strong> have a preview that shows it. Only a preview is proof: the other
  statuses are a judgment from the components' options and slots.
</p>

<h2>Totals</h2>

<table>
  <thead>
    <tr>
      <% statuses.each do |status, text| %>
        <th><%= render "lookbook/flowbite/status", status:, text: %></th>
      <% end %>
    </tr>
  </thead>

  <tbody>
    <tr>
      <% statuses.each_key do |status| %>
        <td><%= totals.fetch(status) %></td>
      <% end %>
    </tr>
  </tbody>
</table>

<h2>Pages</h2>

<table>
  <thead>
    <tr>
      <th>Page</th>
      <th>Examples</th>

      <% statuses.each_value do |text| %>
        <th><%= text %></th>
      <% end %>
    </tr>
  </thead>

  <tbody>
    <% coverage.page_keys.each do |key| %>
      <tr>
        <td><%= link_to key, Lookbook::Engine.pages.find_by_path("flowbite/#{key.tr("-", "_")}").docs_path %></td>
        <td><%= coverage.examples(key).size %></td>

        <% coverage.totals(key).each_value do |count| %>
          <td><%= count unless count.zero? %></td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>

<h2>What's missing</h2>

<p>By the examples waiting for it. An example is only unlocked once all of its needs are met.</p>

<table>
  <thead>
    <tr>
      <th>Needs</th>
      <th>Examples</th>
      <th>Pages</th>
    </tr>
  </thead>

  <tbody>
    <% coverage.gaps.each do |gap| %>
      <tr>
        <td><code><%= gap[:need] %></code></td>
        <td><%= gap[:count] %></td>
        <td><%= gap[:pages].size %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%# locals: (status:, text:) %>
<% colors = {
     "previewed" => "#dcfce7;color:#166534",
     "composable" => "#dbeafe;color:#1e40af",
     "tailwind" => "#e0e7ff;color:#3730a3",
     "feature_gap" => "#fef9c3;color:#854d0e",
     "partial" => "#ffedd5;color:#9a3412",
     "blocked" => "#fee2e2;color:#991b1b",
     "out_of_scope" => "#f3f4f6;color:#374151"
   } %>

<span
  style="background:<%= colors.fetch(status) %>;border-radius:4px;font-size:12px;font-weight:500;padding:2px 8px;white-space:nowrap"
>
  <%= text %>
</span>

<%# locals: (key:) %>
<% coverage = Gustwave::FlowbiteCoverage.current %>

<p>
  <%= link_to "Flowbite docs", coverage.docs_url(key) %> (latest release) ·
  <%= link_to "Source at #{coverage.version}", coverage.source_url(key) %>
</p>

<% coverage.examples(key).each do |example| %>
  <section style="margin-top:2rem">
    <h3 style="align-items:center;display:flex;gap:.5rem;margin:0 0 .5rem">
      <%= example.title %>
      <%= render "lookbook/flowbite/status", status: example.status, text: example.status_label %>
    </h3>

    <p style="margin:0 0 .5rem"><%= link_to "View on Flowbite", example.docs_url %></p>

    <% if example.needs %>
      <p style="margin:0 0 .5rem">Needs <code><%= example.needs %></code>.</p>
    <% elsif example.status == "composable" %>
      <p style="margin:0 0 .5rem">Existing components can build this, but no preview shows it yet.</p>
    <% elsif example.status == "tailwind" %>
      <p style="margin:0 0 .5rem">Plain Tailwind classes cover this, so there is no component.</p>
    <% elsif example.status == "out_of_scope" %>
      <p style="margin:0 0 .5rem">This wraps a third-party library, which Gustwave doesn't implement.</p>
    <% end %>

    <% if example.note %>
      <p style="margin:0 0 .5rem"><%= example.note %></p>
    <% end %>

    <% if example.preview %>
      <%= embed example.preview_path.to_sym, example.scenario, params: example.params.to_h %>
    <% end %>
  </section>
<% end %>

<%= render Dossiers::ExternalChampComponent.new(data: rows, source:) do |c| %>
  <% if @with_header %>
    <% c.with_header do %>
      <%= render Dsfr::AlertComponent.new(
        state: :info,
        with_prefix: false,
        extra_class_names: 'fr-mb-2w clearfix'
      ) do |c| %>
        <% c.with_body do %>
          <%= data.present? ? t('.external_champ.header') : t('.external_champ.waiting_banner') %>
        <% end %>
      <% end %>

      <% if data.present? %>
        <div
          class="fr-text--bold fr-mb-2w"
          data-controller="external-data-refresh"
        >
          <%= t(
            '.external_champ.data_retrieval_date',
            updated_at: I18n.l(@champ.updated_at, format: :long_with_time)
          ) %>

          <%= hidden_field_tag(
            "#{@champ.input_name}[refresh_external_data]",
            "",
            data: { external_data_refresh_target: "refreshDataInput" }
          ) %>

          <%= button_tag(
            type: "button",
            id: "refresh-data-button-champ-#{@champ.id}",
            class: "fr-btn fr-btn--tertiary-no-outline fr-btn--sm fr-btn--icon-left fr-icon-refresh-line",
            data: {
              action: "external-data-refresh#trigger",
              external_data_refresh_target: "refreshButton"
            },
            disabled: refresh_disabled?,
            aria: (refresh_disabled? ? { describedby: "tooltip-refresh-#{@champ.id}" } : nil)
          ) do %>
            <%= t('.external_champ.button_refresh') %>
          <% end %>

          <% if refresh_disabled? %>
            <span
              class="fr-tooltip fr-placement"
              id="tooltip-refresh-<%= @champ.id %>"
              role="tooltip"
            >
              <%= t('.external_champ.refresh_disabled_hint') %>
            </span>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if render_libelle? %>
  <% if @row_number.present? %>
    <strong>[<%= @row_number %>]</strong>
  <% end %>
  <%= @champ.libelle %>
  <% if @champ.mandatory? %>
    <%= render EditableChamp::AsteriskMandatoryComponent.new %>
  <% end %>
<% end %>

<% if @champ.buffer_stream? %>
  <span class="updated-at highlighted">
    <% if @champ.user_buffer_stream? %>
      <%= t(".changes_to_submit") %>
    <% else %>
      <%= t(".changes_to_save") %>
    <% end %>
  </span>
<% elsif @champ.updated_at.present? && @seen_at.present? %>
  <span class="updated-at <%= highlight_if_unseen_class %>">
    <%= t(".modified_at", datetime: try_format_datetime(@champ.updated_at)) %>
  </span>
<% end %>

<% if rebased? %>
  <span class="updated-at highlighted"><%= t(".check_content_rebased") %></span>
<% end %>

<% hints_for_champ.each do |hint| %>
  <span class="fr-hint-text" <%= tag.attributes(data: (hint[:controller] ? { controller: hint[:controller] } : {})) %>><%= hint[:text] %></span>
<% end %>

<% if for_preview? %>
  <div class="fr-fieldset">
    <div class="fr-fieldset__legend--regular fr-fieldset__legend">
      <%= t('.admin.scenario_question') %>
    </div>

    <div class="fr-fieldset__element fr-fieldset__element--inline">
      <div class="fr-radio-group fr-radio-rich">
        <%= @form.radio_button :preview_state, 'fetched_preview',
          id: "#{@champ.stable_id}_fetched",
          aria: labelledby_id_attr(input_label_id(@champ, :fetched)) %>

        <label
          class="fr-label"
          for="<%= "#{@champ.stable_id}_fetched" %>"
          id="<%= input_label_id(@champ, :fetched) %>"
        >
          <%= t('.admin.data_fetched') %>
        </label>
      </div>
    </div>

    <div class="fr-fieldset__element fr-fieldset__element--inline">
      <div class="fr-radio-group fr-radio-rich">
        <%= @form.radio_button :preview_state, 'not_fetched_preview',
          id: "#{@champ.stable_id}_not_fetched",
          aria: labelledby_id_attr(input_label_id(@champ, :not_fetched)) %>

        <label
          class="fr-label"
          for="<%= "#{@champ.stable_id}_not_fetched" %>"
          id="<%= input_label_id(@champ, :not_fetched) %>"
        >
          <%= t('.admin.data_not_fetched') %>
        </label>
      </div>
    </div>
  </div>
<% end %>

<label
  class="fr-label"
  for="<%= @champ.focusable_input_id %>"
  id="<%= input_label_id(@champ) %>"
>
  <%= render EditableChamp::ChampLabelContentComponent.new(
    form: @form,
    champ: @champ,
    seen_at: @seen_at,
    row_number: @row_number
  ) %>
</label>

<% if render_external_champ? %>
  <% if for_preview? %>
    <p><%= t(".admin.preview_simulation.#{@champ.type_champ}") %></p>
  <% end %>
  <div class="fr-mb-2w"><%= render external_data_component %></div>
  <% if fetched? || for_preview? %>
    <div class="fr-fieldset">
      <div class="fr-fieldset__legend--regular fr-fieldset__legend">
        <%= t('.external_champ.confirmation.question') %>
        <%= render EditableChamp::AsteriskMandatoryComponent.new %>
      </div>

      <div class="fr-fieldset__element fr-fieldset__element--inline">
        <div class="fr-radio-group">
          <%= @form.radio_button :value, true,
            id: "#{@champ.stable_id}_correct",
            aria: labelledby_id_attr(input_label_id(@champ, :correct)) %>

          <label
            class="fr-label"
            for="<%= "#{@champ.stable_id}_correct" %>"
            id="<%= input_label_id(@champ, :correct) %>"
          >
            <%= t('.external_champ.confirmation.true') %>
          </label>
        </div>
      </div>

      <div class="fr-fieldset__element fr-fieldset__element--inline">
        <div class="fr-radio-group">
          <%= @form.radio_button :value, false,
            id: "#{@champ.stable_id}_incorrect",
            aria: labelledby_id_attr(input_label_id(@champ, :incorrect)) %>

          <label
            class="fr-label"
            for="<%= "#{@champ.stable_id}_incorrect" %>"
            id="<%= input_label_id(@champ, :incorrect) %>"
          >
            <%= t('.external_champ.confirmation.false') %>
          </label>
        </div>
      </div>
    </div>
  <% end %>
  <% if render_data_incorrect_callout? %>
    <div class="fr-callout fr-callout--yellow-moutarde">
      <div class="fr-callout__text">
        <%= t('.external_champ.incorrect_qf_data', justificatif_label:) %>
      </div>
    </div>
  <% end %>
<% end %>

<% if render_piece_justificative_champ? %>
  <% if @champ.external_error? %>
    <%= render Dsfr::NoticeComponent.new(
      closable: false,
      data_attributes: {
        "data-notice-name" => "donnees-qf-non-trouvees",
        class: 'fr-mb-1w'
      }
    ) do |c| %>
      <% c.with_title do %>
        <%= t(
          @champ.fc_data_not_found? ?
            '.piece_justificative_champ.data_not_found' :
            '.piece_justificative_champ.data_not_recovered',
          justificatif_label:
        ) %>
      <% end %>
    <% end %>
  <% end %>
  <%= justificatif_label.upcase_first %>
  <%= render EditableChamp::AsteriskMandatoryComponent.new %>
  <%= render Attachment::FileFieldComponent.new(
    context: Attachment::Context.new(
      champ: @champ,
      form_object_name: @form.object_name,
      aria_labelledby: labelledby_id
    ),
    max: 1,
    drop_zone: :integrated
  ) %>
<% end %>

<div class="champ-row">
  <dt class="champ-label">
    <%= label %>
    <%= render Dossiers::ChampUpdatedComponent.new(updated_at:, seen_at:) %>
  </dt>

  <% if blank? -%>
    <dd class="champ-content fr-text-mention--grey <%= content_class %>">
      <% if usager? -%>
        <p class="champ-blank"><%= blank %></p>
      <% end -%>
    </dd>
  <% else -%>
    <dd class="champ-content copy-zone <%= content_class %>"><%= value %></dd>
  <% end -%>
</div>

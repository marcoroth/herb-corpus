<div class="champ-row">
  <p class="champ-label">
    <% if label.present? -%>
      <%= t(".label_text", label:) %>
    <% end -%>

    <%= render Dossiers::ChampUpdatedComponent.new(updated_at:, updated_by:, source_stream:, seen_at:) %>
  </p>

  <% if blank? -%>
    <div class="champ-content fr-text-mention--grey <%= content_class %>">
      <% if usager? -%>
        <p class="champ-blank"><%= blank %></p>
      <% end -%>
    </div>
  <% else -%>
    <div class="champ-content <%= content_class %>"><%= value %></div>
  <% end -%>
</div>

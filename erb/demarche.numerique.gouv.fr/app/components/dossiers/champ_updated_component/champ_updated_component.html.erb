<span style="display: inline-flex" class="champ-updated">
  <span class="fr-ml-3v <%= badge_updated_class %>">
    <%= t('.updated_at', datetime: helpers.try_format_datetime(updated_at, format: :veryshort), source:) %>
  </span>

  <% if updated_by_instructeur? %>
    <button
      class="
        fr-btn--tooltip fr-icon-information-line fr-btn--sm
        fr-btn--tertiary-no-outline fr-pl-1v
      "
      type="button"
      aria-describedby="<%= tooltip_id %>"
      aria-label="<%= t('.updated_by') %>"
    ></button>
    <span
      class="fr-tooltip fr-placement"
      id="<%= tooltip_id %>"
      role="tooltip"
      aria-hidden="true"
    >
      <%= updated_by %>
    </span>
  <% end %>
</span>

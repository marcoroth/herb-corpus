<%= helpers.turbo_stream.replace 'autosave-notice' do %>
  <div
    id="autosave-notice"
    class="fr-badge fr-badge--sm <%= class_names("fr-badge--success" => success?, "fr-badge--error" => !success?) %>"
  >
    <%= label %>
  </div>
<% end %>

<%= helpers.turbo_stream.show 'autosave-notice' %>
<%= helpers.turbo_stream.hide 'autosave-notice', delay: 15000 %>

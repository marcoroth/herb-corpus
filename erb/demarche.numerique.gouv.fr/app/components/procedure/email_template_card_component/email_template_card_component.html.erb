<div class="fr-grid-row border-grey">
  <div class="fr-col-12 fr-col-md-6 fr-py-3w fr-px-4w flex column justify-between">
    <div>
      <p class="<%= class_names('fr-tag', 'fr-tag--blue-ecume' => edited?) %>">
        <%= tag_label %>
      </p>

      <h2 class="fr-h6 fr-mt-2w fr-mb-1w"><%= title %></h2>

      <p class="fr-text-mention--grey"><%= subject_preview %></p>

      <% if error.present? %>
        <div
          class="fr-alert fr-alert--error fr-alert--sm fr-my-1w"
          role="alert"
        >
          <p><%= error %></p>
        </div>
      <% end %>
    </div>

    <p class="fr-mb-0">
      <% if not_editable? %>
        <a <%# herb:disable html-anchor-require-href %>
          role="link"
          aria-disabled="true"
          class="fr-link fr-icon-arrow-right-line fr-link--icon-right"
        >
          Modifier
        </a>
      <% else %>
        <%= link_to edit_path, class: 'fr-link fr-icon-arrow-right-line fr-link--icon-right' do %>
          Modifier<span class="fr-sr-only">« <%= title %> »</span>
        <% end %>
      <% end %>
    </p>
  </div>

  <div
    class="
      fr-col-12 fr-col-md-6 fr-pt-3w fr-pb-1w fr-px-4w
      fr-background-alt--blue-france
    "
  >
    <%= render SimpleFormatComponent.new(description, allow_a: false) %>
  </div>
</div>

<% content_for(:footer) do %>
  &nbsp;
<% end %>

<%= render FixedFooterComponent.new(narrow: @narrow) do |footer| %>
  <% if form %>
    <% footer.with_action do %>
      <%= link_to t('.cancel'), admin_procedure_path(id: @procedure), class: 'fr-btn fr-btn--secondary', data: { controller: 'confirm', confirm_message_value: t('.cancel_confirm'), action: 'confirm#ask' } %>
    <% end %>
    <% footer.with_action do %>
      <%= form.submit t('.submit'), class: 'fr-btn', disabled: is_form_disabled %>
    <% end %>
  <% else %>
    <div class="flex wrap align-center flex-gap-2 fr-pb-2w">
      <%= link_to t('.back'), admin_procedure_path(id: @procedure), class: 'fr-link fr-icon-arrow-left-line fr-link--icon-left' %>
      <%= content %>
    </div>
  <% end %>
<% end %>

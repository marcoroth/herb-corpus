<div class="<%= class_names('padded-fixed-footer', @extra_class_names) %>">
  <div class="fixed-footer">
    <div class="fr-container">
      <div class="fr-grid-row">
        <div class="<%= column_class_names %>">
          <% if actions? %>
            <ul class="<%= actions_class_names %>">
              <% actions.each do |action| %>
                <li><%= action %></li>
              <% end %>
            </ul>
          <% end %>

          <%= content %>
        </div>
      </div>
    </div>
  </div>
</div>

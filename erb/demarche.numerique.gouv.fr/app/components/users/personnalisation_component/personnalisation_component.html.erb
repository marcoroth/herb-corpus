<div class="fr-card fr-p-3w fr-mb-4w">
  <h2 class="fr-h6 fr-mb-1w"><%= procedure.libelle %></h2>

  <p class="fr-hint-text fr-mb-1w"><%= t('.hint') %></p>

  <react-fragment>
    <%= render ReactComponent.new "Select/MultipleSelect",
          **select_options,
          value: selected_value,
          name: field_name,
          placeholder: t('views.components.multiple_combobox'),
          emptyHint: t('.empty_hint'),
          selectedLabels: { one: t('.selected_one'), other: t('.selected_other') },
          'aria-label': t('.aria_label', libelle: procedure.libelle) %>
  </react-fragment>
</div>

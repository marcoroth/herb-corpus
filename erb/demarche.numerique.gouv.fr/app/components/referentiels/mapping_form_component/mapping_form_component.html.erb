<%= form_with(model: @type_de_champ, url: update_mapping_type_de_champ_admin_procedure_referentiel_path(@procedure, @type_de_champ.stable_id, @referentiel)) do |f| %>
  <div class="<%= bordered_container_class_names %>">
    <%= render Referentiels::ResponseRendererComponent.new(referentiel:) %>

    <section>
      <div class="fr-table fr-table--bordered">
        <div class="fr-table__wrapper">
          <div class="fr-table__container">
            <div class="fr-table__content">
              <table class="referentiel-table">
                <caption><%= t(".caption") %></caption>

                <thead>
                  <tr>
                    <th class="fr-cell--multiline fr-cell--fixed">
                      <%= t(".property") %>
                    </th>

                    <th><%= t(".example_data") %></th>
                    <th><%= t(".data_type") %></th>
                    <th><%= t(".use_data_for_prefill_html") %></th>
                    <th><%= t(".label_for_display_html") %></th>
                  </tr>
                </thead>

                <tbody>
                  <%- last_request_keys.each do |jsonpath, example_value| -%>
                    <tr data-controller="referentiel-mapping">
                      <td
                        class="fr-cell--multiline fr-cell--fixed referentiel-cell-truncate"
                        title="<%= jsonpath %>"
                      >
                        <span
                          class="hidden"
                          id="<%= label_check_prefill(jsonpath) %>"
                        >
                          <%= t(".use_for_prefill", property: jsonpath) %>
                        </span>

                        <%= jsonpath %>
                        <%= hidden_field_tag attribute_name(jsonpath, "example_value"), example_value %>
                      </td>

                      <td
                        class="fr-cell--multiline referentiel-cell-truncate"
                        title="<%= example_value %>"
                      >
                        <%= example_value %>
                      </td>

                      <td><%= cast_tag(jsonpath, example_value) %></td>
                      <td class="text-center"><%= prefill_tag(jsonpath) %></td>

                      <td>
                        <div
                          data-referentiel-mapping-target="enabledContent"
                          class="<%= 'hidden' if disabled?(jsonpath) %>"
                        >
                          <%= enabled_libelle_tag(jsonpath) %>
                        </div>

                        <div
                          data-referentiel-mapping-target="disabledContent"
                          class="<%= 'hidden' unless disabled?(jsonpath) %>"
                        >
                          <%= disabled_libelle_tag(jsonpath) %>
                        </div>
                      </td>
                    </tr>
                  <%- end -%>
                </tbody>

                <tfoot>
                  <tr>
                    <td colspan="5">
                      <%= render NestedForms::OwnedButtonComponent.new(formaction: reset_mapping_admin_procedure_referentiel_path(@procedure, @type_de_champ.stable_id, @referentiel, scope: 'all'), http_method: :delete, opt: { class: "fr-link fr-link--sm fr-icon-delete-line fr-link--icon-left", data: { turbo_confirm: t(".confirm_reset_mapping") } }) do %>
                        <%= t(".reset_mapping") %>
                      <% end %>
                    </td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="clearfix"></div>
  </div>

  <ul class="fr-btns-group fr-btns-group--inline-sm flex justify-center fr-mt-5w">
    <li>
      <%= link_to t(".cancel"), champs_admin_procedure_path(@procedure), class: 'fr-btn fr-btn--secondary fr-mr-3w' %>
    </li>

    <li>
      <%= link_to t(".previous_step"), back_url, class: 'fr-btn fr-btn--secondary' %>
    </li>

    <li><%= f.submit t(".next_step"), class: "fr-btn" %></li>
  </ul>
<% end %>

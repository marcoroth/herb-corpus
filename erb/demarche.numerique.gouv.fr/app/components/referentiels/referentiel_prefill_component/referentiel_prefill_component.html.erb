<div class="fr-table fr-table--bordered">
  <div class="fr-table__wrapper">
    <div class="fr-table__container">
      <div class="fr-table__content">
        <table class="referentiel-table">
          <caption class="fr-text--regular fr-text--sm">
            <%= t(".caption") %>
          </caption>

          <thead>
            <tr>
              <th class="fr-cell--fixed" role="columnheader">
                <%= t(".property") %>
              </th>

              <th scope="col"><%= t(".example_data") %></th>
              <th scope="col"><%= t(".data_type") %></th>
              <th scope="col"><%= t(".prefill_field") %></th>
            </tr>
          </thead>

          <tbody>
            <%- referentiel_mapping_prefillable.sort.each do |jsonpath, mapping_opts| -%>
              <tr>
                <td
                  class="fr-cell--multiline fr-cell--fixed referentiel-cell-truncate"
                  title="<%= jsonpath %>"
                >
                  <%= jsonpath %>
                </td>

                <td
                  class="fr-cell--multiline referentiel-cell-truncate"
                  title="<%= mapping_opts[:example_value] %>"
                >
                  <%= mapping_opts[:example_value] %>
                </td>

                <td><%= mapping_opts[:type] %></td>
                <td><%= prefill_stable_id_tag(jsonpath, mapping_opts) %></td>
              </tr>
            <%- end -%>
          </tbody>

          <tfoot>
            <tr>
              <td colspan="4">
                <%= render NestedForms::OwnedButtonComponent.new(formaction: reset_mapping_admin_procedure_referentiel_path(procedure, type_de_champ.stable_id, referentiel, scope: 'prefill'), http_method: :delete, opt: { class: "fr-link fr-link--sm fr-icon-delete-line fr-link--icon-left", data: { turbo_confirm: t(".confirm_reset_prefill") } }) do %>
                  <%= t(".reset_prefill") %>
                <% end %>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>
</div>

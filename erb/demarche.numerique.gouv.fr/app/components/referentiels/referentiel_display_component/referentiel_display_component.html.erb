<div class="fr-table fr-table--bordered">
  <div class="fr-table__wrapper">
    <div class="fr-table__container">
      <div class="fr-table__content">
        <table class="referentiel-table">
          <caption class="fr-text--regular fr-text--sm">
            <%= t(".caption") %>
          </caption>

          <thead>
            <tr>
              <th class="fr-cell--fixed" role="columnheader">
                <%= t(".property") %>
              </th>

              <th><%= t(".example_data") %></th>
              <th><%= t(".data_type") %></th>
              <th><%= t(".label") %></th>

              <%- unless type_de_champ.private? -%>
                <th><%= t(".display_usager") %></th>
              <%- end -%>

              <th><%= t(".display_instructeur") %></th>
            </tr>
          </thead>

          <tbody>
            <%- display_mapping.sort.each do |jsonpath, mapping_opts| -%>
              <tr>
                <td
                  class="fr-cell--multiline fr-cell--fixed referentiel-cell-truncate"
                  title="<%= jsonpath %>"
                >
                  <%= jsonpath %>
                </td>

                <td
                  class="fr-cell--multiline referentiel-cell-truncate"
                  title="<%= mapping_opts[:example_value] || mapping_opts["example_value"] %>"
                >
                  <%= mapping_opts[:example_value] || mapping_opts["example_value"] %>
                </td>

                <td><%= mapping_opts[:type] || mapping_opts["type"] %></td>

                <td>
                  <%= mapping_opts[:libelle] || mapping_opts["libelle"] %>
                </td>

                <%- unless type_de_champ.private? -%>
                  <td class="text-center">
                    <%= display_tag_for(jsonpath, "display_usager") %>
                  </td>
                <%- end -%>

                <td class="text-center">
                  <%= display_tag_for(jsonpath, "display_instructeur") %>
                </td>
              </tr>
            <%- end -%>
          </tbody>

          <tfoot>
            <tr>
              <td colspan="<%= type_de_champ.private? ? 5 : 6 %>">
                <%= render NestedForms::OwnedButtonComponent.new(formaction: reset_mapping_admin_procedure_referentiel_path(procedure, type_de_champ.stable_id, referentiel, scope: 'display'), http_method: :delete, opt: { class: "fr-link fr-link--sm fr-icon-delete-line fr-link--icon-left", data: { turbo_confirm: t(".confirm_reset_display") } }) do %>
                  <%= t(".reset_display") %>
                <% end %>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>
</div>

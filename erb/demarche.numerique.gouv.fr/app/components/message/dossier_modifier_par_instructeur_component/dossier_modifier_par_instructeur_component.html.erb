<p>[<%= t('.subject', dossier_number:, demarche_title:) %>]</p>

<p><%= t('.greeting') %></p>

<p>
  <% if changed_columns.present? %>
    <%= t('.body_with_known_changes', dossier_number:, demarche_title:) %>
  <% else %>
    <%= t('.body_with_unknown_changes', dossier_number:, demarche_title:) %>
  <% end %>
</p>

<%= render Dossiers::ChangesComponent.new(changed_columns:) %>

<% if motivation.present? %>
  <p><%= motivation %></p>
<% end %>

<p><%= t('.farewell_html', service_name:) %></p>

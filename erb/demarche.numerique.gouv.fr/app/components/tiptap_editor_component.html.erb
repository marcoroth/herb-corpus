<div class="fr-input-group <%= 'fr-input-group--error' if errors? %>" <%= tag.attributes(data: data_attributes) %>>
  <label class="fr-label fr-h4" for="<%= editor_id %>"><%= label %></label>

  <% if toolbar? %>
    <div class="flex flex-gap-2 fr-mb-2w">
      <div class="flex flex-gap-1">
        <% simple_buttons.each do |button| %>
          <button
            class="fr-btn fr-btn--secondary fr-btn--sm <%= button[:icon] %>"
            type="button"
            title="<%= button[:title] %>"
            data-action="click->tiptap#menuButton"
            data-tiptap-target="button"
            data-tiptap-action="<%= button[:action] %>"
          >
            <%= button[:label] %>
          </button>
        <% end %>
      </div>

      <% if link? %>
        <button
          class="fr-btn fr-btn--secondary fr-btn--sm fr-icon-link"
          type="button"
          title="Ajouter un lien sur le texte sélectionné"
          aria-controls="tiptap-link-modal"
          data-fr-opened="false"
          data-action="click->tiptap#menuButton"
          data-tiptap-target="button"
          data-tiptap-action="link"
        >
          Lien
        </button>
      <% end %>
    </div>
    <p class="fr-hint-text">
      Utilisez les boutons ci-dessus pour mettre en forme votre message ou
      ajouter un lien.
    </p>
  <% end %>

  <div
    id="<%= editor_id %>"
    class="tiptap-editor fr-mt-1w"
    data-tiptap-target="editor"
    <%= tag.attributes(aria: { describedby: errors_id }) if error_attribute %>
  ></div>

  <%= form.hidden_field field_name, data: { tiptap_target: 'input' }, value: input_value %>

  <% if tags? %>
    <p class="fr-hint-text fr-mt-1w">
      Tapez le caractère <strong class="fr-text-title--grey">@</strong> suivi du
      nom de la
      balise<%= collapsed_tags? ? ' pour insérer une donnée.' : ', ou cliquez sur les boutons ci-dessous.' %>
    </p>
    <% if collapsed_tags? %>
      <div class="tiptap-tags-collapse fr-mt-1w">
        <button
          type="button"
          class="
            fr-btn fr-btn--sm fr-btn--tertiary fr-btn--icon-right
            fr-icon-arrow-down-s-line tiptap-tags-collapse__toggle
          "
          aria-controls="<%= tags_collapse_id %>"
          aria-expanded="false"
        >
          Balises disponibles
        </button>

        <div class="fr-collapse" id="<%= tags_collapse_id %>">
          <div class="tags-buttons-panel fr-mt-1w">
            <%= render TagsButtonListComponent.new(tags: tags) %>
          </div>
        </div>
      </div>
    <% else %>
      <p class="fr-h6 fr-mt-2w fr-mb-1w">Balises disponibles</p>
      <div class="tags-buttons-panel">
        <%= render TagsButtonListComponent.new(tags: tags) %>
      </div>
    <% end %>
  <% end %>

  <% if error_attribute %>
    <div
      class="fr-error-text <%= 'hidden' unless errors? %>"
      id="<%= errors_id %>"
    >
      <% if errors? %>
        <%= render partial: "shared/errors_list", locals: { object: form.object, attribute: error_attribute } %>
      <% end %>
    </div>
  <% end %>

  <% if link? %>
    <dialog
      id="tiptap-link-modal"
      class="fr-modal"
      role="dialog"
      aria-labelledby="tiptap-link-modal-title"
      data-tiptap-target="linkModal"
    >
      <div class="fr-container fr-container--fluid fr-container-md">
        <div class="fr-grid-row fr-grid-row--center">
          <div class="fr-col-12 fr-col-md-6">
            <div class="fr-modal__body">
              <div class="fr-modal__header">
                <button
                  class="fr-btn--close fr-btn"
                  type="button"
                  aria-controls="tiptap-link-modal"
                  title="<%= t('utils.modal_close_alt') %>"
                >
                  <%= t('utils.modal_close') %>
                </button>
              </div>

              <div class="fr-modal__content">
                <h1 id="tiptap-link-modal-title" class="fr-modal__title">
                  <span class="fr-icon-link fr-mr-1v" aria-hidden="true"></span>
                  Insérer un lien
                </h1>

                <div data-tiptap-target="linkFormContent">
                  <p class="fr-text--sm fr-mb-2w">
                    Intitulé du lien :
                    <strong data-tiptap-target="linkSelectedText"></strong>
                  </p>

                  <div
                    class="fr-input-group"
                    data-tiptap-target="linkInputGroup"
                  >
                    <label class="fr-label" for="tiptap-link-url-input">
                      Adresse du lien
                      <span class="fr-hint-text">Indiquer l’url cible du lien. Exemple : https://jeunes.gouv.fr</span>
                    </label>

                    <input
                      class="fr-input fr-mt-1w"
                      type="url"
                      id="tiptap-link-url-input"
                      data-tiptap-target="linkUrlInput"
                      data-action="keydown.enter->tiptap#confirmLink input->tiptap#updateRemoveLinkButtonState"
                      autocomplete="url"
                    >

                    <p
                      class="fr-error-text fr-hidden"
                      data-tiptap-target="linkErrorText"
                    >
                      L’adresse du lien doit commencer par https://
                    </p>
                  </div>
                </div>
              </div>

              <div class="fr-modal__footer">
                <div class="flex width-100 justify-between items-center">
                  <button
                    class="
                      fr-btn fr-btn--secondary fr-btn--icon-left
                      fr-icon-delete-line
                    "
                    type="button"
                    disabled
                    data-action="click->tiptap#clearLinkInput"
                    data-tiptap-target="removeLinkButton"
                  >
                    Supprimer le lien
                  </button>

                  <div class="fr-btns-group fr-btns-group--inline fr-btns-group--inline-lg">
                    <button
                      class="fr-btn fr-btn--secondary"
                      type="button"
                      data-action="click->tiptap#closeLinkModal"
                    >
                      Annuler
                    </button>

                    <button
                      class="fr-btn"
                      type="button"
                      data-action="click->tiptap#confirmLink"
                      data-tiptap-target="linkConfirmButton"
                    >
                      Créer le lien
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </dialog>
  <% end %>
</div>

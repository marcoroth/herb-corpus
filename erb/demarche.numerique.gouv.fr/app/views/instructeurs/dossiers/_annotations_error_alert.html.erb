<%= tag.div id: "alert-error-annotation", class: class_names("hidden" => local_assigns[:hidden]) do %>
  <%= render Dsfr::AlertComponent.new(state: :error, title: nil, size: :sm, extra_class_names: "fr-mt-2w") do |c| %>
    <% c.with_body do %>
      <p><%= t("instructeurs.dossiers.alert_error_annotations_html") %></p>

      <ul class="fr-mb-0 list-style-type-disc">
        <% invalid_annotations_libelles(dossier).each do |libelle| %>
          <li><%= libelle %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
<% end %>

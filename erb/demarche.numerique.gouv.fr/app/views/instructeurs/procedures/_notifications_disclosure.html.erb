<% display ||= 'false' %>
<% notifications ||= {} %>

<div class="flex column" id="notifications-disclosure-<%= procedure_id %>">
  <%= button_to t("instructeurs.procedures.notifications_button.notifications_details"),
        instructeur_procedure_display_notifications_path(procedure_id),
        method: :get,
        params: { display: (display == 'true' ? 'false' : 'true') },
        form: { data: { turbo: true, turbo_stream: true } },
        class: "fr-btn fr-btn--tertiary-no-outline fr-btn--icon-right fr-btn--sm #{display == 'true' ? 'fr-icon-arrow-up-s-line' : 'fr-icon-arrow-down-s-line'}",
        id: "notifications-button-#{procedure_id}",
        "aria-expanded": (display == 'true').to_s %>

  <div
    class="fr-container order-first fr-my-1w fr-px-0"
    id="notifications-container-<%= procedure_id %>"
  >
    <% if display == 'true' %>
      <%= render partial: 'instructeurs/procedures/notifications_list_body', locals: { notifications:, procedure_id: } %>
    <% end %>
  </div>
</div>

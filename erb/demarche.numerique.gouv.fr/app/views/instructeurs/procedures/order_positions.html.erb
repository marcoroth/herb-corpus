<% content_for(:title, t('.title')) %>

<div class="fr-container fr-mt-6w fr-mb-15w">
  <%= link_to t('.back_to_procedures'), instructeur_procedures_path, class: 'fr-link fr-icon-arrow-left-line fr-link--icon--left fr-icon--sm' %>

  <h3 class="fr-my-3w"><%= t('.heading_html', count: @procedures.size) %></h3>

  <p><%= t('.description') %></p>

  <fr-container data-controller="move-cards-position">
    <%= form_tag update_order_positions_instructeur_procedures_path, method: :patch, id: 'order-instructeur-procedures-form' do %>
      <% @procedures.each do |procedure| %>
        <div class="fr-card fr-mb-1w fr-py-1w fr-px-2w">
          <div class="flex align-center">
            <button
              class="fr-btn fr-icon-arrow-up-line fr-btn--secondary fr-col-1"
              title="<%= t('shared.order_positions.move_up') %>"
              data-action="move-cards-position#moveUp"
            >
              <span class="fr-sr-only">
                <%= t('shared.order_positions.move_up') %>
              </span>
            </button>

            <button
              class="
                fr-btn fr-icon-arrow-down-line fr-btn--secondary fr-col-1
                fr-mx-2w
              "
              title="<%= t('shared.order_positions.move_down') %>"
              data-action="move-cards-position#moveDown"
            >
              <span class="fr-sr-only">
                <%= t('shared.order_positions.move_down') %>
              </span>
            </button>

            <% if procedure.close? %>
              <span class="fr-badge fr-mr-2w"><%= t('.status_close') %></span>
            <% elsif procedure.depubliee? %>
              <span class="fr-badge fr-mr-2w">
                <%= t('.status_depubliee') %>
              </span>
            <% end %>

            <%= "#{procedure.libelle} - n°#{procedure.id}" %>
          </div>

          <%= hidden_field_tag "ordered_procedure_ids[]", procedure.id %>
        </div>
      <% end %>
    <% end %>
  </fr-container>
</div>

<div class="fixed-footer fr-py-1w">
  <div
    class="
      fr-btns-group fr-btns-group--center fr-btns-group--inline
      fr-btns-group--inline-lg
    "
  >
    <%= link_to t('.cancel'), instructeur_procedures_path, class: 'fr-btn fr-btn--secondary fr-my-1w' %>

    <button
      class="fr-btn fr-my-1w"
      type="submit"
      form="order-instructeur-procedures-form"
    >
      <%= t('.submit') %>
    </button>
  </div>
</div>

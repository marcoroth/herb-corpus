<% if @can_confirm %>
  <%= turbo_stream.remove 'dossier-submit-dialog' %>
  <%= turbo_stream.append 'dossier-edit-instructeur' do %>
    <%= render Instructeurs::EditDossierConfirmComponent.new(dossier: @dossier) %>
  <% end %>
<% else %>
  <%= turbo_stream.replace 'dossier-edit-instructeur' do %>
    <%= render partial: "shared/dossiers/edit_instructeur", locals: { dossier: @dossier, seen_at: @demande_seen_at } %>
  <% end %>
<% end %>

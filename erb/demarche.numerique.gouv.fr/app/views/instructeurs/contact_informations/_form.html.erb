<%= form_with url: instructeur_groupe_contact_information_path, model: @contact_information, local: true do |f| %>
  <%= render "shared/groupe_instructeurs/contact_information_fields", f: f %>

  <% if procedure_id.present? %>
    <%= hidden_field_tag :procedure_id, procedure_id %>
  <% end %>

  <%= render "shared/groupe_instructeurs/contact_information_footer", f:, cancel_path: instructeur_groupe_path(@groupe_instructeur, procedure_id: procedure_id), delete_path: (instructeur_groupe_contact_information_path(procedure_id: @procedure.id, groupe_id: @groupe_instructeur.id) if ["edit", "update"].include?(params[:action])) %>
<% end %>

<% if ["edit", "update"].include?(params[:action]) %>
  <%= render NestedForms::FormOwnerComponent.new %>
<% end %>

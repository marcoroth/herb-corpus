<% content_for(:title, "Filtres") %>

<div class="fr-container fr-mt-6w fr-mb-15w">
  <%= link_to " #{t('.exit_customization')}", instructeur_procedure_path(@procedure, statut: @statut), class: 'fr-link fr-icon-arrow-left-line fr-link--icon--left fr-icon--sm' %>

  <h3 class="fr-my-3w"><%= t('.title') %></h3>

  <%= render Instructeurs::CustomizeFiltersComponent.new(procedure_presentation: @procedure_presentation, statut: @statut, filters_columns: @filters_columns, apply_to_all_tabs: @apply_to_all_tabs) %>
</div>

<%= render FixedFooterComponent.new(centered: true) do |footer| %>
  <% footer.with_action do %>
    <%= link_to t('.cancel'), instructeur_procedure_path(@procedure, statut: @statut), class: 'fr-btn fr-btn--secondary' %>
  <% end %>

  <% footer.with_action do %>
    <button class="fr-btn" type="submit" form="save-filters-form">
      <%= t('.validate') %>
    </button>
  <% end %>
<% end %>

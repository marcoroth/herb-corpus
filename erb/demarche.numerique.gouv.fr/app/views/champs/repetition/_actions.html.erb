<div
  id="<%= dom_id(champ, :repetition_actions) %>"
  class="actions"
  data-turbo-force="server"
>
  <%= render NestedForms::OwnedButtonComponent.new(
    formaction: champs_repetition_path(champ.dossier, champ.stable_id),
    http_method: :create,
    opt: {
      class: "fr-btn fr-btn--secondary fr-btn--icon-left fr-icon-add-circle-line fr-mb-3w",
      id: dom_id(champ, :create_repetition),
      disabled: max_reached
    }
  ) do %>
    <%= t("editable_champ.repetition_component.add", libelle: champ.libelle) %>
  <% end %>

  <% if max_reached %>
    <p class="fr-message fr-message--info">
      <%= t("editable_champ.repetition_component.max_reached", max: champ.type_de_champ.max_repetitions.to_i) %>
    </p>
  <% end %>
</div>

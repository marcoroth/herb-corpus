<% content_for(:title, "#{@subject}") %>

<p><%= t(:hello, scope: [:views, :shared, :greetings]) %></p>

<p>
  <%= t('.header_termine', count: @dossiers.size, expiration_date: human_date(@expiration_date.to_date)) %>

  <ul>
    <% @dossiers.each do |d| %>
      <li>
        <%= link_to("N° #{d.id} (#{d.procedure.libelle})", dossier_url(d)) %>
      </li>
    <% end %>
  </ul>
</p>

<p>
  <%= t('.footer_termine_html', count: @dossiers.size, dossiers_url: dossiers_url) %>
</p>

<p>
  <%= t('.account_active', count: @dossiers.size, application_name: APPLICATION_NAME) %>
</p>

<%= render partial: "layouts/mailers/signature" %>

<% if field.data.any? %>
  <table class="collection-data" aria-labelledby="page-title">
    <thead>
      <tr>
        <td class="cell-label">Libelle</td>
        <td class="cell-label">Type de champ</td>
        <td class="cell-label">Modifier le modèle</td>
      </tr>
    </thead>

    <tbody>
      <% field.data.each do |type_de_champ| %>
        <%= render partial: 'fields/type_de_champs_collection_field/type_champ_line', locals: { type_de_champ: type_de_champ } %>
      <% end %>
    </tbody>
  </table>
<% else %>
  Aucun
<% end %>

<% content_for(:title, t('views.users.dossiers.personnalisation.title')) %>

<%= form_with url: personnalisation_path,
      method: :patch,
      data: { controller: 'enable-submit-if-form-changes', action: 'change->enable-submit-if-form-changes#onFormChange' } do %>
  <div class="fr-container fr-mt-2w fr-mb-15w">
    <%= link_to t('views.users.dossiers.personnalisation.back'), dossiers_path, class: 'fr-link fr-icon-arrow-left-line fr-link--icon-left fr-icon--sm' %>

    <h1 class="fr-h3 fr-my-3w">
      <%= t('views.users.dossiers.personnalisation.title') %>
    </h1>

    <section class="fr-accordion fr-mb-4w">
      <h2 class="fr-accordion__title">
        <button
          class="fr-accordion__btn"
          aria-expanded="false"
          aria-controls="why-personnalisation"
          type="button"
        >
          <%= t('views.users.dossiers.personnalisation.why_title') %>
        </button>
      </h2>

      <div class="fr-collapse" id="why-personnalisation">
        <p class="fr-mb-0">
          <%= t('views.users.dossiers.personnalisation.why_intro') %>
        </p>

        <ul>
          <li>
            <%= t('views.users.dossiers.personnalisation.why_field_number_html') %>
          </li>

          <li>
            <%= t('views.users.dossiers.personnalisation.why_field_applicant_html') %>
          </li>

          <li>
            <%= t('views.users.dossiers.personnalisation.why_field_date_html') %>
          </li>
        </ul>

        <p>
          <%= t('views.users.dossiers.personnalisation.why_explanation_html') %>
        </p>
      </div>
    </section>

    <h2 class="fr-h5">
      <%= t('views.users.dossiers.personnalisation.fields_title') %>
    </h2>

    <% if @personnalisable_procedures.any? %>
      <% @personnalisable_procedures.each do |procedure| %>
        <%= render Users::PersonnalisationComponent.new(procedure:, personnalisation: @personnalisations_by_procedure_id[procedure.id]) %>
      <% end %>
    <% else %>
      <p><%= t('views.users.dossiers.personnalisation.empty_state') %></p>
    <% end %>
  </div>

  <div class="padded-fixed-footer">
    <div class="fixed-footer fr-py-1w">
      <div
        class="
          fr-btns-group fr-btns-group--center fr-btns-group--inline
          fr-btns-group--inline-lg
        "
      >
        <%= link_to t('views.users.dossiers.personnalisation.cancel'), dossiers_path, class: 'fr-btn fr-btn--secondary fr-my-1w' %>

        <% if @personnalisable_procedures.any? %>
          <button
            class="fr-btn fr-my-1w"
            type="submit"
            disabled
            data-enable-submit-if-form-changes-target="submitButton"
          >
            <%= t('views.users.dossiers.personnalisation.save_button') %>
          </button>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

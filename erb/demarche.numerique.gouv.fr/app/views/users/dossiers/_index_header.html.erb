<div class="mes-dossiers-header fr-mt-1w fr-mb-2w">
  <div class="mes-dossiers-header__title">
    <h1 class="fr-h3"><%= t('views.users.dossiers.index.dossiers') %></h1>

    <% if show_personnalisation_link %>
      <%= link_to personnalisation_path,
          class: 'fr-link fr-icon-settings-5-line fr-link--icon-left mes-dossiers-header__personnalisation',
          aria: { label: t('views.users.dossiers.index.personnalisation_link.label') },
          data: { turbo_frame: '_top' } do %>
        <span class="fr-hidden unhidden-md">
          <%= t('views.users.dossiers.index.personnalisation_link.label') %>
        </span>
      <% end %>
    <% end %>
  </div>

  <% if corbeille_count.positive? %>
    <%= link_to t('views.users.dossiers.index.corbeille_link.label', count: corbeille_count),
        trash_path,
        class: 'fr-link fr-icon-delete-bin-line fr-link--icon-left mes-dossiers-header__corbeille',
        data: { turbo_frame: '_top' } %>
  <% end %>
</div>

<% content_for :title, t('.title', application_name: Current.application_name) %>

<div class="fr-container" data-controller="panels">
  <h1 class="page-title">
    <%= t('.title', application_name: Current.application_name) %>
  </h1>

  <p>
    <%= t('.subtitle_html', email: @fci.email_france_connect, application_name: Current.application_name) %>
  </p>

  <fieldset class="fr-fieldset" aria-labelledby="merge-account">
    <legend class="fr-fieldset__legend" id="merge-account">
      <%= t('.label_select_merge_flow', email: @fci.email_france_connect) %>
    </legend>

    <div class="fr-fieldset__element fr-fieldset__element--inline">
      <div class="fr-radio-group">
        <input
          type="radio"
          id="it-is-mine"
          name="value"
          value="true"
          autocomplete="off"
          data-action="panels#show"
          data-panels-name-param="fusion"
        >

        <label for="it-is-mine"><%= t('utils.yes') %></label>
      </div>
    </div>

    <div class="fr-fieldset__element fr-fieldset__element--inline">
      <div class="fr-radio-group">
        <input
          type="radio"
          id="it-is-not-mine"
          name="value"
          value="false"
          autocomplete="off"
          data-action="panels#show"
          data-panels-name-param="new-account"
        >

        <label for="it-is-not-mine"><%= t('utils.no') %></label>
      </div>
    </div>
  </fieldset>

  <div
    class="fusion hidden"
    data-panels-target="panel"
    data-panels-name="fusion"
  >
    <p><%= t('.title_fill_in_password') %></p>

    <%= render partial: 'password_confirmation', locals: { fci: @fci, wrong_password: @wrong_password } %>

    <div class="fr-mt-4v">
      <%= button_to t('.link_confirm_by_email'),
        france_connect_send_email_merge_request_path,
        params: { email: @fci.email_france_connect, merge_token: @fci.merge_token },
        class: 'fr-btn fr-btn--secondary' %>
    </div>
  </div>

  <div
    class="new-account hidden"
    data-panels-target="panel"
    data-panels-name="new-account"
  >
    <p>
      <%= t('.title_fill_in_email', application_name: Current.application_name) %>
    </p>

    <%= form_tag france_connect_send_email_merge_request_path, class: 'fr-mt-4v form' do -%>
      <%= hidden_field_tag :merge_token, @fci.merge_token, id: dom_id(@fci, :new_account_merge_token) %>
      <%= label_tag :email, t('views.registrations.new.email_label'), for: dom_id(@fci, :new_account_email), class: 'fr-label' %>
      <%= email_field_tag :email, "", required: true, id: dom_id(@fci, :new_account_email), class: 'fr-mb-2v fr-input' %>
      <%= submit_tag t('.button_use_this_email'), class: 'fr-btn' %>
    <% end -%>
  </div>
</div>

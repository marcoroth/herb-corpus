<% profile = local_assigns.fetch(:profile, controller.try(:nav_bar_profile).presence || controller.try(:fallback_nav_bar_profile)) %>
<% root_label, root_url = breadcrumb_root_for(profile) %>

<nav
  class="fr-breadcrumb fr-mt-0 fr-mb-1w"
  role="navigation"
  aria-label="<%= t('you_are_here', scope: [:layouts, :breadcrumb]) %>"
>
  <button
    class="fr-breadcrumb__button"
    aria-expanded="false"
    aria-controls="breadcrumb-1"
  >
    <%= t('show', scope: [:layouts, :breadcrumb]) %>
  </button>

  <div class="fr-collapse" id="breadcrumb-1">
    <ol class="fr-breadcrumb__list">
      <li><%= link_to root_label, root_url, class: 'fr-breadcrumb__link' %></li>

      <% steps.each.with_index do |step, i| %>
        <% if i == steps.size - 1 %>
          <li>
            <%= link_to step[0], '', { aria: { current: "page" }, class: 'fr-breadcrumb__link' } %>
          </li>
        <% else %>
          <li><%= link_to step[0], step[1], class: 'fr-breadcrumb__link' %></li>
        <% end %>
      <% end %>
    </ol>
  </div>
</nav>

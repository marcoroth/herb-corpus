<%= render FixedFooterComponent.new do |footer| %>
  <% footer.with_action do %>
    <%= link_to t('.cancel'), cancel_path, class: 'fr-btn fr-btn--secondary' %>
  <% end %>

  <% footer.with_action do %>
    <%= f.submit t('.submit'), class: 'fr-btn' %>
  <% end %>

  <% if local_assigns[:delete_path] %>
    <% footer.with_action do %>
      <%= render NestedForms::OwnedButtonComponent.new(formaction: delete_path, http_method: :delete, opt: { class: 'fr-btn fr-btn--secondary', data: { turbo_confirm: t('.delete_confirm') } }) do %>
        <%= t('.delete') %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= render partial: 'shared/breadcrumbs_section', locals: { steps: [['Mon groupe gestionnaire', admin_groupe_gestionnaire_path], ['Messagerie']] } %>

<div class="fr-container">
  <h1 class="fr-h2">Messagerie de « <%= @groupe_gestionnaire.name %> »</h1>

  <div class="messagerie">
    <% if current_administrateur.commentaire_groupe_gestionnaires.where(groupe_gestionnaire: @groupe_gestionnaire).present? %>
      <ol class="messages-list" data-controller="scroll-to">
        <% current_administrateur.commentaire_groupe_gestionnaires.where(groupe_gestionnaire: @groupe_gestionnaire).each do |commentaire| %>
          <li
            class="message <%= commentaire_is_from_me_class(commentaire, current_administrateur) %>"
            id="<%= dom_id(commentaire) %>"
          >
            <%= render(Dossiers::MessageComponent.new(commentaire: commentaire, connected_user: current_administrateur, messagerie_seen_at: @commentaire_seen_at, groupe_gestionnaire: @groupe_gestionnaire)) %>
          </li>
        <% end %>
      </ol>
    <% end %>

    <%= render FixedFooterComponent.new do %>
      <div data-controller="hide-target">
        <button
          class="fr-btn fr-icon-add-line fr-btn--icon-left fr-mb-2w"
          type="button"
          data-hide-target-target="source"
          data-hide-target-hide-source="true"
        >
          <%= t('shared.messagerie.new_message') %>
        </button>

        <div class="fr-mt-2w fr-hidden" data-hide-target-target="toHide">
          <%= render partial: "shared/dossiers/messages/form", locals: { commentaire: @commentaire, form_url: admin_groupe_gestionnaire_create_commentaire_path } %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<% if @updated_body %>
  <%# Appended (not replaced): the controller loads it off-screen and swaps it in on load. %>
  <%= turbo_stream.append "mail-body-preview" do %>
    <%= tag.iframe(srcdoc: @mail_body_html, class: "mail-preview-frame", title: "Aperçu de l’email", width: "636", height: "480", sandbox: "allow-same-origin", data: { mail_preview_target: "frame" }) %>
  <% end %>
<% end %>

<% if @updated_subject %>
  <%= turbo_stream.update "mail-subject-preview", @subject_preview %>
<% end %>

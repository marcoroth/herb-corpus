<% content_for(:title, t('.title')) %>
<%= render_procedure_sticky_title(@procedure) %>

<div class="fr-container fr-mt-6w fr-mb-6w">
  <%= link_to t('.back_to_labels'), admin_procedure_labels_path, class: 'fr-link fr-icon-arrow-left-line fr-link--icon--left fr-icon--sm' %>

  <h3 class="fr-my-3w"><%= t('.heading_html', count: @labels.size) %></h3>

  <p><%= t('.description') %></p>

  <fr-container data-controller="move-cards-position">
    <%= form_tag update_order_positions_admin_procedure_labels_path, method: :patch, id: 'order-admin-procedure-labels-form' do %>
      <% @labels.each do |label| %>
        <div class="fr-card fr-mb-1w fr-py-1w fr-px-2w">
          <div class="flex align-center">
            <button
              class="
                fr-btn fr-btn--sm fr-icon-arrow-up-line fr-btn--secondary
                fr-col-1
              "
              title="<%= t('shared.order_positions.move_up') %>"
              data-action="move-cards-position#moveUp"
            >
              <span class="fr-sr-only">
                <%= t('shared.order_positions.move_up') %>
              </span>
            </button>

            <button
              class="
                fr-btn fr-btn--sm fr-icon-arrow-down-line fr-btn--secondary
                fr-col-1 fr-ml-2w fr-mr-4w
              "
              title="<%= t('shared.order_positions.move_down') %>"
              data-action="move-cards-position#moveDown"
            >
              <span class="fr-sr-only">
                <%= t('shared.order_positions.move_down') %>
              </span>
            </button>

            <%= tag_label(label.name, label.color) %>
          </div>

          <%= hidden_field_tag "ordered_label_ids[]", label.id %>
        </div>
      <% end %>
    <% end %>
  </fr-container>
</div>

<div class="sticky-footer fr-py-1w">
  <div
    class="
      fr-btns-group fr-btns-group--center fr-btns-group--inline
      fr-btns-group--inline-lg
    "
  >
    <%= link_to t('.cancel'), admin_procedure_labels_path, class: 'fr-btn fr-btn--secondary fr-my-1w' %>

    <button
      class="fr-btn fr-my-1w"
      type="submit"
      form="order-admin-procedure-labels-form"
    >
      <%= t('.submit') %>
    </button>
  </div>
</div>

<% content_for(:title, "Simplification") %>
<% render_procedure_sticky_title(@procedure) %>

<%= render partial: 'shared/breadcrumbs_section',
  locals: { steps: [[admin_procedures_back_label(@procedure), admin_procedures_back_path(@procedure)],
                    [@procedure.libelle.truncate_words(10), admin_procedure_path(@procedure)],
                    ['Amélioration de la qualité du formulaire']] } %>

<%= render LLM::StepperComponent.new(step_component: LLM::SuggestionFormComponent.new(llm_rule_suggestion: @llm_rule_suggestion)) do |stepper| %>
  <% stepper.with_header do %>
    <%= render LLM::HeaderComponent.new(llm_rule_suggestion: @llm_rule_suggestion) %>
  <% end %>
<% end %>

<%= form_with url: admin_procedure_groupe_instructeur_contact_information_path(@procedure, @groupe_instructeur), model: @contact_information, local: true do |f| %>
  <%= render "shared/groupe_instructeurs/contact_information_fields", f: f %>

  <%= render "shared/groupe_instructeurs/contact_information_footer",
    f:,
    cancel_path: admin_procedure_groupe_instructeur_path(@procedure, @groupe_instructeur),
    delete_path: (admin_procedure_groupe_instructeur_contact_information_path(@procedure, @groupe_instructeur) if ["edit", "update"].include?(params[:action])) %>
<% end %>

<% if ["edit", "update"].include?(params[:action]) %>
  <%= render NestedForms::FormOwnerComponent.new %>
<% end %>

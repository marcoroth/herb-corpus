<% content_for(:title, "Nouvelle démarche") %>
<% content_for(:root_class, 'scroll-margins-for-sticky-footer') %>

<%= render partial: 'shared/breadcrumbs_section', locals: { steps: [[admin_procedures_back_label(@procedure), admin_procedures_back_path(@procedure)], ['Nouvelle']] } %>
<%= render NestedForms::FormOwnerComponent.new %>

<%= form_for @procedure, url: url_for({ controller: 'administrateurs/procedures', action: :create, id: @procedure.id }), html: { class: 'procedure_tags_combo', multipart: true } do |f| %>
  <div class="fr-container">
    <div class="fr-grid-row">
      <div class="fr-col-12 fr-col-offset-md-2 fr-col-md-8">
        <h1 class="fr-h2">Nouvelle démarche</h1>
        <%= render partial: 'administrateurs/procedures/informations', locals: { f: f } %>
      </div>
    </div>
  </div>

  <%= render FixedFooterComponent.new(narrow: true) do |footer| %>
    <% footer.with_action do %>
      <%= link_to t('.cancel'), admin_procedures_path, class: 'fr-btn fr-btn--secondary', data: { controller: 'confirm', confirm_message_value: t('.cancel_confirm'), action: 'confirm#ask' } %>
    <% end %>

    <% footer.with_action do %>
      <%= f.button t('.submit'), class: 'fr-btn' %>
    <% end %>
  <% end %>
<% end %>

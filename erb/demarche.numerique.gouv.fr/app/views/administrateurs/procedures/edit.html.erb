<% render_procedure_sticky_title(@procedure) %>
<% content_for(:root_class, 'scroll-margins-for-sticky-footer') %>

<%= render partial: 'shared/breadcrumbs_section', locals: { steps: [[admin_procedures_back_label(@procedure), admin_procedures_back_path(@procedure)], [@procedure.libelle.truncate_words(10), admin_procedure_path(@procedure)], ['Présentation']] } %>
<%= render NestedForms::FormOwnerComponent.new %>

<%= form_for @procedure, url: url_for({ controller: 'administrateurs/procedures', action: :update, id: @procedure.id }), html: { class: 'procedure_tags_combo', multipart: true } do |f| %>
  <div class="fr-container">
    <div class="fr-grid-row">
      <div class="fr-col-12 fr-col-offset-md-2 fr-col-md-8">
        <h1 class="fr-h2">Présentation</h1>
        <%= render partial: 'administrateurs/procedures/informations', locals: { f: f } %>
      </div>
    </div>
  </div>

  <%= render Procedure::FixedFooterComponent.new(procedure: @procedure, form: f, narrow: true) %>
<% end %>

<% content_for(:title, t('.meta_title')) -%>

<div class="fr-container fr-my-4w">
  <%= render partial: "breadcrumb" %>

  <div class="fr-grid-row">
    <div class="fr-col-12 fr-col-md-10">
      <h1><%= t('.title', app_name: Current.application_name) %></h1>

      <% @faqs.each do |category, subcategories| -%>
        <h2>
          <%= t(:name, scope: [:faq, :categories, category], raise: true) %>
          <%# i18n-tasks-use t("faq.categories.#{category}.name") %>
        </h2>

        <p>
          <%= t(:description, scope: [:faq, :categories, category], raise: true) %>
          <%# i18n-tasks-use t("faq.categories.#{category}.description") %>
        </p>

        <div class="fr-accordions-group fr-mb-6w">
          <% subcategories.each_with_index do |(subcategory, faqs), index| -%>
            <section class="fr-accordion">
              <h3 class="fr-accordion__title">
                <button
                  class="fr-accordion__btn"
                  aria-expanded="false"
                  aria-controls="accordion-<%= category %>-<%= index %>"
                >
                  <%= t(:name, scope: [:faq, :subcategories, subcategory], raise: true) %>
                  <%# i18n-tasks-use t("faq.subcategories.#{subcategory}.name") %>
                </button>
              </h3>

              <div
                class="fr-collapse"
                id="accordion-<%= category %>-<%= index %>"
              >
                <% description = t(:description, scope: [:faq, :subcategories, subcategory], default: nil) %>

                <%# i18n-tasks-use t("faq.subcategories.#{subcategory}.description") %>
                <%- if description -%>
                  <p><%= description %></p>
                <%- end -%>

                <ul>
                  <% faqs.each do |faq| -%>
                    <li>
                      <%= link_to faq[:title], faq_path(category: faq[:category], slug: faq[:slug]), class: "fr-link" %>
                    </li>
                  <% end -%>
                </ul>
              </div>
            </section>
          <% end -%>
        </div>
      <% end -%>
    </div>
  </div>
</div>

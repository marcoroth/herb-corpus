<%# https://integration.lasuite.numerique.gouv.fr/guides/gaufre-v2/ %>
<%# locals: (button_id:) %>
<%#
  The icon is the integration guide's inline SVG, not an fr-icon-* class: a
  CSS mask vanishes when styles are off, which fails RGAA 10.2. The square id
  is suffixed since the mobile and desktop buttons share the page.
  icon-only: the header zone cancels the DSFR icon-only square (overflow,
  max-width), so we restore it in dsfr.scss.
%>

<button
  type="button"
  id="<%= button_id %>"
  class="fr-btn fr-btn--tertiary-no-outline icon-only"
  aria-label="<%= t('lasuite_gaufre.label') %>"
  title="<%= t('lasuite_gaufre.label') %>"
  aria-expanded="false"
>
  <svg
    width="18"
    height="18"
    viewBox="0 0 18 18"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <path
        fill="currentColor"
        id="<%= button_id %>-square"
        d="M2.7959 0.5C3.26483 0.5 3.49956 0.49985 3.68848 0.564453C4.03934 0.684581 4.31542 0.960658 4.43555 1.31152C4.50015 1.50044 4.5 1.73517 4.5 2.2041V2.7959C4.5 3.26483 4.50015 3.49956 4.43555 3.68848C4.31542 4.03934 4.03934 4.31542 3.68848 4.43555C3.49956 4.50015 3.26483 4.5 2.7959 4.5H2.2041C1.73517 4.5 1.50044 4.50015 1.31152 4.43555C0.960658 4.31542 0.684581 4.03934 0.564453 3.68848C0.49985 3.49956 0.5 3.26483 0.5 2.7959V2.2041C0.5 1.73517 0.49985 1.50044 0.564453 1.31152C0.684581 0.960658 0.960658 0.684581 1.31152 0.564453C1.50044 0.49985 1.73517 0.5 2.2041 0.5H2.7959Z"
      />
    </defs>

    <use href="#<%= button_id %>-square" transform="translate(0, 0)" />
    <use href="#<%= button_id %>-square" transform="translate(6.5, 0)" />
    <use href="#<%= button_id %>-square" transform="translate(13, 0)" />
    <use href="#<%= button_id %>-square" transform="translate(0, 6.5)" />
    <use href="#<%= button_id %>-square" transform="translate(6.5, 6.5)" />
    <use href="#<%= button_id %>-square" transform="translate(13, 6.5)" />
    <use href="#<%= button_id %>-square" transform="translate(0, 13)" />
    <use href="#<%= button_id %>-square" transform="translate(6.5, 13)" />
    <use href="#<%= button_id %>-square" transform="translate(13, 13)" />
  </svg>
</button>

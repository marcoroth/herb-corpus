<div class="result">
  <div class="parents">
    <%= parents %>
  </div>
  <div class="result__header">
    <h4 class="result__title">
      <%= link_to_if(@archive_file.link.present?, @archive_file.call_number, @archive_file.link, target: "_blank") %>: <%= title %>
    </h4>
    <% if parsed_date %>
      <details class="result__date">
        <summary class="result__date-text"><%= date %></summary>
        <p class="result__date-parsed"><%= t("result_date_parsed") %> <%= parsed_date %></p>
      </details>
    <% else %>
      <p class="result__date-text"><%= date %></p>
    <% end %>
  </div>
  <div class="cite">
    <% CITE_FORMATS.each do |format, label| %>
      <div class="cite__group">
        <span class="cite__label"><%= label %></span>
        <button type="button"
                class="cite__button"
                data-action="copy"
                data-format="<%= format %>"
                data-href="<%= cite_path(format) %>"
                data-copied="<%= t("cite_copied", name: label) %>"
                data-failed="<%= t("cite_copy_failed") %>"
                title="<%= t("cite_copy", name: label) %>"
                aria-label="<%= t("cite_copy", name: label) %>"><%= copy_icon %></button>
        <a class="cite__button"
           data-format="<%= format %>"
           download="<%= cite_filename(format) %>"
           href="<%= cite_path(format) %>"
           title="<%= t("cite_download", name: label) %>"
           aria-label="<%= t("cite_download", name: label) %>"><%= download_icon %></a>
      </div>
    <% end %>
  </div>
  <p class="result__summary">
    <%= summary %>
  </p>
</div>

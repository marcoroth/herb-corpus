<%# Each language names itself, so the link is readable to someone who cannot
    read the page it sits on. %>
<nav class="footer__languages" aria-label="<%= t("language_toggle") %>">
  <% other_locales.each do |locale| %>
    <%= link_to t("language_name", locale: locale),
                language_url(locale),
                lang: locale,
                hreflang: locale,
                rel: "alternate" %>
  <% end %>
</nav>

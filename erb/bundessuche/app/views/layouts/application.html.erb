<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="no-js">
  <head>
    <%# Swapped before the first paint, so that anything JavaScript folds away
        can start out folded instead of flashing open. Browsers without
        JavaScript keep the "no-js" class and see the unfolded markup. %>
    <script nonce="<%= content_security_policy_nonce %>">
      document.documentElement.classList.replace("no-js", "js");
    </script>
    <title>Bundessuche</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script
      src="https://cdn.telemetrydeck.com/websdk/telemetrydeck.min.js"
      data-app-id="4D04C4F8-7914-4E67-88E4-1563561BA088"
      nonce="<%= content_security_policy_nonce %>"
    ></script>
    <%= preload_link_tag asset_path('Atkinson_Hyperlegible/WOFF2/Atkinson-Hyperlegible-Regular-102a.woff2') %>
    <%= preload_link_tag asset_path('Atkinson_Hyperlegible/WOFF2/Atkinson-Hyperlegible-Bold-102a.woff2') %>
    <%= preload_link_tag asset_path('Atkinson_Hyperlegible/WOFF2/Atkinson-Hyperlegible-Italic-102a.woff2') %>
    <%= preload_link_tag asset_path('Atkinson_Hyperlegible/WOFF2/Atkinson-Hyperlegible-BoldItalic-102a.woff2') %>
    <%= preload_link_tag asset_path('EB_Garamond/WOFF2/EBGaramond-Regular.woff2') %>
  </head>
  <body>
    <div class="container__outer">
      <main class="container__inner">
        <h1 class="search__title">
          <%= link_to "Bundessuche", :root %>
        </h1>
        <%= yield %>
      </main>
    </div>
    <footer class="footer">
      <%= link_to t("imprint_title"), :imprint %>
      <%= render "layouts/language_toggle" %>
    </footer>
  </body>
</html>

<%= render Pathogen::Tabs.new(id: "sample-tabs", label: "Sample details") do |tabs| %>
  <% tabs.with_tab(id: "overview-tab", label: "Overview", selected: true) %>
  <% tabs.with_tab(id: "metrics-tab", label: "Quality metrics") %>
  <% tabs.with_panel(id: "overview-panel", tab_id: "overview-tab") do %>
    <p>Sample PVC-001 is ready for review.</p>
  <% end %>
  <% tabs.with_panel(id: "metrics-panel", tab_id: "metrics-tab") do %>
    <p>Coverage: 98%. Quality checks passed.</p>
  <% end %>
<% end %>

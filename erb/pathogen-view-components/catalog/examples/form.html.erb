<fieldset>
  <legend>Report settings</legend>
  <%= render Pathogen::Form::RadioButton.new(attribute: :report_format, value: "summary", label: "Summary report", checked: true) %>
  <%= render Pathogen::Form::RadioButton.new(attribute: :report_format, value: "full", label: "Full report") %>
  <%= render Pathogen::Form::Switch.new(attribute: :include_metadata, label: "Include sample metadata", checked: true) %>
</fieldset>

<%= tag.public_send(@root_arguments[:href].present? ? :a : :span, **@root_arguments) do %>
  <%= tag.span(
    aria: { hidden: true },
    hidden: @src.present?,
    data: { 'pathogen--avatar-target': 'fallback' },
    class: 'pointer-events-none flex size-full items-center justify-center leading-none'
  ) do %>
    <% if @fallback_text.present? %>
      <%= @fallback_text %>
    <% else %>
      <%# Generic user silhouette when no image or initials are available (decorative fallback). %>
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="size-[62%]" xmlns="http://www.w3.org/2000/svg">
        <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8" />

        <path d="M4 20c0-3.3 3.58-6 8-6s8 2.7 8 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    <% end %>
  <% end %>

  <% if @src.present? %>
    <%= tag.img(
      src: @src,
      alt: @image_alt,
      class: 'absolute inset-0 size-full object-cover object-center',
      width: @image_size,
      height: @image_size,
      loading: :lazy,
      decoding: :async,
      data: {
        'pathogen--avatar-target': 'image',
        action: 'load->pathogen--avatar#showImage error->pathogen--avatar#showFallback'
      }
    ) %>
  <% end %>
<% end %>

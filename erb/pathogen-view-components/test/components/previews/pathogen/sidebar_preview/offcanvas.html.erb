<div class="space-y-4 p-4">
  <%= render Pathogen::Sidebar::Provider.new(
    id: 'offcanvas-sidebar',
    class: 'h-[600px] !min-h-[600px] rounded-[var(--pvc-radius-panel)] border border-[color:var(--pvc-color-border)]'
  ) do %>
    <%= render Pathogen::Sidebar.new(id: 'offcanvas-sidebar', label: 'Primary navigation') do %>
      <%= render Pathogen::Sidebar::Header.new do %>
        <%= render Pathogen::Sidebar::Trigger.new %>
        <span data-pathogen-sidebar-label="true" class="text-[length:var(--type-control)] font-semibold">Navigation</span>
      <% end %>

      <%= render Pathogen::Sidebar::Content.new do %>
        <ul class="m-0 flex list-none flex-col gap-1 p-0">
          <li>
            <a
              href="#run-summary"
              class="
                interactive-hover:bg-[var(--pvc-color-surface-muted)] inline-flex min-h-11 w-full items-center
                rounded-[var(--pvc-radius-action)] px-2 text-[length:var(--type-control)] font-semibold
                text-[color:var(--pvc-color-text)] no-underline focus-visible:outline focus-visible:outline-2
                focus-visible:outline-offset-2 focus-visible:outline-[var(--pvc-color-focus)]
              "
            >
              <span data-pathogen-sidebar-label="true">Overview</span>
            </a>
          </li>

          <li>
            <a
              href="#monitoring"
              class="
                interactive-hover:bg-[var(--pvc-color-surface-muted)] inline-flex min-h-11 w-full items-center
                rounded-[var(--pvc-radius-action)] px-2 text-[length:var(--type-control)] font-semibold
                text-[color:var(--pvc-color-text)] no-underline focus-visible:outline focus-visible:outline-2
                focus-visible:outline-offset-2 focus-visible:outline-[var(--pvc-color-focus)]
              "
            >
              <span data-pathogen-sidebar-label="true">Monitoring</span>
            </a>
          </li>
        </ul>
      <% end %>
    <% end %>

    <%= render Pathogen::Sidebar::Inset.new do %>
      <div class="flex items-center gap-2 border-b border-[color:var(--pvc-color-border)] p-3 xl:hidden">
        <%= render Pathogen::Sidebar::Trigger.new %>
        <span class="text-[length:var(--type-control)] font-semibold">Host trigger</span>
      </div>

      <main class="space-y-2 p-4">
        <%= pathogen_heading(level: 2, id: 'run-summary') { 'Run summary' } %>

        <%= pathogen_supporting do %>
          RUN-2026-0812 started at 09:42 and is currently processing 48 samples.
        <% end %>
      </main>
    <% end %>
  <% end %>
</div>

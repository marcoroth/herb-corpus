<% rows = [
  { sample_id: 'SAM-0001', name: 'Northern basin isolate', status: 'Active' },
  { sample_id: 'SAM-0002', name: 'Coastal sediment sample', status: 'Pending' }
] %>

<div class="flex max-w-4xl flex-col gap-8 p-4">
  <section>
    <%= render Pathogen::Typography::Heading.new(level: 2, class: 'mb-2') { 'Data grid toolbar' } %>

    <%= render Pathogen::Typography::Supporting.new(variant: :muted, class: 'mb-4') do %>
      Default <code class="font-mono">variant: :table</code> for full-width action rows above a data grid. Group related
      actions with <code class="font-mono">Toolbar::Group</code>, push end groups with
      <code class="font-mono">Toolbar::Spacer</code>, and keep text-entry controls outside the element with
      <code class="font-mono">role="toolbar"</code> and its roving focus, as recommended by the
      <%= render Pathogen::Link.new(href: 'https://www.w3.org/WAI/ARIA/apg/patterns/toolbar/') do %>
        APG toolbar pattern
      <% end %>.
      Detached submit buttons follow the
      <%= render Pathogen::Link.new(href: 'https://github.com/phac-nml/irida-next/pull/2035') do %>
        IRIDA Next selection-buttons pattern
      <% end %>.
      The search field remains in the same visual band as a separate Tab stop, so its text-editing keys stay native and
      toolbar arrow navigation remains available for every action.
    <% end %>

    <%# Hidden forms keep screen readers from announcing a form boundary before each button. %>
    <%= form_tag '#', method: :get, id: 'toolbar-preview-select-all', class: 'hidden', data: { turbo_frame: 'selected' } do %>
      <%= hidden_field_tag :select, 'on' %>
    <% end %>

    <%= form_tag '#', method: :get, id: 'toolbar-preview-deselect-all', class: 'hidden', data: { turbo_frame: 'selected' } %>

    <%= render Pathogen::DataGridComponent.new(
      id: 'toolbar-preview-grid',
      caption: 'Sample inventory',
      rows: rows
    ) do |grid| %>
      <% grid.with_toolbar(label: 'Sample grid actions') do %>
        <%= render Pathogen::Toolbar::Group.new do %>
          <%= render Pathogen::Toolbar::Button.new(
            form: 'toolbar-preview-select-all',
            label: 'Select all samples in this project'
          ) do %>
            Select all
          <% end %>

          <%= render Pathogen::Toolbar::Button.new(
            form: 'toolbar-preview-deselect-all',
            label: 'Deselect all samples in this project'
          ) do %>
            Deselect all
          <% end %>
        <% end %>

        <%= render Pathogen::Toolbar::Spacer.new %>

        <%= render Pathogen::Toolbar::Group.new do %>
          <%= render Pathogen::Toolbar::Button.new do %>
            Columns
          <% end %>

          <%= render Pathogen::Toolbar::Button.new(aria_disabled: true, label: 'Export selected samples') do %>
            Export
          <% end %>
        <% end %>
      <% end %>

      <% grid.with_toolbar_complement do %>
        <label class="sr-only" for="toolbar-preview-search">Search samples by ID or name</label>

        <input
          id="toolbar-preview-search"
          type="search"
          autocomplete="off"
          placeholder="Search samples by ID or name"
          class="
            w-full min-w-0 rounded-[var(--pvc-radius-control)] border border-[var(--pvc-color-border)]
            bg-[var(--pvc-color-surface)] px-3 py-2 text-[length:var(--type-control)] text-[var(--pvc-color-text)]
            focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2
            focus-visible:outline-[var(--pvc-color-focus)]
          "
        >
      <% end %>

      <% grid.with_column('Sample ID', key: :sample_id, width: 160) %>
      <% grid.with_column('Name', key: :name) %>
      <% grid.with_column('Status', key: :status, width: 140) %>
    <% end %>
  </section>

  <section>
    <%= render Pathogen::Typography::Heading.new(level: 2, class: 'mb-2') { 'Responsive full-width reflow' } %>

    <%= render Pathogen::Typography::Supporting.new(variant: :muted, class: 'mb-4') do %>
      Resize the preview below the <code class="font-mono">sm</code> breakpoint (640px). The spacer collapses, each
      <code class="font-mono">Toolbar::Group</code> takes a full row, and the search field expands to fill the available
      width.
    <% end %>

    <%= render Pathogen::DataGridComponent.new(
      id: 'toolbar-reflow-grid',
      caption: 'Responsive sample inventory',
      rows: rows
    ) do |grid| %>
      <% grid.with_toolbar(label: 'Responsive sample grid actions') do %>
        <%= render Pathogen::Toolbar::Group.new do %>
          <%= render Pathogen::Toolbar::Button.new(label: 'Select all samples in this project') do %>
            Select all
          <% end %>

          <%= render Pathogen::Toolbar::Button.new(label: 'Deselect all samples in this project') do %>
            Deselect all
          <% end %>
        <% end %>

        <%= render Pathogen::Toolbar::Spacer.new %>

        <%= render Pathogen::Toolbar::Group.new do %>
          <%= render Pathogen::Toolbar::Button.new(label: 'Filter samples') do %>
            Filter
          <% end %>

          <%= render Pathogen::Toolbar::Button.new(label: 'Choose visible columns') do %>
            Columns
          <% end %>

          <%= render Pathogen::Toolbar::Button.new(label: 'Export selected samples') do %>
            Export
          <% end %>
        <% end %>
      <% end %>

      <% grid.with_toolbar_complement do %>
        <label class="sr-only" for="toolbar-reflow-search">Search samples by ID or name</label>

        <input
          id="toolbar-reflow-search"
          type="search"
          autocomplete="off"
          placeholder="Search samples by ID or name"
          class="
            w-full min-w-0 rounded-[var(--pvc-radius-control)] border border-[var(--pvc-color-border)]
            bg-[var(--pvc-color-surface)] px-3 py-2 text-[length:var(--type-control)] text-[var(--pvc-color-text)]
            focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2
            focus-visible:outline-[var(--pvc-color-focus)]
          "
        >
      <% end %>

      <% grid.with_column('Sample ID', key: :sample_id, width: 160) %>
      <% grid.with_column('Name', key: :name) %>
      <% grid.with_column('Status', key: :status, width: 140) %>
    <% end %>
  </section>

  <section>
    <%= render Pathogen::Typography::Heading.new(level: 2, class: 'mb-2') { 'Chip toolbar' } %>

    <%= render Pathogen::Typography::Supporting.new(variant: :muted, class: 'mb-4') do %>
      Use <code class="font-mono">variant: :chip</code> for compact bordered toolbars in dialogs, panels, or inline
      editor contexts. Use a toolbar only when grouping three or more controls.
    <% end %>

    <div class="rounded-[var(--pvc-radius-panel)] border border-[var(--pvc-color-border)] bg-[var(--pvc-color-surface)] p-4">
      <%= render Pathogen::Toolbar.new(label: 'Sample actions', variant: :chip) do %>
        <%= render Pathogen::Toolbar::Button.new do %>
          Edit
        <% end %>

        <%= render Pathogen::Toolbar::Button.new do %>
          Duplicate
        <% end %>

        <%= render Pathogen::Toolbar::Separator.new %>

        <%= render Pathogen::Toolbar::Button.new do %>
          Archive
        <% end %>
      <% end %>
    </div>
  </section>

  <section>
    <%= render Pathogen::Typography::Heading.new(level: 2, class: 'mb-2') { 'Toggle and disabled states' } %>

    <%= render Pathogen::Typography::Supporting.new(variant: :muted, class: 'mb-4') do %>
      Pressed state is consumer-owned; the toolbar reflects it through <code class="font-mono">aria-pressed</code>, an
      accent-tinted fill, and an accent border. Unavailable actions use <code class="font-mono">aria-disabled</code> so
      they stay focusable and discoverable.
    <% end %>

    <div class="flex flex-wrap gap-4">
      <div class="rounded-[var(--pvc-radius-panel)] border border-[var(--pvc-color-border)] bg-[var(--pvc-color-surface)] p-4">
        <%= render Pathogen::Toolbar.new(label: 'Display options', variant: :chip) do %>
          <%= render Pathogen::Toolbar::Button.new(pressed: true) do %>
            Compact rows
          <% end %>

          <%= render Pathogen::Toolbar::Button.new(pressed: false) do %>
            Group by status
          <% end %>

          <%= render Pathogen::Toolbar::Button.new do %>
            Export
          <% end %>
        <% end %>
      </div>

      <div class="rounded-[var(--pvc-radius-panel)] border border-[var(--pvc-color-border)] bg-[var(--pvc-color-surface)] p-4">
        <%= render Pathogen::Toolbar.new(label: 'Sync actions', variant: :chip) do %>
          <%= render Pathogen::Toolbar::Button.new do %>
            Refresh data
          <% end %>

          <%= render Pathogen::Toolbar::Button.new(aria_disabled: true) do %>
            Sync all
          <% end %>

          <%= render Pathogen::Toolbar::Button.new do %>
            Download log
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

  <section>
    <%= render Pathogen::Typography::Heading.new(level: 2, id: 'toolbar-preview-a11y-title', class: 'mb-2') do %>
      Keyboard and custom controls
    <% end %>

    <%= render Pathogen::Typography::Supporting.new(variant: :muted, class: 'mb-4') do %>
      Tab into the toolbar once, then use
      <kbd class="rounded-sm border border-[var(--pvc-color-border-strong)] px-1.5 py-0.5 text-xs">←</kbd>
      <kbd class="rounded-sm border border-[var(--pvc-color-border-strong)] px-1.5 py-0.5 text-xs">→</kbd>
      <kbd class="rounded-sm border border-[var(--pvc-color-border-strong)] px-1.5 py-0.5 text-xs">Home</kbd> and
      <kbd class="rounded-sm border border-[var(--pvc-color-border-strong)] px-1.5 py-0.5 text-xs">End</kbd> to move
      between items. Custom controls join roving focus when they expose
      <code class="font-mono">data-pathogen--toolbar-target="item"</code>.
    <% end %>

    <div class="rounded-[var(--pvc-radius-panel)] border border-[var(--pvc-color-border)] bg-[var(--pvc-color-surface)] p-4">
      <%= render Pathogen::Toolbar.new(labelled_by: 'toolbar-preview-a11y-title', variant: :chip) do %>
        <%= render Pathogen::Toolbar::Button.new do %>
          Refresh data
        <% end %>

        <%= render Pathogen::Toolbar::Button.new(aria_disabled: true) do %>
          Sync all
        <% end %>

        <%= render Pathogen::Toolbar::Separator.new %>

        <button
          type="button"
          tabindex="-1"
          data-pathogen--toolbar-target="item"
          class="
            rounded-[var(--pvc-radius-action)] border border-[var(--pvc-color-border)] px-2 py-1
            text-[length:var(--type-control)] text-[var(--pvc-color-text)] hover:bg-[var(--pvc-color-surface-muted)]
          "
        >
          Custom control
        </button>
      <% end %>
    </div>
  </section>

  <section
    class="
      rounded-[var(--pvc-radius-panel)] border border-[var(--pvc-color-border)] bg-[var(--pvc-color-surface-muted)]
      p-4 text-[length:var(--type-control)] text-[var(--pvc-color-text-muted)]
    "
  >
    <%= render Pathogen::Typography::Heading.new(level: 2, class: 'mb-2') { 'Usage notes' } %>

    <ul class="list-disc space-y-2 pl-5">
      <li>
        Link the toolbar to its grid with <code class="font-mono">controls:</code> when actions operate on table
        content.
      </li>

      <li>
        Host-local dropdown menus stay consumer-managed in v1: only the closed trigger is a toolbar item; open menus
        must own their own keyboard model and stop keydown propagation so the toolbar does not steal
        Left/Right/Home/End.
      </li>

      <li>
        After Turbo morphs or wholesale DOM swaps, dispatch <code class="font-mono">pathogen--toolbar:sync</code> on the
        toolbar element.
      </li>
    </ul>
  </section>
</div>

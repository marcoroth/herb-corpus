<% content_for :title, "#{@show.title} - #{@season.name}" %>

<p><%= link_to "← Back", show_path(@show.slug) %></p>

<div class="page">
  <div class="season-page__header">
    <div class="season-page__poster">
      <%= render "poster", url: @season.poster.url, show: @show, size: "small" %>
    </div>

    <div class="season-page__details">
      <h1 class="page__title page__title--snug"><%= @show.title %></h1>

      <h2 class="season-page__name"><%= @season.name %></h2>

      <%= render "more_info", url: "https://www.themoviedb.org/tv/#{@show.tmdb_tv_id}/season/#{@season.season_number}" %>
    </div>
  </div>

  <div class="page-sections">
    <div>
      <div class="list-header">
        <h2 class="section-heading">Episodes</h2>

        <% if current_human.present? && @my_season %>
          <%= form_with url: season_skipping_path(@show.slug, @season.slug),
                        method: @my_season.skipped? ? :delete : :post,
                        class: "checkbox-row" do |f| %>
            <%= f.check_box :skipped,
                            checked: @my_season.skipped?,
                            onchange: "this.form.requestSubmit()" %>

            <%= f.label :skipped, "Skip this season", class: "checkbox-row__label" %>
          <% end %>
        <% end %>
      </div>

      <% if current_human.present? && @my_season && !@my_season.skipped? %>
        <% percentage = @my_season.watched_percentage %>
        <div class="watch-progress watch-progress--spaced">
          <div class="watch-progress__labels">
            <span><%= number_to_percentage(percentage, precision: 0) %></span>
          </div>

          <div class="watch-progress__track" title="Season watch progress">
            <div class="watch-progress__bar" style="width: <%= percentage %>%"></div>
          </div>
        </div>
      <% end %>

      <div class="episode-table__wrap">
        <table class="episode-table">
          <thead>
            <tr>
              <th>Number</th>
              <th>Name</th>
              <th>Air date</th>

              <% if current_human.present? %>
                <th>Seen?</th>
              <% end %>
            </tr>
          </thead>

          <tbody>
            <% @episodes.each do |episode| %>
              <tr>
                <td class="episode-table__number">
                  <%= episode.episode_number %>
                </td>

                <td>
                  <%= link_to episode.name, episode_path(@show.slug, @season.slug, episode.episode_number) %>
                </td>

                <td class="episode-table__air-date">
                  <%= render "air_date", episode: episode, available_same_day: @my_show.nil? || @my_show.available_same_day %>
                </td>

                <% if current_human.present? %>
                  <td>
                    <%= form_with url: episode_viewing_path(@show.slug, @season.slug, episode.episode_number),
                                  method: @my_season.episode_watched?(episode.episode_number) ? :delete : :post do |f| %>
                      <%= f.check_box :watched,
                                      checked: @my_season.episode_watched?(episode.episode_number),
                                      disabled: @my_season.skipped?,
                                      onchange: "this.form.requestSubmit()" %>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div>
      <div class="list-header">
        <h2 class="section-heading">Reviews</h2>

        <% if current_human.present? %>
          <%= link_to "Add review", new_season_review_path(@show.slug, @season.slug), class: "rounded-button" %>
        <% end %>
      </div>

      <% if @season_reviews.any? %>
        <div class="season-review-cards">
          <% @season_reviews.each do |review| %>
            <div class="season-review-card">
              <div class="season-review-card__row">
                <div class="season-review-card__meta">
                  <span class="season-review-card__author">
                    <%= review.author.handle %>
                  </span>

                  <% if review.rating.present? %>
                    <div class="season-review-card__rating">
                      <span class="season-review-card__rating-star">★</span>

                      <span class="season-review-card__rating-value">
                        <%= review.rating %>/10
                      </span>
                    </div>
                  <% end %>
                </div>

                <%= link_to l(review.created_at.to_date, format: :default), proper_review_path(review), class: "season-review-card__date-link" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="muted-text">No reviews yet</p>
      <% end %>
    </div>
  </div>

  <%= render "shows/show_metadata", show: @show %>
  <%= render "seasons/season_metadata", season: @season %>
</div>

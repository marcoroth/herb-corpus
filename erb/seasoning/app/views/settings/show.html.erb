<%= content_for :title do %>
  Settings
<% end %>

<div class="page">
  <h1 class="page__title">Settings</h1>

  <%= form_with model: current_human, url: settings_path, method: :patch, class: "settings-form" do |f| %>
    <div>
      <h2 class="section-heading">Profile page</h2>

      <div class="checkbox-row checkbox-row--wide">
        <%= f.checkbox :share_currently_watching, onchange: "this.form.requestSubmit()" %>
        <%= f.label :share_currently_watching, "Share currently watching", class: "checkbox-row__label checkbox-row__label--plain" %>
      </div>
    </div>

    <div>
      <h2 class="section-heading">Reviews</h2>

      <div class="settings-block">
        <div>
          <%= f.label :default_review_visibility, "Default review visibility", class: "field-label" %>

          <%= f.select(
              :default_review_visibility,
              [
                ["Anybody", "anybody"],
                ["Myself", "myself"]
              ],
              {},
              {
                onchange: "this.form.requestSubmit()"
              }
            ) %>
        </div>

        <p class="field-hint">
          This is just a default for new reviews, you can pick another
          visibility on a review-by-review basis!
        </p>
      </div>
    </div>

    <div>
      <h2 class="section-heading">Limits</h2>

      <div>
        <%= f.label :currently_watching_limit, "Currently watching limit", class: "field-label" %>

        <%= f.select(
            :currently_watching_limit,
            [
              [["None", nil]],
              (1..10).map { [it.to_s, it] }
            ].flatten(1),
            {},
            {
              onchange: "this.form.requestSubmit()"
            }
          ) %>
      </div>
    </div>

    <div>
      <h2 class="section-heading">Time zone</h2>

      <div>
        <%= f.label :time_zone_name, "Time zone", class: "field-label" %>

        <%= f.time_zone_select(:time_zone_name, nil, {}, { onchange: "this.form.requestSubmit()" }) %>

        <p class="field-hint field-hint--spaced">
          Where do you watch TV? This determines when episodes become available.
        </p>
      </div>
    </div>
  <% end %>

  <div class="settings-password">
    <h2 class="section-heading">Password</h2>

    <p class="field-hint">
      <% if current_human.uses_password? %>
        You have a password set. You can sign in with either magic links or your
        password.
      <% else %>
        You currently sign in with magic links only. You can optionally set a
        password.
      <% end %>
    </p>

    <%= link_to current_human.uses_password? ? "Change password" : "Set password",
                edit_password_path,
                class: "rounded-button settings-password__link" %>
  </div>
</div>

<!DOCTYPE html>

<html>
  <head>
    <% if content_for?(:title) %>
      <title><%= yield(:title) %>&mdash; Seasoning</title>
    <% else %>
      <title>Seasoning</title>
    <% end %>

    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    >

    <link rel="manifest" href="/manifest.json">

    <meta name="theme-color" content="#ea580c">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="Seasoning">

    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= csp_meta_tag %>

    <style type="text/css">
      body {
        background-color: rgb(246, 246, 247);
      }
    </style>

    <%= stylesheet_link_tag "application" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <div>
      <header class="site-nav">
        <div class="site-nav__home">
          <%= link_to root_path do %>
            <%= image_tag "logo_with_name.svg" %>
          <% end %>
        </div>

        <div class="site-nav__actions">
          <button id="install-app-button" hidden class="rounded-button">
            Install app
          </button>

          <% if current_human.present? %>
            <%= render "show_search_bar" %>
            <%= link_to "Your page", human_profile_path(current_human.handle) %>
            <%= link_to "Settings", settings_path %>
            <%= button_to "Log out", logout_path, method: :delete, class: "link-looking-button", form_class: "inline", data: { turbo_confirm: "Are you sure you want to log out?" } %>
          <% end %>
        </div>
      </header>

      <main class="site-content">
        <div class="site-flash">
          <% flash.each do |key, message| %>
            <div class="flash flash-<%= key %>"><%= message %></div>
          <% end %>
        </div>

        <% if returning_show_notifications.any? || debuting_show_notifications.any? %>
          <div class="site-notifications">
            <% returning_show_notifications.each do |notification| %>
              <div class="notification">
                <p class="notification__message">
                  <%= link_to "#{notification.show.title} is back!", show_path(notification.show.slug), class: "notification__link" %>
                </p>

                <div class="notification__actions">
                  <span class="notification__snooze-label">Snooze</span>
                  <%= button_to "1 week", returning_show_notification_snooze_path(notification), params: { duration: "1_week" }, method: :post, class: "notification__snooze-button", title: "Snooze for 1 week" %>
                  <%= button_to "1 month", returning_show_notification_snooze_path(notification), params: { duration: "1_month" }, method: :post, class: "notification__snooze-button", title: "Snooze for 1 month" %>
                  <%= button_to "×", returning_show_notification_path(notification), method: :delete, class: "notification__dismiss-button", title: "Dismiss notification" %>
                </div>
              </div>
            <% end %>

            <% debuting_show_notifications.each do |notification| %>
              <div class="notification">
                <p class="notification__message">
                  <%= link_to "#{notification.show.title} is here!", show_path(notification.show.slug), class: "notification__link" %>
                </p>

                <div class="notification__actions">
                  <span class="notification__snooze-label">Snooze</span>
                  <%= button_to "1 week", debuting_show_notification_snooze_path(notification), params: { duration: "1_week" }, method: :post, class: "notification__snooze-button", title: "Snooze for 1 week" %>
                  <%= button_to "1 month", debuting_show_notification_snooze_path(notification), params: { duration: "1_month" }, method: :post, class: "notification__snooze-button", title: "Snooze for 1 month" %>
                  <%= button_to "×", debuting_show_notification_path(notification), method: :delete, class: "notification__dismiss-button", title: "Dismiss notification" %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>

        <%= yield %>

        <footer class="site-footer">
          <% if current_human&.admin? %>
            <%= link_to "Admin", admin_path %>
          <% end %>

          <%= link_to "Roadmap", roadmap_path %>
          <%= link_to "Changelog", changelog_path %>
          <%= link_to "Credits", credits_path %>
        </footer>
      </main>
    </div>
  </body>
</html>

<%# locals: (result:) %>

<% if result.already_imported_show %>
  <%= link_to show_path(result.already_imported_show.slug), data: { test_id: "imported-show-#{result.id}" }, class: "result-card__link" do %>
    <div class="result-card">
      <div class="result-card__row">
        <div class="result-card__poster-wrap">
          <%= image_tag result.poster_url, class: "result-card__poster" %>
        </div>

        <div class="result-card__details">
          <div class="result-card__title">
            <%= result.name %>

            <% if result.year %>
              <span class="result-card__year">(<%= result.year %>)</span>
            <% end %>
          </div>

          <div class="result-card__added-by">
            Added by
            <%= pluralize(result.already_imported_show.watchers_count, "person", "people") %>
          </div>
        </div>

        <div class="result-card__arrow">
          →
        </div>
      </div>
    </div>
  <% end %>
<% else %>
  <%= button_to importable_shows_path, params: { id: result.id }, method: :post, class: "result-card__import", data: { test_id: "import-show-#{result.id}" } do %>
    <div class="result-card">
      <div class="result-card__row result-card__row--center">
        <div class="result-card__poster-wrap">
          <%= image_tag result.poster_url, class: "result-card__poster" %>
        </div>

        <div class="result-card__details">
          <div class="result-card__title">
            <%= result.name %>

            <% if result.year %>
              <span class="result-card__year">(<%= result.year %>)</span>
            <% end %>
          </div>
        </div>

        <div class="result-card__plus">
          +
        </div>
      </div>
    </div>
  <% end %>
<% end %>

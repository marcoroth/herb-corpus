<%# locals: (show:) %>

<%= link_to show_path(show.slug), data: { test_id: "imported-show-#{show.tmdb_tv_id}" }, class: "result-card__link" do %>
  <div class="result-card">
    <div class="result-card__row">
      <div class="result-card__poster-wrap">
        <%= image_tag Poster.new(show.tmdb_poster_path).url, class: "result-card__poster" %>
      </div>

      <div class="result-card__details">
        <div class="result-card__title">
          <%= show.title %>

          <% if show.first_air_date.present? %>
            <span class="result-card__year">(<%= show.first_air_date.year %>)</span>
          <% end %>
        </div>

        <div class="result-card__added-by">
          Added by <%= pluralize(show.watchers_count, "person", "people") %>
        </div>
      </div>

      <div class="result-card__arrow">
        →
      </div>
    </div>
  </div>
<% end %>

<%= content_for :title do %>
  Search
<% end %>

<div class="page">
  <h1 class="page__title">Search results</h1>

  <% if @database_results.present? %>
    <div class="search-results">
      <% @database_results.each do |show| %>
        <%= render "database_show_result", show: show %>
      <% end %>
    </div>
    <div class="search-footer">
      <p class="search-footer__hint">
        Not seeing what you're looking for?
      </p>

      <%= link_to "Include results from TMDB", search_path(q: @query, tmdb: 1), class: "search-footer__link" %>
    </div>
  <% elsif @tmdb_results.present? %>
    <div class="search-results">
      <% @tmdb_results.each do |result| %>
        <%= render "tmdb_show_result", result: result %>
      <% end %>
    </div>
  <% else %>
    <p class="muted-text">No results. Try searching something else.</p>
  <% end %>
</div>

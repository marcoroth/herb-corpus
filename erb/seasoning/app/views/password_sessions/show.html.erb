<h1 class="auth-heading auth-heading--spaced">Sign in</h1>

<div class="auth-columns">
  <div data-test-id="password-section">
    <h2 class="auth-heading auth-heading--column">With password</h2>

    <%= form_with url: login_path, method: :post, class: "auth-form" do |f| %>
      <div>
        <%= f.label :email, "Email", class: "auth-label" %>
        <%= f.text_field :email, value: params[:email], placeholder: "email", autocomplete: "email" %>
      </div>

      <div>
        <%= f.label :password, "Password", class: "auth-label" %>
        <%= f.password_field :password, placeholder: "password", autocomplete: "current-password" %>
      </div>

      <div class="auth-actions">
        <%= f.submit "Sign in", class: "rounded-button" %>
      </div>
    <% end %>
  </div>

  <div data-test-id="magic-link-section">
    <h2 class="auth-heading auth-heading--column">With magic link</h2>

    <p class="field-hint">
      We&rsquo;ll send you an email with a link to sign in.
    </p>

    <%= form_with model: @magic_link, url: magic_links_path, class: "auth-form" do |f| %>
      <% if @magic_link.errors.any? %>
        <div>
          <% @magic_link.errors.full_messages.each do |error| %>
            <div class="error-text"><%= error %></div>
          <% end %>
        </div>
      <% end %>

      <div>
        <%= f.label :email, "Email", class: "auth-label" %>
        <%= f.text_field :email, placeholder: "email", autocomplete: "email" %>
      </div>

      <div class="auth-actions">
        <%= f.submit "Send magic link", class: "rounded-button" %>
      </div>
    <% end %>
  </div>
</div>

<div class="auth-footer">
  <p class="field-hint">
    Don't have an account? <%= link_to "Sign up", signup_path %>
  </p>
</div>

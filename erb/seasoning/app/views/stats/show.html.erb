<%= content_for :title do %>
  <%= @human.handle %> &rsquo;s stats for <%= @year %>
<% end %>

<div class="page">
  <div class="stats-header">
    <h1 class="stats-header__title">
      <%= link_to @human.handle, human_profile_path(@human.handle) %> 's
      <%= @year %> stats
    </h1>

    <p class="stats-header__summary">
      <%= @human.handle %> reviewed <%= pluralize(@reviews.count, "season") %>
      <% if @filter == "reviewed-in" %>
        in
      <% else %>
        that aired in
      <% end %>
      <%= @year %>
    </p>
  </div>

  <div class="stats-tabs">
    <%= link_to profile_stat_path(@human.handle, "reviewed-in", @year),
        class: "stats-tab #{'stats-tab--active' if @filter == 'reviewed-in'}",
        "aria-current": (@filter == "reviewed-in" ? "page" : nil) do %>
      Reviewed in <%= @year %>
    <% end %>

    <%= link_to profile_stat_path(@human.handle, "aired-in", @year),
        class: "stats-tab #{'stats-tab--active' if @filter == 'aired-in'}",
        "aria-current": (@filter == "aired-in" ? "page" : nil) do %>
      Aired in <%= @year %>
    <% end %>
  </div>

  <% if @reviews.any? %>
    <% rated_reviews = @reviews.where.not(rating: nil).order(rating: :desc, created_at: :desc).limit(25) %>
    <% if rated_reviews.any? %>
      <div class="top-favorites">
        <h2 class="stats-section-title">
          <%= @human.handle %>'s favorites
        </h2>

        <div class="stats-favorites-list">
          <% rated_reviews.each_with_index do |review, index| %>
            <div class="favorite-item">
              <div class="favorite-item__rank">
                #<%= index + 1 %>
              </div>

              <div class="favorite-item__poster">
                <%= link_to proper_review_path(review), class: "favorite-item__poster-link" do %>
                  <%= render "application/poster", url: review.season.poster.url, show: review.season.show, size: "small" %>
                <% end %>
              </div>

              <div class="favorite-item__details">
                <div class="favorite-item__title">
                  <%= review.season.show.title %> - <%= review.season.name %>
                </div>

                <div class="favorite-item__rating">
                  <%= render "application/star_rating", rating: review.rating %>

                  <span class="favorite-item__rating-value">
                    (<%= review.rating %>/10)
                  </span>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
    <div class="stats-all-reviews">
      <h2 class="stats-section-title">
        <% if @filter == "reviewed-in" %>
          Everything reviewed in
        <% else %>
          Everything that aired in
        <% end %>

        <%= @year %>
      </h2>

      <div class="stats-grid">
        <% @reviews.order(created_at: :asc).each do |review| %>
          <div class="stats-grid__item">
            <%= link_to proper_review_path(review), class: "stats-grid__link", title: "#{review.season.show.title} - #{review.season.name}\nReviewed #{l(review.created_at.to_date)}" do %>
              <%= render "application/poster", url: review.season.poster.url, show: review.season.show, size: "small" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <p class="muted-text stats-empty">No reviews yet!</p>
  <% end %>

  <div class="year-navigation">
    <div>
      <%= link_to "← #{@previous_year}", profile_stat_path(@human.handle, @filter, @previous_year), class: "rounded-button" %>
    </div>

    <div class="stats-year-nav__year"><%= @year %></div>

    <div>
      <% if @has_next_year %>
        <%= link_to "#{@next_year} →", profile_stat_path(@human.handle, @filter, @next_year), class: "rounded-button" %>
      <% end %>
    </div>
  </div>
</div>

<div>
  <% if @magic_link %>
    <h1 class="auth-heading auth-heading--sub">Complete your sign up</h1>
    <p>
      Just one more question... what would you like to be called?
    </p>
    <%= form_with model: @human, class: "auth-form" do |f| %>
      <% if @human.errors.any? %>
        <div>
          <% @human.errors.full_messages.each do |error| %>
            <div class="error-text"><%= error %></div>
          <% end %>
        </div>
      <% end %>

      <div>
        <%= f.text_field :handle, placeholder: "Your handle" %>
      </div>

      <div class="auth-password-section">
        <h2 class="auth-heading auth-heading--minor">
          Optional: Set a password
        </h2>

        <p class="field-hint">
          You can sign in with magic links or a password. Setting a password is
          optional.
        </p>

        <div class="auth-password-fields">
          <div>
            <%= f.label :password, "Password (optional)", class: "field-label field-label--tight" %>
            <%= f.password_field :password, placeholder: "At least 12 characters", autocomplete: "new-password" %>
          </div>

          <div>
            <%= f.label :password_confirmation, "Confirm password", class: "field-label field-label--tight" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
          </div>
        </div>
      </div>

      <%= hidden_field_tag "human[magic_link_token]", @magic_link.token %>
      <%= f.submit "Go", class: "rounded-button" %>
    <% end %>
  <% else %>
    <p>Hmm, that magic link does not seem to be valid.</p>
    <p>Perhaps it has expired.</p>
    <p><%= link_to "Try again?", root_path %></p>
  <% end %>
</div>

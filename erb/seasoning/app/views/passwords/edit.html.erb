<%= content_for :title do %>
  <%= current_human.uses_password? ? "Change password" : "Set password" %>
<% end %>

<div class="page">
  <h1 class="page__title">
    <%= current_human.uses_password? ? "Change password" : "Set password" %>
  </h1>

  <%= form_with model: current_human, url: password_path, method: :patch, class: "auth-form" do |f| %>
    <% if current_human.errors.any? %>
      <div>
        <% current_human.errors.full_messages.each do |error| %>
          <div class="error-text"><%= error %></div>
        <% end %>
      </div>
    <% end %>

    <div>
      <%= f.label :password, "New password", class: "field-label" %>
      <%= f.password_field :password, autocomplete: "new-password" %>

      <p class="field-hint">Minimum 12 characters</p>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm new password", class: "field-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>

    <div class="auth-actions">
      <%= f.submit "Save password", class: "rounded-button" %>
      <%= link_to "Cancel", settings_path %>
    </div>
  <% end %>
</div>

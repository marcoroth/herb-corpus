<%# locals: (rating:) %>

<span role="img" aria-label="<%= rating %> out of 10">
  <%= render "application/star", position: 1, rating: rating %>
  <%= render "application/star", position: 2, rating: rating %>
  <%= render "application/star", position: 3, rating: rating %>
  <%= render "application/star", position: 4, rating: rating %>
  <%= render "application/star", position: 5, rating: rating %>
  <%= render "application/star", position: 6, rating: rating %>
  <%= render "application/star", position: 7, rating: rating %>
  <%= render "application/star", position: 8, rating: rating %>
  <%= render "application/star", position: 9, rating: rating %>
  <%= render "application/star", position: 10, rating: rating %>
</span>

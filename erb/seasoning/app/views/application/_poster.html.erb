<%# locals: (url:, size:, show:, badge: nil) %>

<% if url %>
  <% size_class = {
       "extra-small" => "poster--extra-small",
       "small" => "poster--small",
       "medium" => "poster--medium",
       "full" => "poster--full"
     }.fetch(size, "poster--large") %>
  <div class="poster <%= size_class %>">
    <%= image_tag(
        url,
        alt: "#{show.title} poster",
        class: "poster__image"
      ) %>

    <% if badge %>
      <%= render "episode_badge", badge: badge %>
    <% end %>
  </div>
<% end %>

<% content_for :title do %>
  Admin
<% end %>

<div class="page">
  <h1 class="page__title">Admin</h1>

  <div class="admin-sections">
    <div class="admin-panel">
      <h2 class="section-heading">Stats</h2>

      <ul class="admin-list">
        <li><strong>Humans count:</strong> <%= Human.count %></li>
        <li><strong>Shows count:</strong> <%= Show.count %></li>
        <li><strong>Seasons count:</strong> <%= Season.count %></li>
        <li><strong>Reviews count:</strong> <%= SeasonReview.count %></li>
        <li><strong>Episodes count:</strong> <%= Episode.count %></li>

        <% orphaned_shows = Show.where(orphaned: true) %>

        <% if orphaned_shows.any? %>
          <li>
            <strong>Orphaned shows count:</strong>
            <%= orphaned_shows.count %>

            <ul class="admin-list admin-list--nested">
              <% orphaned_shows.each do |show| %>
                <li><%= link_to show.title, show_path(show.slug) %></li>
              <% end %>
            </ul>
          </li>
        <% end %>

        <% orphaned_seasons = Season.where(orphaned: true).includes(:show) %>

        <% if orphaned_seasons.any? %>
          <li>
            <strong>Orphaned seasons count:</strong>
            <%= orphaned_seasons.count %>

            <ul class="admin-list admin-list--nested">
              <% orphaned_seasons.each do |season| %>
                <li>
                  <%= link_to "#{season.show.title} - #{season.name}", season_path(season.show.slug, season.slug) %>
                </li>
              <% end %>
            </ul>
          </li>
        <% end %>

        <li>
          <strong>Last refreshed TMDB config:</strong>
          <%= TMDBAPIConfiguration.only.fetched_at %>
        </li>
      </ul>
    </div>

    <div class="admin-panel">
      <h2 class="section-heading">Recent humans</h2>

      <ol class="admin-list admin-list--ordered admin-list--tight">
        <% Human.order(created_at: :desc).limit(50).each do |human| %>
          <li><%= link_to human.handle, human_profile_path(human.handle) %></li>
        <% end %>
      </ol>
    </div>
  </div>
</div>

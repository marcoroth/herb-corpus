<% content_for :title do %>
  <%= @show.title %> note to self
<% end %>

<p><%= link_to "← Back", show_path(@show.slug) %></p>

<div class="page">
  <h1 class="page__title page__title--close"><%= @show.title %></h1>

  <h2 class="note-editor__heading">Edit note to self</h2>

  <%= form_with(model: @my_show, url: show_your_show_path(@show.slug), method: :patch, class: "review-form__body") do |f| %>
    <p class="note-editor__intro">
      Put whatever you want in here. It's just for you. Feel free to use
      <%= link_to "Markdown", "https://commonmark.org/help/", target: "_blank", rel: "noreferrer" %>.
    </p>

    <%= f.textarea :note_to_self, placeholder: "Add your personal notes about this show..." %>

    <div class="note-editor__actions">
      <%= f.submit "Update note to self", class: "rounded-button" %>
    </div>
  <% end %>
</div>

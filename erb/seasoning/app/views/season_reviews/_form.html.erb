<%# locals: (show:, season:, review:, form_url:, submit_text:) %>

<div class="page page--narrow">
  <div class="review-form__header">
    <div class="review-form__poster">
      <%= render "poster", url: season.poster.url, show: show, size: "small" %>
    </div>

    <div class="review-form__details">
      <h1 class="page__title page__title--snug"><%= show.title %></h1>
      <h2 class="review-form__season-name"><%= season.name %></h2>
    </div>
  </div>

  <%= form_with model: review, url: form_url, class: "review-form__body" do |form| %>
    <% if review.errors.any? %>
      <div class="form-errors">
        <h3 class="form-errors__heading">Please fix these errors:</h3>

        <ul class="form-errors__list">
          <% review.errors.full_messages.each do |error| %>
            <li>• <%= error %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="review-form__row">
      <div>
        <%= form.label :rating, "Rating", class: "field-label" %>

        <%= form.select :rating,
            options_for_select([
              ["No rating", ""],
              ["⭐ 1 star", 1],
              ["⭐⭐ 2 stars", 2],
              ["⭐⭐⭐ 3 stars", 3],
              ["⭐⭐⭐⭐ 4 stars", 4],
              ["⭐⭐⭐⭐⭐ 5 stars", 5],
              ["⭐⭐⭐⭐⭐⭐ 6 stars", 6],
              ["⭐⭐⭐⭐⭐⭐⭐ 7 stars", 7],
              ["⭐⭐⭐⭐⭐⭐⭐⭐ 8 stars", 8],
              ["⭐⭐⭐⭐⭐⭐⭐⭐⭐ 9 stars", 9],
              ["⭐⭐⭐⭐⭐⭐⭐⭐⭐⭐ 10 stars", 10]
            ], review.rating),
            { include_blank: false },
            { class: "field--full" } %>
      </div>

      <div>
        <%= form.label :visibility, "Visibility", class: "field-label" %>

        <%= form.select :visibility,
            options_for_select([
              ["Public - Anyone can see", "viewable_by_anybody"],
              ["Private - Only you can see", "viewable_by_only_me"]
            ], review.visibility),
            { include_blank: false },
            { class: "field--full" } %>
      </div>
    </div>

    <div>
      <%= form.label :body, class: "field-label" do %>
        Your review
        <span class="field-label__hint">(you can use <%= link_to "Markdown", "https://commonmark.org/help/", target: "_blank", rel: "noreferrer" %>)</span>
      <% end %>

      <%= form.text_area :body,
          
          placeholder: "Share your thoughts about this season..." %>
    </div>

    <div class="review-form__submit">
      <%= form.submit submit_text, class: "rounded-button" %>
    </div>
  <% end %>
</div>

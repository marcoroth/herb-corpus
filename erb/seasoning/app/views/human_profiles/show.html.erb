<%= content_for :title do %>
  <%= @human.handle %>
<% end %>

<div class="page">
  <h1 class="page__title"><%= @human.handle %></h1>

  <div class="profile-sections">
    <% if current_human && current_human != @human %>
      <div>
        <% if (follow = current_human.follows?(@human)) %>
          <%= button_to(
              "Unfollow",
              follow_path(follow),
              class: "rounded-button",
              params: { followee_id: @human.id },
              method: :delete
            ) %>
        <% else %>
          <%= button_to(
              "Follow",
              follows_path,
              class: "rounded-button",
              params: { followee_id: @human.id },
              method: :post
            ) %>
        <% end %>
      </div>
    <% end %>

    <div>
      <p class="profile-joined">
        Joined Seasoning on
        <%= l(@human.created_at.to_date, format: :default) %>
      </p>

      <nav class="profile-nav">
        <div class="profile-nav__tabs">
          <%= link_to "reviews (#{@human.season_reviews.count})", profile_reviews_path(@human.handle), class: "profile-nav__link" %>

          <% if current_human == @human %>
            <%= link_to "Stats", profile_stats_path(@human.handle), class: "profile-nav__link" %>
          <% end %>
        </div>
      </nav>
    </div>

    <% if @human.share_currently_watching? %>
      <div>
        <h2 class="section-heading">
          Currently watching (<%= @human.currently_watching.count %>)
        </h2>

        <% if @human.currently_watching.any? %>
          <% my_shows_by_show_id = if current_human == @human
              current_human.my_shows.currently_watching.index_by(&:show_id)
            else
              {}
            end %>
          <div class="watching-list">
            <% @human.currently_watching.each do |show| %>
              <div class="watching-list__item">
                <%= link_to show_path(show.slug), class: "watching-list__link" do %>
                  <div class="watching-list__poster">
                    <% badge = my_shows_by_show_id[show.id]&.unwatched_episode_badge %>
                    <%= render "poster", size: "small", url: show.poster.url, show: show, badge: badge %>
                  </div>

                  <div class="watching-list__title">
                    <%= show.title %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="muted-text">
            <%= @human.handle %> is not currently watching anything
          </p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<h1 class="auth-heading auth-heading--spaced">Sign up</h1>

<p class="field-hint">
  We'll send you an email with a link to complete your sign up.
</p>

<div data-test-id="signup-form">
  <%= form_with model: @magic_link, url: signup_path, class: "auth-form" do |f| %>
    <% if @magic_link&.errors&.any? %>
      <div>
        <% @magic_link.errors.full_messages.each do |error| %>
          <div class="error-text"><%= error %></div>
        <% end %>
      </div>
    <% end %>

    <div>
      <%= f.label :email, "Email", class: "auth-label" %>
      <%= f.text_field :email, placeholder: "email", autocomplete: "email" %>
    </div>

    <div class="auth-actions">
      <%= f.submit "Send magic link", class: "rounded-button" %>
    </div>
  <% end %>
</div>

<div class="auth-footer">
  <p class="field-hint">
    Already have an account? <%= link_to "Sign in", login_path %>
  </p>
</div>

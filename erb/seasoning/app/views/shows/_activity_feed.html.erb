<%# locals: (activity_reviews:) %>
<div class="panel" data-test-id="activity-feed">
  <h2 class="panel__heading panel__heading--sub">Activity</h2>

  <% if activity_reviews.any? %>
    <div class="activity-list">
      <% activity_reviews.each do |review| %>
        <div class="activity-item">
          <div class="activity-item__poster">
            <%= link_to proper_review_path(review) do %>
              <%= render "poster", url: review.season.poster.url, size: "extra-small", show: review.season.show %>
            <% end %>
          </div>

          <div class="activity-item__text">
            <%= link_to review.author.handle, human_profile_path(review.author.handle), class: "activity-item__name" %>
            reviewed
            <%= link_to review.season.name, season_path(review.season.show.slug, review.season.slug), class: "activity-item__show" %>
            of
            <%= link_to review.season.show.title, show_path(review.season.show.slug), class: "activity-item__show" %>

            <span class="activity-item__time"><%= time_ago_in_words(review.created_at) %> ago</span>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="activity-empty">
      No recent activity from people you follow.
    </p>
  <% end %>
</div>

<%= content_for :title do %>
  <%= @page.title %>
<% end %>

<div class="page">
  <div class="show-page__header">
    <div class="show-page__poster-wrap">
      <%= render "poster", size: "large", url: @page.show.poster.url, show: @page.show %>
    </div>

    <div class="show-page__details">
      <h1 class="page__title page__title--tight show-page__title">
        <%= @page.title %>
      </h1>

      <%= render "more_info", url: @page.tmdb_url %>

      <div class="show-page__actions">
        <% if current_human %>
          <div>
            <%= render "add_or_remove_show", show: @page.show, my_show: @page.my_show %>
          </div>
        <% end %>

        <% if @page.added? %>
          <div class="show-page__action-stack">
            <%= render "choose_show_status_button", my_show: @page.my_show %>

            <% if @page.my_show.snoozed? %>
              <p class="show-page__snooze-note">
                snoozed <%= @page.my_show.snooze_days_remaining %>d 💤
              </p>
            <% end %>

            <%= render "available_same_day", my_show: @page.my_show %>

            <div class="watch-progress">
              <div class="watch-progress__labels">
                <span>
                  <%= number_to_percentage(@page.watched_percentage, precision: 0, round_mode: :down) %>
                </span>
              </div>

              <div class="watch-progress__track" title="Watch progress">
                <div
                  class="watch-progress__bar"
                  style="width: <%= @page.watched_percentage %>%"
                ></div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="page-sections">
    <% if @page.added? %>
      <div><%= render "note_to_self", my_show: @page.my_show %></div>
    <% end %>

    <% if @page.seasons? %>
      <div>
        <div class="list-header">
          <h2 class="section-heading">Seasons</h2>

          <% if @page.skipped_seasons? %>
            <%= form_with url: show_path(@page.slug), method: :get, class: "checkbox-row" do |f| %>
              <%= check_box_tag :include_skipped, "1", @page.include_skipped, onchange: "this.form.requestSubmit()" %>
              <%= f.label :include_skipped, "Show skipped seasons", class: "checkbox-row__label" %>
            <% end %>
          <% end %>
        </div>

        <%= render "seasons_list", show: @page.show, seasons: @page.seasons, my_show: @page.my_show %>
      </div>
    <% else %>
      <div class="show-page__no-seasons">No seasons...</div>
    <% end %>
  </div>

  <%= render "show_metadata", show: @page.show %>
</div>

<%# locals: (show:, seasons:, my_show:) %>

<div class="seasons-grid">
  <% seasons.each do |season| %>
    <% badge = current_human ? season.unwatched_episode_badge_for(current_human, available_same_day: my_show.nil? || my_show.available_same_day) : EpisodeBadge.new(0, 0) %>

    <div class="season-card">
      <%= link_to season_path(show.slug, season.slug), class: "season-card__poster-link" do %>
        <%= render "poster", url: season.poster.url, show: show, size: "full", badge: badge %>
      <% end %>

      <div class="season-card__details">
        <%= link_to season_path(show.slug, season.slug), class: "season-card__link" do %>
          <%= season.name %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

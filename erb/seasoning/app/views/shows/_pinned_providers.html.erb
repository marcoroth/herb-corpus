<%# locals: (providers:, linked: false) %>

<div class="pinned-providers" data-test-id="pinned-providers">
  <span class="pinned-providers__label">📌 Pinned providers</span>

  <% providers.each do |provider| %>
    <% if provider.logo.url %>
      <%= image_tag provider.logo.url, alt: provider.name, title: "Watch on #{provider.name}", class: "pinned-providers__logo", loading: "lazy" %>
    <% else %>
      <span class="pinned-providers__name"><%= provider.name %></span>
    <% end %>
  <% end %>

  <span class="pinned-providers__via" data-test-id="justwatch-attribution">
    (via
    <% if linked %>
      <%= link_to "JustWatch", "https://www.justwatch.com", target: "_blank", rel: "noreferrer" %>)
    <% else %>
      JustWatch)
    <% end %>
  </span>
</div>

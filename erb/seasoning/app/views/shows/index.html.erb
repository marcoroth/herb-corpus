<%= content_for :title do %>
  Your shows
<% end %>

<div class="shows-layout">
  <div class="shows-layout__sidebar">
    <%= render "activity_feed", activity_reviews: @activity_reviews %>
  </div>

  <div class="shows-layout__main">
    <div class="panel panel--roomy">
      <h1 class="panel__heading">Your shows</h1>

      <div class="filter-form">
        <%= form_with(url: shows_path, method: :get) do |f| %>
          <%= f.text_field :q, placeholder: "Filter your shows", class: "filter-form__field", value: @filters.q %>

          <%= f.select(
              :statuses,
              MyShow.statuses.keys.map { [it.humanize, it] },
              {
                multiple: true,
                selected: @filters.statuses
              },
              class: "filter-form__select",
              size: MyShow.statuses.keys.count
            ) %>

          <%= f.submit "Apply filters", class: "rounded-button filter-form__submit" %>
        <% end %>
      </div>

      <% if @my_shows.any? %>
        <div class="show-list">
          <% @my_shows.each do |my_show| %>
            <div class="show-card">
              <% badge = my_show.unwatched_episode_badge %>

              <%= link_to show_path(my_show.show.slug), class: "show-card__link" do %>
                <div class="show-card__body">
                  <div class="show-card__main">
                    <div class="show-card__poster">
                      <%= render "poster", url: my_show.show.poster.url, show: my_show.show, size: "medium", badge: badge %>
                    </div>

                    <div class="show-card__details">
                      <div class="show-card__title-row">
                        <div class="show-card__title">
                          <%= my_show.show.title %>
                        </div>
                      </div>

                      <div class="show-card__status">
                        <%= my_show.status_label %>
                      </div>

                      <% percentage = my_show.watched_percentage %>

                      <div class="progress">
                        <div class="progress__labels">
                          <span>Progress</span>

                          <span>
                            <%= number_to_percentage(percentage, precision: 0, round_mode: :down) %>
                          </span>
                        </div>

                        <div class="progress__track">
                          <div
                            class="progress__bar"
                            style="width: <%= percentage %>%"
                          ></div>
                        </div>
                      </div>
                    </div>

                    <div class="show-card__chevron show-card__chevron--inline">
                      →
                    </div>
                  </div>

                  <div class="show-card__chevron show-card__chevron--trailing">
                    →
                  </div>
                </div>
              <% end %>

              <% if my_show.note_to_self.present? %>
                <div class="note collapsible-note">
                  <input
                    type="checkbox"
                    id="note-toggle-index-<%= my_show.id %>"
                    class="collapsible-note-toggle"
                    checked
                  >

                  <label
                    for="note-toggle-index-<%= my_show.id %>"
                    class="collapsible-note-header"
                  >
                    <span class="collapsible-note-caret note__caret">▶</span>

                    <div class="note__label">
                      Note to self
                    </div>
                  </label>

                  <div class="collapsible-note-content">
                    <div class="note__body rendered-markdown">
                      <%= auto_link(markdown_to_html(my_show.note_to_self)).html_safe %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div>
          No shows yet. Maybe add some via the search at the top of the page?
        </div>
      <% end %>

      <% if @has_previous_page || @has_next_page %>
        <div class="pagination">
          <div>
            <% if @has_previous_page %>
              <%= link_to "← Previous", @filters.previous_page_path %>
            <% end %>
          </div>

          <div class="pagination__page">Page <%= current_page %></div>

          <div>
            <% if @has_next_page %>
              <%= link_to "Next →", @filters.next_page_path %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

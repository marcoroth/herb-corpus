<%# locals: (show:) %>

<div class="metadata-section">
  <h2 class="section-heading">FYI</h2>

  <ul class="metadata-list">
    <% if show.orphaned? %>
      <li class="metadata-list__warning">
        This show is orphaned (no longer in TMDB data)
      </li>
    <% end %>

    <li>
      Added by <%= pluralize(show.watchers_count, "person", "people") %>
    </li>

    <% if show.tmdb_next_refresh_at %>
      <li>
        Data last refreshed
        <time datetime="<%= show.tmdb_last_refreshed_at.iso8601 %>"><%= time_ago_in_words show.tmdb_last_refreshed_at %> ago</time>
      </li>
    <% end %>

    <% if show.tmdb_next_refresh_at %>
      <li>
        Data will next be refreshed in
        <%= distance_of_time_in_words(Time.current, show.estimated_next_refresh_at) %>
      </li>
    <% end %>
  </ul>

  <% if current_human&.admin? %>
    <div class="metadata-section__action">
      <%= button_to "Refresh now!", show_refresh_path(show.slug), method: :post, class: "rounded-button" %>
    </div>
  <% end %>
</div>

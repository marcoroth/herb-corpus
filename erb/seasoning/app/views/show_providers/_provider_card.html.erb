<%# locals: (show_provider:, preference:) %>

<%
  provider = show_provider.provider
  pinned = preference&.pinned?
  hidden = preference&.hidden?
%>

<li
  class="provider-card <% if pinned %> provider-card--pinned <% end %> <% if hidden %> provider-card--hidden <% end %>"
  data-test-id="provider-<%= provider.tmdb_provider_id %>"
>
  <div class="provider-card__header">
    <% if provider.logo.url %>
      <%= image_tag provider.logo.url, alt: "", class: "provider-card__logo", loading: "lazy" %>
    <% end %>

    <span class="provider-card__name">
      <% if pinned %>
        📌
      <% end %><%= provider.name %>
    </span>

    <% if hidden %>
      <span class="provider-card__hidden-tag">Hidden</span>
    <% end %>
  </div>

  <div class="provider-card__actions">
    <% if hidden %>
      <%= button_to "Unhide",
                    provider_preference_path(provider.id),
                    method: :delete,
                    class: "rounded-button provider-card__action",
                    data: { test_id: "unhide-#{provider.tmdb_provider_id}" } %>
    <% else %>
      <% if pinned %>
        <%= button_to "Unpin",
                      provider_preference_path(provider.id),
                      method: :delete,
                      class: "rounded-button provider-card__action",
                      data: { test_id: "unpin-#{provider.tmdb_provider_id}" } %>
      <% else %>
        <%= button_to "Pin",
                      provider_preferences_path,
                      params: { provider_id: provider.id, status: "pinned" },
                      class: "rounded-button provider-card__action",
                      data: { test_id: "pin-#{provider.tmdb_provider_id}" } %>
      <% end %>

      <%= button_to "Hide",
                    provider_preferences_path,
                    params: { provider_id: provider.id, status: "hidden" },
                    class: "rounded-button provider-card__action",
                    data: { test_id: "hide-#{provider.tmdb_provider_id}" } %>
    <% end %>
  </div>
</li>

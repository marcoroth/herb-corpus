<%= content_for :title do %>
  Where to watch <%= @show.title %>
<% end %>

<p><%= link_to "← Back", show_path(@show.slug) %></p>

<div class="page">
  <h1 class="page__title page__title--tight">Where to watch</h1>

  <p class="providers-page__show">
    <%= link_to @show.title, show_path(@show.slug) %>
  </p>

  <% if @show_providers.any? %>
    <% ShowProvider::CATEGORIES.each do |category| %>
      <% category_providers = @show_providers.select { |show_provider| show_provider.category == category } %>
      <% next if category_providers.none? %>

      <section class="providers-page__section">
        <h2 class="section-heading">
          <%= ShowProvider::CATEGORY_LABELS.fetch(category) %>
        </h2>

        <ul class="providers-grid">
          <% category_providers.each do |show_provider| %>
            <li
              class="provider-card"
              data-test-id="provider-<%= show_provider.provider.tmdb_provider_id %>"
            >
              <% if show_provider.provider.logo.url %>
                <%= image_tag show_provider.provider.logo.url, alt: "", class: "provider-card__logo", loading: "lazy" %>
              <% end %>

              <span class="provider-card__name"><%= show_provider.provider.name %></span>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% else %>
    <p class="providers-page__empty" data-test-id="no-providers">
      We don't know of anywhere to watch this show right now.
    </p>
  <% end %>

  <p class="providers-page__attribution" data-test-id="justwatch-attribution">
    Availability data by
    <%= link_to "JustWatch", "https://www.justwatch.com", target: "_blank", rel: "noreferrer" %>,
    via TMDB. US region only, for now.
  </p>
</div>

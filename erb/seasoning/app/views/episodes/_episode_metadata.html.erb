<%# locals: (season:) %>

<% if season.orphaned? %>
  <div class="metadata-section">
    <h2 class="section-heading">Episode info</h2>

    <ul class="metadata-list">
      <li class="metadata-list__warning">
        This episode's season is orphaned (no longer in TMDB data)
      </li>
    </ul>
  </div>
<% end %>

<%= content_for :title do %>
  <%= @profile.handle %> &rsquo;s reviews
<% end %>

<div class="page">
  <h1 class="page__title">
    <%= @profile.handle %>&rsquo;s reviews
  </h1>

  <% if @reviews.any? %>
    <div class="review-list">
      <% @reviews.each do |review| %>
        <div class="review-card">
          <div class="review-card__row">
            <div class="review-card__poster">
              <%= render "poster", url: review.season.poster.url, show: review.season.show, size: "small" %>
            </div>

            <div class="review-card__details">
              <h2 class="review-card__title">
                <%= link_to "#{review.season.show.title} — #{review.season.name}", proper_review_path(review) %>
              </h2>

              <div class="review-card__meta">
                <%= l(review.created_at.to_date, format: :default) %>

                <% if review.viewable_by_only_me? %>
                  <span title="Private review - only you can see this">🔒</span>
                <% end %>
              </div>

              <div class="review-card__rating">
                <% if review.rating %>
                  <%= render "star_rating", rating: review.rating %>
                <% else %>
                  <span class="review-card__no-rating">No rating</span>
                <% end %>
              </div>

              <div>
                <%= link_to "Read full review", proper_review_path(review), class: "rounded-button" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <% if @has_previous_page || @has_next_page %>
      <div class="review-list__pagination">
        <div>
          <% if @has_previous_page %>
            <%= link_to "← Previous", url_for(page: @page - 1) %>
          <% end %>
        </div>

        <div class="review-list__pagination-page">Page <%= @page %></div>

        <div>
          <% if @has_next_page %>
            <%= link_to "Next →", url_for(page: @page + 1) %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <p class="muted-text">No reviews yet!</p>
  <% end %>
</div>

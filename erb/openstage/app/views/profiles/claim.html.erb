<% content_for :title, "@#{@claimed_username} is available on Openstage" %>
<% content_for :main_class, "os-wrap pt-9" %>

<section class="os-panel mx-auto max-w-[680px] p-6 text-center sm:p-11">
  <p class="os-p">@<%= @claimed_username %> isn't on Openstage yet.</p>
  <h1 class="os-h1 mt-2 text-[clamp(32px,4vw,46px)] [overflow-wrap:anywhere]">@<%= @claimed_username %> is available</h1>
  <p class="os-p mt-2.5 text-lg">Build in public. Show your work. Claim this profile.</p>
  <%= button_to "/auth/github", method: :post, data: { turbo: false }, form: { class: "mt-5.5" }, class: "os-btn" do %>
    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
    <span>Sign in with GitHub</span>
  <% end %>
  <%# The same name on GitHub, as the stage it would make, before any sign-in. %>
  <% if previews_on? && @claimed_username.match?(Previews::BuildService::LOGIN) %>
    <div class="mt-6 border-t border-line pt-6">
      <%= render "previews/form", id: "preview-login", value: @claimed_username, form_class: "mx-auto justify-center", button_class: "os-btn2" %>
    </div>
  <% end %>
</section>

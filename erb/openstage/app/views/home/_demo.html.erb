<%# A real page above the fold, drawn by the page's own code: the headline
    number, the share bar and the chart, nothing more. The whole card opens
    the stage it shows (card-link), and its foot names it: the landing's one
    link to a live stage. Its top and its link are two blocks, so the
    landing's grid lines the link up with the sign-in beside it
    (class: the grid's placing). %>
<% totals = section.tally.totals %>
<% shares = section.tally.projects.all.filter_map { |project| [ project, totals.counts[project.repo] ] if totals.counts[project.repo].to_i.positive? } %>
<div class="os-card min-w-0 cursor-pointer p-5 transition-colors hover:border-ink-3 <%= local_assigns[:class] %>" data-controller="card-link"
     data-card-link-url-value="<%= profile_path(user.username) %>" data-action="click->card-link#open">
  <div>
    <div class="flex items-center gap-3">
      <img src="<%= user.avatar_url %>" alt="" class="os-avatar size-10">
      <div class="min-w-0">
        <%= link_to user.display_name, profile_path(user.username), class: "os-h3 block truncate hover:underline" %>
        <div class="os-xs os-muted truncate">openstage.dev/<%= user.username %></div>
      </div>
    </div>

    <div class="mt-3.5 flex items-baseline gap-2.5">
      <span class="os-num text-[52px] leading-none"><%= totals.commits %></span>
      <span class="os-sm os-ink2">commits, <%= section.labels.words %></span>
    </div>
    <% if shares.any? %>
      <div class="os-sharebar mt-3" role="img" aria-label="Share of commits by project">
        <% shares.each do |project, n| %>
          <% color = project_class(project.rank) %>
          <div class="min-w-1.5 <%= "#{color} bg-(--project)" if color %>" style="flex: <%= n %> 1 0" title="<%= project.name %>: <%= pluralize(n, 'commit') %>"></div>
        <% end %>
      </div>
    <% end %>

    <div class="mt-5">
      <%= render "profiles/page/chart", section: section, chart: chart, height: "h-[200px]" %>
    </div>
  </div>

  <%= link_to profile_path(user.username), class: "os-link mt-3 inline-block justify-self-start text-sm", data: { live_stage: true } do %>View this stage <span aria-hidden="true">→</span><% end %>
</div>

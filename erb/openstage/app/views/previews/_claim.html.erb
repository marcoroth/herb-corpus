<%# The preview's sign-in, named as a claim, when a visitor has just seen
    their own projects: the page's one big button, and the small one on the
    bar that follows them down the page (previews/_bar). Tagged preview for
    /admin (SignIns::CountStartService); whoever signs in gets their own
    stage. label: its words; button_class: its size. %>
<%= button_to "/auth/github", method: :post, params: { ref: "preview" }, data: { turbo: false, claim_preview: true },
              class: local_assigns.fetch(:button_class, "os-btn h-[52px] px-6 text-[17px]") do %>
  <%= brand_icon(:github) %><span><%= local_assigns.fetch(:label, "Claim this stage") %></span>
<% end %>

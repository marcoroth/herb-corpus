<% content_for :title, "Analytics — Openstage" %>
<% content_for :wrap, "os-wide" %>
<% content_for :main_class, "os-wide pt-1.5" %>

<%# The page is its builder's alone, so its script draws the whole of it
    (AnalyticsIsland): the title and the window, the tabs, then the tab's
    numbers, chart, table and lists, or on a tab Free does not open, the Go
    Pro view. Under an empty chart, what the builder can do to fill it,
    as far as the tab asks (chart_step). %>
<% if @report %>
  <% serializer = AnalyticsViewSerializer.new(@report) %>
  <% initial = serializer.as_json %>
  <% step = chart_step(current_user, serializer.attributes, steps: @tab.steps) %>
<% else %>
  <% initial = AnalyticsLockedSerializer.new(current_user, @tab).as_json %>
<% end %>
<%= react_island("analytics", { initial: initial, endpoint: api_analytics_path(tab: @tab.param), defaultRange: Progress::Window::DEFAULT,
                                pro: current_user.pro?, step: step }, id: "analytics") %>

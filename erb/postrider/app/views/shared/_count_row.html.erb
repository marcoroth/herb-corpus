<% if count.positive? %>
  <li class="row" tabindex="-1" data-navigable-list-target="item">
    <%= link_to path, class: "row__body flex-item-grow" do %>
      <strong class="row__title"><%= title %></strong>
    <% end %>
    <span class="row__end"><%= number_with_delimiter(count) %></span>
  </li>
<% end %>

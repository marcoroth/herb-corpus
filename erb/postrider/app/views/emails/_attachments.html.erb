<% if attachments.any? %>
  <ul class="rows" aria-label="Attachments">
    <% attachments.each do |blob| %>
      <li class="row">
        <%= link_to rails_blob_url(blob, disposition: "attachment"), class: "row__body", data: { turbo: false } do %>
          <strong class="row__title"><%= blob.filename %></strong>
          <span class="row__meta"><%= [ blob.filename.extension.upcase.presence, number_to_human_size(blob.byte_size) ].compact.join(" · ") %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>

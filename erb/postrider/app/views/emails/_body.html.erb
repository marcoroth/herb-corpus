<%= turbo_frame_tag "email_body" do %>
  <% if parsed_email.text_body.present? %>
    <% if parsed_email.html_alternative? %>
      <p class="txt-small txt-subtle margin-none">Showing the text version. The HTML is in the <%= link_to "original source", mailpiece_original_path(mailpiece, format: :txt), target: "_blank" %>.</p>
    <% end %>
    <div class="email__frame email__frame--text"><%= parsed_email.text_body %></div>
  <% elsif parsed_email.html_only? %>
    <p class="txt-small txt-subtle margin-none">This mail has no text version. <%= link_to "View the original source", mailpiece_original_path(mailpiece, format: :txt), target: "_blank" %></p>
  <% else %>
    <p class="txt-small txt-subtle margin-none">No body content.</p>
  <% end %>
<% end %>

<% @page_title = "Sign in" %>
<% turbo_exempts_page_from_cache %>
<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="panel panel--centered flex flex-column gap-half txt-medium">
  <%= passkey_sign_in_button session_passkey_path, options: @authentication_options,
        error: { class: "txt-negative txt-small", message: "Something went wrong while signing in with your passkey." },
        cancellation: { class: "txt-subtle txt-small", message: "Passkey sign in was cancelled. Try again when you are ready." },
        class: "btn btn--link center txt-medium" do %>
    <%= icon_tag "authentication" %>
    <span>Sign in with a passkey</span>
  <% end %>

  <p class="margin-block-half">
    New device? Open your profile where you're already signed in and use its sign-in link, or ask an admin for one.
    <% if Account.accepting_signups? %>
      <strong>First time?</strong> <%= link_to "Create your account", new_signup_path %>.
    <% end %>
  </p>

  <% if Rails.env.development? %>
    <ul class="list-style-none margin-none unpad flex flex-column gap-half txt-small">
      <% Identity.order(:email_address).each do |identity| %>
        <li><%= link_to "Sign in as #{identity.email_address}", session_transfer_path(identity.transfer_id, script_name: nil) %></li>
      <% end %>
    </ul>
  <% end %>
</div>

<% content_for :footer do %>
  <%= render "sessions/footer" %>
<% end %>

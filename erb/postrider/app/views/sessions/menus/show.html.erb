<% @page_title = "Choose an account" %>
<% turbo_exempts_page_from_cache %>

<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
  <div class="header__actions header__actions--end">
    <%= link_to new_signup_path, class: "btn btn--circle-mobile", aria: { label: "New account" }, data: { turbo_prefetch: false } do %>
      <%= icon_tag "add" %>
      <span>New account</span>
    <% end %>
  </div>
<% end %>

<div class="page flex flex-column gap">
  <% if @accounts.any? %>
    <%= render layout: "shared/filter", locals: { what: "accounts" } do %>
      <% cache [ Current.identity, @accounts ] do %>
        <div data-controller="navigable-list" data-action="keydown->navigable-list#navigate turbo:before-visit@document->navigable-list#rememberSelection turbo:frame-load->navigable-list#forgetSelection"
              data-navigable-list-actionable-items-value="true">
          <ul class="rows">
            <% @accounts.each do |account| %>
              <li id="<%= dom_id account %>" class="row" data-quick-find-target="item" data-navigable-list-target="item" tabindex="-1">
                <%= link_to landing_path(script_name: account.slug), class: "row__body", data: { turbo: false } do %>
                  <strong class="row__title"><%= account.name %></strong>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <div class="blank-slate fit-content center"><strong>You don't have any accounts yet.</strong></div>
  <% end %>
</div>

<% content_for :footer do %>
  <%= render "sessions/footer" %>
<% end %>

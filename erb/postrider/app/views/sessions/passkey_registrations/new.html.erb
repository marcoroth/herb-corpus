<% @page_title = "Create a passkey" %>
<% turbo_exempts_page_from_cache %>
<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="panel panel--centered flex flex-column gap-half txt-medium">
  <p class="margin-none txt-balance">You'll sign in as <strong><%= @identity.email_address %></strong> with your device's fingerprint, face or PIN. No password, no email code.</p>

  <%= passkey_registration_button session_passkey_registration_path, options: @registration_options,
        error: { class: "txt-negative txt-small", message: "Something went wrong while registering your passkey." },
        cancellation: { class: "txt-subtle txt-small", message: "Passkey registration was cancelled. Try again when you are ready." },
        class: "btn btn--link center txt-medium" do %>
    <%= icon_tag "authentication" %>
    <span>Create a passkey</span>
  <% end %>

  <p class="margin-none txt-small txt-subtle">Your browser will prompt you to create a passkey using your device's biometrics, PIN, or security key.</p>
</div>

<% content_for :footer do %>
  <%= render "sessions/footer" %>
<% end %>

<li id="<%= dom_id mailbox %>" class="row" data-quick-find-target="item" data-navigable-list-target="item" tabindex="-1">
  <%= link_to domain_mailbox_path(mailbox.domain, mailbox), class: "row__body" do %>
    <strong class="row__title"><%= mailbox.address %></strong>
    <span class="row__meta"><%= mailbox_row_meta mailbox %></span>
  <% end %>
</li>

<% @page_title = "Mailboxes" %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= link_to "Domains", domains_path %>
      <span class="breadcrumbs__separator">▸</span>
      <%= up_crumb_to @domain.name, domain_path(@domain) %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end">
    <%= new_link_to "New mailbox", new_domain_mailbox_path(@domain) %>
  </div>
<% end %>

<div class="page flex flex-column gap">
  <%= render layout: "shared/filter", locals: { what: "mailboxes" } do %>
    <div data-controller="navigable-list" data-action="keydown->navigable-list#navigate turbo:before-visit@document->navigable-list#rememberSelection turbo:frame-load->navigable-list#forgetSelection"
          data-navigable-list-actionable-items-value="true">
      <ul class="rows rows--links">
        <li class="row" tabindex="-1" data-navigable-list-target="item">
          <%= link_to edit_domain_catch_all_path(@domain), class: "row__body" do %>
            <strong class="row__title">Everything else</strong>
            <span class="row__meta"><%= catch_all_policy_sentence @domain %></span>
          <% end %>
        </li>
      </ul>

      <% if @page.used? %>
        <ul class="rows">
          <%= with_automatic_pagination :mailboxes, @page do %>
            <%= render partial: "mailboxes/mailbox", collection: @page.records %>
          <% end %>
        </ul>
      <% else %>
        <div class="blank-slate fit-content center"><strong>No mailboxes yet.</strong></div>
      <% end %>
    </div>
  <% end %>
</div>

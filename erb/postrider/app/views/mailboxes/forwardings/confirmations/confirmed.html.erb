<% @page_title = "Forwarding confirmed" %>
<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="panel panel--centered flex flex-column gap-half">
  <p class="margin-none">Mail sent to <strong><%= @mailbox.address %></strong> will now be forwarded to <strong><%= @mailbox.forward_to %></strong>.</p>
  <p class="margin-none">Nothing else is needed from you. To stop the forwarding, ask whoever looks after <%= @mailbox.domain.name %> to turn it off.</p>
  <% if support_email_address %>
    <p class="txt-small txt-subtle margin-none">Need help? <%= mail_to support_email_address, "Send us an email" %>.</p>
  <% end %>
</div>

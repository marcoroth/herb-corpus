<% @page_title = "Link expired" %>
<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="panel panel--centered flex flex-column gap-half">
  <p class="margin-none">That confirmation link is no longer valid. Links expire after 24 hours, and a link stops working once the forwarding destination changes.</p>
  <p class="margin-none">Nothing sent to <strong><%= @mailbox.address %></strong> is being forwarded. Ask whoever looks after <%= @mailbox.domain.name %> to save the forwarding address again, and we'll send a fresh link.</p>
  <% if support_email_address %>
    <p class="txt-small txt-subtle margin-none">If you get stuck, <%= mail_to support_email_address, "send us an email" %> and we'll get you back on track.</p>
  <% end %>
</div>

<% @page_title = "Confirming forwarding" %>
<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="panel panel--centered flex flex-column gap-half">
  <p class="margin-none">Just a moment while we confirm that mail for <strong><%= @mailbox.address %></strong> may be forwarded to <strong><%= @mailbox.forward_to %></strong>.</p>

  <%= auto_submit_form_with url: domain_mailbox_forwarding_confirmation_path(@domain, @mailbox, params[:forwarding_token]), method: :post, class: "flex flex-column" do |form| %>
    <%= form.hidden_field :forwarding_token, value: params[:forwarding_token] %>
    <%= form.button "Confirm", type: "submit", class: "btn btn--link center" %>
  <% end %>
</div>

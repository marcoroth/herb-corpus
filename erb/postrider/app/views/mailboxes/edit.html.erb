<% @page_title = "Forwarding for #{@mailbox.address}" %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= link_to "Domains", domains_path %>
      <span class="breadcrumbs__separator">▸</span>
      <%= link_to @domain.name, domain_path(@domain) %>
      <span class="breadcrumbs__separator">▸</span>
      <%= link_to "Mailboxes", domain_mailboxes_path(@domain) %>
      <span class="breadcrumbs__separator">▸</span>
      <%= up_crumb_to @mailbox.address, domain_mailbox_path(@domain, @mailbox) %>
      <strong>Forwarding</strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <div class="panel shadow">
    <%= form_with model: @mailbox, url: domain_mailbox_path(@domain, @mailbox), class: "flex flex-column gap" do |form| %>
      <%= render "shared/errors", record: @mailbox %>

      <div class="flex flex-column gap-half">
        <%= form.label :forward_to do %>
          <strong>Forward to</strong><br>
          <p class="margin-none txt-x-small txt-subtle">We'll email this address a confirmation link, good for 24 hours. Screened-in mail is forwarded only after it's confirmed. Leave blank to stop forwarding.<% unless @domain.verified? %> Verify this domain's DKIM, then send the confirmation.<% end %></p>
        <% end %>
        <%= form.email_field :forward_to, autofocus: true, class: "input", placeholder: "you@example.com" %>
      </div>

      <div class="flex gap-half">
        <%= form.button "Save", type: "submit", class: "btn btn--link" %>
      </div>
    <% end %>
  </div>
</div>

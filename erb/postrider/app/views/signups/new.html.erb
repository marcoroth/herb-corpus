<% @page_title = "Create your account" %>
<% turbo_exempts_page_from_cache %>

<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="panel panel--centered flex flex-column gap-half">
  <%= form_with model: @signup, url: signup_path, scope: "signup", class: "flex flex-column gap-half txt-medium" do |form| %>
    <div class="flex flex-column gap-half txt-align-start">
      <label for="signup_email_address"><strong>Email</strong></label>
      <%= form.email_field :email_address, id: "signup_email_address", required: true, autofocus: true, autocomplete: "username", placeholder: "Enter your email address…", class: "input txt-large full-width" %>
    </div>

    <p class="margin-block-half">Next, you'll create a passkey to sign in.</p>

    <%= form.button "Continue", type: "submit", class: "btn btn--link center txt-medium" %>
  <% end %>
</div>

<% content_for :footer do %>
  <%= render "sessions/footer" %>
<% end %>

<% @page_title = "Complete your registration" %>
<% turbo_exempts_page_from_cache %>

<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="panel panel--centered flex flex-column gap-half">
  <%= form_with model: @signup, url: signup_completion_path, scope: "signup", class: "flex flex-column gap-half txt-medium" do |form| %>
    <%= render "shared/errors", record: @signup %>

    <div class="flex flex-column gap-half txt-align-start">
      <%= form.label :full_name do %>
        <strong>Full name</strong>
      <% end %>
      <%= form.text_field :full_name, id: "signup_full_name", required: true, autofocus: true, autocomplete: "name", placeholder: "Your name…", maxlength: 240, class: "input txt-large full-width" %>
    </div>

    <p class="margin-block-half">We'll create your account with your name and take you in.</p>

    <%= form.button "Continue", type: "submit", class: "btn btn--link center txt-medium" %>
  <% end %>
</div>

<% content_for :footer do %>
  <%= render "sessions/footer" %>
<% end %>

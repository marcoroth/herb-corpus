<% @page_title = "Delete account" %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= up_crumb_to "Settings", account_settings_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page">
  <div class="settings">
    <div class="settings__panel panel shadow">
      <% if Current.account.cancellable? %>
        <section class="settings__section settings__section--negative">
          <header>
            <h2 class="divider">Danger zone</h2>
            <div>Deletes <%= Current.account.name %> and all its data. This cannot be undone.</div>
          </header>

          <div class="flex gap-half">
            <%= button_to "Delete account…", account_cancellation_path, method: :post, class: "btn btn--negative",
                  data: { turbo_confirm: "Are you sure you want to permanently delete this account and all its data?" } %>
            <%= link_to "Cancel and go back", account_settings_path, class: "btn borderless" %>
          </div>
        </section>
      <% else %>
        <section class="settings__section">
          <p class="margin-none">This account cannot be deleted.</p>
        </section>
      <% end %>
    </div>
  </div>
</div>

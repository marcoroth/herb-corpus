<%# locals: (rows:) %>

<ul class="rows settings__rows">
  <% rows.each do |row| %>
    <li class="row" data-quick-find-target="item" data-navigable-list-target="item" tabindex="-1">
      <%= icon_tag row[:icon], class: "settings__icon" %>
      <%= link_to row[:path], class: "row__body" do %>
        <% if row[:hint] %>
          <strong class="row__title"><%= row[:title] %></strong>
          <span class="row__meta row__meta--wrap"><%= row[:hint] %></span>
        <% else %>
          <strong class="row__title row__title--wrap"><%= row[:title] %></strong>
        <% end %>
      <% end %>
    </li>
  <% end %>
</ul>

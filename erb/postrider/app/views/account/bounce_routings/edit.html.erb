<% @page_title = "Bounce routing" %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= up_crumb_to "Settings", account_settings_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page">
  <div class="settings">
    <div class="settings__panel panel shadow">
      <section class="settings__section">
        <%= form_with model: @setting, url: account_bounce_routing_path, method: :patch, class: "flex flex-column gap" do |form| %>
          <%= render "shared/errors", record: @setting %>

          <div class="flex flex-column gap-half">
            <%= form.label :bounce_address do %>
              <strong>Bounce address</strong>
            <% end %>
            <%= form.email_field :bounce_address, class: "input", placeholder: "bounces@lists.example.com" %>
          </div>

          <div class="flex gap-half">
            <%= form.button "Save", type: "submit", class: "btn btn--link" %>
            <%= link_to "Cancel and go back", account_settings_path, class: "btn borderless" %>
          </div>
        <% end %>
      </section>
    </div>
  </div>
</div>

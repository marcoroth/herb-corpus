<% @page_title = "This invitation link can no longer be used" %>
<% turbo_exempts_page_from_cache %>
<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <p class="margin-none">It has been used as many times as it allowed. Ask someone at <%= @join_code.account.name %> for a new link.</p>
</div>

<% content_for :footer do %>
  <%= render "sessions/footer" %>
<% end %>

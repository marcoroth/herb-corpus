<li id="<%= dom_id sending_token %>" class="row" data-quick-find-target="item" data-navigable-list-target="item" tabindex="-1">
  <%= link_to domain_sending_token_path(sending_token.domain, sending_token), class: "row__body" do %>
    <strong class="row__title"><%= sending_token.name %></strong>
    <span class="row__meta">
      <%= sending_token.domain.name %> ·
      <% if sending_token.last_used_at? %>
        Last used <%= local_datetime_tag sending_token.last_used_at, style: :datetime %>
      <% else %>
        Never used
      <% end %>
    </span>
  <% end %>
</li>

<% @page_title = "New sending token" %>
<% turbo_exempts_page_from_cache %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= link_to "Domains", domains_path %>
      <span class="breadcrumbs__separator">▸</span>
      <%= link_to @domain.name, domain_path(@domain) %>
      <span class="breadcrumbs__separator">▸</span>
      <%= up_crumb_to "Sending tokens", domain_sending_tokens_path(@domain) %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <div id="new_sending_token" class="panel shadow">
    <%= form_with model: @sending_token, url: domain_sending_tokens_path(@domain), class: "flex flex-column gap" do |form| %>
      <%= render "shared/errors", record: @sending_token %>

      <h2 class="txt-large margin-none">
        <%= form.text_field :name, required: true, autofocus: true, class: "input", placeholder: "Name this sending token…" %>
      </h2>

      <div class="flex gap-half">
        <%= form.button "Create sending token", type: "submit", class: "btn btn--link" %>
        <%= link_to "Cancel and go back", domain_sending_tokens_path(@domain), class: "btn borderless" %>
      </div>
    <% end %>
  </div>
</div>

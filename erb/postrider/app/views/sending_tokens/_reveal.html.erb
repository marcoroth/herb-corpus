<div id="new_sending_token" class="panel shadow flex flex-column gap-half" data-turbo-temporary>
  <label class="flex flex-column gap-half">
    <strong>Token (shown once)</strong>
    <input type="text" value="<%= sending_token.token %>" class="input txt-mono" readonly>
  </label>

  <p class="txt-small txt-subtle margin-none">Use it as the SMTP password, or as a Bearer token for the API. It cannot be shown again.</p>

  <div class="flex gap-half">
    <%= button_to_copy_to_clipboard sending_token.token do %>
      <%= icon_tag "copy-paste" %>
      <span>Copy token</span>
    <% end %>
  </div>
</div>

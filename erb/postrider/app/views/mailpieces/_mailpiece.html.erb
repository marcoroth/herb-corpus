<li id="<%= dom_id mailpiece %>" class="row" data-quick-find-target="item" data-navigable-list-target="item" tabindex="-1">
  <%= link_to mailpiece_path(mailpiece), class: "row__body" do %>
    <strong class="row__title"><%= mailpiece.subject.presence || "(no subject)" %></strong>
    <span class="row__meta"><%= mailpiece_meta mailpiece %></span>
  <% end %>
</li>

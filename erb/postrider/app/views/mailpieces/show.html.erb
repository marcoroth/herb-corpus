<% @page_title = @mailpiece.subject.presence || "(no subject)" %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= up_crumb_to "Mailpieces", root_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end">
    <% if @postable.raw_email.attached? %>
      <%= toolbar_button "Original", mailpiece_original_path(@mailpiece, format: :txt), icon: "link", target: "_blank" %>
    <% end %>
  </div>
<% end %>

<% if @mailpiece.inbound_email? %>
  <%= render "mailpieces/inbound_email", mailpiece: @mailpiece, inbound_email: @postable %>
<% else %>
  <%= render "mailpieces/delivery", mailpiece: @mailpiece, delivery: @postable %>
<% end %>

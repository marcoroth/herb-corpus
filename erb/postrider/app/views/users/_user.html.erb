<li id="<%= dom_id user %>" class="row" data-quick-find-target="item" data-navigable-list-target="item" tabindex="-1">
  <%= link_to user, class: "row__body flex-item-grow" do %>
    <strong class="row__title"><%= user.name %></strong>
    <span class="row__meta"><%= user.identity.email_address %> · <%= user.role.humanize %></span>
  <% end %>

  <%# Labelled by attribute, not by text: the filter matches on the row's text content. %>
  <span class="step__actions">
    <%# Rendered disabled rather than left out: Shift+Enter on a navigable row reads its checkbox without a null check. %>
    <%= form_with model: user, url: user_role_path(user), method: :patch, data: { controller: "form" } do |form| %>
      <span title="<%= user.role.humanize %>">
        <label class="btn btn--circle" for="<%= dom_id(user, :role) %>" aria-label="Role of <%= user.name %>: <%= user.role.humanize %>">
          <%= icon_tag "crown" %>
          <%= form.check_box :role, { data: { action: "change->form#submit" }, disabled: !Current.user.can_administer?(user), checked: user.admin?, hidden: true, id: dom_id(user, :role) }, "admin", "member" %>
        </label>
      </span>
    <% end %>

    <% if Current.user.can_administer?(user) %>
      <%= button_to user, method: :delete, class: "btn btn--circle", aria: { label: "Remove #{user.name}" },
            data: { turbo_confirm: "Are you sure you want to permanently remove #{user.name} from the account?" } do %>
        <%= icon_tag "trash" %>
      <% end %>
    <% end %>
  </span>
</li>

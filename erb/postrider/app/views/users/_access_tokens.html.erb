<li class="row">
  <%= link_to my_access_tokens_path, class: "row__body flex-item-grow" do %>
    <strong class="row__title">Personal access tokens</strong>
    <span class="row__meta">For using the PostRider API.</span>
  <% end %>

  <span class="row__end"><%= count.zero? ? "None yet" : pluralize(count, "token") %></span>
</li>

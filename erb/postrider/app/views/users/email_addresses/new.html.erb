<% @page_title = "Change your email" %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= link_to "Settings", account_settings_path %>
      <span class="breadcrumbs__separator">▸</span>
      <%= up_crumb_to "Profile", user_path(@user, script_name: @user.account.slug) %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <div class="panel shadow">
    <%= form_with url: user_email_addresses_path(user_id: @user.id), method: :post, class: "flex flex-column gap", data: { turbo: false } do |form| %>
      <div class="flex flex-column gap-half">
        <label for="email_address">
          <strong>New email address</strong><br>
          <p class="margin-none txt-x-small txt-subtle">It changes in every account you belong to. Your passkeys keep working.</p>
        </label>
        <%= form.email_field :email_address, id: "email_address", autocomplete: "email", placeholder: "New email address", autofocus: true, required: true, class: "input" %>
      </div>

      <div class="flex gap-half">
        <%= form.button "Save", type: "submit", class: "btn btn--link" %>
        <%= link_to "Cancel and go back", user_path(@user, script_name: @user.account.slug), class: "btn borderless" %>
      </div>
    <% end %>
  </div>
</div>

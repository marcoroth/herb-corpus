<% @page_title = "What's your name?" %>
<% turbo_exempts_page_from_cache %>
<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="panel panel--centered flex flex-column gap-half">
  <%= form_with scope: "user", url: users_joins_path, class: "flex flex-column gap-half txt-medium" do |form| %>
    <div class="flex flex-column gap-half txt-align-start">
      <label for="user_name"><strong>Full name</strong></label>
      <%= form.text_field :name, id: "user_name", autocomplete: "name", placeholder: "Your name…", autofocus: true, required: true, class: "input txt-large full-width" %>
    </div>
    <%= form.button "Continue", type: "submit", class: "btn btn--link center txt-medium" %>
  <% end %>
</div>

<% content_for :footer do %>
  <%= render "sessions/footer" %>
<% end %>

<% @page_title = @user.name_in_database %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <% if Current.user == @user %>
        <%= up_crumb_to "Settings", account_settings_path %>
      <% else %>
        <%= link_to "Settings", account_settings_path %>
        <span class="breadcrumbs__separator">▸</span>
        <%= up_crumb_to "People", users_path %>
      <% end %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page">
  <div class="settings settings--profile">
    <div class="settings__panel panel shadow">
      <%= render "users/identity", user: @user %>

      <% if Current.user == @user %>
        <section class="settings__section">
          <header>
            <h2 class="divider txt-medium txt-tight-lines">Signing in</h2>
          </header>

          <ul class="rows">
            <%= render "users/passkeys", count: Current.identity.passkeys.count %>
            <%= render "users/access_tokens", count: Current.identity.access_tokens.count %>
          </ul>
        </section>

        <%= render "users/transfer", user: @user %>
        <%= render "users/theme" %>

        <section class="settings__section">
          <header>
            <h2 class="divider txt-medium txt-tight-lines">Sign out</h2>
          </header>

          <div class="flex flex-wrap gap">
            <%= button_to "Sign out", session_path(script_name: nil), method: :delete, class: "btn", form: { data: { turbo: false, controller: "clear-offline-cache", action: "submit->clear-offline-cache#clearCache" } } %>
            <%= button_to "Sign out of all other devices", my_other_sessions_path, method: :delete, class: "btn" %>
          </div>
        </section>
      <% elsif Current.user.can_let_back_in?(@user) %>
        <%= render "users/transfer", user: @user %>
      <% end %>
    </div>
  </div>
</div>

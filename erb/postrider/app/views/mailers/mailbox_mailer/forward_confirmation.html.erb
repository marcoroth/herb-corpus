<tr>
  <td>
    <h1 class="title">Confirm email forwarding</h1>
    <p class="subtitle">Someone asked for mail sent to <strong><%= @mailbox.address %></strong> to be forwarded to <strong><%= @mailbox.forward_to %></strong>. Nothing will be forwarded until that is confirmed.</p>

    <p><%= link_to "Confirm forwarding to #{@mailbox.forward_to}", domain_mailbox_forwarding_confirmation_url(@mailbox.domain, @mailbox, script_name: @mailbox.account.slug, forwarding_token: @token) %></p>

    <p>This link will work for 24 hours. Nothing will be forwarded to <%= @mailbox.forward_to %> unless it's used, so you can ignore this email.</p>

    <% if support_email_address %>
      <p class="footer">Need help? <%= mail_to support_email_address, "Send us an email" %>.
      </p>
    <% end %>
  </td>
</tr>

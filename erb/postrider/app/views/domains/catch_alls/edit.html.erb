<% @page_title = "Everything else" %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= link_to "Domains", domains_path %>
      <span class="breadcrumbs__separator">▸</span>
      <%= link_to @domain.name, domain_path(@domain) %>
      <span class="breadcrumbs__separator">▸</span>
      <%= up_crumb_to "Mailboxes", domain_mailboxes_path(@domain) %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <div class="panel shadow">
    <%= form_with model: @domain, url: domain_catch_all_path(@domain), method: :patch, class: "flex flex-column gap" do |form| %>
      <div class="flex flex-column gap-half">
        <%= form.label :catch_all_policy do %>
          <strong>Mail for an address with no mailbox</strong>
        <% end %>
        <%= form.select :catch_all_policy, catch_all_policy_options, {}, class: "input input--select" %>
      </div>

      <div class="flex gap-half">
        <%= form.button "Save", type: "submit", class: "btn btn--link" %>
        <%= link_to "Cancel and go back", domain_mailboxes_path(@domain), class: "btn borderless" %>
      </div>
    <% end %>
  </div>
</div>

<% @page_title = "Blocked phrases" %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= link_to "Domains", domains_path %>
      <span class="breadcrumbs__separator">▸</span>
      <%= link_to @domain.name, domain_path(@domain) %>
      <span class="breadcrumbs__separator">▸</span>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <div class="panel shadow">
    <%= form_with model: @domain, url: domain_blocked_phrases_path(@domain), method: :patch, class: "flex flex-column gap" do |form| %>
      <%= render "shared/errors", record: @domain %>

      <p class="margin-none">A message sent from this domain is not delivered when its subject or its content contains one of these phrases. The sending app is not told.</p>

      <div class="flex flex-column gap-half">
        <%= form.label :blocked_phrases do %>
          <strong>One phrase per line</strong><br>
          <p class="margin-none txt-x-small txt-subtle">Capitals, accents and punctuation are ignored. A phrase needs at least <%= Domain::MIN_PHRASE_LENGTH %> characters.</p>
        <% end %>
        <%= form.text_area :blocked_phrases, rows: 8, autofocus: true, class: "input" %>
      </div>

      <div class="flex gap-half">
        <%= form.button "Save blocked phrases", type: "submit", class: "btn btn--link" %>
      </div>
    <% end %>
  </div>
</div>

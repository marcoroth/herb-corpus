<%# locals: (listing:) %>

<div class="dns-item <%= "dns-item--found" if listing.found? %>">
  <div class="dns-item__head">
    <strong><%= listing.title %></strong>
    <span class="chip"><%= listing.record.type %></span>
    <%= dns_status_tag listing.status if listing.checked? %>
  </div>

  <% if listing.error.present? %>
    <p class="dns-item__error"><%= listing.error %></p>
  <% end %>

  <div class="dns-item__line cursor-pointer" title="Click to copy" data-controller="copy-link" data-action="click->copy-link#copy"
       data-copy-link-content-value="<%= listing.record.hostname %>" data-copy-link-copied-value="Copied to clipboard">
    <%= text_field_tag nil, listing.record.hostname, readonly: true, id: nil, class: "input full-width txt-small txt-mono cursor-pointer", aria: { label: "Name" },
          data: { action: "focus->copy-link#select" } %>
    <%= icon_tag "copy-paste", data: { copy_link_target: "icon" } %>
  </div>

  <div class="dns-item__line cursor-pointer" title="Click to copy" data-controller="copy-link" data-action="click->copy-link#copy"
       data-copy-link-content-value="<%= listing.record.value %>" data-copy-link-copied-value="Copied to clipboard">
    <%= text_field_tag nil, listing.record.value, readonly: true, id: nil, class: "input full-width txt-small txt-mono cursor-pointer", aria: { label: "Value" },
          data: { action: "focus->copy-link#select" } %>
    <%= icon_tag "copy-paste", data: { copy_link_target: "icon" } %>
  </div>
</div>

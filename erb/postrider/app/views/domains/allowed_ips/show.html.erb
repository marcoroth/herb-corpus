<% @page_title = "Allowed IPs" %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= link_to "Domains", domains_path %>
      <span class="breadcrumbs__separator">▸</span>
      <%= link_to @domain.name, domain_path(@domain) %>
      <span class="breadcrumbs__separator">▸</span>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <div class="panel shadow">
    <%= form_with model: @domain, url: domain_allowed_ips_path(@domain), method: :patch, class: "flex flex-column gap" do |form| %>
      <%= render "shared/errors", record: @domain %>

      <p class="margin-none">Only these addresses can send with this domain's sending tokens, through the HTTP API or SMTP. Leave it empty to allow any address.</p>

      <div class="flex flex-column gap-half">
        <%= form.label :allowed_ips do %>
          <strong>One IPv4 address or range per line</strong><br>
          <p class="margin-none txt-x-small txt-subtle">Use CIDR for a range, like 203.0.113.0/24. Up to <%= Domain::MAX_ALLOWED_IPS %> lines.</p>
        <% end %>
        <%= form.text_area :allowed_ips, rows: 8, autofocus: true, class: "input" %>
      </div>

      <div class="flex gap-half">
        <%= form.button "Save allowed IPs", type: "submit", class: "btn btn--link" %>
      </div>
    <% end %>
  </div>
</div>

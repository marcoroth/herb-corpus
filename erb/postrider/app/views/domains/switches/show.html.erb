<% @page_title = "Receiving and sending" %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= link_to "Domains", domains_path %>
      <span class="breadcrumbs__separator">▸</span>
      <%= link_to @domain.name, domain_path(@domain) %>
      <span class="breadcrumbs__separator">▸</span>
      <%= up_crumb_to "Settings", edit_domain_path(@domain) %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page settings-index">
  <div class="settings-index__card panel shadow">
    <section>
      <h2 class="settings-index__heading">Receiving and sending</h2>
      <div class="settings-index__body">
        <ul class="rows" style="--rows-margin: 0; --rows-padding: 0; --rows-border-size: 0; --rows-shadow: none; --rows-bg: transparent">
          <li class="row">
            <div class="row__body flex-item-grow">
              <strong class="row__title">Receive mail for <%= @domain.name %></strong>
              <span class="row__meta"><%= @domain.receiving? ? "Mailboxes, forwards and the catch-all policy apply as set" : "Off. Senders get a permanent error." %></span>
            </div>
            <span class="row__end">
              <%= form_with url: domain_receiving_path(@domain), method: (@domain.receiving? ? :delete : :post), class: "display-contents", data: { controller: "form" } do %>
                <label class="switch">
                  <%= check_box_tag "receiving", "1", @domain.receiving?, class: "switch__input", data: { action: "change->form#submit" } %>
                  <span class="switch__btn"></span>
                  <span class="for-screen-reader">Receive mail for this domain</span>
                </label>
              <% end %>
            </span>
          </li>

          <li class="row">
            <div class="row__body flex-item-grow">
              <strong class="row__title">Send mail from <%= @domain.name %></strong>
              <span class="row__meta"><%= @domain.sending? ? "Sending tokens and the API work as set" : "Off. New mail is refused." %></span>
            </div>
            <span class="row__end">
              <%= form_with url: domain_sending_path(@domain), method: (@domain.sending? ? :delete : :post), class: "display-contents", data: { controller: "form" } do %>
                <label class="switch">
                  <%= check_box_tag "sending", "1", @domain.sending?, class: "switch__input", data: { action: "change->form#submit" } %>
                  <span class="switch__btn"></span>
                  <span class="for-screen-reader">Send mail from this domain</span>
                </label>
              <% end %>
            </span>
          </li>

          <li class="row">
            <div class="row__body flex-item-grow">
              <strong class="row__title">This is a bulk sending domain</strong>
              <span class="row__meta"><%= @domain.bulk? ? "Bulk: paced per mail provider" : "Transactional: sent right away" %></span>
            </div>
            <span class="row__end">
              <%= form_with url: domain_bulk_path(@domain), method: (@domain.bulk? ? :delete : :post), class: "display-contents", data: { controller: "form" } do %>
                <label class="switch">
                  <%= check_box_tag "bulk", "1", @domain.bulk?, class: "switch__input", data: { action: "change->form#submit" } %>
                  <span class="switch__btn"></span>
                  <span class="for-screen-reader">This is a bulk sending domain</span>
                </label>
              <% end %>
            </span>
          </li>
        </ul>
      </div>
    </section>
  </div>
</div>

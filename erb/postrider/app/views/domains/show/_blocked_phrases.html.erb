<% blocked_phrases = domain.blocked_phrase_list.first(4) %>

<%= tool_tag "Blocked phrases", domain_blocked_phrases_path(domain) do %>
  <% if blocked_phrases.any? %>
    <ul class="rows">
      <% blocked_phrases.each do |phrase| %>
        <%= tool_row_tag phrase %>
      <% end %>
    </ul>

    <%= tool_more_tag domain.blocked_phrase_list, blocked_phrases %>
  <% else %>
    <div class="blank-slate blank-slate--small"><strong>No blocked phrases yet.</strong> Open to add one.</div>
  <% end %>
<% end %>

<% mailboxes = domain.mailboxes.ordered.limit(4).to_a %>

<%= tool_tag "Mailboxes", domain_mailboxes_path(domain) do %>
  <% if mailboxes.any? %>
    <ul class="rows">
      <% mailboxes.each do |mailbox| %>
        <%= tool_row_tag mailbox.local_part, meta: mailbox_row_state(mailbox) %>
      <% end %>
    </ul>

    <%= tool_more_tag domain.mailboxes, mailboxes %>
  <% else %>
    <div class="blank-slate blank-slate--small"><strong>No mailboxes yet.</strong> Open to add one.</div>
  <% end %>
<% end %>

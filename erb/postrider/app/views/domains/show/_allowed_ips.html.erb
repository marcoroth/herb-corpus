<% allowed_ips = domain.allowed_ip_list.first(4) %>

<%= tool_tag "Allowed IPs", domain_allowed_ips_path(domain) do %>
  <% if allowed_ips.any? %>
    <ul class="rows">
      <% allowed_ips.each do |allowed_ip| %>
        <%= tool_row_tag allowed_ip %>
      <% end %>
    </ul>

    <%= tool_more_tag domain.allowed_ip_list, allowed_ips %>
  <% else %>
    <div class="blank-slate blank-slate--small"><strong>Any IP can send through the API.</strong> Open to restrict it.</div>
  <% end %>
<% end %>

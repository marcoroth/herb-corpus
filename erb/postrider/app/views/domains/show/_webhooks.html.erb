<% webhooks = domain.webhooks.ordered.limit(4).to_a %>

<%= tool_tag "Webhooks", domain_webhooks_path(domain) do %>
  <% if webhooks.any? %>
    <ul class="rows">
      <% webhooks.each do |webhook| %>
        <% if webhook.active? %>
          <%= tool_row_tag webhook.name.presence || webhook.url, meta: few_to_sentence(webhook.subscribed_actions.map { |action| webhook_action_label(action) }) %>
        <% else %>
          <%= tool_row_tag webhook.name.presence || webhook.url, meta: "Inactive", inactive: true %>
        <% end %>
      <% end %>
    </ul>

    <%= tool_more_tag domain.webhooks, webhooks %>
  <% else %>
    <div class="blank-slate blank-slate--small"><strong>No webhooks yet.</strong> Open to add one.</div>
  <% end %>
<% end %>

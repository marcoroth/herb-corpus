<% sending_tokens = domain.sending_tokens.ordered.limit(4).to_a %>

<%= tool_tag "Sending tokens", domain_sending_tokens_path(domain) do %>
  <% if sending_tokens.any? %>
    <ul class="rows">
      <% sending_tokens.each do |sending_token| %>
        <% if sending_token.last_used_at? %>
          <%= tool_row_tag sending_token.name, meta: safe_join([ "Last used ", local_datetime_tag(sending_token.last_used_at, style: :timeordate) ]) %>
        <% else %>
          <%= tool_row_tag sending_token.name, meta: "Never used" %>
        <% end %>
      <% end %>
    </ul>

    <%= tool_more_tag domain.sending_tokens, sending_tokens %>
  <% else %>
    <div class="blank-slate blank-slate--small"><strong>No sending tokens yet.</strong> Open to add one.</div>
  <% end %>
<% end %>

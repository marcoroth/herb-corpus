<% @page_title = "Domains" %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb up: true %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end">
    <%= new_link_to "Add domain", new_domain_path if Current.user.admin? %>
  </div>
<% end %>

<div class="page flex flex-column gap">
  <%= render layout: "shared/filter", locals: { what: "verified domains", search: search_path } do %>
    <div data-controller="navigable-list" data-action="keydown->navigable-list#navigate turbo:before-visit@document->navigable-list#rememberSelection turbo:frame-load->navigable-list#forgetSelection"
          data-navigable-list-actionable-items-value="true">
      <ul class="rows rows--links">
        <%= render "shared/count_row", title: "Not verified", path: domains_unverified_path, count: Current.user.domains.unverified.count %>
      </ul>

      <% if @page.used? %>
        <section class="rows__section">
          <h2 class="rows__heading txt-small txt-subtle">Verified</h2>
          <ul class="rows">
            <%= with_automatic_pagination :domains, @page do %>
              <%= render partial: "domains/domain", collection: @page.records %>
            <% end %>
          </ul>
        </section>
      <% else %>
        <div class="blank-slate fit-content center"><strong><%= Current.user.domains.exists? ? "No verified domains." : "Add every domain this relay sends and receives mail for." %></strong></div>
      <% end %>
    </div>
  <% end %>
</div>

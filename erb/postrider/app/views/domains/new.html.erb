<% @page_title = "Add domain" %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= up_crumb_to "Domains", domains_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <div class="panel shadow">
    <%= form_with model: @domain, url: domains_path, class: "flex flex-column gap" do |form| %>
      <div class="flex flex-column gap-half">
        <%= form.label :name do %>
          <strong>Domain name</strong><br>
          <p class="margin-none txt-x-small txt-subtle">A DKIM keypair is generated automatically for this domain.</p>
        <% end %>
        <%= form.text_field :name, required: true, autofocus: true, class: "input", placeholder: "lists.example.com" %>
        <% if @domain.errors[:name].any? %>
          <p class="txt-negative txt-small margin-none"><%= @domain.errors[:name].to_sentence %></p>
        <% end %>
      </div>

      <div class="flex gap-half">
        <%= form.button "Add domain", type: "submit", class: "btn btn--link" %>
        <%= link_to "Cancel and go back", domains_path, class: "btn borderless" %>
      </div>
    <% end %>
  </div>
</div>

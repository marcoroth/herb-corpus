<% @page_title = @domain.name %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= up_crumb_to "Domains", domains_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end">
    <%= toolbar_button "Settings", edit_domain_path(@domain), icon: "settings" if Current.user.admin? %>
  </div>
<% end %>

<div class="page page--wide project">
  <section class="project__sheet">
    <header class="project__header">
      <h2 class="project__title"><%= @domain.name %></h2>
      <p class="project__description"><%= domain_state_sentence @domain %><% if switches_sentence = domain_switches_sentence(@domain) %> <%= switches_sentence %><% end %></p>

      <% if Current.user.admin? %>
        <%= project_meta_tag project_fact("Mailboxes", @domain.mailboxes.count),
              project_fact("Sending tokens", @domain.sending_tokens.count.nonzero? || "None"),
              project_fact("Webhooks", @domain.webhooks.count.nonzero? || "None"),
              project_fact("Blocked phrases", @domain.blocked_phrase_list.size.nonzero? || "None") %>

        <% unless @domain.verified? %>
          <%= link_to "See the DNS records", domain_dns_records_path(@domain), class: "btn" %>
        <% end %>
      <% end %>
    </header>

    <% if Current.user.admin? %>
      <div class="tools">
        <%= render "domains/show/mailboxes", domain: @domain %>
        <%= render "domains/show/sending_tokens", domain: @domain %>
        <%= render "domains/show/webhooks", domain: @domain %>
        <%= render "domains/show/blocked_phrases", domain: @domain %>
        <%= render "domains/show/allowed_ips", domain: @domain %>
      </div>
    <% end %>
  </section>

  <section class="project__activity page">
    <h2 class="divider txt-medium txt-tight-lines margin-none-block-start margin-block-end">History</h2>

    <div class="trail trail--events trail--whole">
      <% domain_trail(@domain).each do |at, sentence| %>
        <article class="trail__entry">
          <%= trail_time_tag at %>
          <span class="trail__sentence"><%= sentence %></span>
        </article>
      <% end %>
    </div>
  </section>
</div>

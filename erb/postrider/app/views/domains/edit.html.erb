<% @page_title = "#{@domain.name} settings" %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= link_to "Domains", domains_path %>
      <span class="breadcrumbs__separator">▸</span>
      <%= up_crumb_to @domain.name, domain_path(@domain) %>
      <strong>Settings</strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end">
    <%= button_to domain_dns_check_path(@domain), class: "btn btn--circle-mobile", aria: { label: "Check DNS" } do %>
      <%= icon_tag "refresh" %><span>Check DNS</span>
    <% end %>
  </div>
<% end %>

<div class="page settings-index">
  <div class="settings-index__card panel shadow">
    <section>
      <h2 class="settings-index__heading">DNS records</h2>
      <div class="settings-index__body">
        <p class="margin-none txt-align-center">
          <% if @domain.verified? %>
            <span class="status status--success status--badge">Verified</span>
          <% else %>
            <span class="status status--warning status--badge">Not verified for sending</span>
          <% end %>
        </p>

        <% unless @domain.verified? %>
          <p class="txt-small txt-subtle margin-none txt-align-center">Publishing DKIM is what turns on sending from this domain, and forwarding too: the confirmation link goes out from it. Forwarded mail itself is sealed with the relay's own ARC key.</p>
        <% end %>

        <p class="txt-small txt-subtle margin-none txt-align-center">Publish these at your DNS provider.<% if @domain.dns_checked? %> Last checked <%= local_datetime_tag @domain.dns_checked_at, style: :datetime %>.<% end %></p>

        <div class="dns-checks">
          <%= render "domains/dns_record", record: @domain.mx_record, title: "Inbound",
                status: dns_status_tag(@domain.mx_status), error: @domain.mx_error %>
          <p class="txt-small txt-subtle margin-none">MX or CNAME: a CNAME at the same name pointing to <code class="txt-mono"><%= @domain.inbound_cname_record.value %></code> works in place of the MX.</p>

          <%= render "domains/dns_record", record: @domain.dkim_record, title: "DKIM, for sending",
                status: dns_status_tag(@domain.dkim_status), error: @domain.dkim_error %>

          <p class="txt-small txt-subtle margin-none">The next two align bounces under this domain. DMARC reports go to <code class="txt-mono">dmarc-reports@<%= @domain.name %></code>, which only reaches us while this domain's inbound MX points here.</p>

          <%= render "domains/dns_record", record: @domain.dmarc_record, title: "DMARC",
                status: dns_status_tag(@domain.dmarc_status), error: @domain.dmarc_error %>
          <%= render "domains/dns_record", record: @domain.return_path_record, title: "Return-Path",
                status: dns_status_tag(@domain.return_path_status), error: @domain.return_path_error %>
        </div>
      </div>
    </section>
  </div>

  <div class="settings-index__card panel shadow">
    <%= render "domains/accesses", domain: @domain, users: @users, accessed_user_ids: @accessed_user_ids %>

    <div class="txt-align-center pad-block-end">
      <%= button_to domain_path(@domain), method: :delete,
            class: "btn txt-negative borderless txt-small",
            data: { turbo_confirm: "Remove #{@domain.name}? Inbound mail to this domain will be rejected, and nothing can be sent from it." } do %>
        <%= icon_tag "trash" %>
        <span>Remove this domain</span>
      <% end %>
    </div>
  </div>
</div>

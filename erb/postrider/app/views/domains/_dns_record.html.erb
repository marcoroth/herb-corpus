<%# locals: (record:, title:, status: nil, error: nil) %>

<section class="dns-check">
  <header class="dns-check__header">
    <h3 class="dns-check__title"><%= title %></h3>
    <span class="chip"><%= record.type %></span>
    <% if status %>
      <span class="dns-check__status"><%= status %></span>
    <% end %>
  </header>

  <% if error.present? %>
    <p class="txt-small txt-subtle margin-none"><%= error %></p>
  <% end %>

  <div class="details details--columns details--lined">
    <div class="details__row">
      <span class="details__label">Name</span>
      <span class="details__value dns-record">
        <code class="dns-record__value txt-mono txt-break"><%= record.hostname %></code>
        <%= tag.button type: "button", class: "btn btn--circle txt-x-small", aria: { label: "Copy name" }, data: {
              controller: "copy-link", action: "copy-link#copy",
              copy_link_content_value: record.hostname, copy_link_copied_value: "Copied to clipboard" } do %>
          <%= icon_tag "copy-paste" %>
        <% end %>
      </span>
    </div>
    <div class="details__row">
      <span class="details__label">Value</span>
      <span class="details__value dns-record">
        <code class="dns-record__value txt-mono txt-break"><%= record.value %></code>
        <%= tag.button type: "button", class: "btn btn--circle txt-x-small", aria: { label: "Copy value" }, data: {
              controller: "copy-link", action: "copy-link#copy",
              copy_link_content_value: record.value, copy_link_copied_value: "Copied to clipboard" } do %>
          <%= icon_tag "copy-paste" %>
        <% end %>
      </span>
    </div>
  </div>
</section>

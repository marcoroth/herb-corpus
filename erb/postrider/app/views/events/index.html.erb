<% @page_title = "Events" %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb up: true %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <% if @page.used? %>
    <div class="trail trail--events trail--whole" data-controller="navigable-list" data-action="keydown->navigable-list#navigate turbo:before-visit@document->navigable-list#rememberSelection turbo:frame-load->navigable-list#forgetSelection"
          data-navigable-list-actionable-items-value="true">
      <%= with_automatic_pagination :events, @page do %>
        <%= render partial: "events/event", collection: @page.records %>
      <% end %>
    </div>
  <% else %>
    <div class="blank-slate fit-content center"><strong>Nothing recorded yet.</strong></div>
  <% end %>
</div>

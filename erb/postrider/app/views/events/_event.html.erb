<article id="<%= dom_id event %>" class="trail__entry"
         data-navigable-list-target="item" tabindex="-1">
  <%= trail_time_tag event.created_at %>

  <% eventable = event.eventable %>
  <% linkable = eventable.respond_to?(:mailpiece) ? eventable.mailpiece : eventable %>
  <% description = event.description_for(Current.user) %>
  <% if linkable %>
    <%= link_to description, polymorphic_path(linkable), class: "trail__sentence trail__sentence--link" %>
  <% else %>
    <%= tag.span description, class: "trail__sentence" %>
  <% end %>
</article>

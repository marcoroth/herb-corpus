<% @page_title = "Webhooks" %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= link_to "Domains", domains_path %>
      <span class="breadcrumbs__separator">▸</span>
      <%= up_crumb_to @domain.name, domain_path(@domain) %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end">
    <%= new_link_to "New webhook", new_domain_webhook_path(@domain) %>
  </div>
<% end %>

<div class="page flex flex-column gap">
  <% if @page.used? %>
    <%= render layout: "shared/filter", locals: { what: "webhooks" } do %>
      <div data-controller="navigable-list" data-action="keydown->navigable-list#navigate turbo:before-visit@document->navigable-list#rememberSelection turbo:frame-load->navigable-list#forgetSelection"
            data-navigable-list-actionable-items-value="true">
        <ul class="rows">
          <%= with_automatic_pagination :webhooks, @page do %>
            <%= render partial: "webhooks/webhook", collection: @page.records %>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% else %>
    <div class="blank-slate fit-content center"><strong>No webhooks yet.</strong></div>
  <% end %>
</div>

<li id="<%= dom_id webhook %>" class="<%= class_names "row", "row--inactive": !webhook.active? %>" data-quick-find-target="item" data-navigable-list-target="item" tabindex="-1">
  <%= link_to domain_webhook_path(webhook.domain, webhook), class: "row__body" do %>
    <strong class="row__title"><%= webhook.name.presence || webhook.url %></strong>
    <span class="row__meta"><%= webhook.active? ? "Active" : "Inactive" %> · <%= webhook.url %></span>
  <% end %>
</li>

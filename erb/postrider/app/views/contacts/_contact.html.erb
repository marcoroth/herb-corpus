<li id="<%= dom_id contact %>" class="row" data-quick-find-target="item" data-navigable-list-target="item" tabindex="-1">
  <%= avatar_tag contact.name, contact.email, class: "contact__avatar" %>
  <%= link_to contact_path(contact), class: "row__body flex-item-grow" do %>
    <strong class="row__title"><%= contact_address(contact) %></strong>
    <span class="row__meta">
      <%= pluralize email_counts[contact.id], "email" %> <%= contact.mail_state %> ·
      first seen <%= local_datetime_tag contact.created_at, style: :date %>
    </span>
  <% end %>
  <span class="row__end">
    <%= render "contacts/decision", contact: contact %>
  </span>
</li>

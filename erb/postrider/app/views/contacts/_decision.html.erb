<%= form_with url: contact_approval_path(contact), method: (contact.approved? ? :delete : :post), class: "display-contents", data: { controller: "form" } do %>
  <label class="switch">
    <%# Labelled by attribute, not by text: the filter matches on the row's text content. %>
    <%= check_box_tag "approved", "1", contact.approved?, id: dom_id(contact, :approval),
          class: "switch__input", aria: { label: "Forward mail from #{contact.title}" },
          data: { action: "change->form#submit" } %>
    <span class="switch__btn"></span>
  </label>
<% end %>

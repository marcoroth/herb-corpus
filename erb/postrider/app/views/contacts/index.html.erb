<% @page_title = "Contacts" %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb up: true %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <%= render layout: "shared/filter", locals: { what: "approved contacts", search: search_path } do %>
    <div data-controller="navigable-list" data-action="keydown->navigable-list#navigate turbo:before-visit@document->navigable-list#rememberSelection turbo:frame-load->navigable-list#forgetSelection"
          data-navigable-list-actionable-items-value="true">
      <ul class="rows rows--links">
        <%= render "shared/count_row", title: "Denied", path: contacts_denied_path, count: Current.user.accessible_contacts.denied.count %>
      </ul>

      <% if @page.used? %>
        <section class="rows__section">
          <h2 class="rows__heading txt-small txt-subtle">Approved</h2>
          <ul class="rows">
            <%= with_automatic_pagination :contacts, @page do %>
              <%= render partial: "contacts/contact", collection: @page.records, locals: { email_counts: @email_counts } %>
            <% end %>
          </ul>
        </section>
      <% else %>
        <div class="blank-slate fit-content center"><strong><%= Current.user.accessible_contacts.exists? ? "No approved contacts." : "No senders yet." %></strong></div>
      <% end %>
    </div>
  <% end %>
</div>

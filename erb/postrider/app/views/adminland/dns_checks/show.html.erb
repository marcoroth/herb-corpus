<% @page_title = "DNS records" %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb url: session_menu_path, label: "Back to app" %>
      <%= up_crumb_to "Adminland", adminland_settings_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end">
    <% if Relay.hostname.present? %>
      <%= button_to adminland_dns_check_path, class: "btn btn--circle-mobile", aria: { label: "Check DNS" } do %>
        <%= icon_tag "refresh" %><span>Check DNS</span>
      <% end %>
    <% end %>
  </div>
<% end %>

<div class="page settings-index">
  <div class="settings-index__card panel shadow">
    <section>
      <h2 class="settings-index__heading">DNS records</h2>
      <div class="settings-index__body">
        <% if Relay.hostname.blank? %>
          <p class="margin-none txt-align-center">Not configured. Set ENV <code>RELAY_HOSTNAME</code> to this server's public hostname.</p>
        <% else %>
          <p class="flex flex-wrap align-center justify-center gap-half margin-none txt-align-center">
            <% if @dns_check.dns_ok? %>
              <span class="status status--success status--badge">OK</span>
            <% else %>
              <span class="status status--warning status--badge">Not ready</span>
            <% end %>

            <% if @dns_check.dns_checked? %>
              <span class="txt-x-small txt-subtle">Checked <%= local_datetime_tag @dns_check.dns_checked_at, style: :ago %></span>
            <% end %>
          </p>

          <% listings = @dns_check.dns_listings_needing_work_first %>

          <div class="dns-list <%= "dns-list--attention" if listings.any?(&:needs_work?) %>">
            <%= render partial: "domains/dns_records/dns_record", collection: listings, as: :listing %>
          </div>
        <% end %>
      </div>
    </section>
  </div>
</div>

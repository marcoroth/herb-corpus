<% @page_title = "Paused domains" %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb url: session_menu_path, label: "Back to app" %>
      <%= up_crumb_to "Adminland", adminland_settings_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <p class="margin-none">Sending to a domain pauses when its mail servers reject us because this server's IP is on a blocklist, or tell us to slow down. Outlook.com, Yahoo and Gmail pause as a whole, since every domain they host shares their servers. Mail for a paused domain waits and retries as usual, and fails if the domain is still paused when its retries run out. A pause to slow down resumes on its own; resume any other once the IP is delisted.</p>

  <% if @pauses.any? %>
    <ul class="rows">
      <%= render partial: "adminland/pauses/pause", collection: @pauses %>
    </ul>
  <% else %>
    <div class="blank-slate fit-content center">No paused domains. Sending reaches every domain.</div>
  <% end %>
</div>

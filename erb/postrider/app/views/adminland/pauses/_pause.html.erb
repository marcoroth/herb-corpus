<li id="<%= dom_id pause %>" class="row">
  <div class="row__body flex-item-grow">
    <strong class="row__title"><%= pause.recipient_domain %></strong>
    <span class="row__meta">Paused <%= local_datetime_tag pause.created_at, style: :datetime %></span>
    <% if pause.smtp_output.present? %>
      <code class="row__meta row__meta--wrap txt-x-small txt-mono"><%= pause.smtp_output %></code>
    <% end %>
  </div>
  <%= button_to "Resume", adminland_pause_path(pause), method: :delete, class: "btn txt-small", form_class: "button_to flex-item-no-shrink" %>
</li>

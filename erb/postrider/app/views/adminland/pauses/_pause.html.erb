<li id="<%= dom_id pause %>" class="row">
  <div class="row__body flex-item-grow">
    <strong class="row__title"><%= pause.provider_label %></strong>
    <span class="row__meta">Paused <%= local_datetime_tag pause.created_at, style: :datetime %><%= " after mail to #{pause.recipient_domain} was refused" if pause.provider != pause.recipient_domain %></span>
    <% if pause.ends_at %>
      <span class="row__meta">Resumes <%= local_datetime_tag pause.ends_at, style: :datetime %></span>
    <% end %>
    <% if pause.smtp_output.present? %>
      <code class="row__meta row__meta--wrap txt-x-small txt-mono"><%= pause.smtp_output %></code>
    <% end %>
  </div>
  <%= button_to "Resume", adminland_pause_path(pause), method: :delete, class: "btn txt-small", form_class: "button_to flex-item-no-shrink" %>
</li>

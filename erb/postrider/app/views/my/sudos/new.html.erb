<% @page_title = "Confirm it's you" %>
<% turbo_exempts_page_from_cache %>
<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <div class="panel shadow flex flex-column gap">
    <p class="margin-none">Use your passkey before you add a domain, create a token or change your passkeys. We won't ask again for <%= distance_of_time_in_words(Session::SUDO_DURATION) %>.</p>

    <%= passkey_sign_in_button my_sudo_path, options: @authentication_options,
          error: { class: "txt-negative txt-small", message: "Something went wrong while checking your passkey." },
          cancellation: { class: "txt-subtle txt-small", message: "The passkey check was cancelled. Try again when you are ready." },
          class: "btn btn--link" do %>
      <%= icon_tag "authentication" %>
      <span>Confirm with a passkey</span>
    <% end %>
  </div>
</div>

<li id="<%= dom_id access_token %>" class="row">
  <div class="row__body flex-item-grow">
    <strong class="row__title"><%= access_token.description %></strong>
    <span class="row__meta"><%= access_token.permission == "write" ? "Read + Write" : "Read" %> · <%= local_datetime_tag access_token.created_at, style: :timeordate %></span>
  </div>

  <span class="step__actions">
    <%= button_to my_access_token_path(access_token), method: :delete, class: "btn btn--circle", aria: { label: "Revoke" },
          data: { turbo_confirm: "Are you sure you want to permanently revoke this access token? Anything using it stops working." } do %>
      <%= icon_tag "trash" %>
      <span class="for-screen-reader">Revoke</span>
    <% end %>
  </span>
</li>

<% @page_title = "Personal access tokens" %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <% if Current.user %>
        <%= home_crumb %>
        <%= link_to "Settings", account_settings_path %>
        <span class="breadcrumbs__separator">▸</span>
        <%= up_crumb_to "Profile", user_path(Current.user) %>
      <% else %>
        <%= home_crumb url: session_menu_path, label: "Accounts", up: true %>
      <% end %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end">
    <%= new_link_to "Generate a new access token", new_my_access_token_path %>
  </div>
<% end %>

<div class="page flex flex-column gap">
  <p class="margin-none">Tokens you have generated that can be used to access the PostRider API. A token works like a password, and you can revoke it at any time.</p>

  <% if @access_tokens.any? %>
    <ul class="rows">
      <%= render partial: "my/access_tokens/access_token", collection: @access_tokens %>
    </ul>
  <% else %>
    <div class="blank-slate fit-content center"><strong>No access tokens yet.</strong></div>
  <% end %>
</div>

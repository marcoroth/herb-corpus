<% @page_title = "Personal access token" %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <% if Current.user %>
        <%= home_crumb %>
        <%= link_to "Settings", account_settings_path %>
        <span class="breadcrumbs__separator">▸</span>
        <%= link_to "Profile", user_path(Current.user) %>
        <span class="breadcrumbs__separator">▸</span>
      <% else %>
        <%= home_crumb url: session_menu_path, label: "Accounts" %>
      <% end %>
      <%= up_crumb_to "Tokens", my_access_tokens_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <div class="panel shadow flex flex-column gap">
    <div>
      <strong>Description</strong>
      <div><%= @access_token.description %> (<%= @access_token.permission == "write" ? "Read + Write" : "Read" %>)</div>
    </div>

    <% if flash[:access_token] %>
      <div class="flex flex-column gap-half">
        <label for="access-token"><strong>Token</strong></label>
        <input type="text" value="<%= flash[:access_token] %>" id="access-token" readonly autocomplete="off" class="input">
      </div>

      <p class="margin-none txt-small">Save this access token now because you won't be able to see it again.</p>

      <div class="flex gap-half">
        <%= button_to_copy_to_clipboard flash[:access_token] do %>
          <%= icon_tag "copy-paste" %>
          <span>Copy access token</span>
        <% end %>
      </div>
    <% end %>

    <p class="margin-none txt-small"><%= link_to "See the Docs", docs_path %> for how to use it.</p>
  </div>
</div>

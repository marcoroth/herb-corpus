<div id="new_access_token" class="panel shadow flex flex-column gap" data-turbo-temporary>
  <div>
    <strong>Description</strong>
    <div><%= access_token.description %> (<%= access_token.permission == "write" ? "Read + Write" : "Read" %>)</div>
  </div>

  <div class="flex flex-column gap-half">
    <label for="access-token"><strong>Token</strong></label>
    <input type="text" value="<%= access_token.token %>" id="access-token" readonly autocomplete="off" class="input">
  </div>

  <p class="margin-none txt-small">Save this access token now because you won't be able to see it again.</p>

  <div class="flex gap-half">
    <%= button_to_copy_to_clipboard access_token.token do %>
      <%= icon_tag "copy-paste" %>
      <span>Copy access token</span>
    <% end %>
  </div>
</div>

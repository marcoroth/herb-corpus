<% @page_title = "Generate a personal access token" %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <% if Current.user %>
        <%= home_crumb %>
        <%= link_to "Settings", account_settings_path %>
        <span class="breadcrumbs__separator">▸</span>
        <%= link_to "Profile", user_path(Current.user) %>
        <span class="breadcrumbs__separator">▸</span>
      <% else %>
        <%= home_crumb url: session_menu_path, label: "Accounts" %>
      <% end %>
      <%= up_crumb_to "Tokens", my_access_tokens_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <div class="panel shadow">
    <%= form_with model: @access_token, url: my_access_tokens_path, scope: :access_token, class: "flex flex-column gap" do |form| %>
      <div class="flex flex-column gap-half">
        <label for="access_token_description"><strong>Access token description</strong></label>
        <%= form.text_field :description, id: "access_token_description", required: true, autofocus: true, placeholder: "e.g. GitHub", class: "input" %>
      </div>

      <div class="flex flex-column gap-half">
        <label for="access_token_permission"><strong>Permission</strong></label>
        <%= form.select :permission, options_for_select({ "Read" => "read", "Read + Write" => "write" }), {}, id: "access_token_permission", class: "input input--select" %>
      </div>

      <div class="flex gap-half">
        <%= form.button "Generate access token", type: "submit", class: "btn btn--link" %>
        <%= link_to "Cancel and go back", my_access_tokens_path, class: "btn borderless" %>
      </div>
    <% end %>
  </div>
</div>

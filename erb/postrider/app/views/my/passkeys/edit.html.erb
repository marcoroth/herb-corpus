<% @page_title = "Edit passkey" %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <% if Current.user %>
        <%= home_crumb %>
        <%= link_to "Settings", account_settings_path %>
        <span class="breadcrumbs__separator">▸</span>
        <%= link_to "Profile", user_path(Current.user) %>
        <span class="breadcrumbs__separator">▸</span>
      <% else %>
        <%= home_crumb url: session_menu_path, label: "Accounts" %>
      <% end %>
      <%= up_crumb_to "Passkeys", my_passkeys_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <div class="panel shadow flex flex-column gap">
    <% if params[:created] %>
      <p class="margin-none">Your passkey has been registered. Give it a name so you can identify it later.</p>
    <% end %>

    <%= form_with model: @passkey, scope: :passkey, url: my_passkey_path(@passkey), class: "flex flex-column gap" do |form| %>
      <div class="flex flex-column gap-half">
        <label for="passkey_name"><strong>Name your passkey</strong></label>
        <%= form.text_field :name, id: "passkey_name", autofocus: true, autocomplete: "off", placeholder: "e.g. MacBook, iPhone", data: { "1p-ignore": "" }, class: "input" %>
      </div>

      <div class="flex gap-half">
        <%= form.button "Save", type: "submit", class: "btn btn--link" %>
        <%= link_to "Cancel and go back", my_passkeys_path, class: "btn borderless" %>
      </div>
    <% end %>

    <% if Current.identity.passkeys.many? %>
      <div class="txt-align-center">
        <%= button_to my_passkey_path(@passkey), method: :delete,
              class: "btn txt-negative borderless txt-small",
              data: { turbo_confirm: "Are you sure you want to remove this passkey? You can no longer sign in with it." } do %>
          <%= icon_tag "trash" %>
          <span>Remove this passkey</span>
        <% end %>
      </div>
    <% else %>
      <p class="margin-none txt-small txt-subtle txt-align-center">This is your only passkey. Add another before you remove it.</p>
    <% end %>
  </div>
</div>

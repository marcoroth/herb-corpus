<% @page_title = "Passkeys" %>

<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <% if Current.user %>
        <%= home_crumb %>
        <%= link_to "Settings", account_settings_path %>
        <span class="breadcrumbs__separator">▸</span>
        <%= up_crumb_to "Profile", user_path(Current.user) %>
      <% else %>
        <%= home_crumb url: session_menu_path, label: "Accounts", up: true %>
      <% end %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <p class="margin-none">A passkey lets you sign in with your device's fingerprint, face or PIN, with no password or email code. Add one for each device you use, or use a phone that holds one.</p>

  <% if @passkeys.any? %>
    <ul class="rows">
      <%= render partial: "my/passkeys/passkey", collection: @passkeys %>
    </ul>
  <% else %>
    <div class="blank-slate fit-content center"><strong>No passkeys yet.</strong></div>
  <% end %>

  <%= passkey_registration_button my_passkeys_path, options: @registration_options,
        error: { class: "txt-negative txt-small", message: "Something went wrong while registering your passkey." },
        cancellation: { class: "txt-subtle txt-small", message: "Passkey registration was cancelled. Try again when you are ready." },
        duplicate: { class: "txt-negative txt-small", message: "You already have a passkey registered on this device. Remove the existing one first and try again." },
        class: "btn btn--link" do %>
    <%= icon_tag "add" %>
    <span>Register a passkey</span>
  <% end %>

  <p class="margin-none txt-small txt-subtle">Your browser will prompt you to create a passkey using your device's biometrics, PIN, or security key.</p>
</div>

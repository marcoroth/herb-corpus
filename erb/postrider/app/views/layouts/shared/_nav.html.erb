<div class="site-header">
  <%= link_to root_path, class: "site-header__brand" do %>
    <%= image_tag "postrider.svg", alt: "Home", class: "site-header__logo" %>
  <% end %>

  <% if Current.user %>
    <div class="site-header__sections">
      <nav class="site-header__nav">
        <ul class="site-header__list">
          <% navigation_sections.each do |section| %>
            <li class="site-header__item"><%= nav_link_to section %></li>
          <% end %>
        </ul>
      </nav>
    </div>
  <% end %>
</div>

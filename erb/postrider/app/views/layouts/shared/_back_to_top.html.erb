<%= tag.button type: "button", class: "back-to-top btn btn--circle", aria: { label: "Back to top" }, data: {
      controller: "scroll-to-top", scroll_to_top_shown_class: "back-to-top--shown",
      action: "scroll@window->scroll-to-top#toggle:passive resize@window->scroll-to-top#toggle:passive click->scroll-to-top#scroll" } do %>
  <%= icon_tag "arrow-up" %>
<% end %>

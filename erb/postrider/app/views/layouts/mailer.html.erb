<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <style>
      html {
        -ms-text-size-adjust: 100%;
        -webkit-text-size-adjust: 100%;
      }

      body {
        color: #000000;
        font-family: system-ui, sans-serif;
        font-size: 16px;
        line-height: 1.3;
        margin: 0;
        padding: 16px;
      }

      img {
        border: 0 none;
        height: auto;
        line-height: 100%;
        outline: none;
        text-decoration: none;
      }

      a {
        color: #0069ff;
      }

      a img {
        border: 0 none;
      }

      table, td {
        border-collapse: collapse;
      }

      #body {
        height: 100% !important;
        margin: 0;
        padding: 0;
        width: 100% !important;
      }

      .margin-block-end-double {
        margin-bottom: 2em;
      }

      .subtitle {
        font-size: 1.2em;
        font-weight: normal;
        margin-bottom: 1em;
        margin-top: 0.1em;
      }

      .title {
        font-size: 1.4em;
        font-weight: 900;
        margin-bottom: 0;
      }

      .txt-large {
        font-size: 1.2em;
      }

      .footer {
        border-top: 1px solid #d1d5dc;
        color: #737374;
        font-size: 0.85em;
        margin-top: 32px;
        padding-top: 1em;
      }
    </style>
  </head>

  <body>
    <table id="body" style="table-layout: fixed; width: 100%;">
      <%= yield %>
    </table>
  </body>
</html>

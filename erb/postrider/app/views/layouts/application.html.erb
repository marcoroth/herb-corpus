<!DOCTYPE html>
<html lang="en">
  <%= render "layouts/shared/head" %>

  <body class="<%= @body_class %>"
    data-controller="reader-time timezone-cookie theme live-region tint-fade"
    data-action="turbo:morph@window->reader-time#refreshAll turbo:before-stream-render@document->tint-fade#markStream turbo:before-render@document->tint-fade#rememberRows turbo:morph@document->tint-fade#markMorphed animationend->tint-fade#clear"
    data-platform="<%= platform.type %>">
    <div id="global-container">
      <header class="header header--mobile-actions-stack <%= @header_class %>" id="header">
        <a href="#main" class="header__skip-navigation btn" data-turbo="false">Skip to main content</a>

        <%= render "layouts/shared/nav" %>
      </header>

      <% if content_for?(:header) %>
        <div class="strip" data-controller="breadcrumbs" data-breadcrumbs-expanded-class="breadcrumbs--expanded"
          data-action="click->breadcrumbs#toggle keydown.enter->breadcrumbs#toggle keydown.space->breadcrumbs#toggle resize@window->breadcrumbs#refresh turbo:morph@window->breadcrumbs#refresh">
          <%= yield :header %>
        </div>
      <% end %>

      <%= render "layouts/shared/flash" %>
      <%= render "layouts/shared/time_zone" if Current.user %>

      <main id="main">
        <%= yield %>
      </main>
    </div>

    <footer id="footer">
      <%= yield :footer %>

      <%= render "layouts/shared/back_to_top" %>
    </footer>

    <%= render "layouts/shared/live_region" %>
  </body>
</html>

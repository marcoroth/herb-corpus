<% @page_title = "Suppressions" %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= up_crumb_to "Settings", account_settings_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <% if @page.used? %>
    <%= render layout: "shared/filter", locals: { what: "suppressions" } do %>
      <%# Not actionable: a row's only control removes it, and Enter on an actionable row clicks its first button. %>
      <div data-controller="navigable-list" data-action="keydown->navigable-list#navigate turbo:before-visit@document->navigable-list#rememberSelection turbo:frame-load->navigable-list#forgetSelection">
        <ul class="rows">
          <%= with_automatic_pagination :suppressions, @page do %>
            <%= render partial: "suppressions/suppression", collection: @page.records %>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% else %>
    <div class="blank-slate fit-content center">Addresses that hard-bounce are added here automatically and skipped on future sends. Remove one if it was a false positive.</div>
  <% end %>
</div>

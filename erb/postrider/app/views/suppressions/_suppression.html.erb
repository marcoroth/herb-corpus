<li id="<%= dom_id suppression %>" class="row" data-quick-find-target="item" data-navigable-list-target="item" tabindex="-1">
  <div class="row__body flex-item-grow">
    <strong class="row__title"><%= suppression.address %></strong>
    <span class="row__meta"><% if suppression.reason.present? %><%= suppression.reason %> · <% end %><%= local_datetime_tag suppression.created_at, style: :timeordate %></span>
  </div>
  <% if Current.user.admin? %>
    <span class="step__actions">
      <%= button_to suppression_path(suppression), method: :delete,
            class: "btn btn--circle", aria: { label: "Remove" },
            data: { turbo_confirm: "Remove #{suppression.address} from the suppression list?" } do %>
        <%= icon_tag "trash" %>
        <span class="for-screen-reader">Remove</span>
      <% end %>
    </span>
  <% end %>
</li>

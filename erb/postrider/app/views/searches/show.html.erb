<% @page_title = @query ? "Search results for “#{@query}”" : "Search" %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb up: true %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <%= form_with url: search_path, method: :get do %>
    <%= search_field_tag :q, @query, class: "input full-width", autocomplete: "off", autofocus: @query.nil?,
          placeholder: "Search", aria: { label: "Search" } %>
  <% end %>

  <%= render "shared/rows_section", title: "Contacts", records: @contacts, partial: "contacts/contact", email_counts: @email_counts %>
  <%= render "shared/rows_section", title: "Domains", records: @domains, partial: "domains/domain" %>
  <% if @page.used? %>
    <section class="rows__section">
      <h2 class="rows__heading txt-small txt-subtle">Mailpieces</h2>
      <ul class="rows">
        <%= with_automatic_pagination :mailpieces, @page do %>
          <%= render partial: "mailpieces/mailpiece", collection: @page.records %>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if @query && @page.empty? && @contacts.none? && @domains.none? %>
    <div class="blank-slate fit-content center"><strong>No matches</strong></div>
  <% end %>
</div>

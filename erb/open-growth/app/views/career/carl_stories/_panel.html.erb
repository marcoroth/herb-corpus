<%= turbo_frame_tag "career_carl_story_panel" do %>
  <button type="button" onclick="this.closest('turbo-frame').innerHTML = ''" class="fixed inset-0 z-40 bg-black/40" aria-label="Close CARL story editor"></button>

  <div class="fixed inset-y-0 right-0 z-50 flex h-dvh max-h-dvh w-full flex-col overflow-hidden border-l border-border bg-card shadow-xl sm:max-w-2xl">
    <div class="sticky top-0 flex items-start justify-between gap-4 border-b border-border bg-card p-4">
      <div>
        <h2 class="text-xl font-bold text-foreground">Edit CARL story</h2>
        <p class="text-sm text-muted-foreground">Update the behavioral question and response.</p>
      </div>
      <button type="button" onclick="this.closest('turbo-frame').innerHTML = ''" class="rounded-md p-2 text-sm text-muted-foreground hover:bg-muted hover:text-foreground">Close</button>
    </div>

    <div class="min-h-0 flex-1 overflow-y-auto p-6">
      <%= render "form", story: @story %>
    </div>
  </div>
<% end %>

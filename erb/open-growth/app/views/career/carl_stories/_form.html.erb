<div class="space-y-4">
  <div>
    <h1 class="text-xl font-semibold text-foreground">Edit CARL story</h1>
    <p class="text-sm text-muted-foreground">Update the behavioral question and its CARL response.</p>
  </div>

  <%= form_with model: story, url: career_profile_carl_story_path(story), method: :patch, class: "space-y-3", data: { turbo_frame: "_top" } do |f| %>
    <% if story.errors.any? %>
      <div class="rounded-md border border-danger-soft bg-danger-soft p-3 text-sm text-danger">
        <%= story.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div>
      <%= f.label :behavioral_question, "Behavioral question", class: "mb-1 block text-sm font-medium text-foreground" %>
      <%= f.text_area :behavioral_question, required: true, rows: 3, class: "w-full rounded-md border border-input bg-background px-3 py-2 text-foreground" %>
    </div>

    <div>
      <%= f.label :context, "Context", class: "mb-1 block text-sm font-medium text-foreground" %>
      <%= f.text_area :context, rows: 3, class: "w-full rounded-md border border-input bg-background px-3 py-2 text-foreground" %>
    </div>

    <div>
      <%= f.label :action, "Action", class: "mb-1 block text-sm font-medium text-foreground" %>
      <%= f.text_area :action, rows: 3, class: "w-full rounded-md border border-input bg-background px-3 py-2 text-foreground" %>
    </div>

    <div>
      <%= f.label :result, "Result", class: "mb-1 block text-sm font-medium text-foreground" %>
      <%= f.text_area :result, rows: 3, class: "w-full rounded-md border border-input bg-background px-3 py-2 text-foreground" %>
    </div>

    <div>
      <%= f.label :learning, "Learning", class: "mb-1 block text-sm font-medium text-foreground" %>
      <%= f.text_area :learning, rows: 3, class: "w-full rounded-md border border-input bg-background px-3 py-2 text-foreground" %>
    </div>

    <div class="flex gap-2">
      <%= f.submit "Save CARL story", class: "inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-primary-foreground" %>
      <button type="button" class="inline-flex items-center justify-center rounded-md border border-input px-4 py-2" onclick="this.closest('turbo-frame').innerHTML = ''">Cancel</button>
    </div>
  <% end %>
</div>

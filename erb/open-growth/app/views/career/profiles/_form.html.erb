<%= form_with model: @profile, url: career_profile_path, method: :patch, class: "space-y-6" do |f| %>
  <% if @profile.errors.any? %>
    <div class="rounded-md border border-danger-soft bg-danger-soft p-4 text-danger">
      <p class="font-semibold"><%= pluralize(@profile.errors.count, "error") %> prevented this profile from being saved:</p>
      <ul class="mt-2 list-inside list-disc">
        <% @profile.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div>
      <%= f.label :linkedin_url, "LinkedIn URL", class: "mb-2 block text-sm font-medium text-foreground" %>
      <%= f.url_field :linkedin_url, class: "w-full rounded-md border border-input bg-background px-3 py-2 text-foreground" %>
    </div>

    <div>
      <%= f.label :github_url, "GitHub URL", class: "mb-2 block text-sm font-medium text-foreground" %>
      <%= f.url_field :github_url, class: "w-full rounded-md border border-input bg-background px-3 py-2 text-foreground" %>
    </div>

    <div>
      <%= f.label :website_url, "Website / portfolio URL", class: "mb-2 block text-sm font-medium text-foreground" %>
      <%= f.url_field :website_url, class: "w-full rounded-md border border-input bg-background px-3 py-2 text-foreground" %>
    </div>

    <div>
      <%= f.label :resume_url, "Resume URL", class: "mb-2 block text-sm font-medium text-foreground" %>
      <%= f.url_field :resume_url, class: "w-full rounded-md border border-input bg-background px-3 py-2 text-foreground" %>
    </div>

    <div>
      <%= f.label :email, class: "mb-2 block text-sm font-medium text-foreground" %>
      <%= f.email_field :email, class: "w-full rounded-md border border-input bg-background px-3 py-2 text-foreground" %>
    </div>

    <div>
      <%= f.label :phone, class: "mb-2 block text-sm font-medium text-foreground" %>
      <%= f.telephone_field :phone, class: "w-full rounded-md border border-input bg-background px-3 py-2 text-foreground" %>
    </div>

    <div>
      <%= f.label :location, class: "mb-2 block text-sm font-medium text-foreground" %>
      <%= f.text_field :location, class: "w-full rounded-md border border-input bg-background px-3 py-2 text-foreground" %>
    </div>

    <div class="md:col-span-2">
      <%= f.label :headline, class: "mb-2 block text-sm font-medium text-foreground" %>
      <%= f.text_field :headline, class: "w-full rounded-md border border-input bg-background px-3 py-2 text-foreground" %>
    </div>
  </div>

  <div>
    <%= f.label :bio, class: "mb-2 block text-sm font-medium text-foreground" %>
    <%= f.text_area :bio, rows: 5, class: "w-full rounded-md border border-input bg-background px-3 py-2 text-foreground" %>
  </div>

  <div>
    <%= f.label :elevator_pitch, "Elevator pitch", class: "mb-2 block text-sm font-medium text-foreground" %>
    <%= f.text_area :elevator_pitch, rows: 4, class: "w-full rounded-md border border-input bg-background px-3 py-2 text-foreground" %>
  </div>

  <div>
    <%= f.label :unique_selling_point, "Unique selling point", class: "mb-2 block text-sm font-medium text-foreground" %>
    <%= f.text_area :unique_selling_point, rows: 4, class: "w-full rounded-md border border-input bg-background px-3 py-2 text-foreground" %>
  </div>

  <div>
    <%= f.label :cover_letter_snippet, "Cover letter snippet", class: "mb-2 block text-sm font-medium text-foreground" %>
    <%= f.text_area :cover_letter_snippet, rows: 5, class: "w-full rounded-md border border-input bg-background px-3 py-2 text-foreground" %>
  </div>

  <div>
    <%= f.label :salary_preferences, "Salary/preferences", class: "mb-2 block text-sm font-medium text-foreground" %>
    <%= f.text_area :salary_preferences, rows: 4, class: "w-full rounded-md border border-input bg-background px-3 py-2 text-foreground" %>
  </div>

  <div>
    <%= f.label :notes, class: "mb-2 block text-sm font-medium text-foreground" %>
    <%= f.text_area :notes, rows: 4, class: "w-full rounded-md border border-input bg-background px-3 py-2 text-foreground" %>
  </div>

  <div class="flex gap-3">
    <%= f.submit "Save profile", class: "inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-primary-foreground" %>
    <%= link_to "Cancel", career_profile_path, class: "inline-flex items-center justify-center rounded-md border border-input px-4 py-2" %>
  </div>
<% end %>

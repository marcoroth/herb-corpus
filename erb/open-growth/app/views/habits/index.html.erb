<% content_for :title, t("habits.title") %>
<div class="mx-auto max-w-6xl space-y-8 p-4 sm:p-8">
  <header class="flex flex-wrap items-center justify-between gap-3">
    <div><h1 class="text-3xl font-bold"><%= t("habits.title") %></h1><p class="text-muted-foreground"><%= l(@today, format: :long) %></p></div>
    <div class="flex gap-2"><%= link_to t("habits.skills"), habit_skills_path, class: "btn btn-secondary" %><%= link_to t("habits.new"), new_habit_path, class: "btn btn-primary" %></div>
  </header>
  <%= render Habits::ActivityCalendarComponent.new(calendar: @activity_calendar) %>
  <section class="space-y-3">
    <h2 class="text-xl font-semibold"><%= t("habits.today") %></h2>
    <% if @due.empty? %><p class="rounded-xl border border-border p-5 text-muted-foreground"><%= t("habits.none_today") %></p><% end %>
    <div class="grid gap-3 md:grid-cols-2"><% @due.each do |habit| %><%= render "habit_card", habit: habit, today: @today %><% end %></div>
  </section>
  <section class="space-y-3"><h2 class="text-xl font-semibold"><%= t("habits.all") %></h2>
    <div class="grid gap-3 md:grid-cols-2"><% @habits.each do |habit| %><%= render "habit_card", habit: habit, today: @today unless @due.include?(habit) %><% end %></div>
  </section>
  <% if @archived.any? %><section class="space-y-2"><h2 class="text-xl font-semibold"><%= t("habits.archived_title") %></h2><% @archived.each do |habit| %><p><%= link_to habit.name, habit, class: "text-primary hover:underline" %></p><% end %></section><% end %>
</div>

<div class="mx-auto max-w-4xl space-y-7 p-4 sm:p-8">
  <header class="flex flex-wrap justify-between gap-3"><div><%= link_to t("habits.title"), habits_path, class: "text-sm text-primary" %><h1 class="text-3xl font-bold"><%= @habit.name %></h1><% if (skill = @habit.skill_on(@today)) %><p class="mt-1 text-sm text-muted-foreground"><%= t("habits.skill") %>: <%= link_to skill.name, habit_skill_path(skill), class: "font-medium text-primary hover:underline" %></p><% end %><p class="text-muted-foreground"><%= @habit.notes %></p></div><div class="flex gap-2"><%= link_to t("habits.edit"), edit_habit_path(@habit), class: "btn btn-secondary" %><%= button_to t("habits.archive"), archive_habit_path(@habit), method: :patch, class: "btn btn-secondary" %></div></header>
  <div class="grid gap-3 sm:grid-cols-2"><div class="rounded-xl border border-border bg-card p-5"><p class="text-sm text-muted-foreground"><%= t("habits.streak") %></p><p class="text-3xl font-bold"><%= @habit.streak(@today) %></p></div><div class="rounded-xl border border-border bg-card p-5"><p class="text-sm text-muted-foreground"><%= t("habits.rate") %></p><p class="text-3xl font-bold"><%= @habit.completion_rate(@today) %>%</p></div></div>
  <section class="rounded-xl border border-border bg-card p-5"><h2 class="mb-3 text-xl font-semibold"><%= t("habits.history") %></h2><div class="grid grid-cols-7 gap-1"><% (@start..@today).each do |date| %><% if @habit.scheduled_on?(date) %><%= link_to date.day, habit_path(@habit, anchor: "log-#{date}"), title: l(date, format: :long), class: "rounded p-2 text-center text-sm #{@check_ins[date]&.complete? ? 'bg-green-600 text-white' : @check_ins[date] ? 'bg-amber-200 text-amber-900' : 'bg-muted'}" %><% else %><span class="p-2 text-center text-sm text-muted-foreground/40"><%= date.day %></span><% end %><% end %></div></section>
  <section class="space-y-4"><h2 class="text-xl font-semibold"><%= t("habits.check_ins") %></h2><% (@start..@today).to_a.reverse_each do |date| %><% next unless @habit.scheduled_on?(date) %><% entry = @check_ins[date] %><div id="log-<%= date %>" class="rounded-xl border border-border bg-card p-4"><h3 class="font-semibold"><%= l(date, format: :long) %> · <%= entry&.complete? ? t("habits.done") : t("habits.pending") %></h3>
    <%= form_with url: habit_check_ins_path(@habit), method: :post, class: "mt-3 space-y-2" do |f| %><%= hidden_field_tag "habit_check_in[on_date]", date %>
      <% case @habit.kind %><% when "simple" %><%= hidden_field_tag "habit_check_in[done]", "0" %><label class="flex items-center gap-2"><%= check_box_tag "habit_check_in[done]", "1", entry&.done? %><%= t("habits.done") %></label>
      <% when "measured" %><label class="block"><%= t("habits.amount") %> (<%= t("habits.units.#{@habit.unit}") %>, <%= t("habits.target") %>: <%= entry&.target_amount || @habit.target %>)<%= number_field_tag "habit_check_in[amount]", entry&.amount, step: 0.01, min: 0, class: "ml-2 w-28 rounded border border-border bg-background p-2" %></label>
      <% when "exercise" %><p class="text-sm text-muted-foreground"><%= t("habits.exercise_target", sets: entry&.target_sets || @habit.target_sets, reps: entry&.target_reps || @habit.target_reps) %></p><% [@habit.target_sets + 2, entry&.sets&.size || 0].max.times do |index| %><% set = entry&.sets&.sort_by(&:position)&.dig(index) %><div class="flex gap-2"><span class="w-8"><%= index + 1 %></span><%= number_field_tag "habit_check_in[sets][][reps]", set&.reps, min: 0, placeholder: t("habits.reps"), class: "w-24 rounded border border-border bg-background p-2" %><%= number_field_tag "habit_check_in[sets][][weight]", set&.weight, min: 0, step: 0.01, placeholder: t("habits.weight"), class: "w-24 rounded border border-border bg-background p-2" %></div><% end %><% end %>
      <%= f.submit t("habits.save"), class: "btn btn-primary cursor-pointer" %><% if entry %><%= link_to t("habits.clear"), habit_check_in_path(@habit, entry), data: { turbo_method: :delete }, class: "ml-3 text-sm text-destructive" %><% end %>
    <% end %></div><% end %></section>
</div>

<%= form_with model: habit, class: "space-y-5" do |f| %>
  <% if habit.errors.any? %><p class="text-destructive"><%= habit.errors.full_messages.to_sentence %></p><% end %>
  <div><%= f.label :name, t("habits.name"), class: "block font-medium" %><%= f.text_field :name, required: true, class: "w-full rounded-md border border-border bg-background p-2" %></div>
  <div><%= f.label :notes, t("habits.notes"), class: "block font-medium" %><%= f.text_area :notes, class: "w-full rounded-md border border-border bg-background p-2" %></div>
  <div><%= f.label :kind, t("habits.type"), class: "block font-medium" %><%= f.select :kind, Habit::KINDS.map { |kind| [t("habits.kinds.#{kind}"), kind] }, {}, class: "w-full rounded-md border border-border bg-background p-2" %></div>
  <p class="text-sm text-muted-foreground"><%= t("habits.type_hint") %></p>
  <div class="grid gap-4 sm:grid-cols-3">
    <div><%= f.label :unit, t("habits.unit"), class: "block font-medium" %><%= f.select :unit, Habit::UNITS.map { |unit| [t("habits.units.#{unit}"), unit] }, { include_blank: true }, class: "w-full rounded-md border border-border bg-background p-2" %></div>
    <div><%= f.label :target, t("habits.target"), class: "block font-medium" %><%= f.number_field :target, step: 0.01, min: 0, class: "w-full rounded-md border border-border bg-background p-2" %></div>
  </div>
  <div class="grid gap-4 sm:grid-cols-2"><div><%= f.label :target_sets, t("habits.sets"), class: "block font-medium" %><%= f.number_field :target_sets, min: 1, class: "w-full rounded-md border border-border bg-background p-2" %></div><div><%= f.label :target_reps, t("habits.reps"), class: "block font-medium" %><%= f.number_field :target_reps, min: 1, class: "w-full rounded-md border border-border bg-background p-2" %></div></div>
  <% unless habit.persisted? %><div><%= f.label :starts_on, t("habits.starts_on"), class: "block font-medium" %><%= f.date_field :starts_on, class: "rounded-md border border-border bg-background p-2" %></div><% end %>
  <div><%= f.label :scheduled_time, t("habits.time"), class: "block font-medium" %><%= f.time_field :scheduled_time, class: "rounded-md border border-border bg-background p-2" %></div>
  <fieldset><legend class="font-medium"><%= t("habits.days") %></legend><div class="flex flex-wrap gap-3"><% 7.times do |day| %><label class="flex items-center gap-1"><%= check_box_tag "habit[weekdays][]", day, @selected_weekdays.include?(day) %><%= t("date.abbr_day_names")[day] %></label><% end %></div></fieldset>
  <div><%= label_tag "habit_habit_skill_id", t("habits.skill"), class: "block font-medium" %><%= select_tag "habit[habit_skill_id]", options_from_collection_for_select(@skills, :id, :name, habit.persisted? ? habit.skill_on(Time.find_zone!(Current.user.time_zone).today)&.id : nil), include_blank: t("habits.no_skill"), class: "w-full rounded-md border border-border bg-background p-2" %></div>
  <%= f.submit t("habits.save"), class: "btn btn-primary cursor-pointer" %>
<% end %>

<div class="container mx-auto max-w-6xl px-4 py-4 sm:py-8">
  <h1 class="mb-6 text-2xl font-bold text-foreground sm:text-3xl"><%= title %></h1>

  <div class="rounded-xl border border-border bg-card p-4 shadow-sm sm:p-6">
    <%= form_with model: doc, url: form_url, method: form_method, local: true, scope: :doc, class: "space-y-6" do |form| %>
      <% if doc.errors.any? %>
        <div class="rounded-lg border border-danger-soft bg-danger-soft p-4" role="alert">
          <h2 class="mb-2 text-sm font-semibold text-danger"><%= pluralize(doc.errors.count, "error") %> prohibited this document from being saved:</h2>
          <ul class="list-inside list-disc text-sm text-danger">
            <% doc.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_12rem]">
        <div>
          <%= form.label :title, "Title", class: "mb-2 block text-sm font-semibold text-foreground" %>
          <%= form.text_field :title,
            class: "w-full rounded-lg border border-input bg-background px-3 py-2 text-lg font-semibold text-foreground shadow-sm focus:outline-none focus:ring-2 focus:ring-primary",
            placeholder: "Document title…",
            autofocus: true %>
        </div>

        <div>
          <%= form.label :doc_type, "Type", class: "mb-2 block text-sm font-semibold text-foreground" %>
          <%= form.select :doc_type,
            Projects::Doc::DOC_TYPES.map { |doc_type| [ doc_type.humanize, doc_type ] },
            {},
            class: "w-full rounded-lg border border-input bg-background px-3 py-2.5 text-sm text-foreground shadow-sm focus:outline-none focus:ring-2 focus:ring-primary" %>
        </div>
      </div>

      <div>
        <%= form.label :content, "Content", class: "mb-2 block text-sm font-semibold text-foreground" %>
        <%= render Projects::MarkdownEditorComponent.new(form: form, preview_url: preview_docs_path) %>
      </div>

      <div class="flex flex-col-reverse gap-3 border-t border-border pt-4 sm:flex-row sm:justify-end">
        <%= render Ui::ButtonComponent.new(href: cancel_path, label: "Cancel", variant: :ghost) %>
        <%= render Ui::ButtonComponent.new(label: submit_label, variant: :default, type: "submit") %>
      </div>
    <% end %>
  </div>
</div>

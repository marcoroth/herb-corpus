<%= turbo_frame_tag "career_doc_panel" do %>
  <button type="button" onclick="this.closest('turbo-frame').innerHTML = ''" class="fixed inset-0 bg-black/40 z-40 cursor-default" aria-label="Close document"></button>
  <div class="fixed inset-y-0 right-0 w-full sm:max-w-2xl h-dvh max-h-dvh bg-card shadow-xl z-50 overflow-hidden border-l border-border animate-slide-in-right flex flex-col">
    <div class="sticky top-0 border-b border-border bg-card p-4 flex items-start justify-between gap-4">
      <div class="min-w-0">
        <h2 class="text-xl font-bold text-foreground break-words"><%= @doc.title %></h2>
        <p class="text-sm text-muted-foreground"><%= @doc.doc_type.humanize %></p>
      </div>
      <div class="flex flex-shrink-0 items-center gap-2">
        <%= link_to "Edit", edit_doc_path(@doc), data: { turbo_frame: "_top" }, class: "rounded-md p-2 text-sm text-accent hover:bg-muted hover:underline" %>
        <button type="button" onclick="this.closest('turbo-frame').innerHTML = ''" class="rounded-md p-2 text-sm text-muted-foreground hover:bg-muted hover:text-foreground">Close</button>
      </div>
    </div>

    <div class="min-h-0 flex-1 overflow-y-auto p-6">
      <% if @doc.content.present? %>
        <div class="markdown-content text-foreground">
          <%= render_markdown(@doc.content) %>
        </div>
      <% else %>
        <p class="text-sm text-muted-foreground">No content yet.</p>
      <% end %>
    </div>
  </div>
<% end %>

<div class="mx-auto max-w-5xl space-y-6 p-4 sm:p-8">
  <header class="flex justify-between gap-3">
    <div>
      <%= link_to t("habits.title"), habits_path, class: "text-sm text-primary" %>

      <h1 class="text-3xl font-bold"><%= t("habits.skills") %></h1>
    </div><%= link_to t("habits.new_skill"), new_habit_skill_path, class: "btn btn-primary" %>
  </header>

  <div class="grid gap-3 md:grid-cols-2">
    <% @skills.each do |skill| %>
      <%= link_to habit_skill_path(skill), class: "rounded-xl border border-border bg-card p-5 shadow-sm hover:bg-muted/30" do %>
        <h2 class="text-xl font-semibold"><%= skill.name %></h2>

        <p class="text-muted-foreground">
          <%= t("habits.level") %> <%= skill.level %> · <%= skill.xp %> XP
        </p>

        <div class="mt-3 h-2 rounded bg-muted">
          <div
            class="h-2 rounded bg-primary"
            style="width: <%= skill.xp % 100 %>%"
          ></div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<%= form_with model: skill, class: "space-y-4" do |f| %>
  <% if skill.errors.any? %>
    <p class="text-destructive">
      <%= skill.errors.full_messages.to_sentence %>
    </p>
  <% end %>

  <div>
    <%= f.label :name, t("habits.name"), class: "block font-medium" %><%= f.text_field :name, required: true, class: "w-full rounded border border-border bg-background p-2" %>
  </div><%= f.submit t("habits.save"), class: "btn btn-primary cursor-pointer" %>
<% end %>

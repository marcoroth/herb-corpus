<div class="container mx-auto space-y-5 px-4 py-4">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <%= render Ui::ButtonComponent.new(href: reports_ai_conversations_path, label: "Back to conversations", variant: :ghost) %>
    <%= render Ui::ButtonComponent.new(
          href: reports_ai_conversation_path(@conversation),
          label: "Delete conversation",
          variant: :destructive,
          method: :delete,
          data: { turbo_confirm: "Delete this conversation? Usage metadata will be retained." }
        ) %>
  </div>

  <%= render Reports::AnalysisChatComponent.new(conversation: @conversation, membership: @membership) %>
</div>

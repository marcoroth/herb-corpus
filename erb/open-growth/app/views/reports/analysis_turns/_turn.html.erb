<article id="<%= dom_id(turn) %>" class="space-y-3">
  <div class="ml-auto max-w-[85%] rounded-2xl rounded-br-sm bg-primary px-4 py-3 text-sm text-primary-foreground">
    <%= simple_format(turn.question, {}, wrapper_tag: "div") %>
  </div>

  <div class="max-w-[92%] rounded-2xl rounded-bl-sm border border-border bg-background px-4 py-3">
    <% case turn.status %>
    <% when "queued", "processing" %>
      <div class="flex items-center gap-2 text-sm text-muted-foreground" role="status" aria-live="polite">
        <span class="h-2 w-2 animate-pulse rounded-full bg-primary"></span>
        Analyzing this report period…
      </div>
    <% when "completed" %>
      <div class="markdown-content text-sm text-foreground"><%= render_markdown(turn.answer) %></div>
      <p class="mt-3 text-xs text-muted-foreground"><%= turn.model %></p>
    <% else %>
      <p class="text-sm text-destructive"><%= turn.error_message.presence || "The analysis could not be completed." %></p>
    <% end %>
  </div>
</article>

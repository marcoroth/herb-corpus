<%= form_with model: [income_event, planned_expense],
    url: income_event_planned_expenses_path(income_event, kind: "transfer"),
    local: true,
    class: "space-y-6 rounded-xl border border-border bg-card p-5 sm:p-6" do |form| %>
  <div>
    <h2 class="text-xl font-semibold text-foreground">Plan a transfer</h2>
    <p class="mt-1 text-sm text-muted-foreground">Move money to another asset or pay a card. Transfers do not reduce the planned budget.</p>
  </div>

  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :source_selection, "Source asset", class: "mb-2 block text-sm font-medium text-foreground" %>
      <%= render Ui::SelectComponent.new(name: "planned_expense[source_selection]", id: "planned_expense_source_selection", options: @financial_accounts.map { |account| [account.name, "asset:#{account.id}"] }, selected: planned_expense.source_selection, include_blank: "Select source asset", required: true) %>
    </div>

    <div>
      <%= form.label :destination_selection, "Destination", class: "mb-2 block text-sm font-medium text-foreground" %>
      <% destination_options = @financial_accounts.map { |account| ["#{account.name} · Asset", "asset:#{account.id}"] } + @financial_liabilities.map { |liability| ["#{liability.name} · Card or liability", "liability:#{liability.id}"] } %>
      <%= render Ui::SelectComponent.new(name: "planned_expense[destination_selection]", id: "planned_expense_destination_selection", options: destination_options, selected: planned_expense.destination_selection, include_blank: "Select destination", required: true) %>
    </div>

    <div>
      <%= form.label :amount, class: "mb-2 block text-sm font-medium text-foreground" %>
      <%= render Ui::InputComponent.new(name: "planned_expense[amount]", id: "planned_expense_amount", type: "number", value: planned_expense.amount, required: true, min: 0.01, step: 0.01, placeholder: "0.00") %>
    </div>

    <div>
      <%= form.label :due_date, "Due date", class: "mb-2 block text-sm font-medium text-foreground" %>
      <%= render Ui::InputComponent.new(name: "planned_expense[due_date]", id: "planned_expense_due_date", type: "date", value: planned_expense.due_date) %>
    </div>

    <div class="sm:col-span-2">
      <%= form.label :description, class: "mb-2 block text-sm font-medium text-foreground" %>
      <%= render Ui::InputComponent.new(name: "planned_expense[description]", id: "planned_expense_description", value: planned_expense.description, required: true, placeholder: "e.g. Pay Nu card") %>
    </div>

    <div class="sm:col-span-2">
      <%= form.label :notes, "Notes (optional)", class: "mb-2 block text-sm font-medium text-foreground" %>
      <%= form.text_area :notes, rows: 3, placeholder: "Add a reminder or context", class: "w-full rounded-md border border-input bg-background px-3 py-2 text-sm text-foreground shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50" %>
    </div>
  </div>

  <div class="flex flex-col-reverse gap-3 border-t border-border pt-5 sm:flex-row sm:justify-end">
    <%= render Ui::ButtonComponent.new(href: income_event, label: "Cancel", variant: :outline) %>
    <%= render Ui::ButtonComponent.new(label: "Plan Transfer", type: "submit") %>
  </div>
<% end %>

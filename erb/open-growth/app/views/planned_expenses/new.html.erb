<div class="mx-auto max-w-3xl space-y-6">
  <div>
    <%= link_to "← Back to income event", @income_event, class: "text-sm font-medium text-muted-foreground hover:text-foreground" %>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-foreground">Plan Transaction</h1>
    <p class="mt-1 text-sm text-muted-foreground">Plan an expense or move money without counting the movement as spending.</p>
  </div>

  <section class="rounded-xl border border-border bg-card p-4" aria-label="Income event">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Planned from</p>
        <p class="mt-1 font-semibold text-foreground"><%= @income_event.description %></p>
        <p class="text-sm text-muted-foreground"><%= l(@income_event.expected_date, format: :long) %></p>
      </div>
      <div class="grid grid-cols-2 gap-6 sm:text-right">
        <div>
          <p class="text-xs text-muted-foreground">Income</p>
          <p class="font-semibold text-foreground"><%= number_to_currency(@income_event.received_amount || @income_event.expected_amount) %></p>
        </div>
        <div>
          <p class="text-xs text-muted-foreground">Remaining</p>
          <p class="font-semibold text-foreground"><%= number_to_currency(@income_event.remaining_budget) %></p>
        </div>
      </div>
    </div>
  </section>

  <nav class="grid grid-cols-2 rounded-lg bg-muted p-1" aria-label="Transaction type">
    <% [
      ["expense", "Expense", "Consumes this income-event budget"],
      ["transfer", "Transfer", "Moves money without consuming budget"]
    ].each do |kind, label, description| %>
      <% active = @transaction_kind == kind %>
      <%= link_to new_income_event_planned_expense_path(@income_event, kind: kind),
          class: "rounded-md px-3 py-2 text-center transition-colors #{active ? 'bg-card text-foreground shadow-sm' : 'text-muted-foreground hover:text-foreground'}",
          aria: (active ? { current: "page" } : {}) do %>
        <span class="block text-sm font-semibold"><%= label %></span>
        <span class="hidden text-xs sm:block"><%= description %></span>
      <% end %>
    <% end %>
  </nav>

  <%= render "creation_errors", planned_expense: @planned_expense %>
  <%= render @transaction_kind == "transfer" ? "new_transfer_form" : "new_expense_form",
      income_event: @income_event,
      planned_expense: @planned_expense %>
</div>

<% templates_json = (@expense_templates || []).map { |template| { id: template.id, category_id: template.category_id, description: template.description, total_amount: template.total_amount.to_f, notes: template.notes, saved: template.total_saved.to_f } }.to_json %>
<%= form_with model: [income_event, planned_expense],
    url: income_event_planned_expenses_path(income_event, kind: "expense"),
    local: true,
    class: "space-y-6 rounded-xl border border-border bg-card p-5 sm:p-6",
    data: { controller: "template-selector", template_selector_templates_value: templates_json, template_selector_edit_mode_value: false } do |form| %>
  <div>
    <h2 class="text-xl font-semibold text-foreground">Plan an expense</h2>
    <p class="mt-1 text-sm text-muted-foreground">This amount will reduce the income event's remaining budget.</p>
  </div>

  <% if (@expense_templates || []).any? %>
    <div>
      <%= form.label :expense_template_id, "Template (optional)", class: "mb-2 block text-sm font-medium text-foreground" %>
      <%= render Ui::SelectComponent.new(
        name: "planned_expense[expense_template_id]",
        id: "planned_expense_expense_template_id",
        options: @expense_templates.map { |template| [template.name, template.id] },
        selected: planned_expense.expense_template_id,
        include_blank: "Start without a template",
        data: { template_selector_target: "select", action: "change->template-selector#selectTemplate" }
      ) %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
    <div class="sm:col-span-2">
      <%= form.label :description, class: "mb-2 block text-sm font-medium text-foreground" %>
      <%= render Ui::InputComponent.new(name: "planned_expense[description]", id: "planned_expense_description", value: planned_expense.description, required: true, placeholder: "e.g. Groceries", data: { template_selector_target: "descriptionField" }) %>
    </div>

    <div>
      <%= form.label :amount, class: "mb-2 block text-sm font-medium text-foreground" %>
      <%= render Ui::InputComponent.new(name: "planned_expense[amount]", id: "planned_expense_amount", type: "number", value: planned_expense.amount, required: true, min: 0.01, step: 0.01, placeholder: "0.00", data: { template_selector_target: "amountField" }) %>
      <p class="mt-1 text-xs text-muted-foreground" data-template-selector-target="amountHint"></p>
    </div>

    <div>
      <%= form.label :category_id, "Category", class: "mb-2 block text-sm font-medium text-foreground" %>
      <%= render Ui::SelectComponent.new(name: "planned_expense[category_id]", id: "planned_expense_category_id", options: @categories.map { |category| [category.name, category.id] }, selected: planned_expense.category_id, include_blank: "Select a category", required: true, data: { template_selector_target: "categorySelect" }) %>
    </div>

    <div>
      <%= form.label :source_selection, "Source account", class: "mb-2 block text-sm font-medium text-foreground" %>
      <% source_options = @financial_accounts.map { |account| ["#{account.name} · Asset", "asset:#{account.id}"] } + @financial_liabilities.map { |liability| ["#{liability.name} · Liability", "liability:#{liability.id}"] } %>
      <%= render Ui::SelectComponent.new(name: "planned_expense[source_selection]", id: "planned_expense_source_selection", options: source_options, selected: planned_expense.source_selection, include_blank: "Select a source account") %>
    </div>

    <div>
      <%= form.label :due_date, "Due date", class: "mb-2 block text-sm font-medium text-foreground" %>
      <%= render Ui::InputComponent.new(name: "planned_expense[due_date]", id: "planned_expense_due_date", type: "date", value: planned_expense.due_date) %>
    </div>

    <div class="sm:col-span-2">
      <%= form.label :notes, "Notes (optional)", class: "mb-2 block text-sm font-medium text-foreground" %>
      <%= form.text_area :notes, rows: 3, placeholder: "Add a reminder or context", class: "w-full rounded-md border border-input bg-background px-3 py-2 text-sm text-foreground shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50", data: { template_selector_target: "notesField" } %>
    </div>
  </div>

  <div class="flex flex-col-reverse gap-3 border-t border-border pt-5 sm:flex-row sm:justify-end">
    <%= render Ui::ButtonComponent.new(href: income_event, label: "Cancel", variant: :outline) %>
    <%= render Ui::ButtonComponent.new(label: "Plan Expense", type: "submit") %>
  </div>
<% end %>

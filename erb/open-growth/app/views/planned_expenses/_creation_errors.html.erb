<% if planned_expense.errors.any? %>
  <div class="rounded-lg border border-destructive/30 bg-destructive/10 p-4 text-destructive" role="alert">
    <p class="text-sm font-semibold">Please review the following:</p>
    <ul class="mt-2 list-inside list-disc text-sm">
      <% planned_expense.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

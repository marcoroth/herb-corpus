<%= form_with url: quick_add_create_income_path, local: false, data: { turbo: true, quick_add_offline: true } do |f| %>
  <div class="space-y-4">
    <div class="border-b border-border pb-3">
      <%= label_tag "expected_amount", t("quick_add.income_form.amount"), class: "block text-xs font-medium text-muted-foreground" %>
      <%= number_field_tag "income[expected_amount]",
        @income&.expected_amount,
        id: "expected_amount",
        inputmode: "decimal",
        placeholder: "0.00",
        step: "0.01",
        min: "0.01",
        required: true,
        data: { quick_add_autofocus: true },
        class: "h-16 w-full min-w-0 border-0 bg-transparent px-0 py-2 text-5xl font-semibold tracking-tight text-foreground outline-none placeholder:text-muted-foreground/70 focus:ring-0 focus-visible:ring-0"
      %>
    </div>

    <div>
      <%= label_tag "income_description", t("quick_add.income_form.description"), class: "sr-only" %>
      <%= render Ui::InputComponent.new(name: "income[description]", id: "income_description", placeholder: t("quick_add.income_form.description_placeholder"), value: @income&.description, required: true, autocomplete: "off", css_class: "!h-12 rounded-none border-x-0 border-b border-t-0 border-input bg-transparent px-0 text-lg shadow-none focus-visible:border-ring focus-visible:ring-0") %>
    </div>

    <div>
      <%= f.label :destination, t("quick_add.income_form.destination"), class: "mb-1 block truncate text-xs font-medium text-muted-foreground" %>
      <%= render Ui::SelectComponent.new(
        name: "income[destination]",
        options: quick_add_account_options(Current.account),
        selected: nil,
        include_blank: t("quick_add.income_form.select_destination"),
        required: true,
        aria_label: t("quick_add.income_form.destination"),
        searchable: true
      ) %>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <label class="inline-flex h-10 items-center gap-2 rounded-lg border border-input bg-background px-3 text-sm text-foreground">
        <svg aria-hidden="true" class="size-4 shrink-0 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <rect x="3" y="5" width="18" height="16" rx="2" />
          <path stroke-linecap="round" d="M16 3v4M8 3v4M3 10h18" />
        </svg>
        <span class="sr-only"><%= t("quick_add.income_form.date") %></span>
        <%= date_field_tag "income[expected_date]", @income&.expected_date || Date.current, id: "income_date", required: true, class: "w-32 border-0 bg-transparent p-0 text-sm text-foreground focus:ring-0" %>
      </label>

      <button type="button" data-action="quick-add-menu#toggleDetails" aria-expanded="false" aria-controls="quick-add-income-details" class="inline-flex h-10 items-center gap-2 rounded-lg border border-input bg-background px-3 text-sm font-medium text-foreground hover:bg-muted md:hidden">
        <svg aria-hidden="true" class="size-4 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" />
        </svg>
        <%= t("quick_add.income_form.more_details") %>
      </button>
    </div>

    <div id="quick-add-income-details" data-quick-add-menu-target="details" class="hidden md:block">
      <%= f.label :time, t("quick_add.income_form.time"), class: "mb-1 block text-xs font-medium text-muted-foreground" %>
      <%= render Ui::InputComponent.new(name: "income[time]", id: "income_time", type: "time") %>
    </div>

    <div class="sticky bottom-0 -mx-4 border-t border-border bg-card/95 px-4 pb-1 pt-3 backdrop-blur md:static md:mx-0 md:flex md:justify-end md:border-0 md:bg-transparent md:p-0 md:pt-2">
      <%= render Ui::ButtonComponent.new(label: t("quick_add.income_form.submit"), variant: :default, type: "submit", css_class: "w-full py-3 md:w-auto md:py-2") %>
    </div>
  </div>
<% end %>

<%= form_with url: quick_add_create_transfer_path, local: false, data: { turbo: true, quick_add_offline: true } do |f| %>
  <div class="space-y-3">
    <div>
      <label class="block text-sm font-medium text-foreground mb-1">Amount</label>
      <%= render Ui::InputComponent.new(name: "transfer[amount]", type: "number", placeholder: "0.00", step: "0.01", value: @transfer&.amount, required: true) %>
    </div>

    <div>
      <label class="block text-sm font-medium text-foreground mb-1\">From Account</label>
      <%= render Ui::SelectComponent.new(
        name: "transfer[from_type]",
        options: quick_add_account_options(Current.account),
        selected: @transfer_from_type,
        include_blank: "Select from account",
        required: true,
        searchable: true
      ) %>
    </div>

    <div>
      <label class="block text-sm font-medium text-foreground mb-1">To Account</label>
      <%= render Ui::SelectComponent.new(
        name: "transfer[to_type]",
        options: quick_add_account_options(Current.account),
        selected: @transfer_to_type,
        include_blank: "Select to account",
        required: true,
        searchable: true
      ) %>
    </div>

    <div>
      <label class="block text-sm font-medium text-foreground mb-1">Date</label>
      <%= render Ui::InputComponent.new(name: "transfer[date]", type: "date", value: Date.current, required: true) %>
    </div>

    <div>
      <label class="block text-sm font-medium text-foreground mb-1">Time (optional)</label>
      <%= render Ui::InputComponent.new(name: "transfer[time]", type: "time") %>
    </div>

    <div>
      <label class="block text-sm font-medium text-foreground mb-1">Description</label>
      <%= render Ui::InputComponent.new(name: "transfer[description]", type: "text", placeholder: "Optional description (e.g. Rent reimbursement)", value: @transfer&.description) %>
    </div>

    <div class="flex justify-end gap-2 pt-2">
      <%= render Ui::ButtonComponent.new(label: "Create Transfer", variant: :default, type: "submit") %>
    </div>
  </div>
<% end %>

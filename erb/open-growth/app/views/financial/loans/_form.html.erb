<% form_url = loan.persisted? ? finance_loan_path(loan) : finance_loans_path %>
<% form_method = loan.persisted? ? :patch : :post %>
<%= form_with model: loan, url: form_url, method: form_method, class: "grid gap-4 rounded-xl border border-border bg-card p-6 shadow-sm sm:grid-cols-2", data: { controller: "loan-terms" } do %>
  <% if loan.errors.any? %><p class="sm:col-span-2 text-sm text-destructive"><%= loan.errors.full_messages.to_sentence %></p><% end %>
  <label class="space-y-1 text-sm">Name<%= render Ui::InputComponent.new(name: "financial_loan[name]", value: loan.name, required: true) %></label>
  <label class="space-y-1 text-sm">Lender<%= render Ui::InputComponent.new(name: "financial_loan[lender_name]", value: loan.lender_name) %></label>
  <label class="space-y-1 text-sm">Principal<%= render Ui::InputComponent.new(name: "financial_loan[principal_amount]", value: loan.principal_amount, type: "number", min: 0.01, step: 0.01, required: true, data: { loan_terms_target: "principal", action: "input->loan-terms#refresh" }) %></label>
  <label class="space-y-1 text-sm">Terms I know<%= render Ui::SelectComponent.new(name: "financial_loan[repayment_basis]", options: [ [ "Annual interest rate", "annual_rate" ], [ "Payment amounts", "payment_amounts" ] ], selected: loan.repayment_basis, include_blank: "Configure later", data: { loan_terms_target: "basis", action: "change->loan-terms#refresh" }) %></label>
  <label class="space-y-1 text-sm">Number of payments<%= render Ui::InputComponent.new(name: "financial_loan[number_of_payments]", value: loan.number_of_payments, type: "number", min: 1, step: 1, data: { loan_terms_target: "payments", action: "input->loan-terms#refresh" }) %></label>
  <label class="space-y-1 text-sm">Frequency<%= render Ui::SelectComponent.new(name: "financial_loan[payment_frequency]", options: %w[weekly biweekly quincenal monthly].map { |frequency| [ frequency.humanize, frequency ] }, selected: loan.payment_frequency, data: { loan_terms_target: "frequency", action: "change->loan-terms#refresh" }) %></label>
  <label class="space-y-1 text-sm sm:col-span-2">First payment date<%= render Ui::InputComponent.new(name: "financial_loan[first_payment_date]", value: loan.first_payment_date, type: "date") %><span class="block text-xs text-muted-foreground">The date the first repayment is due, not the date the loan money was received or disbursed.</span></label>
  <div class="space-y-1" data-loan-terms-target="rateFields">
    <label class="text-sm">Annual interest %<%= render Ui::InputComponent.new(name: "financial_loan[interest_rate]", value: (loan.interest_rate unless loan.interest_rate_estimated?), type: "number", min: 0, step: 0.001, data: { loan_terms_target: "rate", action: "input->loan-terms#refresh" }) %></label>
  </div>
  <div class="space-y-3" data-loan-terms-target="amountFields">
    <label class="block space-y-1 text-sm">Regular payment<%= render Ui::InputComponent.new(name: "financial_loan[payment_amount]", value: loan.payment_amount, type: "number", min: 0.01, step: 0.01, data: { loan_terms_target: "regular", action: "input->loan-terms#refresh" }) %></label>
    <label class="block space-y-1 text-sm">Different payment (optional)<%= render Ui::InputComponent.new(name: "financial_loan[different_payment_amount]", value: loan.different_payment_amount, type: "number", min: 0.01, step: 0.01, data: { loan_terms_target: "different", action: "input->loan-terms#refresh" }) %></label>
    <label class="block space-y-1 text-sm">Different payment position<%= render Ui::SelectComponent.new(name: "financial_loan[different_payment_position]", options: [ [ "Beginning", "beginning" ], [ "Final", "final" ] ], selected: loan.different_payment_position || "final", data: { loan_terms_target: "position", action: "change->loan-terms#refresh" }) %></label>
  </div>
  <p class="hidden rounded-lg bg-muted/40 p-3 text-sm text-muted-foreground sm:col-span-2" data-loan-terms-target="hint"></p>
  <label class="space-y-1 text-sm">Interest expense category<%= render Ui::SelectComponent.new(name: "financial_loan[interest_category_id]", options: categories.map { |category| [ category.name, category.id ] }, selected: loan.interest_category_id, include_blank: "Select before recording interest") %><span class="block text-xs text-muted-foreground">Each paid installment records its interest as a liability charge in this category.</span></label>
  <label class="space-y-1 text-sm">Real liability<%= render Ui::SelectComponent.new(name: "financial_loan[liability_id]", options: liabilities.map { |liability| [ liability.name, liability.id ] }, selected: loan.liability_id, include_blank: "Not selected") %></label>
  <label class="space-y-1 text-sm">Disburse to asset<%= render Ui::SelectComponent.new(name: "financial_loan[destination_asset_id]", options: assets.map { |asset| [ asset.name, asset.id ] }, selected: loan.destination_asset_id, include_blank: "None") %></label>
  <label class="space-y-1 text-sm">Or refinance liability<%= render Ui::SelectComponent.new(name: "financial_loan[destination_liability_id]", options: liabilities.map { |liability| [ liability.name, liability.id ] }, selected: loan.destination_liability_id, include_blank: "None") %></label>
  <div class="flex gap-2 sm:col-span-2"><%= render Ui::ButtonComponent.new(label: loan.persisted? ? "Save loan" : "Create simulation", type: "submit") %><%= render Ui::ButtonComponent.new(href: loan.persisted? ? finance_loan_path(loan) : finance_loans_path, label: "Cancel", variant: :outline) %></div>
<% end %>

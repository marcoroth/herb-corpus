<section class="mx-auto max-w-3xl space-y-6 p-6 sm:p-8">
  <div>
    <%= link_to "← Back to plan", finance_plan_path(@plan), class: "text-sm text-primary hover:underline" %>
    <h1 class="mt-4 text-3xl font-bold">Edit plan</h1>
    <p class="mt-1 text-muted-foreground">Funding expectations are edited separately on the plan page.</p>
  </div>
  <%= render "form", plan: @plan, funding_source: nil, budget_periods: @budget_periods, assets: @assets, liabilities: @liabilities %>
</section>

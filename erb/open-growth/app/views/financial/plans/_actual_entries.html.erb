<section aria-labelledby="actual-entries-title" class="space-y-4">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 id="actual-entries-title" class="text-xl font-semibold">Actual entries</h2>
      <p class="text-sm text-muted-foreground">Planned and unplanned expenses count toward Actual consumption. These ledger records are never rewritten by planning changes.</p>
    </div>
    <% unless plan.lifecycle_status == "closed" %>
      <%= render Ui::ButtonComponent.new(href: new_finance_entry_path(income_event_id: plan.id), label: "Add unplanned actual", variant: :outline, size: :sm) %>
    <% end %>
  </div>

  <div class="overflow-hidden rounded-xl border border-border bg-card">
    <% if actual_entries.any? %>
      <div class="divide-y divide-border">
        <% actual_entries.each do |entry| %>
          <%= link_to finance_entry_path(entry), class: "flex flex-wrap items-center justify-between gap-3 p-4 hover:bg-muted/30" do %>
            <div><p class="font-medium"><%= entry.description %></p><p class="text-xs text-muted-foreground"><%= entry.entry_type.humanize %> · <%= l(entry.entry_date) %> · <%= entry.category&.name || t("expenses.index.unassigned") %></p></div>
            <span class="font-semibold"><%= number_to_currency(entry.amount) %></span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="p-5 text-sm text-muted-foreground">No actual entries are associated with this plan.</p>
    <% end %>
  </div>
</section>

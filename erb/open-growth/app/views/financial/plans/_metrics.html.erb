<section aria-labelledby="plan-results-title" class="space-y-3">
  <div>
    <h2 id="plan-results-title" class="text-xl font-semibold">
      Projection and plan execution
    </h2>

    <p class="text-sm text-muted-foreground">
      Planned values use expectations; actual values use recorded entries.
    </p>
  </div>

  <div
    class="
      grid overflow-hidden rounded-xl border border-border bg-card
      sm:grid-cols-3
    "
  >
    <div class="border-b border-border p-4 last:border-b-0 sm:border-b-0 sm:border-r">
      <p class="text-sm text-muted-foreground">Funding</p>

      <p class="mt-2 text-xl font-bold">
        <%= number_to_currency(projection.expected_funding) %>
      </p>

      <p class="mt-1 text-xs text-muted-foreground">
        Actual <%= number_to_currency(actuals.actual_funding) %>
      </p>
    </div>

    <div class="border-b border-border p-4 last:border-b-0 sm:border-b-0 sm:border-r">
      <p class="text-sm text-muted-foreground">Consumption</p>

      <p class="mt-2 text-xl font-bold">
        <%= number_to_currency(projection.planned_consumption) %>
      </p>

      <p class="mt-1 text-xs text-muted-foreground">
        Actual <%= number_to_currency(actuals.actual_consumption) %>
      </p>
    </div>

    <div class="border-b border-border p-4 last:border-b-0 sm:border-b-0">
      <p class="text-sm text-muted-foreground">Plan balance</p>

      <p class="mt-2 text-xl font-bold">
        <%= number_to_currency(projection.ending_balance) %>
      </p>

      <p class="mt-1 text-xs text-muted-foreground">
        Actual <%= number_to_currency(actuals.ending_balance) %>
      </p>
    </div>
  </div>

  <% unless projection.complete? %>
    <p class="text-sm text-danger">
      Calculation incomplete: add the missing funding or movement information.
    </p>
  <% end %>
</section>

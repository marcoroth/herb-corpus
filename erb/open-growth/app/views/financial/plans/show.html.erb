<section class="space-y-6 p-6 sm:p-8">
  <div>
    <%= link_to "← Back to plans", finance_plans_path, class: "text-sm text-primary hover:underline" %>
  </div>

  <header
    class="
      flex flex-col gap-4 border-b border-border pb-6 sm:flex-row
      sm:items-start sm:justify-between
    "
  >
    <div>
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-3xl font-bold"><%= @plan.name %></h1>
        <%= render Ui::BadgeComponent.new(label: @plan.lifecycle_status.humanize, variant: :outline) %>
      </div>

      <p class="mt-2 text-muted-foreground">
        Planned for
        <%= l(@plan.planned_for, format: :long) %><%= " · #{@plan.budget_period.name}" if @plan.budget_period %>
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      <%= render Ui::ButtonComponent.new(href: edit_finance_plan_path(@plan), label: "Edit plan", variant: :outline) %>

      <% unless @plan.lifecycle_status.in?(%w[closed cancelled]) %>
        <%= render Ui::ButtonComponent.new(href: close_finance_plan_path(@plan), label: "Close plan", method: :post) %>
        <%= render Ui::ButtonComponent.new(href: cancel_finance_plan_path(@plan), label: "Cancel", variant: :outline, method: :post) %>
      <% end %>

      <% if @plan.lifecycle_status == "draft" %>
        <%= render Ui::ButtonComponent.new(href: finance_plan_path(@plan), label: "Delete draft", variant: :destructive, method: :delete, data: { turbo_confirm: "Delete this draft and its planning records?" }) %>
      <% end %>
    </div>
  </header>

  <%= render "metrics", projection: @projection, actuals: @actuals %>
  <%= render "funding_sources", plan: @plan, projection: @projection, funding_sources: @funding_sources, assets: @assets, liabilities: @liabilities, other_plans: @other_plans %>
  <%= render "planned_transactions", plan: @plan, planned_transactions: @planned_transactions, projection: @projection, order: @order, assets: @assets, liabilities: @liabilities, categories: @categories, other_plans: @other_plans %>
  <%= render "actual_entries", plan: @plan, actual_entries: @actual_entries %>
</section>

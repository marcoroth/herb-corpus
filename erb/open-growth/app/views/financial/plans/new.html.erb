<section class="mx-auto max-w-3xl space-y-6 p-6 sm:p-8">
  <div>
    <%= link_to "← Back to plans", finance_plans_path, class: "text-sm text-primary hover:underline" %>
    <h1 class="mt-4 text-3xl font-bold">New financial plan</h1>
    <p class="mt-1 text-muted-foreground">Create the plan and its first expected funding source together.</p>
  </div>
  <%= render "form", plan: @plan, funding_source: @funding_source, budget_periods: @budget_periods, assets: @assets, liabilities: @liabilities %>
</section>

<% if searchable? %>
  <div class="relative" data-controller="searchable-select">
    <input
      type="text"
      value="<%= selected_label %>"
      placeholder="<%= search_placeholder %>"
      autocomplete="off"
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls="<%= listbox_id %>"
      <%= "required" if @required %>
      <%= "disabled" if @disabled %>
      class="<%= [BASE_CLASSES, @extra_class].compact.join(" ") %>"
      data-searchable-select-target="input"
      data-action="input->searchable-select#filter focus->searchable-select#open keydown->searchable-select#navigate"
    >
    <%= select_tag @name, rendered_options, html_attributes.merge(class: "sr-only", data: { searchable_select_target: "select" }) %>
    <div
      id="<%= listbox_id %>"
      role="listbox"
      class="absolute z-50 mt-1 hidden max-h-60 w-full overflow-y-auto rounded-md border border-border bg-popover p-1 text-popover-foreground shadow-md"
      data-searchable-select-target="list"
    >
      <% searchable_options.each do |option| %>
        <button
          type="button"
          role="option"
          data-value="<%= option[:value] %>"
          data-label="<%= option[:label] %>"
          data-searchable-select-target="option"
          data-action="mousedown->searchable-select#choose"
          class="w-full rounded-sm px-2 py-1.5 text-left text-sm outline-none hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground"
        ><%= option[:label] %></button>
      <% end %>
      <p class="hidden px-2 py-2 text-sm text-muted-foreground" data-searchable-select-target="empty">No matches found</p>
    </div>
  </div>
<% else %>
  <%= select_tag @name, rendered_options, html_attributes %>
<% end %>

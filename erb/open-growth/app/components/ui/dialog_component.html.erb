<dialog id="<%= @id %>" aria-labelledby="<%= title_id %>" <%= "open" if @show %> class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-xl border border-border bg-background p-0 text-foreground shadow-xl backdrop:bg-black/55">
  <div class="border-b border-border p-5">
    <% if @title.present? %><h3 id="<%= title_id %>" class="text-lg font-semibold"><%= @title %></h3><% end %>
    <% if @description.present? %><p class="mt-1 text-sm text-muted-foreground"><%= @description %></p><% end %>
  </div>
  <div class="p-5"><%= content %></div>
</dialog>

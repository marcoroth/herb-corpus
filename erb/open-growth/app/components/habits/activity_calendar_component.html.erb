<section class="rounded-xl border border-border bg-card p-5 shadow-sm" aria-label="<%= t('habits.activity') %>">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
    <h2 class="text-xl font-semibold"><%= t("habits.activity") %></h2>
    <span class="text-sm text-muted-foreground"><%= t("habits.activity_hint") %></span>
  </div>
  <div class="overflow-x-auto pb-2">
    <div class="flex w-max gap-1" role="img" aria-label="<%= t('habits.activity') %>">
      <% calendar.weeks.each do |week| %>
        <div class="flex flex-col gap-1">
          <% week.each do |date| %>
            <% if date <= calendar.today %>
              <% count = calendar.count_on(date) %>
              <div class="size-3 rounded-sm border border-black/5" style="background-color: <%= calendar.color_on(date) %>" title="<%= l(date, format: :long) %>: <%= t('habits.activity_count', count: count) %>" aria-label="<%= l(date, format: :long) %>: <%= t('habits.activity_count', count: count) %>" data-date="<%= date %>" data-count="<%= count %>"></div>
            <% else %>
              <div class="size-3" aria-hidden="true"></div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
  <div class="mt-2 flex items-center justify-end gap-1 text-xs text-muted-foreground">
    <span class="mr-1"><%= t("habits.less") %></span>
    <% Habit::ActivityCalendar::COLORS.each_with_index do |color, count| %><span class="size-3 rounded-sm border border-black/5" style="background-color: <%= color %>" title="<%= count == 4 ? '4+' : count %>"></span><% end %>
    <span class="ml-1"><%= t("habits.more") %></span>
  </div>
</section>

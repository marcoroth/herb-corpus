<li data-task-kind="<%= recurring? ? 'recurring' : 'project' %>" class="flex items-center gap-2 rounded-md border border-border bg-card p-2">
  <%= link_to detail_path,
    data: detail_data,
    onclick: detail_onclick,
    class: "flex min-w-0 flex-1 items-center justify-between gap-3 rounded-sm px-1 py-1.5 outline-none hover:text-accent-dark focus-visible:ring-2 focus-visible:ring-ring" do %>
    <span class="min-w-0">
      <span class="block truncate <%= 'font-semibold text-danger' if task.overdue? %>"><%= title %></span>
      <span class="mt-0.5 block truncate text-xs text-muted-foreground"><%= context_label %></span>
    </span>
    <% if due_date.present? %>
      <span class="shrink-0 text-xs <%= task.overdue? ? 'font-semibold text-danger' : 'text-muted-foreground' %>"><%= helpers.l(due_date, format: :short) %></span>
    <% end %>
  <% end %>

  <%= form_with url: completion_path, method: :patch, class: "shrink-0" do %>
    <%= hidden_field_tag "task[status]", "done" unless recurring? %>
    <%= render Ui::ButtonComponent.new(
      label: t("task.recurring_tasks.mark_done"),
      variant: :default,
      size: :sm,
      type: "submit",
      css_class: "h-10 sm:h-8"
    ) %>
  <% end %>
</li>

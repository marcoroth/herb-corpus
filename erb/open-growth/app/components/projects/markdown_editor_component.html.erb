<div
  class="markdown-editor space-y-3"
  data-controller="markdown-editor"
  data-markdown-editor-preview-url-value="<%= @preview_url %>"
>
  <div class="sticky top-14 z-20 rounded-xl border border-border bg-card/95 shadow-sm backdrop-blur md:top-2">
    <div class="flex items-center justify-between gap-3 border-b border-border px-2 py-2 sm:px-3">
      <div class="flex items-center rounded-lg bg-muted p-1" role="tablist" aria-label="Document mode">
        <button
          type="button"
          role="tab"
          aria-selected="true"
          data-markdown-editor-target="editTab"
          data-action="markdown-editor#showEdit"
          class="rounded-md bg-card px-3 py-1.5 text-sm font-medium text-foreground shadow-sm"
        >Edit</button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-markdown-editor-target="previewTab"
          data-action="markdown-editor#showPreview"
          class="rounded-md px-3 py-1.5 text-sm font-medium text-muted-foreground"
        >Preview</button>
      </div>

      <span class="hidden text-xs text-muted-foreground sm:inline">Markdown</span>
    </div>

    <div class="flex gap-1 overflow-x-auto px-2 py-2 sm:flex-wrap sm:px-3" role="toolbar" aria-label="Markdown formatting" data-markdown-editor-target="formatToolbar">
      <% [
        [ "H1", "heading-1" ],
        [ "H2", "heading-2" ],
        [ "H3", "heading-3" ],
        [ "Bold", "bold" ],
        [ "Italic", "italic" ],
        [ "Link", "link" ],
        [ "List", "bullet-list" ],
        [ "1.", "ordered-list" ],
        [ "Quote", "quote" ],
        [ "Code", "code" ]
      ].each do |label, command| %>
        <%= render Ui::ButtonComponent.new(
          label: label,
          variant: :ghost,
          size: :sm,
          type: "button",
          css_class: "min-w-fit",
          data: {
            action: "markdown-editor#format",
            markdown_editor_command_param: command
          }
        ) %>
      <% end %>
    </div>
  </div>

  <details class="rounded-xl border border-border bg-card p-3 lg:hidden">
    <summary class="cursor-pointer text-sm font-semibold text-foreground">Outline</summary>
    <nav class="mt-3 space-y-1" aria-label="Document outline" data-markdown-editor-target="outline"></nav>
  </details>

  <div class="grid min-w-0 gap-6 lg:grid-cols-[minmax(0,1fr)_15rem]">
    <div class="min-w-0">
      <div data-markdown-editor-target="editPanel">
        <%= @form.text_area :content,
          rows: 24,
          placeholder: "# Document title\n\nWrite in Markdown…",
          class: "min-h-[65dvh] w-full rounded-xl border border-input bg-background px-4 py-4 font-mono text-base leading-7 text-foreground shadow-sm focus:outline-none focus:ring-2 focus:ring-primary",
          data: { markdown_editor_target: "textarea" } %>
        <div class="hidden overflow-hidden rounded-xl border border-input bg-background shadow-sm" data-markdown-editor-target="mount"></div>
      </div>

      <div class="hidden min-h-[65dvh] rounded-xl border border-border bg-card p-4 shadow-sm sm:p-8" data-markdown-editor-target="previewPanel">
        <p class="hidden text-sm text-muted-foreground" role="status" aria-live="polite" data-markdown-editor-target="previewStatus"></p>
        <article class="markdown-content mx-auto max-w-[78ch] text-foreground" data-markdown-editor-target="previewContent"></article>
      </div>
    </div>

    <aside class="hidden lg:block">
      <div class="sticky top-4 rounded-xl border border-border bg-card p-4 shadow-sm">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-muted-foreground">Outline</h2>
        <nav class="space-y-1" aria-label="Document outline" data-markdown-editor-target="outline"></nav>
      </div>
    </aside>
  </div>
</div>

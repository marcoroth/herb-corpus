<div class="grid min-w-0 gap-6 lg:grid-cols-[minmax(0,1fr)_15rem]" data-controller="markdown-outline">
  <details class="rounded-xl border border-border bg-card p-3 lg:hidden">
    <summary class="cursor-pointer text-sm font-semibold text-foreground">Outline</summary>
    <nav class="mt-3 space-y-1" aria-label="Document outline" data-markdown-outline-target="outline"></nav>
  </details>

  <article class="min-w-0 rounded-xl border border-border bg-card p-4 shadow-sm sm:p-8">
    <% if @markdown.present? %>
      <div class="markdown-content mx-auto max-w-[78ch] text-foreground" data-markdown-outline-target="content">
        <%= helpers.render_markdown(@markdown) %>
      </div>
    <% else %>
      <p class="text-sm text-muted-foreground" data-markdown-outline-target="content">No content yet.</p>
    <% end %>
  </article>

  <aside class="hidden lg:block">
    <div class="sticky top-4 rounded-xl border border-border bg-card p-4 shadow-sm">
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-muted-foreground">Outline</h2>
      <nav class="space-y-1" aria-label="Document outline" data-markdown-outline-target="outline"></nav>
    </div>
  </aside>
</div>

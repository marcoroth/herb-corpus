<% if installment %>
  <%= form_with url: finance_loan_installment_payment_path(installment.financial_loan, installment), method: :post, class: "flex flex-wrap items-end gap-2" do %>
    <label class="w-32 space-y-1 text-xs text-muted-foreground">Actual payment
      <%= render Ui::InputComponent.new(name: "installment_payment[total]", value: transaction.amount, type: "number", min: 0.01, step: 0.01, required: true) %>
    </label>
    <label class="w-32 space-y-1 text-xs text-muted-foreground">Interest charged
      <%= render Ui::InputComponent.new(name: "installment_payment[interest]", value: installment.expected_interest, type: "number", min: 0, step: 0.01, required: true) %>
    </label>
    <label class="space-y-1 text-xs text-muted-foreground">Actual date
      <%= render Ui::InputComponent.new(name: "installment_payment[entry_date]", value: entry_date, type: "date", required: true) %>
    </label>
    <%= render Ui::ButtonComponent.new(label: "Record payment", type: "submit", size: :sm) %>
  <% end %>
<% else %>
  <%= form_with url: apply_finance_planned_transaction_path(transaction), method: :patch, class: "flex flex-wrap items-end gap-2" do %>
    <label class="w-32 space-y-1 text-xs text-muted-foreground">Actual amount
      <%= render Ui::InputComponent.new(name: "planned_transaction[amount]", value: transaction.amount, type: "number", min: 0.01, step: 0.01, required: true) %>
    </label>
    <label class="space-y-1 text-xs text-muted-foreground">Actual date
      <%= render Ui::InputComponent.new(name: "planned_transaction[entry_date]", value: entry_date, type: "date", required: true) %>
    </label>
    <%= render Ui::ButtonComponent.new(label: "Apply", type: "submit", size: :sm) %>
  <% end %>
<% end %>

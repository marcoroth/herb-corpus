<% if endpoints.any? %>
  <div class="<%= detailed? ? 'grid gap-3 sm:grid-cols-2' : 'flex flex-wrap items-center gap-1.5' %>">
    <% endpoints.each_with_index do |endpoint, index| %>
      <% unless detailed? || index.zero? %>
        <span class="text-muted-foreground" aria-hidden="true">→</span>
      <% end %>
      <div class="<%= detailed? ? 'rounded-lg border border-border bg-muted/25 p-4' : 'min-w-0' %>">
        <% if detailed? %>
          <p class="mb-1 text-xs font-medium uppercase tracking-wide text-muted-foreground"><%= endpoint[:role] %></p>
        <% end %>
        <%= link_to endpoint[:path], class: "group inline-flex min-w-0 items-center gap-1.5 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" do %>
          <span class="text-xs text-muted-foreground"><%= endpoint[:kind] %></span>
          <span class="truncate font-medium text-foreground group-hover:text-accent group-hover:underline"><%= endpoint[:name] %></span>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <span class="text-sm text-muted-foreground">Not assigned</span>
<% end %>

<div data-controller="tabs">
  <!-- Tab navigation -->
  <div class="nav nav-tabs" role="tablist">
    <button class="nav-link active" type="button" role="tab" data-tabs-target="tab" data-action="click->tabs#change" data-target="tiles">tiles</button>
    <button class="nav-link" type="button" role="tab" data-tabs-target="tab" data-action="click->tabs#change" data-target="list">list</button>
  </div>

  <!-- Panels -->
  <div class="tab-content">
    <div class="tab-pane fade active show" id="tiles" data-tabs-target="panel" role="tabpanel">
      <%= render partial: "plaques/tiles" %>
    </div>
    <div class="tab-pane fade" id="list" data-tabs-target="panel" role="tabpanel">
      <%= render partial: "plaques/rows" %>
    </div>
  </div>
</div>

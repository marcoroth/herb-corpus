
        <div class="swiper-slide" style="background-image: url(<%= post.header_image&.attached? ? rails_blob_path(post.header_image) : asset_path("post-slide-#{rand(4) + 1}.jpg") %>);">
          <div class="content">
            <h2><%= link_to post.title, posts_path(slug: post.slug) %></h2>
            <p><%= truncate_post post, length: 80 %></p>
          </div>
        </div>

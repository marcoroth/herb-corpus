<% content_for(:page_title) { t(".page_title") } %>
<% content_for(:admin_menu) { navbar_link_to(t(".posts"), railspress_path, { class: :edit, title: t(".posts") }) } %>
<% content_for(:admin_menu) { navbar_link_to(t(".todo"), todo_index_path, { class: :edit, title: t(".todo") }) } %>

<!-- Slider Section -->
<section id="slider" class="section dark-background">
  <div class="container slider" data-aos="fade-up" data-aos-delay="100">
    <div data-swiper-target="container" data-controller="swiper">
      <div class="swiper-wrapper">
        <%= render partial: "swiper_slide", collection: @slidees, as: :post %>
      </div>
      <div data-swiper-target="pagination"></div>
      <div data-swiper-target="next"></div>
      <div data-swiper-target="prev"></div>
    </div>
  </div>
</section><!-- /Slider Section -->

<!-- Searchbox Section -->
<section id="searchbox" class="section">
  <div class="container" data-aos="fade-up" data-aos-delay="100">
    <div class="row">
      <div class="col-md-9">
        <%= render "search" %>
      </div>
    </div>
  </div>
</section><!-- /Searchbox Section -->

<!-- Project Category Section -->
<section id="project-category" class="trending-category section">
  <div class="container" data-aos="fade-up" data-aos-delay="100">

    <div class="row g-5">
      <div class="col-lg-4">

        <% @project_posts[0..0]&.each do |post| %>
          <div class="post-entry lg">
            <%= link_to posts_path(slug: post.slug) do %>
              <%= image_tag post %>
            <% end %>
            <div class="post-meta"><span class="date"><%= post.category&.name %></span> <span class="mx-1">•</span> <span><time datetime="<%= post.published_at.strftime('%Y-%m-%d') %>"><%= post.published_at.strftime('%-d %b %Y') %></time></span></div>
            <h2><%= link_to post.title, posts_path(slug: post.slug) %></h2>
            <p class="mb-4 d-block"><%= truncate_post post %></p>
            <div class="d-flex align-items-center author">
              <div class="photo">
                <%= image_tag post.author&.main_photo, alt: post.author&.name, class: "img-fluid" if post.author&.main_photo %>
              </div>
              <div class="name">
                <h3 class="m-0 p-0"><%= post.author&.name %></h3>
              </div>
            </div>
          </div>
        <% end %>

      </div>

      <div class="col-lg-8">
        <div class="row g-5">
          <div class="col-lg-4 border-start custom-border">
            <% @project_posts[1..3]&.each do |post, i| %>
              <div class="post-entry">
                <%= link_to posts_path(slug: post.slug) do %>
                  <%= image_tag post %>
                <% end %>
                <div class="post-meta"><span class="date"><%= post.category&.name %></span> <span class="mx-1">•</span> <span><time datetime="<%= post.published_at.strftime("%Y-%m-%d") %>"><%= post.published_at.strftime("%-d %b %Y") %></time></span></div>
                <h2><%= link_to post.title, posts_path(slug: post.slug) %></h2>
              </div>
            <% end %>
          </div>
          <div class="col-lg-4 border-start custom-border">
            <% @project_posts[4..6]&.each do |post, i| %>
              <div class="post-entry">
                <%= link_to posts_path(slug: post.slug) do %>
                  <%= image_tag post %>
                <% end %>
                <div class="post-meta"><span class="date"><%= post.category&.name %></span> <span class="mx-1">•</span> <span><time datetime="<%= post.published_at.strftime("%Y-%m-%d") %>"><%= post.published_at.strftime("%-d %b %Y") %></time></span></div>
                <h2><%= link_to post.title, posts_path(slug: post.slug) %></h2>
              </div>
            <% end %>
          </div>

          <!-- Trending Section -->
          <div class="col-lg-4">

            <div class="trending">
              <h3>The latest</h3>
              <ul class="trending-post">
                <% @trending.each_with_index do |post, i| %>
                  <li>
                    <%= link_to posts_path(slug: post.slug) do %>
                      <span class="number"><%= i + 1 %></span>
                      <h3><%= post.title %></h3>
                      <span class="author"><%= post.author&.name %></span>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </div>

          </div> <!-- End Trending Section -->
        </div>
      </div>

    </div> <!-- End .row -->

  </div>
</section><!-- /Project Category Section -->

<!-- Culture Category Section -->
<section id="culture-category" class="culture-category section">
  <!-- Section Title -->
  <div class="container section-title" data-aos="fade-up">
    <div class="section-title-container d-flex align-items-center justify-content-between">
      <h2>Culture</h2>
      <!--
      <p><a href="categories.html">See All Culture</a></p>
      -->
    </div>
  </div><!-- End Section Title -->

  <div class="container" data-aos="fade-up" data-aos-delay="100">

    <div class="row">
      <div class="col-md-9">

      <% @culture_posts[0..0]&.each do |post| %>
        <div class="d-lg-flex post-entry">
          <%= link_to posts_path(slug: post.slug), class: "me-4 thumbnail mb-4 mb-lg-0 d-inline-block" do %>
            <%= image_tag post %>
          <% end %>
          <div>
            <div class="post-meta"><span class="date"><%= post.category&.name %></span> <span class="mx-1">•</span> <span><time datetime="<%= post.published_at.strftime('%Y-%m-%d') %>"><%= post.published_at.strftime('%-d %b %Y') %></time></span></div>
            <h3><%= link_to post.title, posts_path(slug: post.slug) %></h3>
            <p><%= truncate_post post %></p>
            <div class="d-flex align-items-center author">
              <div class="photo">
                <%= image_tag post.author&.main_photo, alt: "", class: "img-fluid" if post.author&.main_photo %>
              </div>
              <div class="name">
                <h3 class="m-0 p-0"><%= post.author&.name %></h3>
              </div>
            </div>
          </div>
        </div>
      <% end %>

        <div class="row">
          <div class="col-lg-4">
          <% @culture_posts[1..1]&.each do |post| %>
            <div class="post-list border-bottom">
              <%= link_to posts_path(slug: post.slug) do %>
                <%= image_tag post %>
              <% end %>
              <div class="post-meta"><span class="date"><%= post.category&.name %></span> <span class="mx-1">•</span> <span><time datetime="<%= post.published_at.strftime('%Y-%m-%d') %>"><%= post.published_at.strftime('%-d %b %Y') %></time></span></div>
              <h2 class="mb-2"><%= link_to post.title, posts_path(slug: post.slug) %></h2>
              <span class="author mb-3 d-block"><%= post.author&.name %></span>
              <p class="mb-4 d-block"><%= truncate_post post %></p>
            </div>
          <% end %>
          <% @culture_posts[2..2]&.each do |post| %>
            <div class="post-list">
              <div class="post-meta"><span class="date"><%= post.category&.name %></span> <span class="mx-1">•</span> <span><time datetime="<%= post.published_at.strftime('%Y-%m-%d') %>"><%= post.published_at.strftime('%-d %b %Y') %></time></span></div>
              <h2 class="mb-2"><%= link_to post.title, posts_path(slug: post.slug) %></h2>
              <span class="author mb-3 d-block"><%= post.author&.name %></span>
            </div>
          <% end %>
          </div>
          <div class="col-lg-8">
            <% @culture_posts[3..3]&.each do |post| %>
              <div class="post-list">
                <%= link_to posts_path(slug: post.slug) do %>
                  <%= image_tag post.header_image, alt: post.header_image.custom_metadata["alt"], class: "img-fluid" %>
                <% end if post.header_image&.attached? %>
                <div class="post-meta"><span class="date"><%= post.category&.name %></span> <span class="mx-1">•</span> <span><time datetime="<%= post.published_at.strftime('%Y-%m-%d') %>"><%= post.published_at.strftime('%-d %b %Y') %></time></span></div>
                <h2 class="mb-2"><%= link_to post.title, posts_path(slug: post.slug) %></h2>
                <span class="author mb-3 d-block"><%= post.author&.name %></span>
                <p class="mb-4 d-block"><%= truncate_post post %></p>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="col-md-3">
        <% @culture_posts[4..]&.each do |post| %>
          <div class="post-list border-bottom">
            <div class="post-meta"><span class="date"><%= post.category&.name %></span> <span class="mx-1">•</span> <span><time datetime="<%= post.published_at.strftime('%Y-%m-%d') %>"><%= post.published_at.strftime('%-d %b %Y') %></time></span></div>
            <h2 class="mb-2"><%= link_to post.title, posts_path(slug: post.slug) %></h2>
            <span class="author mb-3 d-block"><%= post.author&.name %></span>
          </div>
        <% end %>
      </div>
    </div>

  </div>

</section><!-- /Culture Category Section -->


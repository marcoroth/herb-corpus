<% content_for(:page_title) { t(".page_title") } %>
<% content_for(:title) {t(".page_heading") } %>

<!-- Page Title -->
<div class="page-title">
  <div class="container d-lg-flex justify-content-between align-items-center">
    <h1 class="mb-2 mb-lg-0"><%= t(".page_heading") %></h1>
    <nav class="breadcrumbs">
      <ol>
        <li><%= link_to "Home", root_path %></li>
        <li><%= link_to "Photographers", photographers_path %></li>
        <li class="current">New</li>
      </ol>
    </nav>
  </div>
</div><!-- End Page Title -->

<section class="section">
  <div class="container" data-aos="fade-up" data-aos-delay="100">

    <%= form_tag("/photographers", method: "create") do %>
      <div class="mb-3">
        <%= label_tag(:flickr_url, t(".flickr_url")) %>
        <%= text_field_tag(:flickr_url) %>
      </div>
      <%= submit_tag t("buttons.add") %>
    <% end %>

</div>
</section>

<% content_for(:page_title) { t(".page_title", photo: @photo.title) } %>
<% content_for(:admin_menu) { navbar_link_to t("buttons.new"), new_photo_path } %>

<!-- Page Title -->
<div class="page-title">
  <div class="container d-lg-flex justify-content-between align-items-center">
    <h1 class="mb-2 mb-lg-0"><%= t(".page_heading", photo: @photo.title) %></h1>
    <nav class="breadcrumbs">
      <ol>
        <li><%= link_to "Home", root_path %></li>
        <li>Photos</li>
        <li><%= link_to @photo %></li>
        <li class="current">Edit</li>
      </ol>
    </nav>
  </div>
</div><!-- End Page Title -->

<section class="section">
  <div class="container" data-aos="fade-up" data-aos-delay="100">

    <%= form_for @photo do |f| %>
      <div class="row">
        <div class="col-xs-12 col-sm-6">
          <section class="section">
            <%= render "section_title", title: "Subject" %>
            <% if @plaques && @plaques.size > 0 %>
              <p>This image is unlinked. The nearest plaque is <%= @plaques.first.distance_to(@photo) %> metres away</p>
            <% elsif !@photo.linked? %>
              <p>This image is unlinked. There are no plaques nearby. Set the subject and shot.</p>
            <% end %>
            <div class="mb-3">
              <%= f.label :of_a_plaque %>
              <%= f.check_box :of_a_plaque %>
            </div>
            <div class="row">
              <div class="col-sm-6 col-md-6">
                <div class="form-floating">
                  <%= f.number_field :plaque_id, maxlength: 5 %>
                  <%= f.label :plaque_id %>
                  <%= render partial: "plaques/tile", object: @photo.plaque, as: :plaque if @photo.plaque %>
                </div>
              </div>
              <div class="col-sm-6 col-md-6">
                <div class="form-floating">
                  <%= f.text_field :person_id, maxlength: 5 %>
                  <%= f.label :person_id %>
                  <%= link_to(@photo.person, @photo.person) if @photo.person %>
                </div>
              </div>
            </div>
            <div class="col-sm-6 col-md-6">
              <div class="form-floating">
                <%= f.number_field :clone_id, maxlength: "5" %>
                <%= f.label :clone_id %>
              </div>
            </div>
            <div class="col-sm-6 col-md-12">
              <div class="form-floating">
                <%= f.collection_select :shot, Photo.shots, :to_s, :to_s, {include_blank: true, class: "form-select"} %>
                <%= f.label :shot %>
              </div>
            </div>
            <%= f.submit t("buttons.save") %>
          </section>

          <section>
            <%= render "section_title", title: "Source description" %>
            <div class="col-sm-6 col-md-12">
              <div class="form-floating">
                <%= f.text_field :subject %>
                <%= f.label :subject %>
              </div>
            </div>
            <% if /\[\[/ =~ @photo.description %>
              <div class="row">
                <%= link_to(fa_icon(:link) + "Geograph image mentioned", "http://www.geograph.org.uk/photo/#{@photo.description.match(/\[\[(\d*)\]\]/i).try(:captures)[0]}", target: :_blank) %>
              </div>
            <% end %>
            <div class="col-sm-6 col-md-12">
              <div class="form-floating">
                <%= f.text_area :description, rows: 12, style: "height: 200px" %>
                <%= f.label :description %>
              </div>
            </div>
          </section>
        </div>
        <div class="col-xs-12 col-sm-6">
          <%= link_to(@photo.file_url) do %>
            <%= render @photo, large: true %>
          <% end %>
        </div>
      </div>



      <% if @plaques && @plaques.size > 0 %>
        <section class="section">
          <%= render "section_title", title: "Nearby plaques" %>
          <div class="mb-3">
            <div class="col-xs-6 col-sm-2">
            </div>
            <div class="col-xs-6 col-sm-10">
              <%= f.radio_button :plaque_id, nil %>
              None of these
            </div>
          </div>
          <% @plaques.each do |plaque| %>
            <div class="row">
              <%= render partial: "plaques/tile", object: plaque, as: :plaque %>
              <div class="col-xs-6 col-sm-10">
                <%= f.radio_button :plaque_id, plaque.id %>
                plaque #<%= plaque.id %> at <%= plaque.distance_to(@photo) %> metres
                <br/><br/>
                "<%= plaque.inscription %>"
              </div>
            </div>
          <% end %>
          </section>
      <% end %>

      <%= f.submit t("buttons.save")%>
  
      <section class="section">
        <%= render "section_title", title: "URLs" %>
        <div class="col-sm-6 col-md-6">
          <div class="form-floating">
            <%= f.text_field :url, maxlength: 100 %>
            <%= f.label :url %>
            <%= link_to(fa_icon(:link), @photo.url, target: :_blank) %>
          </div>
        </div>
        <div class="col-sm-6 col-md-6">
          <div class="form-floating">
            <%= f.text_field :file_url, maxlength: 100 %>
            <%= f.label :file_url %>
            <%= link_to(fa_icon(:link), @photo.file_url, target: :_blank) %>
          </div>
        </div>
        <div class="col-sm-6 col-md-6">
          <div class="form-floating">
            <%= f.text_field :thumbnail, maxlength: 100 %>
            <%= f.label :thumbnail %>
            <%= link_to(fa_icon(:link), @photo.thumbnail, target: :_blank) %>
          </div>
        </div>
        <div class="col-sm-6 col-md-6">
          <div class="form-floating">
            <%= f.text_field :photographer %>
            <%= f.label :photographer %>
          </div>
        </div>
        <div class="col-sm-6 col-md-6">
          <div class="form-floating">
            <%= f.text_field :photographer_url, size: 80 %>
            <%= f.label :photographer_url %>
            <%= link_to(fa_icon(:link), @photo.photographer_url, target: :_blank) %>
          </div>
        </div>
        <div class="col-sm-6 col-md-6">
          <div class="form-floating">
            <%= f.collection_select :licence_id, @licences, :id, :name, { include_blank: true } %>
            <%= f.label :licence_id %>
          </div>
        </div>
      </section>
      <%= f.submit t("buttons.save") %>
    <% end %>

    <br/>
    <div class="row">
      <%= button_to t("buttons.delete"), photo_path(@photo), { method: :delete, class: "btn btn-danger" } if current_user.try(:is_admin?) %>
    </div>

  </div>
</section>

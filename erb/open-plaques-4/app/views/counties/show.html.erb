<% if @display != "unphotographed" %>
  <% content_for(:page_title) { t(".page_title", area: "#{@county}, #{@areas.first&.country&.name}") } %>
<% else %>
  <% content_for(:page_title) { t(".page_title_unphotographed", area: "#{@county}, #{@areas.first&.country&.name}") } %>
<% end %>

<!-- Page Title -->
<div class="page-title">
  <div class="container d-lg-flex justify-content-between align-items-center">
    <h1 class="mb-2 mb-lg-0"><span class="flag-icon flag-icon-<%= @areas.first&.alpha2 %>"></span> <%= @county %></h1>
    <nav class="breadcrumbs">
      <ol>
        <li><%= link_to "Home", root_path %></li>
        <li><%= link_to "Places", countries_path %></li>
        <li><%= link_to @areas.first&.country %></li>
        <li class="current"><%= @county %></li>
      </ol>
    </nav>
  </div>
</div><!-- End Page Title -->

<div class="container" data-aos="fade-up" data-aos-delay="100">
  <div class="row">

    <div class="col-lg-8">

      <section class="section">
        <div class="jumbotron">
          <br/><span class="badge bg-secondary pull-right"><%= pluralize_with_no(@plaques_count, t("activerecord.models.plaque").downcase) %></span>
          <small><%= @percentage_curated %>% have been curated</small>
          <br/><span class="badge bg-secondary pull-right"><%= pluralize_with_no(@subject_count, "subject") %></span>
        </div>
        <%= render partial: "people/top10" %>
        <% if @display!='ungeolocated' %>
          <section id="county_map" data-controller="maplibre" data-maplibre-style="<%= JSON[
            @bbox_array ? 
            {
              bounds: @bbox_array,
              fitBoundsOptions: {
                padding: 50
              }
            }
            :
            { centroid: @center_point_array }
          ] %>" style="height: 400px; width: 100%; margin-top: 15px;">
            <template data-controller="geojson" data-url="<%= county_path(@county, format: :geojson) %>" data-map-id="county_map">
              when this is displayed it sends a message to the map to display popups then autodestructs
            </template>
          </section>
        <% end %>
      </section>

      <section class="section">
        <%= render "section_title", title: "Areas" %>
        <div class="container" data-aos="fade-up" data-aos-delay="100">
          <% @areas.sort { |a,b| a.state.to_s + a.name <=> b.state.to_s + b.name }.group_by(&:state).each do |state, areas| %>
            <div class="row" data-masonry='{"percentPosition": true }'>
              <%= render areas %>
            </div>
          <% end %>
        </div>
      </section>

      <section class="section">
        <%= render "section_title", title: "Plaques" %>
        <%= render partial: "plaques/tabbed" %>
      </section>

    </div>

    <div class="col-lg-4 sidebar">
      <div class="widgets-container">

        <%= render "search" %>
        <%= render "people/diversity" %>

      </div>
    </div>

  </div>
</div>

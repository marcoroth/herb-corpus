<% content_for(:page_title) { t(".page_title", role: @role.name) } %>
<% content_for(:admin_menu) { navbar_link_to t("buttons.add"), new_role_path } %>

<!-- Page Title -->
<div class="page-title">
  <div class="container d-lg-flex justify-content-between align-items-center">
    <h1 class="mb-2 mb-lg-0"><%= t(".page_heading", role: @role.name) %></h1>
    <nav class="breadcrumbs">
      <ol>
        <li><%= link_to "Home", root_path %></li>
        <li><%= link_to "Roles", roles_path %></li>
        <li><%= link_to @role %></li>
        <li class="current">Edit</li>
      </ol>
    </nav>
  </div>
</div><!-- End Page Title -->

<section class="section">
  <div class="container" data-aos="fade-up" data-aos-delay="100">

    <%= form_for @role, html: { class: "row g-3 mb-9" } do |f| %>
      <div class="col-sm-6 col-md-12">
        <div class="form-floating">
          <%= f.text_field :name %>
          <%= f.label :name %>
        </div>
      </div>
      <div class="col-sm-6 col-md-3">
        <div class="form-floating">
          <%= f.collection_select :role_type, Role.types, :to_s, :to_s, include_blank: true %>
          <%= f.label :role_type %>
        </div>
      </div>
      <div class="col-sm-6 col-md-12">
        <div class="form-floating">
          <%= f.text_field :abbreviation %>
          <%= f.label :abbreviation %>
        </div>
      </div>
      <div class="col-sm-6 col-md-12">
        <div class="form-floating">
          <%= f.text_field :prefix %>
          <%= f.label :prefix %>
        </div>
      </div>
      <div class="col-sm-6 col-md-12">
        <div class="form-floating">
          <%= f.text_field :suffix %>
          <%= f.label :suffix %>
        </div>
      </div>
      <div class="col-sm-6 col-md-2">
        <div class="form-floating">
          <%= f.number_field :priority %>
          <%= f.label :priority %>
        </div>
      </div>
      <div class="col-sm-6 col-md-12">
        <div class="form-floating">
          <%= f.text_field :slug %>
          <%= f.label :slug %>
        </div>
      </div>
      <section class="section">
        <%= render "section_title", title: "Links" %>
        <div class="mb-3">
          <%= link_to "Wikidata <i class=\"bi bi-box-arrow-up-right\"></i>".html_safe, @role.wikidata_url, target: :_blank unless @role.wikidata_id.blank?%>
          <%= link_to "Wikipedia<i class=\"bi bi-box-arrow-up-right\"></i>".html_safe, @role.wikipedia_url, target: :_blank unless @role.wikipedia_url.blank? %>
        </div>
        <div class="col-sm-6 col-md-8">
          <div class="form-floating">
            <%= f.text_field :wikidata_id %>
            <%= f.label :wikidata_id %>
            <%= t(".wikidata_comment") %>
          </div>
        </div>
        <div class="col-sm-6 col-md-8">
          <div class="form-floating">
            <%= f.text_field :en_wikipedia_url %>
            <%= f.label :en_wikipedia_url %>
          </div>
        </div>
      </section>
      <section class="section">
        <%= render "section_title", title: "Description" %>
        <div class="col-sm-6 col-md-12">
          <div class="form-floating">
            <%= f.text_area :description, rows: 6, style: "height: 200px" %>
            <%= f.label :description %>
          </div>
        </div>
        <div class="col-sm-6 col-md-4">
          <div class="form-floating">
            <%= f.text_field :citation %>
            <%= f.label :citation %>
          </div>
        </div>
      </section>
      <div class="d-flex justify-content-between align-items-center">
        <div class="d-flex">
          <%= f.submit t("buttons.update") %>
        </div>
      </div>
    <% end %>

  </div>
</section>

<!-- Recent Posts Widget -->
<div class="recent-posts-widget widget-item">
  <h3 class="widget-title">Recent Posts</h3>
  <% Page.random(5).each do |page| %>
    <div class="post-item">
      <%= image_tag page.header_image.thumbnail_url, alt: "", class: "flex-shrink-0" if page.header_image %>
      <div>
        <h4><%= link_to page.title, page %></h4>
        <time datetime="<%= page.published_at.strftime('%Y-%m-%d') %>"><%= page.published_at.strftime('%-d %b %Y') %></time>
      </div>
    </div><!-- End recent post item-->
  <% end %>
</div><!--/Recent Posts Widget -->

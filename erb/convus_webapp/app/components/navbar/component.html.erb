<nav class="bg-white border-b border-gray-200 dark:bg-gray-900 dark:border-gray-700">
  <div
    class="
      max-w-screen-xl flex flex-wrap items-center justify-between mx-auto
      px-4 py-3
    "
  >
    <% if @admin %>
      <%= link_to admin_root_path, class: "flex items-center space-x-3" do %>
        <span class="relative h-6 w-6 inline-block overflow-visible">
          <img
            src="/icon1.svg"
            class="absolute h-11 w-11 -top-2.5 -left-2.5 max-w-none"
            alt=""
          >
        </span>

        <span class="text-lg font-semibold text-gray-900 dark:text-white">
          Seth Template
        </span>

        <span
          class="
            text-xs font-medium text-indigo-600 dark:text-indigo-400
            bg-indigo-50 dark:bg-indigo-900/30 px-2 py-0.5 rounded-full
          "
        >
          Admin
        </span>
      <% end %>
    <% else %>
      <%= link_to @user_root_url, class: "flex items-center space-x-3" do %>
        <span class="relative h-6 w-6 inline-block overflow-visible">
          <img
            src="/icon1.svg"
            class="absolute h-11 w-11 -top-2.5 -left-2.5 max-w-none"
            alt=""
          >
        </span>

        <span class="text-lg font-semibold text-gray-900 dark:text-white sm:text-xl">
          Seth Template
        </span>
      <% end %>
    <% end %>

    <div class="flex items-center space-x-3">
      <% if @admin %>
        <%= render(UI::ButtonLink::Component.new(
          text: "Users", href: admin_users_path,
          active: helpers.current_page_active?(admin_users_path, true)
        )) %>
        <%= link_to "Exit Admin", root_path, class: "twlink text-sm" %>
      <% elsif @current_user.blank? %>
        <button
          type="button"
          data-open-modal="visitor-settings-modal"
          aria-label="Settings"
          class="
            text-gray-500 hover:text-gray-700 dark:text-gray-400
            dark:hover:text-gray-200 cursor-pointer
          "
        >
          <svg
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z"
            />

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
            />
          </svg>
        </button>
        <%= link_to "Log in", new_user_session_path, class: "twlink text-sm" %>
        <%= render(UI::ButtonLink::Component.new(
          text: "Sign up", href: new_user_registration_path,
          color: :primary, active: helpers.current_page_active?(new_user_registration_path)
        )) %>
        <%= render(UI::Modal::Component.new(id: "visitor-settings-modal", title: "Settings")) do |modal| %>
          <% modal.with_body do %>
            <div
              data-controller="theme"
              data-theme-current-value="<%= visitor_theme %>"
            >
              <h4 class="text-sm font-medium text-gray-900 dark:text-white mb-3">
                Theme
              </h4>

              <div class="flex gap-3">
                <% User::THEME_ENUM.each_key do |theme_key| %>
                  <button
                    type="button"
                    data-action="click->theme#select"
                    data-theme-target="option"
                    data-theme="<%= theme_key %>"
                    class="
                      flex flex-col items-center gap-2 px-4 py-3 rounded-lg border
                      border-gray-200 dark:border-gray-700 transition-all
                      cursor-pointer hover:border-gray-400
                      dark:hover:border-gray-500
                    "
                  >
                    <% case theme_key %>
                    <% when :theme_system %>
                      <svg
                        class="w-6 h-6 text-gray-500 dark:text-gray-400"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="1.5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25A2.25 2.25 0 0 1 5.25 3h13.5A2.25 2.25 0 0 1 21 5.25Z"
                        />
                      </svg>
                      <span class="text-xs font-medium text-gray-700 dark:text-gray-300">
                        System
                      </span>
                    <% when :theme_light %>
                      <svg
                        class="w-6 h-6 text-amber-500"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
                          fill-rule="evenodd"
                          clip-rule="evenodd"
                        />
                      </svg>
                      <span class="text-xs font-medium text-gray-700 dark:text-gray-300">
                        Light
                      </span>
                    <% when :theme_dark %>
                      <svg
                        class="w-6 h-6 text-indigo-400"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
                        />
                      </svg>
                      <span class="text-xs font-medium text-gray-700 dark:text-gray-300">
                        Dark
                      </span>
                    <% end %>
                  </button>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <%= render(UI::Dropdown::Component.new(
          name: "User",
          button_class: "flex items-center text-sm rounded-full focus:ring-2 focus:ring-gray-300 dark:focus:ring-gray-600 cursor-pointer"
        )) do |dropdown| %>
          <% dropdown.with_button { avatar_button_content } %>

          <% dropdown.with_entry_item do %>
            <%= link_to(edit_account_path, class: "block px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-t-lg") do %>
              <span class="block text-sm font-medium text-gray-900 dark:text-white">
                <%= @current_user.display_name %>
              </span>

              <span class="block text-xs text-gray-500 dark:text-gray-400 truncate">
                <%= @current_user.email %>
              </span>
            <% end %>
          <% end %>

          <%= dropdown.with_entry_divider %>

          <% if @current_user.admin_access? %>
            <% dropdown.with_entry_item { link_to("Admin", admin_root_path) } %>
          <% end %>

          <% dropdown.with_entry_item { link_to("Logout", destroy_user_session_path, data: {turbo: false}) } %>
        <% end %>
      <% end %>
    </div>
  </div>
</nav>

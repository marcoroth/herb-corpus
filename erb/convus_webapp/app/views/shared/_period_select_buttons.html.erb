<% skip_submission ||= false %>
<% include_future ||= false %>
<% prepend_text ||= nil %>

<div id="timeSelectionBtnGroup" role="group" class="text-right <%= 'custom-period-selected' if @period == 'custom' %>" data-nosubmit="<%= skip_submission %>">
  <% if prepend_text.present? %>
    <span class="mr-2 less-strong d-block d-lg-inline-block"><%= prepend_text %></span>
  <% end %>

  <% if include_future %>
    <a href="<%= url_for(sortable_search_params.merge(period: "next_week")) %>" class="btn btn-secondary btn-sm period-select-standard <%= 'active' if @period == 'next_week' %>" data-period="next_week">
      <span class="d-none d-md-inline-block">next</span> seven days
    </a>
    <a href="<%= url_for(sortable_search_params.merge(period: "next_month")) %>" class="btn btn-secondary btn-sm period-select-standard <%= 'active' if @period == 'next_month' %>" data-period="next_month">
      <span class="d-none d-md-inline-block">next</span> thirty days
    </a>
  <% end %>

  <a href="<%= url_for(sortable_search_params.merge(period: "hour")) %>" class="btn btn-secondary btn-sm period-select-standard <%= 'active' if @period == 'hour' %>" data-period="hour">
    <span class="d-none d-md-inline-block">past</span> hour
  </a>
  <a href="<%= url_for(sortable_search_params.merge(period: "day")) %>" class="btn btn-secondary btn-sm period-select-standard <%= 'active' if @period == 'day' %>" data-period="day">
    <span class="d-none d-md-inline-block">past</span> day
  </a>
  <a href="<%= url_for(sortable_search_params.merge(period: "week")) %>" class="btn btn-secondary btn-sm period-select-standard <%= 'active' if @period == 'week' %>" data-period="week">
    <span class="d-none d-md-inline-block">past</span> seven days
  </a>
  <a href="<%= url_for(sortable_search_params.merge(period: "month")) %>" class="btn btn-secondary btn-sm period-select-standard <%= 'active' if @period == 'month' %>" data-period="month">
    <span class="d-none d-md-inline-block">past</span> thirty days
  </a>
  <a href="<%= url_for(sortable_search_params.merge(period: "year")) %>" class="btn btn-secondary btn-sm period-select-standard <%= 'active' if @period == 'year' %>" data-period="year">
    <span class="d-none d-md-inline-block">past</span> year
  </a>
  <a href="<%= url_for(sortable_search_params.merge(period: "all")) %>" class="btn btn-secondary btn-sm period-select-standard <%= 'active' if @period == 'all' %>" data-period="all">
    all
  </a>
  <button id="periodSelectCustom" class="btn btn-secondary btn-sm ml-2 <%= 'active' if @period == 'custom' %>" data-period="custom">
    custom
  </button>
</div>

<form id="timeSelectionCustom" class="custom-time-selection row mt-2 collapse <%= 'in show' if @period == 'custom' %>">
  <div class="form-group">
    <%= label_tag :start_time_selector, "from", class: "control-label mr-2" %>
    <%= datetime_local_field_tag :start_time_selector, @start_time.strftime("%Y-%m-%dT%H:%M"), step: 60, class: "form-control" %>
  </div>
  <div class="form-group end-time-control">
    <%= label_tag :end_time_selector, "to", class: "control-label mr-2 ml-2" %>
    <%= datetime_local_field_tag :end_time_selector, @end_time.strftime("%Y-%m-%dT%H:%M"), step: 60, class: "form-control" %>
  </div>
  <button id="updatePeriodSelectCustom" class="btn btn-primary btn-sm ml-2">
    update
  </button>
</form>

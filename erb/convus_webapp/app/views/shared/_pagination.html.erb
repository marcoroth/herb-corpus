<%# Requires locals: pagy %>
<%# Optional locals: name, skip_total, skip_pagination %>
<% skip_total ||= false %>
<% skip_pagination ||= false %>

<div class="pagination-container">
  <% unless skip_total %>
    <div class="col-md-5">
      <p class="pagination-number">
        <strong><%= number_with_delimiter(pagy.count) %></strong>
        Matching <%= (defined?(name) ? name : controller_name.humanize).pluralize(pagy.count) %>
        <% if defined?(@time_range) && @period != "all" %>
          <em>
            <% if defined?(@time_range_column) %>
              <strong><%= humanized_time_range_column(@time_range_column) %></strong>
            <% end %>
            <%= humanized_time_range(@time_range) %>
          </em>
        <% end %>
      </p>
    </div>
  <% end %>
  <% unless skip_pagination %>
    <div class="pagination-flex justify-content-md-end <%= skip_total ? 'col-12' : 'col-md-7' %>">
      <%= render(UI::Pagination::Component.new(pagy: pagy, page_params: sortable_search_params)) %>
      <% if pagy.count > pagy.limit %>
        <% per_pages = [10, 25, 50, 100, pagy.limit].uniq.sort %>
        <%= select_tag :per_page_select, options_for_select(per_pages.map { |i| ["#{i} / page", i] }, selected: pagy.limit), class: "form-control per-page-select" %>
      <% end %>
    </div>
  <% end %>
</div>

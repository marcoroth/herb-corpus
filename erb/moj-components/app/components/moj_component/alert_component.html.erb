<% dynamic_class = "moj-alert--#{type}" %>

<div role="region" class="moj-alert <%= dynamic_class %> moj-alert--with-heading" aria-label="<%= type %>: <%= heading %>" data-module="moj-alert">
  <div>
    <svg class="moj-alert__icon" role="presentation" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 30 30" height="30" width="30">
      <%= icon %>
    </svg>
  </div>
  <div class="moj-alert__content">
    <% if heading.present? %>
      <h2 class="moj-alert__heading"><%= heading %></h2>
    <% end %>
    <%= body %>
  </div>
  <% if dismiss_text.present? %>
    <div class="moj-alert__action">
      <%= govuk_link_to(
            dismiss_text,
            dismiss_href,
            method: dismiss_method,
            class: "moj-alert__dismiss",
          ) %>
    </div>
  <% end %>
</div>

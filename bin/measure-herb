#!/usr/bin/env ruby
# frozen_string_literal: true

# Measures one Herb version against the extracted corpus and prints JSON.
#
#   bin/measure-herb --version 0.10.2 --out runs/release.json
#   bin/measure-herb --gem-path ../herb --label "this branch"

require "json"
require "optparse"
require "fileutils"
require "stringio"

require_relative "../lib/pluralize"

include Pluralize

options = { root: File.expand_path("../erb", __dir__), limit: nil, version: nil, gem_path: nil, out: nil, label: nil }

OptionParser.new do |parser|
  parser.banner = "usage: measure-herb [options]"
  parser.on("--version V", "Herb gem version to measure") { |v| options[:version] = v }
  parser.on("--gem-path PATH", "Load Herb from a working tree instead of an installed gem") { |v| options[:gem_path] = v }
  parser.on("--label TEXT", "How to name this run in a comparison (default: derived)") { |v| options[:label] = v }
  parser.on("--corpus DIR", "Directory of .erb files (default: erb/)") { |v| options[:root] = File.expand_path(v) }
  parser.on("--limit N", Integer, "Only measure the first N files, for a quick check") { |v| options[:limit] = v }
  parser.on("--out FILE", "Write JSON here instead of stdout") { |v| options[:out] = v }
end.parse!

if options[:gem_path]
  $LOAD_PATH.unshift(File.join(File.expand_path(options[:gem_path]), "lib"))
elsif options[:version]
  if defined?(Bundler) || ENV["RUBYOPT"].to_s.include?("bundler")
    abort "measure-herb resolves Herb itself and cannot run inside Bundler.\n" \
          "Run it directly, or via `bin/corpus measure`, which clears the bundle for you."
  end

  gem "herb", options[:version]
end

require "herb"
require "herb/project"

unless defined?(Herb::Project) && Herb::Project.method_defined?(:analyze!)
  abort "herb #{Herb::VERSION} has no Herb::Project#analyze!; cannot measure comparably"
end

METRIC = "herb_project_statuses"

PARSE_STATUSES = %i[template_error unexpected_error strict_parse_error analyze_parse_error timeout failed].freeze
COMPILE_STATUSES = %i[compilation_failed strict_compilation_failed invalid_ruby validation_error].freeze

def git_describe(dir)
  return nil unless File.directory?(File.join(dir, ".git"))

  Dir.chdir(dir) do
    branch = `git rev-parse --abbrev-ref HEAD 2>/dev/null`.strip
    sha = `git rev-parse --short HEAD 2>/dev/null`.strip

    next nil if sha.empty?

    branch.empty? || branch == "HEAD" ? sha : "#{branch}@#{sha}"
  end
rescue StandardError
  nil
end

herb_ref = options[:gem_path] ? git_describe(File.expand_path(options[:gem_path])) : nil

label =
  options[:label] ||
  if options[:gem_path]
    herb_ref ? "working tree (#{herb_ref})" : "working tree"
  else
    "released #{Herb::VERSION}"
  end

files = Dir.glob(File.join(options[:root], "**", "*.erb"), File::FNM_DOTMATCH).sort
files = files.first(options[:limit]) if options[:limit]

abort "no .erb files under #{options[:root]}" if files.empty?

project = Herb::Project.new(options[:root])

project.file_paths = files
project.silent = true
project.no_log_file = true
project.no_timing = true
project.validate_ruby = true

started = Process.clock_gettime(Process::CLOCK_MONOTONIC)

captured = StringIO.new
original = $stdout
$stdout = captured

begin
  project.analyze!
ensure
  $stdout = original
end

elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started

results = project.instance_variable_get(:@results)

abort "Herb::Project produced no results" unless results

relative = ->(path) { path.to_s.sub("#{options[:root]}/", "") }

diagnostics = (results.file_diagnostics || {}).to_h { |path, list| [relative.call(path), list] }

by_status = {}

(PARSE_STATUSES + COMPILE_STATUSES).each do |status|
  next unless results.respond_to?(status)

  by_status[status.to_s] = Array(results.public_send(status)).map { |path| relative.call(path) }.sort
end

parse_failing = {}
compile_failing = {}

PARSE_STATUSES.each do |status|
  by_status[status.to_s]&.each do |file|
    parse_failing[file] = {
      "status" => status.to_s,
      "errors" => Array(diagnostics[file]).map { |d| d[:name] || d["name"] }.compact.tally
    }
  end
end

COMPILE_STATUSES.each do |status|
  by_status[status.to_s]&.each { |file| compile_failing[file] = status.to_s }
end

malformed = by_status["template_error"] || []

corpus_commit =
  begin
    Dir.chdir(File.dirname(__dir__)) { `git rev-parse HEAD 2>/dev/null`.strip }
  rescue StandardError
    ""
  end

report = {
  "label" => label,
  "herb_version" => Herb::VERSION,
  "herb_ref" => herb_ref,
  "source" => options[:gem_path] ? "working-tree" : "gem",
  "metric" => METRIC,
  "corpus" => options[:root],
  "corpus_commit" => (corpus_commit.empty? ? nil : corpus_commit),
  "files" => files.size,
  "files_clean" => Array(results.successful).size,
  "files_failing_parse" => parse_failing.size,
  "files_failing_compile" => compile_failing.size,
  "files_malformed" => malformed.size,
  "status_counts" => by_status.transform_values(&:size).reject { |_, count| count.zero? },
  "diagnostic_counts" => diagnostics.values.flatten.filter_map { |d| d[:name] || d["name"] }.tally.sort_by { |_, c| -c }.to_h,
  "seconds" => elapsed.round(1),
  "parse_failing" => parse_failing.sort.to_h,
  "compile_failing" => compile_failing.sort.to_h
}

json = JSON.pretty_generate(report)

if options[:out]
  FileUtils.mkdir_p(File.dirname(options[:out]))
  File.write(options[:out], "#{json}\n")

  warn "#{label}: #{pluralize(malformed.size, "malformed template")}, " \
       "#{parse_failing.size} parse and #{compile_failing.size} compile " \
       "#{noun_for(compile_failing.size, "issue")} of #{files.size} files (#{elapsed.round(1)}s) -> #{options[:out]}"
else
  puts json
end

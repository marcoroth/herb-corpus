#!/usr/bin/env ruby
# frozen_string_literal: true

# Diffs two measurement runs produced by bin/measure-herb.
#
#   bin/diff-runs runs/release.json runs/branch.json --fail-on-regression

require "json"
require "optparse"
require "set"

require_relative "../lib/pluralize"

include Pluralize

fail_on_regression = false
markdown_path = nil

OptionParser.new do |parser|
  parser.banner = "usage: diff-runs BEFORE.json AFTER.json [options]"
  parser.on("--fail-on-regression", "Exit non-zero if any file regressed or started crashing") { fail_on_regression = true }
  parser.on("--markdown FILE", "Also write a Markdown report, for a pull request comment") { |value| markdown_path = value }
end.parse!

before_path, after_path = ARGV
abort "usage: diff-runs BEFORE.json AFTER.json [--fail-on-regression]" unless before_path && after_path

module Color
  ENABLED = $stdout.tty? && !ENV.key?("NO_COLOR")

  def self.wrap(text, code) = ENABLED ? "\e[#{code}m#{text}\e[0m" : text.to_s

  def self.bold(text) = wrap(text, 1)
  def self.dim(text) = wrap(text, 2)
  def self.red(text) = wrap(text, 31)
  def self.green(text) = wrap(text, 32)
  def self.yellow(text) = wrap(text, 33)
end

def load_run(path)
  abort "no such run: #{path}" unless File.exist?(path)

  JSON.parse(File.read(path))
end

def visible_length(text) = text.to_s.gsub(/\e\[[0-9;]*m/, "").length

def table(rows, headers)
  widths = headers.each_index.map do |index|
    ([headers[index]] + rows.map { |row| row[index].to_s }).map { |cell| visible_length(cell) }.max
  end

  puts headers.each_with_index.map { |header, index| Color.bold(header.ljust(widths[index])) }.join("  ")
  puts widths.map { |width| Color.dim("-" * width) }.join("  ")

  rows.each do |row|
    puts row.each_with_index.map { |cell, index|
      "#{cell}#{" " * [widths[index] - visible_length(cell.to_s), 0].max}"
    }.join("  ").rstrip
  end
end

def delta(before, after)
  change = after - before

  return Color.dim("0") if change.zero?

  change.positive? ? Color.red("+#{change}") : Color.green(change.to_s)
end

def neutral_delta(before, after)
  change = after - before

  Color.yellow(change.positive? ? "+#{change}" : change.to_s)
end

def describe(run)
  run["label"] || run["herb_ref"] || "herb #{run["herb_version"]}"
end

before = load_run(before_path)
after = load_run(after_path)

if before["metric"] && after["metric"] && before["metric"] != after["metric"]
  abort "runs measure different things (#{before["metric"]} vs #{after["metric"]}); they are not comparable"
end

if before["corpus_commit"] && after["corpus_commit"] && before["corpus_commit"] != after["corpus_commit"]
  abort "runs measured different corpus commits (#{before["corpus_commit"][0, 8]} vs #{after["corpus_commit"][0, 8]}); re-measure both against the same corpus before comparing"
end

if before["files"] != after["files"]
  puts Color.yellow("Warning: runs cover different file counts (#{before["files"]} vs #{after["files"]}); the corpus moved between them.")
end

SEVERITY = %w[
  unexpected_error
  template_error
  invalid_ruby
  compilation_failed
  validation_error
  timeout
  failed
  analyze_parse_error
  strict_parse_error
  strict_compilation_failed
].freeze

def worsened?(from, to)
  from_rank = SEVERITY.index(from) || SEVERITY.size
  to_rank = SEVERITY.index(to) || SEVERITY.size

  to_rank < from_rank
end

def status_of(entry) = entry.is_a?(Hash) ? entry["status"] : entry

def changes(before, after, key)
  old = before[key] || {}
  new = after[key] || {}

  {
    "gained" => (Set.new(new.keys) - Set.new(old.keys)).sort,
    "lost" => (Set.new(old.keys) - Set.new(new.keys)).sort,
    "changed" => (Set.new(old.keys) & Set.new(new.keys))
                 .reject { |file| status_of(old[file]) == status_of(new[file]) }
                 .sort
                 .map { |file| [file, status_of(old[file]), status_of(new[file])] }
  }
end

def diagnostic_changes(before, after)
  old = before["diagnostic_counts"]
  new = after["diagnostic_counts"]

  return [] unless old.is_a?(Hash) && new.is_a?(Hash)

  (Set.new(old.keys) | Set.new(new.keys))
    .map { |name| [name, old[name].to_i, new[name].to_i] }
    .reject { |_, from, to| from == to }
    .sort_by { |name, from, to| [-(to - from).abs, name] }
end

parse = changes(before, after, "parse_failing")
compile = changes(before, after, "compile_failing")
diagnostics = diagnostic_changes(before, after)

left = describe(before)
right = describe(after)

puts "#{Color.bold(left)}  ->  #{Color.bold(right)}"
puts Color.dim("herb #{before["herb_version"]} vs #{after["herb_version"]}, #{before["files"]} files")
puts

comparable = lambda do |key|
  return "" if before[key].nil? || after[key].nil?

  delta(before[key].to_i, after[key].to_i)
end

table(
  [
    ["malformed templates", before["files_malformed"].to_s, after["files_malformed"].to_s,
     delta(before["files_malformed"].to_i, after["files_malformed"].to_i)],
    ["parse issues (all)", before["files_failing_parse"].to_s, after["files_failing_parse"].to_s,
     delta(before["files_failing_parse"].to_i, after["files_failing_parse"].to_i)],
    ["compile issues", before["files_failing_compile"].to_s, after["files_failing_compile"].to_s,
     delta(before["files_failing_compile"].to_i, after["files_failing_compile"].to_i)],
    ["files with line drift", before["files_with_line_drift"].to_s, after["files_with_line_drift"].to_s,
     comparable.call("files_with_line_drift")],
    ["tags off their line", before["tags_off_their_line"].to_s, after["tags_off_their_line"].to_s,
     comparable.call("tags_off_their_line")],
    ["clean files", before["files_clean"].to_s, after["files_clean"].to_s,
     delta(before["files_clean"].to_i, after["files_clean"].to_i)]
  ],
  ["", left, right, "DELTA"]
)

unless diagnostics.empty?
  puts
  puts Color.bold("Diagnostics")
  puts Color.dim("Counts move without a file changing verdict when a diagnostic is added or dropped.")
  puts

  table(
    diagnostics.first(20).map { |name, from, to| [name, from.to_s, to.to_s, neutral_delta(from, to)] },
    ["", left, right, "DELTA"]
  )

  puts Color.dim("  ... and #{diagnostics.size - 20} more") if diagnostics.size > 20
end

worse = (parse["changed"] + compile["changed"]).select { |_, from, to| worsened?(from, to) }
better = (parse["changed"] + compile["changed"]).reject { |_, from, to| worsened?(from, to) }

sections = [
  [parse["gained"], ->(n) { "#{pluralize(n, "file")} newly #{verb_for(n, "fails", "fail")} to parse" }, :red],
  [compile["gained"], ->(n) { "#{pluralize(n, "file")} newly #{verb_for(n, "fails", "fail")} to compile" }, :red],
  [worse.map { |file, from, to| "#{file}  #{from} -> #{to}" },
   ->(n) { "#{pluralize(n, "file")} got a worse verdict" }, :red],
  [parse["lost"], ->(n) { "#{pluralize(n, "file")} now #{verb_for(n, "parses", "parse")} again" }, :green],
  [compile["lost"], ->(n) { "#{pluralize(n, "file")} now #{verb_for(n, "compiles", "compile")} again" }, :green],
  [better.map { |file, from, to| "#{file}  #{from} -> #{to}" },
   ->(n) { "#{pluralize(n, "file")} got a better verdict" }, :green]
]

sections.each do |entries, title, color|
  next if entries.empty?

  puts "\n#{Color.send(color, title.call(entries.size))}"
  entries.first(20).each { |file| puts "  #{file}" }
  puts Color.dim("  ... and #{entries.size - 20} more") if entries.size > 20
end

if sections.all? { |entries, _, _| entries.empty? }
  puts(
    if diagnostics.empty?
      "\n#{Color.green("No change in outcomes.")}"
    else
      "\n#{Color.yellow("No file changed verdict, but diagnostic counts moved (see above).")}"
    end
  )
end

regressions = parse["gained"] + compile["gained"] + worse.map(&:first)

measured_drift = !before["files_with_line_drift"].nil? && !after["files_with_line_drift"].nil?

drifted =
  if measured_drift
    (after["line_drift"] || {}).reject { |file, count| count <= (before["line_drift"] || {})[file].to_i }
  else
    {}
  end

unless drifted.empty?
  puts
  puts Color.bold("#{pluralize(drifted.size, "template")} started compiling a tag onto the wrong line")
  drifted.sort.first(10).each do |file, count|
    was = (before["line_drift"] || {})[file].to_i
    puts "  #{file} (#{was} -> #{count})"
  end
  puts "  ... and #{drifted.size - 10} more" if drifted.size > 10
end

regressions += drifted.keys

def markdown_report(before, after, parse, compile, regressions, worse, better, diagnostics)
  fixed = parse["lost"] + compile["lost"]
  verdicts_unchanged = regressions.empty? && fixed.empty? && better.empty?
  no_changes = verdicts_unchanged && diagnostics.empty?

  out = []

  out << "<!-- corpus-report -->"
  out << "<!-- corpus-no-changes -->" if no_changes
  out << "### Corpus: #{describe(after)} vs #{describe(before)}"
  out << ""
  out << "| | #{describe(before)} | #{describe(after)} | |"
  out << "| --- | ---: | ---: | ---: |"

  [
    ["Malformed templates", "files_malformed"],
    ["Parse issues (all)", "files_failing_parse"],
    ["Compile issues", "files_failing_compile"],
    ["Files with line drift", "files_with_line_drift"],
    ["Tags off their line", "tags_off_their_line"],
    ["Clean files", "files_clean"]
  ].each do |label, key|
    next if before[key].nil? && after[key].nil?

    if before[key].nil? || after[key].nil?
      out << "| #{label} | #{before[key] || "–"} | #{after[key] || "–"} | – |"
      next
    end

    change = after[key].to_i - before[key].to_i
    arrow = change.zero? ? "–" : (change.positive? ? "**+#{change}**" : "#{change}")
    out << "| #{label} | #{before[key]} | #{after[key]} | #{arrow} |"
  end

  out << ""
  out << "Measured over #{pluralize(after["files"], "template")} from [`herb-corpus`](https://github.com/marcoroth/herb-corpus)."

  if no_changes
    out << ""
    out << "No file changed outcome."
  elsif verdicts_unchanged
    out << ""
    out << "No file changed outcome, but the diagnostics they report did."
  end

  unless diagnostics.empty?
    out << ""
    out << "<details#{verdicts_unchanged ? " open" : ""}>" \
           "<summary><b>#{pluralize(diagnostics.size, "diagnostic")} changed count</b></summary>"
    out << ""
    out << "| Diagnostic | #{describe(before)} | #{describe(after)} | |"
    out << "| --- | ---: | ---: | ---: |"

    diagnostics.first(40).each do |name, from, to|
      change = to - from
      out << "| `#{name}` | #{from} | #{to} | **#{change.positive? ? "+" : ""}#{change}** |"
    end

    out << ""
    out << "_… and #{diagnostics.size - 40} more._" << "" if diagnostics.size > 40
    out << "A count can drop because a false positive was fixed, or because a diagnostic is no " \
           "longer reported when it should be. Worth confirming which."
    out << "</details>"
  end

  render = lambda do |title, files, source, key, limit|
    next if files.empty?

    out << ""
    out << "<details open><summary><b>#{title.call(files.size)}</b></summary>"
    out << ""
    out << "| File | Error |"
    out << "| --- | --- |"

    files.first(limit).each do |file|
      detail = source[key][file]

      described =
        case detail
        when Hash
          errors = (detail["errors"] || {}).map { |type, count| count > 1 ? "`#{type}` ×#{count}" : "`#{type}`" }
          ["`#{detail["status"]}`", *errors].join(", ")
        when String then "`#{detail}`"
        else ""
        end

      out << "| `#{file}` | #{described} |"
    end

    out << ""
    out << "_… and #{files.size - limit} more._" if files.size > limit
    out << "</details>"
  end

  render.call(->(n) { "#{pluralize(n, "file")} no longer #{verb_for(n, "parses", "parse")}" },
              parse["gained"], after, "parse_failing", 40)
  render.call(->(n) { "#{pluralize(n, "file")} no longer #{verb_for(n, "compiles", "compile")}" },
              compile["gained"], after, "compile_failing", 40)

  unless worse.empty?
    out << ""
    out << "<details open><summary><b>#{pluralize(worse.size, "file")} got a worse verdict</b></summary>"
    out << ""
    out << "| File | Was | Now |"
    out << "| --- | --- | --- |"
    worse.first(40).each { |file, from, to| out << "| `#{file}` | `#{from}` | `#{to}` |" }
    out << ""
    out << "</details>"
  end

  unless fixed.empty?
    out << ""
    out << "<details><summary>#{pluralize(fixed.size, "file")} fixed</summary>"
    out << ""

    parse["lost"].first(20).each { |f| out << "- `#{f}` now parses" }
    compile["lost"].first(20).each { |f| out << "- `#{f}` now compiles" }

    shown = parse["lost"].first(20).size + compile["lost"].first(20).size
    out << "" << "_… and #{fixed.size - shown} more._" if fixed.size > shown

    out << "</details>"
  end

  unless better.empty?
    out << ""
    out << "<details><summary>#{pluralize(better.size, "file")} got a better verdict</summary>"
    out << ""
    out << "| File | Was | Now |"
    out << "| --- | --- | --- |"
    better.first(40).each { |file, from, to| out << "| `#{file}` | `#{from}` | `#{to}` |" }
    out << ""
    out << "_… and #{better.size - 40} more._" if better.size > 40
    out << "</details>"
  end

  out << ""

  out.join("\n")
end

if markdown_path
  File.write(markdown_path, markdown_report(before, after, parse, compile, regressions, worse, better, diagnostics))
  warn "Wrote #{markdown_path}"
end

exit 1 if fail_on_regression && !regressions.empty?

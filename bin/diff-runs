#!/usr/bin/env ruby
# frozen_string_literal: true

# Diffs two measurement runs produced by bin/measure-herb.
#
#   bin/diff-runs runs/release.json runs/branch.json --fail-on-regression

require "json"
require "optparse"
require "set"

fail_on_regression = false

OptionParser.new do |parser|
  parser.banner = "usage: diff-runs BEFORE.json AFTER.json [options]"
  parser.on("--fail-on-regression", "Exit non-zero if any file regressed or started crashing") { fail_on_regression = true }
end.parse!

before_path, after_path = ARGV
abort "usage: diff-runs BEFORE.json AFTER.json [--fail-on-regression]" unless before_path && after_path

module Color
  ENABLED = $stdout.tty? && !ENV.key?("NO_COLOR")

  def self.wrap(text, code) = ENABLED ? "\e[#{code}m#{text}\e[0m" : text.to_s

  def self.bold(text) = wrap(text, 1)
  def self.dim(text) = wrap(text, 2)
  def self.red(text) = wrap(text, 31)
  def self.green(text) = wrap(text, 32)
  def self.yellow(text) = wrap(text, 33)
end

def load_run(path)
  abort "no such run: #{path}" unless File.exist?(path)

  JSON.parse(File.read(path))
end

def visible_length(text) = text.to_s.gsub(/\e\[[0-9;]*m/, "").length

def table(rows, headers)
  widths = headers.each_index.map do |index|
    ([headers[index]] + rows.map { |row| row[index].to_s }).map { |cell| visible_length(cell) }.max
  end

  puts headers.each_with_index.map { |header, index| Color.bold(header.ljust(widths[index])) }.join("  ")
  puts widths.map { |width| Color.dim("-" * width) }.join("  ")

  rows.each do |row|
    puts row.each_with_index.map { |cell, index|
      "#{cell}#{" " * [widths[index] - visible_length(cell.to_s), 0].max}"
    }.join("  ").rstrip
  end
end

def delta(before, after)
  change = after - before

  return Color.dim("0") if change.zero?

  change.positive? ? Color.red("+#{change}") : Color.green(change.to_s)
end

def describe(run)
  run["label"] || run["herb_ref"] || "herb #{run["herb_version"]}"
end

before = load_run(before_path)
after = load_run(after_path)

# Two runs are only comparable if they counted the same thing over the same
# input. Otherwise a moved number says nothing about Herb.
%w[parse_metric compile_metric].each do |key|
  next unless before[key] && after[key]
  next if before[key] == after[key]

  abort "runs measure different things (#{key}: #{before[key]} vs #{after[key]}); they are not comparable"
end

if before["corpus_commit"] && after["corpus_commit"] && before["corpus_commit"] != after["corpus_commit"]
  abort "runs measured different corpus commits (#{before["corpus_commit"][0, 8]} vs #{after["corpus_commit"][0, 8]}); " \
        "re-measure both against the same corpus before comparing"
end

if before["files"] != after["files"]
  puts Color.yellow("Warning: runs cover different file counts (#{before["files"]} vs #{after["files"]}); the corpus moved between them.")
end

def changes(before, after, key)
  {
    "gained" => (Set.new(after[key].keys) - Set.new(before[key].keys)).sort,
    "lost" => (Set.new(before[key].keys) - Set.new(after[key].keys)).sort
  }
end

parse = changes(before, after, "parse_failing")
compile = changes(before, after, "compile_failing")
crashes = changes(before, after, "parse_crashed")

left = describe(before)
right = describe(after)

puts "#{Color.bold(left)}  ->  #{Color.bold(right)}"
puts Color.dim("herb #{before["herb_version"]} vs #{after["herb_version"]}, #{before["files"]} files")
puts

table(
  [
    ["parse failures", before["files_failing_parse"].to_s, after["files_failing_parse"].to_s,
     delta(before["files_failing_parse"], after["files_failing_parse"])],
    ["compile failures", before["files_failing_compile"].to_s, after["files_failing_compile"].to_s,
     delta(before["files_failing_compile"], after["files_failing_compile"])],
    ["crashes", before["files_crashed"].to_s, after["files_crashed"].to_s,
     delta(before["files_crashed"], after["files_crashed"])],
    ["total parse errors", before["total_errors"].to_s, after["total_errors"].to_s,
     delta(before["total_errors"], after["total_errors"])],
    ["files fully clean", before["files_clean"].to_s, after["files_clean"].to_s,
     delta(before["files_clean"], after["files_clean"])]
  ],
  ["", left, right, "DELTA"]
)

sections = [
  [parse["gained"], "PARSE REGRESSED (parsed before, fails now)", :red],
  [compile["gained"], "COMPILE REGRESSED (compiled before, fails now)", :red],
  [crashes["gained"], "NEWLY CRASHING", :red],
  [parse["lost"], "PARSE FIXED", :green],
  [compile["lost"], "COMPILE FIXED", :green],
  [crashes["lost"], "NO LONGER CRASHING", :green]
]

sections.each do |entries, title, color|
  next if entries.empty?

  puts "\n#{Color.send(color, "#{title}: #{entries.size}")}"
  entries.first(20).each { |file| puts "  #{file}" }
  puts Color.dim("  ... and #{entries.size - 20} more") if entries.size > 20
end

puts "\n#{Color.green("No change in outcomes.")}" if sections.all? { |entries, _, _| entries.empty? }

regressions = parse["gained"] + compile["gained"] + crashes["gained"]

exit 1 if fail_on_regression && !regressions.empty?

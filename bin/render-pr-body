#!/usr/bin/env ruby
# frozen_string_literal: true

# Renders the weekly drift PR body from the JSON that `bin/corpus drift` and
# `bin/corpus update` emit. Kept out of the workflow YAML so it can be run and
# eyeballed locally:
#
#   bin/corpus drift --json > /tmp/drift.json
#   bin/corpus update --report /tmp/update.json
#   .github/scripts/render-pr-body.rb /tmp/drift.json /tmp/update.json

require "json"

require_relative "../lib/components"
require_relative "../lib/pluralize"

include Pluralize

ROOT = File.expand_path("..", __dir__)

drift_path, update_path, before_path = ARGV

abort "usage: render-pr-body.rb DRIFT_JSON UPDATE_JSON [ADOPTION_BEFORE_JSON]" unless drift_path && update_path

def read_json(body)
  return nil if body.nil? || body.strip.empty?

  JSON.parse(body)
rescue JSON::ParserError
  nil
end

def adoption_before(path)
  return read_json(File.exist?(path) ? File.read(path) : nil) if path

  read_json(`git -C #{ROOT} show HEAD:adoption.json 2>/dev/null`)
end

def new_adoptions(before, after)
  return [] unless before && after && before.any?

  after.flat_map do |app, components|
    components.filter_map do |component, entry|
      next if before.dig(app, component)

      [COMPONENTS.dig(component, "project") || "Other", component, app, entry, !before.key?(app)]
    end
  end
end

drift = JSON.parse(File.read(drift_path))
update = File.exist?(update_path) ? JSON.parse(File.read(update_path)) : { "moved" => [], "skipped" => [], "failed" => [] }

moved = update["moved"] || []
skipped = update["skipped"] || []
failed = update["failed"] || []
unreachable = drift["unreachable"] || []
erb_delta = moved.sum { |entry| entry["erb_after"].to_i - entry["erb_before"].to_i }

def sign(number) = number.positive? ? "+#{number}" : number.to_s

out = []

out << "Automated weekly pin update. Each app below moved to the tip of the branch recorded in `.gitmodules`; `erb/` has been regenerated for those apps only."
out << ""
out << "**#{pluralize(moved.size, "pin")} moved** out of #{drift["total"]} tracked · **#{sign(erb_delta)} `.erb` files**"
out << ""

if moved.any?
  out << "| App | From | To | Commits | ERB |"
  out << "| --- | --- | --- | --- | --- |"

  moved.sort_by { |entry| -(entry["erb_after"].to_i - entry["erb_before"].to_i).abs }.each do |entry|
    delta = entry["erb_after"].to_i - entry["erb_before"].to_i
    compare = "https://github.com/#{entry["repo"]}/compare/#{entry["from"][0, 12]}...#{entry["to"][0, 12]}"
    erb_cell = delta.zero? ? entry["erb_after"].to_s : "#{entry["erb_after"]} (#{sign(delta)})"

    out << "| `#{entry["name"]}` | `#{entry["from"][0, 8]}` | [`#{entry["to"][0, 8]}`](#{compare}) | #{entry["commits"]} | #{erb_cell} |"
  end

  out << ""
end

after = read_json(File.exist?(File.join(ROOT, "adoption.json")) ? File.read(File.join(ROOT, "adoption.json")) : nil)
adopted = new_adoptions(adoption_before(before_path), after)

if adopted.any?
  fresh = adopted.select(&:last).map { |row| row[2] }.uniq

  out << "### New adopters"
  out << ""
  out << "#{pluralize(adopted.size, "component")} newly detected since the last run#{fresh.any? ? ", across #{pluralize(fresh.size, "app")} not previously seen adopting anything" : ""}:"
  out << ""

  adopted.group_by(&:first).sort.each do |project, rows|
    out << "**#{project}**"
    out << ""

    rows.group_by { |row| row[1] }.sort_by { |component, _| COMPONENTS.keys.index(component) || 99 }.each do |component, entries|
      apps = entries.sort_by { |row| row[2].downcase }.map do |_, _, app, entry, first_time|
        "`#{app}`#{first_time ? "*" : ""} (#{entry["adoption_date"] || "date unknown"})"
      end

      out << "- `#{component}`: #{apps.join(", ")}"
    end

    out << ""
  end

  out << "`*` marks an app appearing in the adoption report for the first time." if fresh.any?
  out << ""
end

if unreachable.any?
  out << "### Unreachable"
  out << ""
  out << "These remotes could not be queried. The pinned commits may no longer be fetchable, which means a fresh clone cannot reproduce the corpus:"
  out << ""

  unreachable.each { |entry| out << "- `#{entry["name"]}`: `#{entry["repo"]}` branch `#{entry["branch"]}`" }

  out << ""
end

if failed.any?
  out << "### Failed to update"
  out << ""

  failed.each { |entry| out << "- `#{entry["name"]}`: #{entry["reason"]}" }

  out << ""
end

if skipped.any?
  out << "### Skipped"
  out << ""

  skipped.each { |entry| out << "- `#{entry["name"]}`: #{entry["reason"]}" }

  out << ""
end

out << "---"
out << ""
out << "Merging changes the corpus, so Herb results measured before and after are not directly comparable. Re-run Herb's corpus check against the new pins and record the parse-error baseline in the merge commit."

puts out.join("\n")

rules:
  - files: "**/corpus.yml"
    pipeline:
      - sort:
          path: "apps"
          by: ".name"
          order: asc

      - sort_keys:
          path: "apps[]"
          order:
            - name
            - repo
            - upstream
            - fork
            - license
            - license_file
            - redistributable
            - exclude_paths
            - note

      - quote_style:
          key_style: plain
          value_style: double

      - blank_lines:
          count: 1
